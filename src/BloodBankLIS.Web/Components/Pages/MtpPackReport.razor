@page "/mtp/pack-records/{PackRecordId:long}"
@inject BloodBankApiClient Api
@inject IJSRuntime Js

<PageTitle>MTP pack report &middot; Greyhound Blood Bank LIS</PageTitle>

@* Nine columns plus blanks for handwriting: print this sheet landscape. Only present while this page is open. *@
<style>
    @@media print { @@page { size: landscape; margin: 12mm; } }
</style>

<div class="flex-between no-print">
    <a class="btn btn-ghost" href="/issuing">Issue &amp; Transfuse</a>
    @if (_report is not null)
    {
        <button type="button" class="btn btn-primary" disabled="@_busy" @onclick="PrintAsync">Print</button>
    }
</div>
<Outcome Value="_feedback" />

@if (_report is { } r)
{
    <div class="mtp-report">
        <h1>@MtpPackReportText.Heading</h1>
        <p class="mtp-report-sub">MTP #@r.MtpActivationId &middot; Pack @r.PackNumber &middot; All times: @r.TimeZoneLabel</p>

        @if (r.TemperatureOutsideRange)
        {
            <div class="alert alert-danger"><strong>Temperature at packing was outside the container's range.</strong> Contact the blood bank before using these units.</div>
        }

        <table class="mtp-report-facts">
            <tbody>
                <tr><th>Patient</th><td>@r.PatientName</td><th>MRN</th><td class="mono">@(r.MedicalRecordNumber ?? "—")</td></tr>
                <tr><th>Date of birth</th><td>@(r.DateOfBirth?.ToString("yyyy-MM-dd") ?? "—")</td><th>Protocol activated</th><td>@((r.ActivatedLocal ?? r.ActivatedUtc).ToString("yyyy-MM-dd HH:mm"))</td></tr>
                <tr><th>Called by</th><td>@r.RequestedBy</td><th>Reason</th><td>@r.ActivationReason@(r.ActivationLocation is null ? "" : $" ({r.ActivationLocation})")</td></tr>
                <tr><th>Pack</th><td>@(r.PackDefinitionCode is null ? "No pack definition" : $"{r.PackDefinitionName} ({r.PackDefinitionCode})")</td><th>Pack number</th><td>@r.PackNumber</td></tr>
                <tr><th>Packed</th><td>@((r.PackedLocal ?? r.PackedUtc).ToString("yyyy-MM-dd HH:mm"))</td><th>Packed by</th><td>@r.PackedBy</td></tr>
                <tr><th>Container</th><td>@r.ContainerName (@r.ContainerCode)@(r.ContainerLabel is null ? "" : $" · {r.ContainerLabel}")</td><th>Temperature at packing</th><td>@r.TemperatureC.ToString("0.0") °C <span class="muted">(range: @r.ContainerRange)</span></td></tr>
                @if (r.Comment is not null)
                {
                    <tr><th>Comment</th><td colspan="3">@r.Comment</td></tr>
                }
            </tbody>
        </table>

        <h2>Units in this pack (@r.Units.Count)</h2>
        <table class="mtp-report-units">
            <thead>
                <tr>
                    <th>#</th><th>Unit number</th><th>Product type</th><th>Product code</th><th>ABO/Rh</th><th>Expires</th><th>Crossmatch</th>
                    <th>Checked (date/time)</th><th>Initials</th>
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < r.Units.Count; i++)
                {
                    var u = r.Units[i];
                    <tr>
                        <td>@(i + 1)</td>
                        <td class="mono">@u.UnitNumber</td>
                        <td>@u.ProductName</td>
                        <td class="mono">@u.ProductCode@(u.IsbtProductCode is null || u.IsbtProductCode == u.ProductCode ? "" : $" / {u.IsbtProductCode}")</td>
                        <td>@u.BloodType</td>
                        <td class="nowrap">@((u.ExpiresLocal ?? u.ExpiresUtc).ToString("yyyy-MM-dd HH:mm"))</td>
                        <td>@u.Crossmatch</td>
                        <td class="mtp-blank"></td>
                        <td class="mtp-blank mtp-blank-narrow"></td>
                    </tr>
                }
            </tbody>
        </table>

        <h2>Received</h2>
        <table class="mtp-report-sign">
            <tbody>
                <tr><th>Received by (print name)</th><td class="mtp-blank"></td><th>Date/time</th><td class="mtp-blank"></td><th>Initials</th><td class="mtp-blank mtp-blank-narrow"></td></tr>
                <tr><th>Ordering provider (print name)</th><td class="mtp-blank"></td><th>Date</th><td class="mtp-blank"></td><th>Signature</th><td class="mtp-blank"></td></tr>
            </tbody>
        </table>

        <h2>Please read</h2>
        <ul class="mtp-report-disclaimers">
            @foreach (var line in r.Disclaimers)
            {
                <li>@line</li>
            }
        </ul>
    </div>
}

@code {
    [Parameter] public long PackRecordId { get; set; }

    private MtpPackReportDto? _report;
    private Feedback? _feedback;
    private bool _busy;

    protected override async Task OnParametersSetAsync()
    {
        var r = await Api.GetMtpPackReportAsync(PackRecordId);
        _report = r.Succeeded ? r.Value : null;
        if (!r.Succeeded) _feedback = r.ToFeedback();
    }

    // The print is audited before the browser's print dialog opens: the sheet carries patient data off the system.
    private async Task PrintAsync()
    {
        _busy = true;
        var recorded = await Api.RecordMtpPackPrintedAsync(PackRecordId);
        _busy = false;
        if (!recorded.Succeeded)
        {
            _feedback = recorded.ToFeedback();
            return;
        }

        await Js.InvokeVoidAsync("print");
    }
}
