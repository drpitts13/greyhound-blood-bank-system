@page "/alerts"
@inject BloodBankApiClient Api

<PageTitle>Alerts &middot; HemoCore</PageTitle>

<h1>Alerts</h1>
<p class="muted">Conditions that need someone to look, most severe first. Open an alert's link to act on it.</p>
<details class="bb-help">
    <summary>How it works</summary>
    <ul>
        <li>Alerts appear in the app only. Nothing is emailed or texted.</li>
        <li>Below minimum stock, near expiry, reagent QC, transfusion not completed, and backup overdue alerts close on their own once the condition clears. The system checks every five minutes by default.</li>
        <li>Temperature excursion, incompatible after release, units expired, and backup failed alerts stay open until someone acknowledges them.</li>
        <li>Acknowledging records your name and note. It does not change a unit, deviation, or QC row. Open the link to act.</li>
    </ul>
</details>
<Outcome Value="_feedback" />

<div class="bb-card">
    <div class="bb-card-title"><h3>Open (@Open.Count)</h3></div>
    @if (Kinds.Count > 1)
    {
        <div class="flex" style="gap:.35rem;flex-wrap:wrap;margin-bottom:.5rem;" data-alert-kinds>
            <button type="button" class="btn btn-sm @(_kind is null || !Open.Any(a => a.Source == _kind) ? "btn-secondary" : "btn-ghost")" @onclick="() => _kind = null">All (@Open.Count)</button>
            @foreach (var (source, label, count) in Kinds)
            {
                <button type="button" class="btn btn-sm @(_kind == source ? "btn-secondary" : "btn-ghost")" @onclick="() => _kind = source">@label (@count)</button>
            }
        </div>
    }
    @if (Open.Count == 0)
    {
        <div class="muted">No open alerts.</div>
    }
    else
    {
        <div class="table-scroll">
        <table class="bb">
            <thead><tr><th>Severity</th><th>Alert</th><th>Raised</th><th>Note</th><th></th></tr></thead>
            <tbody>
                @foreach (var alert in ShownOpen)
                {
                    <tr>
                        <td><span class="badge @SeverityClass(alert.Severity)">@Ui.EnumText(alert.Severity)</span></td>
                        <td>
                            <div>@if (alert.Link is not null) { <a href="@alert.Link">@alert.Title</a> } else { @alert.Title }</div>
                            <div class="muted">@alert.Message</div>
                        </td>
                        <td class="nowrap">@alert.RaisedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")<span class="sub" data-open-for>open @AlertInboxView.OpenFor(alert.RaisedUtc, DateTime.UtcNow)</span></td>
                        @* Kept as typed, so Enter acknowledges with the note without leaving the field first. *@
                        <td><input placeholder="Optional; Enter acknowledges" value="@NoteFor(alert.Id)" @oninput="e => _notes[alert.Id] = e.Value?.ToString() ?? string.Empty" @onkeydown="e => OnNoteKey(e, alert.Id)" /></td>
                        <td><button class="btn btn-secondary btn-sm" disabled="@_busy" @onclick="() => AcknowledgeAsync(alert.Id)">Acknowledge</button></td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    }
</div>

<div class="bb-card">
    <div class="bb-card-title"><h3>Closed in the last 7 days</h3></div>
    @if (Closed.Count == 0)
    {
        <div class="muted">None.</div>
    }
    else
    {
        <div class="table-scroll">
        <table class="bb">
            <thead><tr><th>Severity</th><th>Alert</th><th>Raised</th><th>Closed</th></tr></thead>
            <tbody>
                @foreach (var alert in Closed)
                {
                    <tr>
                        <td><span class="badge @SeverityClass(alert.Severity)">@Ui.EnumText(alert.Severity)</span></td>
                        <td>@alert.Title</td>
                        <td class="nowrap">@alert.RaisedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            @if (alert.AcknowledgedUtc is DateTime ack)
                            {
                                <span>Acknowledged by @alert.AcknowledgedBy @ack.ToLocalTime().ToString("yyyy-MM-dd HH:mm")@(alert.AcknowledgeNote is null ? "" : $": {alert.AcknowledgeNote}")</span>
                            }
                            else if (alert.ResolvedUtc is DateTime resolved)
                            {
                                <span>Condition cleared @resolved.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    }
</div>

@code {
    private List<AlertDto> _alerts = new();
    private readonly Dictionary<long, string> _notes = new();
    private Feedback? _feedback;
    private bool _busy;

    private List<AlertDto> Open => _alerts.Where(a => a.AcknowledgedUtc is null && a.ResolvedUtc is null).ToList();

    // A kind filter that no longer has open alerts falls back to all.
    private string? _kind;

    private IReadOnlyList<(string Source, string Label, int Count)> Kinds => AlertInboxView.Kinds(Open);

    private List<AlertDto> ShownOpen =>
        _kind is not null && Open.Any(a => a.Source == _kind) ? Open.Where(a => a.Source == _kind).ToList() : Open;

    private List<AlertDto> Closed => _alerts.Where(a => a.AcknowledgedUtc is not null || a.ResolvedUtc is not null).ToList();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var result = await Api.GetAlertsAsync();
        if (result.Succeeded) _alerts = result.Value ?? new();
        else _feedback = result.ToFeedback();
    }

    private string NoteFor(long id) => _notes.TryGetValue(id, out var note) ? note : string.Empty;

    private async Task OnNoteKey(KeyboardEventArgs e, long id)
    {
        if (e.Key == "Enter") await AcknowledgeAsync(id);
    }

    private async Task AcknowledgeAsync(long id)
    {
        if (_busy) return;
        _busy = true;
        try
        {
            var note = NoteFor(id);
            var result = await Api.AcknowledgeAlertAsync(id, string.IsNullOrWhiteSpace(note) ? null : note);
            _feedback = result.ToFeedback("Alert acknowledged.");
            if (result.Succeeded)
            {
                _notes.Remove(id);
                await LoadAsync();
                AlertBadge.NotifyChanged();
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private static string SeverityClass(AlertSeverity severity) => severity switch
    {
        AlertSeverity.Critical => "badge-red",
        AlertSeverity.Warning => "badge-amber",
        _ => "badge-gray"
    };
}
