                        <th>Delivery</th>
                        <th>Supplier</th>
                        <th>Packing list</th>
                        <th>Ordered</th>
                        <th>Received</th>
                        <th>Expected</th>
                        <th>Entered</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var delivery in _openDeliveries)
                    {
                        <tr>
                            <td class="mono"><a href="@($"/inventory/deliveries/{delivery.Id}")">@delivery.Id</a></td>
                            <td>@delivery.SupplierNameLabel</td>
                            <td class="mono">@(delivery.PackingListNumber ?? "—")</td>
                            <td>@delivery.OrderedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@delivery.ReceivedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@delivery.ExpectedQuantity</td>
                            <td>@delivery.ReceivedQuantity</td>
                            <td class="right"><a class="btn btn-primary btn-sm" href="@($"/inventory/deliveries/{delivery.Id}/receive")">Enter units</a></td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        }
    </div>
}

@if (_board == "search")
{
<div class="bb-card">
    <div class="bb-card-title"><h3>Search</h3></div>
    <div class="form-row">
        <div class="field"><label>Unit number</label><input @bind="_searchUnit" @bind:event="oninput" @onkeydown="OnUnitSearchKey" placeholder="Type or scan, then Enter" /></div>
        <div class="field"><label>Status</label>
            <select @bind="_searchStatus"><option value="">Any</option>@foreach (var s in Enum.GetValues<UnitStatus>()) { <option value="@s">@Ui.EnumText(s)</option> }</select>
        </div>
        <div class="field"><label>Product</label>
            <select @bind="_searchProductTypeId"><option value="">Any</option>@foreach (var p in _productTypes) { <option value="@p.Id">@p.ChoiceLabel</option> }</select>
        </div>
        <div class="field"><label>ABO</label>
            <select @bind="_searchAbo"><option value="">Any</option>@foreach (var a in Enum.GetValues<AboGroup>()) { <option value="@a">@Ui.EnumText(a)</option> }</select>
        </div>
        <div class="field"><label>Rh(D)</label>
            <select @bind="_searchRh"><option value="">Any</option>@foreach (var r in Enum.GetValues<RhType>()) { <option value="@r">@Ui.EnumText(r)</option> }</select>
        </div>
        <div class="field">
            <label class="checkbox-item" style="margin-top:1.6rem;">
                <input type="checkbox" @bind="_showIssuedTransfused" @bind:after="SearchAsync" />
                Include units no longer in stock (issued, transfused, discarded, modified, shipped)
            </label>
        </div>
    </div>
    <button class="btn btn-secondary" disabled="@_busy" @onclick="SearchAsync">Search</button>
</div>

<div class="bb-card">
    @if (_loading)
    {
        <div class="loading">Loading units...</div>
    }
    else if (_units.Count == 0)
    {
        <div class="empty">No units match the current filters.</div>
    }
    else
    {
        <div class="table-scroll">
        <table class="bb">
            <thead><tr><th>Unit #</th><th>Product</th><th>Name</th><th>ABO/Rh</th><th>Expires</th><th>Status</th><th>Location</th><th></th></tr></thead>
            <tbody>
                @foreach (var u in _units)
                {
                    <tr>
                        <td><UnitLink Id="u.Id" Number="@u.UnitNumber" /></td>
                        <td class="mono">@ProductCode(u)</td>
                        <td>@ProductName(u.ProductTypeId)</td>
                        <td><strong>@Ui.BloodType(u.Abo, u.RhD)</strong></td>
                        <td class="nowrap">
                            @u.ExpiresUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                            @if (u.ExpiresUtc < DateTime.UtcNow)
                            {
                                <span class="badge badge-red">Expired</span>
                            }
                            else if (_nearExpiryItems.Any(n => n.UnitId == u.Id))
                            {
                                <span class="badge badge-amber">Near expiry</span>
                            }
                        </td>
                        <td><span class="@Ui.Badge(u.Status)">@Ui.StatusLabel(u.Status)</span>
                            @if (u.Status == UnitStatus.Expected && u.ExpectedArrivalDueUtc is DateTime due && due < DateTime.UtcNow)
                            {
                                <span class="badge badge-amber">Overdue</span>
                            }
                        </td>
                        <td>@LocationName(u.CurrentLocationId)</td>
                        <td class="right"><a class="btn btn-ghost btn-sm" href="@InventoryUrls.Unit(u.Id)">Manage</a></td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    }
</div>
}

@code {
    private List<BloodUnitDto> _units = new();
    private List<ExpectedInboundWorkItemDto> _expectedItems = new();
    private List<NearExpiryWorkItemDto> _nearExpiryItems = new();
    private List<ReadyToIssueWorkItemDto> _nearReady = new();
    private readonly Dictionary<long, int> _nearOpenOrdersByProduct = new();
    private List<QuarantineWorkItemDto> _quarantineItems = new();
    private List<DiscrepancyWorkItemDto> _discrepancyItems = new();
    private List<OnHoldWorkItemDto> _onHoldItems = new();
    private List<ProductRetypeWorkItemDto> _retypeItems = new();
    private bool _retypesLoading;
    private long? _expandedRetypeUnitId;
    private ProductRetypeDetailDto? _boardRetypeDetail;
    private List<ProductTypeDto> _productTypes = new();
    private List<InventoryLocationDto> _locations = new();
    private bool _loading = true;
    private bool _busy;
    private Feedback? _topFb;

    private string? _searchUnit;
    private bool _showIssuedTransfused;
    private UnitStatus? _searchStatus;
    private AboGroup? _searchAbo;
    private long? _searchProductTypeId;
    private RhType? _searchRh;

    private List<OpenDeliveryDto> _openDeliveries = new();
    private UnitAppearance? _arrivalAppearance;
    private string? _arrivalVisualNotes;
    private string? _supplierReturnReason;
    private string? _arrivalSecondVerifier;
    private bool _requireReceiveVerifier;
    private decimal? _arrivalTemperatureCelsius;
    private long? _confirmingExpectedId;
    private long? _releasingQuarantineId;
    private long? _discardingNearExpiryId;
    // A coded reason from Admin › Discard reasons, a comment when the reason needs one, and a second verifier: the same
    // discard as the unit page (Cycle 607; before, free text was sent as the reason code and the verifier as the comment).
    private string _nearExpiryDiscardReason = string.Empty;
    private string _nearExpiryDiscardComment = string.Empty;
    private string? _nearExpiryDiscardVerifier;
    private List<UnitDiscardReasonRefDto> _discardReasons = new();

    private bool NearExpiryCommentRequired =>
        _discardReasons.FirstOrDefault(r => r.Code == _nearExpiryDiscardReason)?.RequiresComment == true;

    private Feedback? _actionFb;
    private string? _releaseSecondVerifier;
    private string? _releaseScannedUnitNumber;
    private List<DirectoryUserDto> _directoryUsers = new();
    private List<PatientDto> _patients = new();

    private IEnumerable<DirectoryUserDto> QuarantineVerifierChoices =>
        _directoryUsers.Where(u => !string.Equals(u.UserName, Session.UserName, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<DirectoryUserDto> ReceiveVerifierChoices => QuarantineVerifierChoices;

    private string _board = "search";

    private string BoardClass(string board) => _board == board ? "btn-primary" : "btn-secondary";

    private static readonly string[] Boards = ["search", "expected", "retype", "near", "quarantine", "discrepancy", "hold", "deliveries"];

    private void SelectBoard(string board) => _board = board;

    protected override async Task OnInitializedAsync()
    {
        // A link may open any board on this page (the dashboard opens Near expiry, Retype, Quarantine).
        if (Boards.FirstOrDefault(b => string.Equals(b, Board, StringComparison.OrdinalIgnoreCase)) is { } linked)
        {
            _board = linked;
        }

        var policy = await Api.GetReceivePolicyAsync();
        _requireReceiveVerifier = policy.Succeeded && policy.Value?.RequireSecondVerifier == true;
        _productTypes = (await Api.GetProductTypesAsync()).Value ?? new();
        _locations = (await Api.GetLocationsAsync()).Value ?? new();
        if (Session.Has(PermissionCodes.InventoryReceive))
        {
            await LoadOpenDeliveriesAsync();
        }
        var users = await Api.GetDirectoryUsersAsync();
        if (users.Succeeded) _directoryUsers = users.Value ?? new();
        var patients = await Api.GetPatientsAsync();
        if (patients.Succeeded) _patients = patients.Value ?? new();
        _searchProductTypeId = ProductTypeId;
        if (Enum.TryParse<AboGroup>(Abo, ignoreCase: true, out var abo)) _searchAbo = abo;
        if (Enum.TryParse<UnitStatus>(Status, ignoreCase: true, out var status)) _searchStatus = status;
        await SearchAsync();
        await LoadExpectedAsync();
        await LoadNearExpiryAsync();
        await LoadQuarantineAsync();
        await LoadDiscrepancyAsync();
        await LoadOnHoldAsync();
        await LoadRetypesAsync();
        await ApplyBoardQueryAsync();
    }

    [SupplyParameterFromQuery]
    public string? Board { get; set; }

    [SupplyParameterFromQuery]
    public long? UnitId { get; set; }

    // Search prefill, so another page (Minimum stock) can link straight to the units it counted.
    [SupplyParameterFromQuery]
    public long? ProductTypeId { get; set; }

    [SupplyParameterFromQuery]
    public string? Abo { get; set; }

    [SupplyParameterFromQuery]
    public string? Status { get; set; }

    private bool _boardQueryApplied;

    private async Task ApplyBoardQueryAsync()
    {
        if (_boardQueryApplied) return;
        if (string.Equals(Board, "retype", StringComparison.OrdinalIgnoreCase))
        {
            _board = "retype";
            _boardQueryApplied = true;
            if (UnitId is long unitId)
            {
                await ToggleBoardRetype(unitId);
            }

            return;
        }

        if (string.Equals(Board, "quarantine", StringComparison.OrdinalIgnoreCase))
        {
            _board = "quarantine";
            _boardQueryApplied = true;
            _releasingQuarantineId = ModificationResultNextStep.QuarantineReleaseTarget(
                Board,
                UnitId,
                _quarantineItems.Select(item => item.UnitId));
            _releaseSecondVerifier = null;
            _releaseScannedUnitNumber = null;
            return;
        }

        if (UnitId is long manageId)
        {
            _boardQueryApplied = true;
            Nav.NavigateTo(InventoryUrls.Unit(manageId), replace: true);
        }
    }

    private string ProductCode(BloodUnitDto u)
    {
        if (!string.IsNullOrWhiteSpace(u.ProductDescriptionCode))
        {
            return u.ProductDescriptionCode;
        }

        if (!string.IsNullOrWhiteSpace(u.ProductCodeData) && u.ProductCodeData.Length >= 5)
        {
            return u.ProductCodeData[..5];
        }

        if (!string.IsNullOrWhiteSpace(u.Isbt128ProductCode))
        {
            return u.Isbt128ProductCode.Length >= 5 ? u.Isbt128ProductCode[..5] : u.Isbt128ProductCode;
        }

        return _productTypes.FirstOrDefault(t => t.Id == u.ProductTypeId)?.DisplayProductCode
            ?? u.ProductTypeId.ToString();
    }

    private string ProductName(long productTypeId) =>
        _productTypes.FirstOrDefault(t => t.Id == productTypeId)?.Name ?? "—";

    private string LocationName(long? id) =>
        StorageLocationLabel.ForInventoryList(
            id,
            _locations.Select(l => new StorageLocationLabel.CatalogLocation(l.Id, l.Name, l.Code)));

    /// <summary>
    /// Enter searches. A unit number that finds exactly one unit (typically a scanned label) opens that unit,
    /// saving the Search and Manage clicks.
    /// </summary>
    private async Task OnUnitSearchKey(KeyboardEventArgs e)
    {
        if (e.Key != "Enter") return;
        await SearchAsync();
        if (!string.IsNullOrWhiteSpace(_searchUnit) && _units.Count == 1)
        {
            Nav.NavigateTo(InventoryUrls.Unit(_units[0].Id));
        }
    }

    private async Task SearchAsync()
    {
        _loading = true;
        var criteria = new InventorySearchCriteria(
            string.IsNullOrWhiteSpace(_searchUnit) ? null : _searchUnit, _searchStatus, _searchAbo, _searchRh,
            ProductTypeId: _searchProductTypeId,
            Statuses: InventorySearchScope.Statuses(_searchUnit, _searchStatus, _showIssuedTransfused));
        var r = await Api.SearchUnitsAsync(criteria);
        _loading = false;
        if (r.Succeeded) _units = r.Value!;
        else _topFb = r.ToFeedback();
    }

    private async Task LoadExpectedAsync()
    {
        if (!Session.Has(PermissionCodes.InventoryReceive))
        {
            _expectedItems = new();
            return;
        }

        var r = await Api.GetExpectedInboundAsync();
        if (r.Succeeded) _expectedItems = r.Value ?? new();
    }

    private async Task LoadNearExpiryAsync()
    {
        var r = await Api.GetNearExpiryUnitsAsync();
        if (r.Succeeded) _nearExpiryItems = r.Value ?? new();

        // The next step for each row: a reserved unit's issue, or open orders an unreserved one could fill.
        _nearReady = Session.Has(PermissionCodes.IssueCreate) && _nearExpiryItems.Any(u => u.IsReserved)
            ? (await Api.GetReadyToIssueAllocationsAsync()).Value ?? new()
            : new();
        _nearOpenOrdersByProduct.Clear();
        if (Session.Has(PermissionCodes.CompatibilityAllocate))
        {
            foreach (var first in _nearExpiryItems.Where(u => !u.IsReserved).GroupBy(u => u.ProductTypeId).Select(g => g.First()))
            {
                var orders = await Api.GetUnitAllocatableOrdersAsync(first.UnitId);
                if (orders.Succeeded) _nearOpenOrdersByProduct[first.ProductTypeId] = orders.Value?.Count ?? 0;
            }
        }
    }

    private async Task LoadQuarantineAsync()
    {
        var r = await Api.GetQuarantineUnitsAsync();
        if (r.Succeeded) _quarantineItems = r.Value ?? new();
    }

    private async Task LoadDiscrepancyAsync()
    {
        if (!Session.Has(PermissionCodes.InventoryRelease))
        {
            _discrepancyItems = new();
            return;
        }

        var r = await Api.GetDiscrepancyUnitsAsync();
        if (r.Succeeded) _discrepancyItems = r.Value ?? new();
    }

    private async Task LoadOnHoldAsync()
    {
        if (!Session.Has(PermissionCodes.InventoryRelease))
        {
            _onHoldItems = new();
            return;
        }

        var r = await Api.GetOnHoldUnitsAsync();
        if (r.Succeeded) _onHoldItems = r.Value ?? new();
    }

    private async Task LoadRetypesAsync()
    {
        _retypesLoading = true;
        var r = await Api.GetPendingRetypesAsync();
        _retypesLoading = false;
        if (r.Succeeded) _retypeItems = r.Value ?? new();
    }

    private string _retypeScan = string.Empty;
    private string? _retypeScanMessage;
    private ElementReference _retypeScanInput;
    // After a retype is recorded the scan field takes the focus, ready for the next label (Cycle 610).
    private bool _focusRetypeScan;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusRetypeScan || _retypeScanInput.Context is null) return;
        _focusRetypeScan = false;
        try
        {
            // Keep the recorded outcome in view rather than scrolling to the field.
            await _retypeScanInput.FocusAsync(preventScroll: true);
        }
        catch (JSException)
        {
        }
    }

    /// <summary>Enter on the board's scan opens that unit's retype entry (a unit already open stays open).</summary>
    private async Task OnRetypeScanKey(KeyboardEventArgs e)
    {
        if (e.Key != "Enter") return;
        var found = RetypeBoardScan.Find(_retypeScan, _retypeItems);
        _retypeScanMessage = found.Message;
        if (found.Row is { } row)
        {
            _retypeScan = string.Empty;
            if (_expandedRetypeUnitId != row.UnitId)
            {
                await ToggleBoardRetype(row.UnitId);
            }
        }
    }

    private async Task ToggleBoardRetype(long unitId)
    {
        if (_expandedRetypeUnitId == unitId)
        {
            _expandedRetypeUnitId = null;
            _boardRetypeDetail = null;
            return;
        }

        _expandedRetypeUnitId = unitId;
        var r = await Api.GetUnitRetypeAsync(unitId);
        _boardRetypeDetail = r.Value;
        if (!r.Succeeded)
        {
            // The row only shows "Loading retype..." here, so report the failure at the top and close it.
            _topFb = r.ToFeedback();
            _expandedRetypeUnitId = null;
        }
    }

    private async Task OnBoardRetypeSaved(Feedback? outcome)
    {
        // The row collapses, taking the panel's message with it, so repeat the outcome at the top.
        _topFb = outcome;
        await Js.ScrollIntoViewAsync("inventory-top-outcome");
        _expandedRetypeUnitId = null;
        _boardRetypeDetail = null;
        _retypeScanMessage = null;
        _focusRetypeScan = true;
        await LoadRetypesAsync();
        await LoadQuarantineAsync();
        await SearchAsync();
    }

    private void ToggleExpectedConfirm(long unitId)
    {
        _confirmingExpectedId = _confirmingExpectedId == unitId ? null : unitId;
        _actionFb = null;
    }

    private async Task ToggleNearExpiryDiscard(long unitId)
    {
        _discardingNearExpiryId = _discardingNearExpiryId == unitId ? null : unitId;
        _nearExpiryDiscardReason = string.Empty;
        _nearExpiryDiscardComment = string.Empty;
        _nearExpiryDiscardVerifier = null;
        _actionFb = null;
        if (_discardingNearExpiryId is not null && _discardReasons.Count == 0)
        {
            var reasons = await Api.GetDiscardReasonsAsync();
            if (reasons.Succeeded) _discardReasons = reasons.Value ?? new();
        }
    }

    private async Task DiscardNearExpiryAsync(long id)
    {
        _busy = true;
        var r = await Api.DiscardUnitAsync(
            id, _nearExpiryDiscardReason,
            string.IsNullOrWhiteSpace(_nearExpiryDiscardComment) ? null : _nearExpiryDiscardComment.Trim(),
            _nearExpiryDiscardVerifier);
        _busy = false;
        _actionFb = r.ToFeedback("Unit discarded.");
        if (r.Succeeded)
        {
            _discardingNearExpiryId = null;
            _nearExpiryDiscardReason = string.Empty;
            _nearExpiryDiscardComment = string.Empty;
            _nearExpiryDiscardVerifier = null;
            await LoadNearExpiryAsync();
            await SearchAsync();
        }
    }

    private void ToggleQuarantineRelease(long unitId)
    {
        _releasingQuarantineId = _releasingQuarantineId == unitId ? null : unitId;
        _releaseSecondVerifier = null;
        _releaseScannedUnitNumber = null;
        _actionFb = null;
    }

    private async Task LoadOpenDeliveriesAsync()
    {
        var r = await Api.GetOpenDeliveriesAsync();
        _openDeliveries = r.Succeeded ? r.Value ?? new() : new();
        if (!r.Succeeded) _topFb = r.ToFeedback();
    }

    private async Task ExpireDueAsync()
    {
        _busy = true;
        var r = await Api.ExpireDueAsync();
        _busy = false;
        _topFb = r.Succeeded
            ? new Feedback(true, $"Expiration sweep complete: {r.Value!.Expired} unit(s) expired.", Array.Empty<RuleMessage>(), false, false, Array.Empty<RuleMessage>(), null)
            : r.ToFeedback();
        if (r.Succeeded)
        {
            await SearchAsync();
            await LoadNearExpiryAsync();
            await LoadQuarantineAsync();
        }
    }

    private async Task ReloadBoardsAsync()
    {
        await SearchAsync();
        if (Session.Has(PermissionCodes.InventoryReceive))
        {
            await LoadOpenDeliveriesAsync();
        }
        await LoadExpectedAsync();
        await LoadNearExpiryAsync();
        await LoadQuarantineAsync();
        await LoadDiscrepancyAsync();
        await LoadOnHoldAsync();
        await LoadRetypesAsync();
    }

    private async Task ReleaseAsync(long id, bool requiresLabelScan = false)
    {
        _busy = true;
        var r = await Api.ReleaseUnitAsync(id, new ReleaseFromQuarantineRequest(
            _releaseSecondVerifier,
            requiresLabelScan ? _releaseScannedUnitNumber : null));
        _busy = false;
        _actionFb = r.Succeeded && r.Value is { Status: UnitStatus.Received }
            ? Feedback.Succeed("Unit released from quarantine, but its ABO/Rh retype is not confirmed yet, so it went back to Received. Record the retype before it can be allocated or issued.")
            : r.ToFeedback("Unit released from quarantine.");
        if (r.Succeeded)
        {
            _topFb = _actionFb;
            _releaseSecondVerifier = null;
            _releaseScannedUnitNumber = null;
            _releasingQuarantineId = null;
            await ReloadBoardsAsync();
        }
    }

    private long? _releasingHoldId;
    private string _holdReleaseReason = string.Empty;

    private void BeginHoldRelease(long id)
    {
        _releasingHoldId = _releasingHoldId == id ? null : id;
        _holdReleaseReason = string.Empty;
    }

    private async Task ReleaseHoldAsync(long id)
    {
        _busy = true;
        var r = await Api.ReleaseHoldAsync(id, _holdReleaseReason);
        if (r.Succeeded)
        {
            _releasingHoldId = null;
            _holdReleaseReason = string.Empty;
        }
        _busy = false;
        _topFb = r.Succeeded && r.Value is { Status: UnitStatus.Received }
            ? Feedback.Succeed("Unit released from operational hold, but its ABO/Rh retype is not confirmed yet, so it went back to Received. Record the retype before it can be allocated or issued.")
            : r.ToFeedback("Unit released from operational hold.");
        await Js.ScrollIntoViewAsync("inventory-top-outcome");
        if (r.Succeeded) await ReloadBoardsAsync();
    }

    private long? _discrepancyUnitId;
    private string _discrepancyNote = string.Empty;

    private void BeginDiscrepancy(long id)
    {
        _discrepancyUnitId = _discrepancyUnitId == id ? null : id;
        _discrepancyNote = string.Empty;
    }

    private async Task LocateMissingAsync(long id)
    {
        _busy = true;
        var r = await Api.LocateMissingAsync(id, _discrepancyNote);
        if (r.Succeeded) { _discrepancyUnitId = null; _discrepancyNote = string.Empty; }
        _busy = false;
        _topFb = r.ToFeedback("Unit located into quarantine for inspection.");
        await Js.ScrollIntoViewAsync("inventory-top-outcome");
        if (r.Succeeded) await ReloadBoardsAsync();
    }

    private async Task InspectDamagedAsync(long id)
    {
        _busy = true;
        var r = await Api.InspectDamagedAsync(id, _discrepancyNote);
        if (r.Succeeded) { _discrepancyUnitId = null; _discrepancyNote = string.Empty; }
        _busy = false;
        _topFb = r.ToFeedback("Damaged unit moved to quarantine for quality review.");
        await Js.ScrollIntoViewAsync("inventory-top-outcome");
        if (r.Succeeded) await ReloadBoardsAsync();
    }

    private async Task ReceiveExpectedAsync(long id)
    {
        _busy = true;
        var r = await Api.ReceiveExpectedUnitAsync(id, new ReceiveExpectedUnitRequest(
            VisualInspectionAcceptable: _arrivalAppearance == UnitAppearance.Acceptable,
            VisualInspectionNotes: string.IsNullOrWhiteSpace(_arrivalVisualNotes) ? null : _arrivalVisualNotes,
            SecondVerifier: _requireReceiveVerifier ? _arrivalSecondVerifier : null,
            Appearance: _arrivalAppearance,
            ReceiveTemperatureCelsius: _arrivalTemperatureCelsius));
        _busy = false;
        _actionFb = r.ToFeedback(r.Value?.Status == UnitStatus.Received
            ? "Arrival confirmed. Pending retype until results are entered and verified."
            : "Arrival confirmed into quarantine.");
        if (r.Succeeded)
        {
            _arrivalAppearance = null;
            _arrivalVisualNotes = null;
            _arrivalSecondVerifier = null;
            _arrivalTemperatureCelsius = null;
            _supplierReturnReason = null;
            _confirmingExpectedId = null;
            _topFb = _actionFb;
            await ReloadBoardsAsync();
        }
    }

    private string? SupplierReturnReasonForExpected() =>
        // An unrecorded appearance suggests no reason (as Acceptable does); a typed reason is still used.
        ReceiveAppearanceRule.SuggestedSupplierReturnReason(
            _arrivalAppearance ?? UnitAppearance.Acceptable, _arrivalVisualNotes, _supplierReturnReason);

    private async Task ReturnExpectedToSupplierAsync(long id)
    {
        var reason = SupplierReturnReasonForExpected();
        if (string.IsNullOrWhiteSpace(reason))
        {
            _actionFb = Feedback.Fail("A reason is required to return a unit to the supplier.");
            return;
        }

        _busy = true;
        var r = await Api.ReturnToSupplierAsync(id, reason);
        _busy = false;
        _actionFb = r.ToFeedback("Unit returned to the supplier.");
        if (r.Succeeded)
        {
            _arrivalAppearance = null;
            _arrivalVisualNotes = null;
            _arrivalSecondVerifier = null;
            _arrivalTemperatureCelsius = null;
            _supplierReturnReason = null;
            _confirmingExpectedId = null;
            _topFb = _actionFb;
            await ReloadBoardsAsync();
        }
    }

}
