@page "/inventory"
@using BloodBankLIS.Application.Inventory
@using BloodBankLIS.Application.Reference
@inject BloodBankApiClient Api
@inject UserSession Session

<PageTitle>Inventory &middot; Greyhound Blood Bank LIS</PageTitle>

<div class="flex-between" style="margin-bottom:1rem;">
    <h1>Blood Product Inventory</h1>
    <div class="flex gap">
        <a class="btn btn-secondary" href="inventory/isbt-receive">ISBT 128 receive</a>
        @if (Session.Has(PermissionCodes.InventoryReceive))
        {
            <button class="btn btn-primary" @onclick="ToggleReceive">@(_showReceive ? "Cancel" : "Receive unit")</button>
            <button class="btn btn-secondary" @onclick="ToggleExpect">@(_showExpect ? "Cancel" : "Expect unit")</button>
        }
        @if (Session.Has(PermissionCodes.InventoryDiscard))
        {
            <button class="btn btn-secondary" disabled="@_busy" @onclick="ExpireDueAsync">Run expiration sweep</button>
        }
    </div>
</div>

<Outcome Value="_topFb" />

@if (_showReceive)
{
    <div class="bb-card">
        <div class="bb-card-title"><h3>Receive a unit</h3></div>
        <p class="muted">Products marked Retype Y enter as Received until the front-type retype is recorded. Others enter Quarantine.</p>
        <Outcome Value="_receiveFb" />
        <div class="form-row">
            <div class="field"><label>Unit number</label><input @bind="_rec.UnitNumber" placeholder="W0001230000099" /></div>
            <div class="field"><label>Product type</label>
                <select @bind="_rec.ProductTypeId">
                    <option value="0">— select —</option>
                    @foreach (var t in _productTypes) { <option value="@t.Id">@t.DisplayProductCode — @t.Name</option> }
                </select>
            </div>
            <div class="field"><label>ABO</label><select @bind="_rec.Abo">@foreach (var a in Enum.GetValues<AboGroup>()) { <option value="@a">@a</option> }</select></div>
            <div class="field"><label>Rh(D)</label><select @bind="_rec.RhD">@foreach (var r in Enum.GetValues<RhType>()) { <option value="@r">@r</option> }</select></div>
            <div class="field"><label>Expires (UTC)</label><input type="datetime-local" @bind="_rec.ExpiresLocal" /></div>
            <div class="field"><label>Location</label>
                <select @bind="_rec.LocationId">
                    <option value="0">— none —</option>
                    @foreach (var l in _locations) { <option value="@l.Id">@l.Code — @l.Name</option> }
                </select>
            </div>
            <div class="field"><label>Product description code</label>
                <input @bind="_rec.ProductDescriptionCode" placeholder="E0336 or E0336000" maxlength="8" required />
            </div>
            <div class="field"><label>Collection facility</label><input @bind="_rec.CollectionFacility" /></div>
            <div class="field"><label>Supplier</label><input @bind="_rec.Supplier" /></div>
        </div>
        <label class="flex"><input type="checkbox" @bind="_rec.VisualInspectionAcceptable" /> &nbsp;Visual inspection acceptable (no clots, hemolysis, or container defects)</label>
        <div class="form-row">
            <div class="field"><label>Visual notes</label><input @bind="_rec.VisualInspectionNotes" placeholder="Optional appearance notes" /></div>
        </div>
        <button class="btn btn-primary" disabled="@_busy" @onclick="ReceiveAsync">Receive</button>
    </div>
}

@if (_showExpect)
{
    <div class="bb-card">
        <div class="bb-card-title"><h3>Expect an inbound unit</h3></div>
        <p class="muted">Packing-list / ASN intake (SoftBank expected inventory). The unit is not in house until arrival is confirmed and visually inspected.</p>
        <Outcome Value="_expectFb" />
        <div class="form-row">
            <div class="field"><label>Unit number</label><input @bind="_exp.UnitNumber" placeholder="W0001230000099" /></div>
            <div class="field"><label>Product type</label>
                <select @bind="_exp.ProductTypeId">
                    <option value="0">— select —</option>
                    @foreach (var t in _productTypes) { <option value="@t.Id">@t.DisplayProductCode — @t.Name</option> }
                </select>
            </div>
            <div class="field"><label>ABO</label><select @bind="_exp.Abo">@foreach (var a in Enum.GetValues<AboGroup>()) { <option value="@a">@a</option> }</select></div>
            <div class="field"><label>Rh(D)</label><select @bind="_exp.RhD">@foreach (var r in Enum.GetValues<RhType>()) { <option value="@r">@r</option> }</select></div>
            <div class="field"><label>Expires (UTC)</label><input type="datetime-local" @bind="_exp.ExpiresLocal" /></div>
            <div class="field"><label>Product description code</label>
                <input @bind="_exp.ProductDescriptionCode" placeholder="E0336 or E0336000" maxlength="8" required />
            </div>
            <div class="field"><label>Supplier</label><input @bind="_exp.Supplier" /></div>
            <div class="field"><label>Shipment / packing list</label><input @bind="_exp.ShipmentId" placeholder="Optional ASN id" /></div>
        </div>
        <button class="btn btn-primary" disabled="@_busy" @onclick="ExpectAsync">Record as expected</button>
    </div>
}

<div class="bb-card">
    <div class="bb-card-title"><h3>Search</h3></div>
    <div class="form-row">
        <div class="field"><label>Unit number</label><input @bind="_searchUnit" /></div>
        <div class="field"><label>Status</label>
            <select @bind="_searchStatus"><option value="">Any</option>@foreach (var s in Enum.GetValues<UnitStatus>()) { <option value="@s">@s</option> }</select>
        </div>
        <div class="field"><label>ABO</label>
            <select @bind="_searchAbo"><option value="">Any</option>@foreach (var a in Enum.GetValues<AboGroup>()) { <option value="@a">@a</option> }</select>
        </div>
        <div class="field"><label>Rh(D)</label>
            <select @bind="_searchRh"><option value="">Any</option>@foreach (var r in Enum.GetValues<RhType>()) { <option value="@r">@r</option> }</select>
        </div>
    </div>
    <button class="btn btn-secondary" disabled="@_busy" @onclick="SearchAsync">Search</button>
</div>

<div class="bb-card">
    @if (_loading)
    {
        <div class="loading">Loading units...</div>
    }
    else if (_units.Count == 0)
    {
        <div class="empty">No units match the current filters.</div>
    }
    else
    {
        <table class="bb">
            <thead><tr><th>Unit #</th><th>Product</th><th>Name</th><th>ABO/Rh</th><th>Expires</th><th>Status</th><th>Location</th><th></th></tr></thead>
            <tbody>
                @foreach (var u in _units)
                {
                    <tr>
                        <td class="mono">@u.UnitNumber</td>
                        <td class="mono">@ProductCode(u)</td>
                        <td>@ProductName(u.ProductTypeId)</td>
                        <td><strong>@Ui.BloodType(u.Abo, u.RhD)</strong></td>
                        <td class="nowrap @(u.ExpiresUtc < DateTime.UtcNow ? "" : "")">@u.ExpiresUtc.ToString("yyyy-MM-dd HH:mm")</td>
                        <td><span class="@Ui.Badge(u.Status)">@u.Status</span></td>
                        <td>@LocationName(u.CurrentLocationId)</td>
                        <td class="right"><button class="btn btn-ghost btn-sm" @onclick="() => Select(u)">@(_selected?.Id == u.Id ? "Hide" : "Manage")</button></td>
                    </tr>
                    @if (_selected?.Id == u.Id)
                    {
                        <tr><td colspan="8">@RenderActions(u)</td></tr>
                    }
                }
            </tbody>
        </table>
    }
</div>

@code {
    private List<BloodUnitDto> _units = new();
    private List<ProductTypeDto> _productTypes = new();
    private List<InventoryLocationDto> _locations = new();
    private bool _loading = true;
    private bool _busy;
    private Feedback? _topFb;

    private string? _searchUnit;
    private UnitStatus? _searchStatus;
    private AboGroup? _searchAbo;
    private RhType? _searchRh;

    private bool _showReceive;
    private ReceiveModel _rec = new();
    private Feedback? _receiveFb;

    private bool _showExpect;
    private ReceiveModel _exp = new();
    private Feedback? _expectFb;
    private bool _arrivalVisualOk = true;
    private string? _arrivalVisualNotes;
    private string _cancelExpectedReason = string.Empty;

    private BloodUnitDto? _selected;
    private string _unitTab = "actions";
    private ProductRetypeDetailDto? _retypeDetail;
    private List<InventoryStatusHistoryDto> _history = new();
    private List<UnitBloodAttributeDto> _unitAttributes = new();
    private List<BloodAttributeListItemDto> _bloodAttributeCatalog = new();
    private long? _uaCatalogId;
    private BloodAttributeKind _uaKind = BloodAttributeKind.Antigen;
    private AntigenResult _uaResult = AntigenResult.Negative;
    private Feedback? _actionFb;
    private long _transferTo;
    private string _transferReason = string.Empty;
    private string _discardReason = string.Empty;
    private string _holdReason = string.Empty;
    private string? _releaseSecondVerifier;
    private List<DirectoryUserDto> _directoryUsers = new();

    private IEnumerable<DirectoryUserDto> QuarantineVerifierChoices =>
        _directoryUsers.Where(u => !string.Equals(u.UserName, Session.UserName, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        _productTypes = (await Api.GetProductTypesAsync()).Value ?? new();
        _locations = (await Api.GetLocationsAsync()).Value ?? new();
        var users = await Api.GetDirectoryUsersAsync();
        if (users.Succeeded) _directoryUsers = users.Value ?? new();
        await SearchAsync();
    }

    private string ProductCode(BloodUnitDto u)
    {
        if (!string.IsNullOrWhiteSpace(u.ProductDescriptionCode))
        {
            return u.ProductDescriptionCode;
        }

        if (!string.IsNullOrWhiteSpace(u.ProductCodeData) && u.ProductCodeData.Length >= 5)
        {
            return u.ProductCodeData[..5];
        }

        if (!string.IsNullOrWhiteSpace(u.Isbt128ProductCode))
        {
            return u.Isbt128ProductCode.Length >= 5 ? u.Isbt128ProductCode[..5] : u.Isbt128ProductCode;
        }

        return _productTypes.FirstOrDefault(t => t.Id == u.ProductTypeId)?.DisplayProductCode
            ?? u.ProductTypeId.ToString();
    }

    private string ProductName(long productTypeId) =>
        _productTypes.FirstOrDefault(t => t.Id == productTypeId)?.Name ?? "—";

    private string LocationName(long? id) => id is null ? "—" : (_locations.FirstOrDefault(l => l.Id == id)?.Code ?? id.Value.ToString());

    private async Task SearchAsync()
    {
        _loading = true;
        var criteria = new InventorySearchCriteria(
            string.IsNullOrWhiteSpace(_searchUnit) ? null : _searchUnit, _searchStatus, _searchAbo, _searchRh);
        var r = await Api.SearchUnitsAsync(criteria);
        _loading = false;
        if (r.Succeeded) _units = r.Value!;
        else _topFb = r.ToFeedback();
    }

    private async Task ReceiveAsync()
    {
        _busy = true;
        var req = new ReceiveUnitRequest(_rec.UnitNumber, _rec.ProductTypeId, _rec.Abo, _rec.RhD,
            DateTime.SpecifyKind(_rec.ExpiresLocal, DateTimeKind.Utc),
            _rec.LocationId == 0 ? null : _rec.LocationId,
            string.IsNullOrWhiteSpace(_rec.CollectionFacility) ? null : _rec.CollectionFacility,
            string.IsNullOrWhiteSpace(_rec.Supplier) ? null : _rec.Supplier,
            string.IsNullOrWhiteSpace(_rec.ProductDescriptionCode) ? null : _rec.ProductDescriptionCode.Trim(),
            VisualInspectionAcceptable: _rec.VisualInspectionAcceptable,
            VisualInspectionNotes: string.IsNullOrWhiteSpace(_rec.VisualInspectionNotes) ? null : _rec.VisualInspectionNotes);
        var r = await Api.ReceiveUnitAsync(req);
        _busy = false;
        _receiveFb = r.ToFeedback(r.Value?.Status == UnitStatus.Received
            ? "Unit received. ABO/Rh retype is required before the unit is Available."
            : "Unit received into quarantine.");
        if (r.Succeeded) { _rec = new(); _showReceive = false; await SearchAsync(); }
    }

    private async Task ExpectAsync()
    {
        _busy = true;
        var req = new ReceiveUnitRequest(_exp.UnitNumber, _exp.ProductTypeId, _exp.Abo, _exp.RhD,
            DateTime.SpecifyKind(_exp.ExpiresLocal, DateTimeKind.Utc),
            _exp.LocationId == 0 ? null : _exp.LocationId,
            string.IsNullOrWhiteSpace(_exp.CollectionFacility) ? null : _exp.CollectionFacility,
            string.IsNullOrWhiteSpace(_exp.Supplier) ? null : _exp.Supplier,
            string.IsNullOrWhiteSpace(_exp.ProductDescriptionCode) ? null : _exp.ProductDescriptionCode.Trim(),
            ShipmentId: string.IsNullOrWhiteSpace(_exp.ShipmentId) ? null : _exp.ShipmentId.Trim());
        var r = await Api.ExpectUnitAsync(req);
        _busy = false;
        _expectFb = r.ToFeedback("Unit recorded as expected. Confirm arrival when the shipment is received.");
        if (r.Succeeded) { _exp = new(); _showExpect = false; await SearchAsync(); }
    }

    private async Task ExpireDueAsync()
    {
        _busy = true;
        var r = await Api.ExpireDueAsync();
        _busy = false;
        _topFb = r.Succeeded
            ? new Feedback(true, $"Expiration sweep complete: {r.Value!.Expired} unit(s) expired.", Array.Empty<RuleMessage>(), false, false, Array.Empty<RuleMessage>(), null)
            : r.ToFeedback();
        if (r.Succeeded) await SearchAsync();
    }

    private void ToggleReceive()
    {
        _showReceive = !_showReceive;
        if (_showReceive) _showExpect = false;
    }

    private void ToggleExpect()
    {
        _showExpect = !_showExpect;
        if (_showExpect) _showReceive = false;
    }

    private async Task Select(BloodUnitDto u)
    {
        if (_selected?.Id == u.Id)
        {
            _selected = null;
            return;
        }

        _selected = u;
        _unitTab = "actions";
        _actionFb = null;
        _transferTo = 0;
        _transferReason = string.Empty;
        _discardReason = string.Empty;
        _holdReason = string.Empty;
        _history = (await Api.GetUnitHistoryAsync(u.Id)).Value ?? new();
        _unitAttributes = (await Api.GetUnitBloodAttributesAsync(u.Id)).Value ?? new();
        _retypeDetail = (await Api.GetUnitRetypeAsync(u.Id)).Value;
        if (_bloodAttributeCatalog.Count == 0)
        {
            _bloodAttributeCatalog = (await Api.GetReferenceBloodAttributesAsync()).Value ?? new();
        }
    }

    private string UnitTabClass(string tab) => _unitTab == tab ? "btn-primary" : "btn-secondary";

    private async Task OnRetypeSaved()
    {
        if (_selected is null) return;
        await RefreshSelected(_selected.Id);
        _unitTab = "retype";
    }

    private async Task SaveUnitAttributeAsync(long unitId)
    {
        if (_uaCatalogId is null) return;
        _busy = true;
        var r = await Api.SaveUnitBloodAttributeAsync(unitId, new SaveUnitBloodAttributeRequest(_uaCatalogId.Value, _uaKind, _uaResult));
        _busy = false;
        _actionFb = r.ToFeedback("Blood attribute saved.");
        if (r.Succeeded) await RefreshSelected(unitId);
    }

    private async Task ReleaseAsync(long id)
    {
        _busy = true;
        var r = await Api.ReleaseUnitAsync(id, new ReleaseFromQuarantineRequest(_releaseSecondVerifier));
        _busy = false;
        _actionFb = r.ToFeedback("Unit released from quarantine.");
        if (r.Succeeded)
        {
            _releaseSecondVerifier = null;
            await RefreshSelected(id);
        }
    }

    private async Task HoldAsync(long id)
    {
        _busy = true;
        var r = await Api.HoldUnitAsync(id, _holdReason);
        _busy = false;
        _actionFb = r.ToFeedback("Unit placed on operational hold. It cannot be issued until released.");
        if (r.Succeeded)
        {
            _holdReason = string.Empty;
            await RefreshSelected(id);
        }
    }

    private async Task ReleaseHoldAsync(long id)
    {
        _busy = true;
        var r = await Api.ReleaseHoldAsync(id);
        _busy = false;
        _actionFb = r.ToFeedback("Unit released from operational hold.");
        if (r.Succeeded) await RefreshSelected(id);
    }

    private async Task ReceiveExpectedAsync(long id)
    {
        _busy = true;
        var r = await Api.ReceiveExpectedUnitAsync(id, new ReceiveExpectedUnitRequest(
            VisualInspectionAcceptable: _arrivalVisualOk,
            VisualInspectionNotes: string.IsNullOrWhiteSpace(_arrivalVisualNotes) ? null : _arrivalVisualNotes));
        _busy = false;
        _actionFb = r.ToFeedback(r.Value?.Status == UnitStatus.Received
            ? "Arrival confirmed. ABO/Rh retype is required before the unit is Available."
            : "Arrival confirmed into quarantine.");
        if (r.Succeeded)
        {
            _arrivalVisualOk = true;
            _arrivalVisualNotes = null;
            await RefreshSelected(id);
        }
    }

    private async Task CancelExpectedAsync(long id)
    {
        _busy = true;
        var r = await Api.CancelExpectedUnitAsync(id, new CancelExpectedUnitRequest(_cancelExpectedReason));
        _busy = false;
        _actionFb = r.ToFeedback("Expected unit cancelled.");
        if (r.Succeeded)
        {
            _cancelExpectedReason = string.Empty;
            await RefreshSelected(id);
        }
    }

    private static bool CanPlaceOnHold(UnitStatus status) => status is
        UnitStatus.Available or UnitStatus.Selected or UnitStatus.Assigned or UnitStatus.Allocated
        or UnitStatus.Crossmatched or UnitStatus.Received or UnitStatus.Returned
        or UnitStatus.Transferred or UnitStatus.CancelledAssignment;

    private async Task TransferAsync(long id)
    {
        _busy = true;
        var r = await Api.TransferUnitAsync(id, _transferTo, string.IsNullOrWhiteSpace(_transferReason) ? null : _transferReason);
        _busy = false;
        _actionFb = r.ToFeedback("Unit transferred.");
        if (r.Succeeded) await RefreshSelected(id);
    }

    private async Task DiscardAsync(long id)
    {
        _busy = true;
        var r = await Api.DiscardUnitAsync(id, _discardReason);
        _busy = false;
        _actionFb = r.ToFeedback("Unit discarded.");
        if (r.Succeeded) await RefreshSelected(id);
    }

    private async Task PrintComponentLabelAsync(long id)
    {
        _busy = true;
        var r = await Api.PrintComponentLabelAsync(id, new PrintRequestVm(LabelFormat.Preview));
        _busy = false;
        _actionFb = r.ToFeedback("Component label queued. Open Printing to view or reprint.");
        if (r.Succeeded) await RefreshSelected(id);
    }

    private async Task RefreshSelected(long id)
    {
        await SearchAsync();
        _selected = _units.FirstOrDefault(u => u.Id == id);
        if (_selected is not null)
        {
            _history = (await Api.GetUnitHistoryAsync(id)).Value ?? new();
            _unitAttributes = (await Api.GetUnitBloodAttributesAsync(id)).Value ?? new();
            _retypeDetail = (await Api.GetUnitRetypeAsync(id)).Value;
        }
    }

    private RenderFragment RenderActions(BloodUnitDto u) => __builder =>
    {
        <div class="stack">
            <Outcome Value="_actionFb" />
            <div class="flex gap" style="flex-wrap:wrap;margin-bottom:.5rem;">
                <button type="button" class="btn btn-sm @UnitTabClass("actions")" @onclick='() => _unitTab = "actions"'>Actions</button>
                <button type="button" class="btn btn-sm @UnitTabClass("retype")" @onclick='() => _unitTab = "retype"'>Retype</button>
                <button type="button" class="btn btn-sm @UnitTabClass("attributes")" @onclick='() => _unitTab = "attributes"'>Attributes</button>
                <button type="button" class="btn btn-sm @UnitTabClass("history")" @onclick='() => _unitTab = "history"'>History</button>
            </div>

            @if (_unitTab == "actions")
            {
                <div class="flex gap" style="flex-wrap:wrap;">
                    @if (u.Status == UnitStatus.Quarantine && Session.Has(PermissionCodes.InventoryRelease))
                    {
                        <div class="field" style="min-width:16rem;">
                            <label>Second verifier</label>
                            <FilterableComboBox TItem="DirectoryUserDto" TValue="string?"
                                Items="QuarantineVerifierChoices"
                                @bind-Value="_releaseSecondVerifier"
                                DisplayText="@(x => x.Label)"
                                ItemValue="@(x => x.UserName)"
                                SearchText="@(x => x.Label)"
                                Clearable="true"
                                Placeholder="Different active user" />
                        </div>
                        <button class="btn btn-secondary btn-sm" disabled="@_busy" @onclick="() => ReleaseAsync(u.Id)">Release from quarantine</button>
                    }
                    @if (u.Status == UnitStatus.Expected && Session.Has(PermissionCodes.InventoryReceive))
                    {
                        <label class="field" style="min-width:14rem;">
                            <input type="checkbox" @bind="_arrivalVisualOk" />
                            Visual inspection acceptable
                        </label>
                        <div class="field" style="min-width:16rem;">
                            <label>Arrival notes</label>
                            <input @bind="_arrivalVisualNotes" placeholder="Appearance, defects" />
                        </div>
                        <button class="btn btn-primary btn-sm" disabled="@_busy" @onclick="() => ReceiveExpectedAsync(u.Id)">Confirm arrival</button>
                        <div class="field" style="min-width:16rem;">
                            <label>Cancel reason</label>
                            <input @bind="_cancelExpectedReason" placeholder="Not shipped / cancelled ASN" />
                        </div>
                        <button class="btn btn-danger btn-sm" disabled="@(_busy || string.IsNullOrWhiteSpace(_cancelExpectedReason))" @onclick="() => CancelExpectedAsync(u.Id)">Cancel expected</button>
                    }
                    @if (u.Status == UnitStatus.OnHold && Session.Has(PermissionCodes.InventoryRelease))
                    {
                        <button class="btn btn-secondary btn-sm" disabled="@_busy" @onclick="() => ReleaseHoldAsync(u.Id)">Release from hold</button>
                    }
                    @if (Session.Has(PermissionCodes.PrintLabel))
                    {
                        <button class="btn btn-secondary btn-sm" disabled="@_busy" @onclick="() => PrintComponentLabelAsync(u.Id)">Print component label</button>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(u.HoldReason) || !string.IsNullOrWhiteSpace(u.QuarantineReason) || !string.IsNullOrWhiteSpace(u.ReceiveVisualNotes) || !string.IsNullOrWhiteSpace(u.ShipmentId))
                {
                    <p class="muted">
                        @if (!string.IsNullOrWhiteSpace(u.ShipmentId))
                        {
                            <span>Shipment: @u.ShipmentId</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(u.HoldReason))
                        {
                            <span>Hold: @u.HoldReason</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(u.QuarantineReason))
                        {
                            <span>Quarantine: @u.QuarantineReason</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(u.ReceiveVisualNotes))
                        {
                            <span>Receive visual: @u.ReceiveVisualNotes</span>
                        }
                    </p>
                }

                @if (CanPlaceOnHold(u.Status) && Session.Has(PermissionCodes.InventoryRelease))
                {
                    <div class="flex gap">
                        <input @bind="_holdReason" placeholder="Hold reason (paperwork, pending review)" style="flex:1;" />
                        <button class="btn btn-secondary btn-sm" disabled="@(_busy || string.IsNullOrWhiteSpace(_holdReason))" @onclick="() => HoldAsync(u.Id)">Place on hold</button>
                    </div>
                }

                @if (Session.Has(PermissionCodes.InventoryTransfer))
                {
                    <div class="flex gap">
                        <select @bind="_transferTo"><option value="0">— location —</option>@foreach (var l in _locations) { <option value="@l.Id">@l.Code — @l.Name</option> }</select>
                        <input @bind="_transferReason" placeholder="Reason (optional)" />
                        <button class="btn btn-secondary btn-sm" disabled="@(_busy || _transferTo == 0)" @onclick="() => TransferAsync(u.Id)">Transfer</button>
                    </div>
                }

                @if (Session.Has(PermissionCodes.InventoryDiscard))
                {
                    <div class="flex gap">
                        <input @bind="_discardReason" placeholder="Discard reason" style="flex:1;" />
                        <button class="btn btn-danger btn-sm" disabled="@(_busy || string.IsNullOrWhiteSpace(_discardReason))" @onclick="() => DiscardAsync(u.Id)">Discard</button>
                    </div>
                }
            }

            @if (_unitTab == "retype")
            {
                @if (_retypeDetail is null)
                {
                    <div class="muted">Unable to load retype details for this unit.</div>
                }
                else
                {
                    <ProductRetypeEntryPanel Detail="_retypeDetail" OnSaved="OnRetypeSaved" />
                }
            }

            @if (_unitTab == "attributes")
            {
                <h4>Blood attributes</h4>
                @if (_unitAttributes.Count == 0)
                {
                    <div class="muted">No extended typing on record.</div>
                }
                else
                {
                    <table class="bb">
                        <thead><tr><th>Kind</th><th>Antigen</th><th>Antibody</th><th>Result</th></tr></thead>
                        <tbody>
                            @foreach (var a in _unitAttributes)
                            {
                                <tr>
                                    <td>@a.AttributeKind</td>
                                    <td class="mono">@a.AntigenCode — @a.AntigenName</td>
                                    <td>@a.AntibodyName</td>
                                    <td>@a.Result</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                @if (Session.Has(PermissionCodes.InventoryReceive))
                {
                    <div class="form-row" style="margin-top:.5rem;">
                        <div class="field"><label>Attribute</label>
                            <FilterableComboBox TItem="BloodAttributeListItemDto" TValue="long?"
                                                Items="_bloodAttributeCatalog"
                                                @bind-Value="_uaCatalogId"
                                                DisplayText="@(a => $"{a.Name} ({a.Code})")"
                                                Placeholder="Select" />
                        </div>
                        <div class="field"><label>Kind</label>
                            <select @bind="_uaKind">@foreach (var k in Enum.GetValues<BloodAttributeKind>()) { <option value="@k">@k</option> }</select>
                        </div>
                        <div class="field"><label>Result</label>
                            <select @bind="_uaResult">@foreach (var r in Enum.GetValues<AntigenResult>()) { <option value="@r">@r</option> }</select>
                        </div>
                    </div>
                    <button class="btn btn-secondary btn-sm" disabled="@(_busy || _uaCatalogId is null)" @onclick="() => SaveUnitAttributeAsync(u.Id)">Save attribute</button>
                }
            }

            @if (_unitTab == "history")
            {
                <h4>Status history</h4>
                @if (_history.Count == 0)
                {
                    <div class="muted">No history.</div>
                }
                else
                {
                    <table class="bb">
                        <thead><tr><th>From</th><th>To</th><th>Reason</th><th>By</th><th>When</th></tr></thead>
                        <tbody>
                            @foreach (var h in _history)
                            {
                                <tr>
                                    <td>@(h.FromStatus?.ToString() ?? "—")</td>
                                    <td>@h.ToStatus</td>
                                    <td>@h.Reason</td>
                                    <td>@h.ChangedBy</td>
                                    <td class="nowrap">@h.ChangedUtc.ToString("yyyy-MM-dd HH:mm")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            }
        </div>
    };

    private sealed class ReceiveModel
    {
        public string UnitNumber { get; set; } = string.Empty;
        public long ProductTypeId { get; set; }
        public AboGroup Abo { get; set; } = AboGroup.O;
        public RhType RhD { get; set; } = RhType.Positive;
        public DateTime ExpiresLocal { get; set; } = DateTime.UtcNow.AddDays(30);
        public long LocationId { get; set; }
        public string ProductDescriptionCode { get; set; } = string.Empty;
        public string? CollectionFacility { get; set; }
        public string? Supplier { get; set; }
        public string? ShipmentId { get; set; }
        public bool VisualInspectionAcceptable { get; set; } = true;
        public string? VisualInspectionNotes { get; set; }
    }
}
