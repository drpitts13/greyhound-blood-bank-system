@page "/inventory"
@using BloodBankLIS.Application.Inventory
@using BloodBankLIS.Application.Issuing
@using BloodBankLIS.Application.Reference
@using BloodBankLIS.Domain.Rules
@inject BloodBankApiClient Api
@inject UserSession Session
@inject NavigationManager Nav
@inject IJSRuntime Js

<PageTitle>Inventory &middot; Greyhound Blood Bank LIS</PageTitle>

<InventoryDeskRibbon Current="@(string.Equals(Board, "retype", StringComparison.OrdinalIgnoreCase) ? InventoryDeskRibbon.Desk.Retype : InventoryDeskRibbon.Desk.Inventory)" />

<div class="flex-between" style="margin-bottom:1rem;">
    <h1>Blood Product Inventory</h1>
    <div class="flex gap">
        @if (Session.Has(PermissionCodes.InventoryReceive))
        {
            <a class="btn btn-primary" href="/inventory/deliveries/new">New delivery</a>
        }
        @if (Session.Has(PermissionCodes.InventoryDiscard))
        {
            <button class="btn btn-secondary" disabled="@_busy" @onclick="ExpireDueAsync">Run expiration sweep</button>
        }
    </div>
</div>

<div id="inventory-top-outcome"><Outcome Value="_topFb" /></div>

<div class="flex gap" style="margin-bottom:1rem;flex-wrap:wrap;">
    <button type="button" class="btn @BoardClass("search")" @onclick='() => SelectBoard("search")'>Search</button>
    <button type="button" class="btn @BoardClass("expected")" @onclick='() => SelectBoard("expected")'>Expected inbound</button>
    <button type="button" class="btn @BoardClass("retype")" @onclick='() => SelectBoard("retype")'>Retype</button>
    <button type="button" class="btn @BoardClass("near")" @onclick='() => SelectBoard("near")'>Near expiry</button>
    <button type="button" class="btn @BoardClass("quarantine")" @onclick='() => SelectBoard("quarantine")'>Quarantine</button>
    <button type="button" class="btn @BoardClass("discrepancy")" @onclick='() => SelectBoard("discrepancy")'>Discrepancy</button>
    <button type="button" class="btn @BoardClass("hold")" @onclick='() => SelectBoard("hold")'>Operational hold</button>
    <button type="button" class="btn @BoardClass("deliveries")" @onclick='() => SelectBoard("deliveries")'>Open deliveries</button>
</div>

@if (_board == "expected" && (_expectedItems.Count > 0 || Session.Has(PermissionCodes.InventoryReceive)))
{
    <div class="bb-card">
        <div class="bb-card-title"><h3>Expected inbound</h3></div>
        <p class="muted">Packing-list units that have not arrived. Confirm arrival from the row.</p>
        <details class="bb-help">
            <summary>Arrival rules</summary>
            <ul>
                <li>Confirm arrival here with appearance, cooler temperature, and a second verifier — the same receive gates as the Manage drawer.</li>
                <li>A unit that fails appearance or temperature is returned to the supplier from this row.</li>
                <li>An outdated unit says Outdated and is not received; return it to the supplier.</li>
                <li>Overdue after the facility arrival window (default 24 hours).</li>
                <li>Late arrival is still allowed.</li>
            </ul>
        </details>
        @if (_expectedItems.Count == 0)
        {
            <div class="muted">No expected inbound units.</div>
        }
        else
        {
            <table class="bb">
                <thead>
                    <tr>
                        <th>Unit</th>
                        <th>ABO/Rh</th>
                        <th>Product</th>
                        <th>Shipment</th>
                        <th>Supplier</th>
                        <th>Recorded</th>
                        <th>Due</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _expectedItems)
                    {
                        <tr>
                            <td class="mono">@row.UnitNumber</td>
                            <td><strong>@Ui.BloodType(row.Abo, row.RhD)</strong></td>
                            <td>@ProductName(row.ProductTypeId)</td>
                            <td class="mono">@(row.ShipmentId ?? "—")</td>
                            <td>@(row.SupplierLabel ?? "—")</td>
                            <td>@row.CreatedUtc.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>
                                @(row.DueUtc?.ToString("yyyy-MM-dd HH:mm") ?? "—")
                                @if (row.IsOutdated)
                                {
                                    <span class="badge badge-red" title="This unit is outdated and cannot be received. Return it to the supplier.">Outdated</span>
                                }
                                else if (row.IsOverdue)
                                {
                                    <span class="badge badge-amber">Overdue</span>
                                }
                            </td>
                            <td class="right nowrap">
                                @if (Session.Has(PermissionCodes.InventoryReceive))
                                {
                                    <button class="btn @(row.IsOutdated ? "btn-ghost" : "btn-primary") btn-sm" disabled="@_busy" @onclick="() => ToggleExpectedConfirm(row.UnitId)">
                                        @(_confirmingExpectedId == row.UnitId ? "Hide" : row.IsOutdated ? "Return" : "Confirm")
                                    </button>
                                }
                                <a class="btn btn-ghost btn-sm" href="@InventoryUrls.Unit(row.UnitId)">Open</a>
                            </td>
                        </tr>
                        @if (_confirmingExpectedId == row.UnitId && Session.Has(PermissionCodes.InventoryReceive))
                        {
                            <tr>
                                <td colspan="8">
                                    <div class="alert alert-info" style="margin:.25rem 0;">
                                        @if (row.IsOutdated)
                                        {
                                            <p class="muted" style="margin:0 0 .5rem;">@row.UnitNumber is outdated and cannot be received. Return it to the supplier.</p>
                                        }
                                        else
                                        {
                                            <p class="muted" style="margin:0 0 .5rem;">Confirm arrival of <span class="mono">@row.UnitNumber</span> with the same visual and temperature gates as walk-in receive.</p>
                                        }
                                        <Outcome Value="_actionFb" />
                                        @if (!row.IsOutdated)
                                        {
                                        <div class="form-row">
                                            <div class="field"><label>Appearance</label>
                                                <select @bind="_arrivalAppearance">
                                                    @foreach (var a in Enum.GetValues<UnitAppearance>()) { <option value="@a">@a</option> }
                                                </select>
                                            </div>
                                            <div class="field"><label>Arrival notes</label>
                                                <input @bind="_arrivalVisualNotes" placeholder="Appearance, defects" />
                                            </div>
                                            <div class="field"><label>Receipt temperature (°C)</label>
                                                <input type="number" step="0.1" @bind="_arrivalTemperatureCelsius" placeholder="e.g. 4.0" />
                                                <span class="muted">Shipping range @ReceiveTemperatureRule.MinCelsius.ToString("0")–@ReceiveTemperatureRule.MaxCelsius.ToString("0") °C.</span>
                                            </div>
                                            @if (_requireReceiveVerifier)
                                            {
                                                <div class="field" style="min-width:16rem;"><label>Second verifier</label>
                                                    <FilterableComboBox TItem="DirectoryUserDto" TValue="string?"
                                                        Items="ReceiveVerifierChoices"
                                                        @bind-Value="_arrivalSecondVerifier"
                                                        DisplayText="@(x => x.Label)"
                                                        ItemValue="@(x => x.UserName)"
                                                        SearchText="@(x => x.Label)"
                                                        Clearable="true"
                                                        Placeholder="Different active user" />
                                                </div>
                                            }
                                        </div>
                                        @if (_arrivalAppearance != UnitAppearance.Acceptable)
                                        {
                                            <p class="muted" style="margin:.35rem 0 0;">This appearance is not received. Return the unit to the supplier.</p>
                                        }
                                        }
                                        <div class="flex gap" style="margin-top:.5rem;flex-wrap:wrap;align-items:end;">
                                            @if (!row.IsOutdated)
                                            {
                                                <button class="btn btn-primary btn-sm" disabled="@_busy" @onclick="() => ReceiveExpectedAsync(row.UnitId)">Confirm arrival</button>
                                            }
                                            <div class="field" style="min-width:16rem;margin:0;">
                                                <label>Return to supplier</label>
                                                <input @bind="_supplierReturnReason" placeholder="Failed inspection / refused at dock" />
                                            </div>
                                            <button class="btn btn-danger btn-sm" disabled="@(_busy || string.IsNullOrWhiteSpace(SupplierReturnReasonForExpected()))" @onclick="() => ReturnExpectedToSupplierAsync(row.UnitId)">Return to supplier</button>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        }
    </div>
}

@if (_board == "retype" && (_retypeItems.Count > 0 || Session.Has(PermissionCodes.ResultEnter)))
{
    <div id="pending-retype" class="bb-card">
        <div class="bb-card-title">
            <h3>Pending ABO/Rh retype</h3>
            <button class="btn btn-secondary btn-sm" disabled="@_busy" @onclick="LoadRetypesAsync">Refresh</button>
        </div>
        <p class="muted">Received units need a front-type confirmation before they become Available. A match releases the unit; a mismatch quarantines it.</p>
        <details class="bb-help">
            <summary>About retypes</summary>
            <ul>
                <li>An outdated unit is marked Outdated: a matching retype records the type and moves it to Expired instead of Available.</li>
                <li>The test worklist lists the same units and opens this board.</li>
                <li>The Manage drawer can still record a retype while you are already on the unit.</li>
            </ul>
        </details>
        @if (_retypesLoading)
        {
            <div class="loading">Loading retypes...</div>
        }
        else if (_retypeItems.Count == 0)
        {
            <div class="muted">No units are waiting for an ABO/Rh retype.</div>
        }
        else
        {
            <table class="bb">
                <thead>
                    <tr>
                        <th>Unit</th>
                        <th>Product</th>
                        <th>Test</th>
                        <th>Labeled ABO/Rh</th>
                        <th>Received</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _retypeItems)
                    {
                        <tr>
                            <td class="mono">@row.UnitNumber</td>
                            <td>
                                <span class="mono">@row.ProductCode</span>
                                <span class="muted">@row.ProductName</span>
                            </td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(row.TestCode))
                                {
                                    <strong>@(row.TestName ?? row.TestCode)</strong>
                                    <span class="mono muted">@row.TestCode</span>
                                }
                                else
                                {
                                    <span class="muted">—</span>
                                }
                            </td>
                            <td><strong>@Ui.BloodType(row.Abo, row.RhD)</strong></td>
                            <td class="nowrap">@row.ReceivedUtc.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>
                                <span class="@Ui.Badge(row.Status)">@Ui.StatusLabel(row.Status)</span>
                                @if (row.Expired)
                                {
                                    <span class="badge badge-red" title="A matching retype records the type and moves this unit to Expired.">Outdated</span>
                                }
                            </td>
                            <td class="right nowrap">
                                @if (Session.HasAny(PermissionCodes.ResultEnter, PermissionCodes.ResultVerify))
                                {
                                    <button class="btn btn-primary btn-sm" disabled="@_busy" @onclick="() => ToggleBoardRetype(row.UnitId)">
                                        @(_expandedRetypeUnitId == row.UnitId ? "Hide" : Session.Has(PermissionCodes.ResultEnter) ? "Enter" : "Verify")
                                    </button>
                                }
                                <a class="btn btn-ghost btn-sm" href="@InventoryUrls.Unit(row.UnitId)">Open</a>
                            </td>
                        </tr>
                        @if (_expandedRetypeUnitId == row.UnitId && Session.HasAny(PermissionCodes.ResultEnter, PermissionCodes.ResultVerify))
                        {
                            <tr>
                                <td colspan="7">
                                    @if (_boardRetypeDetail?.UnitId == row.UnitId)
                                    {
                                        <ProductRetypeEntryPanel Detail="_boardRetypeDetail" OnSaved="OnBoardRetypeSaved" />
                                    }
                                    else
                                    {
                                        <div class="loading">Loading retype...</div>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        }
    </div>
}

@if (_board == "near")
{
    <div class="bb-card">
        <div class="bb-card-title"><h3>Near expiry</h3></div>
        <p class="muted">On-hand units that expire within the facility warning window (default 24 hours). Discard from the row with the same reason and second verifier as the unit page, before the expiration sweep.</p>
        @if (_nearExpiryItems.Count == 0)
        {
            <div class="muted">No units near expiry.</div>
        }
        else
        {
        <table class="bb">
            <thead>
                <tr>
                    <th>Unit</th>
                    <th>ABO/Rh</th>
                    <th>Product</th>
                    <th>Location</th>
                    <th>Status</th>
                    <th>Expires</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in _nearExpiryItems)
                {
                    <tr>
                        <td class="mono">@row.UnitNumber</td>
                        <td><strong>@Ui.BloodType(row.Abo, row.RhD)</strong></td>
                        <td>@ProductName(row.ProductTypeId)</td>
                        <td>@row.LocationLabel</td>
                        <td><span class="@Ui.Badge(row.Status)">@row.Status</span></td>
                        <td class="nowrap">
                            @row.ExpiresUtc.ToString("yyyy-MM-dd HH:mm")
                            <span class="badge badge-amber">Near expiry</span>
                        </td>
                        <td class="right nowrap">
                            @if (Session.Has(PermissionCodes.InventoryDiscard))
                            {
                                <button class="btn btn-danger btn-sm" disabled="@_busy" @onclick="() => ToggleNearExpiryDiscard(row.UnitId)">
                                    @(_discardingNearExpiryId == row.UnitId ? "Hide" : "Discard")
                                </button>
                            }
                            <a class="btn btn-ghost btn-sm" href="@InventoryUrls.Unit(row.UnitId)">Open</a>
                        </td>
                    </tr>
                    @if (_discardingNearExpiryId == row.UnitId && Session.Has(PermissionCodes.InventoryDiscard))
                    {
                        <tr>
                            <td colspan="7">
                                <div class="alert alert-info" style="margin:.25rem 0;">
                                    <p class="muted" style="margin:0 0 .5rem;">
                                        Discard <span class="mono">@row.UnitNumber</span>. It is at @row.LocationLabel. A reason and a different second verifier are required.
                                    </p>
                                    <Outcome Value="_actionFb" />
                                    <div class="flex gap" style="flex-wrap:wrap;align-items:flex-end;">
                                        <div class="field" style="flex:1;min-width:12rem;">
                                            <label>Discard reason</label>
                                            <input @bind="_nearExpiryDiscardReason" />
                                        </div>
                                        <div class="field" style="min-width:16rem;">
                                            <label>Second verifier</label>
                                            <FilterableComboBox TItem="DirectoryUserDto" TValue="string?"
                                                Items="QuarantineVerifierChoices"
                                                @bind-Value="_nearExpiryDiscardVerifier"
                                                DisplayText="@(x => x.Label)"
                                                ItemValue="@(x => x.UserName)"
                                                SearchText="@(x => x.Label)"
                                                Clearable="true"
                                                Placeholder="Different active user" />
                                        </div>
                                        <button class="btn btn-danger btn-sm" disabled="@(_busy || string.IsNullOrWhiteSpace(_nearExpiryDiscardReason))" @onclick="() => DiscardNearExpiryAsync(row.UnitId)">Discard unit</button>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
        }
    </div>
}

@if (_board == "quarantine" && (_quarantineItems.Count > 0 || Session.Has(PermissionCodes.InventoryRelease)))
{
    <div class="bb-card" id="quality-quarantine">
        <div class="bb-card-title"><h3>Quality quarantine</h3></div>
        <p class="muted">Units held for quality disposition with a coded reason (SoftBank/SafeTrace). The board shows product, the storage location name, the recorded volume, and any ABO/Rh retype mismatch. A unit with no volume says so. Release from the row with the same second-verifier gate as Manage.</p>
        @if (_quarantineItems.Count == 0)
        {
            <div class="muted">No units in quality quarantine.</div>
        }
        else
        {
            <table class="bb">
                <thead>
                    <tr>
                        <th>Unit</th>
                        <th>Product</th>
                        <th>Location</th>
                        <th>Volume</th>
                        <th>ABO/Rh</th>
                        <th>Retype</th>
                        <th>Reason</th>
                        <th>Notes</th>
                        <th>Expires</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _quarantineItems)
                    {
                        <tr>
                            <td class="mono">@row.UnitNumber</td>
                            <td class="mono">@(row.ProductCode ?? ProductName(row.ProductTypeId))</td>
                            <td>@row.LocationLabel</td>
                            <td>@row.VolumeLabel</td>
                            <td><strong>@Ui.BloodType(row.Abo, row.RhD)</strong></td>
                            <td>
                                @if (row.RetypeMismatch && row.RetypeInterpretedAbo is AboGroup interp)
                                {
                                    <span class="badge badge-red" title="Labeled @Ui.BloodType(row.Abo, row.RhD)">Retype @Ui.BloodType(interp, row.RetypeInterpretedRh ?? RhType.Unknown)</span>
                                }
                                else if (row.RetypeInterpretedAbo is AboGroup ok)
                                {
                                    <span class="muted">@Ui.BloodType(ok, row.RetypeInterpretedRh ?? RhType.Unknown)</span>
                                }
                                else
                                {
                                    <span class="muted">—</span>
                                }
                            </td>
                            <td>@row.ReasonCode</td>
                            <td>@(row.Notes ?? "—")</td>
                            <td class="nowrap">@row.ExpiresUtc.ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="right nowrap">
                                @if (Session.Has(PermissionCodes.InventoryRelease))
                                {
                                    <button class="btn btn-primary btn-sm" disabled="@_busy" @onclick="() => ToggleQuarantineRelease(row.UnitId)">
                                        @(_releasingQuarantineId == row.UnitId ? "Hide" : "Release")
                                    </button>
                                }
                                <a class="btn btn-ghost btn-sm" href="@InventoryUrls.Unit(row.UnitId)">Open</a>
                            </td>
                        </tr>
                        @if (_releasingQuarantineId == row.UnitId && Session.Has(PermissionCodes.InventoryRelease))
                        {
                            <tr>
                                <td colspan="10">
                                    <div class="alert alert-info" style="margin:.25rem 0;">
                                        <p class="muted" style="margin:0 0 .5rem;">
                                            Release <span class="mono">@row.UnitNumber</span> with the same second-verifier gate as Manage. @row.ReleasePlaceSentence @row.VolumeLabel.
                                            @if (row.RequiresLabelScan)
                                            {
                                                <span> Scan the unit number on the new label. A different number is a hard stop. Other quarantine releases do not ask for this scan.</span>
                                            }
                                            @if (row.RetypeMismatch)
                                            {
                                                <span> This unit was quarantined after an ABO/Rh retype mismatch.</span>
                                            }
                                        </p>
                                        <Outcome Value="_actionFb" />
                                        <div class="field" style="min-width:16rem;max-width:22rem;">
                                            <label>Second verifier</label>
                                            <FilterableComboBox TItem="DirectoryUserDto" TValue="string?"
                                                Items="QuarantineVerifierChoices"
                                                @bind-Value="_releaseSecondVerifier"
                                                DisplayText="@(x => x.Label)"
                                                ItemValue="@(x => x.UserName)"
                                                SearchText="@(x => x.Label)"
                                                Clearable="true"
                                                Placeholder="Different active user" />
                                        </div>
                                        @if (row.RequiresLabelScan)
                                        {
                                            <div class="field" style="min-width:16rem;max-width:22rem;">
                                                <label>Scanned unit number</label>
                                                <input class="mono" @bind="_releaseScannedUnitNumber" />
                                            </div>
                                        }
                                        <button class="btn btn-primary btn-sm" style="margin-top:.5rem;" disabled="@_busy" @onclick="() => ReleaseAsync(row.UnitId, row.RequiresLabelScan)">Release from quarantine</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        }
    </div>
}

@if (_board == "discrepancy" && (_discrepancyItems.Count > 0 || Session.Has(PermissionCodes.InventoryRelease)))
{
    <div class="bb-card">
        <div class="bb-card-title"><h3>Inventory discrepancy</h3></div>
        <p class="muted">Missing and damaged units awaiting locate or inspect (SoftBank/SafeTrace physical inventory). They cannot be issued.</p>
        @if (_discrepancyItems.Count == 0)
        {
            <div class="muted">No missing or damaged units.</div>
        }
        else
        {
            <table class="bb">
                <thead>
                    <tr>
                        <th>Unit</th>
                        <th>ABO/Rh</th>
                        <th>Product</th>
                        <th>Status</th>
                        <th>Reason</th>
                        <th>Location</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _discrepancyItems)
                    {
                        <tr>
                            <td class="mono">@row.UnitNumber</td>
                            <td><strong>@Ui.BloodType(row.Abo, row.RhD)</strong></td>
                            <td>@(row.ProductCode ?? ProductName(row.ProductTypeId))</td>
                            <td><span class="@Ui.Badge(row.Status)">@row.Status</span></td>
                            <td>@(row.Reason ?? "—")</td>
                            <td>@row.LocationLabel</td>
                            <td class="right nowrap">
                                @if (Session.Has(PermissionCodes.InventoryRelease) && row.Status == UnitStatus.Missing)
                                {
                                    <button class="btn btn-primary btn-sm" disabled="@_busy" @onclick="() => LocateMissingAsync(row.UnitId)">Locate</button>
                                }
                                @if (Session.Has(PermissionCodes.InventoryRelease) && row.Status == UnitStatus.Damaged)
                                {
                                    <button class="btn btn-primary btn-sm" disabled="@_busy" @onclick="() => InspectDamagedAsync(row.UnitId)">Inspect</button>
                                }
                                <a class="btn btn-ghost btn-sm" href="@InventoryUrls.Unit(row.UnitId)">Open</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}

@if (_board == "hold" && (_onHoldItems.Count > 0 || Session.Has(PermissionCodes.InventoryRelease)))
{
    <div class="bb-card">
        <div class="bb-card-title"><h3>Operational hold</h3></div>
        <p class="muted">Units that cannot be issued until hold is released (paperwork or pending review — not quality quarantine). Release needs the same permission as Manage.</p>
        @if (_onHoldItems.Count == 0)
        {
            <div class="muted">No units on operational hold.</div>
        }
        else
        {
            <table class="bb">
                <thead>
                    <tr>
                        <th>Unit</th>
                        <th>ABO/Rh</th>
                        <th>Product</th>
                        <th>Location</th>
                        <th>Reason</th>
                        <th>Expires</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _onHoldItems)
                    {
                        <tr>
                            <td class="mono">@row.UnitNumber</td>
                            <td><strong>@Ui.BloodType(row.Abo, row.RhD)</strong></td>
                            <td>@(row.ProductCode ?? ProductName(row.ProductTypeId))</td>
                            <td>@row.LocationLabel</td>
                            <td>@(row.HoldReason ?? "—")</td>
                            <td>@row.ExpiresUtc.ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="right nowrap">
                                @if (Session.Has(PermissionCodes.InventoryRelease))
                                {
                                    <button class="btn btn-primary btn-sm" disabled="@_busy" @onclick="() => ReleaseHoldAsync(row.UnitId)">Release from hold</button>
                                }
                                <a class="btn btn-ghost btn-sm" href="@InventoryUrls.Unit(row.UnitId)">Open</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}

@if (_board == "deliveries" && Session.Has(PermissionCodes.InventoryReceive))
{
    <div class="bb-card">
        <div class="bb-card-title"><h3>Open deliveries</h3></div>
        <p class="muted">Open a delivery to review it, or enter the units that arrived. Each delivery has one supplier and expected counts by product, such as RBC or FFP.</p>
        @if (_openDeliveries.Count == 0)
        {
            <div class="muted">No open deliveries.</div>
        }
        else
        {
            <table class="bb">
                <thead>
                    <tr>
                        <th>Delivery</th>
                        <th>Supplier</th>
                        <th>Packing list</th>
                        <th>Ordered</th>
                        <th>Received</th>
                        <th>Expected</th>
                        <th>Entered</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var delivery in _openDeliveries)
                    {
                        <tr>
                            <td class="mono"><a href="@($"/inventory/deliveries/{delivery.Id}")">@delivery.Id</a></td>
                            <td>@delivery.SupplierNameLabel</td>
                            <td class="mono">@(delivery.PackingListNumber ?? "—")</td>
                            <td>@delivery.OrderedUtc.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@delivery.ReceivedUtc.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@delivery.ExpectedQuantity</td>
                            <td>@delivery.ReceivedQuantity</td>
                            <td class="right"><a class="btn btn-primary btn-sm" href="@($"/inventory/deliveries/{delivery.Id}/receive")">Enter units</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}

@if (_board == "search")
{
<div class="bb-card">
    <div class="bb-card-title"><h3>Search</h3></div>
    <div class="form-row">
        <div class="field"><label>Unit number</label><input @bind="_searchUnit" @bind:event="oninput" @onkeydown="OnUnitSearchKey" placeholder="Type or scan, then Enter" /></div>
        <div class="field"><label>Status</label>
            <select @bind="_searchStatus"><option value="">Any</option>@foreach (var s in Enum.GetValues<UnitStatus>()) { <option value="@s">@s</option> }</select>
        </div>
        <div class="field"><label>ABO</label>
            <select @bind="_searchAbo"><option value="">Any</option>@foreach (var a in Enum.GetValues<AboGroup>()) { <option value="@a">@a</option> }</select>
        </div>
        <div class="field"><label>Rh(D)</label>
            <select @bind="_searchRh"><option value="">Any</option>@foreach (var r in Enum.GetValues<RhType>()) { <option value="@r">@r</option> }</select>
        </div>
        <div class="field">
            <label class="checkbox-item" style="margin-top:1.6rem;">
                <input type="checkbox" @bind="_showIssuedTransfused" @bind:after="SearchAsync" />
                Show issued/transfused
            </label>
        </div>
    </div>
    <button class="btn btn-secondary" disabled="@_busy" @onclick="SearchAsync">Search</button>
</div>

<div class="bb-card">
    @if (_loading)
    {
        <div class="loading">Loading units...</div>
    }
    else if (_units.Count == 0)
    {
        <div class="empty">No units match the current filters.</div>
    }
    else
    {
        <table class="bb">
            <thead><tr><th>Unit #</th><th>Product</th><th>Name</th><th>ABO/Rh</th><th>Expires</th><th>Status</th><th>Location</th><th></th></tr></thead>
            <tbody>
                @foreach (var u in _units)
                {
                    <tr>
                        <td class="mono">@u.UnitNumber</td>
                        <td class="mono">@ProductCode(u)</td>
                        <td>@ProductName(u.ProductTypeId)</td>
                        <td><strong>@Ui.BloodType(u.Abo, u.RhD)</strong></td>
                        <td class="nowrap">
                            @u.ExpiresUtc.ToString("yyyy-MM-dd HH:mm")
                            @if (u.ExpiresUtc < DateTime.UtcNow)
                            {
                                <span class="badge badge-red">Expired</span>
                            }
                            else if (_nearExpiryItems.Any(n => n.UnitId == u.Id))
                            {
                                <span class="badge badge-amber">Near expiry</span>
                            }
                        </td>
                        <td><span class="@Ui.Badge(u.Status)">@Ui.StatusLabel(u.Status)</span>
                            @if (u.Status == UnitStatus.Expected && u.ExpectedArrivalDueUtc is DateTime due && due < DateTime.UtcNow)
                            {
                                <span class="badge badge-amber">Overdue</span>
                            }
                        </td>
                        <td>@LocationName(u.CurrentLocationId)</td>
                        <td class="right"><a class="btn btn-ghost btn-sm" href="@InventoryUrls.Unit(u.Id)">Manage</a></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
}

@code {
    private List<BloodUnitDto> _units = new();
    private List<ExpectedInboundWorkItemDto> _expectedItems = new();
    private List<NearExpiryWorkItemDto> _nearExpiryItems = new();
    private List<QuarantineWorkItemDto> _quarantineItems = new();
    private List<DiscrepancyWorkItemDto> _discrepancyItems = new();
    private List<OnHoldWorkItemDto> _onHoldItems = new();
    private List<ProductRetypeWorkItemDto> _retypeItems = new();
    private bool _retypesLoading;
    private long? _expandedRetypeUnitId;
    private ProductRetypeDetailDto? _boardRetypeDetail;
    private List<ProductTypeDto> _productTypes = new();
    private List<InventoryLocationDto> _locations = new();
    private bool _loading = true;
    private bool _busy;
    private Feedback? _topFb;

    private string? _searchUnit;
    private bool _showIssuedTransfused;
    private UnitStatus? _searchStatus;
    private AboGroup? _searchAbo;
    private RhType? _searchRh;

    private List<OpenDeliveryDto> _openDeliveries = new();
    private UnitAppearance _arrivalAppearance = UnitAppearance.Acceptable;
    private string? _arrivalVisualNotes;
    private string? _supplierReturnReason;
    private string? _arrivalSecondVerifier;
    private bool _requireReceiveVerifier;
    private decimal? _arrivalTemperatureCelsius;
    private long? _confirmingExpectedId;
    private long? _releasingQuarantineId;
    private long? _discardingNearExpiryId;
    private string _nearExpiryDiscardReason = string.Empty;
    private string? _nearExpiryDiscardVerifier;

    private Feedback? _actionFb;
    private string? _releaseSecondVerifier;
    private string? _releaseScannedUnitNumber;
    private List<DirectoryUserDto> _directoryUsers = new();
    private List<PatientDto> _patients = new();

    private IEnumerable<DirectoryUserDto> QuarantineVerifierChoices =>
        _directoryUsers.Where(u => !string.Equals(u.UserName, Session.UserName, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<DirectoryUserDto> ReceiveVerifierChoices => QuarantineVerifierChoices;

    private string _board = "search";

    private string BoardClass(string board) => _board == board ? "btn-primary" : "btn-secondary";

    private void SelectBoard(string board) => _board = board;

    protected override async Task OnInitializedAsync()
    {
        if (string.Equals(Board, "retype", StringComparison.OrdinalIgnoreCase))
        {
            _board = "retype";
        }
        else if (string.Equals(Board, "quarantine", StringComparison.OrdinalIgnoreCase))
        {
            _board = "quarantine";
        }

        var policy = await Api.GetReceivePolicyAsync();
        _requireReceiveVerifier = policy.Succeeded && policy.Value?.RequireSecondVerifier == true;
        _productTypes = (await Api.GetProductTypesAsync()).Value ?? new();
        _locations = (await Api.GetLocationsAsync()).Value ?? new();
        if (Session.Has(PermissionCodes.InventoryReceive))
        {
            await LoadOpenDeliveriesAsync();
        }
        var users = await Api.GetDirectoryUsersAsync();
        if (users.Succeeded) _directoryUsers = users.Value ?? new();
        var patients = await Api.GetPatientsAsync();
        if (patients.Succeeded) _patients = patients.Value ?? new();
        await SearchAsync();
        await LoadExpectedAsync();
        await LoadNearExpiryAsync();
        await LoadQuarantineAsync();
        await LoadDiscrepancyAsync();
        await LoadOnHoldAsync();
        await LoadRetypesAsync();
        await ApplyBoardQueryAsync();
    }

    [SupplyParameterFromQuery]
    public string? Board { get; set; }

    [SupplyParameterFromQuery]
    public long? UnitId { get; set; }

    private bool _boardQueryApplied;

    private async Task ApplyBoardQueryAsync()
    {
        if (_boardQueryApplied) return;
        if (string.Equals(Board, "retype", StringComparison.OrdinalIgnoreCase))
        {
            _board = "retype";
            _boardQueryApplied = true;
            if (UnitId is long unitId)
            {
                await ToggleBoardRetype(unitId);
            }

            return;
        }

        if (string.Equals(Board, "quarantine", StringComparison.OrdinalIgnoreCase))
        {
            _board = "quarantine";
            _boardQueryApplied = true;
            _releasingQuarantineId = ModificationResultNextStep.QuarantineReleaseTarget(
                Board,
                UnitId,
                _quarantineItems.Select(item => item.UnitId));
            _releaseSecondVerifier = null;
            _releaseScannedUnitNumber = null;
            return;
        }

        if (UnitId is long manageId)
        {
            _boardQueryApplied = true;
            Nav.NavigateTo(InventoryUrls.Unit(manageId), replace: true);
        }
    }

    private string ProductCode(BloodUnitDto u)
    {
        if (!string.IsNullOrWhiteSpace(u.ProductDescriptionCode))
        {
            return u.ProductDescriptionCode;
        }

        if (!string.IsNullOrWhiteSpace(u.ProductCodeData) && u.ProductCodeData.Length >= 5)
        {
            return u.ProductCodeData[..5];
        }

        if (!string.IsNullOrWhiteSpace(u.Isbt128ProductCode))
        {
            return u.Isbt128ProductCode.Length >= 5 ? u.Isbt128ProductCode[..5] : u.Isbt128ProductCode;
        }

        return _productTypes.FirstOrDefault(t => t.Id == u.ProductTypeId)?.DisplayProductCode
            ?? u.ProductTypeId.ToString();
    }

    private string ProductName(long productTypeId) =>
        _productTypes.FirstOrDefault(t => t.Id == productTypeId)?.Name ?? "—";

    private string LocationName(long? id) =>
        StorageLocationLabel.ForInventoryList(
            id,
            _locations.Select(l => new StorageLocationLabel.CatalogLocation(l.Id, l.Name, l.Code)));

    /// <summary>
    /// Enter searches. A unit number that finds exactly one unit (typically a scanned label) opens that unit,
    /// saving the Search and Manage clicks.
    /// </summary>
    private async Task OnUnitSearchKey(KeyboardEventArgs e)
    {
        if (e.Key != "Enter") return;
        await SearchAsync();
        if (!string.IsNullOrWhiteSpace(_searchUnit) && _units.Count == 1)
        {
            Nav.NavigateTo(InventoryUrls.Unit(_units[0].Id));
        }
    }

    private async Task SearchAsync()
    {
        _loading = true;
        var criteria = new InventorySearchCriteria(
            string.IsNullOrWhiteSpace(_searchUnit) ? null : _searchUnit, _searchStatus, _searchAbo, _searchRh,
            ExcludeIssuedAndTransfused: !_showIssuedTransfused && _searchStatus is null);
        var r = await Api.SearchUnitsAsync(criteria);
        _loading = false;
        if (r.Succeeded) _units = r.Value!;
        else _topFb = r.ToFeedback();
    }

    private async Task LoadExpectedAsync()
    {
        if (!Session.Has(PermissionCodes.InventoryReceive))
        {
            _expectedItems = new();
            return;
        }

        var r = await Api.GetExpectedInboundAsync();
        if (r.Succeeded) _expectedItems = r.Value ?? new();
    }

    private async Task LoadNearExpiryAsync()
    {
        var r = await Api.GetNearExpiryUnitsAsync();
        if (r.Succeeded) _nearExpiryItems = r.Value ?? new();
    }

    private async Task LoadQuarantineAsync()
    {
        var r = await Api.GetQuarantineUnitsAsync();
        if (r.Succeeded) _quarantineItems = r.Value ?? new();
    }

    private async Task LoadDiscrepancyAsync()
    {
        if (!Session.Has(PermissionCodes.InventoryRelease))
        {
            _discrepancyItems = new();
            return;
        }

        var r = await Api.GetDiscrepancyUnitsAsync();
        if (r.Succeeded) _discrepancyItems = r.Value ?? new();
    }

    private async Task LoadOnHoldAsync()
    {
        if (!Session.Has(PermissionCodes.InventoryRelease))
        {
            _onHoldItems = new();
            return;
        }

        var r = await Api.GetOnHoldUnitsAsync();
        if (r.Succeeded) _onHoldItems = r.Value ?? new();
    }

    private async Task LoadRetypesAsync()
    {
        _retypesLoading = true;
        var r = await Api.GetPendingRetypesAsync();
        _retypesLoading = false;
        if (r.Succeeded) _retypeItems = r.Value ?? new();
    }

    private async Task ToggleBoardRetype(long unitId)
    {
        if (_expandedRetypeUnitId == unitId)
        {
            _expandedRetypeUnitId = null;
            _boardRetypeDetail = null;
            return;
        }

        _expandedRetypeUnitId = unitId;
        var r = await Api.GetUnitRetypeAsync(unitId);
        _boardRetypeDetail = r.Value;
        if (!r.Succeeded)
        {
            // The row only shows "Loading retype..." here, so report the failure at the top and close it.
            _topFb = r.ToFeedback();
            _expandedRetypeUnitId = null;
        }
    }

    private async Task OnBoardRetypeSaved(Feedback? outcome)
    {
        // The row collapses, taking the panel's message with it, so repeat the outcome at the top.
        _topFb = outcome;
        await Js.ScrollIntoViewAsync("inventory-top-outcome");
        _expandedRetypeUnitId = null;
        _boardRetypeDetail = null;
        await LoadRetypesAsync();
        await LoadQuarantineAsync();
        await SearchAsync();
    }

    private void ToggleExpectedConfirm(long unitId)
    {
        _confirmingExpectedId = _confirmingExpectedId == unitId ? null : unitId;
        _actionFb = null;
    }

    private void ToggleNearExpiryDiscard(long unitId)
    {
        _discardingNearExpiryId = _discardingNearExpiryId == unitId ? null : unitId;
        _nearExpiryDiscardReason = string.Empty;
        _nearExpiryDiscardVerifier = null;
        _actionFb = null;
    }

    private async Task DiscardNearExpiryAsync(long id)
    {
        _busy = true;
        var r = await Api.DiscardUnitAsync(id, _nearExpiryDiscardReason, _nearExpiryDiscardVerifier);
        _busy = false;
        _actionFb = r.ToFeedback("Unit discarded.");
        if (r.Succeeded)
        {
            _discardingNearExpiryId = null;
            _nearExpiryDiscardReason = string.Empty;
            _nearExpiryDiscardVerifier = null;
            await LoadNearExpiryAsync();
            await SearchAsync();
        }
    }

    private void ToggleQuarantineRelease(long unitId)
    {
        _releasingQuarantineId = _releasingQuarantineId == unitId ? null : unitId;
        _releaseSecondVerifier = null;
        _releaseScannedUnitNumber = null;
        _actionFb = null;
    }

    private async Task LoadOpenDeliveriesAsync()
    {
        var r = await Api.GetOpenDeliveriesAsync();
        _openDeliveries = r.Succeeded ? r.Value ?? new() : new();
        if (!r.Succeeded) _topFb = r.ToFeedback();
    }

    private async Task ExpireDueAsync()
    {
        _busy = true;
        var r = await Api.ExpireDueAsync();
        _busy = false;
        _topFb = r.Succeeded
            ? new Feedback(true, $"Expiration sweep complete: {r.Value!.Expired} unit(s) expired.", Array.Empty<RuleMessage>(), false, false, Array.Empty<RuleMessage>(), null)
            : r.ToFeedback();
        if (r.Succeeded)
        {
            await SearchAsync();
            await LoadNearExpiryAsync();
            await LoadQuarantineAsync();
        }
    }

    private async Task ReloadBoardsAsync()
    {
        await SearchAsync();
        if (Session.Has(PermissionCodes.InventoryReceive))
        {
            await LoadOpenDeliveriesAsync();
        }
        await LoadExpectedAsync();
        await LoadNearExpiryAsync();
        await LoadQuarantineAsync();
        await LoadDiscrepancyAsync();
        await LoadOnHoldAsync();
        await LoadRetypesAsync();
    }

    private async Task ReleaseAsync(long id, bool requiresLabelScan = false)
    {
        _busy = true;
        var r = await Api.ReleaseUnitAsync(id, new ReleaseFromQuarantineRequest(
            _releaseSecondVerifier,
            requiresLabelScan ? _releaseScannedUnitNumber : null));
        _busy = false;
        _actionFb = r.ToFeedback("Unit released from quarantine.");
        if (r.Succeeded)
        {
            _topFb = _actionFb;
            _releaseSecondVerifier = null;
            _releaseScannedUnitNumber = null;
            _releasingQuarantineId = null;
            await ReloadBoardsAsync();
        }
    }

    private async Task ReleaseHoldAsync(long id)
    {
        _busy = true;
        var r = await Api.ReleaseHoldAsync(id);
        _busy = false;
        _topFb = r.ToFeedback("Unit released from operational hold.");
        await Js.ScrollIntoViewAsync("inventory-top-outcome");
        if (r.Succeeded) await ReloadBoardsAsync();
    }

    private async Task LocateMissingAsync(long id)
    {
        _busy = true;
        var r = await Api.LocateMissingAsync(id);
        _busy = false;
        _topFb = r.ToFeedback("Unit located into quarantine for inspection.");
        await Js.ScrollIntoViewAsync("inventory-top-outcome");
        if (r.Succeeded) await ReloadBoardsAsync();
    }

    private async Task InspectDamagedAsync(long id)
    {
        _busy = true;
        var r = await Api.InspectDamagedAsync(id);
        _busy = false;
        _topFb = r.ToFeedback("Damaged unit moved to quarantine for quality review.");
        await Js.ScrollIntoViewAsync("inventory-top-outcome");
        if (r.Succeeded) await ReloadBoardsAsync();
    }

    private async Task ReceiveExpectedAsync(long id)
    {
        _busy = true;
        var r = await Api.ReceiveExpectedUnitAsync(id, new ReceiveExpectedUnitRequest(
            VisualInspectionAcceptable: _arrivalAppearance == UnitAppearance.Acceptable,
            VisualInspectionNotes: string.IsNullOrWhiteSpace(_arrivalVisualNotes) ? null : _arrivalVisualNotes,
            SecondVerifier: _requireReceiveVerifier ? _arrivalSecondVerifier : null,
            Appearance: _arrivalAppearance,
            ReceiveTemperatureCelsius: _arrivalTemperatureCelsius));
        _busy = false;
        _actionFb = r.ToFeedback(r.Value?.Status == UnitStatus.Received
            ? "Arrival confirmed. Pending retype until results are entered and verified."
            : "Arrival confirmed into quarantine.");
        if (r.Succeeded)
        {
            _arrivalAppearance = UnitAppearance.Acceptable;
            _arrivalVisualNotes = null;
            _arrivalSecondVerifier = null;
            _arrivalTemperatureCelsius = null;
            _supplierReturnReason = null;
            _confirmingExpectedId = null;
            _topFb = _actionFb;
            await ReloadBoardsAsync();
        }
    }

    private string? SupplierReturnReasonForExpected() =>
        ReceiveAppearanceRule.SuggestedSupplierReturnReason(
            _arrivalAppearance, _arrivalVisualNotes, _supplierReturnReason);

    private async Task ReturnExpectedToSupplierAsync(long id)
    {
        var reason = SupplierReturnReasonForExpected();
        if (string.IsNullOrWhiteSpace(reason))
        {
            _actionFb = Feedback.Fail("A reason is required to return a unit to the supplier.");
            return;
        }

        _busy = true;
        var r = await Api.ReturnToSupplierAsync(id, reason);
        _busy = false;
        _actionFb = r.ToFeedback("Unit returned to the supplier.");
        if (r.Succeeded)
        {
            _arrivalAppearance = UnitAppearance.Acceptable;
            _arrivalVisualNotes = null;
            _arrivalSecondVerifier = null;
            _arrivalTemperatureCelsius = null;
            _supplierReturnReason = null;
            _confirmingExpectedId = null;
            _topFb = _actionFb;
            await ReloadBoardsAsync();
        }
    }

}
