@page "/inventory"
@using BloodBankLIS.Application.Inventory
@using BloodBankLIS.Application.Issuing
@using BloodBankLIS.Application.Reference
@using BloodBankLIS.Domain.Rules
@inject BloodBankApiClient Api
@inject UserSession Session
@inject NavigationManager Nav
@inject IJSRuntime Js

<PageTitle>Inventory &middot; HemoCore</PageTitle>

<InventoryDeskRibbon Current="@(string.Equals(Board, "retype", StringComparison.OrdinalIgnoreCase) ? InventoryDeskRibbon.Desk.Retype : InventoryDeskRibbon.Desk.Inventory)" />

<div class="flex-between" style="margin-bottom:1rem;">
    <h1>Blood Product Inventory</h1>
    <div class="flex gap">
        @if (Session.Has(PermissionCodes.InventoryReceive))
        {
            <a class="btn btn-primary" href="/inventory/deliveries/new">New delivery</a>
            <a class="btn btn-secondary" href="/inventory/return-to-supplier" data-return-to-supplier>Return to supplier</a>
            <a class="btn btn-secondary" href="/inventory/ship-out" data-ship-out>Ship to facility</a>
        }
        @if (Session.Has(PermissionCodes.InventoryTransfer))
        {
            <a class="btn btn-secondary" href="/inventory/move" data-move-units>Move units</a>
            <a class="btn btn-secondary" href="/inventory/count" data-stock-count>Stock count</a>
        }
        @if (Session.Has(PermissionCodes.InventoryDiscard))
        {
            <a class="btn btn-secondary" href="/inventory/discard-expired" data-discard-expired>Discard expired</a>
            <button class="btn btn-secondary" disabled="@_busy" @onclick="ExpireDueAsync">Run expiration sweep</button>
        }
    </div>
</div>

<div id="inventory-top-outcome"><Outcome Value="_topFb" /></div>

<div class="flex gap" style="margin-bottom:1rem;flex-wrap:wrap;">
    <button type="button" class="btn @BoardClass("search")" @onclick='() => SelectBoard("search")'>Search</button>
    <button type="button" class="btn @BoardClass("expected")" @onclick='() => SelectBoard("expected")'>Expected inbound</button>
    <button type="button" class="btn @BoardClass("retype")" @onclick='() => SelectBoard("retype")'>Retype</button>
    <button type="button" class="btn @BoardClass("near")" @onclick='() => SelectBoard("near")'>Near expiry</button>
    <button type="button" class="btn @BoardClass("quarantine")" @onclick='() => SelectBoard("quarantine")'>Quarantine</button>
    <button type="button" class="btn @BoardClass("discrepancy")" @onclick='() => SelectBoard("discrepancy")'>Discrepancy</button>
    <button type="button" class="btn @BoardClass("hold")" @onclick='() => SelectBoard("hold")'>Operational hold</button>
    <button type="button" class="btn @BoardClass("deliveries")" @onclick='() => SelectBoard("deliveries")'>Open deliveries</button>
</div>

@if (_board == "expected" && (_expectedItems.Count > 0 || Session.Has(PermissionCodes.InventoryReceive)))
{
    <div class="bb-card">
        <div class="bb-card-title"><h3>Expected inbound</h3></div>
        <p class="muted">Packing-list units that have not arrived. Confirm arrival from the row.</p>
        <details class="bb-help">
            <summary>Arrival rules</summary>
            <ul>
                <li>Confirm arrival here with appearance, cooler temperature, and a second verifier — the same receive gates as the Manage drawer.</li>
                <li>A unit that fails appearance or temperature is returned to the supplier from this row.</li>
                <li>An outdated unit says Outdated and is not received; return it to the supplier.</li>
                <li>Overdue after the facility arrival window (default 24 hours).</li>
                <li>Late arrival is still allowed.</li>
            </ul>
        </details>
        @if (_expectedItems.Count == 0)
        {
            <div class="muted">No expected inbound units.</div>
        }
        else
        {
            <table class="bb">
                <thead>
                    <tr>
                        <th>Unit</th>
                        <th>ABO/Rh</th>
                        <th>Product</th>
                        <th>Shipment</th>
                        <th>Supplier</th>
                        <th>Recorded</th>
                        <th>Due</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _expectedItems)
                    {
                        <tr>
                            <td><UnitLink Id="row.UnitId" Number="@row.UnitNumber" /></td>
                            <td><strong>@Ui.BloodType(row.Abo, row.RhD)</strong></td>
                            <td>@ProductName(row.ProductTypeId)</td>
                            <td class="mono">@(row.ShipmentId ?? "—")</td>
                            <td>@(row.SupplierLabel ?? "—")</td>
                            <td>@row.CreatedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                            <td>
                                @(row.DueUtc?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "—")
                                @if (row.IsOutdated)
                                {
                                    <span class="badge badge-red" title="This unit is outdated and cannot be received. Return it to the supplier.">Outdated</span>
                                }
                                else if (row.IsOverdue)
                                {
                                    <span class="badge badge-amber">Overdue</span>
                                }
                            </td>
                            <td class="right nowrap">
                                @if (Session.Has(PermissionCodes.InventoryReceive))
                                {
                                    <button class="btn @(row.IsOutdated ? "btn-ghost" : "btn-primary") btn-sm" disabled="@_busy" @onclick="() => ToggleExpectedConfirm(row.UnitId)">
                                        @(_confirmingExpectedId == row.UnitId ? "Hide" : row.IsOutdated ? "Return" : "Confirm")
                                    </button>
                                }
                                <a class="btn btn-ghost btn-sm" href="@InventoryUrls.Unit(row.UnitId)">Open</a>
                            </td>
                        </tr>
                        @if (_confirmingExpectedId == row.UnitId && Session.Has(PermissionCodes.InventoryReceive))
                        {
                            <tr>
                                <td colspan="8">
                                    <div class="alert alert-info" style="margin:.25rem 0;">
                                        @if (row.IsOutdated)
                                        {
                                            <p class="muted" style="margin:0 0 .5rem;">@row.UnitNumber is outdated and cannot be received. Return it to the supplier.</p>
                                        }
                                        else
                                        {
                                            <p class="muted" style="margin:0 0 .5rem;">Confirm arrival of <span class="mono">@row.UnitNumber</span> with the same visual and temperature gates as walk-in receive.</p>
                                        }
                                        <Outcome Value="_actionFb" />
                                        @if (!row.IsOutdated)
                                        {
                                        <div class="form-row">
                                            <AppearanceSelect @bind-Value="_arrivalAppearance" />
                                            <div class="field"><label>Arrival notes</label>
                                                <input @bind="_arrivalVisualNotes" placeholder="Appearance, defects" />
                                            </div>
                                            <div class="field"><label>Receipt temperature (°C)</label>
                                                <input type="number" step="0.1" @bind="_arrivalTemperatureCelsius" placeholder="e.g. 4.0" />
                                                <span class="muted">Shipping range @ReceiveTemperatureRule.MinCelsius.ToString("0")–@ReceiveTemperatureRule.MaxCelsius.ToString("0") °C.</span>
                                            </div>
                                            @if (_requireReceiveVerifier)
                                            {
                                                <div class="field" style="min-width:16rem;"><label>Second verifier</label>
                                                    <FilterableComboBox TItem="DirectoryUserDto" TValue="string?"
                                                        Items="ReceiveVerifierChoices"
                                                        @bind-Value="_arrivalSecondVerifier"
                                                        DisplayText="@(x => x.Label)"
                                                        ItemValue="@(x => x.UserName)"
                                                        SearchText="@(x => x.Label)"
                                                        Clearable="true"
                                                        Placeholder="Different active user" />
                                                </div>
                                            }
                                        </div>
                                        @if (_arrivalAppearance is not null and not UnitAppearance.Acceptable)
                                        {
                                            <p class="muted" style="margin:.35rem 0 0;">This appearance is not received. Return the unit to the supplier.</p>
                                        }
                                        }
                                        <div class="flex gap" style="margin-top:.5rem;flex-wrap:wrap;align-items:end;">
                                            @if (!row.IsOutdated)
                                            {
                                                <button class="btn btn-primary btn-sm" disabled="@_busy" @onclick="() => ReceiveExpectedAsync(row.UnitId)">Confirm arrival</button>
                                            }
                                            <div class="field" style="min-width:16rem;margin:0;">
                                                <label>Return to supplier</label>
                                                <input @bind="_supplierReturnReason" @bind:event="oninput" placeholder="Failed inspection / refused at dock" />
                                            </div>
                                            <button class="btn btn-danger btn-sm" disabled="@(_busy || string.IsNullOrWhiteSpace(SupplierReturnReasonForExpected()))" @onclick="() => ReturnExpectedToSupplierAsync(row.UnitId)">Return to supplier</button>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        }
    </div>
}

@if (_board == "retype" && (_retypeItems.Count > 0 || Session.Has(PermissionCodes.ResultEnter)))
{
    <div id="pending-retype" class="bb-card">
        <div class="bb-card-title">
            <h3>Pending ABO/Rh retype</h3>
            <button class="btn btn-secondary btn-sm" disabled="@_busy" @onclick="LoadRetypesAsync">Refresh</button>
        </div>
        <p class="muted">Received units need a front-type confirmation before they become Available. A match releases the unit; a mismatch quarantines it.</p>
        @if (Session.HasAny(PermissionCodes.ResultEnter, PermissionCodes.ResultVerify) && _retypeItems.Count > 0)
        {
            <div class="field" style="max-width:24rem;">
                <label>Scan a unit to retype</label>
                <input @ref="_retypeScanInput" @bind="_retypeScan" @bind:event="oninput" @onkeydown="OnRetypeScanKey" placeholder="Scan the unit label or type, then Enter" autocomplete="off" data-retype-scan />
            </div>
            @if (_retypeScanMessage is not null)
            {
                <p class="muted" data-retype-scan-message>@_retypeScanMessage</p>
            }
        }
        <details class="bb-help">
            <summary>About retypes</summary>
            <ul>
                <li>An outdated unit is marked Outdated: a matching retype records the type and moves it to Expired instead of Available.</li>
                <li>The test worklist lists the same units and opens this board.</li>
                <li>The Manage drawer can still record a retype while you are already on the unit.</li>
            </ul>
        </details>
        @if (_retypesLoading)
        {
            <div class="loading">Loading retypes...</div>
        }
        else if (_retypeItems.Count == 0)
        {
            <div class="muted">No units are waiting for an ABO/Rh retype.</div>
        }
        else
        {
            <div class="table-scroll">
            <table class="bb">
                <thead>
                    <tr>
                        <th>Unit</th>
                        <th>Product</th>
                        <th>Test</th>
                        <th>Labeled ABO/Rh</th>
                        <th>Received</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _retypeItems)
                    {
                        <tr>
                            <td><UnitLink Id="row.UnitId" Number="@row.UnitNumber" /></td>
                            <td>
                                <span class="mono">@row.ProductCode</span>
                                <span class="muted">@row.ProductName</span>
                            </td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(row.TestCode))
                                {
                                    <strong>@(row.TestName ?? row.TestCode)</strong>
                                    <span class="mono muted">@row.TestCode</span>
                                }
                                else
                                {
                                    <span class="muted">—</span>
                                }
                            </td>
                            <td><strong>@Ui.BloodType(row.Abo, row.RhD)</strong></td>
                            <td class="nowrap">@row.ReceivedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                            <td>
                                <span class="@Ui.Badge(row.Status)">@Ui.StatusLabel(row.Status)</span>
                                @if (row.Expired)
                                {
                                    <span class="badge badge-red" title="A matching retype records the type and moves this unit to Expired.">Outdated</span>
                                }
                            </td>
                            <td class="right nowrap">
                                @if (Session.HasAny(PermissionCodes.ResultEnter, PermissionCodes.ResultVerify))
                                {
                                    <button class="btn btn-primary btn-sm" disabled="@_busy" @onclick="() => ToggleBoardRetype(row.UnitId)">
                                        @(_expandedRetypeUnitId == row.UnitId ? "Hide" : Session.Has(PermissionCodes.ResultEnter) ? "Enter" : "Verify")
                                    </button>
                                }
                                <a class="btn btn-ghost btn-sm" href="@InventoryUrls.Unit(row.UnitId)">Open</a>
                            </td>
                        </tr>
                        @if (_expandedRetypeUnitId == row.UnitId && Session.HasAny(PermissionCodes.ResultEnter, PermissionCodes.ResultVerify))
                        {
                            <tr>
                                <td colspan="7">
                                    @if (_boardRetypeDetail?.UnitId == row.UnitId)
                                    {
                                        <ProductRetypeEntryPanel Detail="_boardRetypeDetail" OnSaved="OnBoardRetypeSaved" />
                                    }
                                    else
                                    {
                                        <div class="loading">Loading retype...</div>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
            </div>
        }
    </div>
}

@if (_board == "near")
{
    <div class="bb-card">
        <div class="bb-card-title"><h3>Near expiry</h3></div>
        <p class="muted">On-hand units that expire within the facility warning window (default 24 hours). Use them first: issue one reserved for a patient, or allocate it to an open order for its product. Discard only a unit that cannot be used, with a coded reason and a second verifier, as on the unit page.</p>
        @if (_nearExpiryItems.Count == 0)
        {
            <div class="muted">No units near expiry.</div>
        }
        else
        {
        <table class="bb">
            <thead>
                <tr>
                    <th>Unit</th>
                    <th>ABO/Rh</th>
                    <th>Product</th>
                    <th>Location</th>
                    <th>Status</th>
                    <th>Expires</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in _nearExpiryItems)
                {
                    <tr>
                        <td>
                            <UnitLink Id="row.UnitId" Number="@row.UnitNumber" />
                            @if (row.ReservedPatientId is long reservedPatientId)
                            {
                                <span class="sub">Reserved for <a href="@($"/patients/{reservedPatientId}?tab=products")">@row.ReservedPatientLabel</a></span>
                            }
                        </td>
                        <td><strong>@Ui.BloodType(row.Abo, row.RhD)</strong></td>
                        <td>@ProductName(row.ProductTypeId)</td>
                        <td>@row.LocationLabel</td>
                        <td><span class="@Ui.Badge(row.Status)">@Ui.EnumText(row.Status)</span></td>
                        <td class="nowrap">
                            @row.ExpiresUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                            <span class="badge badge-amber">Near expiry</span>
                            @if (row.IsReserved)
                            {
                                <span class="badge badge-amber" title="@NearExpiryWorkItemDto.ReservedNextStep">Reserved</span>
                            }
                        </td>
                        <td class="right nowrap">
                            @{ var openOrders = _nearOpenOrdersByProduct.GetValueOrDefault(row.ProductTypeId); }
                            @switch (IssueRun.ForNearExpiry(row.IsReserved, _nearReady.FirstOrDefault(r => r.BloodUnitId == row.UnitId), openOrders))
                            {
                                case NearExpiryNextStep.Issue:
                                    <a class="btn btn-primary btn-sm" href="@($"/issuing?desk=issue&bloodUnitId={row.UnitId}")" title="Issue it to the patient it is reserved for before it expires">Issue</a>
                                    break;
                                case NearExpiryNextStep.Allocate:
                                    <a class="btn btn-secondary btn-sm" href="@InventoryUrls.Unit(row.UnitId, "actions")" title="Allocate it to an open order before it expires; compatibility is checked when you allocate">@openOrders open @(openOrders == 1 ? "order" : "orders") for this product</a>
                                    break;
                            }
                            <a class="btn btn-ghost btn-sm" href="@InventoryUrls.Unit(row.UnitId)">Open</a>
                            @if (Session.Has(PermissionCodes.InventoryDiscard))
                            {
                                <button class="btn btn-danger btn-sm" disabled="@_busy" @onclick="() => ToggleNearExpiryDiscard(row.UnitId)">
                                    @(_discardingNearExpiryId == row.UnitId ? "Hide" : "Discard")
                                </button>
                            }
                        </td>
                    </tr>
                    @if (_discardingNearExpiryId == row.UnitId && Session.Has(PermissionCodes.InventoryDiscard))
                    {
                        <tr>
                            <td colspan="7">
                                <div class="alert alert-info" style="margin:.25rem 0;">
                                    <p class="muted" style="margin:0 0 .5rem;">
                                        Discard <span class="mono">@row.UnitNumber</span>. It is at @row.LocationLabel. A reason and a different second verifier are required.
                                    </p>
                                    <Outcome Value="_actionFb" />
                                    <div class="flex gap" style="flex-wrap:wrap;align-items:flex-end;">
                                        <div class="field" style="min-width:14rem;">
                                            <label>Discard reason</label>
                                            <select @bind="_nearExpiryDiscardReason" data-near-discard-reason>
                                                <option value="">Select</option>
                                                @foreach (var reason in _discardReasons)
                                                {
                                                    <option value="@reason.Code">@reason.Code — @reason.Text</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="field" style="flex:1;min-width:12rem;">
                                            <label>Comment@(NearExpiryCommentRequired ? " (required)" : "")</label>
                                            <input @bind="_nearExpiryDiscardComment" @bind:event="oninput" />
                                        </div>
                                        <div class="field" style="min-width:16rem;">
                                            <label>Second verifier</label>
                                            <FilterableComboBox TItem="DirectoryUserDto" TValue="string?"
                                                Items="QuarantineVerifierChoices"
                                                @bind-Value="_nearExpiryDiscardVerifier"
                                                DisplayText="@(x => x.Label)"
                                                ItemValue="@(x => x.UserName)"
                                                SearchText="@(x => x.Label)"
                                                Clearable="true"
                                                Placeholder="Different active user" />
                                        </div>
                                        <button class="btn btn-danger btn-sm" disabled="@(_busy || string.IsNullOrWhiteSpace(_nearExpiryDiscardReason) || (NearExpiryCommentRequired && string.IsNullOrWhiteSpace(_nearExpiryDiscardComment)))" @onclick="() => DiscardNearExpiryAsync(row.UnitId)">Discard unit</button>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
        }
    </div>
}

@if (_board == "quarantine" && (_quarantineItems.Count > 0 || Session.Has(PermissionCodes.InventoryRelease)))
{
    <div class="bb-card" id="quality-quarantine">
        <div class="bb-card-title"><h3>Quality quarantine</h3></div>
        <p class="muted">Units held for quality disposition with a coded reason (SoftBank/SafeTrace). The board shows product, the storage location name, the recorded volume, and any ABO/Rh retype mismatch. A unit with no volume says so. Release from the row with the same second-verifier gate as Manage.</p>
        @if (_quarantineItems.Count == 0)
        {
            <div class="muted">No units in quality quarantine.</div>
        }
        else
        {
            <table class="bb">
                <thead>
                    <tr>
                        <th>Unit</th>
                        <th>Product</th>
                        <th>Location</th>
                        <th>Volume</th>
                        <th>ABO/Rh</th>
                        <th>Retype</th>
                        <th>Reason</th>
                        <th>Notes</th>
                        <th>Expires</th>
                        <th>Next step</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _quarantineItems)
                    {
                        <tr>
                            <td><UnitLink Id="row.UnitId" Number="@row.UnitNumber" /></td>
                            <td class="mono">@(row.ProductCode ?? ProductName(row.ProductTypeId))</td>
                            <td>@row.LocationLabel</td>
                            <td>@row.VolumeLabel</td>
                            <td><strong>@Ui.BloodType(row.Abo, row.RhD)</strong></td>
                            <td>
                                @if (row.RetypeMismatch && row.RetypeInterpretedAbo is AboGroup interp)
                                {
                                    <span class="badge badge-red" title="Labeled @Ui.BloodType(row.Abo, row.RhD)">Retype @Ui.BloodType(interp, row.RetypeInterpretedRh ?? RhType.Unknown)</span>
                                }
                                else if (row.RetypeInterpretedAbo is AboGroup ok)
                                {
                                    <span class="muted">@Ui.BloodType(ok, row.RetypeInterpretedRh ?? RhType.Unknown)</span>
                                }
                                else
                                {
                                    <span class="muted">—</span>
                                }
                            </td>
                            <td>@row.ReasonCode</td>
                            <td>@(row.Notes ?? "—")</td>
                            <td class="nowrap">@row.ExpiresUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                            <td>
                                @if (row.CanRelease)
                                {
                                    @row.NextStep
                                }
                                else
                                {
                                    <span class="badge badge-red">@row.NextStep</span>
                                }
                            </td>
                            <td class="right nowrap">
                                @if (Session.Has(PermissionCodes.InventoryRelease) && row.CanRelease)
                                {
                                    <button class="btn btn-primary btn-sm" disabled="@_busy" @onclick="() => ToggleQuarantineRelease(row.UnitId)">
                                        @(_releasingQuarantineId == row.UnitId ? "Hide" : "Release")
                                    </button>
                                }
                                <a class="btn btn-ghost btn-sm" href="@InventoryUrls.Unit(row.UnitId)">Open</a>
                            </td>
                        </tr>
                        @if (_releasingQuarantineId == row.UnitId && Session.Has(PermissionCodes.InventoryRelease))
                        {
                            <tr>
                                <td colspan="11">
                                    <div class="alert alert-info" style="margin:.25rem 0;">
                                        <p class="muted" style="margin:0 0 .5rem;">
                                            Release <span class="mono">@row.UnitNumber</span> with the same second-verifier gate as Manage. @row.ReleasePlaceSentence @row.VolumeLabel.
                                            @if (row.RequiresLabelScan)
                                            {
                                                <span> Scan the unit number on the new label. A different number is a hard stop. Other quarantine releases do not ask for this scan.</span>
                                            }
                                            @if (row.RetypeMismatch)
                                            {
                                                <span> This unit was quarantined after an ABO/Rh retype mismatch.</span>
                                            }
                                        </p>
                                        <Outcome Value="_actionFb" />
                                        <div class="field" style="min-width:16rem;max-width:22rem;">
                                            <label>Second verifier</label>
                                            <FilterableComboBox TItem="DirectoryUserDto" TValue="string?"
                                                Items="QuarantineVerifierChoices"
                                                @bind-Value="_releaseSecondVerifier"
                                                DisplayText="@(x => x.Label)"
                                                ItemValue="@(x => x.UserName)"
                                                SearchText="@(x => x.Label)"
                                                Clearable="true"
                                                Placeholder="Different active user" />
                                        </div>
                                        @if (row.RequiresLabelScan)
                                        {
                                            <div class="field" style="min-width:16rem;max-width:22rem;">
                                                <label>Scanned unit number</label>
                                                <input class="mono" @bind="_releaseScannedUnitNumber" />
                                            </div>
                                        }
                                        <button class="btn btn-primary btn-sm" style="margin-top:.5rem;" disabled="@_busy" @onclick="() => ReleaseAsync(row.UnitId, row.RequiresLabelScan)">Release from quarantine</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        }
    </div>
}

@if (_board == "discrepancy" && (_discrepancyItems.Count > 0 || Session.Has(PermissionCodes.InventoryRelease)))
{
    <div class="bb-card">
        <div class="bb-card-title"><h3>Inventory discrepancy</h3></div>
        <p class="muted">Missing and damaged units awaiting locate or inspect (SoftBank/SafeTrace physical inventory). They cannot be issued.</p>
        @if (_discrepancyItems.Count == 0)
        {
            <div class="muted">No missing or damaged units.</div>
        }
        else
        {
            <div class="table-scroll">
            <table class="bb">
                <thead>
                    <tr>
                        <th>Unit</th>
                        <th>ABO/Rh</th>
                        <th>Product</th>
                        <th>Status</th>
                        <th>Reason</th>
                        <th>Location</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _discrepancyItems)
                    {
                        <tr>
                            <td><UnitLink Id="row.UnitId" Number="@row.UnitNumber" /></td>
                            <td><strong>@Ui.BloodType(row.Abo, row.RhD)</strong></td>
                            <td>@(row.ProductCode ?? ProductName(row.ProductTypeId))</td>
                            <td><span class="@Ui.Badge(row.Status)">@Ui.EnumText(row.Status)</span></td>
                            <td>@(row.Reason ?? "—")</td>
                            <td>@row.LocationLabel</td>
                            <td class="right nowrap">
                                @if (Session.Has(PermissionCodes.InventoryRelease) && row.Status is UnitStatus.Missing or UnitStatus.Damaged)
                                {
                                    <button class="btn btn-primary btn-sm" disabled="@_busy" @onclick="() => BeginDiscrepancy(row.UnitId)">
                                        @(_discrepancyUnitId == row.UnitId ? "Hide" : row.Status == UnitStatus.Missing ? "Locate" : "Inspect")
                                    </button>
                                }
                                <a class="btn btn-ghost btn-sm" href="@InventoryUrls.Unit(row.UnitId)">Open</a>
                            </td>
                        </tr>
                        @if (_discrepancyUnitId == row.UnitId)
                        {
                            <tr>
                                <td colspan="7">
                                    <div class="flex gap" style="align-items:flex-end;flex-wrap:wrap;">
                                        <div class="field" style="min-width:20rem;margin:0;">
                                            <label>@(row.Status == UnitStatus.Missing ? "Where and how was it found?" : "What did the inspection show?")</label>
                                            <input @bind="_discrepancyNote" @bind:event="oninput" placeholder="@(row.Status == UnitStatus.Missing ? "e.g. Back of shelf 2, OR satellite fridge" : "e.g. Port intact, small crease in overwrap, no leak")" />
                                        </div>
                                        <button class="btn btn-primary btn-sm" disabled="@(_busy || string.IsNullOrWhiteSpace(_discrepancyNote))"
                                                @onclick="() => row.Status == UnitStatus.Missing ? LocateMissingAsync(row.UnitId) : InspectDamagedAsync(row.UnitId)">
                                            @(row.Status == UnitStatus.Missing ? "Record found, to quarantine" : "Record inspection, to quarantine")
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
            </div>
        }
    </div>
}

@if (_board == "hold" && (_onHoldItems.Count > 0 || Session.Has(PermissionCodes.InventoryRelease)))
{
    <div class="bb-card">
        <div class="bb-card-title"><h3>Operational hold</h3></div>
        <p class="muted">Units that cannot be issued until hold is released (paperwork or pending review — not quality quarantine). Release needs the same permission as Manage.</p>
        @if (_onHoldItems.Count == 0)
        {
            <div class="muted">No units on operational hold.</div>
        }
        else
        {
            <div class="table-scroll">
            <table class="bb">
                <thead>
                    <tr>
                        <th>Unit</th>
                        <th>ABO/Rh</th>
                        <th>Product</th>
                        <th>Location</th>
                        <th>Reason</th>
                        <th>Expires</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _onHoldItems)
                    {
                        <tr>
                            <td><UnitLink Id="row.UnitId" Number="@row.UnitNumber" /></td>
                            <td><strong>@Ui.BloodType(row.Abo, row.RhD)</strong></td>
                            <td>@(row.ProductCode ?? ProductName(row.ProductTypeId))</td>
                            <td>@row.LocationLabel</td>
                            <td>@(row.HoldReason ?? "—")</td>
                            <td>@row.ExpiresUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="right nowrap">
                                @if (row.ExpiresUtc <= DateTime.UtcNow)
                                {
                                    <span class="badge badge-red">@HoldReleaseRule.ExpiredNextStep</span>
                                }
                                else if (Session.Has(PermissionCodes.InventoryRelease))
                                {
                                    <button class="btn btn-primary btn-sm" disabled="@_busy" @onclick="() => BeginHoldRelease(row.UnitId)">@(_releasingHoldId == row.UnitId ? "Hide" : "Release from hold")</button>
                                }
                                <a class="btn btn-ghost btn-sm" href="@InventoryUrls.Unit(row.UnitId)">Open</a>
                            </td>
                        </tr>
                        @if (_releasingHoldId == row.UnitId)
                        {
                            <tr>
                                <td colspan="7">
                                    <div class="flex gap" style="align-items:flex-end;flex-wrap:wrap;">
                                        <div class="field" style="min-width:18rem;margin:0;"><label>How was the hold resolved?</label>
                                            <input @bind="_holdReleaseReason" @bind:event="oninput" placeholder="e.g. Supplier paperwork received" />
                                        </div>
                                        <button class="btn btn-primary btn-sm" disabled="@(_busy || string.IsNullOrWhiteSpace(_holdReleaseReason))" @onclick="() => ReleaseHoldAsync(row.UnitId)">Release from hold</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
            </div>
        }
    </div>
}

@if (_board == "deliveries" && Session.Has(PermissionCodes.InventoryReceive))
{
    <div class="bb-card">
        <div class="bb-card-title"><h3>Open deliveries</h3></div>
        <p class="muted">Open a delivery to review it, or enter the units that arrived. Each delivery has one supplier and expected counts by product, such as RBC or FFP.</p>
        @if (_openDeliveries.Count == 0)
        {
            <div class="muted">No open deliveries.</div>
        }
        else
        {
