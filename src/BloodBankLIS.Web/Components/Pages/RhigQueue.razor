@page "/rhig"
@using BloodBankLIS.Application.Immunohematology
@inject BloodBankApiClient Api

<PageTitle>Open RhIG evaluations &middot; HemoCore</PageTitle>

<h1>Open RhIG evaluations</h1>
<p class="muted">
    RhIG evaluations recorded on patient charts and not yet completed, and completed candidates with no RhIG given recorded
    (<strong>To give</strong>), oldest event first. <strong>Ready</strong> means the
    record says what was decided and can be completed by a verifier; the others still need the decision, the vials, the
    quantitation, or a reason. Open a chart to finish or complete it. <strong>Suggested</strong> is what the facts on file
    suggest and the dose calculated from the facility's RhIG dose settings; the reviewer decides (OCD-069).
</p>
<Outcome Value="_fb" />

<div class="bb-card" data-rhig-lot-trace>
    <div class="bb-card-title"><h3>Who received an RhIG lot</h3></div>
    <p class="muted" style="margin-top:0;">For a recall: scan or type a lot number and press Enter.</p>
    <div class="flex gap" style="align-items:center;">
        <input @bind="_lot" @bind:event="oninput" @onkeydown="OnLotKey" placeholder="RhIG lot" autocomplete="off" data-rhig-lot />
        <button class="btn btn-secondary btn-sm" disabled="@string.IsNullOrWhiteSpace(_lot)" @onclick="FindLotAsync">Find</button>
    </div>
    @if (_recipients is not null)
    {
        @if (_recipients.Count == 0)
        {
            <div class="empty" style="margin-top:.5rem;">No patient has RhIG lot @_searchedLot recorded as given.</div>
        }
        else
        {
            <div class="table-scroll">
            <table class="bb" style="margin-top:.5rem;" data-rhig-lot-results>
                <thead><tr><th>Patient</th><th>Given</th><th>Vials</th><th>By</th></tr></thead>
                <tbody>
                    @foreach (var r in _recipients)
                    {
                        <tr>
                            <td><a href="@($"/patients/{r.PatientId}?tab=rhig")">@r.PatientName</a> <span class="sub mono">@r.Mrn</span></td>
                            <td class="nowrap">@r.GivenUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@r.Vials</td>
                            <td>@r.GivenBy</td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        }
    }
</div>

@if (_items is null)
{
    <div class="loading">Loading...</div>
}
else if (_items.Count == 0)
{
    <div class="empty">No open RhIG evaluations.</div>
}
else
{
    <div class="bb-card">
        <div class="table-scroll">
        <table class="bb" data-rhig-queue>
            <thead><tr><th>Patient</th><th>Event</th><th>Decision</th><th>Suggested</th><th>Recorded</th><th></th></tr></thead>
            <tbody>
                @foreach (var item in _items)
                {
                    var e = item.Evaluation;
                    <tr>
                        <td><a href="@($"/patients/{e.PatientId}?tab=rhig")">@item.PatientName</a> <span class="sub mono">@item.Mrn</span></td>
                        <td class="nowrap">@Context(e.Context) @e.EventUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@Decision(e)</td>
                        @* Cycle 681: what the facts suggest and the dose calculated, beside what was recorded. *@
                        <td data-rhig-queue-suggested="@e.Id">
                            @SuggestedText(e)
                            @if (e.DecisionDiffersFromSuggestion || e.VialsDifferFromCalculated)
                            {
                                <span class="badge badge-amber" data-rhig-queue-differs>Differs</span>
                            }
                        </td>
                        <td class="nowrap">@e.RecordedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm") <span class="sub">@e.RecordedBy</span></td>
                        <td>
                            @if (item.Evaluation.AwaitsGiving)
                            {
                                <span class="badge badge-blue" data-rhig-to-give>To give</span>
                            }
                            else if (item.ReadyToComplete)
                            {
                                <span class="badge badge-green" data-rhig-ready>Ready to complete</span>
                            }
                            else
                            {
                                <span class="badge badge-amber">Needs entries</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    </div>
}

@code {
    private List<RhigQueueItemDto>? _items;

    /// <summary>"Candidate, 3 vials", "Not a candidate", "Candidate (no dose calculated)", or "—" when the facts suggest nothing.</summary>
    private static string SuggestedText(RhigEvaluationDto e) => e.SuggestedDecision switch
    {
        RhigDecision.Candidate => e.VialsCalculated is int v ? $"Candidate, {v} vial{(v == 1 ? "" : "s")}" : "Candidate (no dose calculated)",
        RhigDecision.NotCandidate => "Not a candidate",
        _ => "—"
    };

    // A link (the top-bar lookup) may open the page on a lot's trace.
    [SupplyParameterFromQuery(Name = "lot")] public string? LotQuery { get; set; }
    private string _lot = string.Empty;
    private string _searchedLot = string.Empty;
    private List<RhigLotRecipientDto>? _recipients;

    private async Task OnLotKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_lot))
        {
            await FindLotAsync();
        }
    }

    private async Task FindLotAsync()
    {
        _searchedLot = _lot.Trim();
        var r = await Api.FindRhigLotRecipientsAsync(_searchedLot);
        _recipients = r.Succeeded ? r.Value ?? new() : new();
        if (!r.Succeeded)
        {
            _fb = r.ToFeedback();
        }
    }
    private Feedback? _fb;

    protected override async Task OnInitializedAsync()
    {
        var r = await Api.GetOpenRhigEvaluationsAsync();
        _items = r.Succeeded ? r.Value ?? new() : new();
        if (!r.Succeeded)
        {
            _fb = r.ToFeedback();
        }

        if (!string.IsNullOrWhiteSpace(LotQuery))
        {
            _lot = LotQuery.Trim();
            await FindLotAsync();
        }
    }

    private static string Context(RhigContext c) => c switch
    {
        RhigContext.Antepartum => "Antepartum",
        RhigContext.Postpartum => "Delivery",
        _ => "Other exposure"
    };

    private static string Decision(RhigEvaluationDto e) => e.Decision switch
    {
        RhigDecision.Candidate => e.VialsRecommended is int v ? $"Candidate, {v} vial{(v == 1 ? "" : "s")}" : "Candidate",
        RhigDecision.NotCandidate => "Not a candidate",
        _ => "Not yet decided"
    };
}
