@page "/inventory/isbt-receive"
@using BloodBankLIS.Application.Isbt128
@using BloodBankLIS.Application.Inventory
@using BloodBankLIS.Application.Reference
@using BloodBankLIS.Domain.Enums
@inject BloodBankApiClient Api
@inject UserSession Session
@inject IJSRuntime Js

<PageTitle>ISBT 128 Receive · Greyhound Blood Bank LIS</PageTitle>

<section class="page">
    <InventoryDeskRibbon Current="InventoryDeskRibbon.Desk.Isbt" />
    <h1>ISBT 128 component receive</h1>
    <p class="muted">
        Manual structured entry and scanner session intake normalize to one canonical component.
        Placeholder ABO/product codes require ICCBBA validation before clinical use.
    </p>

    <Outcome Value="_feedback" />
    @if (_lastUnit is not null)
    {
        <p class="flex gap" style="flex-wrap:wrap;">
            <a class="btn btn-secondary btn-sm" href="@InventoryUrls.Unit(_lastUnit.Id)">Open Inventory</a>
            @if (_lastUnit.Status == UnitStatus.Received)
            {
                <a class="btn btn-secondary btn-sm" href="@($"/inventory?board=retype&unitId={_lastUnit.Id}#pending-retype")">Open retype desk</a>
            }
            @if (Session.Has(PermissionCodes.PrintLabel))
            {
                <a class="btn btn-ghost btn-sm" href="@($"/printing?unitId={_lastUnit.Id}")">Open Printing</a>
            }
            @if (_lastUnit.ReservedPatientId is long reservedPatientId)
            {
                <a class="btn btn-ghost btn-sm" href="@($"/patients/{reservedPatientId}")">Open chart</a>
            }
        </p>
    }

    @if (!CanReceive)
    {
        <div class="alert alert-warning">You can view this page, but receiving units requires the inventory receive permission.</div>
    }

    <div class="bb-card">
        <div class="form-row">
            <div class="field"><label>Open delivery</label>
                <select @bind="_deliveryId" @bind:after="LoadDeliveryAsync">
                    <option value="0">— select —</option>
                    @foreach (var delivery in _openDeliveries)
                    {
                        <option value="@delivery.Id">@delivery.Id — @delivery.SupplierNameLabel@(string.IsNullOrWhiteSpace(delivery.PackingListNumber) ? "" : $" ({delivery.PackingListNumber})")</option>
                    }
                </select>
            </div>
            <div class="field"><label>Product</label>
                <select @bind="_productTypeId" @bind:after="ApplyProductDefaults">
                    <option value="0">— select —</option>
                    @foreach (var product in EligibleProducts)
                    {
                        <option value="@product.Id">@product.Name</option>
                    }
                </select>
            </div>
        </div>
        <p class="muted">A blank supplier name stays the supplier id. The name stored on each unit stays the recorded supplier name.</p>
        @if (_deliveryLines.Count > 0)
        {
            <p class="muted">
                @string.Join(" · ", _deliveryLines.Select(l => $"{l.ProductLabel} {l.ReceivedQuantity}/{l.ExpectedQuantity}"))
            </p>
        }
        @if (MissingCatalogLabels.Count > 0)
        {
            <div class="alert alert-warning">
                No active catalog product for @string.Join(", ", MissingCatalogLabels) on this delivery.
                @if (Session.Has(PermissionCodes.AdminProductsManage))
                {
                    <a href="/admin/products">Add a product</a>
                }
                else
                {
                    <span>Ask an administrator to add one.</span>
                }
            </div>
        }
        @if (_openDeliveries.Count == 0)
        {
            <p class="muted">No open delivery. <a href="/inventory/deliveries/new">Create a delivery</a> before receiving units.</p>
        }
    </div>

    <div class="grid-2">
        <div class="bb-card">
            <div class="bb-card-title"><h3>Manual entry</h3></div>
            <div class="field">
                <label>Donation / unit number</label>
                <input @bind="_donationNumber" maxlength="20" placeholder="G123417654321 or G1234 17 654321 A" />
                <span class="muted">Enter the full DIN as one string (facility + year + sequence). Spaces and an optional keyboard check character are allowed.</span>
            </div>
            <div class="form-row">
                <div class="field"><label>ABO/RhD code (lookup)</label><input @bind="_aboCode" /></div>
                <div class="field"><label>Product description code</label><input @bind="_pdc" maxlength="5" /></div>
                <div class="field"><label>Collection type</label><input @bind="_collection" maxlength="1" /></div>
                <div class="field"><label>Division</label><input @bind="_division" maxlength="2" /></div>
                <div class="field"><label>Expiration (local)</label><input type="datetime-local" @bind="_expirationLocal" /></div>
                <div class="field"><label>Appearance</label>
                    <select @bind="_appearance">
                        @foreach (var a in Enum.GetValues<UnitAppearance>()) { <option value="@a">@a</option> }
                    </select>
                </div>
                <div class="field"><label>Receipt temperature (°C)</label>
                    <input type="number" step="0.1" @bind="_receiveTemperature" placeholder="e.g. 4.0" />
                    <span class="muted">Shipping cooler 1–10 °C. Out-of-range units are not received.</span>
                </div>
                <div class="field"><label>How many</label>
                    <input type="number" min="1" max="50" @bind="_quantity" />
                    <span class="muted">Each unit uses the next donation sequence.</span>
                </div>
                <div class="field"><label>Donation</label>
                    <select @bind="_donationRestriction">
                        @foreach (var d in Enum.GetValues<DonationRestriction>()) { <option value="@d">@d</option> }
                    </select>
                </div>
                @if (_donationRestriction != DonationRestriction.Allogeneic)
                {
                    <div class="field"><label>Intended recipient</label>
                        <FilterableComboBox TItem="PatientDto" TValue="long?"
                            Items="_patients"
                            @bind-Value="_reservedPatientId"
                            DisplayText="@(p => $"{p.LastName}, {p.FirstName} ({p.MedicalRecordNumber})")"
                            ItemValue="@(p => p.Id)"
                            SearchText="@(p => $"{p.LastName} {p.FirstName} {p.MedicalRecordNumber}")"
                            Clearable="true"
                            Placeholder="Autologous / directed patient" />
                    </div>
                }
                @if (_requireReceiveVerifier)
                {
                    <div class="field"><label>Second verifier</label>
                        <FilterableComboBox TItem="DirectoryUserDto" TValue="string?"
                            Items="ReceiveVerifierChoices"
                            @bind-Value="_secondVerifier"
                            DisplayText="@(x => x.Label)"
                            ItemValue="@(x => x.UserName)"
                            SearchText="@(x => x.Label)"
                            Clearable="true"
                            Placeholder="Different active user" />
                    </div>
                }
            </div>
            <label class="checkbox-item"><input type="checkbox" @bind="_explicitTime" /> Label includes explicit time</label>
            <label class="checkbox-item"><input type="checkbox" @bind="_releaseAvailable" /> Release to Available</label>
            <p class="muted" style="font-size:0.85rem;">Release is ignored when the product requires an ABO/Rh retype — those units enter as Received.</p>
            <div class="flex gap" style="align-items:center;flex-wrap:wrap;">
                <button class="btn btn-primary" disabled="@(!ReadyToReceive || _busy)" @onclick="SubmitManual">
                    @(_quantity <= 1 ? "Receive unit" : $"Receive {_quantity} units")
                </button>
                @if (CanReceive && !DeliverySelected)
                {
                    <span class="muted">Select an open delivery and product above first.</span>
                }
            </div>
            <div id="isbt-manual-outcome" style="margin-top:.6rem;"><Outcome Value="_manualFeedback" /></div>
        </div>

        <div class="bb-card">
            <div class="bb-card-title"><h3>Scanner session</h3></div>
            <button class="btn btn-secondary" disabled="@(!CanReceive || _busy)" @onclick="StartSession">@(_sessionKey is null ? "Start scan session" : "Restart scan session")</button>
            @if (_sessionKey is not null)
            {
                <p class="muted mono">Session: @_sessionKey</p>
                <div class="field"><label>Scan / paste</label>
                    <input @bind="_scanValue" @bind:event="oninput" @onkeydown="OnScanKey" />
                </div>
                <div class="flex gap">
                    <button class="btn btn-secondary" disabled="@_busy" @onclick="AddScan">Add scan</button>
                    <button class="btn btn-primary" disabled="@(!ReadyToReceive || _busy)" @onclick="CompleteSession">Complete &amp; receive</button>
                </div>
                @if (_session is not null)
                {
                    <pre>Received: @string.Join(", ", _session.Received)
Identity: @_session.Draft?.ComponentIdentity
Valid: @_session.Validation?.Valid</pre>
                }
            }
            <div id="isbt-scan-outcome" style="margin-top:.6rem;"><Outcome Value="_scanFeedback" /></div>
        </div>
    </div>
</section>

@code {
    private string _donationNumber = "G123417654321";
    private string _aboCode = "DEMO";
    private string _pdc = "E0206";
    private string _collection = "0";
    private string _division = "00";
    private DateTime _expirationLocal = DateTime.Now.AddDays(30);
    private bool _explicitTime;
    private UnitAppearance _appearance = UnitAppearance.Acceptable;
    private decimal? _receiveTemperature = 4.0m;
    private int _quantity = 1;
    private DonationRestriction _donationRestriction = DonationRestriction.Allogeneic;
    private long? _reservedPatientId;
    private bool _releaseAvailable = true;
    private string? _secondVerifier;
    private bool _requireReceiveVerifier;
    private bool _busy;
    private List<DirectoryUserDto> _directoryUsers = new();
    private List<PatientDto> _patients = new();

    private IEnumerable<DirectoryUserDto> ReceiveVerifierChoices =>
        _directoryUsers.Where(u => !string.Equals(u.UserName, Session.UserName, StringComparison.OrdinalIgnoreCase));
    private Feedback? _feedback;
    private Feedback? _manualFeedback;
    private Feedback? _scanFeedback;
    private BloodUnitDto? _lastUnit;
    private Guid? _sessionKey;
    private string _scanValue = "";
    private ScanSessionDto? _session;
    private long _productTypeId;
    private long _deliveryId;
    private List<OpenDeliveryDto> _openDeliveries = new();
    private List<DeliveryLineDto> _deliveryLines = new();
    private List<ProductTypeDto> _productTypes = new();

    private bool CanReceive => Session.Has(PermissionCodes.InventoryReceive);
    private bool DeliverySelected => _deliveryId > 0 && _productTypeId > 0;
    private bool ReadyToReceive => CanReceive && DeliverySelected;

    private IEnumerable<ProductTypeDto> EligibleProducts =>
        _productTypes.Where(p => p.IsActive && _deliveryLines.Any(l => l.ComponentClass == p.ComponentClass))
            .OrderBy(p => p.Name);

    private List<string> MissingCatalogLabels =>
        _deliveryLines
            .Where(l => !_productTypes.Any(p => p.IsActive && p.ComponentClass == l.ComponentClass))
            .Select(l => l.ProductLabel)
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        var policy = await Api.GetReceivePolicyAsync();
        _requireReceiveVerifier = policy.Succeeded && policy.Value?.RequireSecondVerifier == true;
        _productTypes = (await Api.GetProductTypesAsync()).Value ?? new();
        var open = await Api.GetOpenDeliveriesAsync();
        if (open.Succeeded) _openDeliveries = open.Value ?? new();
        else _feedback = open.ToFeedback();
        var users = await Api.GetDirectoryUsersAsync();
        if (users.Succeeded) _directoryUsers = users.Value ?? new();
        var patients = await Api.GetPatientsAsync();
        if (patients.Succeeded) _patients = patients.Value ?? new();
    }

    private async Task LoadDeliveryAsync()
    {
        var previousProduct = _productTypeId;
        _deliveryLines = new();
        if (_deliveryId <= 0)
        {
            _productTypeId = 0;
            return;
        }

        var delivery = await Api.GetDeliveryAsync(_deliveryId);
        if (!delivery.Succeeded || delivery.Value is null)
        {
            _productTypeId = 0;
            _feedback = delivery.ToFeedback();
            return;
        }

        _deliveryLines = delivery.Value.Lines.ToList();
        _productTypeId = EligibleProducts.Any(p => p.Id == previousProduct)
            ? previousProduct
            : EligibleProducts.FirstOrDefault()?.Id ?? 0;
        ApplyProductDefaults();
    }

    private void ApplyProductDefaults()
    {
        var product = _productTypes.FirstOrDefault(p => p.Id == _productTypeId);
        if (product is null) return;
        if (!string.IsNullOrWhiteSpace(product.Isbt128ProductCode))
            _pdc = product.Isbt128ProductCode;
        if (product.DefaultShelfLifeHours is int hours && hours > 0)
            _expirationLocal = DateTime.Now.AddHours(hours);
    }

    private static string NextDin(string current)
    {
        var compact = new string(current.Where(c => !char.IsWhiteSpace(c)).ToArray()).ToUpperInvariant();
        if (compact.Length < 13 || !int.TryParse(compact.Substring(7, 6), out var sequence) || sequence >= 999999)
            return current;
        return compact[..7] + (sequence + 1).ToString("D6");
    }

    private bool DeliveryReady(Action<Feedback> report)
    {
        if (!DeliverySelected)
        {
            report(Feedback.Fail("Select an open delivery and a product type on that delivery."));
            return false;
        }

        return true;
    }

    private async Task SubmitManual()
    {
        if (_busy || !DeliveryReady(f => _manualFeedback = f)) return;
        _busy = true;
        try
        {
            var count = Math.Clamp(_quantity, 1, 50);
            var created = new List<string>();
            BloodUnitDto? last = null;
            for (var i = 0; i < count; i++)
            {
                var req = new ManualComponentEntryRequest(
                    _donationNumber.Trim(),
                    _aboCode, _pdc, _collection, _division, null,
                    _expirationLocal, _explicitTime, _productTypeId,
                    ReleaseToAvailable: _releaseAvailable,
                    VisualInspectionAcceptable: _appearance == UnitAppearance.Acceptable,
                    SecondVerifier: _requireReceiveVerifier ? _secondVerifier : null,
                    Appearance: _appearance,
                    ReceiveTemperatureCelsius: _receiveTemperature,
                    DonationRestriction: _donationRestriction,
                    ReservedPatientId: _donationRestriction == DonationRestriction.Allogeneic ? null : _reservedPatientId,
                    DeliveryId: _deliveryId);
                var result = await Api.CreateIsbtManualAsync(req);
                if (!result.Succeeded || result.Value is null)
                {
                    _lastUnit = last;
                    _manualFeedback = created.Count == 0
                        ? result.ToFeedback()
                        : Feedback.Fail($"Received {created.Count} of {count}. Stopped at {_donationNumber}: {result.FailureSummary()}");
                    await LoadDeliveryAsync();
                    return;
                }

                last = result.Value;
                created.Add(result.Value.ComponentIdentity);
                _donationNumber = NextDin(_donationNumber);
            }

            _lastUnit = last;
            _quantity = 1;
            _manualFeedback = Feedback.Succeed(count == 1
                ? $"Received {created[0]} (status {last!.Status}). Next DIN is {_donationNumber}."
                : $"Received {count} units ({created[0]} through {created[^1]}, status {last!.Status}). Next DIN is {_donationNumber}.");
            await LoadDeliveryAsync();
        }
        finally
        {
            _busy = false;
            StateHasChanged();
            await Js.ScrollIntoViewAsync("isbt-manual-outcome");
        }
    }

    private async Task StartSession()
    {
        var result = await Api.StartIsbtScanSessionAsync(new StartScanSessionRequest());
        if (result.Succeeded)
        {
            _sessionKey = result.Value!.SessionKey;
            _session = result.Value;
            _scanFeedback = Feedback.Succeed("Scan session started.");
        }
        else _scanFeedback = result.ToFeedback();
    }

    private async Task AddScan()
    {
        if (_sessionKey is null) return;
        if (string.IsNullOrWhiteSpace(_scanValue))
        {
            _scanFeedback = Feedback.Fail("Scan or paste a barcode first.");
            return;
        }

        var result = await Api.AddIsbtScanAsync(new AddScanRequest(_sessionKey.Value, _scanValue));
        _scanValue = "";
        if (result.Succeeded) { _session = result.Value; _scanFeedback = Feedback.Succeed("Scan accepted."); }
        else _scanFeedback = result.ToFeedback();
    }

    private async Task OnScanKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await AddScan();
    }

    private async Task CompleteSession()
    {
        if (_sessionKey is null || _busy) return;
        if (!DeliveryReady(f => _scanFeedback = f)) return;
        _busy = true;
        try
        {
            var result = await Api.CompleteIsbtScanSessionAsync(new CompleteScanSessionRequest(
                _sessionKey.Value, _productTypeId, ReleaseToAvailable: _releaseAvailable,
                VisualInspectionAcceptable: _appearance == UnitAppearance.Acceptable,
                SecondVerifier: _requireReceiveVerifier ? _secondVerifier : null, Appearance: _appearance,
                ReceiveTemperatureCelsius: _receiveTemperature,
                DonationRestriction: _donationRestriction,
                ReservedPatientId: _donationRestriction == DonationRestriction.Allogeneic ? null : _reservedPatientId,
                DeliveryId: _deliveryId));
            if (result.Succeeded)
            {
                _lastUnit = result.Value;
                _scanFeedback = Feedback.Succeed($"Received {result.Value!.ComponentIdentity}. Start a new session for the next unit.");
                _sessionKey = null;
                _session = null;
                await LoadDeliveryAsync();
            }
            else
            {
                _lastUnit = null;
                _scanFeedback = result.ToFeedback();
            }
        }
        finally
        {
            _busy = false;
        }
    }
}
