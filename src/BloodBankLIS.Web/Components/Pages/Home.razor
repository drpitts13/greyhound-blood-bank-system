@page "/"
@using BloodBankLIS.Application.Compliance
@inject BloodBankApiClient Api
@inject UserSession Session
@inject NavigationManager Nav
@inject IJSRuntime Js

<PageTitle>Dashboard &middot; HemoCore</PageTitle>

<div class="flex-between" style="margin-bottom:1rem;">
    <h1>Transfusion Service Dashboard</h1>
    <span class="muted">Signed in as <strong>@Session.DisplayName</strong></span>
</div>

@if (_cards.Count > 0)
{
    <div class="flex-between" style="margin-bottom:.75rem;flex-wrap:wrap;gap:.5rem;">
        <h2 style="font-size:1rem;margin:0;">Your work</h2>
        <div class="flex gap" role="group" aria-label="Work focus">
            <span class="muted" style="font-size:.85rem;">Focus:</span>
            @foreach (var choice in DashboardHome.Choices)
            {
                var c = choice;
                <button type="button" class="btn btn-sm @(_focus == c ? "btn-primary" : "btn-secondary")"
                        aria-pressed="@(_focus == c ? "true" : "false")" @onclick="() => SetFocusAsync(c)">@DashboardHome.Label(c)</button>
            }
        </div>
    </div>

    @if (!_loaded)
    {
        <div class="loading">Loading your queues...</div>
    }
    else
    {
        var home = Layout;
        @if (home.StartHere is { } start)
        {
            <a class="bb-start-here @(home.Attention.Contains(start) ? "urgent" : "")" href="@start.Card.Href">
                <span class="bb-start-label">Start here</span>
                <span class="bb-start-title">@start.Card.Label: @start.Count</span>
                @if (start.Note is not null) { <span class="bb-start-note">@start.Note</span> }
                <span class="bb-start-go">Open &rarr;</span>
            </a>
        }
        else if (home.Unavailable.Count == 0)
        {
            <div class="alert alert-success" style="margin-bottom:1rem;">All of your @(DashboardHome.Label(_focus).ToLowerInvariant() == "everything" ? "" : DashboardHome.Label(_focus).ToLowerInvariant() + " ")queues are clear.</div>
        }

        @if (home.Attention.Count > 0)
        {
            <h3 class="bb-home-section">Needs attention</h3>
            <div class="bb-grid cols-4">
                @foreach (var card in home.Attention) { @Card(card, "attention") }
            </div>
        }

        @if (home.Queues.Count > 0)
        {
            <h3 class="bb-home-section">@(_focus == WorkFocus.Everything ? "Queues with work" : $"{DashboardHome.Label(_focus)} queues with work")</h3>
            <div class="bb-grid cols-4">
                @foreach (var card in home.Queues) { @Card(card, null) }
            </div>
        }

        @if (home.Unavailable.Count > 0)
        {
            <div class="alert alert-warning" style="margin-top:1rem;">
                Could not load:
                @foreach (var card in home.Unavailable)
                {
                    <a class="bb-chip" href="@card.Card.Href">@card.Card.Label</a>
                }
                Open the queue to check it. A queue that did not load is not counted as clear.
            </div>
        }

        @if (home.Clear.Count > 0)
        {
            <div class="bb-home-clear">
                <span class="muted">Clear:</span>
                @foreach (var card in home.Clear)
                {
                    <a class="bb-chip" href="@card.Card.Href">@card.Card.Label</a>
                }
            </div>
        }

        @if (home.OtherDesks.Count > 0)
        {
            <details class="bb-help" style="margin-top:.75rem;">
                <summary>Other desks (@home.OtherDesks.Sum(c => c.Count ?? 0) item@(home.OtherDesks.Sum(c => c.Count ?? 0) == 1 ? "" : "s") in @home.OtherDesks.Count queue@(home.OtherDesks.Count == 1 ? "" : "s"))</summary>
                <div class="bb-grid cols-4" style="margin-top:.5rem;">
                    @foreach (var card in home.OtherDesks) { @Card(card, null) }
                </div>
            </details>
        }
    }
}

<div class="bb-grid cols-4" style="margin-top:1.25rem;">
    <a class="stat" href="/patients">
        <div class="label">Patients</div>
        <div class="value">@Format(_patients)</div>
    </a>
    <a class="stat" href="/inventory?status=Available">
        <div class="label">Available units</div>
        <div class="value">@Format(_available)</div>
    </a>
    <a class="stat" href="/inventory?board=quarantine">
        <div class="label">In quarantine</div>
        <div class="value">@Format(_quarantine)</div>
    </a>
    @if (Session.Has(PermissionCodes.BillingReview))
    {
        <a class="stat" href="/billing">
            <div class="label">Charges to review</div>
            <div class="value">@Format(_pendingCharges)</div>
        </a>
    }
</div>

<div class="bb-card" style="margin-top:1.25rem;">
    <div class="bb-card-title"><h3>Quick actions</h3></div>
    <div class="flex gap" style="flex-wrap:wrap;">
        <button class="btn btn-secondary" @onclick='() => Nav.NavigateTo("/patients")'>Find a patient</button>
        <button class="btn btn-secondary" @onclick='() => Nav.NavigateTo("/inventory")'>Search inventory</button>
        <button class="btn btn-secondary" @onclick='() => Nav.NavigateTo("/compatibility")'>Crossmatch &amp; allocate</button>
        <button class="btn btn-secondary" @onclick='() => Nav.NavigateTo("/issuing")'>Issue a unit</button>
        @if (Session.Has(PermissionCodes.Hl7Manage))
        {
            <button class="btn btn-secondary" @onclick='() => Nav.NavigateTo("/hl7")'>HL7 interface</button>
        }
    </div>
</div>

@* Collapsed by default: the full permission list is rarely needed and pushed the rest of the page down. *@
<div class="bb-card">
    <details class="bb-help" style="margin:0;">
        <summary>Your access (@Session.Permissions.Count permission@(Session.Permissions.Count == 1 ? "" : "s"))</summary>
        <p class="muted" style="margin-top:.5rem;">The API grants you the following permissions. Actions you cannot perform are hidden or will be rejected by the server.</p>
        <div class="flex gap" style="flex-wrap:wrap;">
            @if (Session.Permissions.Count == 0)
            {
                <span class="muted">No permissions.</span>
            }
            else
            {
                @foreach (var p in Session.Permissions)
                {
                    <span class="badge badge-gray mono">@p</span>
                }
            }
        </div>
    </details>
</div>

@code {
    private const string Missing = "\u2014";

    private IReadOnlyList<DashboardQueueCatalog.Card> _cards = [];
    private WorkFocus _focus = WorkFocus.Everything;
    private bool _loaded;
    private readonly Dictionary<string, int> _counts = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string> _notes = new(StringComparer.Ordinal);
    private int? _patients;
    private int? _available;
    private int? _quarantine;
    private int? _pendingCharges;

    protected override async Task OnInitializedAsync()
    {
        _cards = DashboardQueueCatalog.Select(Session.Has);
        _focus = DashboardHome.InferFocus(Session.Has);
        var loads = _cards.Select(LoadCardAsync).ToList();
        loads.Add(LoadSnapshotAsync());
        var loaded = await Task.WhenAll(loads);
        foreach (var item in loaded)
        {
            if (item.Count is int count)
            {
                _counts[item.Key] = count;
            }

            if (!string.IsNullOrWhiteSpace(item.Note))
            {
                _notes[item.Key] = item.Note;
            }
        }

        _loaded = true;
    }

    private DashboardHomeLayout Layout => DashboardHome.Arrange(
        _cards.Select(card => new DashboardCardState(
            card,
            _counts.TryGetValue(card.Key, out var count) ? count : null,
            Note(card.Key))),
        _focus);

    private RenderFragment Card(DashboardCardState state, string? css) => __builder =>
    {
        <a class="stat @css" href="@state.Card.Href">
            <div class="label">@state.Card.Label</div>
            <div class="value">@(state.Count?.ToString() ?? Missing)</div>
            @if (state.Note is { } note)
            {
                <div class="detail">@note</div>
            }
        </a>
    };

    private string FocusKey => $"bb.home.focus.{Session.UserName}";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        // Per-browser convenience only; any failure keeps the inferred focus.
        try
        {
            var saved = await Js.InvokeAsync<string?>("localStorage.getItem", FocusKey);
            if (Enum.TryParse<WorkFocus>(saved, out var focus) && focus != _focus)
            {
                _focus = focus;
                StateHasChanged();
            }
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException)
        {
        }
    }

    private async Task SetFocusAsync(WorkFocus focus)
    {
        _focus = focus;
        try
        {
            await Js.InvokeVoidAsync("localStorage.setItem", FocusKey, focus.ToString());
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException)
        {
        }
    }

    private string? Note(string key) =>
        _notes.TryGetValue(key, out var note) ? note : null;

    private static string Format(int? value) => value?.ToString() ?? Missing;

    private async Task<(string Key, int? Count, string? Note)> LoadSnapshotAsync()
    {
        var patients = await Api.GetPatientsAsync();
        if (patients.Succeeded)
        {
            _patients = patients.Value!.Count;
        }

        var available = await Api.SearchUnitsAsync(new InventorySearchCriteria(Status: UnitStatus.Available));
        if (available.Succeeded)
        {
            _available = available.Value!.Count;
        }

        var quarantine = await Api.SearchUnitsAsync(new InventorySearchCriteria(Status: UnitStatus.Quarantine));
        if (quarantine.Succeeded)
        {
            _quarantine = quarantine.Value!.Count;
        }

        if (Session.Has(PermissionCodes.BillingReview))
        {
            var charges = await Api.GetBillingQueueAsync();
            if (charges.Succeeded)
            {
                _pendingCharges = charges.Value!.Count;
            }
        }

        return ("snapshot", null, null);
    }

    private async Task<(string Key, int? Count, string? Note)> LoadCardAsync(DashboardQueueCatalog.Card card)
    {
        switch (card.Key)
        {
            case DashboardQueueCatalog.Ready:
            {
                var result = await Api.GetReadyToIssueAllocationsAsync();
                if (!result.Succeeded || result.Value is null)
                {
                    return (card.Key, null, null);
                }

                return (card.Key, result.Value.Count, ReadyToIssueAttentionRule.CardNote(result.Value, DateTime.UtcNow));
            }
            case DashboardQueueCatalog.SecondAbo:
            {
                var result = await Api.GetPendingSecondAboAsync();
                if (!result.Succeeded || result.Value is null)
                {
                    return (card.Key, null, null);
                }

                return (card.Key, result.Value.Count, DashboardQueueCatalog.SecondAboNote(result.Value));
            }
            case DashboardQueueCatalog.Retrospective:
            {
                var result = await Api.GetPendingRetrospectiveCrossmatchesAsync();
                if (!result.Succeeded || result.Value is null)
                {
                    return (card.Key, null, null);
                }

                var overdue = RetrospectiveCrossmatchAttentionRule.CountOverdue(result.Value);
                return (card.Key, result.Value.Count, DashboardQueueCatalog.AttentionNote(overdue, "past due", "past due"));
            }
            case DashboardQueueCatalog.InTransit:
            {
                var result = await Api.GetInTransitIssuesAsync();
                if (!result.Succeeded || result.Value is null)
                {
                    return (card.Key, null, null);
                }

                var overdue = InTransitAttentionRule.CountOverdue(result.Value.Select(item => item.IsOverdue));
                var coolers = await Api.GetOpenCoolersAsync();
                return (card.Key, result.Value.Count, DashboardQueueCatalog.InTransitNote(overdue, coolers.Succeeded ? coolers.Value : null));
            }
            case DashboardQueueCatalog.Outstanding:
            {
                var result = await Api.GetOutstandingIssuesAsync();
                if (!result.Succeeded || result.Value is null)
                {
                    return (card.Key, null, null);
                }

                return (card.Key, result.Value.Count, DashboardQueueCatalog.OutstandingNote(result.Value));
            }
            case DashboardQueueCatalog.Disposition:
            {
                var result = await Api.GetOverdueDispositionAsync();
                if (!result.Succeeded || result.Value is null)
                {
                    return (card.Key, null, null);
                }

                return (card.Key, result.Value.Count, DashboardQueueCatalog.DispositionNote(result.Value, DateTime.UtcNow));
            }
            case DashboardQueueCatalog.ToVerify:
            {
                var result = await PendingTestsOnce();
                if (!result.Succeeded || result.Value is null)
                {
                    return (card.Key, null, null);
                }

                var (mine, note) = DashboardQueueCatalog.ToVerifyCard(result.Value, Session.UserName);
                return (card.Key, mine, note);
            }
            case DashboardQueueCatalog.PendingTests:
            {
                var result = await PendingTestsOnce();
                if (!result.Succeeded || result.Value is null)
                {
                    return (card.Key, null, null);
                }

                return (card.Key, result.Value.Count, DashboardQueueCatalog.PendingTestsNote(result.Value));
            }
            case DashboardQueueCatalog.PendingSpecimens:
            {
                var result = await Api.GetPendingSpecimensAsync();
                if (!result.Succeeded || result.Value is null)
                {
                    return (card.Key, null, null);
                }

                var expired = PendingSpecimenAttentionRule.CountExpired(result.Value);
                return (card.Key, result.Value.Count, DashboardQueueCatalog.AttentionNote(expired, "expired, to reject", "expired, to reject"));
            }
            case DashboardQueueCatalog.Reactions:
            {
                var result = await Api.GetReactionInvestigationsAsync();
                if (!result.Succeeded || result.Value is null)
                {
                    return (card.Key, null, null);
                }

                var open = OpenReactionInvestigationRule.Count(result.Value.Select(item => item.Status));
                return (card.Key, open, DashboardQueueCatalog.ReactionsNote(result.Value));
            }
            case DashboardQueueCatalog.NearExpiry:
            {
                var result = await Api.GetNearExpiryUnitsAsync();
                if (!result.Succeeded || result.Value is null)
                {
                    return (card.Key, null, null);
                }

                return (card.Key, result.Value.Count,
                    DashboardQueueCatalog.NearExpiryNote(result.Value.Count(u => u.ReservedPatientId is not null)));
            }
            case DashboardQueueCatalog.Supervisor:
            {
                var result = await Api.GetSupervisorQueueAsync();
                if (!result.Succeeded || result.Value is null)
                {
                    return (card.Key, null, null);
                }

                return (card.Key, result.Value.Count, DashboardQueueCatalog.SupervisorNote(result.Value));
            }
            case DashboardQueueCatalog.ReagentQc:
            {
                var result = await Api.GetReagentQcWorklistAsync();
                if (!result.Succeeded || result.Value is null)
                {
                    return (card.Key, null, null);
                }

                return (card.Key, result.Value.Count, DashboardQueueCatalog.ReagentQcNote(result.Value));
            }
            case DashboardQueueCatalog.Deviations:
            {
                var result = await Api.GetDeviationsAsync();
                if (!result.Succeeded || result.Value is null)
                {
                    return (card.Key, null, null);
                }

                var (open, note) = DashboardQueueCatalog.DeviationsCard(result.Value);
                return (card.Key, open, note);
            }
            case DashboardQueueCatalog.ExpiredOnShelf:
                return await CountList(card.Key, Api.GetExpiredOnShelfAsync());
            case DashboardQueueCatalog.BloodOrders:
            {
                var result = await Api.GetBloodOrdersToPrepareAsync();
                return result.Succeeded && result.Value is not null
                    ? (card.Key, result.Value.Count, DashboardQueueCatalog.BloodOrdersNote(result.Value))
                    : (card.Key, null, null);
            }
            case DashboardQueueCatalog.Unidentified:
            {
                var result = await Api.GetUnidentifiedPatientsAsync();
                if (!result.Succeeded || result.Value is null)
                {
                    return (card.Key, null, null);
                }

                return (card.Key, result.Value.Count, DashboardQueueCatalog.UnidentifiedNote(result.Value, DateTime.UtcNow));
            }
            case DashboardQueueCatalog.TubesDueForDiscard:
                return await CountList(card.Key, Api.GetTubesDueForDiscardAsync());
            case DashboardQueueCatalog.LowStock:
            {
                var result = await Api.GetMinimumStockAsync();
                if (!result.Succeeded || result.Value is null)
                {
                    return (card.Key, null, null);
                }

                var (shortCount, note) = DashboardQueueCatalog.LowStockCard(result.Value);
                return (card.Key, shortCount, note);
            }
            case DashboardQueueCatalog.TemperatureExcursions:
                return await CountList(card.Key, Api.GetOpenTemperatureExcursionsAsync());
            case DashboardQueueCatalog.InstrumentFailures:
            {
                var result = await Api.GetOpenInstrumentFailuresAsync();
                if (!result.Succeeded || result.Value is null)
                {
                    return (card.Key, null, null);
                }

                var (open, note) = DashboardQueueCatalog.InstrumentFailuresCard(result.Value, DateTime.UtcNow);
                return (card.Key, open, note);
            }
            case DashboardQueueCatalog.Hl7Errors:
            {
                var result = await Api.GetHl7ErrorsAsync();
                if (!result.Succeeded || result.Value is null)
                {
                    return (card.Key, null, null);
                }

                return (card.Key, result.Value.Count, DashboardQueueCatalog.OldestWaitingNote(result.Value.Select(e => e.QueuedUtc), DateTime.UtcNow));
            }
            case DashboardQueueCatalog.OpenRhig:
            {
                var result = await Api.GetOpenRhigEvaluationsAsync();
                return result.Succeeded && result.Value is not null
                    ? (card.Key, result.Value.Count, DashboardQueueCatalog.RhigQueueNote(result.Value))
                    : (card.Key, null, null);
            }
            case DashboardQueueCatalog.PossibleDuplicates:
            {
                var result = await Api.GetPossibleDuplicatePairsAsync();
                return result.Succeeded && result.Value is not null
                    ? (card.Key, result.Value.Count, DashboardQueueCatalog.PossibleDuplicatesNote(result.Value))
                    : (card.Key, null, null);
            }
            case DashboardQueueCatalog.UnmappedInterfaceValues:
                return await CountList(card.Key, Api.GetAdminHl7UnmappedValuesAsync());
            case DashboardQueueCatalog.Handoff:
            {
                var result = await Api.GetOpenShiftHandoffAsync();
                if (!result.Succeeded)
                {
                    return (card.Key, null, null);
                }

                var open = result.Value is not null;
                return (card.Key, open ? 1 : 0, DashboardQueueCatalog.HandoffNote(result.Value));
            }
            default:
                return (card.Key, null, null);
        }
    }

    // Pending tests and Results to verify read the same worklist: fetch it once per load.
    private Task<ApiResult<List<TestWorkItemDto>>>? _pendingTests;

    private Task<ApiResult<List<TestWorkItemDto>>> PendingTestsOnce() => _pendingTests ??= Api.GetPendingTestWorklistAsync();

    private static async Task<(string Key, int? Count, string? Note)> CountList<T>(string key, Task<ApiResult<List<T>>> call)
    {
        var result = await call;
        return result.Succeeded && result.Value is not null
            ? (key, result.Value.Count, null)
            : (key, null, null);
    }
}
