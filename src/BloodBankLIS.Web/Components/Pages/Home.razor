@page "/"
@inject BloodBankApiClient Api
@inject UserSession Session
@inject NavigationManager Nav

<PageTitle>Dashboard &middot; Greyhound Blood Bank LIS</PageTitle>

<div class="flex-between" style="margin-bottom:1rem;">
    <h1>Transfusion Service Dashboard</h1>
    <span class="muted">Signed in as <strong>@Session.DisplayName</strong></span>
</div>

<div class="bb-grid cols-4">
    <div class="stat">
        <div class="label">Patients</div>
        <div class="value">@(_patients?.ToString() ?? "?")</div>
    </div>
    <div class="stat">
        <div class="label">Available units</div>
        <div class="value">@(_available?.ToString() ?? "?")</div>
    </div>
    <div class="stat">
        <div class="label">In quarantine</div>
        <div class="value">@(_quarantine?.ToString() ?? "?")</div>
    </div>
    <div class="stat">
        <div class="label">Charges to review</div>
        <div class="value">@(_pendingCharges?.ToString() ?? "?")</div>
    </div>
</div>

@if (Session.Has(PermissionCodes.ImmunoRecord) || Session.Has(PermissionCodes.ImmunoOverride))
{
    <div class="bb-card" style="margin-top:1.25rem;">
        <div class="bb-card-title">
            <h3>Open antibody identification</h3>
            <button class="btn btn-secondary btn-sm" type="button" @onclick='() => Nav.NavigateTo("/antibody-id")'>Worklist</button>
        </div>
        @if (_abid is null)
        {
            <p class="muted">Open workups could not be loaded.</p>
        }
        else if (_abid.OpenCount == 0)
        {
            <p class="muted">No open antibody-identification workups. Assistance does not identify antibodies.</p>
        }
        else
        {
            <p>
                <strong>@_abid.OpenCount</strong> open.
                @if (_abid.RecordReactionsCount > 0)
                {
                    <button class="btn btn-ghost btn-sm" type="button" @onclick="OpenReactionsWorklist">
                        @_abid.RecordReactionsCount need reactions.
                    </button>
                }
                @if (_abid.InterpretCount > 0)
                {
                    <button class="btn btn-ghost btn-sm" type="button" @onclick="OpenInterpretWorklist">
                        @_abid.InterpretCount need interpretation.
                    </button>
                }
                @if (_abid.ReviewCount > 0)
                {
                    <button class="btn btn-ghost btn-sm" type="button" @onclick="OpenReviewWorklist">
                        @_abid.ReviewCount need supervisor review.
                    </button>
                }
                @if (_abid.WithdrawnJudgmentCount > 0)
                {
                    <button class="btn btn-ghost btn-sm" type="button" @onclick="OpenWithdrawnWorklist">
                        @_abid.WithdrawnJudgmentCount have withdrawn judgment.
                    </button>
                }
                @if (_abid.PendingTypeCorrectionCount > 0)
                {
                    <button class="btn btn-ghost btn-sm" type="button" @onclick="OpenPendingTypeWorklist">
                        @_abid.PendingTypeCorrectionCount have a pending type correction.
                    </button>
                }
                @if (_abid.ReservedOrIssuedUnitCount > 0)
                {
                    <button class="btn btn-ghost btn-sm" type="button" @onclick="OpenProductsWorklist">
                        @_abid.ReservedOrIssuedUnitCount have reserved or issued units.
                    </button>
                }
            </p>
            @if (_abid.UnusableSpecimenCount > 0)
            {
                <p>
                    <button class="btn btn-ghost btn-sm" type="button" @onclick="OpenUnusableWorklist">
                        <span class="badge badge-red">@_abid.UnusableSpecimenCount rejected/cancelled specimen</span>
                    </button>
                </p>
                <p class="muted">Open the worklist filtered to those workups. Void or re-link them. They remain the identification of record for the patient. This does not identify antibodies.</p>
            }
            @if (_abid.NotReadySpecimenCount > 0)
            {
                <p>
                    <button class="btn btn-ghost btn-sm" type="button" @onclick="OpenNotReadyWorklist">
                        <span class="badge badge-red">@_abid.NotReadySpecimenCount not-yet-received specimen</span>
                    </button>
                </p>
                <p class="muted">Open the worklist filtered to those workups. Receive the specimen, void, or re-link. Complete HardStops. They remain the identification of record for the patient. This does not identify antibodies.</p>
            }
            @if (_abid.ExpiredSpecimenCount > 0)
            {
                <p>
                    <button class="btn btn-ghost btn-sm" type="button" @onclick="OpenExpiredWorklist">
                        <span class="badge badge-amber">@_abid.ExpiredSpecimenCount expired specimen</span>
                    </button>
                </p>
                <p class="muted">Open the worklist filtered to those workups. Complete with acknowledgment, void, or re-link. They remain the identification of record for the patient. This does not identify antibodies.</p>
            }
            @if (_abid.UnacceptedSpecimenCount > 0)
            {
                <p>
                    <button class="btn btn-ghost btn-sm" type="button" @onclick="OpenUnacceptedWorklist">
                        <span class="badge badge-blue">@_abid.UnacceptedSpecimenCount not-yet-accepted specimen</span>
                    </button>
                </p>
                <p class="muted">Open the worklist filtered to those workups. Accept the specimen, complete with acknowledgment, void, or re-link. They remain the identification of record for the patient. This does not identify antibodies.</p>
            }
            @if (_abid.InactiveLotCount > 0 || _abid.ExpiredLotCount > 0)
            {
                <p>
                    @if (_abid.InactiveLotCount > 0)
                    {
                        <button class="btn btn-ghost btn-sm" type="button" @onclick="OpenLotAttentionWorklist">
                            <span class="badge badge-red">@_abid.InactiveLotCount inactive lot</span>
                        </button>
                    }
                    @if (_abid.ExpiredLotCount > 0)
                    {
                        <button class="btn btn-ghost btn-sm" type="button" @onclick="OpenLotAttentionWorklist">
                            <span class="badge badge-amber">@_abid.ExpiredLotCount expired lot</span>
                        </button>
                    }
                </p>
                <p class="muted">Count badges open every workup with a withdrawn or expired lot. Named lots open that reagent only. This does not identify antibodies.</p>
                <div class="flex gap" style="flex-wrap:wrap;">
                    @foreach (var lot in _abid.InactiveLotNumbers ?? [])
                    {
                        <button class="btn btn-ghost btn-sm" type="button" @onclick="() => OpenLotWorklist(lot)">
                            <span class="badge badge-red">Inactive @lot</span>
                        </button>
                    }
                    @foreach (var lot in _abid.ExpiredLotNumbers ?? [])
                    {
                        <button class="btn btn-ghost btn-sm" type="button" @onclick="() => OpenLotWorklist(lot)">
                            <span class="badge badge-amber">Expired @lot</span>
                        </button>
                    }
                </div>
            }
        }
    </div>
}

<div class="bb-card" style="margin-top:1.25rem;">
    <div class="bb-card-title"><h3>Quick actions</h3></div>
    <div class="flex gap" style="flex-wrap:wrap;">
        <button class="btn btn-secondary" @onclick='() => Nav.NavigateTo("/patients")'>Find a patient</button>
        <button class="btn btn-secondary" @onclick='() => Nav.NavigateTo("/inventory")'>Search inventory</button>
        @if (Session.Has(PermissionCodes.ImmunoRecord) || Session.Has(PermissionCodes.ImmunoOverride))
        {
            <button class="btn btn-secondary" @onclick='() => Nav.NavigateTo("/antibody-id")'>Antibody identification</button>
        }
        <button class="btn btn-secondary" @onclick='() => Nav.NavigateTo("/compatibility")'>Crossmatch &amp; allocate</button>
        <button class="btn btn-secondary" @onclick='() => Nav.NavigateTo("/issuing")'>Issue a unit</button>
        @if (Session.Has(PermissionCodes.LookbackManage))
        {
            <button class="btn btn-secondary" @onclick='() => Nav.NavigateTo("/lookback")'>Lookback / traceback</button>
        }
        @if (Session.Has(PermissionCodes.Hl7Manage))
        {
            <button class="btn btn-secondary" @onclick='() => Nav.NavigateTo("/hl7")'>HL7 interface</button>
        }
    </div>
</div>

<div class="bb-card">
    <div class="bb-card-title"><h3>Your access</h3></div>
    <p class="muted">The API grants you the following permissions. Actions you cannot perform are hidden or will be rejected by the server.</p>
    <div class="flex gap" style="flex-wrap:wrap;">
        @if (Session.Permissions.Count == 0)
        {
            <span class="muted">No permissions.</span>
        }
        else
        {
            @foreach (var p in Session.Permissions)
            {
                <span class="badge badge-gray mono">@p</span>
            }
        }
    </div>
</div>

@code {
    private int? _patients;
    private int? _available;
    private int? _quarantine;
    private int? _pendingCharges;
    private AntibodyIdOpenWorklistSummaryDto? _abid;

    protected override async Task OnInitializedAsync()
    {
        var patients = await Api.GetPatientsAsync();
        if (patients.Succeeded) _patients = patients.Value!.Count;

        var available = await Api.SearchUnitsAsync(new InventorySearchCriteria(Status: UnitStatus.Available));
        if (available.Succeeded) _available = available.Value!.Count;

        var quarantine = await Api.SearchUnitsAsync(new InventorySearchCriteria(Status: UnitStatus.Quarantine));
        if (quarantine.Succeeded) _quarantine = quarantine.Value!.Count;

        if (Session.Has(PermissionCodes.BillingReview))
        {
            var charges = await Api.GetBillingQueueAsync();
            if (charges.Succeeded) _pendingCharges = charges.Value!.Count;
        }

        if (Session.Has(PermissionCodes.ImmunoRecord) || Session.Has(PermissionCodes.ImmunoOverride))
        {
            var abid = await Api.GetOpenAntibodyIdSummaryAsync();
            if (abid.Succeeded) _abid = abid.Value;
        }
    }

    private void OpenLotWorklist(string lotNumber) =>
        Nav.NavigateTo($"/antibody-id?lot={Uri.EscapeDataString(lotNumber)}");

    private void OpenLotAttentionWorklist() =>
        Nav.NavigateTo("/antibody-id?lotAttention=1");

    private void OpenUnusableWorklist() =>
        Nav.NavigateTo("/antibody-id?unusable=1");

    private void OpenNotReadyWorklist() =>
        Nav.NavigateTo("/antibody-id?notready=1");

    private void OpenExpiredWorklist() =>
        Nav.NavigateTo("/antibody-id?expired=1");

    private void OpenUnacceptedWorklist() =>
        Nav.NavigateTo("/antibody-id?unaccepted=1");

    private void OpenReactionsWorklist() =>
        Nav.NavigateTo("/antibody-id?action=reactions");

    private void OpenInterpretWorklist() =>
        Nav.NavigateTo("/antibody-id?action=interpret");

    private void OpenReviewWorklist() =>
        Nav.NavigateTo("/antibody-id?action=review");

    private void OpenWithdrawnWorklist() =>
        Nav.NavigateTo("/antibody-id?withdrawn=1");

    private void OpenPendingTypeWorklist() =>
        Nav.NavigateTo("/antibody-id?typePending=1");

    private void OpenProductsWorklist() =>
        Nav.NavigateTo("/antibody-id?products=1");
}
