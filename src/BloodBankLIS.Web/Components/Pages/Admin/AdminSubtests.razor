@page "/admin/subtests"
@using BloodBankLIS.Application.Admin
@using BloodBankLIS.Domain.ValueObjects
@inject UserSession Session
@inject BloodBankApiClient Api

<PageTitle>Subtests &middot; Admin</PageTitle>

<div class="flex-between">
    <h1>Subtest Definitions</h1>
    <div class="flex gap">
        <a class="btn btn-ghost" href="/admin/phases">Open Phases</a>
        <a class="btn btn-ghost" href="/admin/tests">Open Tests</a>
        @if (CanManage)
        {
            <button class="btn btn-primary" @onclick="NewDraft">New subtest</button>
        }
    </div>
</div>
<p class="muted">Reusable panel subtests: graded reactions, pick lists, and free text with polarity for logic tables.</p>
<details class="bb-help">
    <summary>How it works</summary>
    <ul>
        <li>Phases (IS, 37°C, AHG) are assigned here and used on Tests.</li>
        <li>The list keeps the subtest code. A blank name stays Subtest {id}. That label is not written onto the subtest, and the edit form keeps the stored name.</li>
    </ul>
</details>

<Outcome Value="_feedback" />

@if (!_loading && MissingSummary is { } summary)
{
    @* Loop 2 tick 58: one summary instead of the same "Missing standard: mf" note on every graded row. *@
    <div class="alert alert-warning" style="margin-top:1rem;" data-subtests-missing-summary>
        <div>@summary</div>
        @if (CanManage)
        {
            <div class="form-row" style="margin-top:.5rem; align-items:flex-end;">
                <div class="field" style="flex:1;"><label>Change reason (optional)</label><input @bind="_bulkReason" @bind:event="oninput" placeholder="Why is this change being made?" /></div>
                <button class="btn btn-secondary btn-sm" disabled="@_busy" @onclick="AddMissingGradesToAllAsync" data-subtests-add-missing-all>Add to all</button>
            </div>
        }
    </div>
}

<div class="bb-card" style="margin-top:1rem;">
    <div class="flex gap" style="margin-bottom:.6rem;">
        <input style="flex:1;" placeholder="Filter by code or name" @bind="_filter" @bind:event="oninput" />
        <label class="flex" style="gap:.35rem;"><input type="checkbox" @bind="_includeInactive" @bind:after="LoadAsync" /> Include inactive</label>
    </div>

    @if (_loading)
    {
        <div class="loading">Loading...</div>
    }
    else if (Filtered.Count == 0)
    {
        <div class="empty">No subtest definitions.</div>
    }
    else
    {
        <div class="table-scroll">
        <table class="bb">
            <thead><tr><th>Code</th><th>Name</th><th>Result type</th><th>Choices</th><th>Ver</th><th>Status</th><th></th></tr></thead>
            <tbody>
                @foreach (var s in Filtered)
                {
                    <tr>
                        <td class="mono">@s.Code</td>
                        <td>@s.NameLabel</td>
                        <td>@Ui.EnumText(s.ResultType)</td>
                        <td>@s.Choices.Count
                            @if (MissingGrades(s) is { Count: > 0 } missing)
                            {
                                @* Loop 2 tick 13, shortened in tick 58: the summary above says what * means. *@
                                <span class="muted" title="Missing standard: @string.Join(", ", missing)" data-subtest-missing-grades="@s.Code">*</span>
                            }
                        </td>
                        <td>@s.Version</td>
                        <td>@StatusBadge(s)</td>
                        <td class="right nowrap">
                            <button class="btn btn-ghost btn-sm" @onclick="() => EditAsync(s.Id)">Edit</button>
                            @if (Session.Has(PermissionCodes.AdminAuditReview))
                            {
                                <button class="btn btn-ghost btn-sm" @onclick="() => ShowHistoryAsync(s.Id)">History</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    }
</div>

@if (_editing is not null)
{
    <div class="bb-card" style="margin-top:1rem;" data-scroll-on-show>
        <h2>@(_editId is null ? "New subtest" : $"Edit: {_editing.Code}")</h2>
        <div class="form-row">
            <div class="field"><label>Code</label><input @bind="_editing.Code" disabled="@(_editId is not null)" /></div>
            <div class="field"><label>Name</label><input @bind="_editing.Name" /></div>
            <div class="field"><label>Result type</label>
                <select @bind="_editing.ResultType" @bind:after="OnResultTypeChanged">
                    @foreach (var t in Enum.GetValues<SubtestResultType>()) { <option value="@t">@Ui.EnumText(t)</option> }
                </select>
            </div>
        </div>

        @if (_editing.ResultType != SubtestResultType.FreeText)
        {
            <div class="field" style="margin-top:.6rem;">
                <div class="flex-between" style="margin-bottom:.4rem;">
                    <label style="margin:0;"><strong>Choices</strong></label>
                    <div class="flex gap">
                        @if (_editing.ResultType == SubtestResultType.GradedReaction)
                        {
                            <button type="button" class="btn btn-ghost btn-sm" @onclick="LoadDefaultGradedChoices">Load standard grades</button>
                            @if (SubtestChoiceDefinitions.MissingStandardGrades(_editing.Choices.Select(c => c.Code)).Count > 0 && _editing.Choices.Any(c => !string.IsNullOrWhiteSpace(c.Code)))
                            {
                                @* Keeps the subtest's own choices and adds only the standard grades it lacks. *@
                                <button type="button" class="btn btn-ghost btn-sm" @onclick="AddMissingStandardGrades" data-subtest-add-missing>Add missing standard grades</button>
                            }
                        }
                        <button type="button" class="btn btn-ghost btn-sm" @onclick="AddChoice">Add choice</button>
                    </div>
                </div>
                <div class="table-scroll">
                <table class="bb">
                    <thead>
                        <tr>
                            <th>Code</th><th>Label</th>
                            @if (_editing.ResultType == SubtestResultType.GradedReaction) { <th>Polarity</th> }
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < _editing.Choices.Count; i++)
                        {
                            var row = _editing.Choices[i];
                            var choiceIndex = i;
                            <tr>
                                <td><input class="mono" @bind="row.Code" /></td>
                                <td><input @bind="row.Label" /></td>
                                @if (_editing.ResultType == SubtestResultType.GradedReaction)
                                {
                                    <td>
                                        <select @bind="row.Polarity">
                                            @foreach (var p in Enum.GetValues<ReactionPolarity>()) { <option value="@p">@Ui.EnumText(p)</option> }
                                        </select>
                                    </td>
                                }
                                <td><button type="button" class="btn btn-ghost btn-sm" @onclick="() => RemoveChoice(choiceIndex)">Remove</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
            </div>
        }

        <div class="field"><label>Change reason @(EditingActive ? "(required)" : "(optional)")</label>
            <input @bind="_changeReason" placeholder="Why is this change being made?" />
        </div>

        <div class="flex gap" style="margin-top:.6rem;">
            <button class="btn btn-primary" disabled="@(_busy || !CanManage)" @onclick="SaveAsync">Save</button>
            @if (!CanManage)
            {
                <span class="muted">View only. Saving needs the manage permission for this catalog.</span>
            }
            @if (_editId is not null && CanActivate)
            {
                @if (!_currentIsActive)
                {
                    <button class="btn btn-secondary" disabled="@_busy" @onclick="ActivateAsync">Activate</button>
                }
                else
                {
                    <button class="btn btn-secondary" disabled="@_busy" @onclick="DeactivateAsync">Deactivate</button>
                }
            }
            <button class="btn btn-ghost" @onclick="() => _editing = null">Cancel</button>
        </div>
    </div>
}

@if (_history is not null)
{
    <ConfigHistoryPanel Title="@($"History: {_historyTitle}")" Rows="_history" OnClose="() => _history = null" />
}

@code {
    private List<SubtestDefinitionDto> _items = new();
    private bool _loading = true;
    private bool _includeInactive = true;
    private string _filter = string.Empty;
    private Feedback? _feedback;
    private bool _busy;

    private EditModel? _editing;
    private long? _editId;
    private bool _currentIsActive;
    private string? _changeReason;
    private string? _bulkReason;

    private List<SubtestDefinitionDto> MissingAny => _items.Where(s => MissingGrades(s).Count > 0).ToList();

    private string? MissingSummary
    {
        get
        {
            var missing = MissingAny;
            if (missing.Count == 0)
            {
                return null;
            }

            var grades = string.Join(", ", missing.SelectMany(MissingGrades).Distinct());
            var graded = _items.Count(s => s.ResultType == SubtestResultType.GradedReaction && s.Choices.Count > 0);
            var which = missing.Count == graded && graded > 1
                ? $"All {graded} graded subtests lack"
                : missing.Count == 1
                    ? $"1 graded subtest ({missing[0].Code}) lacks"
                    : $"{missing.Count} graded subtests ({string.Join(", ", missing.Select(s => s.Code))}) lack";
            return $"{which} the standard grade{(grades.Contains(',') ? "s" : "")} {grades}, marked * in Choices. Add them here or with Add missing standard grades on each subtest.";
        }
    }

    private List<ConfigHistoryDto>? _history;
    private string _historyTitle = string.Empty;

    private bool CanManage => Session.Has(PermissionCodes.AdminTestsManage);
    private bool CanActivate => Session.Has(PermissionCodes.AdminConfigActivate);
    private bool EditingActive => _currentIsActive;

    private List<SubtestDefinitionDto> Filtered => string.IsNullOrWhiteSpace(_filter)
        ? _items
        : _items.Where(s => s.Code.Contains(_filter, StringComparison.OrdinalIgnoreCase)
            || s.Name.Contains(_filter, StringComparison.OrdinalIgnoreCase)
            || s.NameLabel.Contains(_filter, StringComparison.OrdinalIgnoreCase)).ToList();

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        var r = await Api.GetAdminSubtestsAsync(_includeInactive);
        _items = r.Value ?? new();
        if (!r.Succeeded) _feedback = r.ToFeedback();
        _loading = false;
    }

    private void NewDraft()
    {
        _editId = null;
        _currentIsActive = false;
        _changeReason = null;
        _editing = new EditModel { ResultType = SubtestResultType.GradedReaction };
        LoadDefaultGradedChoices();
        _feedback = null;
    }

    private async Task EditAsync(long id)
    {
        var r = await Api.GetAdminSubtestAsync(id);
        if (!r.Succeeded || r.Value is null) { _feedback = r.ToFeedback(); return; }
        _editId = r.Value.Id;
        _currentIsActive = r.Value.IsActive;
        _changeReason = null;
        _editing = EditModel.From(r.Value);
        _feedback = null;
    }

    private async Task SaveAsync()
    {
        if (_editing is null) return;
        _busy = true;
        var req = _editing.ToRequest(_changeReason);
        var r = _editId is null
            ? await Api.CreateAdminSubtestAsync(req)
            : await Api.UpdateAdminSubtestAsync(_editId.Value, req);
        _busy = false;
        _feedback = r.ToFeedback(_editId is null ? "Draft created." : "Saved.");
        if (r.Succeeded)
        {
            _editId = r.Value!.Id;
            _currentIsActive = r.Value.IsActive;
            await LoadAsync();
        }
    }

    private async Task ActivateAsync()
    {
        if (_editId is null) return;
        _busy = true;
        var r = await Api.ActivateAdminSubtestAsync(_editId.Value, _changeReason);
        _busy = false;
        _feedback = r.ToFeedback("Activated.");
        if (r.Succeeded) { _currentIsActive = true; await LoadAsync(); }
    }

    private async Task DeactivateAsync()
    {
        if (_editId is null) return;
        _busy = true;
        var r = await Api.DeactivateAdminSubtestAsync(_editId.Value, _changeReason);
        _busy = false;
        _feedback = r.ToFeedback("Deactivated.");
        if (r.Succeeded) { _currentIsActive = false; await LoadAsync(); }
    }

    private async Task ShowHistoryAsync(long id)
    {
        var r = await Api.GetConfigHistoryAsync(nameof(BloodBankLIS.Domain.Entities.Configuration.SubtestDefinition), id);
        if (!r.Succeeded)
        {
            _feedback = r.ToFeedback();
            _history = null;
            return;
        }

        _history = r.Value ?? new();
        _historyTitle = _items.FirstOrDefault(s => s.Id == id)?.Code ?? id.ToString();
    }

    private static RenderFragment StatusBadge(SubtestDefinitionDto s) => builder =>
    {
        var (cls, text) = s.IsActive ? ("badge-green", "Active") : s.IsDraft ? ("badge-gray", "Draft") : ("badge-amber", "Inactive");
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", $"badge {cls}");
        builder.AddContent(2, text);
        builder.CloseElement();
    };

    private void OnResultTypeChanged()
    {
        if (_editing is null) return;
        if (_editing.ResultType == SubtestResultType.GradedReaction && _editing.Choices.Count == 0)
        {
            LoadDefaultGradedChoices();
        }
    }

    private void AddChoice()
    {
        if (_editing is null) return;
        _editing.Choices.Add(new ChoiceRow { Polarity = ReactionPolarity.Negative });
    }

    private void RemoveChoice(int index)
    {
        if (_editing is null || index < 0 || index >= _editing.Choices.Count) return;
        _editing.Choices.RemoveAt(index);
    }

    private static List<string> MissingGrades(SubtestDefinitionDto s) =>
        s.ResultType != SubtestResultType.GradedReaction || s.Choices.Count == 0
            ? []
            : SubtestChoiceDefinitions.MissingStandardGrades(s.Choices.Select(c => c.Code)).Select(g => g.Code).ToList();

    // Adds the missing standard grades to every graded subtest through the same save the editor uses.
    private async Task AddMissingGradesToAllAsync()
    {
        _busy = true;
        var done = new List<string>();
        var failed = new List<string>();
        foreach (var s in MissingAny)
        {
            var current = await Api.GetAdminSubtestAsync(s.Id);
            if (!current.Succeeded || current.Value is null)
            {
                failed.Add($"{s.Code}: {current.ToFeedback().Error ?? "could not be read"}");
                continue;
            }

            var model = EditModel.From(current.Value);
            foreach (var g in SubtestChoiceDefinitions.MissingStandardGrades(model.Choices.Select(c => c.Code)))
            {
                model.Choices.Add(new ChoiceRow { Code = g.Code, Label = g.Label, Polarity = g.Polarity ?? ReactionPolarity.Neutral });
            }

            var saved = await Api.UpdateAdminSubtestAsync(s.Id, model.ToRequest(_bulkReason));
            if (saved.Succeeded)
            {
                done.Add(s.Code);
            }
            else
            {
                failed.Add($"{s.Code}: {saved.ToFeedback().Error ?? "not saved"}");
            }
        }

        _busy = false;
        _feedback = failed.Count == 0
            ? Feedback.Succeed($"Added the missing standard grades to {done.Count} subtest{(done.Count == 1 ? "" : "s")}.")
            : Feedback.Fail($"Updated {done.Count}; not updated: {string.Join("; ", failed)}");
        _bulkReason = null;
        await LoadAsync();
    }

    private void AddMissingStandardGrades()
    {
        if (_editing is null) return;
        foreach (var g in SubtestChoiceDefinitions.MissingStandardGrades(_editing.Choices.Select(c => c.Code)))
        {
            _editing.Choices.Add(new ChoiceRow { Code = g.Code, Label = g.Label, Polarity = g.Polarity ?? ReactionPolarity.Neutral });
        }
    }

    private void LoadDefaultGradedChoices()
    {
        if (_editing is null) return;
        _editing.Choices = SubtestChoiceDefinitions.DefaultGradedReaction()
            .Select(c => new ChoiceRow { Code = c.Code, Label = c.Label, Polarity = c.Polarity ?? ReactionPolarity.Neutral })
            .ToList();
    }

    private sealed class ChoiceRow
    {
        public string Code { get; set; } = string.Empty;
        public string Label { get; set; } = string.Empty;
        public ReactionPolarity Polarity { get; set; } = ReactionPolarity.Negative;
    }

    private sealed class EditModel
    {
        public string Code { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public SubtestResultType ResultType { get; set; }
        public List<ChoiceRow> Choices { get; set; } = new();

        public static EditModel From(SubtestDefinitionDto s) => new()
        {
            Code = s.Code,
            Name = s.Name,
            ResultType = s.ResultType,
            Choices = s.Choices.Select(c => new ChoiceRow
            {
                Code = c.Code,
                Label = c.Label,
                Polarity = c.Polarity ?? ReactionPolarity.Neutral
            }).ToList()
        };

        public SaveSubtestDefinitionRequest ToRequest(string? reason) => new(
            Code,
            Name,
            ResultType,
            ResultType == SubtestResultType.FreeText
                ? null
                : Choices.Select(c => new SubtestChoiceDto(
                    c.Code,
                    c.Label,
                    ResultType == SubtestResultType.GradedReaction ? c.Polarity : null)).ToList(),
            reason);
    }
}
