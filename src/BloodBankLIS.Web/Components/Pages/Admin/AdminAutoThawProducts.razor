@page "/admin/auto-thaw-products"
@using BloodBankLIS.Application.Admin
@inject UserSession Session
@inject BloodBankApiClient Api

<PageTitle>Auto thaw products &middot; Admin</PageTitle>

<div class="flex-between">
    <h1>Auto thaw products</h1>
</div>
<p class="muted">ISBT product codes, such as E0707, that can be thawed in place when allocated. The code stays the same; expiration becomes 24 hours after the thaw time.</p>

<Outcome Value="_feedback" />

<div class="bb-card" style="margin-top:1rem;">
    <div class="flex gap" style="margin-bottom:.6rem;">
        <label class="flex" style="gap:.35rem;"><input type="checkbox" @bind="_includeInactive" @bind:after="LoadAsync" /> Include inactive</label>
    </div>

    @if (_loading)
    {
        <div class="loading">Loading...</div>
    }
    else if (VisibleRows.Count == 0)
    {
        <div class="empty">No auto-thaw product codes.</div>
    }
    else
    {
        <table class="bb">
            <thead><tr><th>Product code</th><th>Description</th><th>Status</th><th></th></tr></thead>
            <tbody>
                @foreach (var row in VisibleRows)
                {
                    <tr>
                        <td class="mono">@row.ProductCode</td>
                        <td>@row.Description</td>
                        <td>@(row.IsActive ? "Active" : "Inactive")</td>
                        <td class="right nowrap">
                            @if (row.IsActive && CanActivate)
                            {
                                <button class="btn btn-ghost btn-sm" disabled="@_busy" @onclick="() => SetActiveAsync(row.Id, false)">Remove</button>
                            }
                            else if (!row.IsActive && CanActivate)
                            {
                                <button class="btn btn-ghost btn-sm" disabled="@_busy" @onclick="() => SetActiveAsync(row.Id, true)">Activate</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@if (CanEdit)
{
    <div class="bb-card" style="margin-top:1rem;">
        <h2>Add product code</h2>
        <div class="form-row">
            <div class="field">
                <label>ISBT product code</label>
                <select @bind="_productCode">
                    <option value="">— Select a product code —</option>
                    @foreach (var productCode in AvailableCodes)
                    {
                        <option value="@productCode.ProductDescriptionCode">@productCode.ProductDescriptionCode — @productCode.Description</option>
                    }
                </select>
            </div>
        </div>
        <button class="btn btn-primary" disabled="@(_busy || string.IsNullOrEmpty(_productCode))" @onclick="AddAsync">Add</button>
    </div>
}

@code {
    private bool _loading = true;
    private bool _busy;
    private bool _includeInactive;
    private string _productCode = string.Empty;
    private List<AutoThawProductDto> _list = new();
    private List<IsbtProductCodeDto> _catalog = new();
    private Feedback? _feedback;

    private bool CanEdit => Session.Has(PermissionCodes.AdminConfigEdit);
    private bool CanActivate => Session.Has(PermissionCodes.AdminConfigActivate);

    private List<AutoThawProductDto> VisibleRows =>
        (_includeInactive ? _list : _list.Where(row => row.IsActive))
            .OrderBy(row => row.ProductCode)
            .ToList();

    private IEnumerable<IsbtProductCodeDto> AvailableCodes =>
        _catalog.Where(code =>
                !code.IsRetired
                && string.Equals(code.ComponentClass, "Plasma", StringComparison.OrdinalIgnoreCase)
                && _list.All(row => !string.Equals(row.ProductCode, code.ProductDescriptionCode, StringComparison.OrdinalIgnoreCase)))
            .OrderBy(code => code.ProductDescriptionCode);

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        var rows = await Api.GetAdminAutoThawProductsAsync(includeInactive: true);
        var catalog = await Api.GetAdminIsbtProductCodesAsync();
        _list = rows.Succeeded ? rows.Value ?? new() : new();
        _catalog = catalog.Succeeded ? catalog.Value ?? new() : new();
        if (!rows.Succeeded) _feedback = rows.ToFeedback();
        else if (!catalog.Succeeded) _feedback = catalog.ToFeedback();
        _loading = false;
    }

    private async Task AddAsync()
    {
        if (string.IsNullOrWhiteSpace(_productCode)) return;
        _busy = true;
        var r = await Api.CreateAdminAutoThawProductAsync(new SaveAutoThawProductRequest(_productCode));
        _busy = false;
        _feedback = r.Succeeded ? r.ToFeedback("Product code added.") : r.ToFeedback();
        if (r.Succeeded)
        {
            _productCode = string.Empty;
            await LoadAsync();
        }
    }

    private async Task SetActiveAsync(long id, bool active)
    {
        _busy = true;
        var r = await Api.SetAdminAutoThawProductActiveAsync(id, active);
        _busy = false;
        _feedback = r.Succeeded ? r.ToFeedback(active ? "Activated." : "Removed.") : r.ToFeedback();
        if (r.Succeeded) await LoadAsync();
    }
}
