@page "/admin/special-requirements"
@using BloodBankLIS.Application.Admin
@using BloodBankLIS.Domain.Rules.Config
@inject UserSession Session
@inject BloodBankApiClient Api

<PageTitle>Special Requirements &middot; Admin</PageTitle>

<div class="flex-between">
    <h1>Special Requirements</h1>
    <div class="flex gap">
        <a class="btn btn-ghost" href="/admin/blood-attributes">Open Blood Attributes</a>
        <a class="btn btn-ghost" href="/admin/compatibility-rules">Open Compatibility Tables</a>
        @if (CanEdit)
        {
            <button class="btn btn-primary" @onclick="NewDraft">New requirement</button>
        }
    </div>
</div>
<p class="muted">The requirements staff can add to a patient chart. Unit typings and modifications apply to one unit category and are enforced at selection and issue; informational ones show as a banner.</p>
<details class="bb-help">
    <summary>How it works</summary>
    <ul>
        <li><strong>Unit typings</strong>: what the unit must type as, for one unit category: an allowed ABO group, RhD negative, antigen negative, or a negative unit test (CMV, HbS). A unit test is met by the product code carrying the attribute or by a negative result recorded on the unit.</li>
        <li><strong>Unit modifications</strong>: the product attribute the unit must carry, for one unit category (irradiated, washed, leukoreduced, volume reduced).</li>
        <li><strong>Informational</strong>: banner text shown on the patient chart and the issue desk. Never enforced.</li>
        <li><strong>Issue procedures</strong>: acknowledgments at issue, complex crossmatch, A1/A2 subgroup typing.</li>
        <li>Unit typings and modifications that are not met stop selection and issue. On emergency or MTP release they need an authorized override instead. Issue procedures are never overridden.</li>
        <li>Entries made before unit categories show <em>All categories</em> and apply to every unit, as before.</li>
        <li>A requirement on the chart applies from its start date and no longer applies on and after its end date.</li>
    </ul>
</details>
<div class="flex gap" style="margin:.75rem 0;">
    @foreach (var category in Enum.GetValues<SpecialRequirementCategory>())
    {
        var c = category;
        <button type="button" class="btn btn-sm @(_category == c ? "btn-primary" : "btn-secondary")" @onclick="() => SelectCategory(c)">@TabName(c) (@_items.Count(d => d.Category == c))</button>
    }
</div>

<Outcome Value="_feedback" />

<div class="flex gap" style="margin:1rem 0 .6rem;">
    <input style="flex:1;" placeholder="Filter by code or name" @bind="_filter" @bind:event="oninput" />
    <label class="flex" style="gap:.35rem;"><input type="checkbox" @bind="_includeInactive" @bind:after="LoadAsync" /> Include inactive</label>
</div>

@if (_loading)
{
    <div class="loading">Loading...</div>
}
else
{
    var rows = Filtered.Where(d => d.Category == _category).ToList();
    <div class="bb-card" style="margin-top:1rem;">
        <div class="bb-card-title"><h3>@TabName(_category)</h3></div>
        @if (rows.Count == 0)
        {
            <div class="empty">No @TabName(_category).ToLowerInvariant().</div>
        }
        else
        {
            <div class="table-scroll">
            <table class="bb">
                <thead>
                    <tr>
                        <th>Code</th><th>Name</th>
                        @if (IsUnitFact(_category)) { <th>Unit category</th> }
                        <th>@(_category == SpecialRequirementCategory.Informational ? "Banner text" : "Requires")</th>
                        <th>Ver</th><th>Status</th><th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in rows)
                    {
                        <tr>
                            <td class="mono">@d.Code</td>
                            <td>@d.NameLabel</td>
                            @if (IsUnitFact(_category)) { <td>@SpecialRequirementLabel.UnitCategory(d.Category, d.ComponentClass)</td> }
                            <td>@Requires(d)</td>
                            <td>@d.Version</td>
                            <td>@StatusBadge(d)</td>
                            <td class="right nowrap">
                                <button class="btn btn-ghost btn-sm" @onclick="() => EditAsync(d.Id)">Edit</button>
                                @if (Session.Has(PermissionCodes.AdminAuditReview))
                                {
                                    <button class="btn btn-ghost btn-sm" @onclick="() => ShowHistoryAsync(d.Id)">History</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        }
    </div>
}

@if (_editing is not null)
{
    <div class="bb-card" style="margin-top:1rem;" data-scroll-on-show>
        <h2>@(_editId is null ? "New special requirement" : $"Edit: {_editing.Code}")</h2>
        <p class="muted">@TabName(_editing.Category)</p>
        <div class="form-row">
            <div class="field"><label>Code</label><input class="mono" @bind="_editing.Code" disabled="@(_editId is not null)" /></div>
            <div class="field"><label>Name</label><input @bind="_editing.Name" placeholder="@NamePlaceholder(_editing.Category)" /></div>
            @if (IsUnitFact(_editing.Category))
            {
                <div class="field"><label>Unit category</label>
                    <select @bind="_editing.ComponentClassValue">
                        @if (_editId is not null && _editing.ComponentClass is null)
                        {
                            <option value="">All categories</option>
                        }
                        else
                        {
                            <option value="">Choose...</option>
                        }
                        @foreach (var c in Enum.GetValues<ComponentClass>()) { <option value="@c">@ComponentClassLabels.Label(c)</option> }
                    </select>
                </div>
            }
            @if (_editing.Category == SpecialRequirementCategory.UnitTyping)
            {
                <div class="field"><label>Unit must be</label>
                    <select @bind="_editing.EnforcementKind">
                        @foreach (var k in SpecialRequirementDefinitionValidator.KindsFor(SpecialRequirementCategory.UnitTyping)) { <option value="@k">@SpecialRequirementLabel.Kind(k)</option> }
                    </select>
                </div>
                @if (_editing.EnforcementKind == SpecialRequirementEnforcementKind.RequireUnitAbo)
                {
                    <div class="field"><label>Allowed unit ABO groups</label>
                        <div class="flex gap">
                            @foreach (var g in new[] { AboGroup.O, AboGroup.A, AboGroup.B, AboGroup.AB })
                            {
                                var group = g;
                                <label class="flex" style="gap:.25rem;"><input type="checkbox" checked="@_editing.Allows(group)" @onchange="e => _editing.SetAllowed(group, e.Value is true)" /> @group</label>
                            }
                        </div>
                    </div>
                }
                @if (_editing.EnforcementKind == SpecialRequirementEnforcementKind.RequireAntigenNegative)
                {
                    <div class="field"><label>Antigen</label><input class="mono" @bind="_editing.AntigenCode" placeholder="Blank: entered on the chart" /></div>
                }
                @if (_editing.EnforcementKind == SpecialRequirementEnforcementKind.RequireUnitTestNegative)
                {
                    <div class="field"><label>Unit test code</label><input class="mono" @bind="_editing.UnitTestCode" placeholder="CMV / HBS" /></div>
                    <div class="field"><label>Or product attribute</label>@AttributeInput()</div>
                }
            }
            @if (_editing.Category == SpecialRequirementCategory.UnitModification)
            {
                <div class="field"><label>Product attribute</label>@AttributeInput()</div>
            }
            @if (_editing.Category == SpecialRequirementCategory.IssueProcedure)
            {
                <div class="field"><label>Level</label>
                    <select @bind="_editing.Level">@foreach (var l in Enum.GetValues<SpecialRequirementLevel>()) { <option value="@l">@Ui.EnumText(l)</option> }</select>
                </div>
                <div class="field"><label>Enforcement</label>
                    <select @bind="_editing.EnforcementKind">
                        @foreach (var k in SpecialRequirementDefinitionValidator.KindsFor(SpecialRequirementCategory.IssueProcedure)) { <option value="@k">@SpecialRequirementLabel.Kind(k)</option> }
                    </select>
                </div>
            }
            <div class="field"><label>Sort order</label><input type="number" @bind="_editing.SortOrder" /></div>
            <div class="field" style="grid-column:1/-1;"><label>@(_editing.Category == SpecialRequirementCategory.Informational ? "Banner text (required)" : "Instruction")</label><input @bind="_editing.Instruction" /></div>
        </div>
        <div class="field" style="margin-top:.6rem;"><label>Change reason @(EditingActive ? "(required)" : "(optional)")</label>
            <input @bind="_changeReason" placeholder="Why is this change being made?" />
        </div>
        <div class="flex gap" style="margin-top:.6rem;">
            @if (CanEdit)
            {
                <button class="btn btn-primary" disabled="@_busy" @onclick="SaveAsync">Save</button>
                @if (_editId is not null && !_editing.IsActive && CanActivate)
                {
                    <button class="btn btn-secondary" disabled="@_busy" @onclick="ActivateAsync">Activate</button>
                }
                @if (_editId is not null && _editing.IsActive && CanActivate)
                {
                    <button class="btn btn-secondary" disabled="@_busy" @onclick="DeactivateAsync">Deactivate</button>
                }
            }
            <button class="btn btn-ghost" @onclick="CancelEdit">Cancel</button>
        </div>
    </div>
}

@if (_historyEntityId is not null)
{
    <ConfigHistoryPanel EntityType="SpecialRequirementDefinition" EntityId="_historyEntityId.Value" OnClose="() => _historyEntityId = null" />
}

@code {
    private bool CanEdit => Session.Has(PermissionCodes.AdminConfigEdit);
    private bool CanActivate => Session.Has(PermissionCodes.AdminConfigActivate);

    private List<SpecialRequirementDefinitionDto> _items = new();
    private List<ProductAttributeDto> _attributes = new();
    private SpecialRequirementCategory _category = SpecialRequirementCategory.UnitTyping;
    private string _filter = string.Empty;
    private bool _includeInactive = true;
    private bool _loading = true;
    private bool _busy;
    private Feedback? _feedback;
    private long? _editId;
    private EditModel? _editing;
    private string _changeReason = string.Empty;
    private long? _historyEntityId;

    private bool EditingActive => _editId is not null && _editing?.IsActive == true;

    private IEnumerable<SpecialRequirementDefinitionDto> Filtered =>
        string.IsNullOrWhiteSpace(_filter)
            ? _items
            : _items.Where(d =>
                d.Code.Contains(_filter, StringComparison.OrdinalIgnoreCase)
                || d.Name.Contains(_filter, StringComparison.OrdinalIgnoreCase)
                || d.NameLabel.Contains(_filter, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        _attributes = ((await Api.GetProductAttributesAsync()).Value ?? new()).Where(a => a.IsActive).ToList();
    }

    private void SelectCategory(SpecialRequirementCategory category)
    {
        _category = category;
        CancelEdit();
    }

    private static bool IsUnitFact(SpecialRequirementCategory c) =>
        c is SpecialRequirementCategory.UnitTyping or SpecialRequirementCategory.UnitModification;

    private static string TabName(SpecialRequirementCategory c) => c switch
    {
        SpecialRequirementCategory.UnitTyping => "Unit typings",
        SpecialRequirementCategory.UnitModification => "Unit modifications",
        SpecialRequirementCategory.Informational => "Informational",
        _ => "Issue procedures"
    };

    private static string NamePlaceholder(SpecialRequirementCategory c) => c switch
    {
        SpecialRequirementCategory.UnitTyping => "e.g. Group O red cells only",
        SpecialRequirementCategory.UnitModification => "e.g. Irradiated red cells",
        SpecialRequirementCategory.Informational => "e.g. Call the transfusion service physician",
        _ => "e.g. Blood warmer"
    };

    private static string Requires(SpecialRequirementDefinitionDto d) => d.EnforcementKind switch
    {
        SpecialRequirementEnforcementKind.RequireUnitAbo => $"Group {d.AllowedAboGroups?.Replace(",", " or ")}",
        SpecialRequirementEnforcementKind.RequireRhNegative => "RhD negative",
        SpecialRequirementEnforcementKind.RequireAntigenNegative =>
            string.IsNullOrWhiteSpace(d.AntigenCode) ? "Antigen negative (antigen on the chart)" : $"{d.AntigenCode} negative",
        SpecialRequirementEnforcementKind.RequireUnitTestNegative =>
            $"{d.UnitTestCode} test negative" + (string.IsNullOrWhiteSpace(d.ProductAttributeCode) ? string.Empty : $" or {d.ProductAttributeCode} product"),
        SpecialRequirementEnforcementKind.RequireProductAttribute => d.ProductAttributeCode ?? string.Empty,
        SpecialRequirementEnforcementKind.Informational => d.Instruction ?? string.Empty,
        _ => SpecialRequirementLabel.Kind(d.EnforcementKind)
    };

    private RenderFragment AttributeInput() => __builder =>
    {
        if (_editing is null) return;
        if (_attributes.Count == 0)
        {
            <input class="mono" @bind="_editing.ProductAttributeCode" placeholder="IRRAD / WASHED" />
        }
        else
        {
            <select @bind="_editing.ProductAttributeCode">
                <option value="">@(_editing.Category == SpecialRequirementCategory.UnitTyping ? "None" : "Choose...")</option>
                @foreach (var a in _attributes) { <option value="@a.Code">@a.Name (@a.Code)</option> }
            </select>
        }
    };

    private async Task LoadAsync()
    {
        _loading = true;
        _items = (await Api.GetAdminSpecialRequirementsAsync(_includeInactive)).Value ?? new();
        _loading = false;
    }

    private void NewDraft()
    {
        _editId = null;
        _changeReason = string.Empty;
        _editing = EditModel.New(_category, (_items.Count + 1) * 10);
    }

    private async Task EditAsync(long id)
    {
        var r = await Api.GetAdminSpecialRequirementAsync(id);
        if (r.Value is null) { _feedback = r.ToFeedback(); return; }
        _editId = id;
        _changeReason = string.Empty;
        _editing = EditModel.From(r.Value);
    }

    private async Task SaveAsync()
    {
        if (_editing is null) return;
        _busy = true;
        var req = _editing.ToRequest(_changeReason);
        var r = _editId is null
            ? await Api.CreateAdminSpecialRequirementAsync(req)
            : await Api.UpdateAdminSpecialRequirementAsync(_editId.Value, req);
        _busy = false;
        _feedback = r.ToFeedback(_editId is null ? "Special requirement created." : "Special requirement saved.");
        if (r.Succeeded && r.Value is not null)
        {
            _editId = r.Value.Id;
            _editing = EditModel.From(r.Value);
            await LoadAsync();
        }
    }

    private async Task ActivateAsync()
    {
        if (_editId is null) return;
        _busy = true;
        var r = await Api.ActivateAdminSpecialRequirementAsync(_editId.Value, _changeReason);
        _busy = false;
        _feedback = r.ToFeedback("Special requirement activated.");
        if (r.Succeeded && r.Value is not null) { _editing = EditModel.From(r.Value); await LoadAsync(); }
    }

    private async Task DeactivateAsync()
    {
        if (_editId is null) return;
        _busy = true;
        var r = await Api.DeactivateAdminSpecialRequirementAsync(_editId.Value, _changeReason);
        _busy = false;
        _feedback = r.ToFeedback("Special requirement deactivated.");
        if (r.Succeeded && r.Value is not null) { _editing = EditModel.From(r.Value); await LoadAsync(); }
    }

    private void CancelEdit() { _editId = null; _editing = null; _changeReason = string.Empty; }
    private void ShowHistoryAsync(long id) => _historyEntityId = id;

    private static string StatusBadge(SpecialRequirementDefinitionDto d) =>
        d.IsActive ? "Active" : d.IsDraft ? "Draft" : "Inactive";

    private sealed class EditModel
    {
        public string Code { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public SpecialRequirementLevel Level { get; set; } = SpecialRequirementLevel.Unit;
        public SpecialRequirementEnforcementKind EnforcementKind { get; set; } = SpecialRequirementEnforcementKind.RequireProductAttribute;
        public string? ProductAttributeCode { get; set; }
        public string? Instruction { get; set; }
        public int SortOrder { get; set; }
        public bool IsActive { get; set; }
        public SpecialRequirementCategory Category { get; set; }
        public ComponentClass? ComponentClass { get; set; }
        public string? AntigenCode { get; set; }
        public string? UnitTestCode { get; set; }
        private readonly HashSet<AboGroup> _allowed = new();

        // The select binds a string so "All categories" / "Choose..." can be empty.
        public string ComponentClassValue
        {
            get => ComponentClass?.ToString() ?? string.Empty;
            set => ComponentClass = Enum.TryParse<ComponentClass>(value, out var c) ? c : null;
        }

        public bool Allows(AboGroup g) => _allowed.Contains(g);

        public void SetAllowed(AboGroup g, bool allowed)
        {
            if (allowed) _allowed.Add(g); else _allowed.Remove(g);
        }

        public static EditModel New(SpecialRequirementCategory category, int sort) => new()
        {
            Category = category,
            SortOrder = sort,
            Level = category == SpecialRequirementCategory.Informational ? SpecialRequirementLevel.Patient
                : category == SpecialRequirementCategory.IssueProcedure ? SpecialRequirementLevel.Issuing
                : SpecialRequirementLevel.Unit,
            EnforcementKind = SpecialRequirementDefinitionValidator.KindsFor(category)[0]
        };

        public static EditModel From(SpecialRequirementDefinitionDto d)
        {
            var m = new EditModel
            {
                Code = d.Code, Name = d.Name, Level = d.Level, EnforcementKind = d.EnforcementKind,
                ProductAttributeCode = d.ProductAttributeCode, Instruction = d.Instruction,
                SortOrder = d.SortOrder, IsActive = d.IsActive, Category = d.Category,
                ComponentClass = d.ComponentClass, AntigenCode = d.AntigenCode, UnitTestCode = d.UnitTestCode
            };
            foreach (var g in SpecialTransfusionRequirementRule.ParseAboGroups(d.AllowedAboGroups)) m._allowed.Add(g);
            return m;
        }

        public SaveSpecialRequirementDefinitionRequest ToRequest(string? reason)
        {
            var kind = EnforcementKind;
            // Fields that do not belong to the chosen kind are not sent.
            return new(
                Code, Name, Level, kind,
                kind is SpecialRequirementEnforcementKind.RequireProductAttribute or SpecialRequirementEnforcementKind.RequireUnitTestNegative
                    ? ProductAttributeCode : null,
                Instruction, SortOrder,
                string.IsNullOrWhiteSpace(reason) ? null : reason,
                Category,
                Category is SpecialRequirementCategory.UnitTyping or SpecialRequirementCategory.UnitModification ? ComponentClass : null,
                kind == SpecialRequirementEnforcementKind.RequireUnitAbo ? string.Join(",", _allowed.OrderBy(g => g)) : null,
                kind == SpecialRequirementEnforcementKind.RequireAntigenNegative ? AntigenCode : null,
                kind == SpecialRequirementEnforcementKind.RequireUnitTestNegative ? UnitTestCode : null);
        }
    }
}
