@page "/admin/isbt-product-codes"
@using BloodBankLIS.Application.Admin
@inject UserSession Session
@inject BloodBankApiClient Api

<PageTitle>ISBT Product Codes &middot; Admin</PageTitle>

<div class="flex-between">
    <h1>ISBT Product Description Codes</h1>
</div>
<p class="muted">
    Supplier product codes permitted for inventory intake. Units must match one of these codes.
    Seeded rows are a US public subset pending ICCBBA validation. Official tables must be
    imported from a licensed extract — this software does not invent product or ABO/RhD codes (OCD-004).
    Microsoft Access and Excel ICCBBA databases are not parsed; export CSV, TSV, or JSON first.
</p>

<Outcome Value="_feedback" />

@if (CanImport)
{
    <div class="bb-card" style="margin-top:1rem;">
        <div class="bb-card-title"><h3>Import licensed ICCBBA catalog</h3></div>
        <p class="muted">Same license acknowledgment and standard version apply to drop-folder files, uploaded extracts, and pasted JSON. Placeholder or pending-ICCBBA versions are rejected.</p>
        <div class="form-row">
            <div class="field"><label>Standard version</label><input class="mono" @bind="_importVersion" placeholder="ICCBBA-licensed version id" /></div>
            <div class="field"><label>Reason</label><input @bind="_importReason" placeholder="Facility validation of licensed extract" /></div>
        </div>
        <label class="flex" style="gap:.35rem;margin:.5rem 0;">
            <input type="checkbox" @bind="_importAck" />
            I confirm this payload is from a current ICCBBA license held by the facility.
        </label>

        <h4 style="margin-top:1rem;">Drop-folder extracts</h4>
        @if (_extracts.Count == 0)
        {
            <p class="muted">No ICCBBA extract files in the drop folder. Place CSV, TSV, or JSON exports in <span class="mono">testdata/isbt128/extracts</span> (or <span class="mono">Iccbba:ExtractDirectory</span>) and refresh.</p>
        }
        else
        {
            <p class="muted">@_extracts.Count file(s) detected. Select files to import.</p>
            <ul style="list-style:none;padding:0;margin:.4rem 0;">
                @foreach (var file in _extracts)
                {
                    <li>
                        <label class="flex" style="gap:.35rem;">
                            <input type="checkbox" checked="@_selectedDrop.Contains(file.FileName)"
                                   @onchange="e => ToggleDrop(file.FileName, e.Value is true)" />
                            <span class="mono">@file.FileName</span>
                            <span class="muted">@file.Kind · @file.SizeBytes bytes</span>
                        </label>
                    </li>
                }
            </ul>
            <button class="btn btn-primary" style="margin-top:.4rem;" disabled="@_busy" @onclick="ImportDropAsync">Import selected extracts</button>
        }

        <h4 style="margin-top:1rem;">Upload extract files</h4>
        <p class="muted">CSV, TSV, TXT, or JSON. Access/Excel files are rejected.</p>
        <InputFile OnChange="OnUploadSelected" accept=".csv,.tsv,.txt,.json" multiple />
        @if (_uploads.Count > 0)
        {
            <p class="muted" style="margin-top:.4rem;">@_uploads.Count file(s) ready: @string.Join(", ", _uploads.Select(f => f.FileName))</p>
        }
        <button class="btn btn-primary" style="margin-top:.4rem;" disabled="@(_busy || _uploads.Count == 0)" @onclick="ImportUploadsAsync">Import uploaded files</button>

        <h4 style="margin-top:1rem;">Paste licensee JSON</h4>
        <div class="field">
            <label>Licensed rows (JSON)</label>
            <textarea rows="8" class="mono" style="width:100%;" @bind="_importJson"
                placeholder='{"productCodes":[{"productDescriptionCode":"T0001","description":"Licensee-supplied example","componentClass":"Other"}],"aboRhdCodes":[{"code":"T1","abo":"O","rhD":"Positive"}]}'></textarea>
        </div>
        <button class="btn btn-primary" style="margin-top:.6rem;" disabled="@_busy" @onclick="ImportJsonAsync">Import licensed catalog</button>
    </div>
}

<div class="bb-card" style="margin-top:1rem;">
    <div class="flex gap" style="margin-bottom:.6rem;">
        <input style="flex:1;" placeholder="Filter by code, description, or class" @bind="_filter" @bind:event="oninput" />
        <label class="flex" style="gap:.35rem;">
            <input type="checkbox" @bind="_hideRetired" /> Hide retired
        </label>
    </div>

    @if (_loading)
    {
        <div class="loading">Loading...</div>
    }
    else if (!Filtered.Any())
    {
        <div class="empty">No product description codes found. Restart the app so the database seeder can load the US supplier subset.</div>
    }
    else
    {
        <p class="muted" style="margin-bottom:.5rem;">@Filtered.Count() of @_items.Count code(s)</p>
        <table class="bb">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Product description</th>
                    <th>Class</th>
                    <th>Ext. div.</th>
                    <th>Status</th>
                    <th>Version</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Filtered)
                {
                    <tr>
                        <td class="mono">@c.ProductDescriptionCode</td>
                        <td>@c.Description</td>
                        <td>@c.ComponentClass</td>
                        <td>@(c.RequiresExtendedDivision ? "Yes" : "No")</td>
                        <td>
                            @if (c.IsRetired)
                            {
                                <span class="badge badge-gray">Retired</span>
                            }
                            else if (c.IsPlaceholder)
                            {
                                <span class="badge badge-amber">Pending ICCBBA</span>
                            }
                            else
                            {
                                <span class="badge badge-green">Active</span>
                            }
                        </td>
                        <td class="mono muted">@c.StandardVersion</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private List<IsbtProductCodeDto> _items = new();
    private List<IccbbaExtractFileDto> _extracts = new();
    private readonly HashSet<string> _selectedDrop = new(StringComparer.OrdinalIgnoreCase);
    private List<IccbbaExtractUploadFile> _uploads = new();
    private bool _loading = true;
    private string _filter = string.Empty;
    private bool _hideRetired = true;
    private Feedback? _feedback;
    private bool _busy;
    private bool _importAck;
    private string _importVersion = string.Empty;
    private string _importReason = string.Empty;
    private string _importJson = """{"productCodes":[],"aboRhdCodes":[]}""";

    private bool CanImport => Session.Has(PermissionCodes.AdminConfigEdit);

    private IEnumerable<IsbtProductCodeDto> Filtered
    {
        get
        {
            IEnumerable<IsbtProductCodeDto> q = _items;
            if (_hideRetired)
                q = q.Where(c => !c.IsRetired);
            if (!string.IsNullOrWhiteSpace(_filter))
            {
                var f = _filter.Trim();
                q = q.Where(c =>
                    c.ProductDescriptionCode.Contains(f, StringComparison.OrdinalIgnoreCase)
                    || c.Description.Contains(f, StringComparison.OrdinalIgnoreCase)
                    || c.ComponentClass.Contains(f, StringComparison.OrdinalIgnoreCase));
            }
            return q;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!Session.Has(PermissionCodes.AdminConfigView))
        {
            _feedback = Feedback.Fail("You do not have permission to view configuration.");
            _loading = false;
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var r = await Api.GetAdminIsbtProductCodesAsync();
        _loading = false;
        if (r.Succeeded)
            _items = r.Value ?? new();
        else
            _feedback = r.ToFeedback();

        if (CanImport)
        {
            var extracts = await Api.GetAdminIsbtExtractsAsync();
            if (extracts.Succeeded)
                _extracts = extracts.Value ?? new();
        }
    }

    private void ToggleDrop(string fileName, bool selected)
    {
        if (selected)
            _selectedDrop.Add(fileName);
        else
            _selectedDrop.Remove(fileName);
    }

    private async Task OnUploadSelected(InputFileChangeEventArgs e)
    {
        var uploaded = new List<IccbbaExtractUploadFile>();
        foreach (var file in e.GetMultipleFiles(20))
        {
            await using var stream = file.OpenReadStream(20 * 1024 * 1024);
            using var reader = new StreamReader(stream);
            uploaded.Add(new IccbbaExtractUploadFile(file.Name, await reader.ReadToEndAsync()));
        }

        _uploads = uploaded;
    }

    private async Task ImportDropAsync()
    {
        _busy = true;
        var req = new LicensedIsbtExtractImportRequest(
            _importVersion,
            _importAck,
            string.IsNullOrWhiteSpace(_importReason) ? null : _importReason,
            _selectedDrop.ToList());
        var r = await Api.ImportIccbbaExtractFilesAsync(req);
        _busy = false;
        ApplyImportResult(r);
        if (r.Succeeded)
            await LoadAsync();
    }

    private async Task ImportUploadsAsync()
    {
        _busy = true;
        var r = await Api.ImportIccbbaExtractUploadAsync(
            _importVersion,
            _importAck,
            string.IsNullOrWhiteSpace(_importReason) ? null : _importReason,
            _uploads.Select(f => (f.FileName, f.Content)).ToList());
        _busy = false;
        ApplyImportResult(r);
        if (r.Succeeded)
            await LoadAsync();
    }

    private async Task ImportJsonAsync()
    {
        LicensedRowsJson? rows;
        try
        {
            rows = System.Text.Json.JsonSerializer.Deserialize<LicensedRowsJson>(
                _importJson,
                new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
        }
        catch (System.Text.Json.JsonException)
        {
            _feedback = Feedback.Fail("Licensed rows JSON could not be parsed.");
            return;
        }

        _busy = true;
        var req = new LicensedIsbtCatalogImportRequest(
            _importVersion,
            _importAck,
            string.IsNullOrWhiteSpace(_importReason) ? null : _importReason,
            rows?.ProductCodes,
            rows?.AboRhdCodes);
        var r = await Api.ImportLicensedIsbtCatalogAsync(req);
        _busy = false;
        ApplyImportResult(r);
        if (r.Succeeded)
            await LoadAsync();
    }

    private void ApplyImportResult(ApiResult<LicensedIsbtCatalogImportResult> r)
    {
        _feedback = r.ToFeedback(r.Succeeded
            ? $"Imported {r.Value?.ProductCodesImported ?? 0} product and {r.Value?.AboRhdCodesImported ?? 0} ABO/RhD row(s)."
            : null);
    }

    private sealed class LicensedRowsJson
    {
        public List<LicensedIsbtProductCodeRow>? ProductCodes { get; set; }
        public List<LicensedIsbtAboRhdRow>? AboRhdCodes { get; set; }
    }
}
