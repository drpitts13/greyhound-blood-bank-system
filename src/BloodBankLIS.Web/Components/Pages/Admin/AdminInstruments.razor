@page "/admin/instruments"
@using BloodBankLIS.Domain.Enums
@inject UserSession Session
@inject BloodBankApiClient Api
@inject IJSRuntime Js
@inject ReportDownloadCache Downloads
@using BloodBankLIS.Domain.Interfaces
@using BloodBankLIS.Domain.Reporting

<PageTitle>Instrument Interfaces · Admin</PageTitle>

<div class="flex-between">
    <h1>Instrument Interfaces</h1>
    <div class="flex gap">
        <button class="btn btn-secondary" @onclick="() => _showHelp = !_showHelp">
            @(_showHelp ? "Hide help" : "Help")
        </button>
        @if (CanManage)
        {
            <button class="btn btn-primary" @onclick="NewDraft">New interface</button>
        }
    </div>
</div>
<div class="flex gap" style="margin:.6rem 0 1rem;flex-wrap:wrap;">
    <a class="btn btn-ghost" href="/instruments">Open status</a>
    <a class="btn btn-ghost" href="/instruments/simulator">Simulator</a>
</div>
<p class="muted">Define ASTM instrument connections (TCP/IP), field maps, translations, and if/then rules. Leave IP blank to listen as the server. Restart the API after changing a listen port.</p>

<Outcome Value="_feedback" />

<div class="bb-card" style="margin-top:1rem;">
    @if (_loading)
    {
        <div class="loading">Loading...</div>
    }
    else if (_items.Count == 0)
    {
        <div class="empty">No instrument interfaces configured.</div>
    }
    else
    {
        <table class="bb">
            <thead><tr><th>Name</th><th>Connection</th><th>Maps</th><th>Rules</th><th>Status</th><th></th></tr></thead>
            <tbody>
                @foreach (var item in _items)
                {
                    <tr>
                        <td>@item.Name</td>
                        <td class="mono">@(item.Connection.IsServer ? $"listen :{item.Connection.Port}" : $"{item.Connection.IpAddress}:{item.Connection.Port}")</td>
                        <td>@item.FieldMappings.Count / @item.Translations.Count</td>
                        <td>@item.Rules.Count</td>
                        <td>
                            @if (item.IsEnabled) { <span class="badge badge-green">Enabled</span> }
                            else { <span class="badge badge-gray">Disabled</span> }
                        </td>
                        <td class="right nowrap">
                            <button class="btn btn-ghost btn-sm" @onclick="() => EditAsync(item.Id)">Edit</button>
                            @if (Session.Has(PermissionCodes.AdminAuditReview))
                            {
                                <button class="btn btn-ghost btn-sm" @onclick="() => ShowHistoryAsync(item.Id)">History</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@if (_editing is not null)
{
    <div class="bb-card" style="margin-top:1rem;" data-scroll-on-show>
        <h2>@(_editId is null ? "New interface" : $"Edit: {_editing.Name}")</h2>
        <div class="flex gap" style="margin-bottom:1rem;flex-wrap:wrap;">
            <button type="button" class="btn @TabClass("connection")" @onclick='() => _tab = "connection"'>Connection</button>
            <button type="button" class="btn @TabClass("configuration")" @onclick='() => _tab = "configuration"'>Configuration</button>
            <button type="button" class="btn @TabClass("translations")" @onclick='() => _tab = "translations"' data-inst-translations-tab>Translations</button>
            <button type="button" class="btn @TabClass("rules")" @onclick='() => _tab = "rules"'>Interface rules</button>
        </div>

        @if (_tab == "connection")
        {
            <div class="form-row">
                <div class="field"><label>Name</label><input @bind="_editing.Name" /></div>
                <div class="field"><label>Environment</label><input @bind="_editing.Environment" /></div>
                <div class="field"><label>IP address</label><input @bind="_editing.IpAddress" placeholder="blank = listen (server)" /></div>
                <div class="field"><label>Port</label><input type="number" @bind="_editing.Port" /></div>
            </div>
            <p class="muted">When IP is empty the application listens on the port. When IP is set, the application connects as the client.</p>
        }
        else if (_tab == "configuration")
        {
            <div class="form-row">
                <div class="field" style="min-width:22rem;">
                    <label>An R record is an interpretation when</label>
                    <select @bind="_editing.InterpretationMatch">
                        <option value="@InstrumentInterpretationMatch.AnalyteEqualsAssay">Analyte code equals the assay code</option>
                        <option value="@InstrumentInterpretationMatch.AnalyteInList">Analyte code is one of these values</option>
                        <option value="@InstrumentInterpretationMatch.Never">Never — every R record is an analyte result</option>
                    </select>
                </div>
                @if (_editing.InterpretationMatch == InstrumentInterpretationMatch.AnalyteInList)
                {
                    <div class="field" style="flex:1;">
                        <label>Interpretation analyte codes</label>
                        <input class="mono" @bind="_editing.InterpretationAnalyteCodes" placeholder="INTERP, RESULT, Group" />
                    </div>
                }
            </div>
            <p class="muted">
                Map each data item to an ASTM locator such as <span class="mono">P.3</span> or
                <span class="mono">R.4.1</span>.
                <span class="mono">subtest_result</span> and <span class="mono">test_interp</span> can
                share a path; this setting decides which R records are assay-level interpretation versus
                analyte results.
                <button type="button" class="btn btn-ghost btn-sm" @onclick="() => _showHelp = true">Open help</button>
            </p>
            <table class="bb">
                <thead><tr><th>Data item</th><th>ASTM path</th><th>Required</th></tr></thead>
                <tbody>
                    @foreach (var row in _editing.FieldMappings)
                    {
                        <tr>
                            <td class="mono">@row.DataItemKey</td>
                            <td><input class="mono" @bind="row.AstmPath" /></td>
                            <td><input type="checkbox" @bind="row.IsRequired" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else if (_tab == "translations")
        {
            <p class="muted">
                This instrument's codes and values, translated to the LIS's. A result whose test or subtest code has no
                translation is not posted: it waits in instrument failures and is listed under Unmapped values. Once error
                codes are listed here, an error or flag code without a row holds the result (OCD-066).
            </p>
            <div class="flex gap" style="flex-wrap:wrap;margin-bottom:.6rem;" data-inst-xlat-fields>
                @foreach (var f in _xlatFields)
                {
                    var count = _editing.Translations.Count(t => t.DataItemKey == f.Key && !t.IsBlank);
                    <button type="button" class="btn btn-sm @(f.Key == _xlatKey ? "btn-primary" : "btn-secondary")" title="@f.Description"
                            @onclick="() => SelectXlatField(f.Key)" data-inst-xlat-field="@f.Key">
                        @f.DisplayName @if (count > 0) { <span class="badge">@count</span> }
                    </button>
                }
            </div>
            @if (XlatField is { } field)
            {
                <p class="muted" style="margin:.2rem 0 .6rem;">@field.Description</p>
                <datalist id="inst-local-values">
                    @foreach (var v in field.LocalValues)
                    {
                        <option value="@v.Value">@(v.Kind is null ? v.Label : $"{v.Kind}: {v.Label}")</option>
                    }
                </datalist>
                <datalist id="inst-tests">
                    @foreach (var t in TestValues)
                    {
                        <option value="@t.Value">@t.Label</option>
                    }
                </datalist>
                <div class="flex gap" style="justify-content:flex-end;margin-bottom:.4rem;">
                    <button type="button" class="btn btn-ghost btn-sm" @onclick="ExportXlatAsync" disabled="@(!XlatRows.Any(r => !r.IsBlank))">Export CSV</button>
                    @if (CanManage)
                    {
                        <button type="button" class="btn btn-ghost btn-sm" @onclick="() => _xlatImportOpen = !_xlatImportOpen">Import rows</button>
                    }
                </div>
                @if (_xlatImportOpen && CanManage)
                {
                    <div class="bb-card" style="margin-bottom:.6rem;" data-inst-xlat-import>
                        <p class="muted" style="margin-top:0;">Paste rows from a spreadsheet or a CSV file: instrument value, local value, and@(field.AllowsContext ? " an optional test the row is limited to" : " (no third column)"). A header line is fine. Rows go into the table below; Save the interface to keep them.</p>
                        <textarea rows="5" class="mono" style="width:100%;" @bind="_xlatImportText" @bind:event="oninput" data-inst-xlat-import-text></textarea>
                        <div class="flex gap" style="margin-top:.4rem;align-items:center;">
                            <InputFile OnChange="OnXlatFileAsync" accept=".csv,.tsv,.txt" />
                            <button type="button" class="btn btn-secondary btn-sm" @onclick="ApplyXlatImport" disabled="@string.IsNullOrWhiteSpace(_xlatImportText)" data-inst-xlat-import-apply>Put rows in the table</button>
                        </div>
                        @if (_xlatImportSummary is not null)
                        {
                            <div style="margin-top:.4rem;" data-inst-xlat-import-summary>@_xlatImportSummary</div>
                        }
                    </div>
                }
                <table class="bb" data-inst-xlat-rows>
                    <thead>
                        <tr>
                            <th>Instrument value</th><th>Local value</th>
                            @if (field.AllowsContext) { <th>Only for test</th> }
                            <th>Order</th><th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!XlatRows.Any())
                        {
                            <tr><td colspan="5" class="muted">No rows for @field.DisplayName.</td></tr>
                        }
                        @foreach (var row in XlatRows)
                        {
                            <tr>
                                <td><input id="@(ReferenceEquals(row, XlatRows.LastOrDefault()) ? "xlat-last-code" : null)" class="mono" @bind="row.InstrumentValue" disabled="@(!CanManage)" /></td>
                                <td>
                                    <input class="mono" list="@(field.LocalValues.Count > 0 ? "inst-local-values" : null)" @bind="row.LocalValue" @bind:event="oninput" disabled="@(!CanManage)" />
                                    @if (field.LocalValues.Count > 0 && !string.IsNullOrWhiteSpace(row.LocalValue))
                                    {
                                        var lv = field.LocalValues.FirstOrDefault(v => string.Equals(v.Value, row.LocalValue.Trim(), StringComparison.OrdinalIgnoreCase));
                                        <div class="@(lv is null ? "text-danger" : "muted")" style="font-size:.85em;">@(lv is null ? "Not a local value for this field" : $"{lv.Kind}: {lv.Label}")</div>
                                    }
                                </td>
                                @if (field.AllowsContext)
                                {
                                    <td><input class="mono" list="inst-tests" placeholder="all tests" @bind="row.Context" disabled="@(!CanManage)" /></td>
                                }
                                <td><input type="number" style="width:5rem;" @bind="row.SortOrder" disabled="@(!CanManage)" /></td>
                                <td>@if (CanManage) { <button class="btn btn-ghost btn-sm" @onclick="() => _editing.Translations.Remove(row)">Remove</button> }</td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (CanManage)
                {
                    <button class="btn btn-secondary" style="margin-top:.6rem;" @onclick="AddMapping">Add row</button>
                }

                @if (_editId is not null)
                {
                    <div class="bb-card" style="margin-top:1rem;" data-inst-xlat-check>
                        <h3 style="margin-top:0;">Test a value</h3>
                        <p class="muted">Uses this instrument's saved translations (not unsaved edits).</p>
                        <div class="form-row">
                            <div class="field"><label>@(field.Outbound ? "LIS test" : "Instrument value")</label><input @bind="_checkValue" @bind:event="oninput" /></div>
                            @if (field.AllowsContext)
                            {
                                <div class="field"><label>For test</label><input list="inst-tests" @bind="_checkContext" placeholder="optional" /></div>
                            }
                            <div class="field" style="align-self:flex-end;"><button type="button" class="btn btn-secondary" @onclick="CheckXlatAsync" disabled="@string.IsNullOrWhiteSpace(_checkValue)">Try it</button></div>
                        </div>
                        @if (_check is not null)
                        {
                            <div data-inst-xlat-check-result>
                                <strong>@_check.Input → @_check.Output</strong>
                                <span class="muted"> &middot; @(_check.Translated ? "translated" : "no translation")</span>
                                @if (!string.IsNullOrEmpty(_check.Note)) { <div class="muted">@_check.Note</div> }
                            </div>
                        }
                    </div>
                }
            }
        }
        else
        {
            <table class="bb">
                <thead><tr><th>Name</th><th>If</th><th>Then</th><th>Order</th><th>On</th><th>Stop</th><th></th></tr></thead>
                <tbody>
                    @foreach (var row in _editing.Rules)
                    {
                        <tr>
                            <td><input id="@(ReferenceEquals(row, _editing.Rules[^1]) ? "rule-last-name" : null)" @bind="row.Name" /></td>
                            <td><textarea class="mono" rows="2" @bind="row.ConditionExpression"></textarea></td>
                            <td><textarea class="mono" rows="2" @bind="row.ActionExpression"></textarea></td>
                            <td><input type="number" @bind="row.SortOrder" /></td>
                            <td><input type="checkbox" @bind="row.IsEnabled" /></td>
                            <td><input type="checkbox" @bind="row.StopOnMatch" /></td>
                            <td><button class="btn btn-ghost btn-sm" @onclick="() => _editing.Rules.Remove(row)">Remove</button></td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (CanManage)
            {
                <button class="btn btn-secondary" style="margin-top:.6rem;" @onclick="AddRule">Add rule</button>
            }
            <p class="muted" style="margin-top:.6rem;">
                Conditions use the order/test expression language against <span class="mono">message.*</span>
                data items. Actions are <span class="mono">set('subtest_result','4+')</span>. A grade such as
                <span class="mono">4+</span> is not a number.
                <button type="button" class="btn btn-ghost btn-sm" @onclick="() => _showHelp = true">Open help</button>
            </p>
        }

        <div class="form-row" style="margin-top:1rem;">
            <div class="field"><label>Change reason</label><input @bind="_changeReason" /></div>
        </div>
        <div class="flex gap" style="margin-top:1rem;">
            @if (CanManage)
            {
                <button class="btn btn-primary" disabled="@_busy" @onclick="SaveAsync">Save</button>
                @if (_editId is not null)
                {
                    <button class="btn btn-secondary" disabled="@_busy" @onclick="() => ToggleEnabledAsync(!_editing.IsEnabled)">
                        @(_editing.IsEnabled ? "Disable" : "Enable")
                    </button>
                }
            }
            <button class="btn btn-ghost" @onclick="Cancel">Cancel</button>
        </div>
    </div>
}

@if (_showHelp)
{
    <InstrumentHelpPanel Catalog="_catalog" OnClose="() => _showHelp = false" />
}

@if (_historyId is long historyId)
{
    <ConfigHistoryPanel Title="Instrument interface history" EntityType="InstrumentInterface" EntityId="historyId" OnClose="() => _historyId = null" />
}

@code {
    private readonly List<InstrumentInterfaceDto> _items = new();
    private List<InstrumentDataItemDto> _catalog = new();
    private EditModel? _editing;
    private long? _editId;
    private long? _historyId;
    private string _tab = "connection";
    private string? _changeReason;
    private Feedback? _feedback;
    private bool _loading = true;
    private bool _busy;
    private bool _showHelp;
    private string? _focusId;
    private List<InstrumentTranslationFieldDto> _xlatFields = new();
    private string _xlatKey = "Instrument.ResultTestCode";
    private bool _xlatImportOpen;
    private string _xlatImportText = string.Empty;
    private string? _xlatImportSummary;
    private string _checkValue = string.Empty;
    private string? _checkContext;
    private InstrumentTranslationCheckDto? _check;
    private bool CanManage => Session.Has(PermissionCodes.AdminInstrumentsManage);

    [SupplyParameterFromQuery(Name = "id")] public long? IdQuery { get; set; }
    [SupplyParameterFromQuery(Name = "tab")] public string? TabQuery { get; set; }
    [SupplyParameterFromQuery(Name = "key")] public string? KeyQuery { get; set; }
    [SupplyParameterFromQuery(Name = "value")] public string? ValueQuery { get; set; }

    private InstrumentTranslationFieldDto? XlatField => _xlatFields.FirstOrDefault(f => f.Key == _xlatKey);

    private IEnumerable<XlatRow> XlatRows => _editing?.Translations.Where(t => t.DataItemKey == _xlatKey) ?? [];

    private IReadOnlyList<InterfaceLocalValueDto> TestValues =>
        _xlatFields.FirstOrDefault(f => f.Key == "Instrument.ResultTestCode")?.LocalValues ?? [];

    protected override async Task OnInitializedAsync()
    {
        var catalog = await Api.GetAdminInstrumentDataItemsAsync();
        _catalog = catalog.Value ?? new();
        var fields = await Api.GetAdminInstrumentTranslationFieldsAsync();
        _xlatFields = fields.Value ?? new();
        await LoadAsync();

        // Opened from Unmapped values: the instrument, its translations, the field, and a row ready for the value.
        if (IdQuery is long id)
        {
            await EditAsync(id);
            if (_editing is not null && string.Equals(TabQuery, "translations", StringComparison.OrdinalIgnoreCase))
            {
                _tab = "translations";
                if (_xlatFields.Any(f => f.Key == KeyQuery))
                {
                    _xlatKey = KeyQuery!;
                    if (!string.IsNullOrWhiteSpace(ValueQuery))
                    {
                        var outbound = XlatField?.Outbound == true;
                        _editing.Translations.Add(new XlatRow
                        {
                            DataItemKey = _xlatKey,
                            InstrumentValue = outbound ? string.Empty : ValueQuery,
                            LocalValue = outbound ? ValueQuery : string.Empty,
                            SortOrder = NextOrder(XlatRows.Select(r => r.SortOrder))
                        });
                        _changeReason = $"Translation for unmapped instrument value {ValueQuery}";
                    }
                }
            }
        }
    }

    private void SelectXlatField(string key)
    {
        _xlatKey = key;
        _check = null;
        _xlatImportSummary = null;
    }

    private async Task CheckXlatAsync()
    {
        if (_editId is not long id) return;
        var r = await Api.CheckAdminInstrumentTranslationAsync(id, _xlatKey, _checkValue.Trim(), _checkContext);
        _check = r.Value;
        if (!r.Succeeded) _feedback = r.ToFeedback();
    }

    private async Task OnXlatFileAsync(InputFileChangeEventArgs e)
    {
        try
        {
            await using var stream = e.File.OpenReadStream(1024 * 1024);
            using var reader = new StreamReader(stream);
            _xlatImportText = await reader.ReadToEndAsync();
            _xlatImportSummary = $"Loaded {e.File.Name}. Choose Put rows in the table to use it.";
        }
        catch (IOException)
        {
            _xlatImportSummary = "The file could not be read; files over 1 MB are refused.";
        }
    }

    private void ApplyXlatImport()
    {
        if (_editing is null) return;
        var result = InterfaceTranslationImport.ParseInstrument(_xlatImportText);
        var allowsContext = XlatField?.AllowsContext == true;
        var added = 0;
        var order = NextOrder(XlatRows.Select(r => r.SortOrder));
        foreach (var row in result.Rows)
        {
            var context = allowsContext ? row.Context : null;
            if (XlatRows.Any(r => string.Equals(r.InstrumentValue.Trim(), row.InstrumentValue, StringComparison.OrdinalIgnoreCase)
                    && string.Equals(r.LocalValue.Trim(), row.LocalValue, StringComparison.OrdinalIgnoreCase)
                    && string.Equals((r.Context ?? "").Trim(), context ?? "", StringComparison.OrdinalIgnoreCase)))
            {
                continue;
            }

            _editing.Translations.Add(new XlatRow { DataItemKey = _xlatKey, InstrumentValue = row.InstrumentValue, LocalValue = row.LocalValue, Context = context, SortOrder = order++ });
            added++;
        }

        var problems = string.Join(" ", result.Problems.Select(p => $"Line {p.Line}: {p.Message}"));
        _xlatImportSummary = $"{added} row{(added == 1 ? "" : "s")} put in the table."
            + (result.Duplicates > 0 || added < result.Rows.Count ? " Rows already there or repeated were skipped." : "")
            + (problems.Length > 0 ? $" Not read: {problems}" : "");
        _changeReason ??= "Imported instrument translation rows";
    }

    private async Task ExportXlatAsync()
    {
        var rows = XlatRows.Where(r => !r.IsBlank)
            .Select(r => new InterfaceTranslationImport.InstrumentRow(r.InstrumentValue.Trim(), r.LocalValue.Trim(), string.IsNullOrWhiteSpace(r.Context) ? null : r.Context.Trim()));
        var name = $"instrument-{(_editing?.Name ?? "new").Replace(' ', '-')}-{_xlatKey.Replace('.', '-')}.csv";
        var token = Downloads.Put(name, CsvFormat.ContentType, CsvFormat.Write(InterfaceTranslationImport.InstrumentColumns, InterfaceTranslationImport.InstrumentCells(rows)));
        await Js.InvokeVoidAsync("open", $"/downloads/reports/{token}", "_blank");
    }

    private async Task LoadAsync()
    {
        _loading = true;
        var result = await Api.GetAdminInstrumentInterfacesAsync();
        _items.Clear();
        if (result.Value is not null) _items.AddRange(result.Value);
        if (!result.Succeeded) _feedback = result.ToFeedback();
        _loading = false;
    }

    private async Task NewDraft()
    {
        _editId = null;
        _tab = "connection";
        _changeReason = null;
        _editing = new EditModel
        {
            Name = "",
            Environment = "Development",
            Port = 2576,
            FieldMappings = _catalog.Select(i => new FieldRow { DataItemKey = i.Key, AstmPath = i.DefaultAstmPath, IsRequired = i.Required }).ToList()
        };
        await Task.CompletedTask;
    }

    private async Task EditAsync(long id)
    {
        var result = await Api.GetAdminInstrumentInterfaceAsync(id);
        if (!result.Succeeded || result.Value is null)
        {
            _feedback = result.ToFeedback();
            return;
        }

        _editId = id;
        _tab = "connection";
        _changeReason = null;
        _editing = EditModel.From(result.Value);
    }

    private void Cancel()
    {
        _editing = null;
        _editId = null;
    }

    // New rows continue the order (a 0 would jump ahead of every existing row) and take the cursor.
    private void AddMapping()
    {
        if (_editing is null) return;
        _editing.Translations.Add(new XlatRow { DataItemKey = _xlatKey, SortOrder = NextOrder(XlatRows.Select(m => m.SortOrder)) });
        _focusId = "xlat-last-code";
    }

    private void AddRule()
    {
        if (_editing is null) return;
        _editing.Rules.Add(new RuleRow { IsEnabled = true, SortOrder = NextOrder(_editing.Rules.Select(r => r.SortOrder)) });
        _focusId = "rule-last-name";
    }

    private static int NextOrder(IEnumerable<int> orders) => orders.DefaultIfEmpty(0).Max() + 1;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusId is { } id)
        {
            _focusId = null;
            await Js.FocusSelectAsync(id);
        }
    }

    private async Task SaveAsync()
    {
        if (_editing is null) return;
        _busy = true;
        var req = _editing.ToRequest(_changeReason);
        var result = _editId is long id
            ? await Api.UpdateAdminInstrumentInterfaceAsync(id, req)
            : await Api.CreateAdminInstrumentInterfaceAsync(req);
        _feedback = result.ToFeedback("Instrument interface saved.");
        if (result.Succeeded && result.Value is not null)
        {
            _editId = result.Value.Id;
            _editing = EditModel.From(result.Value);
            await LoadAsync();
        }
        _busy = false;
    }

    private async Task ToggleEnabledAsync(bool enabled)
    {
        if (_editId is not long id) return;
        _busy = true;
        var result = await Api.SetInstrumentInterfaceEnabledAsync(id, enabled, _changeReason);
        _feedback = result.ToFeedback(enabled ? "Interface enabled." : "Interface disabled.");
        if (result.Succeeded && result.Value is not null)
        {
            _editing = EditModel.From(result.Value);
            await LoadAsync();
        }
        _busy = false;
    }

    private Task ShowHistoryAsync(long id)
    {
        _historyId = id;
        return Task.CompletedTask;
    }

    private string TabClass(string tab) => _tab == tab ? "btn-primary" : "btn-secondary";

    private sealed class EditModel
    {
        public string Name { get; set; } = "";
        public string? Environment { get; set; }
        public bool IsEnabled { get; set; }
        public string? IpAddress { get; set; }
        public int Port { get; set; } = 2576;
        public InstrumentInterpretationMatch InterpretationMatch { get; set; } =
            InstrumentInterpretationMatch.AnalyteEqualsAssay;
        public string? InterpretationAnalyteCodes { get; set; }
        public List<FieldRow> FieldMappings { get; set; } = new();
        public List<XlatRow> Translations { get; set; } = new();
        public List<RuleRow> Rules { get; set; } = new();

        public static EditModel From(InstrumentInterfaceDto dto) => new()
        {
            Name = dto.Name,
            Environment = dto.Environment,
            IsEnabled = dto.IsEnabled,
            IpAddress = dto.Connection.IpAddress,
            Port = dto.Connection.Port,
            InterpretationMatch = dto.InterpretationMatch,
            InterpretationAnalyteCodes = dto.InterpretationAnalyteCodes,
            FieldMappings = dto.FieldMappings.Select(m => new FieldRow { DataItemKey = m.DataItemKey, AstmPath = m.AstmPath, IsRequired = m.IsRequired }).ToList(),
            Translations = dto.Translations.Select(t => new XlatRow
            {
                DataItemKey = t.DataItemKey,
                InstrumentValue = t.InstrumentValue,
                LocalValue = t.LocalValue,
                Context = t.Context,
                SortOrder = t.SortOrder
            }).ToList(),
            Rules = dto.Rules.Select(r => new RuleRow
            {
                Name = r.Name,
                ConditionExpression = r.ConditionExpression,
                ActionExpression = r.ActionExpression,
                SortOrder = r.SortOrder,
                IsEnabled = r.IsEnabled,
                StopOnMatch = r.StopOnMatch
            }).ToList()
        };

        public SaveInstrumentInterfaceRequest ToRequest(string? reason) =>
            new(Name, Environment, reason,
                new InstrumentConnectionDto(IpAddress, Port, string.IsNullOrWhiteSpace(IpAddress)),
                FieldMappings.Select(m => new InstrumentFieldMappingDto(m.DataItemKey, m.AstmPath, m.IsRequired)).ToList(),
                Translations.Where(t => !t.IsBlank)
                    .Select(t => new InstrumentTranslationDto(t.DataItemKey, t.InstrumentValue, t.LocalValue, InterfaceTranslationDirection.Inbound, t.SortOrder, t.Context))
                    .ToList(),
                Rules.Select(r => new InstrumentRuleDto(r.Name, r.ConditionExpression, r.ActionExpression, r.SortOrder, r.IsEnabled, r.StopOnMatch)).ToList(),
                InterpretationMatch,
                InterpretationAnalyteCodes);
    }

    private sealed class FieldRow
    {
        public string DataItemKey { get; set; } = "";
        public string AstmPath { get; set; } = "";
        public bool IsRequired { get; set; }
    }

    private sealed class XlatRow
    {
        public string DataItemKey { get; set; } = "";
        public string InstrumentValue { get; set; } = "";
        public string LocalValue { get; set; } = "";
        public string? Context { get; set; }
        public int SortOrder { get; set; }

        public bool IsBlank => string.IsNullOrWhiteSpace(InstrumentValue) && string.IsNullOrWhiteSpace(LocalValue);
    }

    private sealed class RuleRow
    {
        public string Name { get; set; } = "";
        public string ConditionExpression { get; set; } = "";
        public string ActionExpression { get; set; } = "";
        public int SortOrder { get; set; }
        public bool IsEnabled { get; set; } = true;
        public bool StopOnMatch { get; set; }
    }
}
