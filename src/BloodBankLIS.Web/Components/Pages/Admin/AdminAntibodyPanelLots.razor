    private async Task BeginCreate()
    {
        _creating = true;
        _createManufacturerId = null;
        _createLotNumber = "";
        _createPanelName = "";
        _createExpires = DateTime.UtcNow.Date.AddYears(1);
        _createSelected = false;
        _createCells.Clear();
        AddCell();
        _manufacturers = _allManufacturers.Where(m => m.IsActive).ToList();

        if (_attributes.Count == 0)
        {
            var attrs = await Api.GetAdminBloodAttributesAsync(false);
            _attributes = (attrs.Value ?? new()).Where(a => a.IsActive).OrderBy(a => a.SortOrder).ToList();
            if (!attrs.Succeeded)
            {
                _feedback = attrs.ToFeedback();
            }
        }
    }

    private void CancelCreate()
    {
        _creating = false;
        _createCells.Clear();
    }

    private void OnSelectedLotChanged()
    {
        var role = _createSelected ? PanelCellRole.Selected : PanelCellRole.Panel;
        foreach (var cell in _createCells.Where(c => c.Role != PanelCellRole.Autocontrol))
        {
            cell.Role = role;
        }
    }

    private void AddCell()
    {
        _createCells.Add(new LotCellDraft
        {
            CellNumber = (_createCells.Count + 1).ToString(),
            Role = _createSelected ? PanelCellRole.Selected : PanelCellRole.Panel,
            SortOrder = _createCells.Count + 1
        });
        AddAntigen(_createCells[^1]);
    }

    private void RemoveCell(LotCellDraft cell) => _createCells.Remove(cell);

    private void AddAntigen(LotCellDraft cell)
    {
        var first = _attributes.FirstOrDefault();
        cell.Antigens.Add(new LotAntigenDraft
        {
            BloodAttributeDefinitionId = first?.Id ?? 0,
            Expression = AntigenExpression.Present
        });
    }

    private static void RemoveAntigen(LotCellDraft cell, LotAntigenDraft antigen) =>
        cell.Antigens.Remove(antigen);

    private async Task CreateAsync()
    {
        if (_createManufacturerId is null)
        {
            return;
        }

        _busy = true;
        var cells = _createCells
            .Select(c => new CreateAntibodyPanelLotCellRequest(
                c.CellNumber,
                c.Role,
                c.SortOrder,
                c.Role == PanelCellRole.Autocontrol
                    ? []
                    : c.Antigens
                        .Select(a => new CreateAntibodyPanelLotAntigenRequest(a.BloodAttributeDefinitionId, a.Expression))
                        .ToList()))
            .ToList();
        var r = await Api.CreateAntibodyPanelLotAsync(new CreateAntibodyPanelLotRequest(
            _createManufacturerId.Value,
            _createLotNumber,
            _createPanelName,
            DateOnly.FromDateTime(_createExpires),
            _createSelected,
            cells));
        _feedback = r.ToFeedback("Lot created. It does not identify antibodies.");
        _busy = false;
        if (r.Succeeded)
        {
            CancelCreate();
            await LoadAsync();
            if (r.Value is not null)
            {
                await ViewLotAsync(r.Value.Id);
            }
        }
    }

    private sealed class LotCellDraft
    {
        public string CellNumber { get; set; } = "1";
        public PanelCellRole Role { get; set; } = PanelCellRole.Panel;
        public int SortOrder { get; set; } = 1;
        public List<LotAntigenDraft> Antigens { get; } = new();
    }

    private sealed class LotAntigenDraft
    {
        public long BloodAttributeDefinitionId { get; set; }
        public AntigenExpression Expression { get; set; } = AntigenExpression.Present;
    }

