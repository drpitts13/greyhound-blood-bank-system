@page "/admin/antibody-panel-lots"
@inject UserSession Session
@inject BloodBankApiClient Api
@inject ReportDownloadCache Downloads
@inject IJSRuntime Js

<PageTitle>Antibody Panel Lots &middot; Admin</PageTitle>

<div class="flex-between">
    <h1>Antibody panel lots</h1>
    <div class="flex gap">
        <a class="btn btn-ghost" href="/antibody-id">Open Antibody ID</a>
        <a class="btn btn-ghost" href="/admin/blood-attributes">Open Blood Attributes</a>
        @if (CanEdit)
        {
            <button class="btn btn-secondary" type="button" @onclick="BeginCreateManufacturer">New manufacturer</button>
            <button class="btn btn-primary" type="button" @onclick="BeginCreate">New lot</button>
        }
    </div>
</div>
<p class="muted">Create, withdraw, or restore reagent manufacturers and lots used for antibody identification.</p>
<details class="bb-help">
    <summary>How it works</summary>
    <ul>
        <li>A new lot requires an active manufacturer, cells, and typed antigens.</li>
        <li>Creating or deactivating a manufacturer or lot does not identify antibodies and does not void an open workup.</li>
        <li>Accept and complete HardStop on a deactivated attached lot until it is restored or the workup is voided.</li>
    </ul>
</details>

@if (!_creating) { <Outcome Value="_feedback" /> }
<PanelLotSupplyNotice Items="_supply" />

<div class="bb-card" style="margin-top:1rem;">
    <div class="bb-card-title"><h3>Manufacturers</h3></div>
    @if (_allManufacturers.Count == 0)
    {
        <div class="empty">No manufacturers. Create one before opening a new lot.</div>
    }
    else
    {
        <div class="table-scroll">
        <table class="bb">
            <thead><tr><th>Code</th><th>Name</th><th>Workups</th><th>Status</th><th></th></tr></thead>
            <tbody>
                @foreach (var m in _allManufacturers)
                {
                    <tr>
                        <td class="mono">@m.Code</td>
                        <td>@m.Name</td>
                        <td>
                            @if (m.OpenWorkupCount > 0)
                            {
                                <span class="badge badge-amber">@m.OpenWorkupCount open</span>
                            }
                            @if (m.PostedHistoryWorkupCount > 0)
                            {
                                <span class="badge badge-amber">@m.PostedHistoryWorkupCount posted history</span>
                            }
                            @if (m.CompletedWorkupCount > 0)
                            {
                                <span class="badge badge-gray">@m.CompletedWorkupCount completed</span>
                            }
                        </td>
                        <td>
                            @if (m.IsActive)
                            {
                                <span class="badge badge-green">Active</span>
                            }
                            else
                            {
                                <span class="badge badge-gray">Inactive</span>
                            }
                        </td>
                        <td class="right nowrap">
                            <button class="btn btn-ghost btn-sm" type="button" @onclick="() => ViewManufacturerAsync(m.Id)">View workups</button>
                            <a class="btn btn-ghost btn-sm" href="@ManufacturerWorklistHref(m)">Worklist</a>
                            @if (CanActivate)
                            {
                                @if (m.IsActive)
                                {
                                    <button class="btn btn-ghost btn-sm" type="button" @onclick="() => BeginDeactivateManufacturer(m)">Deactivate</button>
                                }
                                else
                                {
                                    <button class="btn btn-ghost btn-sm" type="button" @onclick="() => ActivateManufacturerAsync(m)">Activate</button>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    }
</div>

@if (_mfgDetail is not null && _deactivatingManufacturer is null)
{
    @* These cards open below long tables; keyed so each one re-adds and scrolls into view. *@
    <div @key="_mfgDetail.Manufacturer.Id" class="bb-card" style="margin-top:1rem;" data-scroll-on-show>
        <div class="bb-card-title">
            <h3>@_mfgDetail.Manufacturer.Name (@_mfgDetail.Manufacturer.Code)</h3>
            <button class="btn btn-ghost btn-sm" type="button" @onclick="CloseManufacturerDetail">Close</button>
        </div>
        <p class="muted">Open and completed workups that used a lot from this manufacturer. Voided workups are omitted. This list does not identify antibodies.</p>
        @if (_mfgDetail.OpenWorkups.Count == 0 && _mfgDetail.CompletedWorkups.Count == 0)
        {
            <div class="empty">No open or completed workups use this manufacturer.</div>
        }
        else
        {
            @if (_mfgDetail.OpenWorkups.Count > 0)
            {
                <h4>Open workups</h4>
                <div class="table-scroll">
                <table class="bb">
                    <thead><tr><th>Patient</th><th>MRN</th><th>Lot</th><th>Next</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var w in _mfgDetail.OpenWorkups)
                        {
                            <tr>
                                <td>@(w.PatientName ?? "—")</td>
                                <td class="mono">@(w.PatientMrn ?? "—")</td>
                                <td class="mono">@(w.LotNumber ?? "—")</td>
                                <td>@OpenWorkupNextLabel(w.NextAction)</td>
                                <td class="right">
                                    <a class="btn btn-ghost btn-sm" href="@PatientWorkupHref(w)">Open workup</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
            }
            @if (_mfgDetail.CompletedWorkups.Count > 0)
            {
                <h4 style="margin-top:1rem;">Completed identifications of record</h4>
                <p class="muted">These workups already posted or completed using this manufacturer's lots. History count is posted Identified findings only and does not identify antibodies.</p>
                <div class="table-scroll">
                <table class="bb">
                    <thead><tr><th>Patient</th><th>MRN</th><th>Lot</th><th>Status</th><th>History</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var w in _mfgDetail.CompletedWorkups)
                        {
                            <tr>
                                <td>@(w.PatientName ?? "—")</td>
                                <td class="mono">@(w.PatientMrn ?? "—")</td>
                                <td class="mono">@(w.LotNumber ?? "—")</td>
                                <td>Completed</td>
                                <td>@PostedHistoryLabel(w)</td>
                                <td class="right">
                                    <a class="btn btn-ghost btn-sm" href="@PatientWorkupHref(w)">Open workup</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
            }
        }
    </div>
}

@if (_creatingManufacturer && CanEdit)
{
    <div class="bb-card" style="margin-top:1rem;" data-scroll-on-show>
        <h2>New manufacturer</h2>
        <p class="muted">In-house or commercial panel source. This does not identify antibodies.</p>
        <div class="form-row">
            <div class="field"><label>Code</label><input class="mono" @bind="_mfgCode" @bind:event="oninput" /></div>
            <div class="field"><label>Name</label><input @bind="_mfgName" @bind:event="oninput" /></div>
        </div>
        <div class="flex gap" style="margin-top:.6rem;">
            <button class="btn btn-primary" disabled="@(_busy || string.IsNullOrWhiteSpace(_mfgCode) || string.IsNullOrWhiteSpace(_mfgName))" @onclick="CreateManufacturerAsync">Create manufacturer</button>
            <button class="btn btn-ghost" type="button" @onclick="CancelCreateManufacturer">Cancel</button>
        </div>
    </div>
}

@if (_deactivatingManufacturer is not null)
{
    <div @key="_deactivatingManufacturer.Id" class="bb-card" style="margin-top:1rem;" data-scroll-on-show>
        <h2>Deactivate @_deactivatingManufacturer.Code</h2>
        <p class="muted">
            Existing lots stay on file. New lots cannot use this manufacturer until it is restored. This does not identify antibodies or void a workup.
            @if (_deactivatingManufacturer.OpenWorkupCount > 0)
            {
                <span> @_deactivatingManufacturer.OpenWorkupCount open workup(s) currently use a lot from this manufacturer.</span>
            }
            @if (_deactivatingManufacturer.CompletedWorkupCount > 0)
            {
                <span> @_deactivatingManufacturer.CompletedWorkupCount completed identification(s) of record used a lot from this manufacturer.</span>
            }
        </p>
        @if (_mfgDetail is not null && _mfgDetail.Manufacturer.Id == _deactivatingManufacturer.Id &&
             (_mfgDetail.OpenWorkups.Count > 0 || _mfgDetail.CompletedWorkups.Count > 0))
        {
            @if (_mfgDetail.OpenWorkups.Count > 0)
            {
                <div class="table-scroll">
                <table class="bb">
                    <thead><tr><th>Patient</th><th>MRN</th><th>Lot</th><th>Next</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var w in _mfgDetail.OpenWorkups)
                        {
                            <tr>
                                <td>@(w.PatientName ?? "—")</td>
                                <td class="mono">@(w.PatientMrn ?? "—")</td>
                                <td class="mono">@(w.LotNumber ?? "—")</td>
                                <td>@OpenWorkupNextLabel(w.NextAction)</td>
                                <td class="right">
                                    <a class="btn btn-ghost btn-sm" href="@PatientWorkupHref(w)">Open workup</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
            }
            @if (_mfgDetail.CompletedWorkups.Count > 0)
            {
                <h4 style="margin-top:1rem;">Completed identifications of record</h4>
                <div class="table-scroll">
                <table class="bb">
                    <thead><tr><th>Patient</th><th>MRN</th><th>Lot</th><th>Status</th><th>History</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var w in _mfgDetail.CompletedWorkups)
                        {
                            <tr>
                                <td>@(w.PatientName ?? "—")</td>
                                <td class="mono">@(w.PatientMrn ?? "—")</td>
                                <td class="mono">@(w.LotNumber ?? "—")</td>
                                <td>Completed</td>
                                <td>@PostedHistoryLabel(w)</td>
                                <td class="right">
                                    <a class="btn btn-ghost btn-sm" href="@PatientWorkupHref(w)">Open workup</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
            }
        }
        <div class="field"><label>Reason (required)</label>
            <input @bind="_mfgReason" @bind:event="oninput" placeholder="Vendor withdrawn, replaced, or other reason." />
        </div>
        <div class="flex gap" style="margin-top:.6rem;">
            <button class="btn btn-danger" disabled="@(_busy || string.IsNullOrWhiteSpace(_mfgReason))" @onclick="ConfirmDeactivateManufacturerAsync">Deactivate</button>
            <button class="btn btn-ghost" type="button" @onclick="CancelDeactivateManufacturer">Cancel</button>
        </div>
    </div>
}

<div class="bb-card" style="margin-top:1rem;">
    <div class="flex gap" style="margin-bottom:.6rem;">
        <input style="flex:1;" placeholder="Filter by lot, panel, or manufacturer" @bind="_filter" @bind:event="oninput" />
        <label class="flex" style="gap:.35rem;"><input type="checkbox" @bind="_includeInactive" @bind:after="LoadAsync" /> Include inactive</label>
    </div>

    @if (_loading)
    {
        <div class="loading">Loading...</div>
    }
    else if (Filtered.Count == 0)
    {
        <div class="empty">No antibody panel lots.</div>
    }
    else
    {
        <div class="table-scroll">
        <table class="bb">
            <thead>
                <tr>
                    <th>Manufacturer</th>
                    <th>Lot</th>
                    <th>Panel</th>
                    <th>Expires</th>
                    <th>Type</th>
                    <th>Workups</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var lot in Filtered)
                {
                    <tr>
                        <td>@lot.ManufacturerName</td>
                        <td class="mono">@lot.LotNumber</td>
                        <td>@lot.PanelName</td>
                        <td class="nowrap">@lot.ExpiresOn.ToString("yyyy-MM-dd")</td>
                        <td>@(lot.IsSelectedCellLot ? "Selected cells" : "Panel")</td>
                        <td>
                            @if (lot.OpenWorkupCount > 0)
                            {
                                <span class="badge badge-amber">@lot.OpenWorkupCount open</span>
                            }
                            @if (lot.PostedHistoryWorkupCount > 0)
                            {
                                <span class="badge badge-amber">@lot.PostedHistoryWorkupCount posted history</span>
                            }
                            @if (lot.CompletedWorkupCount > 0)
                            {
                                <span class="badge badge-gray">@lot.CompletedWorkupCount completed</span>
                            }
                        </td>
                        <td>
                            @if (!lot.IsActive)
                            {
                                <span class="badge badge-gray">Inactive</span>
                            }
                            else if (lot.IsExpired)
                            {
                                <span class="badge badge-amber">Expired</span>
                            }
                            else
                            {
                                <span class="badge badge-green">Active</span>
                            }
                        </td>
                        <td class="right nowrap">
                            <button class="btn btn-ghost btn-sm" type="button" @onclick="() => ViewLotAsync(lot.Id)">View cells</button>
                            <a class="btn btn-ghost btn-sm" href="@LotWorklistHref(lot.LotNumber)">Worklist</a>
                            @if (CanActivate)
                            {
                                @if (lot.IsActive)
                                {
                                    <button class="btn btn-ghost btn-sm" type="button" @onclick="() => BeginDeactivate(lot)">Deactivate</button>
                                }
                                else
                                {
                                    <button class="btn btn-ghost btn-sm" type="button" @onclick="() => ActivateAsync(lot)">Activate</button>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    }
</div>

@if (_detail is not null && _deactivating is null)
{
    <div @key="_detail.Lot.Id" class="bb-card" style="margin-top:1rem;" data-scroll-on-show>
        <div class="bb-card-title">
            <h3>@_detail.Lot.PanelName — lot @_detail.Lot.LotNumber</h3>
            <div class="flex gap">
                @if (_detail.Cells.Count > 0)
                {
                    <button class="btn btn-ghost btn-sm" type="button" @onclick="DownloadAntigramAsync" data-antigram-download>Download antigram (CSV)</button>
                }
                @if (CanEdit && !InUse(_detail) && !_creating)
                {
                    <button class="btn btn-secondary btn-sm" type="button" @onclick="BeginCorrectAsync" data-antigram-correct>Correct antigram</button>
                }
                <button class="btn btn-ghost btn-sm" type="button" @onclick="CloseDetail">Close</button>
            </div>
        </div>
        <p class="muted">
            Reagent cell map only. Viewing a lot does not identify antibodies.
            @_detail.Lot.ManufacturerName
            · exp @_detail.Lot.ExpiresOn.ToString("yyyy-MM-dd")
            · @(_detail.Lot.IsSelectedCellLot ? "Selected cells" : "Panel")
        </p>
        @if (CanEdit && InUse(_detail))
        {
            <p class="muted" data-antigram-locked>
                Workups have used this lot, so its antigram cannot be corrected here: their reactions were read against these cells.
                If the antigram is wrong, deactivate the lot with the reason, create a corrected lot, and review the workups listed below.
            </p>
        }
        @if (_detail.Cells.Count == 0)
        {
            <div class="empty">This lot has no cells.</div>
        }
        else
        {
            <div class="table-scroll">
            <table class="bb">
                <thead>
                    <tr>
                        <th>Cell</th>
                        <th>Role</th>
                        <th>Antigens</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cell in _detail.Cells)
                    {
                        <tr>
                            <td class="mono">@cell.CellNumber</td>
                            <td>@cell.Role</td>
                            <td>
                                @if (cell.Role == PanelCellRole.Autocontrol)
                                {
                                    <span class="muted">No panel typings</span>
                                }
                                else if (cell.Antigens.Count == 0)
                                {
                                    <span class="muted">No typed antigens</span>
                                }
                                else
                                {
                                    @string.Join(" · ", cell.Antigens.Select(ExpressionLabel))
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        }
        @if (_detail.OpenWorkups.Count > 0)
        {
            <h4 style="margin-top:1rem;">Open workups using this lot</h4>
            <p class="muted">Deactivating the lot HardStops Accept and complete on these workups. This list does not identify antibodies.</p>
            <div class="table-scroll">
            <table class="bb">
                <thead><tr><th>Patient</th><th>MRN</th><th>Next</th><th></th></tr></thead>
                <tbody>
                    @foreach (var w in _detail.OpenWorkups)
                    {
                        <tr>
                            <td>@(w.PatientName ?? "—")</td>
                            <td class="mono">@(w.PatientMrn ?? "—")</td>
                            <td>@OpenWorkupNextLabel(w.NextAction)</td>
                            <td class="right">
                                <a class="btn btn-ghost btn-sm" href="@PatientWorkupHref(w)">Open workup</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        }
        @if (_detail.CompletedWorkups.Count > 0)
        {
            <h4 style="margin-top:1rem;">Completed identifications of record</h4>
            <p class="muted">These workups already completed using this lot. History count is posted Identified findings only and does not identify antibodies or void history.</p>
            <div class="table-scroll">
            <table class="bb">
                <thead><tr><th>Patient</th><th>MRN</th><th>Status</th><th>History</th><th></th></tr></thead>
                <tbody>
                    @foreach (var w in _detail.CompletedWorkups)
                    {
                        <tr>
                            <td>@(w.PatientName ?? "—")</td>
                            <td class="mono">@(w.PatientMrn ?? "—")</td>
                            <td>Completed</td>
                            <td>@PostedHistoryLabel(w)</td>
                            <td class="right">
                                <a class="btn btn-ghost btn-sm" href="@PatientWorkupHref(w)">Open workup</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        }
    </div>
}

@if (_creating && CanEdit)
{
    <div class="bb-card" style="margin-top:1rem;" data-scroll-on-show>
        @if (_correcting is not null)
        {
            <h2>Correct antigram — @_correcting.Lot.PanelName lot @_correcting.Lot.LotNumber</h2>
            <p class="muted" data-antigram-correct-form>
                No workup has used this lot yet, so its cells can be corrected. The cells below replace the current ones (which are kept
                on record, not deleted); the audit entry keeps the antigram before and after, with your reason. Check them against the
                manufacturer's sheet before saving.
            </p>
        }
        else
        {
        <h2>New antibody panel lot</h2>
        <p class="muted">Teaching or reagent panels only. This does not identify antibodies.</p>
        <div class="form-row">
            <div class="field"><label>Manufacturer</label>
                <select @bind="_createManufacturerId">
                    <option value="">Select manufacturer</option>
                    @foreach (var m in _manufacturers)
                    {
                        <option value="@m.Id">@m.Name (@m.Code)</option>
                    }
                </select>
            </div>
            <div class="field"><label>Lot number</label><input class="mono" @bind="_createLotNumber" /></div>
            <div class="field"><label>Panel name</label><input @bind="_createPanelName" /></div>
            <div class="field"><label>Expires</label><input type="date" @bind="_createExpires" /></div>
        </div>
        <label class="flex" style="gap:.35rem;margin:.6rem 0;">
            <input type="checkbox" @bind="_createSelected" @bind:after="OnSelectedLotChanged" /> Selected-cell lot
        </label>
        }
        <h3>Cells</h3>
        @* Import an antigram downloaded from the manufacturer and saved in this layout; it fills the cells below. *@
        <div class="bb-card" style="margin:.5rem 0;" data-antigram-import>
            <p class="muted" style="margin-top:0;">
                <strong>Import an antigram</strong> (CSV or Excel): one row per cell, a <span class="mono">Cell</span> column, an optional
                <span class="mono">Role</span> column, and one column per antigen code; values <span class="mono">+</span>,
                <span class="mono">0</span>, <span class="mono">w</span>, <span class="mono">+het</span>, <span class="mono">+hom</span>, or blank for not tested.
                The cells below are replaced; check them against the manufacturer's sheet before saving.
            </p>
            <div class="flex gap" style="align-items:center;flex-wrap:wrap;">
                <InputFile OnChange="OnAntigramFileAsync" accept=".csv,.tsv,.txt,.xlsx" data-antigram-file />
                <button class="btn btn-ghost btn-sm" type="button" @onclick="DownloadTemplateAsync" data-antigram-template>Download blank template</button>
            </div>
            @if (_importSummary is not null)
            {
                <div class="@(_importProblems.Count > 0 ? "alert alert-danger" : "alert alert-info")" style="margin-top:.5rem;" data-antigram-import-result>
                    @_importSummary
                    @if (_importProblems.Count > 0)
                    {
                        <ul style="margin:.25rem 0 0;">
                            @foreach (var problem in _importProblems)
                            {
                                <li>@problem</li>
                            }
                        </ul>
                    }
                </div>
            }
        </div>
        @foreach (var cell in _createCells)
        {
            <div class="bb-card" style="margin:.5rem 0;">
                <div class="form-row">
                    <div class="field"><label>Cell</label><input class="mono" @bind="cell.CellNumber" /></div>
                    <div class="field"><label>Role</label>
                        <select @bind="cell.Role">
                            @if (_createSelected)
                            {
                                <option value="@PanelCellRole.Selected">Selected</option>
                            }
                            else
                            {
                                <option value="@PanelCellRole.Panel">Panel</option>
                            }
                            <option value="@PanelCellRole.Autocontrol">Autocontrol</option>
                        </select>
                    </div>
                    <div class="field"><label>Sort</label><input type="number" @bind="cell.SortOrder" /></div>
                </div>
                @if (cell.Role != PanelCellRole.Autocontrol)
                {
                    <div class="table-scroll">
                    <table class="bb">
                        <thead><tr><th>Antigen</th><th>Expression</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var ag in cell.Antigens)
                            {
                                <tr>
                                    <td>
                                        <select @bind="ag.BloodAttributeDefinitionId">
                                            <option value="0">— select antigen —</option>
                                            @foreach (var attr in _attributes)
                                            {
                                                <option value="@attr.Id">@attr.Code — @attr.AntibodyName</option>
                                            }
                                        </select>
                                    </td>
                                    <td>
                                        <select @bind="ag.Expression">
                                            <option value="@AntigenExpression.Absent">Absent</option>
                                            <option value="@AntigenExpression.Present">Present</option>
                                            <option value="@AntigenExpression.Weak">Weak</option>
                                            <option value="@AntigenExpression.Heterozygous">Heterozygous</option>
                                            <option value="@AntigenExpression.Homozygous">Homozygous</option>
                                        </select>
                                    </td>
                                    <td class="right">
                                        <button class="btn btn-ghost btn-sm" type="button" @onclick="() => RemoveAntigen(cell, ag)">Remove</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    </div>
                    <button class="btn btn-ghost btn-sm" type="button" @onclick="() => AddAntigen(cell)">Add antigen</button>
                    @if (_attributes.Any(a => cell.Antigens.All(ag => ag.BloodAttributeDefinitionId != a.Id)))
                    {
                        <button class="btn btn-ghost btn-sm" type="button" @onclick="() => AddAllAntigens(cell)">Add all antigens</button>
                    }
                }
                <button class="btn btn-ghost btn-sm" type="button" @onclick="() => RemoveCell(cell)">Remove cell</button>
            </div>
        }
        @if (_correcting is not null)
        {
            <div class="field" style="margin-top:.6rem;">
                <label>Reason for the correction</label>
                <input @bind="_correctReason" @bind:event="oninput" placeholder="e.g. Cell 4 Jka entered wrongly; manufacturer's corrected sheet" data-antigram-correct-reason />
            </div>
        }
        <div class="flex gap" style="margin-top:.6rem;">
            <button class="btn btn-secondary btn-sm" type="button" @onclick="AddCell">Add cell</button>
            @if (_correcting is not null)
            {
                <button class="btn btn-primary" disabled="@(_busy || string.IsNullOrWhiteSpace(_correctReason))" @onclick="SaveCorrectionAsync" data-antigram-correct-save>Save corrected antigram</button>
            }
            else
            {
                <button class="btn btn-primary" disabled="@(_busy || _createManufacturerId is null)" @onclick="CreateAsync">Create lot</button>
            }
            <button class="btn btn-ghost" type="button" @onclick="CancelCreate">Cancel</button>
            @if (_correcting is null && _createManufacturerId is null)
            {
                <span class="muted">Choose a manufacturer to create the lot.</span>
            }
            else if (_correcting is not null && string.IsNullOrWhiteSpace(_correctReason))
            {
                <span class="muted">Give a reason to save the correction.</span>
            }
        </div>
        <div style="margin-top:.6rem;"><Outcome Value="_feedback" /></div>
    </div>
}

@if (_deactivating is not null)
{
    <div @key="_deactivating.Id" class="bb-card" style="margin-top:1rem;" data-scroll-on-show>
        <h2>Deactivate @_deactivating.LotNumber</h2>
        <p class="muted">
            Open workups that use this lot cannot be accepted or completed until it is restored or the workup is voided.
            @if (_deactivating.OpenWorkupCount > 0)
            {
                <span> @_deactivating.OpenWorkupCount open workup(s) currently use this lot.</span>
            }
            @if (_deactivating.CompletedWorkupCount > 0)
            {
                <span> @_deactivating.CompletedWorkupCount completed identification(s) of record used this lot.</span>
            }
        </p>
        @if (_detail is not null && _detail.Lot.Id == _deactivating.Id
             && (_detail.OpenWorkups.Count > 0 || _detail.CompletedWorkups.Count > 0))
        {
            @if (_detail.OpenWorkups.Count > 0)
            {
                <div class="table-scroll">
                <table class="bb">
                    <thead><tr><th>Patient</th><th>MRN</th><th>Next</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var w in _detail.OpenWorkups)
                        {
                            <tr>
                                <td>@(w.PatientName ?? "—")</td>
                                <td class="mono">@(w.PatientMrn ?? "—")</td>
                                <td>@OpenWorkupNextLabel(w.NextAction)</td>
                                <td class="right">
                                    <a class="btn btn-ghost btn-sm" href="@PatientWorkupHref(w)">Open workup</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
            }
            @if (_detail.CompletedWorkups.Count > 0)
            {
                <h4 style="margin-top:1rem;">Completed identifications of record</h4>
                <div class="table-scroll">
                <table class="bb">
                    <thead><tr><th>Patient</th><th>MRN</th><th>Status</th><th>History</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var w in _detail.CompletedWorkups)
                        {
                            <tr>
                                <td>@(w.PatientName ?? "—")</td>
                                <td class="mono">@(w.PatientMrn ?? "—")</td>
                                <td>Completed</td>
                                <td>@PostedHistoryLabel(w)</td>
                                <td class="right">
                                    <a class="btn btn-ghost btn-sm" href="@PatientWorkupHref(w)">Open workup</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
            }
        }
        <div class="field"><label>Reason (required)</label>
            <input @bind="_reason" @bind:event="oninput" placeholder="QC failure, recall, or other withdrawal reason." />
        </div>
        <div class="flex gap" style="margin-top:.6rem;">
            <button class="btn btn-danger" disabled="@(_busy || string.IsNullOrWhiteSpace(_reason))" @onclick="ConfirmDeactivateAsync">Deactivate</button>
            <button class="btn btn-ghost" type="button" @onclick="CancelDeactivate">Cancel</button>
        </div>
    </div>
}

@code {
    private Feedback? _feedback;
    private bool _loading = true;
    private bool _busy;
    private bool _includeInactive = true;
    private string _filter = "";
    private string? _reason;
    private List<AntibodyPanelLotListItemDto> _lots = new();
    private AntibodyPanelLotListItemDto? _deactivating;

    private bool CanActivate => Session.Has(PermissionCodes.AdminConfigActivate);
    private bool CanEdit => Session.Has(PermissionCodes.AdminConfigEdit);

    private bool _creating;
    private long? _createManufacturerId;
    private string _createLotNumber = "";
    private string _createPanelName = "";
    private DateTime _createExpires = DateTime.Now.Date.AddYears(1);
    private bool _createSelected;
    private readonly List<LotCellDraft> _createCells = new();
    private List<AntibodyPanelManufacturerListItemDto> _manufacturers = new();
    private List<AntibodyPanelManufacturerListItemDto> _allManufacturers = new();
    private List<BloodAttributeDefinitionDto> _attributes = new();
    private AntibodyPanelLotDetailDto? _detail;
    private List<AntibodyPanelLotSupplyItemDto> _supply = new();
    private AntibodyPanelManufacturerDetailDto? _mfgDetail;
    private bool _creatingManufacturer;
    private string _mfgCode = "";
    private string _mfgName = "";
    private string? _mfgReason;
    private AntibodyPanelManufacturerListItemDto? _deactivatingManufacturer;

    private IReadOnlyList<AntibodyPanelLotListItemDto> Filtered =>
        _lots
            .Where(l =>
                string.IsNullOrWhiteSpace(_filter)
                || l.LotNumber.Contains(_filter, StringComparison.OrdinalIgnoreCase)
                || l.PanelName.Contains(_filter, StringComparison.OrdinalIgnoreCase)
                || l.ManufacturerName.Contains(_filter, StringComparison.OrdinalIgnoreCase))
            .ToList();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        var r = await Api.GetAdminAntibodyPanelLotsAsync(_includeInactive);
        _lots = r.Value ?? new();
        if (!r.Succeeded)
        {
            _feedback = r.ToFeedback();
        }

        var supply = await Api.GetAntibodyPanelLotSupplyAsync();
        _supply = supply.Value ?? new();

        var mfg = await Api.GetAdminAntibodyPanelManufacturersAsync(true);
        _allManufacturers = mfg.Value ?? new();
        _manufacturers = _allManufacturers.Where(m => m.IsActive).ToList();
        if (!mfg.Succeeded)
        {
            _feedback = mfg.ToFeedback();
        }
        _loading = false;
    }

    private async Task BeginDeactivate(AntibodyPanelLotListItemDto lot)
    {
        _deactivating = lot;
        _reason = null;
        await ViewLotAsync(lot.Id);
    }

    private void CancelDeactivate()
    {
        _deactivating = null;
        _reason = null;
    }

    private async Task ConfirmDeactivateAsync()
    {
        if (_deactivating is null)
        {
            return;
        }

        _busy = true;
        var r = await Api.DeactivateAntibodyPanelLotAsync(_deactivating.Id, _reason);
        _feedback = r.ToFeedback("Lot deactivated. Open workups using it cannot be completed until restored or voided.");
        _busy = false;
        if (r.Succeeded)
        {
            CancelDeactivate();
            await LoadAsync();
        }
    }

    private void BeginCreateManufacturer()
    {
        _creatingManufacturer = true;
        _mfgCode = "";
        _mfgName = "";
    }

    private void CancelCreateManufacturer()
    {
        _creatingManufacturer = false;
        _mfgCode = "";
        _mfgName = "";
    }

    private async Task CreateManufacturerAsync()
    {
        _busy = true;
        var r = await Api.CreateAntibodyPanelManufacturerAsync(
            new CreateAntibodyPanelManufacturerRequest(_mfgCode, _mfgName));
        _feedback = r.ToFeedback("Manufacturer created. It does not identify antibodies.");
        _busy = false;
        if (r.Succeeded)
        {
            CancelCreateManufacturer();
            await LoadAsync();
        }
    }

    private async Task ViewManufacturerAsync(long manufacturerId)
    {
        var r = await Api.GetAdminAntibodyPanelManufacturerAsync(manufacturerId);
        if (r.Succeeded && r.Value is not null)
        {
            _mfgDetail = r.Value;
        }
        else
        {
            _feedback = r.ToFeedback();
            _mfgDetail = null;
        }
    }

    private void CloseManufacturerDetail() => _mfgDetail = null;

    private async Task BeginDeactivateManufacturer(AntibodyPanelManufacturerListItemDto manufacturer)
    {
        _deactivatingManufacturer = manufacturer;
        _mfgReason = null;
        await ViewManufacturerAsync(manufacturer.Id);
    }

    private void CancelDeactivateManufacturer()
    {
        _deactivatingManufacturer = null;
        _mfgReason = null;
    }

    private async Task ConfirmDeactivateManufacturerAsync()
    {
        if (_deactivatingManufacturer is null)
        {
            return;
        }

        _busy = true;
        var r = await Api.DeactivateAntibodyPanelManufacturerAsync(_deactivatingManufacturer.Id, _mfgReason);
        _feedback = r.ToFeedback("Manufacturer deactivated. New lots cannot use it until restored.");
        _busy = false;
        if (r.Succeeded)
        {
            CancelDeactivateManufacturer();
            await LoadAsync();
        }
    }

    private async Task ActivateManufacturerAsync(AntibodyPanelManufacturerListItemDto manufacturer)
    {
        _busy = true;
        var r = await Api.ActivateAntibodyPanelManufacturerAsync(manufacturer.Id, "Restore antibody panel manufacturer.");
        _feedback = r.ToFeedback("Manufacturer activated.");
        _busy = false;
        if (r.Succeeded)
        {
            await LoadAsync();
        }
    }

    private async Task BeginCreate()
    {
        CancelCreate();
        _creating = true;
        _createManufacturerId = null;
        _createLotNumber = "";
        _createPanelName = "";
        _createExpires = DateTime.Now.Date.AddYears(1);
        _createSelected = false;
        _createCells.Clear();
        _manufacturers = _allManufacturers.Where(m => m.IsActive).ToList();

        // Load the antigen catalog before the first cell so its antigen defaults to a real code.
        if (_attributes.Count == 0)
        {
            var attrs = await Api.GetAdminBloodAttributesAsync(false);
            _attributes = (attrs.Value ?? new()).Where(a => a.IsActive).OrderBy(a => a.SortOrder).ToList();
            if (!attrs.Succeeded)
            {
                _feedback = attrs.ToFeedback();
            }
        }

        AddCell();
    }

    private void CancelCreate()
    {
        _creating = false;
        _correcting = null;
        _correctReason = null;
        _createCells.Clear();
        _importSummary = null;
        _importProblems = new();
        _importedFrom = null;
    }

    private string? _importSummary;
    private List<string> _importProblems = new();
    private string? _importedFrom;

    private IReadOnlyList<AntigramImport.Antigen> AntigenCatalog =>
        _attributes.Select(a => new AntigramImport.Antigen(a.Id, a.Code, a.AntibodyName)).ToList();

    // An antigram file (CSV, tab-separated or Excel) fills the cells; nothing is saved until Create.
    private async Task OnAntigramFileAsync(InputFileChangeEventArgs e)
    {
        const long maxBytes = 2 * 1024 * 1024;
        IReadOnlyList<IReadOnlyList<string>> rows;
        try
        {
            await using var upload = e.File.OpenReadStream(maxBytes);
            using var buffer = new MemoryStream();
            await upload.CopyToAsync(buffer);
            buffer.Position = 0;
            if (e.File.Name.EndsWith(".xlsx", StringComparison.OrdinalIgnoreCase))
            {
                rows = SpreadsheetRows.ReadXlsx(buffer);
            }
            else
            {
                using var reader = new StreamReader(buffer);
                rows = BloodBankLIS.Domain.Reporting.CsvFormat.ReadRows(await reader.ReadToEndAsync());
            }
        }
        catch (Exception ex) when (ex is IOException or InvalidDataException or ArgumentException or InvalidOperationException)
        {
            _importSummary = $"{e.File.Name} could not be read: files over 2 MB, and Excel files other than .xlsx, are refused.";
            _importProblems = new();
            return;
        }

        var result = AntigramImport.Parse(rows, AntigenCatalog, _createSelected ? PanelCellRole.Selected : PanelCellRole.Panel);
        var ignored = result.IgnoredColumns.Count == 0
            ? ""
            : $" Columns not in the antigen catalog were left out: {string.Join(", ", result.IgnoredColumns)}.";
        if (!result.CanUse)
        {
            _importProblems = result.Problems.ToList();
            _importSummary = $"{e.File.Name} was not used; correct it and import again:{ignored}";
            return;
        }

        _createCells.Clear();
        var order = 1;
        foreach (var cell in result.Cells)
        {
            var draft = new LotCellDraft { CellNumber = cell.CellNumber, Role = cell.Role, SortOrder = order++ };
            foreach (var value in cell.Antigens)
            {
                draft.Antigens.Add(new LotAntigenDraft { BloodAttributeDefinitionId = value.AntigenId, Expression = value.Expression });
            }

            _createCells.Add(draft);
        }

        _importedFrom = e.File.Name;
        _importProblems = new();
        _importSummary = $"{result.Cells.Count} cell{(result.Cells.Count == 1 ? "" : "s")} and {result.AntigenIds.Count} antigen{(result.AntigenIds.Count == 1 ? "" : "s")} imported from {e.File.Name}. {(_correcting is null ? "Check them, fill in the manufacturer, lot, name and expiry, then Create." : "Check them against the current cells, give a reason, then Save corrected antigram.")}{ignored}";
    }

    private async Task DownloadTemplateAsync()
    {
        var token = Downloads.Put("antigram-template.csv", BloodBankLIS.Domain.Reporting.CsvFormat.ContentType,
            BloodBankLIS.Domain.Reporting.CsvFormat.Write(AntigramImport.Header(AntigenCatalog), []));
        await Js.InvokeVoidAsync("open", $"/downloads/reports/{token}", "_blank");
    }

    // The lot's antigram in the import layout, so it can be checked, kept, or imported for another lot.
    private async Task DownloadAntigramAsync()
    {
        if (_detail is null)
        {
            return;
        }

        // Columns follow the antigen catalog's order, as the New lot form does.
        if (_attributes.Count == 0)
        {
            var attrs = await Api.GetAdminBloodAttributesAsync(false);
            _attributes = (attrs.Value ?? new()).Where(a => a.IsActive).OrderBy(a => a.SortOrder).ToList();
        }

        var antigens = _detail.Cells.SelectMany(c => c.Antigens)
            .GroupBy(a => a.BloodAttributeDefinitionId)
            .Select(g => g.First())
            .OrderBy(a => _attributes.FindIndex(x => x.Id == a.BloodAttributeDefinitionId) is var i && i >= 0 ? i : int.MaxValue)
            .ThenBy(a => a.AntigenCode, StringComparer.Ordinal)
            .Select(a => new AntigramImport.Antigen(a.BloodAttributeDefinitionId, a.AntigenCode, a.AntibodyName))
            .ToList();
        var rows = _detail.Cells.OrderBy(c => c.SortOrder).Select(c => AntigramImport.Row(c.CellNumber, c.Role,
            antigens.Select(a => c.Antigens.FirstOrDefault(x => x.BloodAttributeDefinitionId == a.Id)?.Expression ?? AntigenExpression.NotTested)));
        var name = $"antigram-{_detail.Lot.ManufacturerName}-{_detail.Lot.LotNumber}.csv"
            .Replace(' ', '-').Replace('/', '-');
        var token = Downloads.Put(name, BloodBankLIS.Domain.Reporting.CsvFormat.ContentType,
            BloodBankLIS.Domain.Reporting.CsvFormat.Write(AntigramImport.Header(antigens), rows));
        await Js.InvokeVoidAsync("open", $"/downloads/reports/{token}", "_blank");
    }

    private void OnSelectedLotChanged()
    {
        var role = _createSelected ? PanelCellRole.Selected : PanelCellRole.Panel;
        foreach (var cell in _createCells.Where(c => c.Role != PanelCellRole.Autocontrol))
        {
            cell.Role = role;
        }
    }

    // A new cell is typed for the same antigens as the cell before it (every active antigen for the
    // first), all Absent, so the tech marks only what is present instead of adding each row by hand.
    // Absent is the safe default: a wrongly saved Present could rule out an antibody that is there.
    private void AddCell()
    {
        var previous = _createCells.Count > 0 ? _createCells[^1] : null;
        var cell = new LotCellDraft
        {
            CellNumber = (_createCells.Count + 1).ToString(),
            Role = _createSelected ? PanelCellRole.Selected : PanelCellRole.Panel,
            SortOrder = _createCells.Count + 1
        };
        var antigenIds = previous is { Antigens.Count: > 0 }
            ? previous.Antigens.Select(a => a.BloodAttributeDefinitionId).Where(id => id > 0).ToList()
            : _attributes.Select(a => a.Id).ToList();
        foreach (var id in antigenIds)
        {
            cell.Antigens.Add(new LotAntigenDraft { BloodAttributeDefinitionId = id });
        }

        _createCells.Add(cell);
    }

    private void AddAllAntigens(LotCellDraft cell)
    {
        foreach (var attr in _attributes.Where(a => cell.Antigens.All(ag => ag.BloodAttributeDefinitionId != a.Id)))
        {
            cell.Antigens.Add(new LotAntigenDraft { BloodAttributeDefinitionId = attr.Id });
        }
    }

    private void RemoveCell(LotCellDraft cell) => _createCells.Remove(cell);

    private void AddAntigen(LotCellDraft cell)
    {
        var next = _attributes.FirstOrDefault(a => cell.Antigens.All(ag => ag.BloodAttributeDefinitionId != a.Id));
        cell.Antigens.Add(new LotAntigenDraft { BloodAttributeDefinitionId = next?.Id ?? 0 });
    }

    private static void RemoveAntigen(LotCellDraft cell, LotAntigenDraft antigen) =>
        cell.Antigens.Remove(antigen);

    private async Task CreateAsync()
    {
        if (_createManufacturerId is null)
        {
            _feedback = Feedback.Fail("Choose a manufacturer before creating the lot.");
            return;
        }

        if (_createCells.Any(c => c.Role != PanelCellRole.Autocontrol && c.Antigens.Any(a => a.BloodAttributeDefinitionId <= 0)))
        {
            _feedback = Feedback.Fail("Choose an antigen for every antigen row, or remove the empty rows.");
            return;
        }

        _busy = true;
        var cells = CellRequests();
        var r = await Api.CreateAntibodyPanelLotAsync(new CreateAntibodyPanelLotRequest(
            _createManufacturerId.Value,
            _createLotNumber,
            _createPanelName,
            DateOnly.FromDateTime(_createExpires),
            _createSelected,
            cells,
            _importedFrom));
        _feedback = r.ToFeedback("Lot created. It does not identify antibodies.");
        _busy = false;
        if (r.Succeeded)
        {
            CancelCreate();
            await LoadAsync();
            if (r.Value is not null)
            {
                await ViewLotAsync(r.Value.Id);
            }
        }
    }

    private List<CreateAntibodyPanelLotCellRequest> CellRequests() =>
        _createCells
            .Select(c => new CreateAntibodyPanelLotCellRequest(
                c.CellNumber,
                c.Role,
                c.SortOrder,
                c.Role == PanelCellRole.Autocontrol
                    ? []
                    : c.Antigens
                        .Select(a => new CreateAntibodyPanelLotAntigenRequest(a.BloodAttributeDefinitionId, a.Expression))
                        .ToList()))
            .ToList();

    // Correcting an antigram (Cycle 706): only before any workup uses the lot; the server refuses it otherwise.
    private AntibodyPanelLotDetailDto? _correcting;
    private string? _correctReason;

    private static bool InUse(AntibodyPanelLotDetailDto detail) =>
        detail.OpenWorkups.Count > 0 || detail.CompletedWorkups.Count > 0
        || detail.Lot.OpenWorkupCount > 0 || detail.Lot.CompletedWorkupCount > 0;

    private async Task BeginCorrectAsync()
    {
        if (_detail is null)
        {
            return;
        }

        var lot = _detail;
        CancelCreate();
        if (_attributes.Count == 0)
        {
            var attrs = await Api.GetAdminBloodAttributesAsync(false);
            _attributes = (attrs.Value ?? new()).Where(a => a.IsActive).OrderBy(a => a.SortOrder).ToList();
        }

        _correcting = lot;
        _creating = true;
        _createSelected = lot.Lot.IsSelectedCellLot;
        foreach (var cell in lot.Cells.OrderBy(c => c.SortOrder))
        {
            var draft = new LotCellDraft { CellNumber = cell.CellNumber, Role = cell.Role, SortOrder = cell.SortOrder };
            foreach (var antigen in cell.Antigens)
            {
                draft.Antigens.Add(new LotAntigenDraft { BloodAttributeDefinitionId = antigen.BloodAttributeDefinitionId, Expression = antigen.Expression });
            }

            _createCells.Add(draft);
        }
    }

    private async Task SaveCorrectionAsync()
    {
        if (_correcting is null)
        {
            return;
        }

        if (_createCells.Any(c => c.Role != PanelCellRole.Autocontrol && c.Antigens.Any(a => a.BloodAttributeDefinitionId <= 0)))
        {
            _feedback = Feedback.Fail("Choose an antigen for every antigen row, or remove the empty rows.");
            return;
        }

        _busy = true;
        var lotId = _correcting.Lot.Id;
        var r = await Api.CorrectAntibodyPanelLotAntigramAsync(lotId,
            new CorrectAntibodyPanelLotAntigramRequest(CellRequests(), _correctReason, _importedFrom));
        _feedback = r.ToFeedback("Antigram corrected. The previous cells are kept on record and the change is audited.");
        _busy = false;
        if (r.Succeeded)
        {
            CancelCreate();
            _detail = r.Value;
        }
    }

    private sealed class LotCellDraft
    {
        public string CellNumber { get; set; } = "1";
        public PanelCellRole Role { get; set; } = PanelCellRole.Panel;
        public int SortOrder { get; set; } = 1;
        public List<LotAntigenDraft> Antigens { get; } = new();
    }

    private sealed class LotAntigenDraft
    {
        public long BloodAttributeDefinitionId { get; set; }
        public AntigenExpression Expression { get; set; } = AntigenExpression.Absent;
    }

    private async Task ViewLotAsync(long lotId)
    {
        var r = await Api.GetAdminAntibodyPanelLotAsync(lotId);
        if (r.Succeeded && r.Value is not null)
        {
            _detail = r.Value;
        }
        else
        {
            _feedback = r.ToFeedback();
            _detail = null;
        }
    }

    private void CloseDetail() => _detail = null;

    private static string ExpressionLabel(AntibodyPanelLotAntigenDetailDto antigen) =>
        $"{antigen.AntigenCode} {antigen.Expression}";

    private static string OpenWorkupNextLabel(AntibodyIdWorklistNextAction action) =>
        action switch
        {
            AntibodyIdWorklistNextAction.Interpret => "Interpret",
            AntibodyIdWorklistNextAction.Review => "Supervisor review",
            AntibodyIdWorklistNextAction.None => "—",
            _ => "Record reactions"
        };

    private static string PostedHistoryLabel(AntibodyPanelLotOpenWorkupDto workup) =>
        workup.PostedHistoryCount > 0
            ? $"{workup.PostedHistoryCount} posted"
            : "None posted";

    private static string LotWorklistHref(string lotNumber) =>
        $"/antibody-id?lot={Uri.EscapeDataString(lotNumber)}";

    private static string ManufacturerWorklistHref(AntibodyPanelManufacturerListItemDto manufacturer) =>
        $"/antibody-id?manufacturer={Uri.EscapeDataString(manufacturer.Code)}";

    private static string PatientWorkupHref(AntibodyPanelLotOpenWorkupDto workup) =>
        $"/patients/{workup.PatientId}/antibody-id/{workup.WorkupId}";

    private async Task ActivateAsync(AntibodyPanelLotListItemDto lot)
    {
        _busy = true;
        var r = await Api.ActivateAntibodyPanelLotAsync(lot.Id, "Restore antibody panel lot.");
        _feedback = r.ToFeedback("Lot activated.");
        _busy = false;
        if (r.Succeeded)
        {
            await LoadAsync();
        }
    }
}
