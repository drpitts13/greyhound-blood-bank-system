@page "/admin/inventory-locations"
@using BloodBankLIS.Application.Admin
@using BloodBankLIS.Domain.Enums
@inject UserSession Session
@inject BloodBankApiClient Api

<PageTitle>Inventory Locations &middot; Admin</PageTitle>

<div class="flex-between">
    <h1>Inventory Locations</h1>
    @if (CanEdit)
    {
        <button class="btn btn-primary" @onclick="NewDraft">New storage location</button>
    }
</div>
<p class="muted">SafeTrace / SoftBank storage sites: refrigerator, freezer, platelet incubator, satellite fridge, and issue window. Storage class, remote/electronic issue, and second-verifier policy are enforced at transfer and issue (AABB 5.1.8, 5.11, 5.16; 21 CFR 606.160).</p>

<Outcome Value="_feedback" />

<div class="bb-card" style="margin-top:1rem;">
    <div class="flex gap" style="margin-bottom:.6rem;">
        <input style="flex:1;" placeholder="Filter by code, name, or department" @bind="_filter" @bind:event="oninput" />
        <label class="flex" style="gap:.35rem;"><input type="checkbox" @bind="_includeInactive" @bind:after="LoadAsync" /> Include inactive</label>
    </div>

    @if (_loading)
    {
        <div class="loading">Loading...</div>
    }
    else if (!Filtered.Any())
    {
        <div class="empty">No inventory locations.</div>
    }
    else
    {
        <table class="bb">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Name</th>
                    <th>Type</th>
                    <th>Issue</th>
                    <th>Storage</th>
                    <th>Temp °C</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var loc in Filtered)
                {
                    <tr>
                        <td class="mono">@loc.Code</td>
                        <td>@loc.Name</td>
                        <td>
                            @loc.LocationType
                            @if (loc.IsSatellite)
                            {
                                <span class="badge badge-amber">Satellite</span>
                            }
                        </td>
                        <td>
                            @if (loc.AllowsRemoteIssue) { <span class="badge">Remote</span> }
                            else if (loc.AllowsIssue) { <span class="badge">Issue</span> }
                            else { <span class="muted">Storage only</span> }
                            @if (loc.AllowsElectronicIssue) { <span class="badge badge-gray">EXM</span> }
                            @if (loc.RequiresSecondVerifier) { <span class="badge badge-amber">2-person</span> }
                        </td>
                        <td class="mono">@StorageSummary(loc)</td>
                        <td class="mono">@TempSummary(loc)</td>
                        <td>@(loc.IsActive ? "Active" : "Inactive")</td>
                        <td class="right nowrap">
                            @if (CanEdit)
                            {
                                <button class="btn btn-ghost btn-sm" @onclick="() => Edit(loc)">Edit</button>
                                @if (loc.IsActive)
                                {
                                    <button class="btn btn-ghost btn-sm" @onclick="() => SetActiveAsync(loc.Id, false)">Deactivate</button>
                                }
                                else if (CanActivate)
                                {
                                    <button class="btn btn-ghost btn-sm" @onclick="() => SetActiveAsync(loc.Id, true)">Activate</button>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@if (_draft is not null && CanEdit)
{
    <div class="bb-card" style="margin-top:1rem;">
        <h2>@(_editId is null ? "New storage location" : $"Edit: {_draft.Code}")</h2>
        <div class="form-row">
            <div class="field"><label>Code</label><input class="mono" @bind="_draft.Code" disabled="@(_editId is not null)" /></div>
            <div class="field"><label>Name</label><input @bind="_draft.Name" /></div>
            <div class="field">
                <label>Type</label>
                <select @bind="_draft.LocationType">
                    @foreach (var t in Enum.GetValues<LocationType>())
                    {
                        <option value="@t">@t</option>
                    }
                </select>
            </div>
            <div class="field"><label>Department</label><input @bind="_draft.Department" /></div>
        </div>
        <div class="form-row">
            <div class="field"><label>Min °C</label><input type="number" step="0.1" @bind="_draft.StorageTempMinC" /></div>
            <div class="field"><label>Max °C</label><input type="number" step="0.1" @bind="_draft.StorageTempMaxC" /></div>
            <div class="field"><label>In-transit hours</label><input type="number" @bind="_draft.DefaultInTransitHours" /></div>
            <div class="field"><label>Notes</label><input @bind="_draft.Notes" /></div>
        </div>
        <div class="form-row">
            <label class="flex" style="gap:.35rem;"><input type="checkbox" @bind="_draft.AllowsIssue" /> Allows issue</label>
            <label class="flex" style="gap:.35rem;"><input type="checkbox" @bind="_draft.AllowsRemoteIssue" /> Remote / satellite issue</label>
            <label class="flex" style="gap:.35rem;"><input type="checkbox" @bind="_draft.AllowsElectronicIssue" /> Electronic XM issue</label>
            <label class="flex" style="gap:.35rem;"><input type="checkbox" @bind="_draft.RequiresSecondVerifier" /> Requires second verifier</label>
            <label class="flex" style="gap:.35rem;"><input type="checkbox" @bind="_draft.IsSatellite" /> Satellite site</label>
        </div>
        <div class="form-row">
            <label class="flex" style="gap:.35rem;"><input type="checkbox" @bind="_draft.AllowsRbc" /> RBC</label>
            <label class="flex" style="gap:.35rem;"><input type="checkbox" @bind="_draft.AllowsWholeBlood" /> Whole blood</label>
            <label class="flex" style="gap:.35rem;"><input type="checkbox" @bind="_draft.AllowsPlasma" /> Plasma</label>
            <label class="flex" style="gap:.35rem;"><input type="checkbox" @bind="_draft.AllowsPlatelets" /> Platelets</label>
            <label class="flex" style="gap:.35rem;"><input type="checkbox" @bind="_draft.AllowsCryo" /> Cryo</label>
        </div>
        <label class="flex" style="gap:.35rem;margin:.6rem 0;"><input type="checkbox" @bind="_draft.ApplyTypeDefaults" /> Apply AABB storage defaults for the selected type on save</label>
        <div class="flex gap">
            <button class="btn btn-primary" disabled="@_busy" @onclick="SaveAsync">Save</button>
            <button class="btn btn-ghost" @onclick="CancelEdit">Cancel</button>
        </div>
    </div>
}

@code {
    private bool _loading = true;
    private bool _busy;
    private string _filter = string.Empty;
    private bool _includeInactive;
    private List<InventoryLocationAdminDto> _list = new();
    private Feedback? _feedback;
    private long? _editId;
    private LocationDraft? _draft;

    private bool CanEdit => Session.Has(PermissionCodes.AdminConfigEdit);
    private bool CanActivate => Session.Has(PermissionCodes.AdminConfigActivate);

    private IEnumerable<InventoryLocationAdminDto> Filtered =>
        string.IsNullOrWhiteSpace(_filter)
            ? _list
            : _list.Where(l =>
                l.Code.Contains(_filter, StringComparison.OrdinalIgnoreCase)
                || l.Name.Contains(_filter, StringComparison.OrdinalIgnoreCase)
                || (l.Department?.Contains(_filter, StringComparison.OrdinalIgnoreCase) ?? false));

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        var r = await Api.GetAdminInventoryLocationsAsync(_includeInactive);
        _list = r.Succeeded ? r.Value ?? new() : new();
        if (!r.Succeeded) _feedback = r.ToFeedback();
        _loading = false;
    }

    private void NewDraft()
    {
        _editId = null;
        _draft = new LocationDraft { ApplyTypeDefaults = true };
    }

    private void Edit(InventoryLocationAdminDto loc)
    {
        _editId = loc.Id;
        _draft = new LocationDraft
        {
            Code = loc.Code,
            Name = loc.Name,
            LocationType = loc.LocationType,
            Department = loc.Department,
            AllowsIssue = loc.AllowsIssue,
            AllowsRemoteIssue = loc.AllowsRemoteIssue,
            AllowsElectronicIssue = loc.AllowsElectronicIssue,
            RequiresSecondVerifier = loc.RequiresSecondVerifier,
            IsSatellite = loc.IsSatellite,
            AllowsRbc = loc.AllowsRbc,
            AllowsPlasma = loc.AllowsPlasma,
            AllowsPlatelets = loc.AllowsPlatelets,
            AllowsCryo = loc.AllowsCryo,
            AllowsWholeBlood = loc.AllowsWholeBlood,
            StorageTempMinC = loc.StorageTempMinC,
            StorageTempMaxC = loc.StorageTempMaxC,
            DefaultInTransitHours = loc.DefaultInTransitHours,
            Notes = loc.Notes
        };
    }

    private void CancelEdit()
    {
        _editId = null;
        _draft = null;
    }

    private async Task SaveAsync()
    {
        if (_draft is null) return;
        if (string.IsNullOrWhiteSpace(_draft.Code) || string.IsNullOrWhiteSpace(_draft.Name))
        {
            _feedback = Feedback.Fail("Code and name are required.");
            return;
        }

        _busy = true;
        var req = new SaveInventoryLocationRequest(
            _draft.Code,
            _draft.Name,
            _draft.LocationType,
            _draft.Department,
            _draft.AllowsIssue,
            _draft.AllowsRemoteIssue,
            _draft.AllowsElectronicIssue,
            _draft.RequiresSecondVerifier,
            _draft.IsSatellite,
            _draft.AllowsRbc,
            _draft.AllowsPlasma,
            _draft.AllowsPlatelets,
            _draft.AllowsCryo,
            _draft.AllowsWholeBlood,
            _draft.StorageTempMinC,
            _draft.StorageTempMaxC,
            _draft.DefaultInTransitHours,
            _draft.Notes,
            _draft.ApplyTypeDefaults);
        var r = _editId is null
            ? await Api.CreateAdminInventoryLocationAsync(req)
            : await Api.UpdateAdminInventoryLocationAsync(_editId.Value, req);
        _busy = false;
        if (r.Succeeded)
        {
            _feedback = r.ToFeedback("Inventory location saved.");
            _editId = null;
            _draft = null;
            await LoadAsync();
        }
        else
        {
            _feedback = r.ToFeedback();
        }
    }

    private async Task SetActiveAsync(long id, bool active)
    {
        _busy = true;
        var r = await Api.SetAdminInventoryLocationActiveAsync(id, active);
        _busy = false;
        _feedback = r.Succeeded ? r.ToFeedback(active ? "Activated." : "Deactivated.") : r.ToFeedback();
        if (r.Succeeded) await LoadAsync();
    }

    private static string StorageSummary(InventoryLocationAdminDto loc)
    {
        var parts = new List<string>();
        if (loc.AllowsRbc) parts.Add("RBC");
        if (loc.AllowsWholeBlood) parts.Add("WB");
        if (loc.AllowsPlasma) parts.Add("FFP");
        if (loc.AllowsPlatelets) parts.Add("PLT");
        if (loc.AllowsCryo) parts.Add("CRYO");
        return parts.Count == 0 ? "—" : string.Join(" ", parts);
    }

    private static string TempSummary(InventoryLocationAdminDto loc) =>
        loc.StorageTempMinC is null && loc.StorageTempMaxC is null
            ? "—"
            : $"{loc.StorageTempMinC?.ToString("0.#") ?? "?"} to {loc.StorageTempMaxC?.ToString("0.#") ?? "?"}";

    private sealed class LocationDraft
    {
        public string Code { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public LocationType LocationType { get; set; } = LocationType.Refrigerator;
        public string? Department { get; set; }
        public bool AllowsIssue { get; set; } = true;
        public bool AllowsRemoteIssue { get; set; }
        public bool AllowsElectronicIssue { get; set; } = true;
        public bool RequiresSecondVerifier { get; set; }
        public bool IsSatellite { get; set; }
        public bool AllowsRbc { get; set; } = true;
        public bool AllowsPlasma { get; set; } = true;
        public bool AllowsPlatelets { get; set; } = true;
        public bool AllowsCryo { get; set; } = true;
        public bool AllowsWholeBlood { get; set; } = true;
        public decimal? StorageTempMinC { get; set; }
        public decimal? StorageTempMaxC { get; set; }
        public int? DefaultInTransitHours { get; set; }
        public string? Notes { get; set; }
        public bool ApplyTypeDefaults { get; set; }
    }
}
