@page "/admin/blood-suppliers"
@using BloodBankLIS.Application.Admin
@inject UserSession Session
@inject BloodBankApiClient Api

<PageTitle>Blood Suppliers &middot; Admin</PageTitle>

<div class="flex-between">
    <h1>Blood Suppliers</h1>
    <div class="flex gap">
        @if (CanEdit)
        {
            <button class="btn btn-primary" @onclick="NewDraft">New supplier</button>
        }
    </div>
</div>
<p class="muted">Code, name, and registration are required. Address is optional. Deliveries pick an active supplier. The code stays in the catalog. A blank name on this list stays the supplier id. The edit form still shows the stored name.</p>

<Outcome Value="_feedback" />

<div class="bb-card" style="margin-top:1rem;">
    <div class="flex gap" style="margin-bottom:.6rem;">
        <input style="flex:1;" placeholder="Filter by code, name, or registration" @bind="_filter" @bind:event="oninput" />
        <label class="flex" style="gap:.35rem;"><input type="checkbox" @bind="_includeInactive" @bind:after="LoadAsync" /> Include inactive</label>
    </div>

    @if (_loading)
    {
        <div class="loading">Loading...</div>
    }
    else if (!Filtered.Any())
    {
        <div class="empty">No blood suppliers.</div>
    }
    else
    {
        <table class="bb">
            <thead><tr><th>Code</th><th>Name</th><th>Registration</th><th>Address</th><th>Status</th><th></th></tr></thead>
            <tbody>
                @foreach (var s in Filtered)
                {
                    <tr>
                        <td class="mono">@s.Code</td>
                        <td>@s.NameLabel</td>
                        <td class="mono">@s.Registration</td>
                        <td>@(s.Address ?? "—")</td>
                        <td>@(s.IsActive ? "Active" : "Inactive")</td>
                        <td class="right nowrap">
                            @if (CanEdit)
                            {
                                <button class="btn btn-ghost btn-sm" @onclick="() => Edit(s)">Edit</button>
                                @if (s.IsActive)
                                {
                                    <button class="btn btn-ghost btn-sm" @onclick="() => SetActiveAsync(s.Id, false)">Deactivate</button>
                                }
                                else if (CanActivate)
                                {
                                    <button class="btn btn-ghost btn-sm" @onclick="() => SetActiveAsync(s.Id, true)">Activate</button>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@if (_draft is not null && CanEdit)
{
    <div class="bb-card" style="margin-top:1rem;">
        <h2>@(_editId is null ? "New supplier" : $"Edit: {_draft.Code}")</h2>
        <div class="form-row">
            <div class="field"><label>Code</label><input class="mono" @bind="_draft.Code" disabled="@(_editId is not null)" /></div>
            <div class="field"><label>Name</label><input @bind="_draft.Name" /></div>
            <div class="field"><label>Registration</label><input class="mono" @bind="_draft.Registration" /></div>
            <div class="field"><label>Address</label><input @bind="_draft.Address" placeholder="Optional" /></div>
        </div>
        <div class="flex gap">
            <button class="btn btn-primary" disabled="@_busy" @onclick="SaveAsync">Save</button>
            <button class="btn btn-ghost" @onclick="CancelEdit">Cancel</button>
        </div>
    </div>
}

@code {
    private bool _loading = true;
    private bool _busy;
    private string _filter = string.Empty;
    private bool _includeInactive;
    private List<BloodSupplierDto> _list = new();
    private Feedback? _feedback;
    private long? _editId;
    private SupplierDraft? _draft;

    private bool CanEdit => Session.Has(PermissionCodes.AdminConfigEdit);
    private bool CanActivate => Session.Has(PermissionCodes.AdminConfigActivate);

    private IEnumerable<BloodSupplierDto> Filtered =>
        string.IsNullOrWhiteSpace(_filter)
            ? _list
            : _list.Where(s =>
                s.Code.Contains(_filter, StringComparison.OrdinalIgnoreCase)
                || s.Name.Contains(_filter, StringComparison.OrdinalIgnoreCase)
                || s.NameLabel.Contains(_filter, StringComparison.OrdinalIgnoreCase)
                || s.Registration.Contains(_filter, StringComparison.OrdinalIgnoreCase)
                || (s.Address?.Contains(_filter, StringComparison.OrdinalIgnoreCase) ?? false));

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        var r = await Api.GetAdminBloodSuppliersAsync(_includeInactive);
        _list = r.Succeeded ? r.Value ?? new() : new();
        if (!r.Succeeded) _feedback = r.ToFeedback();
        _loading = false;
    }

    private void NewDraft() { _editId = null; _draft = new SupplierDraft(); }

    private void Edit(BloodSupplierDto s)
    {
        _editId = s.Id;
        _draft = new SupplierDraft
        {
            Code = s.Code,
            Name = s.Name,
            Address = s.Address,
            Registration = s.Registration
        };
    }

    private void CancelEdit() { _editId = null; _draft = null; }

    private async Task SaveAsync()
    {
        if (_draft is null) return;
        if (string.IsNullOrWhiteSpace(_draft.Code) || string.IsNullOrWhiteSpace(_draft.Name) || string.IsNullOrWhiteSpace(_draft.Registration))
        {
            _feedback = Feedback.Fail("Code, name, and registration are required.");
            return;
        }

        _busy = true;
        var req = new SaveBloodSupplierRequest(_draft.Code, _draft.Name, _draft.Address, _draft.Registration);
        var r = _editId is null
            ? await Api.CreateAdminBloodSupplierAsync(req)
            : await Api.UpdateAdminBloodSupplierAsync(_editId.Value, req);
        _busy = false;
        if (r.Succeeded)
        {
            _feedback = r.ToFeedback("Supplier saved.");
            _editId = null;
            _draft = null;
            await LoadAsync();
        }
        else
        {
            _feedback = r.ToFeedback();
        }
    }

    private async Task SetActiveAsync(long id, bool active)
    {
        _busy = true;
        var r = await Api.SetAdminBloodSupplierActiveAsync(id, active);
        _busy = false;
        _feedback = r.Succeeded ? r.ToFeedback(active ? "Activated." : "Deactivated.") : r.ToFeedback();
        if (r.Succeeded) await LoadAsync();
    }

    private sealed class SupplierDraft
    {
        public string Code { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string? Address { get; set; }
        public string Registration { get; set; } = string.Empty;
    }
}
