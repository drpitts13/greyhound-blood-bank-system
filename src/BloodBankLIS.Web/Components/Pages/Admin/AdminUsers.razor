@page "/admin/users"
@inject UserSession Session
@inject BloodBankApiClient Api

<PageTitle>Users &middot; Admin</PageTitle>

<div class="flex-between">
    <h1>Users</h1>
    <div class="flex gap">
        <a class="btn btn-ghost" href="/admin/roles">Open Roles</a>
        <button class="btn btn-primary" @onclick="NewUser">New user</button>
    </div>
</div>
<p class="muted">Role definitions live on Roles &amp; Permissions. Privilege escalation here still requires a reason.</p>

<Outcome Value="_feedback" />

@* Periodic access review: who can sign in, with which roles, and who has not signed in for a while. *@
<div class="bb-card" style="margin-top:1rem;" data-access-review>
    <div class="bb-card-title"><h3>Access review</h3></div>
    @if (_lastReview is { } review)
    {
        <p class="muted" style="margin:0 0 .5rem;">Last recorded @review.ReviewedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm") by @review.ReviewedBy (@review.ActiveAccounts active accounts): @review.Note</p>
    }
    else
    {
        <p class="muted" style="margin:0 0 .5rem;">No access review recorded yet.</p>
    }
    <div class="form-row" style="align-items:flex-end;">
        <div class="field" style="flex:2;"><label>What was reviewed and decided</label><input @bind="_reviewNote" @bind:event="oninput" placeholder="e.g. Quarterly review: roles checked against staffing list; 2 dormant accounts deactivated" /></div>
        <button class="btn btn-secondary" disabled="@(_busy || string.IsNullOrWhiteSpace(_reviewNote))" @onclick="RecordReviewAsync" data-record-review>Record access review</button>
    </div>
    <p class="muted" style="margin:.25rem 0 0;">Recording keeps every active account with its roles and last sign-in in the audit trail. It changes no account.</p>
</div>

<div class="bb-card" style="margin-top:1rem;">
    <div class="flex gap" style="margin-bottom:.6rem;align-items:center;flex-wrap:wrap;">
        <input style="flex:1;" placeholder="Filter by username, name or role" @bind="_filter" @bind:event="oninput" />
        <label class="flex" style="gap:.35rem;align-items:center;" data-dormant-filter>
            <input type="checkbox" @bind="_dormantOnly" /> Active, not signed in for
            <input type="number" min="1" max="3650" style="width:5rem;" @bind="_dormantDays" @bind:event="oninput" /> days
        </label>
    </div>

    @if (_loading)
    {
        <div class="loading">Loading...</div>
    }
    else if (_users.Count == 0)
    {
        <div class="empty">No users.</div>
    }
    else if (!Filtered.Any())
    {
        <div class="empty">No users match "@_filter".</div>
    }
    else
    {
        <div class="table-scroll">
        <table class="bb">
            <thead><tr><th>Username</th><th>Display name</th><th>Roles</th><th>Status</th><th>Last sign-in</th><th></th></tr></thead>
            <tbody>
                @foreach (var u in Filtered)
                {
                    <tr>
                        <td class="mono">@u.UserName</td>
                        <td>@u.DisplayName @if (u.IsServiceAccount) { <span class="badge badge-gray">service</span> }</td>
                        <td>@string.Join(", ", u.Roles)</td>
                        <td>
                            @if (!u.IsActive) { <span class="badge badge-amber">Inactive</span> }
                            else if (u.IsLocked) { <span class="badge badge-amber">Locked</span> }
                            else { <span class="badge badge-green">Active</span> }
                        </td>
                        <td class="nowrap">
                            @if (u.LastLoginUtc is DateTime last)
                            {
                                @last.ToLocalTime().ToString("yyyy-MM-dd")
                            }
                            else
                            {
                                <span class="muted">Never</span>
                            }
                            @if (IsDormant(u))
                            {
                                <span class="badge badge-amber" style="margin-left:.35rem;" title="Active, and not signed in for @_dormantDays days or more">Dormant</span>
                            }
                        </td>
                        <td class="right nowrap">
                            <button class="btn btn-ghost btn-sm" @onclick="() => EditAsync(u.Id)">Manage</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    }
</div>

@if (_editing is not null)
{
    <div class="bb-card" style="margin-top:1rem;" data-scroll-on-show>
        <h2>@(_editId is null ? "New user" : $"Manage: {_editing.UserName}")</h2>
        <div class="form-row">
            <div class="field"><label>Username</label><input @bind="_editing.UserName" disabled="@(_editId is not null)" /></div>
            <div class="field"><label>Display name</label><input @bind="_editing.DisplayName" /></div>
            <div class="field"><label>Email</label><input @bind="_editing.Email" /></div>
        </div>
        <div class="flex gap" style="margin:.4rem 0;">
            <label class="flex" style="gap:.35rem;"><input type="checkbox" @bind="_editing.IsServiceAccount" /> Service account</label>
        </div>

        <div class="field">
            <label>Roles</label>
            <div class="checkbox-grid">
                @foreach (var role in _roles)
                {
                    <label class="checkbox-item"><input type="checkbox" checked="@_editing.Roles.Contains(role.Name)" @onchange="() => ToggleRole(role.Name)" /> @role.Name</label>
                }
            </div>
        </div>

        <div class="field"><label>Change reason (required to grant admin roles)</label>
            <input @bind="_changeReason" placeholder="Reason for this change" />
        </div>

        <div class="flex gap" style="margin-top:.6rem;flex-wrap:wrap;">
            <button class="btn btn-primary" disabled="@_busy" @onclick="SaveAsync">Save</button>
            @if (_editId is not null && _current is not null)
            {
                @if (_current.IsActive)
                {
                    <button class="btn btn-secondary" disabled="@_busy" @onclick="() => SetActiveAsync(false)">Deactivate</button>
                }
                else
                {
                    <button class="btn btn-secondary" disabled="@_busy" @onclick="() => SetActiveAsync(true)">Activate</button>
                }
                @if (_current.IsLocked)
                {
                    <button class="btn btn-secondary" disabled="@_busy" @onclick="() => SetLockedAsync(false)">Unlock</button>
                }
                else
                {
                    <button class="btn btn-secondary" disabled="@_busy" @onclick="() => SetLockedAsync(true)">Lock</button>
                }
                <button class="btn btn-ghost" disabled="@_busy" @onclick="ResetPasswordAsync">Reset password</button>
                <button class="btn btn-ghost" disabled="@_busy" @onclick="ResetMfaAsync" title="Removes the user's authenticator so they can set it up again">Reset authenticator</button>
            }
            <button class="btn btn-ghost" @onclick="() => _editing = null">Cancel</button>
        </div>
    </div>
}

@code {
    private List<AdminUserDto> _users = new();
    private List<AdminRoleDto> _roles = new();
    private string _filter = string.Empty;

    private AccessReviewDto? _lastReview;
    private string? _reviewNote;
    private bool _dormantOnly;
    private int _dormantDays = 90;

    // Active accounts (not service accounts) with no sign-in within the chosen number of days.
    private bool IsDormant(AdminUserDto u) =>
        DormantAccountRule.IsDormant(u.IsActive, u.IsServiceAccount, u.LastLoginUtc, DateTime.UtcNow, _dormantDays);

    private async Task LoadReviewAsync()
    {
        var r = await Api.GetLastAccessReviewAsync();
        _lastReview = r.Succeeded ? r.Value : null;
    }

    private async Task RecordReviewAsync()
    {
        _busy = true;
        var r = await Api.RecordAccessReviewAsync(new RecordAccessReviewRequest(_reviewNote));
        _busy = false;
        _feedback = r.ToFeedback("Access review recorded.");
        if (r.Succeeded)
        {
            _reviewNote = null;
            await LoadReviewAsync();
        }
    }

    private IEnumerable<AdminUserDto> Filtered => (_dormantOnly ? _users.Where(IsDormant) : _users)
        .Where(u => string.IsNullOrWhiteSpace(_filter) ||
                u.UserName.Contains(_filter, StringComparison.OrdinalIgnoreCase)
                || u.DisplayName.Contains(_filter, StringComparison.OrdinalIgnoreCase)
                || u.Roles.Any(r => r.Contains(_filter, StringComparison.OrdinalIgnoreCase)));
    private bool _loading = true;
    private Feedback? _feedback;
    private bool _busy;

    private EditModel? _editing;
    private long? _editId;
    private AdminUserDto? _current;
    private string? _changeReason;

    protected override async Task OnInitializedAsync()
    {
        var roles = await Api.GetAdminRolesAsync();
        _roles = roles.Value ?? new();
        await LoadAsync();
        await LoadReviewAsync();
        // Without roles the role picker is empty, so say why instead of showing nothing.
        if (!roles.Succeeded) _feedback = roles.ToFeedback();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        var r = await Api.GetAdminUsersAsync();
        _users = r.Value ?? new();
        if (!r.Succeeded) _feedback = r.ToFeedback();
        _loading = false;
    }

    private void NewUser()
    {
        _editId = null; _current = null; _changeReason = null;
        _editing = new EditModel();
        _feedback = null;
    }

    private async Task EditAsync(long id)
    {
        var r = await Api.GetAdminUserAsync(id);
        if (!r.Succeeded || r.Value is null) { _feedback = r.ToFeedback(); return; }
        _current = r.Value; _editId = r.Value.Id; _changeReason = null;
        _editing = EditModel.From(r.Value);
        _feedback = null;
    }

    private void ToggleRole(string name)
    {
        if (_editing is null) return;
        if (!_editing.Roles.Remove(name)) _editing.Roles.Add(name);
    }

    private async Task SaveAsync()
    {
        if (_editing is null) return;
        _busy = true;
        var req = _editing.ToRequest(_changeReason);
        var r = _editId is null ? await Api.CreateAdminUserAsync(req) : await Api.UpdateAdminUserAsync(_editId.Value, req);
        _busy = false;
        _feedback = r.ToFeedback(_editId is null ? "User created." : "Saved.");
        if (r.Succeeded) { _current = r.Value; _editId = r.Value!.Id; await LoadAsync(); }
    }

    private async Task SetActiveAsync(bool active)
    {
        if (_editId is null) return;
        _busy = true;
        var r = await Api.SetUserActiveAsync(_editId.Value, active, _changeReason);
        _busy = false;
        _feedback = r.ToFeedback(active ? "Activated." : "Deactivated.");
        if (r.Succeeded) { _current = r.Value; await LoadAsync(); }
    }

    private async Task SetLockedAsync(bool locked)
    {
        if (_editId is null) return;
        _busy = true;
        var r = await Api.SetUserLockedAsync(_editId.Value, locked, _changeReason);
        _busy = false;
        _feedback = r.ToFeedback(locked ? "Locked." : "Unlocked.");
        if (r.Succeeded) { _current = r.Value; await LoadAsync(); }
    }

    private async Task ResetPasswordAsync()
    {
        if (_editId is null) return;
        _busy = true;
        var r = await Api.ResetUserPasswordAsync(_editId.Value, _changeReason);
        _busy = false;
        _feedback = r.ToFeedback("Password reset recorded (placeholder).");
    }

    private async Task ResetMfaAsync()
    {
        if (_editId is null) return;
        _busy = true;
        var r = await Api.ResetUserMfaAsync(_editId.Value);
        _busy = false;
        _feedback = r.ToFeedback("Authenticator reset. The user sets it up again at next sign-in if policy requires it.");
    }

    private sealed class EditModel
    {
        public string UserName { get; set; } = string.Empty;
        public string DisplayName { get; set; } = string.Empty;
        public string? Email { get; set; }
        public bool IsServiceAccount { get; set; }
        public List<string> Roles { get; set; } = new();

        public static EditModel From(AdminUserDto u) => new()
        {
            UserName = u.UserName, DisplayName = u.DisplayName, Email = u.Email,
            IsServiceAccount = u.IsServiceAccount, Roles = u.Roles.ToList()
        };

        public SaveUserRequest ToRequest(string? reason) => new(UserName, DisplayName, Email, IsServiceAccount, Roles, reason);
    }
}
