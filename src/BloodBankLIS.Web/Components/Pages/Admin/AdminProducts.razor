@page "/admin/products"
@inject UserSession Session
@inject BloodBankApiClient Api

<PageTitle>Products &middot; Admin</PageTitle>

<div class="flex-between">
    <h1>Product Definitions</h1>
    <div class="flex gap">
        <a class="btn btn-ghost" href="/admin/isbt-product-codes">Open ISBT Product Codes</a>
        <a class="btn btn-ghost" href="/admin/product-billing">Open Product Billing</a>
        @if (CanManage)
        {
            <button class="btn btn-primary" @onclick="NewDraft">New product</button>
        }
    </div>
</div>
<p class="muted">Product types, attributes, and issue/return rules. Intake product codes live on ISBT Product Codes; issue charges live on Product Billing. The list keeps the product code. A blank name stays Product {id}. That label is not written onto the product, and the edit form keeps the stored name.</p>

<Outcome Value="_feedback" />

<div class="bb-card" style="margin-top:1rem;">
    @if (_loading)
    {
        <div class="loading">Loading...</div>
    }
    else if (_items.Count == 0)
    {
        <div class="empty">No products.</div>
    }
    else
    {
        <table class="bb">
            <thead><tr><th>Code</th><th>Name</th><th>Class</th><th>XM</th><th>Retype</th><th>Attributes</th><th>Ver</th><th>Status</th><th></th></tr></thead>
            <tbody>
                @foreach (var p in _items)
                {
                    <tr>
                        <td class="mono">@p.ProductCode</td>
                        <td>@p.NameLabel</td>
                        <td>@p.ComponentClass</td>
                        <td>@(p.RequiresCrossmatch ? "Yes" : "No")</td>
                        <td>
                            @if (p.RequiresRetype)
                            {
                                <span>Y</span>
                                <span class="muted mono">
                                    @(p.RhPositiveRetypeTestCode ?? "?")/@(p.RhNegativeRetypeTestCode ?? "?")
                                </span>
                            }
                            else
                            {
                                <span>N</span>
                            }
                        </td>
                        <td>@string.Join(", ", p.Attributes.Select(a => a.Code + (a.IsRequired ? "*" : "")))</td>
                        <td>@p.Version</td>
                        <td>
                            @if (p.IsActive) { <span class="badge badge-green">Active</span> }
                            else { <span class="badge badge-gray">Inactive</span> }
                        </td>
                        <td class="right nowrap">
                            <button class="btn btn-ghost btn-sm" @onclick="() => EditAsync(p.Id)">Edit</button>
                            <button class="btn btn-ghost btn-sm" @onclick="() => ShowHistoryAsync(p.Id)">History</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@if (_editing is not null)
{
    <div class="bb-card" style="margin-top:1rem;">
        <h2>@(_editId is null ? "New product" : $"Edit: {_editing.ProductCode}")</h2>
        <div class="form-row">
            <div class="field"><label>Product code</label><input @bind="_editing.ProductCode" disabled="@(_editId is not null)" /></div>
            <div class="field"><label>Name</label><input @bind="_editing.Name" /></div>
            <div class="field"><label>Component class</label>
                <select value="@_editing.ComponentClass" @onchange="OnComponentClassChanged">@foreach (var c in Enum.GetValues<ComponentClass>()) { <option value="@c">@c</option> }</select>
            </div>
            <div class="field"><label>Category</label><input @bind="_editing.Category" /></div>
            <div class="field"><label>Shelf life (hours)</label><input type="number" @bind="_editing.DefaultShelfLifeHours" /></div>
            <div class="field"><label>ISBT 128 code</label><input @bind="_editing.Isbt128ProductCode" /></div>
            <div class="field"><label>Default charge code</label><input @bind="_editing.DefaultChargeCode" /></div>
            <div class="field"><label>Storage requirements</label><input @bind="_editing.StorageRequirements" /></div>
            <div class="field" style="grid-column:1/3;"><label>Issue rules</label><input @bind="_editing.IssueRules" /></div>
            <div class="field" style="grid-column:1/3;"><label>Return rules</label><input @bind="_editing.ReturnRules" /></div>
            <div class="field" style="grid-column:1/3;"><label>Modification rules</label><input @bind="_editing.ModificationRules" /></div>
        </div>

        <div class="flex gap" style="flex-wrap:wrap;margin:.6rem 0;">
            <label class="flex" style="gap:.35rem;"><input type="checkbox" @bind="_editing.RequiresCrossmatch" /> Requires crossmatch</label>
            <label class="flex" style="gap:.35rem;"><input type="checkbox" @bind="_editing.RequiresAboMatch" /> Requires ABO match</label>
            <label class="flex" style="gap:.35rem;"><input type="checkbox" @bind="_editing.RequiresRhMatch" /> Requires Rh match</label>
            <label class="flex" style="gap:.35rem;"><input type="checkbox" @bind="_editing.RequiresRetype" /> Retype (Y/N)</label>
        </div>

        <div style="margin:.8rem 0;">
            <div class="flex-between">
                <h3 style="margin:0;">ABO compatibility</h3>
                <button type="button" class="btn btn-ghost btn-sm" @onclick="ResetAboRh">Reset to standard for this class</button>
            </div>
            <p class="muted">Checked cells may be issued. ABO is the same for every patient sex. Issue and allocation use this grid.</p>
            <table class="bb">
                <thead>
                    <tr>
                        <th>Patient</th>
                        @foreach (var unit in StandardProductAboRhPolicy.AboGroups)
                        {
                            <th>Unit @unit</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var patientAbo in StandardProductAboRhPolicy.AboGroups)
                    {
                        <tr>
                            <td>@patientAbo</td>
                            @foreach (var unitAbo in StandardProductAboRhPolicy.AboGroups)
                            {
                                var cell = _editing.AboCell(patientAbo, unitAbo);
                                <td><input type="checkbox" checked="@cell.IsAllowed" @onchange="e => SetAbo(cell, (bool)e.Value!)" /></td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div style="margin:.8rem 0 1rem;">
            <h3 style="margin:0 0 .35rem;">Rh compatibility</h3>
            <p class="muted">Rh can differ by sex. Unknown and other sex use the Unknown/Other column.</p>
            <table class="bb">
                <thead>
                    <tr>
                        <th>Pair</th>
                        @foreach (var sex in StandardProductAboRhPolicy.SexGroups)
                        {
                            <th>@SexLabel(sex)</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in RhRows)
                    {
                        <tr>
                            <td>@row.Label</td>
                            @foreach (var sex in StandardProductAboRhPolicy.SexGroups)
                            {
                                var cell = _editing.RhCell(row.Patient, row.Unit, sex);
                                <td><input type="checkbox" checked="@cell.IsAllowed" @onchange="e => SetRh(cell, (bool)e.Value!)" /></td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (_editing.RequiresRetype)
        {
            <div class="form-row">
                <div class="field">
                    <label>Rh+ Retype Test</label>
                    <select @bind="_editing.RhPositiveRetypeTestId">
                        <option value="">Select test</option>
                        @foreach (var t in RetypeTests)
                        {
                            <option value="@t.Id.ToString()">@t.Code — @t.Name</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label>Rh− Retype Test</label>
                    <select @bind="_editing.RhNegativeRetypeTestId">
                        <option value="">Select test</option>
                        @foreach (var t in RetypeTests)
                        {
                            <option value="@t.Id.ToString()">@t.Code — @t.Name</option>
                        }
                    </select>
                </div>
            </div>
        }

        <div class="field">
            <label>Attributes</label>
            <div class="flex gap" style="flex-wrap:wrap;">
                @foreach (var attr in _attributes)
                {
                    var sel = _editing.Attributes.FirstOrDefault(a => a.AttributeId == attr.Id);
                    <span class="badge @(sel is not null ? "badge-green" : "badge-gray")" style="cursor:pointer;" @onclick="() => ToggleAttr(attr.Id)">
                        @attr.Code
                        @if (sel is not null)
                        {
                            <label class="flex" style="gap:.2rem;margin-left:.4rem;" @onclick:stopPropagation="true">
                                <input type="checkbox" checked="@sel.IsRequired" @onchange="e => SetRequired(attr.Id, (bool)e.Value!)" /> req
                            </label>
                        }
                    </span>
                }
            </div>
        </div>

        <div class="field"><label>Change reason @(_currentIsActive ? "(required)" : "(optional)")</label>
            <input @bind="_changeReason" placeholder="Why is this change being made?" />
        </div>

        <div class="flex gap" style="margin-top:.6rem;">
            <button class="btn btn-primary" disabled="@_busy" @onclick="SaveAsync">Save</button>
            @if (_editId is not null && CanActivate)
            {
                @if (!_currentIsActive)
                {
                    <button class="btn btn-secondary" disabled="@_busy" @onclick="ActivateAsync">Activate</button>
                }
                else
                {
                    <button class="btn btn-secondary" disabled="@_busy" @onclick="DeactivateAsync">Deactivate</button>
                }
            }
            <button class="btn btn-ghost" @onclick="() => _editing = null">Cancel</button>
        </div>
    </div>
}

@if (_history is not null)
{
    <ConfigHistoryPanel Title="@($"History: {_historyTitle}")" Rows="_history" OnClose="() => _history = null" />
}

@code {
    private List<ProductDefinitionDto> _items = new();
    private List<ProductAttributeDto> _attributes = new();
    private List<TestDefinitionDto> _tests = new();
    private bool _loading = true;
    private Feedback? _feedback;
    private bool _busy;

    private EditModel? _editing;
    private long? _editId;
    private bool _currentIsActive;
    private string? _changeReason;
    private bool _aboRhDirty;

    private static readonly (RhType Patient, RhType Unit, string Label)[] RhRows =
    [
        (RhType.Negative, RhType.Positive, "Rh− patient, Rh+ unit"),
        (RhType.Negative, RhType.Negative, "Rh− patient, Rh− unit"),
        (RhType.Positive, RhType.Positive, "Rh+ patient, Rh+ unit"),
        (RhType.Positive, RhType.Negative, "Rh+ patient, Rh− unit")
    ];

    private static string SexLabel(RhCompatibilitySex sex) => sex switch
    {
        RhCompatibilitySex.Male => "Male",
        RhCompatibilitySex.Female => "Female",
        _ => "Unknown/Other"
    };

    private List<ConfigHistoryDto>? _history;
    private string _historyTitle = string.Empty;

    private bool CanManage => Session.Has(PermissionCodes.AdminProductsManage);
    private bool CanActivate => Session.Has(PermissionCodes.AdminConfigActivate);
    private IEnumerable<TestDefinitionDto> RetypeTests =>
        _tests.Where(t => t.IsActive && (t.Category is TestCategory.AboRhRetype or TestCategory.AboRh))
            .OrderBy(t => t.Code);

    protected override async Task OnInitializedAsync()
    {
        var attrs = await Api.GetProductAttributesAsync();
        _attributes = attrs.Value ?? new();
        var tests = await Api.GetAdminTestsAsync(includeInactive: false);
        _tests = tests.Value ?? new();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        var r = await Api.GetAdminProductsAsync();
        _items = r.Value ?? new();
        if (!r.Succeeded) _feedback = r.ToFeedback();
        _loading = false;
    }

    private void NewDraft()
    {
        _editId = null; _currentIsActive = false; _changeReason = null; _aboRhDirty = false;
        _editing = new EditModel();
        _editing.LoadPolicy(StandardProductAboRhPolicy.For(ComponentClass.RedBloodCells));
        _feedback = null;
    }

    private void OnComponentClassChanged(ChangeEventArgs e)
    {
        if (_editing is null || !Enum.TryParse<ComponentClass>(e.Value?.ToString(), out var next))
        {
            return;
        }

        _editing.ComponentClass = next;
        if (_editId is null && !_aboRhDirty)
        {
            _editing.LoadPolicy(StandardProductAboRhPolicy.For(next));
        }
    }

    private void ResetAboRh()
    {
        if (_editing is null)
        {
            return;
        }

        _editing.LoadPolicy(StandardProductAboRhPolicy.For(_editing.ComponentClass));
        _aboRhDirty = true;
    }

    private void SetAbo(AboCellEdit cell, bool allowed)
    {
        cell.IsAllowed = allowed;
        _aboRhDirty = true;
    }

    private void SetRh(RhCellEdit cell, bool allowed)
    {
        cell.IsAllowed = allowed;
        _aboRhDirty = true;
    }

    private async Task EditAsync(long id)
    {
        var r = await Api.GetAdminProductAsync(id);
        if (!r.Succeeded || r.Value is null) { _feedback = r.ToFeedback(); return; }
        _editId = r.Value.Id; _currentIsActive = r.Value.IsActive; _changeReason = null; _aboRhDirty = false;
        _editing = EditModel.From(r.Value);
        _feedback = null;
    }

    private void ToggleAttr(long attrId)
    {
        if (_editing is null) return;
        var existing = _editing.Attributes.FirstOrDefault(a => a.AttributeId == attrId);
        if (existing is not null) _editing.Attributes.Remove(existing);
        else _editing.Attributes.Add(new ProductAttributeSelection(attrId, false));
    }

    private void SetRequired(long attrId, bool required)
    {
        if (_editing is null) return;
        var idx = _editing.Attributes.FindIndex(a => a.AttributeId == attrId);
        if (idx >= 0) _editing.Attributes[idx] = new ProductAttributeSelection(attrId, required);
    }

    private async Task SaveAsync()
    {
        if (_editing is null) return;
        _busy = true;
        var req = _editing.ToRequest(_changeReason);
        var r = _editId is null ? await Api.CreateAdminProductAsync(req) : await Api.UpdateAdminProductAsync(_editId.Value, req);
        _busy = false;
        _feedback = r.ToFeedback(_editId is null ? "Draft created." : "Saved.");
        if (r.Succeeded) { _editId = r.Value!.Id; _currentIsActive = r.Value.IsActive; await LoadAsync(); }
    }

    private async Task ActivateAsync()
    {
        if (_editId is null) return;
        _busy = true;
        var r = await Api.ActivateAdminProductAsync(_editId.Value, _changeReason);
        _busy = false;
        _feedback = r.ToFeedback("Activated.");
        if (r.Succeeded) { _currentIsActive = true; await LoadAsync(); }
    }

    private async Task DeactivateAsync()
    {
        if (_editId is null) return;
        _busy = true;
        var r = await Api.DeactivateAdminProductAsync(_editId.Value, _changeReason);
        _busy = false;
        _feedback = r.ToFeedback("Deactivated.");
        if (r.Succeeded) { _currentIsActive = false; await LoadAsync(); }
    }

    private async Task ShowHistoryAsync(long id)
    {
        var r = await Api.GetConfigHistoryAsync(nameof(BloodBankLIS.Domain.Entities.ProductType), id);
        _history = r.Value ?? new();
        _historyTitle = _items.FirstOrDefault(p => p.Id == id)?.ProductCode ?? id.ToString();
    }

    private sealed class EditModel
    {
        public string ProductCode { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public ComponentClass ComponentClass { get; set; } = ComponentClass.RedBloodCells;
        public string? Category { get; set; }
        public int? DefaultShelfLifeHours { get; set; }
        public bool RequiresCrossmatch { get; set; }
        public bool RequiresAboMatch { get; set; } = true;
        public bool RequiresRhMatch { get; set; } = true;
        public bool RequiresRetype { get; set; }
        public string RhPositiveRetypeTestId { get; set; } = string.Empty;
        public string RhNegativeRetypeTestId { get; set; } = string.Empty;
        public string? Isbt128ProductCode { get; set; }
        public string? DefaultChargeCode { get; set; }
        public string? StorageRequirements { get; set; }
        public string? IssueRules { get; set; }
        public string? ReturnRules { get; set; }
        public string? ModificationRules { get; set; }
        public List<ProductAttributeSelection> Attributes { get; set; } = new();
        public List<AboCellEdit> AboCells { get; set; } = new();
        public List<RhCellEdit> RhCells { get; set; } = new();

        public AboCellEdit AboCell(AboGroup patient, AboGroup unit) =>
            AboCells.First(c => c.PatientAbo == patient && c.UnitAbo == unit);

        public RhCellEdit RhCell(RhType patient, RhType unit, RhCompatibilitySex sex) =>
            RhCells.First(c => c.PatientRh == patient && c.UnitRh == unit && c.SexGroup == sex);

        public void LoadPolicy(ProductAboRhPolicy policy)
        {
            AboCells = policy.AboCells
                .Select(c => new AboCellEdit { PatientAbo = c.PatientAbo, UnitAbo = c.UnitAbo, IsAllowed = c.IsAllowed })
                .ToList();
            RhCells = policy.RhCells
                .Select(c => new RhCellEdit { SexGroup = c.SexGroup, PatientRh = c.PatientRh, UnitRh = c.UnitRh, IsAllowed = c.IsAllowed })
                .ToList();
        }

        public static EditModel From(ProductDefinitionDto p)
        {
            var model = new EditModel
            {
                ProductCode = p.ProductCode, Name = p.Name, ComponentClass = p.ComponentClass, Category = p.Category,
                DefaultShelfLifeHours = p.DefaultShelfLifeHours, RequiresCrossmatch = p.RequiresCrossmatch,
                RequiresAboMatch = p.RequiresAboMatch, RequiresRhMatch = p.RequiresRhMatch, RequiresRetype = p.RequiresRetype,
                RhPositiveRetypeTestId = p.RhPositiveRetypeTestId?.ToString() ?? string.Empty,
                RhNegativeRetypeTestId = p.RhNegativeRetypeTestId?.ToString() ?? string.Empty,
                Isbt128ProductCode = p.Isbt128ProductCode,
                DefaultChargeCode = p.DefaultChargeCode, StorageRequirements = p.StorageRequirements, IssueRules = p.IssueRules,
                ReturnRules = p.ReturnRules, ModificationRules = p.ModificationRules,
                Attributes = p.Attributes.Select(a => new ProductAttributeSelection(a.AttributeId, a.IsRequired)).ToList()
            };
            var standard = StandardProductAboRhPolicy.For(p.ComponentClass);
            if (p.AboCompatibilities is { Count: > 0 } || p.RhCompatibilities is { Count: > 0 })
            {
                model.LoadPolicy(Overlay(standard, p));
            }
            else
            {
                model.LoadPolicy(standard);
            }

            return model;
        }

        private static ProductAboRhPolicy Overlay(ProductAboRhPolicy standard, ProductDefinitionDto p)
        {
            var abo = standard.AboCells.ToDictionary(c => (c.PatientAbo, c.UnitAbo));
            foreach (var cell in p.AboCompatibilities ?? [])
            {
                abo[(cell.PatientAbo, cell.UnitAbo)] = new ProductAboRhPolicy.AboCell(cell.PatientAbo, cell.UnitAbo, cell.IsAllowed);
            }

            var rh = standard.RhCells.ToDictionary(c => (c.SexGroup, c.PatientRh, c.UnitRh));
            foreach (var cell in p.RhCompatibilities ?? [])
            {
                rh[(cell.SexGroup, cell.PatientRh, cell.UnitRh)] =
                    new ProductAboRhPolicy.RhCell(cell.SexGroup, cell.PatientRh, cell.UnitRh, cell.IsAllowed);
            }

            return new ProductAboRhPolicy(abo.Values, rh.Values);
        }

        public SaveProductDefinitionRequest ToRequest(string? reason) => new(
            ProductCode, Name, ComponentClass, Category, DefaultShelfLifeHours, RequiresCrossmatch, RequiresAboMatch,
            RequiresRhMatch, RequiresRetype, Isbt128ProductCode, DefaultChargeCode, StorageRequirements, IssueRules, ReturnRules,
            ModificationRules, Attributes, reason,
            ParseId(RhPositiveRetypeTestId), ParseId(RhNegativeRetypeTestId),
            AboCells.Select(c => new ProductAboCompatibilityDto(c.PatientAbo, c.UnitAbo, c.IsAllowed)).ToList(),
            RhCells.Select(c => new ProductRhCompatibilityDto(c.SexGroup, c.PatientRh, c.UnitRh, c.IsAllowed)).ToList());

        private static long? ParseId(string? value) =>
            long.TryParse(value, out var id) && id > 0 ? id : null;
    }

    private sealed class AboCellEdit
    {
        public AboGroup PatientAbo { get; set; }
        public AboGroup UnitAbo { get; set; }
        public bool IsAllowed { get; set; }
    }

    private sealed class RhCellEdit
    {
        public RhCompatibilitySex SexGroup { get; set; }
        public RhType PatientRh { get; set; }
        public RhType UnitRh { get; set; }
        public bool IsAllowed { get; set; }
    }
}
