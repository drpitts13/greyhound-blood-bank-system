@page "/admin/tests"
@using BloodBankLIS.Application.Admin
@using BloodBankLIS.Application.Reference
@using BloodBankLIS.Domain.ValueObjects
@inject UserSession Session
@inject BloodBankApiClient Api

<PageTitle>Test Definitions &middot; Admin</PageTitle>

<div class="flex-between">
    <h1>Test Definitions</h1>
    <div class="flex gap">
        <a class="btn btn-ghost" href="/admin/specimen-types">Open Specimen Types</a>
        <a class="btn btn-ghost" href="/admin/test-groupers">Open Test Groupers</a>
        <a class="btn btn-ghost" href="/admin/reflex-rules">Open Reflex Rules</a>
        <a class="btn btn-ghost" href="/admin/test-service-billing">Open Test/Service Billing</a>
        <a class="btn btn-ghost" href="/admin/charge-rules">Open Charge Rules</a>
        @if (CanManage)
        {
            <button class="btn btn-primary" @onclick="NewDraft">New test</button>
        }
    </div>
</div>
<p class="muted">Test catalog: result types, panel assignments, interpretation logic, history contribution.</p>
<details class="bb-help">
    <summary>How it works</summary>
    <ul>
        <li>Verified-result charges are mapped on Test/Service Billing.</li>
        <li>The list keeps the test code. A blank name stays Test {id}. That label is not written onto the test, and the edit form keeps the stored name.</li>
    </ul>
</details>

<Outcome Value="_feedback" />

<div class="bb-card" style="margin-top:1rem;">
    <div class="flex gap" style="margin-bottom:.6rem;">
        <input style="flex:1;" placeholder="Filter by code or name" @bind="_filter" @bind:event="oninput" />
        <label class="flex" style="gap:.35rem;"><input type="checkbox" @bind="_includeInactive" @bind:after="LoadAsync" /> Include inactive</label>
    </div>

    @if (_loading)
    {
        <div class="loading">Loading...</div>
    }
    else if (Filtered.Count == 0)
    {
        <div class="empty">No test definitions.</div>
    }
    else
    {
        <div class="table-scroll">
        <table class="bb">
            <thead>
                <tr><th>Code</th><th>Name</th><th>Category</th><th>Value type</th><th>Ver</th><th>Status</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var t in Filtered)
                {
                    <tr>
                        <td class="mono">@t.Code</td>
                        <td>@t.NameLabel</td>
                        <td>@t.Category</td>
                        <td>@DisplayValueType(t.ResultValueType)</td>
                        <td>@t.Version</td>
                        <td>@StatusBadge(t)</td>
                        <td class="right nowrap">
                            <button class="btn btn-ghost btn-sm" @onclick="() => EditAsync(t.Id)">Edit</button>
                            @if (Session.Has(PermissionCodes.AdminAuditReview))
                            {
                                <button class="btn btn-ghost btn-sm" @onclick="() => ShowHistoryAsync(t.Id)">History</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    }
</div>

@if (_editing is not null)
{
    <div class="bb-card" style="margin-top:1rem;" data-scroll-on-show>
        <h2>@(_editId is null ? "New test definition" : $"Edit: {_editing.Code}")</h2>
        <div class="form-row">
            <div class="field"><label>Code</label><input @bind="_editing.Code" disabled="@(_editId is not null)" /></div>
            <div class="field"><label>Name</label><input @bind="_editing.Name" /></div>
            <div class="field"><label>Category</label>
                <select @bind="_editing.Category">
                    @foreach (var c in Enum.GetValues<TestCategory>()) { <option value="@c">@Ui.EnumText(c)</option> }
                </select>
            </div>
            <div class="field"><label>Result value type</label>
                <select @bind="_editing.ResultValueType" @bind:after="OnResultValueTypeChanged">
                    @foreach (var v in Enum.GetValues<ResultValueType>()) { <option value="@v">@DisplayValueType(v)</option> }
                </select>
            </div>
            <div class="field"><label>LOINC code (optional)</label>
                <input @bind="_editing.LoincCode" placeholder="e.g. 882-1" data-loinc-code />
                <span class="sub">Sent to the EHR with each result, beside the test code. Your interface team chooses it.</span>
            </div>
            @if (_editing.ResultValueType == ResultValueType.Numeric)
            {
                <div class="field" style="grid-column:1/-1;" data-numeric-settings>
                    <label><strong>Numeric result</strong> (every limit is optional and the facility's own)</label>
                    <div class="form-row" style="margin-top:.4rem;">
                        <div class="field"><label>Units</label><input @bind="_editing.Shape.ResultUnits" placeholder="e.g. %" /></div>
                        <div class="field"><label>Decimal places</label><input type="number" min="0" max="4" @bind="_editing.Shape.DecimalPlaces" /></div>
                        <div class="field"><label>Reportable low</label><input type="number" step="any" @bind="_editing.Shape.ReportableLow" /></div>
                        <div class="field"><label>Reportable high</label><input type="number" step="any" @bind="_editing.Shape.ReportableHigh" /></div>
                        <div class="field"><label>Reference low</label><input type="number" step="any" @bind="_editing.Shape.ReferenceLow" /></div>
                        <div class="field"><label>Reference high</label><input type="number" step="any" @bind="_editing.Shape.ReferenceHigh" /></div>
                        <div class="field"><label>Critical low</label><input type="number" step="any" @bind="_editing.Shape.CriticalLow" /></div>
                        <div class="field"><label>Critical high</label><input type="number" step="any" @bind="_editing.Shape.CriticalHigh" /></div>
                    </div>
                    <p class="muted" style="margin:.25rem 0 0;">Outside the reportable range is refused at entry; outside the reference range is flagged L or H; beyond a critical limit is flagged LL or HH and warns.</p>
                </div>
            }
            @if (_editing.ResultValueType == ResultValueType.Titer)
            {
                <div class="field" style="grid-column:1/-1;" data-titer-settings>
                    <label><strong>Titer</strong> (doubling dilutions; endpoint and scoring are the facility's, OCD-065)</label>
                    <div class="form-row" style="margin-top:.4rem;">
                        <div class="field"><label>First dilution (1:n)</label><input type="number" min="1" @bind="_editing.Shape.TiterStartDilution" /></div>
                        <div class="field"><label>Last dilution (1:n)</label><input type="number" min="2" @bind="_editing.Shape.TiterEndDilution" /></div>
                        <div class="field"><label>Read at phase</label>
                            <select @bind="_editing.Shape.TiterPhaseCode">
                                <option value="">(none)</option>
                                @foreach (var phase in _catalogPhases)
                                {
                                    <option value="@phase.Code">@phase.Code — @phase.Name</option>
                                }
                            </select>
                        </div>
                        <div class="field"><label>Endpoint: weakest grade that counts</label>
                            <select @bind="_editing.Shape.TiterEndpointMinGrade">
                                <option value="">Choose</option>
                                @foreach (var grade in BloodBankLIS.Domain.Rules.TiterRule.Grades.Skip(1))
                                {
                                    <option value="@grade">@Ui.EnumText(grade)</option>
                                }
                            </select>
                        </div>
                        <div class="field"><label class="flex" style="gap:.35rem;"><input type="checkbox" @bind="_editing.Shape.TiterScored" /> Calculate a score</label></div>
                    </div>
                    @if (_editing.Shape.TiterStartDilution is int start && _editing.Shape.TiterEndDilution is int end)
                    {
                        var series = BloodBankLIS.Domain.Rules.TiterRule.Dilutions(start, end);
                        <p class="muted" style="margin:.25rem 0 0;" data-titer-series>@(series.Count == 0
                            ? "The last dilution must be the first doubled 1 to 13 times (for example 1 to 2048)."
                            : $"{series.Count} dilutions: {string.Join(", ", series.Select(d => $"1:{d}"))}")</p>
                    }
                </div>
            }
            @if (_editing.ResultValueType == ResultValueType.BloodAttribute)
            {
                <div class="field">
                    <label>Scoped as</label>
                    <select @bind="_editing.BloodAttributeScopeKind">
                        @foreach (var k in Enum.GetValues<BloodAttributeKind>()) { <option value="@k">@Ui.EnumText(k)</option> }
                    </select>
                </div>
                <div class="field" style="grid-column:1/-1;">
                    <label><strong>Blood attribute scope</strong> (catalog @(_editing.BloodAttributeScopeKind == BloodAttributeKind.Antibody ? "antibodies" : "antigens") this test may report)</label>
                    <div class="flex gap" style="flex-wrap:wrap;margin-top:.4rem;">
                        @foreach (var attr in _catalogBloodAttributes)
                        {
                            var selected = _editing.BloodAttributeScopeCodes.Contains(attr.Code, StringComparer.Ordinal);
                            <label class="flex" style="gap:.35rem;">
                                <input type="checkbox" checked="@selected" @onchange="e => ToggleBloodAttrScope(attr.Code, (bool)(e.Value ?? false))" />
                                @attr.Code —
                                @(_editing.BloodAttributeScopeKind == BloodAttributeKind.Antibody ? attr.AntibodyName : attr.Name)
                            </label>
                        }
                    </div>
                </div>
            }
            @if (EditModel.UsesPanelSubtests(_editing.ResultValueType))
            {
                @if (_editing.ResultValueType is ResultValueType.Crossmatch or ResultValueType.ComplexCrossmatch)
                {
                    <div class="field" style="grid-column:1/3;"><label>Overall result values (one per line)</label>
                        <textarea rows="2" @bind="_editing.AllowedResultValues" placeholder="Compatible&#10;Incompatible"></textarea>
                    </div>
                }
                <div class="field" style="grid-column:1/-1;">
                    <div class="flex-between" style="margin-bottom:.4rem;">
                        <label style="margin:0;"><strong>@( _editing.ResultValueType is ResultValueType.Crossmatch or ResultValueType.ComplexCrossmatch ? "Cell reaction subtests" : "Panel subtests" )</strong> (from subtest catalog)</label>
                        <div class="flex gap">
                            <button type="button" class="btn btn-ghost btn-sm" @onclick="LoadDefaultAboRhSubtests">Load ABORH defaults</button>
                            <button type="button" class="btn btn-ghost btn-sm" @onclick="LoadDefaultAboRhRetypeSubtests">Load ABORH retype defaults</button>
                            <button type="button" class="btn btn-ghost btn-sm" @onclick="ApplyPhasesToAll">Apply first-row phases to all</button>
                            <button type="button" class="btn btn-ghost btn-sm" @onclick="AddSubtest">Add subtest</button>
                        </div>
                    </div>
                    @if (_editing.PanelSubtestAssignments.Count == 0)
                    {
                        <div class="muted">No subtests assigned. Add rows or load defaults before activating a panel test.</div>
                    }
                    else
                    {
                        <div class="table-scroll">
                        <table class="bb">
                            <thead><tr><th>Subtest</th><th>Type</th><th>Required</th><th>Phases</th><th>Order</th><th></th></tr></thead>
                            <tbody>
                                @for (var i = 0; i < _editing.PanelSubtestAssignments.Count; i++)
                                {
                                    var row = _editing.PanelSubtestAssignments[i];
                                    var rowIndex = i;
                                    var catalog = _catalogSubtests.FirstOrDefault(s => string.Equals(s.Code, row.SubtestCode, StringComparison.OrdinalIgnoreCase));
                                    <tr>
                                        <td>
                                            <select @bind="row.SubtestCode">
                                                <option value="">— select —</option>
                                                @foreach (var s in _catalogSubtests) { <option value="@s.Code">@s.Code — @s.Name</option> }
                                            </select>
                                        </td>
                                        <td class="muted">@(catalog?.ResultType.ToString() ?? "—")</td>
                                        <td><input type="checkbox" @bind="row.Required" /></td>
                                        <td>
                                            @if (_catalogPhases.Count == 0)
                                            {
                                                <span class="muted">No phases</span>
                                            }
                                            else
                                            {
                                                <div class="flex" style="flex-wrap:wrap;gap:.35rem;">
                                                    @foreach (var phase in _catalogPhases)
                                                    {
                                                        var selected = row.PhaseCodes.Contains(phase.Code, StringComparer.OrdinalIgnoreCase);
                                                        <label class="flex" style="gap:.2rem;font-size:.85rem;">
                                                            <input type="checkbox" checked="@selected" @onchange="e => OnPhaseToggled(row, phase.Code, (bool)(e.Value ?? false))" />
                                                            @phase.Code
                                                            @if (phase.IsCheckCell)
                                                            {
                                                                <span class="muted">(CC)</span>
                                                            }
                                                        </label>
                                                    }
                                                </div>
                                            }
                                        </td>
                                        <td><input type="number" style="width:4rem;" @bind="row.SortOrder" /></td>
                                        <td><button type="button" class="btn btn-ghost btn-sm" @onclick="() => RemoveSubtest(rowIndex)">Remove</button></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        </div>
                    }
                </div>

                @if (_editing.ResultValueType is ResultValueType.AboRh or ResultValueType.Subtest)
                {
                    <div class="field" style="grid-column:1/-1;">
                        <div class="flex-between" style="margin-bottom:.4rem;">
                            <label style="margin:0;"><strong>Interpretation logic</strong> (expected subtest reactions per interpretation)</label>
                            <div class="flex gap">
                                @if (_editing.ResultValueType == ResultValueType.AboRh)
                                {
                                    <button type="button" class="btn btn-ghost btn-sm" @onclick="LoadDefaultAboRhLogic">Load standard ABO/Rh logic</button>
                                    <button type="button" class="btn btn-ghost btn-sm" @onclick="LoadDefaultAboRhRetypeLogic">Load ABORH retype logic</button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-ghost btn-sm" @onclick="AddLogicRow">Add interpretation row</button>
                                }
                            </div>
                        </div>
                        @if (_editing.InterpretationLogic.Count == 0)
                        {
                            <div class="muted">No logic rows. @( _editing.ResultValueType == ResultValueType.AboRh ? "Load standard logic or add rows manually." : "Add rows to define interpretations and expected subtest reactions.")</div>
                        }
                        else if (LogicTableColumns.Any())
                        {
                            <div class="table-scroll">
                            <table class="bb">
                                <thead>
                                    @if (LogicColumnGroups.Any(g => g.Phases.Count > 0))
                                    {
                                        <tr>
                                            <th rowspan="2">Interpretation</th>
                                            <th rowspan="2">Match</th>
                                            @foreach (var group in LogicColumnGroups)
                                            {
                                                <th colspan="@(group.Phases.Count == 0 ? 1 : group.Phases.Count)" class="mono">@group.SubtestCode</th>
                                            }
                                            @if (_editing.ResultValueType == ResultValueType.Subtest)
                                            {
                                                <th rowspan="2"></th>
                                            }
                                        </tr>
                                        <tr>
                                            @foreach (var col in LogicTableColumns)
                                            {
                                                <th class="mono">@(string.IsNullOrEmpty(col.PhaseCode) ? "—" : col.PhaseCode)</th>
                                            }
                                        </tr>
                                    }
                                    else
                                    {
                                        <tr>
                                            <th>Interpretation</th>
                                            <th>Match</th>
                                            @foreach (var col in LogicTableColumns)
                                            {
                                                <th class="mono">@col.Header</th>
                                            }
                                            @if (_editing.ResultValueType == ResultValueType.Subtest)
                                            {
                                                <th></th>
                                            }
                                        </tr>
                                    }
                                </thead>
                                <tbody>
                                    @for (var ri = 0; ri < _editing.InterpretationLogic.Count; ri++)
                                    {
                                        var row = _editing.InterpretationLogic[ri];
                                        var logicIndex = ri;
                                        <tr>
                                            <td>
                                                @if (_editing.ResultValueType == ResultValueType.AboRh)
                                                {
                                                    @row.Label <span class="mono muted">@row.InterpretationKey</span>
                                                }
                                                else
                                                {
                                                    <input @bind="row.Label" placeholder="Label" style="margin-bottom:.25rem;" />
                                                    <input @bind="row.InterpretationKey" placeholder="Key" class="mono" />
                                                }
                                            </td>
                                            <td>
                                                <select @bind="row.MatchMode">
                                                    @foreach (var mode in Enum.GetValues<InterpretationMatchMode>())
                                                    {
                                                        <option value="@mode">@Ui.EnumText(mode)</option>
                                                    }
                                                </select>
                                            </td>
                                            @foreach (var col in LogicTableColumns)
                                            {
                                                <td>
                                                    <select value="@GetLogicExpectation(row, col.Key)" @onchange="e => SetLogicExpectation(row, col.Key, e)">
                                                        <option value="">—</option>
                                                        <option value="@ReactionPolarity.Negative">Neg</option>
                                                        <option value="@ReactionPolarity.Positive">Pos</option>
                                                    </select>
                                                </td>
                                            }
                                            @if (_editing.ResultValueType == ResultValueType.Subtest)
                                            {
                                                <td><button type="button" class="btn btn-ghost btn-sm" @onclick="() => RemoveLogicRow(logicIndex)">Remove</button></td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            </div>
                        }
                        else
                        {
                            <div class="muted">Assign subtests above before configuring interpretation logic.</div>
                        }
                    </div>
                }
            }
            else
            {
            <div class="field" style="grid-column:1/3;"><label>Allowed result values (one per line)</label>
                <textarea rows="3" @bind="_editing.AllowedResultValues"></textarea>
            </div>
            }
            <div class="field" data-test-specimen-types><label>Preferred specimen type</label>
                <select value="@(AcceptedSpecimenTypes.Preferred(_editing.RequiredSpecimenType) ?? "")" @onchange="e => SetPreferredSpecimenType(e.Value?.ToString())">
                    <option value="">— Any —</option>
                    @foreach (var t in _catalogSpecimenTypes)
                    {
                        <option value="@t.Code">@t.Code — @t.Description</option>
                    }
                </select>
                @if (AcceptedSpecimenTypes.Preferred(_editing.RequiredSpecimenType) is { } preferredType)
                {
                    <div style="margin-top:.35rem;font-size:.9rem;">
                        <span class="muted">Also accepted:</span>
                        @foreach (var t in _catalogSpecimenTypes.Where(t => !string.Equals(t.Code, preferredType, StringComparison.OrdinalIgnoreCase)))
                        {
                            <label style="margin-right:.6rem;white-space:nowrap;">
                                <input type="checkbox" checked="@AcceptedSpecimenTypes.Parse(_editing.RequiredSpecimenType).Contains(t.Code.ToUpperInvariant())"
                                       @onchange="e => ToggleAcceptedSpecimenType(t.Code, e.Value is true)" data-accept-type="@t.Code" /> @t.Code
                            </label>
                        }
                    </div>
                }
                <p class="muted" style="margin:.25rem 0 0;font-size:.85rem;">The preferred type prefills accession. Result entry is blocked unless the specimen is the preferred type or one also accepted.</p>
            </div>
            <div class="field"><label>Testing method</label><input @bind="_editing.TestingMethod" /></div>
            <div class="field"><label>Performing department</label><input @bind="_editing.PerformingDepartment" /></div>
            <div class="field"><label>Sort order</label><input type="number" @bind="_editing.SortOrder" /></div>
            <div class="field"><label>Charge code mapping</label><input @bind="_editing.ChargeCodeMapping" /></div>
        </div>

        <div class="flex gap" style="flex-wrap:wrap;margin:.6rem 0;">
            <label class="flex" style="gap:.35rem;"><input type="checkbox" @bind="_editing.Billable" /> Billable</label>
            <label class="flex" style="gap:.35rem;"><input type="checkbox" @bind="_editing.VerificationRequired" /> Verification required</label>
            <label class="flex" style="gap:.35rem;"><input type="checkbox" @bind="_editing.ContributesToAboRhHistory" /> ABO/Rh history</label>
            <label class="flex" style="gap:.35rem;"><input type="checkbox" @bind="_editing.ContributesToAntibodyHistory" /> Antibody history</label>
            <label class="flex" style="gap:.35rem;"><input type="checkbox" @bind="_editing.ContributesToCompatibility" /> Compatibility</label>
            <label class="flex" style="gap:.35rem;"><input type="checkbox" @bind="_editing.ContributesToUnitBloodAttributes" /> Unit blood attributes</label>
        </div>

        <div class="field"><label>Change reason @(EditingActive ? "(required)" : "(optional)")</label>
            <input @bind="_changeReason" placeholder="Why is this change being made?" />
        </div>

        <div class="flex gap" style="margin-top:.6rem;">
            <button class="btn btn-primary" disabled="@(_busy || !CanManage)" @onclick="SaveAsync">Save</button>
            @if (!CanManage)
            {
                <span class="muted">View only. Saving needs the manage permission for this catalog.</span>
            }
            @if (_editId is not null && CanActivate)
            {
                @if (!_currentIsActive)
                {
                    <button class="btn btn-secondary" disabled="@_busy" @onclick="ActivateAsync">Activate</button>
                }
                else
                {
                    <button class="btn btn-secondary" disabled="@_busy" @onclick="DeactivateAsync">Deactivate</button>
                }
            }
            @if (_editId is not null && CanManage)
            {
                <button class="btn btn-ghost" disabled="@(_busy || !CanManage)" @onclick="CloneAsync">Clone</button>
            }
            <button class="btn btn-ghost" @onclick="() => _editing = null">Cancel</button>
        </div>
    </div>
}

@if (_history is not null)
{
    <ConfigHistoryPanel Title="@($"History: {_historyTitle}")" Rows="_history" OnClose="() => _history = null" />
}

@code {
    private List<TestDefinitionDto> _items = new();
    private List<SubtestListItemDto> _catalogSubtests = new();
    private List<PhaseListItemDto> _catalogPhases = new();
    private List<BloodAttributeListItemDto> _catalogBloodAttributes = new();
    private List<SpecimenTypeListItemDto> _catalogSpecimenTypes = new();

    // The stored list keeps the preferred type first, then the others in catalog order.
    private void SetPreferredSpecimenType(string? code)
    {
        if (_editing is null) return;
        if (string.IsNullOrWhiteSpace(code))
        {
            _editing.RequiredSpecimenType = null;
            return;
        }

        var others = AcceptedSpecimenTypes.Parse(_editing.RequiredSpecimenType).Skip(1)
            .Where(c => !string.Equals(c, code, StringComparison.OrdinalIgnoreCase));
        _editing.RequiredSpecimenType = AcceptedSpecimenTypes.Normalize(string.Join(",", new[] { code }.Concat(others)));
    }

    private void ToggleAcceptedSpecimenType(string code, bool accepted)
    {
        if (_editing is null) return;
        var current = AcceptedSpecimenTypes.Parse(_editing.RequiredSpecimenType).ToList();
        if (current.Count == 0) return;
        var preferred = current[0];
        var others = current.Skip(1).Where(c => !string.Equals(c, code, StringComparison.OrdinalIgnoreCase)).ToList();
        if (accepted) others.Add(code.ToUpperInvariant());
        var ordered = _catalogSpecimenTypes.Select(t => t.Code.ToUpperInvariant()).Where(others.Contains);
        _editing.RequiredSpecimenType = AcceptedSpecimenTypes.Normalize(string.Join(",", new[] { preferred }.Concat(ordered)));
    }
    private bool _loading = true;
    private bool _includeInactive = true;
    private string _filter = string.Empty;
    private Feedback? _feedback;
    private bool _busy;

    private EditModel? _editing;
    private long? _editId;
    private bool _currentIsActive;
    private string? _changeReason;

    private List<ConfigHistoryDto>? _history;
    private string _historyTitle = string.Empty;

    private bool CanManage => Session.Has(PermissionCodes.AdminTestsManage);
    private bool CanActivate => Session.Has(PermissionCodes.AdminConfigActivate);
    private bool EditingActive => _currentIsActive;

    private List<TestDefinitionDto> Filtered => string.IsNullOrWhiteSpace(_filter)
        ? _items
        : _items.Where(t => t.Code.Contains(_filter, StringComparison.OrdinalIgnoreCase)
            || t.Name.Contains(_filter, StringComparison.OrdinalIgnoreCase)
            || t.NameLabel.Contains(_filter, StringComparison.OrdinalIgnoreCase)).ToList();

    private IEnumerable<string> GradedAssignmentCodes =>
        _editing?.PanelSubtestAssignments
            .Select(a => a.SubtestCode)
            .Where(c => !string.IsNullOrWhiteSpace(c))
            .Where(c => _catalogSubtests.FirstOrDefault(s => string.Equals(s.Code, c, StringComparison.OrdinalIgnoreCase))?.ResultType == SubtestResultType.GradedReaction)
            .Distinct(StringComparer.OrdinalIgnoreCase)
        ?? Enumerable.Empty<string>();

    private IEnumerable<string> AssignedSubtestCodes =>
        _editing?.PanelSubtestAssignments
            .Select(a => a.SubtestCode)
            .Where(c => !string.IsNullOrWhiteSpace(c))
            .Distinct(StringComparer.OrdinalIgnoreCase)
        ?? Enumerable.Empty<string>();

    private IReadOnlyList<LogicColumn> LogicTableColumns
    {
        get
        {
            if (_editing is null)
            {
                return Array.Empty<LogicColumn>();
            }

            var columns = new List<LogicColumn>();
            foreach (var assignment in _editing.PanelSubtestAssignments.Where(a => !string.IsNullOrWhiteSpace(a.SubtestCode)))
            {
                if (_editing.ResultValueType == ResultValueType.AboRh
                    && !GradedAssignmentCodes.Contains(assignment.SubtestCode, StringComparer.OrdinalIgnoreCase))
                {
                    continue;
                }

                var interpretive = assignment.PhaseCodes
                    .Where(code =>
                    {
                        var phase = _catalogPhases.FirstOrDefault(p =>
                            string.Equals(p.Code, code, StringComparison.OrdinalIgnoreCase));
                        return phase is null || (phase.IncludeInInterpretation && !phase.IsCheckCell);
                    })
                    .ToList();

                if (interpretive.Count == 0)
                {
                    columns.Add(new LogicColumn(assignment.SubtestCode, assignment.SubtestCode, string.Empty, assignment.SubtestCode));
                    continue;
                }

                foreach (var phaseCode in interpretive)
                {
                    columns.Add(new LogicColumn(
                        PhaseResultKeys.Compose(assignment.SubtestCode, phaseCode),
                        assignment.SubtestCode,
                        phaseCode,
                        $"{assignment.SubtestCode} {phaseCode}"));
                }
            }

            return columns;
        }
    }

    private IReadOnlyList<LogicColumnGroup> LogicColumnGroups =>
        LogicTableColumns
            .GroupBy(c => c.SubtestCode, StringComparer.OrdinalIgnoreCase)
            .Select(g => new LogicColumnGroup(g.Key, g.Select(c => c.PhaseCode).ToList()))
            .ToList();

    private static string DisplayValueType(ResultValueType valueType) =>
        valueType switch
        {
            ResultValueType.Subtest => "Subtest",
            ResultValueType.BloodAttribute => "Blood attribute",
            ResultValueType.Crossmatch => "Crossmatch",
            ResultValueType.ComplexCrossmatch => "Complex crossmatch",
            _ => valueType.ToString()
        };

    private void ToggleBloodAttrScope(string code, bool selected)
    {
        if (_editing is null) return;
        // Blood-attribute codes are case-sensitive (Rh C vs c).
        if (selected && !_editing.BloodAttributeScopeCodes.Contains(code, StringComparer.Ordinal))
        {
            _editing.BloodAttributeScopeCodes.Add(code);
        }
        else if (!selected)
        {
            _editing.BloodAttributeScopeCodes.RemoveAll(c => string.Equals(c, code, StringComparison.Ordinal));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var subtests = await Api.GetReferenceSubtestsAsync();
        _catalogSubtests = subtests.Value ?? new();
        var phases = await Api.GetReferencePhasesAsync();
        _catalogPhases = phases.Value ?? new();
        var bloodAttrs = await Api.GetReferenceBloodAttributesAsync();
        _catalogBloodAttributes = bloodAttrs.Value ?? new();
        var specimenTypes = await Api.GetReferenceSpecimenTypesAsync();
        _catalogSpecimenTypes = specimenTypes.Value ?? new();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        var r = await Api.GetAdminTestsAsync(_includeInactive);
        _items = r.Value ?? new();
        if (!r.Succeeded) _feedback = r.ToFeedback();
        _loading = false;
    }

    private void NewDraft()
    {
        _editId = null;
        _currentIsActive = false;
        _changeReason = null;
        _editing = new EditModel { VerificationRequired = true };
        _feedback = null;
    }

    private async Task EditAsync(long id)
    {
        var r = await Api.GetAdminTestAsync(id);
        if (!r.Succeeded || r.Value is null) { _feedback = r.ToFeedback(); return; }
        var t = r.Value;
        _editId = t.Id;
        _currentIsActive = t.IsActive;
        _changeReason = null;
        _editing = EditModel.From(t);
        _feedback = null;
    }

    private async Task SaveAsync()
    {
        if (_editing is null) return;
        _editing.PruneUnassignedLogicExpectations();
        _busy = true;
        var req = _editing.ToRequest(_changeReason);
        var r = _editId is null
            ? await Api.CreateAdminTestAsync(req)
            : await Api.UpdateAdminTestAsync(_editId.Value, req);
        _busy = false;
        _feedback = r.ToFeedback(_editId is null ? "Draft created." : "Saved.");
        if (r.Succeeded)
        {
            _editId = r.Value!.Id;
            _currentIsActive = r.Value.IsActive;
            await LoadAsync();
        }
    }

    private async Task ActivateAsync()
    {
        if (_editId is null) return;
        _busy = true;
        var r = await Api.ActivateAdminTestAsync(_editId.Value, _changeReason);
        _busy = false;
        _feedback = r.ToFeedback("Activated.");
        if (r.Succeeded) { _currentIsActive = true; await LoadAsync(); }
    }

    private async Task DeactivateAsync()
    {
        if (_editId is null) return;
        _busy = true;
        var r = await Api.DeactivateAdminTestAsync(_editId.Value, _changeReason);
        _busy = false;
        _feedback = r.ToFeedback("Deactivated.");
        if (r.Succeeded) { _currentIsActive = false; await LoadAsync(); }
    }

    private async Task CloneAsync()
    {
        if (_editId is null || _editing is null) return;
        _busy = true;
        var r = await Api.CloneAdminTestAsync(_editId.Value, _editing.Code + "-COPY");
        _busy = false;
        _feedback = r.ToFeedback("Cloned to a new draft.");
        if (r.Succeeded) { await LoadAsync(); await EditAsync(r.Value!.Id); }
    }

    private async Task ShowHistoryAsync(long id)
    {
        var r = await Api.GetConfigHistoryAsync(nameof(BloodBankLIS.Domain.Entities.Configuration.TestDefinition), id);
        if (!r.Succeeded)
        {
            _feedback = r.ToFeedback();
            _history = null;
            return;
        }

        _history = r.Value ?? new();
        _historyTitle = _items.FirstOrDefault(t => t.Id == id)?.Code ?? id.ToString();
    }

    private static RenderFragment StatusBadge(TestDefinitionDto t) => builder =>
    {
        var (cls, text) = t.IsActive ? ("badge-green", "Active") : t.IsDraft ? ("badge-gray", "Draft") : ("badge-amber", "Inactive");
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", $"badge {cls}");
        builder.AddContent(2, text);
        builder.CloseElement();
    };

    private void OnResultValueTypeChanged()
    {
        if (_editing is null) return;
        if (EditModel.UsesPanelSubtests(_editing.ResultValueType) && _editing.PanelSubtestAssignments.Count == 0
            && _editing.ResultValueType == ResultValueType.AboRh)
        {
            LoadDefaultAboRhSubtests();
        }
    }

    private void AddSubtest()
    {
        if (_editing is null) return;
        var next = _editing.PanelSubtestAssignments.Count + 1;
        _editing.PanelSubtestAssignments.Add(new AssignmentRow { SortOrder = next });
    }

    private void RemoveSubtest(int index)
    {
        if (_editing is null || index < 0 || index >= _editing.PanelSubtestAssignments.Count) return;
        _editing.PanelSubtestAssignments.RemoveAt(index);
        _editing.PruneUnassignedLogicExpectations();
    }

    private void OnPhaseToggled(AssignmentRow row, string phaseCode, bool selected)
    {
        TogglePhase(row, phaseCode, selected);
        _editing?.PruneUnassignedLogicExpectations();
    }

    private static void TogglePhase(AssignmentRow row, string phaseCode, bool selected)
    {
        if (selected)
        {
            if (!row.PhaseCodes.Contains(phaseCode, StringComparer.OrdinalIgnoreCase))
            {
                row.PhaseCodes.Add(phaseCode);
            }
        }
        else
        {
            row.PhaseCodes.RemoveAll(c => string.Equals(c, phaseCode, StringComparison.OrdinalIgnoreCase));
        }
    }

    private void ApplyPhasesToAll()
    {
        if (_editing is null || _editing.PanelSubtestAssignments.Count == 0) return;
        var source = _editing.PanelSubtestAssignments[0].PhaseCodes.ToList();
        foreach (var row in _editing.PanelSubtestAssignments)
        {
            row.PhaseCodes = source.ToList();
        }
        _editing.PruneUnassignedLogicExpectations();
    }

    private void LoadDefaultAboRhSubtests()
    {
        if (_editing is null) return;
        _editing.PanelSubtestAssignments = PanelSubtestDefinitions.DefaultAboRh()
            .Select(s => new AssignmentRow
            {
                SubtestCode = s.Code,
                Required = s.Required,
                SortOrder = s.SortOrder
            }).ToList();
    }

    private void LoadDefaultAboRhLogic()
    {
        if (_editing is null) return;
        _editing.InterpretationLogic = InterpretationLogicDefinitions.DefaultAboRhLogic()
            .Select(r => new LogicRow
            {
                InterpretationKey = r.InterpretationKey,
                Label = r.Label,
                Expectations = new Dictionary<string, ReactionPolarity>(r.SubtestExpectations, StringComparer.OrdinalIgnoreCase)
            }).ToList();
    }

    private void LoadDefaultAboRhRetypeSubtests()
    {
        if (_editing is null) return;
        _editing.PanelSubtestAssignments = PanelSubtestDefinitions.DefaultAboRhRetype()
            .Select(s => new AssignmentRow
            {
                SubtestCode = s.Code,
                Required = s.Required,
                SortOrder = s.SortOrder
            }).ToList();
    }

    private void LoadDefaultAboRhRetypeLogic()
    {
        if (_editing is null) return;
        _editing.InterpretationLogic = InterpretationLogicDefinitions.DefaultAboRhRetypeLogic()
            .Select(r => new LogicRow
            {
                InterpretationKey = r.InterpretationKey,
                Label = r.Label,
                Expectations = new Dictionary<string, ReactionPolarity>(r.SubtestExpectations, StringComparer.OrdinalIgnoreCase)
            }).ToList();
    }

    private void AddLogicRow()
    {
        if (_editing is null) return;
        var index = _editing.InterpretationLogic.Count + 1;
        _editing.InterpretationLogic.Add(new LogicRow
        {
            InterpretationKey = $"INTERP{index}",
            Label = $"Interpretation {index}"
        });
    }

    private void RemoveLogicRow(int index)
    {
        if (_editing is null || index < 0 || index >= _editing.InterpretationLogic.Count) return;
        _editing.InterpretationLogic.RemoveAt(index);
    }

    private static string GetLogicExpectation(LogicRow row, string code) =>
        row.Expectations.TryGetValue(code, out var p) ? p.ToString() : string.Empty;

    private static void SetLogicExpectation(LogicRow row, string code, ChangeEventArgs e)
    {
        if (string.IsNullOrWhiteSpace(e.Value?.ToString()))
        {
            row.Expectations.Remove(code);
            return;
        }

        if (Enum.TryParse<ReactionPolarity>(e.Value?.ToString(), out var polarity))
        {
            row.Expectations[code] = polarity;
        }
    }

    private sealed class AssignmentRow
    {
        public string SubtestCode { get; set; } = string.Empty;
        public bool Required { get; set; }
        public int SortOrder { get; set; }
        public List<string> PhaseCodes { get; set; } = new();
    }

    private sealed class LogicRow
    {
        public string InterpretationKey { get; set; } = string.Empty;
        public string Label { get; set; } = string.Empty;
        public InterpretationMatchMode MatchMode { get; set; } = InterpretationMatchMode.AllMatch;
        public Dictionary<string, ReactionPolarity> Expectations { get; set; } = new(StringComparer.OrdinalIgnoreCase);
    }

    private sealed record LogicColumn(string Key, string SubtestCode, string PhaseCode, string Header);

    private sealed record LogicColumnGroup(string SubtestCode, IReadOnlyList<string> Phases);

    private sealed class EditModel
    {
        public string Code { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public TestCategory Category { get; set; } = TestCategory.Other;
        public ResultValueType ResultValueType { get; set; } = ResultValueType.Coded;
        public string? AllowedResultValues { get; set; }
        public List<AssignmentRow> PanelSubtestAssignments { get; set; } = new();
        public List<LogicRow> InterpretationLogic { get; set; } = new();

        public static bool UsesPanelSubtests(ResultValueType valueType) =>
            valueType is ResultValueType.AboRh
                or ResultValueType.Subtest
                or ResultValueType.Crossmatch
                or ResultValueType.ComplexCrossmatch;
        public string? RequiredSpecimenType { get; set; }
        public string? TestingMethod { get; set; }
        public string? PerformingDepartment { get; set; }
        public int SortOrder { get; set; }
        public bool Billable { get; set; }
        public string? ChargeCodeMapping { get; set; }
        public bool VerificationRequired { get; set; } = true;
        public bool ContributesToAboRhHistory { get; set; }
        public bool ContributesToAntibodyHistory { get; set; }
        public bool ContributesToCompatibility { get; set; }
        public List<string> BloodAttributeScopeCodes { get; set; } = new();
        public BloodAttributeKind BloodAttributeScopeKind { get; set; } = BloodAttributeKind.Antigen;
        public bool ContributesToUnitBloodAttributes { get; set; }
        public ShapeModel Shape { get; set; } = new();
        public string? LoincCode { get; set; }

        public static EditModel From(TestDefinitionDto t) => new()
        {
            Code = t.Code, Name = t.Name, Category = t.Category, ResultValueType = t.ResultValueType,
            AllowedResultValues = t.AllowedResultValues,
            PanelSubtestAssignments = t.PanelSubtestAssignments.Select(s => new AssignmentRow
            {
                SubtestCode = s.SubtestCode,
                Required = s.Required,
                SortOrder = s.SortOrder,
                PhaseCodes = (s.PhaseCodes ?? Array.Empty<string>()).ToList()
            }).ToList(),
            InterpretationLogic = t.InterpretationLogic.Select(r => new LogicRow
            {
                InterpretationKey = r.InterpretationKey,
                Label = r.Label,
                MatchMode = r.MatchMode,
                Expectations = new Dictionary<string, ReactionPolarity>(r.SubtestExpectations, StringComparer.OrdinalIgnoreCase)
            }).ToList(),
            RequiredSpecimenType = t.RequiredSpecimenType,
            TestingMethod = t.TestingMethod, PerformingDepartment = t.PerformingDepartment, SortOrder = t.SortOrder,
            Billable = t.Billable, ChargeCodeMapping = t.ChargeCodeMapping, VerificationRequired = t.VerificationRequired,
            ContributesToAboRhHistory = t.ContributesToAboRhHistory, ContributesToAntibodyHistory = t.ContributesToAntibodyHistory,
            ContributesToCompatibility = t.ContributesToCompatibility,
            BloodAttributeScopeCodes = t.BloodAttributeScopeCodes.ToList(),
            BloodAttributeScopeKind = t.BloodAttributeScopeKind ?? BloodAttributeKind.Antigen,
            ContributesToUnitBloodAttributes = t.ContributesToUnitBloodAttributes,
            Shape = ShapeModel.From(t.ResultShape),
            LoincCode = t.LoincCode
        };

        public void PruneUnassignedLogicExpectations()
        {
            var assignments = PanelSubtestAssignments
                .Select(s => new PanelSubtestAssignment(s.SubtestCode, s.Required, s.SortOrder, s.PhaseCodes))
                .ToList();
            var pruned = InterpretationLogicDefinitions.DropUnassignedPhaseExpectations(
                InterpretationLogic.Select(r => new InterpretationLogicRow(
                    r.InterpretationKey, r.Label, r.Expectations, r.MatchMode)).ToList(),
                assignments);
            for (var i = 0; i < InterpretationLogic.Count && i < pruned.Count; i++)
            {
                InterpretationLogic[i].Expectations = new Dictionary<string, ReactionPolarity>(
                    pruned[i].SubtestExpectations, StringComparer.OrdinalIgnoreCase);
            }
        }

        public SaveTestDefinitionRequest ToRequest(string? reason)
        {
            PruneUnassignedLogicExpectations();
            return new(
            Code, Name, Category, ResultValueType, AllowedResultValues,
            PanelSubtestAssignments.Select(s => new PanelSubtestAssignmentDto(s.SubtestCode, s.Required, s.SortOrder, s.PhaseCodes)).ToList(),
            InterpretationLogic.Select(r => new InterpretationLogicRowDto(
                r.InterpretationKey, r.Label, r.Expectations, r.MatchMode)).ToList(),
            RequiredSpecimenType, TestingMethod, PerformingDepartment, SortOrder, Billable, ChargeCodeMapping,
            VerificationRequired, ContributesToAboRhHistory, ContributesToAntibodyHistory, ContributesToCompatibility,
            BloodAttributeScopeCodes,
            ResultValueType == ResultValueType.BloodAttribute ? BloodAttributeScopeKind : null,
            ContributesToUnitBloodAttributes, reason, Shape.ToDto(), LoincCode);
        }
    }

    /// <summary>Numeric and titer settings as the form edits them.</summary>
    private sealed class ShapeModel
    {
        public string? ResultUnits { get; set; }
        public int? DecimalPlaces { get; set; }
        public decimal? ReportableLow { get; set; }
        public decimal? ReportableHigh { get; set; }
        public decimal? ReferenceLow { get; set; }
        public decimal? ReferenceHigh { get; set; }
        public decimal? CriticalLow { get; set; }
        public decimal? CriticalHigh { get; set; }
        public int? TiterStartDilution { get; set; }
        public int? TiterEndDilution { get; set; }
        public string? TiterPhaseCode { get; set; }
        public string? TiterEndpointMinGrade { get; set; }
        public bool TiterScored { get; set; }

        public static ShapeModel From(TestResultShapeDto? s) => s is null ? new() : new()
        {
            ResultUnits = s.ResultUnits, DecimalPlaces = s.DecimalPlaces,
            ReportableLow = s.ReportableLow, ReportableHigh = s.ReportableHigh,
            ReferenceLow = s.ReferenceLow, ReferenceHigh = s.ReferenceHigh,
            CriticalLow = s.CriticalLow, CriticalHigh = s.CriticalHigh,
            TiterStartDilution = s.TiterStartDilution, TiterEndDilution = s.TiterEndDilution,
            TiterPhaseCode = s.TiterPhaseCode, TiterEndpointMinGrade = s.TiterEndpointMinGrade, TiterScored = s.TiterScored
        };

        public TestResultShapeDto ToDto() => new(
            ResultUnits, DecimalPlaces, ReportableLow, ReportableHigh, ReferenceLow, ReferenceHigh, CriticalLow, CriticalHigh,
            TiterStartDilution, TiterEndDilution, TiterPhaseCode, TiterEndpointMinGrade, TiterScored);
    }
