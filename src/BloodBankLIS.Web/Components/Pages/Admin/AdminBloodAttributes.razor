@page "/admin/blood-attributes"
@using BloodBankLIS.Application.Admin
@inject UserSession Session
@inject BloodBankApiClient Api

<PageTitle>Blood Attributes &middot; Admin</PageTitle>

<div class="flex-between">
    <h1>Blood Attributes</h1>
    @if (CanEdit)
    {
        <button class="btn btn-primary" @onclick="NewDraft">New attribute</button>
    }
</div>
<p class="muted">Antigen catalog with paired antibody names. Clinically significant attributes drive compatibility rules for patients and units.</p>

<Outcome Value="_feedback" />

<div class="bb-card" style="margin-top:1rem;">
    <div class="flex gap" style="margin-bottom:.6rem;">
        <input style="flex:1;" placeholder="Filter by code or name" @bind="_filter" @bind:event="oninput" />
        <label class="flex" style="gap:.35rem;"><input type="checkbox" @bind="_includeInactive" @bind:after="LoadAsync" /> Include inactive</label>
    </div>

    @if (_loading)
    {
        <div class="loading">Loading...</div>
    }
    else if (!Filtered.Any())
    {
        <div class="empty">No blood attribute definitions.</div>
    }
    else
    {
        <table class="bb">
            <thead><tr><th>Code</th><th>Name</th><th>Antibody</th><th>Significant</th><th>Sort</th><th>Ver</th><th>Status</th><th></th></tr></thead>
            <tbody>
                @foreach (var d in Filtered)
                {
                    <tr>
                        <td class="mono">@d.Code</td>
                        <td>@d.Name</td>
                        <td>@d.AntibodyName</td>
                        <td>@(d.IsClinicallySignificant ? "Yes" : "No")</td>
                        <td>@d.SortOrder</td>
                        <td>@d.Version</td>
                        <td>@StatusBadge(d)</td>
                        <td class="right nowrap">
                            <button class="btn btn-ghost btn-sm" @onclick="() => EditAsync(d.Id)">Edit</button>
                            <button class="btn btn-ghost btn-sm" @onclick="() => ShowHistoryAsync(d.Id)">History</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@if (_editing is not null)
{
    <div class="bb-card" style="margin-top:1rem;">
        <h2>@(_editId is null ? "New blood attribute" : $"Edit: {_editing.Code}")</h2>
        <div class="form-row">
            <div class="field"><label>Antigen code</label><input class="mono" @bind="_editing.Code" disabled="@(_editId is not null)" /></div>
            <div class="field"><label>Name</label><input @bind="_editing.Name" /></div>
            <div class="field"><label>Antibody name</label><input @bind="_editing.AntibodyName" /></div>
            <div class="field"><label>Sort order</label><input type="number" @bind="_editing.SortOrder" /></div>
        </div>
        <label class="flex" style="gap:.35rem;margin-top:.5rem;">
            <input type="checkbox" @bind="_editing.IsClinicallySignificant" /> Clinically significant (enforces compatibility)
        </label>
        <div class="field" style="margin-top:.6rem;"><label>Change reason @(EditingActive ? "(required)" : "(optional)")</label>
            <input @bind="_changeReason" placeholder="Why is this change being made?" />
        </div>
        <div class="flex gap" style="margin-top:.6rem;">
            @if (CanEdit)
            {
                <button class="btn btn-primary" disabled="@_busy" @onclick="SaveAsync">Save</button>
                @if (_editId is not null && !_editing.IsActive && CanActivate)
                {
                    <button class="btn btn-secondary" disabled="@_busy" @onclick="ActivateAsync">Activate</button>
                }
                @if (_editId is not null && _editing.IsActive && CanActivate)
                {
                    <button class="btn btn-secondary" disabled="@_busy" @onclick="DeactivateAsync">Deactivate</button>
                }
            }
            <button class="btn btn-ghost" @onclick="CancelEdit">Cancel</button>
        </div>
    </div>
}

@if (_historyEntityId is not null)
{
    <ConfigHistoryPanel EntityType="BloodAttributeDefinition" EntityId="_historyEntityId.Value" OnClose="() => _historyEntityId = null" />
}

@code {
    private bool CanEdit => Session.Has(PermissionCodes.AdminConfigEdit);
    private bool CanActivate => Session.Has(PermissionCodes.AdminConfigActivate);

    private List<BloodAttributeDefinitionDto> _items = new();
    private string _filter = string.Empty;
    private bool _includeInactive = true;
    private bool _loading = true;
    private bool _busy;
    private Feedback? _feedback;
    private long? _editId;
    private EditModel? _editing;
    private string _changeReason = string.Empty;
    private long? _historyEntityId;

    private bool EditingActive => _editId is not null && _editing?.IsActive == true;

    private IEnumerable<BloodAttributeDefinitionDto> Filtered =>
        string.IsNullOrWhiteSpace(_filter)
            ? _items
            : _items.Where(d =>
                d.Code.Contains(_filter, StringComparison.OrdinalIgnoreCase)
                || d.Name.Contains(_filter, StringComparison.OrdinalIgnoreCase)
                || d.AntibodyName.Contains(_filter, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _items = (await Api.GetAdminBloodAttributesAsync(_includeInactive)).Value ?? new();
        _loading = false;
    }

    private void NewDraft()
    {
        _editId = null;
        _changeReason = string.Empty;
        _editing = new EditModel { SortOrder = (_items.Count + 1) * 10 };
    }

    private async Task EditAsync(long id)
    {
        var r = await Api.GetAdminBloodAttributeAsync(id);
        if (r.Value is null) { _feedback = r.ToFeedback(); return; }
        _editId = id;
        _changeReason = string.Empty;
        _editing = EditModel.From(r.Value);
    }

    private async Task SaveAsync()
    {
        if (_editing is null) return;
        _busy = true;
        var req = _editing.ToRequest(_changeReason);
        var r = _editId is null
            ? await Api.CreateAdminBloodAttributeAsync(req)
            : await Api.UpdateAdminBloodAttributeAsync(_editId.Value, req);
        _busy = false;
        _feedback = r.ToFeedback(_editId is null ? "Blood attribute created." : "Blood attribute saved.");
        if (r.Succeeded && r.Value is not null)
        {
            _editId = r.Value.Id;
            _editing = EditModel.From(r.Value);
            await LoadAsync();
        }
    }

    private async Task ActivateAsync()
    {
        if (_editId is null) return;
        _busy = true;
        var r = await Api.ActivateAdminBloodAttributeAsync(_editId.Value, _changeReason);
        _busy = false;
        _feedback = r.ToFeedback("Blood attribute activated.");
        if (r.Succeeded && r.Value is not null) { _editing = EditModel.From(r.Value); await LoadAsync(); }
    }

    private async Task DeactivateAsync()
    {
        if (_editId is null) return;
        _busy = true;
        var r = await Api.DeactivateAdminBloodAttributeAsync(_editId.Value, _changeReason);
        _busy = false;
        _feedback = r.ToFeedback("Blood attribute deactivated.");
        if (r.Succeeded && r.Value is not null) { _editing = EditModel.From(r.Value); await LoadAsync(); }
    }

    private void CancelEdit() { _editId = null; _editing = null; _changeReason = string.Empty; }
    private void ShowHistoryAsync(long id) => _historyEntityId = id;

    private static string StatusBadge(BloodAttributeDefinitionDto d) =>
        d.IsActive ? "Active" : d.IsDraft ? "Draft" : "Inactive";

    private sealed class EditModel
    {
        public string Code { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string AntibodyName { get; set; } = string.Empty;
        public bool IsClinicallySignificant { get; set; }
        public int SortOrder { get; set; }
        public bool IsActive { get; set; }

        public static EditModel From(BloodAttributeDefinitionDto d) => new()
        {
            Code = d.Code, Name = d.Name, AntibodyName = d.AntibodyName,
            IsClinicallySignificant = d.IsClinicallySignificant, SortOrder = d.SortOrder, IsActive = d.IsActive
        };

        public SaveBloodAttributeDefinitionRequest ToRequest(string? reason) => new(
            Code, Name, AntibodyName, IsClinicallySignificant, SortOrder,
            string.IsNullOrWhiteSpace(reason) ? null : reason);
    }
}
