@page "/utilization"
@inject BloodBankApiClient Api

<PageTitle>Utilization &middot; HemoCore</PageTitle>

<h1>Blood utilization</h1>
<p class="muted">Crossmatch-to-transfusion ratio by ordering location and provider.</p>
<details class="bb-help">
    <summary>How it works</summary>
    <ul>
        <li>A crossmatched unit is one patient and one unit with a compatible crossmatch in the period, by any method. Repeat crossmatches of the same unit for the same patient count once.</li>
        <li>Issued and transfused are counted for that patient and unit whenever they happened. A transfusion counts when it was documented as completed or stopped after it started.</li>
        <li>The location and provider come from the order on the first crossmatch. A crossmatch with no order is listed as "(no order)".</li>
        <li>C:T ratio is crossmatched units divided by transfused units. The page shows the numbers only. Your facility sets any target.</li>
    </ul>
</details>
<Outcome Value="_feedback" />

<div class="bb-card">
    <div class="form-row">
        <div class="field"><label>From (UTC date)</label><input type="date" @bind="_from" /></div>
        <div class="field"><label>To (UTC date)</label><input type="date" @bind="_to" /></div>
    </div>
    <div class="flex gap" style="flex-wrap:wrap;align-items:center;">
        <button class="btn btn-primary btn-sm" disabled="@_busy" @onclick="LoadAsync">Run</button>
        <span class="muted">or</span>
        @foreach (var (label, range) in Presets())
        {
            <button class="btn btn-ghost btn-sm" disabled="@_busy" @onclick="() => RunPresetAsync(range)">@label</button>
        }
    </div>
</div>

@if (_report is not null)
{
    <div class="bb-card">
        <div class="bb-card-title"><h3>@_report.FromUtc.ToString("yyyy-MM-dd") to @_report.ToUtc.ToString("yyyy-MM-dd")</h3></div>
        @if (_report.Total.Crossmatched == 0)
        {
            <div class="muted">No compatible crossmatches in this period.</div>
        }
        else
        {
            <div class="table-scroll">
            <table class="bb">
                <thead>
                    <tr><th>Ordering location</th><th>Provider</th><th class="right">Crossmatched</th><th class="right">Issued</th><th class="right">Transfused</th><th class="right">C:T ratio</th><th class="right">Transfused / crossmatched</th><th class="right">Transfused / issued</th></tr>
                </thead>
                <tbody>
                    @foreach (var row in _report.Rows)
                    {
                        <UtilizationRow Row="row" />
                    }
                </tbody>
                <tfoot>
                    <UtilizationRow Row="_report.Total" Bold="true" />
                </tfoot>
            </table>
            </div>
        }
    </div>
}

<div class="bb-card">
    <div class="bb-card-title"><h3>Orders outside transfusion criteria</h3></div>
    @if (_reviewError is not null)
    {
        <div class="alert alert-danger">The review could not be loaded: @_reviewError</div>
    }
    else if (_review.Count == 0)
    {
        <div class="muted">None in this period. Product orders are only checked when the facility turns on the transfusion-criteria policy and sets up criteria.</div>
    }
    else
    {
        <div class="table-scroll">
        <table class="bb">
            <thead><tr><th>Ordered (UTC)</th><th>Order</th><th>MRN</th><th>Product</th><th>Location</th><th>Provider</th><th>Finding</th><th>Reason given</th></tr></thead>
            <tbody>
                @foreach (var row in _review)
                {
                    <tr>
                        <td class="nowrap">@row.OrderedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="mono">@row.OrderNumber</td>
                        <td class="mono">@row.Mrn</td>
                        <td class="mono">@row.ProductCode</td>
                        <td>@row.OrderingLocation</td>
                        <td>@row.OrderingProvider</td>
                        <td>@row.Detail</td>
                        <td>@(row.Justification ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    }
</div>

@code {
    private List<PbmReviewRowDto> _review = new();
    private UtilizationReportDto? _report;
    private Feedback? _feedback;
    private bool _busy;
    private DateTime _to = DateTime.UtcNow.Date;
    private DateTime _from = DateTime.UtcNow.Date.AddDays(-30);
    private string? _reviewError;

    // Reviews usually cover a calendar period; one click sets the dates and runs.
    private static IEnumerable<(string Label, (DateTime From, DateTime To) Range)> Presets()
    {
        var today = DateTime.UtcNow.Date;
        var monthStart = new DateTime(today.Year, today.Month, 1);
        var quarterStart = new DateTime(today.Year, (today.Month - 1) / 3 * 3 + 1, 1);
        yield return ("Last 30 days", (today.AddDays(-30), today));
        yield return ("This month", (monthStart, today));
        yield return ("Last month", (monthStart.AddMonths(-1), monthStart.AddDays(-1)));
        yield return ("Last quarter", (quarterStart.AddMonths(-3), quarterStart.AddDays(-1)));
    }

    private async Task RunPresetAsync((DateTime From, DateTime To) range)
    {
        (_from, _to) = range;
        await LoadAsync();
    }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        if (_busy) return;
        _busy = true;
        try
        {
            var from = DateTime.SpecifyKind(_from.Date, DateTimeKind.Utc);
            var to = DateTime.SpecifyKind(_to.Date.AddDays(1).AddTicks(-1), DateTimeKind.Utc);
            var review = await Api.GetPbmReviewAsync(from, to);
            _review = review.Succeeded ? review.Value ?? new() : new();
            // An empty list would read as "none in this period", so say when it failed instead.
            _reviewError = review.Succeeded ? null : review.FailureSummary();
            var result = await Api.GetUtilizationAsync(from, to);
            _report = result.Succeeded ? result.Value : null;
            _feedback = result.Succeeded ? null : result.ToFeedback();
        }
        finally
        {
            _busy = false;
        }
    }
}
