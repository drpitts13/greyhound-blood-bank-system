@page "/storage-temps"
@inject BloodBankApiClient Api
@inject UserSession Session
@inject IJSRuntime Js

<PageTitle>Storage temperatures &middot; HemoCore</PageTitle>

<div class="flex-between">
    <h1>Storage temperatures</h1>
    <div class="flex gap">
        <a class="btn btn-ghost" href="/storage-temps/report">Temperature history report</a>
        @if (Session.Has(PermissionCodes.AdminConfigView))
        {
            <a class="btn btn-ghost" href="/admin/storage-devices">Manage refrigerators &amp; freezers</a>
        }
    </div>
</div>
<p class="muted">Record refrigerator, freezer, and platelet-storage readings against each location's range.</p>
<details class="bb-help">
    <summary>How it works</summary>
    <ul>
        <li>The range comes from the device's minimum and maximum in Admin &rsaquo; Refrigerators &amp; Freezers. A location with no range records readings but cannot raise an excursion.</li>
        <li>A reading outside the range opens a Major deviation that names the location and the number of units stored there.</li>
        <li>Units are not quarantined automatically. Review them from Inventory and quarantine any that need it.</li>
        <li>Readings are never edited. Record a new reading to correct one.</li>
    </ul>
</details>
<Outcome Value="_feedback" />

@if (_excursions.Count > 0)
{
    <div class="bb-card">
        <div class="bb-card-title"><h3>Open excursions</h3></div>
        <div class="table-scroll">
        <table class="bb">
            <thead><tr><th>Location</th><th>Reading</th><th>Range</th><th>Time (UTC)</th><th>Recorded by</th><th>Deviation</th></tr></thead>
            <tbody>
                @foreach (var row in _excursions)
                {
                    <tr>
                        <td class="mono">@row.LocationCode</td>
                        <td class="text-error">@row.ReadingC °C (@StatusText(row.Status))</td>
                        <td>@RangeText(row.RangeMinC, row.RangeMaxC)</td>
                        <td>@row.ReadingUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@row.RecordedBy</td>
                        <td>@if (row.DeviationId is long id) { <a href="@($"/deviations?id={id}")">DEV-@id</a> }</td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    </div>
}

<div class="bb-card">
    <div class="bb-card-title"><h3>Locations</h3></div>
    @if (_locations.Count == 0)
    {
        <div class="muted">No active storage locations.</div>
    }
    else
    {
        <div class="table-scroll">
        <table class="bb">
            <thead><tr><th>Location</th><th>Range</th><th>Last reading</th><th>Time (UTC)</th><th>Units stored</th><th></th></tr></thead>
            <tbody>
                @foreach (var loc in _locations)
                {
                    <tr>
                        <td><span class="mono">@loc.Code</span> @loc.Name</td>
                        <td>@RangeText(loc.RangeMinC, loc.RangeMaxC)</td>
                        <td class="@(loc.LastStatus is StorageTemperatureStatus s && StorageTemperatureRule.IsExcursion(s) ? "text-error" : null)">
                            @(loc.LastReadingC is decimal c ? $"{c} °C" : "None")
                        </td>
                        <td>@loc.LastReadingUtc?.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@loc.UnitsStored</td>
                        <td class="right nowrap">
                            @if (Session.Has(PermissionCodes.InventoryReceive))
                            {
                                <button class="btn btn-secondary btn-sm" @onclick="() => StartReadingAsync(loc.LocationId)">Record</button>
                            }
                            <button class="btn btn-ghost btn-sm" @onclick="() => ShowHistoryAsync(loc.LocationId)">History</button>
                            <a class="btn btn-ghost btn-sm" href="@($"/storage-temps/report?device={loc.LocationId}")">Report</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    }
</div>

@if (Session.Has(PermissionCodes.InventoryReceive))
{
    <div class="bb-card">
        <div class="bb-card-title"><h3>Record a reading</h3></div>
        <Outcome Value="_recordFb" />
        <div class="form-row">
            <div class="field">
                <label>Location</label>
                <select @bind="_locationId">
                    <option value="0">Select</option>
                    @foreach (var loc in _locations)
                    {
                        <option value="@loc.LocationId">@loc.Code — @loc.Name</option>
                    }
                </select>
            </div>
            <div class="field"><label>Reading (°C)</label><input id="temp-reading" type="number" step="0.1" @bind="_reading" @bind:event="oninput" @onkeydown="OnReadingKey" /></div>
            <div class="field"><label>Comment</label><input @bind="_comment" /></div>
        </div>
        <button class="btn btn-primary btn-sm" disabled="@(_busy || _locationId == 0 || _reading is null)" @onclick="RecordAsync">Record reading</button>
    </div>
}

@if (_historyLocationId is long historyId)
{
    @* Scrolled to only when History is clicked; recording a reading also opens it and must not pull the page away from the form. *@
    <div id="temp-history" class="bb-card">
        <div class="bb-card-title"><h3>Last 7 days &middot; @_locations.FirstOrDefault(l => l.LocationId == historyId)?.Code</h3></div>
        @if (_history.Count == 0)
        {
            <div class="muted">No readings in the last 7 days.</div>
        }
        else
        {
            <div class="table-scroll">
            <table class="bb">
                <thead><tr><th>Time (UTC)</th><th>Reading</th><th>Status</th><th>Range then</th><th>Recorded by</th><th>Comment</th></tr></thead>
                <tbody>
                    @foreach (var row in _history)
                    {
                        <tr>
                            <td>@row.ReadingUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@row.ReadingC °C</td>
                            <td class="@(StorageTemperatureRule.IsExcursion(row.Status) ? "text-error" : null)">@StatusText(row.Status)</td>
                            <td>@RangeText(row.RangeMinC, row.RangeMaxC)</td>
                            <td>@row.RecordedBy</td>
                            <td>@row.Comment</td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        }
    </div>
}

@code {
    private List<StorageLocationTemperatureDto> _locations = new();
    private List<StorageTemperatureReadingDto> _excursions = new();
    private List<StorageTemperatureReadingDto> _history = new();
    private long? _historyLocationId;
    private Feedback? _feedback;
    private long _locationId;
    private decimal? _reading;
    private Feedback? _recordFb;

    // Rounds go fridge by fridge: Record on a row picks the location and puts the cursor in the reading.
    private async Task StartReadingAsync(long locationId)
    {
        _locationId = locationId;
        _recordFb = null;
        StateHasChanged();
        await Js.FocusSelectAsync("temp-reading");
    }

    private async Task OnReadingKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && _locationId != 0 && _reading is not null)
        {
            await RecordAsync();
        }
    }
    private string _comment = string.Empty;
    private bool _busy;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        var locations = await Api.GetStorageTemperatureLocationsAsync();
        if (locations.Succeeded) _locations = locations.Value ?? new();
        var excursions = await Api.GetOpenTemperatureExcursionsAsync();
        if (excursions.Succeeded) _excursions = excursions.Value ?? new();
        if (_historyLocationId is long id) await LoadHistoryAsync(id);
    }

    private async Task ShowHistoryAsync(long locationId)
    {
        _historyLocationId = locationId;
        await LoadHistoryAsync(locationId);
        StateHasChanged();
        await Js.ScrollIntoViewAsync("temp-history");
    }

    private async Task LoadHistoryAsync(long locationId)
    {
        var history = await Api.GetStorageTemperatureReadingsAsync(locationId, 7);
        _history = history.Succeeded ? history.Value ?? new() : new();
    }

    private async Task RecordAsync()
    {
        // A second click can arrive before the disabled button renders; a reading is never edited, so one click is one row.
        if (_busy || _reading is not decimal reading) return;
        _busy = true;
        try
        {
            var saved = await Api.RecordStorageTemperatureAsync(
                new RecordStorageTemperatureRequest(_locationId, reading, null, _comment));
            var excursion = saved.Succeeded && saved.Value is not null && StorageTemperatureRule.IsExcursion(saved.Value.Status);
            _recordFb = saved.ToFeedback(excursion
                ? $"Excursion recorded. Deviation DEV-{saved.Value!.DeviationId} is open. Review the units at this location."
                : "Reading recorded.");
            if (saved.Succeeded)
            {
                _reading = null;
                _comment = string.Empty;
                _historyLocationId = _locationId;
                await ReloadAsync();
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private static string StatusText(StorageTemperatureStatus status) => status switch
    {
        StorageTemperatureStatus.InRange => "In range",
        StorageTemperatureStatus.BelowRange => "Below range",
        StorageTemperatureStatus.AboveRange => "Above range",
        _ => "No range set"
    };

    private static string RangeText(decimal? min, decimal? max) => (min, max) switch
    {
        (decimal lo, decimal hi) => $"{lo} to {hi} °C",
        (decimal lo, null) => $"≥ {lo} °C",
        (null, decimal hi) => $"≤ {hi} °C",
        _ => "Not set"
    };
}
