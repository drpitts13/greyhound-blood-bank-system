@page "/reagents"
@using BloodBankLIS.Domain.Entities
@inject BloodBankApiClient Api
@inject UserSession Session
@inject IJSRuntime Js

<PageTitle>Reagent QC &middot; HemoCore</PageTitle>

<h1>Reagent QC</h1>
<p class="muted">Record reagent lots and the daily QC row.</p>
<details class="bb-help">
    <summary>How it works</summary>
    <ul>
        <li>Review is a different person from the one who performed the QC.</li>
        <li>Overdue, failed, and unreviewed rows stay on the worklist.</li>
        <li>Patient resulting stays open unless facility policy blocks it. That policy is off unless an administrator turns it on. This is not a CLIA hold.</li>
    </ul>
</details>
<Outcome Value="_feedback" />

<div class="bb-card">
    <div class="bb-card-title"><h3>Worklist</h3></div>
    @if (_work.Count == 0)
    {
        <div class="muted">No overdue, failed, or unreviewed QC.</div>
    }
    else
    {
        <table class="bb">
            <thead><tr><th>Kind</th><th>Lot</th><th>Detail</th><th></th></tr></thead>
            <tbody>
                @foreach (var row in _work)
                {
                    <tr>
                        <td>@row.Kind</td>
                        <td class="mono">@row.LotNumber</td>
                        <td>@row.Message</td>
                        <td>
                            @if (row.QcId is long qcId && row.Kind == ReagentQcWorklistRule.Unreviewed && Session.Has(PermissionCodes.ResultEnter))
                            {
                                <button class="btn btn-secondary btn-sm" @onclick="() => ReviewAsync(qcId)">Review</button>
                            }
                            else if (row.Kind != ReagentQcWorklistRule.Unreviewed && Session.Has(PermissionCodes.ResultEnter) && QcLots.Any(l => l.Id == row.LotId))
                            {
                                <button class="btn btn-secondary btn-sm" @onclick="() => StartQcForLotAsync(row.LotId)">Enter QC</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@if (Session.Has(PermissionCodes.ResultEnter))
{
    <div class="bb-card">
        <div class="bb-card-title"><h3>Reagent</h3></div>
        <div class="form-row">
            <div class="field"><label>Code</label><input @bind="_code" @bind:event="oninput" /></div>
            <div class="field"><label>Name</label><input @bind="_name" @bind:event="oninput" /></div>
        </div>
        <button class="btn btn-primary btn-sm" disabled="@(string.IsNullOrWhiteSpace(_code) || string.IsNullOrWhiteSpace(_name))" @onclick="SaveReagentAsync">Save reagent</button>
    </div>

    <div class="bb-card">
        <div class="bb-card-title"><h3>Lot</h3>
            @if (ClosedLotCount > 0)
            {
                <label class="muted" style="font-size:.85rem;"><input type="checkbox" @bind="_showClosedLots" /> Show closed (@ClosedLotCount)</label>
            }
        </div>
        <div class="form-row">
            <div class="field">
                <label>Reagent</label>
                <select @bind="_reagentId">
                    <option value="0">Select</option>
                    @foreach (var reagent in _reagents.Where(r => r.IsActive))
                    {
                        <option value="@reagent.Id">@reagent.Code — @reagent.Name</option>
                    }
                </select>
            </div>
            <div class="field"><label>Lot number</label><input @bind="_lotNumber" @bind:event="oninput" /></div>
            <div class="field"><label>Expires (UTC)</label><input type="datetime-local" @bind="_expiresLocal" /></div>
        </div>
        <button class="btn btn-primary btn-sm" disabled="@(_reagentId == 0 || string.IsNullOrWhiteSpace(_lotNumber))" @onclick="ReceiveLotAsync">Receive lot</button>
        @if (VisibleLots.Any())
        {
            <table class="bb" style="margin-top:1rem;">
                <thead><tr><th>Reagent</th><th>Lot</th><th>State</th><th>Expires</th><th></th></tr></thead>
                <tbody>
                    @foreach (var lot in VisibleLots)
                    {
                        <tr>
                            <td class="mono">@lot.ReagentCode</td>
                            <td class="mono">@lot.LotNumber</td>
                            <td>@lot.State</td>
                            <td>@lot.ExpiresUtc.ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="right nowrap">
                                @if (_confirmCloseId == lot.Id)
                                {
                                    @* Closing is one-way: a closed lot cannot take QC again. *@
                                    <span class="text-error" style="margin-right:.4rem;">Close this lot for good?</span>
                                    <button class="btn btn-danger btn-sm" @onclick="() => CloseAsync(lot.Id)">Close lot</button>
                                    <button class="btn btn-ghost btn-sm" @onclick="() => _confirmCloseId = null">Cancel</button>
                                }
                                else
                                {
                                    @if (lot.State == ReagentLotState.Received)
                                    {
                                        <button class="btn btn-secondary btn-sm" @onclick="() => OpenAsync(lot.Id)">Open</button>
                                    }
                                    @if (lot.State != ReagentLotState.Closed)
                                    {
                                        <button class="btn btn-ghost btn-sm" @onclick="() => _confirmCloseId = lot.Id">Close</button>
                                    }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else if (_lots.Count > 0)
        {
            <div class="muted" style="margin-top:1rem;">No open or received lots.</div>
        }
    </div>

    <div class="bb-card" id="reagent-qc-form">
        <div class="bb-card-title"><h3>Daily QC</h3></div>
        <div class="field">
            <label>Scan lot</label>
            <input @bind="_lotScan" @bind:event="oninput" @onkeydown="OnLotScanKey" placeholder="Scan or type the lot number; Enter to select" autocomplete="off" data-lot-scan />
            @if (_lotScanMessage is not null)
            {
                <span class="sub">@_lotScanMessage</span>
            }
        </div>
        <div class="form-row">
            <div class="field">
                <label>Lot</label>
                <select @bind="_qcLotId">
                    <option value="0">Select</option>
                    @foreach (var lot in QcLots)
                    {
                        <option value="@lot.Id">@lot.ReagentCode @lot.LotNumber</option>
                    }
                </select>
            </div>
            <div class="field"><label>Expected</label><input id="reagent-qc-expected" @bind="_expected" @bind:event="oninput" @bind:after="SyncPassedFromResults" />
                @if (string.IsNullOrWhiteSpace(_expected) && LastExpected is { } lastExpected)
                {
                    <div class="sub" data-last-expected>
                        Last recorded for this reagent: @lastExpected
                        <button type="button" class="btn btn-ghost btn-sm" @onclick="() => UseLastExpected(lastExpected)" title="Check it against the package insert">Use it</button>
                    </div>
                }
            </div>
            <div class="field"><label>Observed</label><input @bind="_observed" @bind:event="oninput" @bind:after="SyncPassedFromResults" /></div>
            <div class="field"><label>Passed</label><input type="checkbox" @bind="_passed" /></div>
        </div>
        @if (ResultsCompared)
        {
            @if (ResultsMatch)
            {
                <p class="muted" style="margin:0 0 .5rem;">Observed matches expected.</p>
            }
            else
            {
                <p class="text-error" style="margin:0 0 .5rem;">Observed differs from expected. Recorded as failed unless you tick Passed.</p>
            }
        }
        <button class="btn btn-primary btn-sm" disabled="@(_qcLotId == 0 || !ResultsCompared)" @onclick="RecordQcAsync">Record QC</button>
    </div>

    <div class="bb-card" data-recent-qc>
        <div class="bb-card-title"><h3>Recent QC (14 days)</h3></div>
        @if (_recentQc.Count == 0)
        {
            <div class="muted">No QC recorded in the last 14 days.</div>
        }
        else
        {
            <table class="bb">
                <thead><tr><th>Performed</th><th>Reagent / lot</th><th>Expected</th><th>Observed</th><th>Result</th><th>Performed by</th><th>Reviewed by</th></tr></thead>
                <tbody>
                    @foreach (var q in _recentQc)
                    {
                        <tr>
                            <td class="nowrap">@q.PerformedUtc.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@(q.ReagentCode ?? "—") <span class="mono">@q.LotNumber</span></td>
                            <td>@q.ExpectedResult</td>
                            <td>@q.ObservedResult</td>
                            <td><span class="badge @(q.Passed ? "badge-green" : "badge-red")">@(q.Passed ? "Passed" : "Failed")</span></td>
                            <td>@q.PerformedBy</td>
                            <td>@(q.ReviewedBy is null ? "Not reviewed" : $"{q.ReviewedBy} {q.ReviewedUtc:yyyy-MM-dd HH:mm}")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}

@code {
    private List<ReagentDto> _reagents = new();
    private List<ReagentLotDto> _lots = new();
    private List<ReagentQcWorkItemDto> _work = new();
    private Feedback? _feedback;
    private string _code = string.Empty;
    private string _name = string.Empty;
    private long _reagentId;
    private string _lotNumber = string.Empty;
    private DateTime _expiresLocal = DateTime.UtcNow.Date.AddDays(30);
    private long _qcLotId;
    private string _expected = string.Empty;
    private string _observed = string.Empty;
    // Not passed until the results say so: a pre-ticked box let a mismatched QC be recorded as passed.
    private bool _passed;

    private bool ResultsCompared => !string.IsNullOrWhiteSpace(_expected) && !string.IsNullOrWhiteSpace(_observed);

    private bool ResultsMatch =>
        ResultsCompared && string.Equals(_expected.Trim(), _observed.Trim(), StringComparison.OrdinalIgnoreCase);

    /// <summary>Passed follows the comparison as results are typed; the tech can still change it before recording.</summary>
    private void SyncPassedFromResults() => _passed = ResultsMatch;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        var reagents = await Api.GetReagentsAsync();
        if (reagents.Succeeded) _reagents = reagents.Value ?? new();
        var lots = await Api.GetReagentLotsAsync();
        if (lots.Succeeded) _lots = lots.Value ?? new();
        // With only one lot able to take QC, there is nothing to choose.
        if (QcLots.All(l => l.Id != _qcLotId)) _qcLotId = QcLots.Count == 1 ? QcLots[0].Id : 0;
        var work = await Api.GetReagentQcWorklistAsync();
        if (work.Succeeded) _work = work.Value ?? new();
        var recent = await Api.GetRecentReagentQcAsync();
        if (recent.Succeeded) _recentQc = recent.Value ?? new();
    }

    // Recent QC for the history table and the expected-result offer.
    private List<ReagentDailyQcDto> _recentQc = new();

    private string? LastExpected =>
        QcLots.FirstOrDefault(l => l.Id == _qcLotId) is { } lot ? ReagentQcHistory.LastExpected(lot.ReagentId, _recentQc) : null;

    private void UseLastExpected(string expected)
    {
        _expected = expected;
        SyncPassedFromResults();
    }

    // Barcode-first: the scanned lot number selects the one open lot that carries it.
    private string _lotScan = string.Empty;
    private string? _lotScanMessage;

    private void OnLotScanKey(KeyboardEventArgs e)
    {
        if (e.Key != "Enter" || string.IsNullOrWhiteSpace(_lotScan)) return;
        if (ReagentQcHistory.LotForScan(_lotScan, QcLots) is { } lot)
        {
            _qcLotId = lot.Id;
            _lotScanMessage = $"Selected {lot.ReagentCode} {lot.LotNumber}.";
            _lotScan = string.Empty;
        }
        else
        {
            _lotScanMessage = $"No single open lot is numbered \"{_lotScan.Trim()}\". Receive or open it first, or choose from the list.";
        }
    }

    private async Task SaveReagentAsync()
    {
        var saved = await Api.SaveReagentAsync(new SaveReagentRequest(_code, _name));
        _feedback = saved.ToFeedback("Reagent saved.");
        if (saved.Succeeded)
        {
            _code = string.Empty;
            _name = string.Empty;
            await ReloadAsync();
        }
    }

    // Closed lots are one-way and take no QC; they stay on record but are hidden by default.
    private bool _showClosedLots;
    private int ClosedLotCount => _lots.Count(l => l.State == ReagentLotState.Closed);
    private IEnumerable<ReagentLotDto> VisibleLots => _showClosedLots ? _lots : _lots.Where(l => l.State != ReagentLotState.Closed);

    private List<ReagentLotDto> QcLots => _lots.Where(l => l.State != ReagentLotState.Closed).ToList();

    /// <summary>From an overdue or failed worklist row: pick that lot in Daily QC and put the cursor on Expected.</summary>
    private async Task StartQcForLotAsync(long lotId)
    {
        _qcLotId = lotId;
        StateHasChanged();
        await Js.ScrollIntoViewAsync("reagent-qc-form");
        await Js.FocusSelectAsync("reagent-qc-expected", preventScroll: true);
    }

    private async Task ReceiveLotAsync()
    {
        var expires = DateTime.SpecifyKind(_expiresLocal, DateTimeKind.Utc);
        var saved = await Api.ReceiveReagentLotAsync(new ReceiveReagentLotRequest(_reagentId, _lotNumber, expires));
        _feedback = saved.ToFeedback("Lot received.");
        if (saved.Succeeded)
        {
            _lotNumber = string.Empty;
            await ReloadAsync();
        }
    }

    private async Task OpenAsync(long id)
    {
        var saved = await Api.OpenReagentLotAsync(id);
        _feedback = saved.ToFeedback("Lot opened.");
        if (saved.Succeeded) await ReloadAsync();
    }

    private long? _confirmCloseId;

    private async Task CloseAsync(long id)
    {
        _confirmCloseId = null;
        var saved = await Api.CloseReagentLotAsync(id);
        _feedback = saved.ToFeedback("Lot closed.");
        if (saved.Succeeded) await ReloadAsync();
    }

    private async Task RecordQcAsync()
    {
        var saved = await Api.RecordReagentQcAsync(new RecordReagentQcRequest(_qcLotId, _expected, _observed, _passed));
        _feedback = saved.ToFeedback(_passed ? "QC recorded as passed." : "QC recorded as failed.");
        if (saved.Succeeded)
        {
            // Clear the results so the next lot's QC starts fresh; the lot choice stays.
            _expected = string.Empty;
            _observed = string.Empty;
            _passed = false;
            await ReloadAsync();
        }
    }

    private async Task ReviewAsync(long id)
    {
        var saved = await Api.ReviewReagentQcAsync(id);
        _feedback = saved.ToFeedback("QC reviewed.");
        if (saved.Succeeded) await ReloadAsync();
    }
}
