    {
        public string LastName { get; set; } = string.Empty;
        public string FirstName { get; set; } = string.Empty;
        public string? MiddleName { get; set; }
        public DateOnly DateOfBirth { get; set; }
        public Sex Sex { get; set; } = Sex.Unknown;
        public PatientStatus Status { get; set; } = PatientStatus.Active;
    }

    private sealed class SpecimenEditModel
    {
        public DateTime CollectedLocal { get; set; } = DateTime.UtcNow;
        public string? Barcode { get; set; }
        public string? DrawLocation { get; set; }
        public string? Collector { get; set; }
        public int? ValidityHours { get; set; }
    }

    private static string FormatProvider(OrderingProviderRefDto p) => $"{p.Name} ({p.ProviderId})";

    private static string SearchProvider(OrderingProviderRefDto p) =>
        $"{p.Name} {p.ProviderId} {p.Specialty} {p.Location}";

    private static long? ProviderItemValue(OrderingProviderRefDto p) => p.Id;
}
