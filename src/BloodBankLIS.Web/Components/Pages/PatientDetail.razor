        OnToggleMerge="ToggleMerge"
        OnSaveDemo="SaveDemographicsAsync"
        OnCancelEdit="() => _editingDemographics = false"
        OnMerge="MergeDuplicateAsync"
        OnCancelMerge="() => _showMerge = false" />

    <PatientWorkflowRibbon Steps="WorkflowSteps" OnStepSelected="OpenWorkflowStepAsync" />
    <PatientChartTabBar Current="_tab" OnSelect="SelectTab" />

    @if (_tab == "overview")
