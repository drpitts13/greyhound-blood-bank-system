        await EnsureWorkspaceRefsAsync();
        if (!_visitsLoaded) await LoadVisitsAsync();

        _editingOrderId = order.Id;
        _showAddOrder = false;
        _editOrderEncounterId = order.EncounterId;
        _editOrderTestCodes = order.Lines
            .Where(l => l.LineCategory == OrderCategory.Test && l.TestCode is not null)
            .Select(l => l.TestCode!)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
        _editOrderProductTypeIds = order.Lines
            .Where(l => l.LineCategory == OrderCategory.Product && l.ProductTypeId is > 0)
            .Select(l => l.ProductTypeId!.Value)
            .ToHashSet();
        _editOrderPriority = order.Priority;
        _editOrderLocationId = order.OrderingLocationId;
        _editOrderProviderId = order.OrderingProviderId;
        _orderFb = null;
    }

    private async Task SaveOrderAsync()
    {
        if (_editingOrderId is not > 0) return;
        if (_editOrderEncounterId <= 0) { _orderFb = Feedback.Fail("Select a visit."); return; }
        if (_editOrderLocationId <= 0) { _orderFb = Feedback.Fail("Select an ordering location."); return; }
        var lines = BuildLineInputs(_editOrderTestCodes, _editOrderProductTypeIds);
        if (lines.Count == 0) { _orderFb = Feedback.Fail("Select at least one test or product."); return; }

        var order = _orders.FirstOrDefault(o => o.Id == _editingOrderId);
        if (order is null) { _orderFb = Feedback.Fail("Order not found."); return; }

        _busy = true;
        var req = new UpdateOrderRequest(
            _editOrderEncounterId,
            _editOrderLocationId,
            lines,
            _editOrderPriority,
            _editOrderProviderId is > 0 ? _editOrderProviderId : null);
        var r = await Api.UpdatePatientOrderAsync(Id, _editingOrderId.Value, req);
        _busy = false;
        if (!r.Succeeded) { _orderFb = r.ToFeedback(); return; }
        _orderFb = r.ToFeedback($"Order {order.OrderNumber} updated.");
        _editingOrderId = null;
        _ordersLoaded = false;
        await LoadOrdersAsync();
    }

