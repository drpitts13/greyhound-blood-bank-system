    private List<SpecialRequirementDefinitionDto> _srCatalog = new();
    private Feedback? _srFb;
    private long _srDefinitionId;
    private DateTime? _srEndDate;
    private string? _srAntigen;
    private string _srReason = string.Empty;
    private HashSet<string> _issueAcks = new(StringComparer.OrdinalIgnoreCase);

    private IEnumerable<SpecialRequirementDto> ActiveSpecialRequirements =>
        _specialRequirements.Where(r => r.IsClinicallyActive);

    private IEnumerable<SpecialRequirementDto> AcknowledgmentSpecialRequirements =>
        ActiveSpecialRequirements.Where(r => r.EnforcementKind == SpecialRequirementEnforcementKind.RequireIssueAcknowledgment);

    private SpecialRequirementDefinitionDto? SelectedSrDefinition =>
        _srCatalog.FirstOrDefault(d => d.Id == _srDefinitionId);
