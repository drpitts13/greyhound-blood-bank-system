    private async Task IssueAllocationAsync()
    {
        if (!ValidateIssueForm())
        {
            return;
        }

        _busy = true;
        var r = await Api.IssueUnitAsync(BuildPatientIssueRequest(null, null));
        _busy = false;

        if (r.Blocked && r.Overridable)
        {
            _showIssueOverride = true;
            _issueFb = r.ToFeedback();
            return;
        }

        _issueFb = r.ToFeedback($"Unit {_issuingAllocation!.UnitNumber} issued.");
        if (r.Succeeded)
        {
            _lastIssue = r.Value;
            _ptagFb = null;
            _issuingAllocation = null;
            _showIssueOverride = false;
            await LoadAllocationsAsync();
            _historyLoaded = false;
        }
    }

    private async Task IssueAllocationWithOverrideAsync()
    {
        if (!ValidateIssueForm())
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_issueOverrideReason) || string.IsNullOrWhiteSpace(_issueSignatureMeaning))
        {
            _issueFb = Feedback.Fail("An override reason and a meaning-of-signature are required.");
            return;
        }

        _busy = true;
        var sig = await Api.RecordSignatureAsync(new SignatureRequestVm("IssueOverride", _issueSignatureMeaning, "Issue", ReauthenticationSecret: _issueSignatureSecret));
        if (!sig.Succeeded || sig.Value is null)
        {
            _busy = false;
            _issueFb = sig.ToFeedback();
            return;
        }

        var authorizedBy = string.IsNullOrWhiteSpace(_issueAuthorizedBy) ? Session.UserName : _issueAuthorizedBy.Trim();
        var r = await Api.IssueUnitAsync(
            BuildPatientIssueRequest(_issueOverrideReason.Trim(), authorizedBy),
            sig.Value.Id);
        _busy = false;
        _issueFb = r.ToFeedback($"Unit {_issuingAllocation!.UnitNumber} issued under override.");
        if (r.Succeeded)
        {
            _lastIssue = r.Value;
            _ptagFb = null;
            _issuingAllocation = null;
            _showIssueOverride = false;
            await LoadAllocationsAsync();
            _historyLoaded = false;
        }
    }

