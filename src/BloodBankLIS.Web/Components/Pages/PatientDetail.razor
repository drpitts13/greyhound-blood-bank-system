    private IReadOnlyList<AntibodyIdWorkupListItemDto> OpenAbidWorkups =>
        _abidWorkups
            .Where(w => w.Status is AntibodyWorkupStatus.InProgress
                or AntibodyWorkupStatus.PendingInterpretation
                or AntibodyWorkupStatus.PendingSupervisorReview)
            .ToList();

    private bool HasCompletedUnscopedAbid =>
        _abidWorkups.Any(w => w.Status == AntibodyWorkupStatus.Completed && w.SpecimenId is null);

    private bool HasCompletedPostedAbid =>
        _abidWorkups.Any(w => w.Status == AntibodyWorkupStatus.Completed)
        && _antibodyHistory.Any(a => a.IsActive);

    private bool HasCompletedAbidOnSpecimen(long specimenId) =>
        _abidWorkups.Any(w => w.Status == AntibodyWorkupStatus.Completed && w.SpecimenId == specimenId);
