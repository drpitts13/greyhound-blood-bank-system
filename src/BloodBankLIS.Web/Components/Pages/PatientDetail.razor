    private IEnumerable<DirectoryUserDto> SecondVerifierChoices =>
        _directoryUsers.Where(u => !string.Equals(u.UserName, Session.UserName, StringComparison.OrdinalIgnoreCase));

    private bool NeedsAbHistoryOverride =>
        _antibodyHistory.Count > 0
        && _selectedUnit?.RequiresCrossmatch == true
        && SelectedXmResultType == ResultValueType.Crossmatch;

    private ResultValueType SelectedXmResultType =>
        _crossmatchTests.FirstOrDefault(t => string.Equals(t.Code, _allocXmTestCode, StringComparison.OrdinalIgnoreCase))
            ?.ResultValueType
        ?? ResultValueType.Crossmatch;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        var p = await Api.GetPatientAsync(Id);
        if (!p.Succeeded) { _patient = null; _error = p.FailureSummary(); _loading = false; return; }
        _patient = p.Value;

        _currentType = (await Api.GetCurrentBloodTypeAsync(Id)).Value;
        _exm = (await Api.GetPatientElectronicCrossmatchEligibilityAsync(Id)).Value;
        _typeHistory = (await Api.GetBloodTypeHistoryAsync(Id)).Value ?? new();
        _antibodyHistory = (await Api.GetAntibodyHistoryAsync(Id)).Value ?? new();
        _antigenProfiles = (await Api.GetAntigenProfilesAsync(Id)).Value ?? new();
        _bloodAttributeCatalog = (await Api.GetReferenceBloodAttributesAsync()).Value ?? new();
        _specimens = (await Api.GetPatientSpecimensAsync(Id)).Value ?? new();
        _specimenTypes = (await Api.GetReferenceSpecimenTypesAsync()).Value ?? new();
        _specialRequirements = (await Api.GetSpecialRequirementsAsync(Id)).Value ?? new();
        await LoadPanelDefinitionAsync(_panelTestCode);
        _loading = false;
    }

    private string TabClass(string tab) => _tab == tab ? "btn-primary" : "btn-secondary";

    private async Task SelectTab(string tab)
    {
        _tab = tab;
        if (tab is "visits" or "orders") await EnsureWorkspaceRefsAsync();
        if (tab == "visits" && !_visitsLoaded) await LoadVisitsAsync();
        if (tab == "orders") { if (!_visitsLoaded) await LoadVisitsAsync(); if (!_ordersLoaded) await LoadOrdersAsync(); }
        if (tab == "history" && !_historyLoaded) await LoadProductHistoryAsync();
        if (tab == "test-history" && !_testHistoryLoaded) await LoadTestHistoryAsync();
        if (tab == "tests" && !_testsLoaded) await LoadTestWorklistAsync();
        if (tab == "products" && !_allocLoaded) await LoadAllocationsAsync();
    }

    private static string DisplayAllocationStatus(ProductAllocationDisplayStatus status) => status switch
    {
        ProductAllocationDisplayStatus.ReadyForIssue => "Ready for Issue",
        ProductAllocationDisplayStatus.Exception => "Exception",
        ProductAllocationDisplayStatus.Reserved => "Reserved",
        _ => status.ToString()
    };

    private async Task LoadAllocationsAsync()
    {
        _allocLoading = true;
        var r = await Api.GetPatientAllocationsAsync(Id);
        _allocations = r.Value ?? new();
        if (!r.Succeeded) _allocFb = r.ToFeedback();
        _allocLoading = false;
        _allocLoaded = true;
        await LoadDirectoryUsersAsync();
    }

    private async Task LoadDirectoryUsersAsync()
    {
        if (_directoryUsers.Count > 0) return;
        var users = await Api.GetDirectoryUsersAsync();
        if (users.Succeeded) _directoryUsers = users.Value ?? new();
    }

    private async Task ToggleAllocatePanel()
    {
        _showAllocate = !_showAllocate;
        _allocFb = null;
        if (_showAllocate)
        {
            await EnsureWorkspaceRefsAsync();
            if (!_visitsLoaded) await LoadVisitsAsync();
            await LoadCompatibleUnitsAsync();
            var tests = await Api.GetPatientCrossmatchTestsAsync(Id);
            _crossmatchTests = tests.Value ?? new();
            if (_antibodyHistory.Count > 0
                && _crossmatchTests.Any(t => t.ResultValueType == ResultValueType.ComplexCrossmatch))
            {
                _allocXmTestCode = _crossmatchTests.First(t => t.ResultValueType == ResultValueType.ComplexCrossmatch).Code;
            }
            else if (_crossmatchTests.Count > 0
                     && !_crossmatchTests.Any(t => string.Equals(t.Code, _allocXmTestCode, StringComparison.OrdinalIgnoreCase)))
            {
                _allocXmTestCode = _crossmatchTests[0].Code;
            }

            var exc = await Api.GetAdminExceptionByCodeAsync(AntibodyHistoryCrossmatchRule.RuleCode);
            if (exc.Succeeded && exc.Value is not null) _allocXmMinLevel = exc.Value.MinSecurityLevel;
        }
    }

    private async Task LoadCompatibleUnitsAsync()
    {
        _compatUnitsLoading = true;
        _compatUnitsError = null;
        var r = await Api.GetPatientCompatibleUnitsAsync(Id);
        _compatibleUnits = r.Value ?? new();
        if (!r.Succeeded) _compatUnitsError = r.FailureSummary();
        _compatUnitsLoading = false;
    }

    private void SelectAllocUnit(CompatibleUnitDto u)
    {
        _selectedUnitId = u.BloodUnitId;
        _selectedUnit = u;
    }

    private void BeginReleaseAllocation(PatientAllocationRowDto a)
    {
        _issuingAllocation = null;
        _showIssueOverride = false;
        _issueFb = null;
        _releasingAllocationId = a.AllocationId;
        _releaseReason = string.Empty;
    }

    private void BeginIssueAllocation(PatientAllocationRowDto a)
    {
        _releasingAllocationId = null;
        _issuingAllocation = a;
        _issueFb = null;
        _showIssueOverride = false;
        _issueLocalDateTime = DateTime.Now;
        _issueLocation = string.Empty;
        _issueIssuedTo = string.Empty;
        _issueComment = string.Empty;
        _issueOverrideReason = string.Empty;
        _issueAuthorizedBy = Session.UserName ?? string.Empty;
        _issueSignatureMeaning = "I authorize issue override";
        _issueSignatureSecret = string.Empty;
        _issueId1 = _patient?.MedicalRecordNumber ?? string.Empty;
        _issueId2 = _patient?.DateOfBirth.ToString("yyyy-MM-dd") ?? string.Empty;
        _issueSecondVerifier = string.Empty;
        _issueAppearance = UnitAppearance.Acceptable;
        _issueScan.Clear();
    }

    private void CancelIssueAllocation()
    {
        _issuingAllocation = null;
        _showIssueOverride = false;
        _issueFb = null;
    }

    private IssueUnitRequest BuildPatientIssueRequest(string? overrideReason, string? authorizedBy)
    {
        var issuedUtc = DateTime.SpecifyKind(_issueLocalDateTime, DateTimeKind.Local).ToUniversalTime();
        return new IssueUnitRequest(
            _issuingAllocation!.BloodUnitId,
            Id,
            PatientIdentifier1Type: IdentityTokenType.MedicalRecordNumber,
            PatientIdentifier1Value: _issueId1,
            PatientIdentifier2Type: IdentityTokenType.DateOfBirth,
            PatientIdentifier2Value: _issueId2,
            IssuedTo: _issueIssuedTo.Trim(),
            IssuedToLocation: _issueLocation.Trim(),
            IssueType: IssueType.Standard,
            VisualInspectionAcceptable: _issueAppearance == UnitAppearance.Acceptable,
            SecondVerifier: _issueSecondVerifier,
            OverrideReason: overrideReason,
            AuthorizedBy: authorizedBy,
            IssuedUtc: issuedUtc,
            Comment: string.IsNullOrWhiteSpace(_issueComment) ? null : _issueComment.Trim(),
            VerifiedScan: _issueScan.ToRequest(),
            Appearance: _issueAppearance);
    }

    private bool ValidateIssueForm()
    {
        if (_issuingAllocation is null)
        {
            _issueFb = Feedback.Fail("Select a unit to issue.");
            return false;
        }

        if (string.IsNullOrWhiteSpace(_issueLocation))
        {
            _issueFb = Feedback.Fail("Location to issue is required.");
            return false;
        }

        if (string.IsNullOrWhiteSpace(_issueIssuedTo))
        {
            _issueFb = Feedback.Fail("Person issued to is required.");
            return false;
        }

        if (_issueLocalDateTime == default)
        {
            _issueFb = Feedback.Fail("Date/time of issue is required.");
            return false;
        }

        return true;
    }

    private async Task IssueAllocationAsync()
    {
        if (!ValidateIssueForm())
        {
            return;
        }

        _busy = true;
        var r = await Api.IssueUnitAsync(BuildPatientIssueRequest(null, null));
        _busy = false;

        if (r.Blocked && r.Overridable)
        {
            _showIssueOverride = true;
            _issueFb = r.ToFeedback();
            return;
        }

        _issueFb = r.ToFeedback($"Unit {_issuingAllocation!.UnitNumber} issued.");
        if (r.Succeeded)
        {
            _issuingAllocation = null;
            _showIssueOverride = false;
            await LoadAllocationsAsync();
            _historyLoaded = false;
        }
    }

    private async Task IssueAllocationWithOverrideAsync()
    {
        if (!ValidateIssueForm())
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_issueOverrideReason) || string.IsNullOrWhiteSpace(_issueSignatureMeaning))
        {
            _issueFb = Feedback.Fail("An override reason and a meaning-of-signature are required.");
            return;
        }

        _busy = true;
        var sig = await Api.RecordSignatureAsync(new SignatureRequestVm("IssueOverride", _issueSignatureMeaning, "Issue", ReauthenticationSecret: _issueSignatureSecret));
        if (!sig.Succeeded || sig.Value is null)
        {
            _busy = false;
            _issueFb = sig.ToFeedback();
            return;
        }

        var authorizedBy = string.IsNullOrWhiteSpace(_issueAuthorizedBy) ? Session.UserName : _issueAuthorizedBy.Trim();
        var r = await Api.IssueUnitAsync(
            BuildPatientIssueRequest(_issueOverrideReason.Trim(), authorizedBy),
            sig.Value.Id);
        _busy = false;
        _issueFb = r.ToFeedback($"Unit {_issuingAllocation!.UnitNumber} issued under override.");
        if (r.Succeeded)
        {
            _issuingAllocation = null;
            _showIssueOverride = false;
            await LoadAllocationsAsync();
            _historyLoaded = false;
        }
    }

    private async Task ReleaseAllocationAsync()
    {
        if (_releasingAllocationId is null || string.IsNullOrWhiteSpace(_releaseReason))
        {
            _allocFb = Feedback.Fail("A release reason is required.");
            return;
        }

        _busy = true;
        var r = await Api.ReleaseAllocationAsync(_releasingAllocationId.Value, _releaseReason.Trim());
        _busy = false;
        _allocFb = r.ToFeedback("Allocation released.");
        if (r.Succeeded)
        {
            _releasingAllocationId = null;
            await LoadAllocationsAsync();
        }
    }

    private async Task AllocateUnitAsync()
    {
        if (_selectedUnitId is null)
        {
            _allocFb = Feedback.Fail("Select a unit to allocate.");
            return;
        }

        if (_selectedUnit?.RequiresCrossmatch == true && string.IsNullOrWhiteSpace(_allocXmTestCode))
        {
            _allocFb = Feedback.Fail("Select a crossmatch test.");
            return;
        }

        if (NeedsAbHistoryOverride)
        {
            if (Session.SecurityLevel < _allocXmMinLevel)
            {
                _allocFb = Feedback.Fail("Security level is insufficient to override antibody-history crossmatch exception.");
                return;
            }

            if (string.IsNullOrWhiteSpace(_allocOverrideReason))
            {
                _allocFb = Feedback.Fail("An override comment is required when selecting simple crossmatch for a patient with antibody history.");
                return;
            }
        }

        _busy = true;
        var req = new AllocatePatientUnitRequest(
            _selectedUnitId.Value,
            _allocEncounterId > 0 ? _allocEncounterId : null,
            _allocSpecimenId > 0 ? _allocSpecimenId : null,
            _newOrderLocationId > 0 ? _newOrderLocationId : null,
            null,
            _selectedUnit?.RequiresCrossmatch == true ? _allocXmTestCode : null,
            NeedsAbHistoryOverride ? _allocOverrideReason.Trim() : null,
            NeedsAbHistoryOverride
                ? (string.IsNullOrWhiteSpace(_allocAuthorizedBy) ? Session.UserName : _allocAuthorizedBy.Trim())
                : null);

        var r = await Api.AllocatePatientUnitAsync(Id, req);
        _busy = false;

        if (r.Blocked && r.Overridable && NeedsAbHistoryOverride)
        {
            _allocFb = r.ToFeedback();
            return;
        }

        _allocFb = r.ToFeedback(
            r.Value?.CrossmatchOrderId is not null
                ? $"Unit allocated; crossmatch order {r.Value.CrossmatchTestCode} created."
                : "Unit allocated.");

        if (r.Succeeded)
        {
            _showAllocate = false;
            _selectedUnitId = null;
            _selectedUnit = null;
            _allocOverrideReason = string.Empty;
            await LoadAllocationsAsync();
            _testsLoaded = false;
        }
    }

