@page "/patients/{Id:long}"
@using BloodBankLIS.Application.Admin
@using BloodBankLIS.Application.Immunohematology
@using BloodBankLIS.Application.Issuing
@using BloodBankLIS.Application.PatientWorkspace
@using BloodBankLIS.Application.Reference
@using BloodBankLIS.Domain.ValueObjects
@inject BloodBankApiClient Api
@inject UserSession Session
@inject NavigationManager Nav

<PageTitle>Patient &middot; Greyhound Blood Bank LIS</PageTitle>

@if (_loading)
{
    <div class="loading">Loading patient...</div>
}
else if (_patient is null)
{
    <div class="alert alert-danger">@(_error ?? "Patient not found.")</div>
    <button class="btn btn-secondary" @onclick='() => Nav.NavigateTo("/patients")'>Back to patients</button>
}
else
{
    <div class="flex-between" style="margin-bottom:1rem;">
        <div>
            <h1>@DisplayName(_patient)</h1>
            <div class="muted">
                MRN <span class="mono">@_patient.MedicalRecordNumber</span>
                &middot; DOB @_patient.DateOfBirth.ToString("yyyy-MM-dd")
                &middot; @_patient.Sex
                &middot; <span class="badge @(_patient.Status == PatientStatus.Merged ? "badge-amber" : "badge-gray")">@_patient.Status</span>
            </div>
        </div>
        <div class="flex gap">
            <div class="stat" style="text-align:center;padding:.6rem 1rem;">
                <div class="label">Blood type</div>
                <div class="value" style="font-size:1.4rem;">@(_currentType is null ? "—" : Ui.BloodType(_currentType.Abo, _currentType.RhD))</div>
            </div>
            @if (_exm is not null)
            {
                <div class="stat" style="text-align:center;padding:.6rem 1rem;">
                    <div class="label">Electronic XM</div>
                    <div class="value" style="font-size:1rem;">
                        <span class="badge @(_exm.Eligible ? "badge-green" : "badge-amber")">@(_exm.Eligible ? "Eligible" : "Not eligible")</span>
                    </div>
                </div>
            }
            @if (CanEditDemographics)
            {
                <button class="btn btn-secondary" @onclick="ToggleEditDemographics">@(_editingDemographics ? "Cancel edit" : "Edit demographics")</button>
            }
            @if (CanMergePatients)
            {
                <button class="btn btn-secondary" @onclick="ToggleMerge">@(_showMerge ? "Cancel merge" : "Merge duplicate")</button>
            }
            @if (Session.Has(PermissionCodes.LookbackManage))
            {
                <button class="btn btn-secondary" @onclick="OpenRecipientTrace">Recipient traceback</button>
            }
            <button class="btn btn-secondary" @onclick='() => Nav.NavigateTo("/patients")'>Back</button>
        </div>
    </div>

    @if (_editingDemographics)
    {
        <div class="bb-card" style="margin-bottom:1rem;">
            <div class="bb-card-title"><h3>Edit demographics</h3></div>
            <Outcome Value="_demoFb" />
            <div class="form-row">
                <div class="field"><label>MRN</label><input value="@_patient.MedicalRecordNumber" disabled /></div>
                <div class="field"><label>Last name</label><input @bind="_demo.LastName" /></div>
                <div class="field"><label>First name</label><input @bind="_demo.FirstName" /></div>
                <div class="field"><label>Middle name</label><input @bind="_demo.MiddleName" /></div>
                <div class="field"><label>Date of birth</label><input type="date" @bind="_demo.DateOfBirth" /></div>
                <div class="field"><label>Sex</label>
                    <select @bind="_demo.Sex">
                        @foreach (var s in Enum.GetValues<Sex>())
                        {
                            <option value="@s">@s</option>
                        }
                    </select>
                </div>
                <div class="field"><label>Status</label>
                    <select @bind="_demo.Status">
                        <option value="@PatientStatus.Active">Active</option>
                        <option value="@PatientStatus.Inactive">Inactive</option>
                    </select>
                </div>
            </div>
            <p class="muted">MRN cannot be changed. Later ADT messages may overwrite name, date of birth, and sex.</p>
            <div class="flex gap">
                <button class="btn btn-primary" disabled="@_busy" @onclick="SaveDemographicsAsync">Save</button>
                <button class="btn btn-secondary" @onclick="() => _editingDemographics = false">Cancel</button>
            </div>
        </div>
    }

    @if (_patient.Status == PatientStatus.Merged)
    {
        <div class="alert alert-danger">
            <strong>Merged record.</strong>
            This patient record is merged. Continue testing, allocation, and issue on the surviving patient record.
            @if (_patient.MergedIntoPatientId is long survivorId)
            {
                <button class="btn btn-primary btn-sm" style="margin-left:.75rem;" @onclick="() => OpenSurvivor(survivorId)">Open surviving patient</button>
            }
        </div>
    }

    @if (_showMerge && CanMergePatients)
    {
        <div class="bb-card" style="margin-bottom:1rem;">
            <div class="bb-card-title"><h3>Merge a duplicate into this patient</h3></div>
            <p class="muted">The duplicate is marked Merged and is no longer used for testing, allocation, or issue. History is reassigned to this record and is not deleted.</p>
            <Outcome Value="_mergeFb" />
            <div class="form-row">
                <div class="field"><label>Duplicate MRN</label><input @bind="_mergeMrn" placeholder="MRN of the losing record" /></div>
                <div class="field" style="flex:2;"><label>Reason</label><input @bind="_mergeReason" placeholder="Why these records are the same person" /></div>
            </div>
            <div class="flex gap">
                <button class="btn btn-primary" disabled="@_busy" @onclick="MergeDuplicateAsync">Merge into this patient</button>
                <button class="btn btn-secondary" @onclick="() => _showMerge = false">Cancel</button>
            </div>
        </div>
    }

    @if (_antibodyHistory.Count > 0)
    {
        <div class="alert alert-warning">
            <strong>Antibody history:</strong>
            @string.Join(", ", _antibodyHistory.Select(a => a.IsActive ? a.AntibodySpecificity : $"{a.AntibodySpecificity} (historical / currently undetectable)"))
        </div>
    }

    @if (_specialRequirements.Any(r => r.IsActive))
    {
        <div class="alert alert-warning">
            <strong>Special transfusion requirements:</strong>
            @string.Join(", ", _specialRequirements.Where(r => r.IsActive).Select(r => r.AntigenCode is null ? r.RequirementType.ToString() : $"{r.RequirementType} {r.AntigenCode}"))
        </div>
    }

    <div class="flex gap" style="margin-bottom:1rem;flex-wrap:wrap;">
        <button type="button" class="btn @TabClass("overview")" @onclick='() => SelectTab("overview")'>Overview</button>
        <button type="button" class="btn @TabClass("visits")" @onclick='() => SelectTab("visits")'>Visits</button>
        <button type="button" class="btn @TabClass("orders")" @onclick='() => SelectTab("orders")'>Orders</button>
        <button type="button" class="btn @TabClass("specimens")" @onclick='() => SelectTab("specimens")'>Specimens</button>
        <button type="button" class="btn @TabClass("tests")" @onclick='() => SelectTab("tests")'>Tests</button>
        <button type="button" class="btn @TabClass("test-history")" @onclick='() => SelectTab("test-history")'>Test History</button>
        <button type="button" class="btn @TabClass("products")" @onclick='() => SelectTab("products")'>Products</button>
        <button type="button" class="btn @TabClass("history")" @onclick='() => SelectTab("history")'>Product History</button>
    </div>

    @if (_tab == "overview")
    {
    <div class="bb-grid cols-2">
        <div class="bb-card">
            <div class="bb-card-title"><h3>Electronic crossmatch eligibility</h3></div>
            <p class="muted">AABB 5.16 computer XM checklist (SafeTrace / SoftBank). Serologic XM is required when any item fails.</p>
            @if (_exm is null)
            {
                <div class="empty">Eligibility could not be loaded.</div>
            }
            else
            {
                <p>
                    <span class="badge @(_exm.Eligible ? "badge-green" : "badge-amber")">@(_exm.Eligible ? "Eligible" : "Not eligible")</span>
                    @if (!_exm.Eligible && !string.IsNullOrWhiteSpace(_exm.BlockingReason))
                    {
                        <span class="muted"> @_exm.BlockingReason</span>
                    }
                </p>
                <table class="bb">
                    <thead><tr><th>Criterion</th><th>Status</th></tr></thead>
                    <tbody>
                        @foreach (var c in _exm.Criteria)
                        {
                            <tr>
                                <td>
                                    <strong>@c.Label</strong>
                                    <div class="muted">@c.Detail</div>
                                </td>
                                <td>
                                    <span class="badge @(c.Satisfied ? "badge-green" : "badge-red")">@(c.Satisfied ? "Met" : "Not met")</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <!-- Blood type -->
        <div class="bb-card">
            <div class="bb-card-title"><h3>Blood type history</h3></div>
            @if (_typeHistory.Count == 0)
            {
                <div class="empty">No blood type on record.</div>
            }
            else
            {
                <table class="bb">
                    <thead><tr><th>Type</th><th>Source</th><th>Current</th><th>Recorded</th></tr></thead>
                    <tbody>
                        @foreach (var t in _typeHistory)
                        {
                            <tr>
                                <td><strong>@Ui.BloodType(t.Abo, t.RhD)</strong></td>
                                <td>@t.Source</td>
                                <td>@(t.IsCurrent ? "Yes" : "")</td>
                                <td class="nowrap">@t.RecordedUtc.ToString("yyyy-MM-dd HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            @if (Session.Has(PermissionCodes.ImmunoOverride))
            {
                <hr style="margin:1rem 0;border:none;border-top:1px solid var(--bb-border);" />
                <h4>Record manual ABO/Rh <span class="badge badge-red">dangerous</span></h4>
                <Outcome Value="_typeFb" />
                <div class="form-row">
                    <div class="field"><label>ABO</label>
                        <select @bind="_typeAbo">@foreach (var a in Enum.GetValues<AboGroup>()) { <option value="@a">@a</option> }</select>
                    </div>
                    <div class="field"><label>Rh(D)</label>
                        <select @bind="_typeRh">@foreach (var r in Enum.GetValues<RhType>()) { <option value="@r">@r</option> }</select>
                    </div>
                </div>
                <div class="field"><label>Reason (required)</label><input @bind="_typeReason" /></div>
                <button class="btn btn-danger" disabled="@_busy" @onclick="RecordTypeAsync">Record blood type</button>
            }
        </div>

        <!-- Special transfusion requirements -->
        <div class="bb-card">
            <div class="bb-card-title"><h3>Special transfusion requirements</h3></div>
            <p class="muted">Computer-evaluated at issue. Operators cannot checkbox these away.</p>
            <Outcome Value="_srFb" />
            @if (_specialRequirements.Count == 0)
            {
                <div class="empty">No special requirements on record.</div>
            }
            else
            {
                <table class="bb">
                    <thead><tr><th>Type</th><th>Antigen</th><th>Reason</th><th>Active</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var r in _specialRequirements)
                        {
                            <tr>
                                <td>@r.RequirementType</td>
                                <td class="mono">@r.AntigenCode</td>
                                <td>@r.Reason</td>
                                <td>@(r.IsActive ? "Yes" : "No")</td>
                                <td class="right">
                                    @if (r.IsActive && Session.Has(PermissionCodes.ImmunoOverride))
                                    {
                                        <button class="btn btn-ghost btn-sm" @onclick="() => BeginDeactivateSr(r)">Deactivate</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            @if (_srDeactivateId is not null)
            {
                <div class="alert alert-warning">
                    <div class="field"><label>Reason to deactivate</label><input @bind="_srDeactivateReason" /></div>
                    <button class="btn btn-danger btn-sm" disabled="@_busy" @onclick="DeactivateSrAsync">Confirm</button>
                    <button class="btn btn-secondary btn-sm" @onclick="() => _srDeactivateId = null">Cancel</button>
                </div>
            }
            @if (Session.Has(PermissionCodes.ImmunoRecord))
            {
                <hr style="margin:1rem 0;border:none;border-top:1px solid var(--bb-border);" />
                <h4>Add requirement</h4>
                <div class="form-row">
                    <div class="field"><label>Type</label>
                        <select @bind="_srType">@foreach (var t in Enum.GetValues<SpecialTransfusionRequirementType>()) { <option value="@t">@t</option> }</select>
                    </div>
                    <div class="field"><label>Antigen code</label><input @bind="_srAntigen" placeholder="Required for AntigenNegative" /></div>
                    <div class="field" style="grid-column:1/-1;"><label>Reason</label><input @bind="_srReason" /></div>
                </div>
                <button class="btn btn-primary" disabled="@_busy" @onclick="AddSpecialRequirementAsync">Add</button>
            }
            @if (Session.Has(PermissionCodes.PatientWrite))
            {
                <hr style="margin:1rem 0;border:none;border-top:1px solid var(--bb-border);" />
                <h4>Recent pregnancy (specimen window)</h4>
                <p class="muted">When documented, accepted specimens use the 3-day alloimmunization-risk window.</p>
                <div class="muted">Current: @(_patient.RecentPregnancyUtc?.ToString("yyyy-MM-dd") ?? "not documented")</div>
                <button class="btn btn-secondary btn-sm" disabled="@_busy" @onclick="MarkRecentPregnancyAsync">Document pregnancy in last 3 months</button>
            }
        </div>

        <!-- Antibodies -->
        <div class="bb-card">
            <div class="bb-card-title"><h3>Antibodies</h3></div>
            @if (_antibodyHistory.Count == 0)
            {
                <div class="empty">No antibodies on record.</div>
            }
            else
            {
                <table class="bb">
                    <thead><tr><th>Specificity</th><th>Status</th><th>Active</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var a in _antibodyHistory)
                        {
                            <tr>
                                <td><strong>@a.AntibodySpecificity</strong></td>
                                <td>@a.Status</td>
                                <td>@(a.IsActive ? "Yes" : "No")</td>
                                <td class="right">
                                    @if (a.IsActive && Session.Has(PermissionCodes.ImmunoOverride))
                                    {
                                        <button class="btn btn-ghost btn-sm" @onclick="() => BeginDeactivate(a)">Deactivate</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            @if (_deactivateId is not null)
            {
                <div class="alert alert-warning">
                    <div class="field"><label>Reason to deactivate</label><input @bind="_deactivateReason" /></div>
                    <button class="btn btn-danger btn-sm" disabled="@_busy" @onclick="DeactivateAsync">Confirm</button>
                    <button class="btn btn-secondary btn-sm" @onclick="() => _deactivateId = null">Cancel</button>
                </div>
            }

            @if (Session.Has(PermissionCodes.ImmunoRecord))
            {
                <hr style="margin:1rem 0;border:none;border-top:1px solid var(--bb-border);" />
                <h4>Add antibody</h4>
                <Outcome Value="_antibodyFb" />
                <div class="form-row">
                    <div class="field"><label>Catalog antibody</label>
                        <FilterableComboBox TItem="BloodAttributeListItemDto" TValue="long?"
                                            Items="_bloodAttributeCatalog"
                                            @bind-Value="_abCatalogId"
                                            DisplayText="@(a => $"{a.AntibodyName} ({a.Code})")"
                                            Placeholder="Select from catalog" />
                    </div>
                    <div class="field"><label>Status</label>
                        <select @bind="_abStatus">@foreach (var s in Enum.GetValues<AntibodyStatus>()) { <option value="@s">@s</option> }</select>
                    </div>
                </div>
                <div class="field"><label>Comment</label><input @bind="_abComment" /></div>
                <button class="btn btn-primary" disabled="@(_busy || _abCatalogId is null)" @onclick="AddAntibodyAsync">Add antibody</button>
            }
        </div>

        <!-- Antigen profile -->
        <div class="bb-card">
            <div class="bb-card-title"><h3>Antigen profile</h3></div>
            @if (_antigenProfiles.Count == 0)
            {
                <div class="empty">No antigen typing on record.</div>
            }
            else
            {
                <table class="bb">
                    <thead><tr><th>Antigen</th><th>Code</th><th>Result</th><th>Tested</th></tr></thead>
                    <tbody>
                        @foreach (var p in _antigenProfiles)
                        {
                            <tr>
                                <td>@p.AntigenName</td>
                                <td class="mono">@p.AntigenCode</td>
                                <td>@p.Result</td>
                                <td class="nowrap">@(p.TestedUtc?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            @if (Session.Has(PermissionCodes.ImmunoRecord))
            {
                <hr style="margin:1rem 0;border:none;border-top:1px solid var(--bb-border);" />
                <h4>Record antigen result</h4>
                <Outcome Value="_antigenFb" />
                <div class="form-row">
                    <div class="field"><label>Antigen</label>
                        <FilterableComboBox TItem="BloodAttributeListItemDto" TValue="long?"
                                            Items="_bloodAttributeCatalog"
                                            @bind-Value="_agCatalogId"
                                            DisplayText="@(a => $"{a.Name} ({a.Code})")"
                                            Placeholder="Select antigen" />
                    </div>
                    <div class="field"><label>Result</label>
                        <select @bind="_agResult">@foreach (var r in Enum.GetValues<AntigenResult>()) { <option value="@r">@r</option> }</select>
                    </div>
                </div>
                <button class="btn btn-primary" disabled="@(_busy || _agCatalogId is null)" @onclick="SaveAntigenProfileAsync">Save antigen result</button>
            }
        </div>
    </div>
    }

    @if (_tab == "visits")
    {
        <div class="bb-card">
            <div class="bb-card-title flex-between">
                <h3>Visits / encounters</h3>
                @if (Session.Has(PermissionCodes.PatientWrite))
                {
                    <button type="button" class="btn btn-primary btn-sm" @onclick="ToggleAddVisit">@(_showAddVisit ? "Cancel" : "Add visit")</button>
                }
            </div>
            <Outcome Value="_visitFb" />
            @if (_showAddVisit && Session.Has(PermissionCodes.PatientWrite))
            {
                <div class="alert alert-info" style="margin-bottom:.75rem;">
                    <div class="form-row">
                        <div class="field"><label>Visit number</label><input @bind="_newVisitNumber" class="mono" placeholder="VIS-2026-100" /></div>
                        <div class="field"><label>Type</label>
                            <select @bind="_newVisitType">@foreach (var t in Enum.GetValues<EncounterType>()) { <option value="@t">@t</option> }</select>
                        </div>
                        <div class="field"><label>Status</label>
                            <select @bind="_newVisitStatus">@foreach (var s in Enum.GetValues<EncounterStatus>()) { <option value="@s">@s</option> }</select>
                        </div>
                        <div class="field"><label>Admit (local)</label><input type="datetime-local" @bind="_newVisitAdmit" /></div>
                        <div class="field"><label>Current location</label><input @bind="_newVisitLocation" /></div>
                        <div class="field"><label>Attending provider</label>
                            <FilterableComboBox TItem="OrderingProviderRefDto" TValue="long?"
                                               Items="_providers"
                                               @bind-Value="_newVisitProviderId"
                                               DisplayText="@FormatProvider"
                                               SearchText="@SearchProvider"
                                               ItemValue="@ProviderItemValue"
                                               Clearable="true"
                                               Placeholder="Type to search providers..." />
                        </div>
                    </div>
                    <button type="button" class="btn btn-primary" disabled="@_busy" @onclick="AddVisitAsync">Save visit</button>
                </div>
            }
            @if (_visitsLoading) { <div class="loading">Loading visits...</div> }
            else if (_encounters.Count == 0) { <div class="empty">No visits on record.</div> }
            else
            {
                <table class="bb">
                    <thead><tr><th>Visit #</th><th>Type</th><th>Admit</th><th>Discharge</th><th>Location</th><th>Status</th></tr></thead>
                    <tbody>
                        @foreach (var v in _encounters)
                        {
                            <tr class="@(v.Status == EncounterStatus.Active ? "row-active" : "")">
                                <td class="mono"><strong>@v.VisitNumber</strong></td>
                                <td>@v.EncounterType</td>
                                <td class="nowrap">@(v.AdmitUtc?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                                <td class="nowrap">@(v.DischargeUtc?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                                <td>@(v.CurrentLocation ?? v.AdmissionLocation ?? "—")</td>
                                <td><span class="@(v.Status == EncounterStatus.Active ? "badge badge-green" : "badge")">@v.Status</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    }

    @if (_tab == "orders")
    {
        <div class="bb-card">
            <div class="bb-card-title flex-between">
                <h3>Orders</h3>
                @if (Session.Has(PermissionCodes.PatientWrite))
                {
                    <button type="button" class="btn btn-primary btn-sm" @onclick="ToggleAddOrder">@(_showAddOrder ? "Cancel" : "Add order")</button>
                }
            </div>
            <Outcome Value="_orderFb" />
            @if (_showAddOrder && Session.Has(PermissionCodes.PatientWrite))
            {
                <div class="alert alert-info" style="margin-bottom:.75rem;">
                    @if (_encounters.Count == 0)
                    {
                        <p class="muted">Add a visit before placing an order.</p>
                    }
                    else
                    {
                        <div class="form-row">
                            <div class="field"><label>Visit</label>
                                <select @bind="_newOrderEncounterId">
                                    @foreach (var v in _encounters)
                                    {
                                        <option value="@v.Id">@v.VisitNumber</option>
                                    }
                                </select>
                            </div>
                            <div class="field"><label>Priority</label>
                                <select @bind="_newOrderPriority">@foreach (var p in Enum.GetValues<OrderPriority>()) { <option value="@p">@p</option> }</select>
                            </div>
                            <div class="field"><label>Ordering location</label>
                                <select @bind="_newOrderLocationId">
                                    @foreach (var l in _orderingLocations)
                                    {
                                        <option value="@l.Id">@l.DisplayName (@l.Code)</option>
                                    }
                                </select>
                            </div>
                            <div class="field"><label>Ordering provider</label>
                                <FilterableComboBox TItem="OrderingProviderRefDto" TValue="long?"
                                                   Items="_providers"
                                                   @bind-Value="_newOrderProviderId"
                                                   DisplayText="@FormatProvider"
                                                   SearchText="@SearchProvider"
                                                   ItemValue="@ProviderItemValue"
                                                   Clearable="true"
                                                   Placeholder="Type to search providers..." />
                            </div>
                        </div>
                        <div class="form-row" style="margin-top:.5rem;">
                            <div class="field" style="flex:1;">
                                @if (_testGroupers.Count > 0)
                                {
                                    <label>Test groupers</label>
                                    <div class="checkbox-list" style="margin-bottom:.5rem;">
                                        @foreach (var g in _testGroupers)
                                        {
                                            <label class="checkbox-item">
                                                <input type="checkbox" checked="@IsGrouperSelected(g.Code, _newOrderGrouperCodes)" @onchange="e => ToggleNewOrderGrouper(g, e)" />
                                                <strong>@g.Name</strong> <span class="muted mono">(@g.Code)</span>
                                                <span class="muted"> — @string.Join(", ", g.MemberTestCodes)</span>
                                            </label>
                                        }
                                    </div>
                                }
                                <label>Tests</label>
                                <div class="checkbox-list">
                                    @foreach (var t in _testDefs)
                                    {
                                        <label class="checkbox-item">
                                            <input type="checkbox" checked="@_newOrderTestCodes.Contains(t.Code)" @onchange="e => ToggleNewOrderTest(t.Code, e)" />
                                            @t.Name <span class="muted mono">(@t.Code)</span>
                                        </label>
                                    }
                                </div>
                            </div>
                            <div class="field" style="flex:1;">
                                <label>Products</label>
                                <div class="checkbox-list">
                                    @foreach (var pt in _productTypes)
                                    {
                                        <label class="checkbox-item">
                                            <input type="checkbox" checked="@_newOrderProductTypeIds.Contains(pt.Id)" @onchange="e => ToggleNewOrderProduct(pt.Id, e)" />
                                            @pt.Name
                                        </label>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="field" style="grid-column:1/-1;max-width:420px;">
                            <label>Specimen (optional)</label>
                            <select @bind="_newOrderSpecimenId">
                                <option value="0">Auto-link most recent accepted specimen</option>
                                @foreach (var s in LinkableSpecimens)
                                {
                                    <option value="@s.Id">@s.AccessionNumber — @s.SpecimenType</option>
                                }
                            </select>
                        </div>
                        <p class="muted" style="margin:.5rem 0 0;font-size:.85rem;">Link a specimen to inherit this order's tests on the worklist. Leave auto-link to use the most recent accepted specimen, or pick one explicitly.</p>
                        <button type="button" class="btn btn-primary" disabled="@_busy" @onclick="AddOrderAsync">Save order</button>
                    }
                </div>
            }
            <div class="form-row" style="margin-bottom:.75rem;">
                <div class="field">
                    <label>Visit</label>
                    <select @bind="_orderVisitFilter" @bind:after="LoadOrdersAsync">
                        <option value="0">All visits</option>
                        @foreach (var v in _encounters)
                        {
                            <option value="@v.Id">@v.VisitNumber</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label>Type</label>
                    <select @bind="_orderCategoryFilter" @bind:after="LoadOrdersAsync">
                        <option value="">All</option>
                        <option value="Test">Test</option>
                        <option value="Product">Product</option>
                        <option value="Mixed">Mixed</option>
                    </select>
                </div>
                <div class="field">
                    <label>Active</label>
                    <select @bind="_orderActiveFilter" @bind:after="LoadOrdersAsync">
                        <option value="">All</option>
                        <option value="true">Active only</option>
                        <option value="false">Historical</option>
                    </select>
                </div>
                <div class="field" style="flex:2;">
                    <label>Search</label>
                    <input @bind="_orderSearch" @bind:event="oninput" @onkeyup="LoadOrdersAsync" placeholder="Order name, accession, visit, provider" />
                </div>
            </div>
            @if (_ordersLoading) { <div class="loading">Loading orders...</div> }
            else if (_orders.Count == 0) { <div class="empty">No orders.</div> }
            else
            {
                <table class="bb">
                    <thead><tr><th>Date/time</th><th>Visit</th><th>Type</th><th>Order</th><th>Priority</th><th>Location</th><th>Provider</th><th>Specimen</th><th>Status</th><th>Fulfillment</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var o in _orders)
                        {
                            <tr class="@OrderRowClass(o)">
                                <td class="nowrap">@o.OrderedUtc.ToString("yyyy-MM-dd HH:mm")</td>
                                <td class="mono">@o.VisitNumber</td>
                                <td>@o.OrderCategory</td>
                                <td>
                                    <div class="muted mono" style="margin-bottom:.15rem;">@o.OrderNumber</div>
                                    @foreach (var line in o.Lines)
                                    {
                                        <div>@line.LineName <span class="muted">(@(line.LineCategory == OrderCategory.Test ? line.TestCode : "product"))</span></div>
                                    }
                                </td>
                                <td>@if (o.IsUrgentPriority) { <span class="badge badge-red">@o.Priority</span> } else { @o.Priority }</td>
                                <td>@o.OrderingLocationName</td>
                                <td>@(o.OrderingProvider ?? "—")</td>
                                <td class="mono">
                                    @(o.AccessionNumber ?? "—")
                                    @if (Session.Has(PermissionCodes.PatientWrite) && o.IsActive)
                                    {
                                        <button type="button" class="btn btn-ghost btn-sm" style="margin-left:.35rem;" @onclick="() => BeginLinkSpecimen(o)">
                                            @(_linkingOrderId == o.Id ? "Cancel" : string.IsNullOrEmpty(o.AccessionNumber) ? "Link" : "Change")
                                        </button>
                                    }
                                </td>
                                <td><span class="@Ui.Badge(o.Status)">@o.Status</span></td>
                                <td>@(o.ResultStatus?.ToString() ?? o.FulfillmentStatus?.ToString() ?? "—")</td>
                                <td class="right nowrap">
                                    @if (Session.Has(PermissionCodes.PatientWrite) && o.IsActive)
                                    {
                                        <button type="button" class="btn btn-ghost btn-sm" @onclick="() => BeginEditOrder(o)">@(_editingOrderId == o.Id ? "Cancel" : "Edit")</button>
                                    }
                                </td>
                            </tr>
                            @if (_linkingOrderId == o.Id)
                            {
                                <tr>
                                    <td colspan="11">
                                        <div class="alert alert-info" style="margin:.25rem 0;">
                                            <p class="muted" style="margin:0 0 .5rem;">Link specimen to order <span class="mono">@o.OrderNumber</span>. Tests on this order will appear on the worklist for the selected specimen.</p>
                                            <div class="flex gap" style="align-items:end;">
                                                <div class="field" style="flex:1;max-width:420px;margin:0;">
                                                    <label>Specimen</label>
                                                    <select @bind="_linkSpecimenId">
                                                        <option value="0">— Select —</option>
                                                        @foreach (var s in LinkableSpecimens)
                                                        {
                                                            <option value="@s.Id">@s.AccessionNumber — @s.SpecimenType (@s.CollectedUtc.ToString("yyyy-MM-dd HH:mm"))</option>
                                                        }
                                                    </select>
                                                </div>
                                                <button type="button" class="btn btn-primary btn-sm" disabled="@(_busy || _linkSpecimenId <= 0)" @onclick="() => LinkSpecimenAsync(o.Id)">Link specimen</button>
                                            </div>
                                            @if (!LinkableSpecimens.Any())
                                            {
                                                <p class="muted" style="margin:.5rem 0 0;">No accepted, non-expired specimens are available. Accession a specimen first.</p>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                            @if (_editingOrderId == o.Id)
                            {
                                <tr>
                                    <td colspan="11">
                                        <div class="alert alert-info" style="margin:.25rem 0;">
                                            <p class="muted" style="margin:0 0 .5rem;">Editing order <span class="mono">@o.OrderNumber</span></p>
                                            <div class="form-row">
                                                <div class="field"><label>Visit</label>
                                                    <select @bind="_editOrderEncounterId">
                                                        @foreach (var v in _encounters)
                                                        {
                                                            <option value="@v.Id">@v.VisitNumber</option>
                                                        }
                                                    </select>
                                                </div>
                                                <div class="field"><label>Priority</label>
                                                    <select @bind="_editOrderPriority">@foreach (var p in Enum.GetValues<OrderPriority>()) { <option value="@p">@p</option> }</select>
                                                </div>
                                                <div class="field"><label>Ordering location</label>
                                                    <select @bind="_editOrderLocationId">
                                                        @foreach (var l in _orderingLocations)
                                                        {
                                                            <option value="@l.Id">@l.DisplayName (@l.Code)</option>
                                                        }
                                                    </select>
                                                </div>
                                                <div class="field"><label>Ordering provider</label>
                                                    <FilterableComboBox TItem="OrderingProviderRefDto" TValue="long?"
                                                                       Items="_providers"
                                                                       @bind-Value="_editOrderProviderId"
                                                                       DisplayText="@FormatProvider"
                                                                       SearchText="@SearchProvider"
                                                                       ItemValue="@ProviderItemValue"
                                                                       Clearable="true"
                                                                       Placeholder="Type to search providers..." />
                                                </div>
                                            </div>
                                            <div class="form-row" style="margin-top:.5rem;">
                                                <div class="field" style="flex:1;">
                                                    @if (_testGroupers.Count > 0)
                                                    {
                                                        <label>Test groupers</label>
                                                        <div class="checkbox-list" style="margin-bottom:.5rem;">
                                                            @foreach (var g in _testGroupers)
                                                            {
                                                                <label class="checkbox-item">
                                                                    <input type="checkbox" checked="@IsGrouperSelected(g.Code, _editOrderGrouperCodes)" @onchange="e => ToggleEditOrderGrouper(g, e)" />
                                                                    <strong>@g.Name</strong> <span class="muted mono">(@g.Code)</span>
                                                                </label>
                                                            }
                                                        </div>
                                                    }
                                                    <label>Tests</label>
                                                    <div class="checkbox-list">
                                                        @foreach (var t in _testDefs)
                                                        {
                                                            <label class="checkbox-item">
                                                                <input type="checkbox" checked="@_editOrderTestCodes.Contains(t.Code)" @onchange="e => ToggleEditOrderTest(t.Code, e)" />
                                                                @t.Name <span class="muted mono">(@t.Code)</span>
                                                            </label>
                                                        }
                                                    </div>
                                                </div>
                                                <div class="field" style="flex:1;">
                                                    <label>Products</label>
                                                    <div class="checkbox-list">
                                                        @foreach (var pt in _productTypes)
                                                        {
                                                            <label class="checkbox-item">
                                                                <input type="checkbox" checked="@_editOrderProductTypeIds.Contains(pt.Id)" @onchange="e => ToggleEditOrderProduct(pt.Id, e)" />
                                                                @pt.Name
                                                            </label>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                            <button type="button" class="btn btn-primary" disabled="@_busy" @onclick="SaveOrderAsync">Save changes</button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            }
        </div>
    }

    @if (_tab == "specimens")
    {
    <div class="bb-card">
        <p class="muted" style="margin:0 0 .75rem;">For order-driven result entry, use the <strong>Tests</strong> tab.</p>
        <div class="bb-card-title">
            <h3>Specimens</h3>
            @if (Session.Has(PermissionCodes.SpecimenAccession))
            {
                <button class="btn btn-primary btn-sm" @onclick="() => _showAccession = !_showAccession">@(_showAccession ? "Cancel" : "Accession specimen")</button>
            }
        </div>

        @if (_showAccession)
        {
            <div class="alert alert-info">
                <Outcome Value="_accessionFb" />
                <div class="form-row">
                    <div class="field"><label>Accession #</label><input @bind="_acc.AccessionNumber" /></div>
                    <div class="field"><label>Specimen type</label>
                        <select @bind="_acc.SpecimenType">
                            @if (_specimenTypes.Count == 0)
                            {
                                <option value="EDTA">EDTA — EDTA Whole Blood</option>
                            }
                            else
                            {
                                @foreach (var t in _specimenTypes)
                                {
                                    <option value="@t.Code">@t.Code — @t.Description</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="field"><label>Collected (UTC)</label><input type="datetime-local" @bind="_acc.CollectedLocal" /></div>
                    <div class="field"><label>Validity hours (optional)</label><input type="number" @bind="_acc.ValidityHours" /></div>
                    <div class="field"><label>Identifier 1 (MRN)</label><input @bind="_acc.Identifier1Value" placeholder="Defaults to patient MRN" /></div>
                    <div class="field"><label>Identifier 2 (DOB yyyy-MM-dd)</label><input @bind="_acc.Identifier2Value" placeholder="Defaults to patient DOB" /></div>
                </div>
                <button class="btn btn-primary" disabled="@_busy" @onclick="AccessionAsync">Accession</button>
            </div>
        }

        @if (_specimens.Count == 0)
        {
            <div class="empty">No specimens.</div>
        }
        else
        {
            <table class="bb">
                <thead><tr><th>Accession</th><th>Type</th><th>Collected</th><th>Expires</th><th>Status</th><th></th></tr></thead>
                <tbody>
                    @foreach (var s in _specimens)
                    {
                        <tr>
                            <td class="mono">@s.AccessionNumber</td>
                            <td>@(s.SpecimenTypeDescription ?? s.SpecimenType)</td>
                            <td class="nowrap">@s.CollectedUtc.ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="nowrap">@(s.ExpiresUtc?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                            <td><span class="@Ui.Badge(s.Status)">@s.Status</span></td>
                            <td class="right">
                                <button class="btn btn-ghost btn-sm" @onclick="() => SelectSpecimen(s)">@(_selectedSpecimen?.Id == s.Id ? "Hide" : "Results")</button>
                                @if (s.Status == SpecimenStatus.Accepted && Session.Has(PermissionCodes.SpecimenEdit))
                                {
                                    <button class="btn btn-ghost btn-sm" @onclick="() => BeginEdit(s)">@(_editId == s.Id ? "Cancel edit" : "Edit")</button>
                                }
                                @if (s.Status == SpecimenStatus.Accepted && Session.Has(PermissionCodes.SpecimenReject))
                                {
                                    <button class="btn btn-ghost btn-sm" @onclick="() => BeginReject(s)">Reject</button>
                                }
                            </td>
                        </tr>
                        @if (_editId == s.Id)
                        {
                            <tr><td colspan="6">
                                <div class="alert alert-info" style="margin:0;">
                                    <Outcome Value="_editFb" />
                                    <div class="form-row">
                                        <div class="field"><label>Accession #</label><input value="@s.AccessionNumber" disabled /></div>
                                        <div class="field"><label>Specimen type</label><input value="@(s.SpecimenTypeDescription ?? s.SpecimenType)" disabled /></div>
                                        <div class="field"><label>Collected (UTC)</label><input type="datetime-local" @bind="_edit.CollectedLocal" /></div>
                                        <div class="field"><label>Barcode</label><input @bind="_edit.Barcode" /></div>
                                        <div class="field"><label>Draw location</label><input @bind="_edit.DrawLocation" /></div>
                                        <div class="field"><label>Collector</label><input @bind="_edit.Collector" /></div>
                                        <div class="field"><label>Validity hours (optional)</label><input type="number" @bind="_edit.ValidityHours" /></div>
                                    </div>
                                    <div class="flex gap">
                                        <button class="btn btn-primary btn-sm" disabled="@_busy" @onclick="() => SaveEditAsync(s.Id)">Save</button>
                                        <button class="btn btn-secondary btn-sm" @onclick="() => _editId = null">Cancel</button>
                                    </div>
                                </div>
                            </td></tr>
                        }
                        @if (_rejectId == s.Id)
                        {
                            <tr><td colspan="6">
                                <div class="flex gap">
                                    <input @bind="_rejectReason" placeholder="Rejection reason" style="flex:1;" />
                                    <button class="btn btn-danger btn-sm" disabled="@_busy" @onclick="() => RejectAsync(s.Id)">Confirm reject</button>
                                    <button class="btn btn-secondary btn-sm" @onclick="() => _rejectId = null">Cancel</button>
                                </div>
                            </td></tr>
                        }
                        @if (_selectedSpecimen?.Id == s.Id)
                        {
                            <tr><td colspan="6">
                                @if (_specimenWorklist.Count > 0)
                                {
                                    <div style="margin-bottom:.75rem;">
                                        <strong>Tests from linked orders</strong>
                                        <table class="bb" style="margin-top:.35rem;">
                                            <thead><tr><th>Test</th><th>Order #</th><th>Status</th></tr></thead>
                                            <tbody>
                                                @foreach (var item in _specimenWorklist)
                                                {
                                                    <tr>
                                                        <td>@item.TestName <span class="mono muted">@item.TestCode</span></td>
                                                        <td class="mono">@item.OrderNumber</td>
                                                        <td>@(item.CurrentResultStatus?.ToString() ?? (item.CanEnterResults ? "Pending" : item.BlockReason ?? "Blocked"))</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                        <p class="muted" style="margin:.35rem 0 0;font-size:.85rem;">Enter results on the <strong>Tests</strong> tab after linking.</p>
                                    </div>
                                }
                                else
                                {
                                    <p class="muted" style="margin:0 0 .75rem;">No tests from linked orders. Link this specimen to an order on the Orders tab to inherit its tests.</p>
                                }
                                @RenderResults(s)
                            </td></tr>
                        }
                    }
                </tbody>
            </table>
        }
    </div>
    }

    @if (_tab == "tests")
    {
        <div class="bb-card">
            <div class="bb-card-title">
                <h3>Test results</h3>
                <button class="btn btn-secondary btn-sm" disabled="@_busy" @onclick="LoadTestWorklistAsync">Refresh</button>
            </div>
            <div class="form-row" style="margin-bottom:.75rem;">
                <div class="field">
                    <label>Status</label>
                    <select @bind="_testStatusFilter" @bind:after="LoadTestWorklistAsync">
                        <option value="pending">Pending</option>
                        <option value="completed">Completed</option>
                        <option value="all">Both</option>
                    </select>
                </div>
                <div class="field" style="flex:1;">
                    <label>Search</label>
                    <input @bind="_testSearch" @bind:event="oninput" placeholder="Test, order #, accession..." />
                </div>
            </div>
            @if (_testsLoading)
            {
                <div class="loading">Loading tests...</div>
            }
            else if (_testWorklist.Count == 0)
            {
                <div class="empty">No tests match this filter.</div>
            }
            else
            {
                <table class="bb">
                    <thead><tr><th>Test</th><th>Order #</th><th>Accession</th><th>Status</th><th>Priority</th><th>Ordered</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var item in _testWorklist)
                        {
                            <tr class="@TestRowClass(item)">
                                <td><strong>@item.TestName</strong> <span class="mono muted">@item.TestCode</span></td>
                                <td class="mono">@item.OrderNumber</td>
                                <td class="mono">@(item.AccessionNumber ?? "—")</td>
                                <td>
                                    @if (item.CurrentResultStatus is not null)
                                    {
                                        <span class="@Ui.Badge(item.CurrentResultStatus.Value)">@item.CurrentResultStatus</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-gray">Pending</span>
                                    }
                                </td>
                                <td>@item.Priority</td>
                                <td class="nowrap">@item.OrderedUtc.ToString("yyyy-MM-dd HH:mm")</td>
                                <td class="right">
                                    <button class="btn btn-ghost btn-sm" @onclick="() => ToggleTestEntry(item.OrderLineId)">
                                        @(_expandedTestLineId == item.OrderLineId ? "Hide" : "Enter")
                                    </button>
                                </td>
                            </tr>
                            @if (_expandedTestLineId == item.OrderLineId)
                            {
                                <tr><td colspan="7">
                                    <TestResultEntryPanel WorkItem="item" OnSaved="OnTestResultSaved" />
                                </td></tr>
                            }
                        }
                    </tbody>
                </table>
            }
        </div>
    }

    @if (_tab == "test-history")
    {
        <div class="bb-card">
            <div class="bb-card-title">
                <h3>Test history</h3>
                <button class="btn btn-secondary btn-sm" disabled="@_busy" @onclick="LoadTestHistoryAsync">Refresh</button>
            </div>
            <div class="form-row" style="margin-bottom:.75rem;">
                <div class="field" style="flex:1;">
                    <label>Search</label>
                    <input @bind="_testHistorySearch" @bind:event="oninput" placeholder="Test, accession, order #..." />
                </div>
            </div>
            @if (_testHistoryLoading)
            {
                <div class="loading">Loading test history...</div>
            }
            else if (FilteredTestHistory.Count == 0)
            {
                <div class="empty">@(string.IsNullOrWhiteSpace(_testHistorySearch) ? "No verified results." : "No verified results match this search.")</div>
            }
            else
            {
                <table class="bb">
                    <thead><tr><th>Verified</th><th>Test</th><th>Result</th><th>Interpretation</th><th>Accession</th><th>Order</th><th>Verified by</th></tr></thead>
                    <tbody>
                        @foreach (var h in FilteredTestHistory)
                        {
                            <tr>
                                <td class="nowrap">@h.VerifiedUtc.ToString("yyyy-MM-dd HH:mm")</td>
                                <td><strong>@h.TestName</strong> <span class="mono muted">@h.TestCode</span></td>
                                <td>@DisplayHistoryValue(h)</td>
                                <td>@(h.Interpretation ?? "—")</td>
                                <td class="mono">@(string.IsNullOrWhiteSpace(h.AccessionNumber) ? "—" : h.AccessionNumber)</td>
                                <td class="mono">@(h.OrderNumber ?? "—")</td>
                                <td>@(h.VerifiedBy ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    }

    @if (_tab == "products")
    {
        <div class="bb-card">
            <div class="bb-card-title flex-between">
                <h3>Allocated products</h3>
                @if (Session.Has(PermissionCodes.CompatibilityAllocate))
                {
                    <button type="button" class="btn btn-primary btn-sm" @onclick="ToggleAllocatePanel">@(_showAllocate ? "Cancel" : "Allocate unit")</button>
                }
            </div>
            <Outcome Value="_allocFb" />
            @if (_allocLoading) { <div class="loading">Loading allocations...</div> }
            else if (_allocations.Count == 0) { <div class="empty">No active product allocations.</div> }
            else
            {
                <table class="bb">
                    <thead><tr><th>Unit number</th><th>Product code</th><th>Status</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var a in _allocations)
                        {
                            <tr>
                                <td class="mono">@a.UnitNumber</td>
                                <td class="mono">@a.ProductCode</td>
                                <td><span class="@Ui.Badge(a.DisplayStatus)">@DisplayAllocationStatus(a.DisplayStatus)</span></td>
                                <td>
                                    <div class="flex gap" style="flex-wrap:wrap;">
                                        @if (Session.Has(PermissionCodes.IssueCreate))
                                        {
                                            <button type="button" class="btn btn-primary btn-sm" disabled="@_busy" @onclick="() => BeginIssueAllocation(a)">Issue</button>
                                        }
                                        @if (Session.Has(PermissionCodes.CompatibilityAllocate))
                                        {
                                            <button type="button" class="btn btn-ghost btn-sm" disabled="@_busy" @onclick="() => BeginReleaseAllocation(a)">Release</button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            @if (_issuingAllocation is not null)
            {
                <div class="bb-card" style="margin-top:1rem;">
                    <div class="bb-card-title"><h3>Issue unit <span class="mono">@_issuingAllocation.UnitNumber</span></h3></div>
                    <Outcome Value="_issueFb" RequiresSignature="true" />
                    <div class="form-row">
                        <div class="field"><label>Date/time of issue</label>
                            <input type="datetime-local" @bind="_issueLocalDateTime" />
                        </div>
                        <div class="field"><label>Location to issue</label>
                            <input @bind="_issueLocation" placeholder="Ward / OR / location" />
                        </div>
                        <div class="field"><label>Person issued to</label>
                            <input @bind="_issueIssuedTo" placeholder="Nurse / courier / recipient" />
                        </div>
                        <div class="field"><label>Patient ID 1 (MRN)</label>
                            <input @bind="_issueId1" />
                        </div>
                        <div class="field"><label>Patient ID 2 (DOB yyyy-MM-dd)</label>
                            <input @bind="_issueId2" />
                        </div>
                        <div class="field"><label>Second verifier</label>
                            <FilterableComboBox TItem="DirectoryUserDto" TValue="string?"
                                Items="SecondVerifierChoices"
                                @bind-Value="_issueSecondVerifier"
                                DisplayText="@(u => u.Label)"
                                ItemValue="@(u => u.UserName)"
                                SearchText="@(u => u.Label)"
                                Clearable="true"
                                Placeholder="Different active user" />
                        </div>
                        <div class="field"><label>User id issuing</label>
                            <input value="@(Session.UserName ?? "—")" disabled />
                        </div>
                        <div class="field" style="grid-column:1/-1;"><label>Comments (optional)</label>
                            <textarea rows="2" @bind="_issueComment"></textarea>
                        </div>
                    </div>
                    <div class="field" style="min-width:14rem;"><label>Appearance at issue</label>
                        <select @bind="_issueAppearance">
                            @foreach (var a in Enum.GetValues<UnitAppearance>()) { <option value="@a">@a</option> }
                        </select>
                    </div>
                    <UnitScanVerificationPanel Scan="_issueScan" />

                    @if (_showIssueOverride)
                    {
                        <div class="bb-card" style="background:#fff8f0;margin-top:.75rem;border:1px solid #e8c48a;">
                            <strong>Issue override required</strong>
                            <p class="muted">The issue gate reported warnings. Provide a reason, authorizer, and electronic signature to proceed.</p>
                            <div class="form-row">
                                <div class="field"><label>Override reason</label><input @bind="_issueOverrideReason" /></div>
                                <div class="field"><label>Authorized by</label><input @bind="_issueAuthorizedBy" placeholder="@Session.UserName" /></div>
                                <div class="field"><label>Meaning of signature</label><input @bind="_issueSignatureMeaning" placeholder="I authorize issue override" /></div>
                                <div class="field"><label>Password / PIN</label><input type="password" @bind="_issueSignatureSecret" /></div>
                            </div>
                            <div class="flex gap" style="margin-top:.5rem;">
                                <button class="btn btn-danger btn-sm" disabled="@_busy" @onclick="IssueAllocationWithOverrideAsync">Sign &amp; issue</button>
                                <button class="btn btn-ghost btn-sm" @onclick="CancelIssueAllocation">Cancel</button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="flex gap" style="margin-top:.75rem;">
                            <button class="btn btn-primary" disabled="@_busy" @onclick="IssueAllocationAsync">Confirm issue</button>
                            <button class="btn btn-ghost" @onclick="CancelIssueAllocation">Cancel</button>
                        </div>
                    }
                </div>
            }

            @if (_releasingAllocationId is not null)
            {
                <div class="bb-card" style="margin-top:1rem;background:#fff8f0;">
                    <div class="field"><label>Release reason</label><input @bind="_releaseReason" placeholder="Reason for releasing allocation" /></div>
                    <div class="flex gap" style="margin-top:.5rem;">
                        <button class="btn btn-danger btn-sm" disabled="@_busy" @onclick="ReleaseAllocationAsync">Confirm release</button>
                        <button class="btn btn-ghost btn-sm" @onclick="() => _releasingAllocationId = null">Cancel</button>
                    </div>
                </div>
            }
        </div>

        @if (_showAllocate && Session.Has(PermissionCodes.CompatibilityAllocate))
        {
            <div class="bb-card" style="margin-top:1rem;">
                <div class="bb-card-title"><h3>Allocate unit</h3></div>
                <p class="muted">Select an ABO/Rh-compatible Available unit. Crossmatch-required products will order the selected XM/CXM test.</p>
                <div class="form-row">
                    <div class="field"><label>Visit</label>
                        <select @bind="_allocEncounterId">
                            <option value="0">— Active visit (auto) —</option>
                            @foreach (var v in _encounters.Where(e => e.Status == EncounterStatus.Active))
                            {
                                <option value="@v.Id">@v.VisitNumber</option>
                            }
                        </select>
                    </div>
                    <div class="field"><label>Specimen (optional)</label>
                        <select @bind="_allocSpecimenId">
                            <option value="0">— None —</option>
                            @foreach (var s in LinkableSpecimens)
                            {
                                <option value="@s.Id">@s.AccessionNumber</option>
                            }
                        </select>
                    </div>
                </div>

                @if (_compatUnitsLoading) { <div class="loading">Loading compatible units...</div> }
                else if (!string.IsNullOrWhiteSpace(_compatUnitsError)) { <div class="alert alert-warning">@_compatUnitsError</div> }
                else if (_compatibleUnits.Count == 0) { <div class="empty">No ABO/Rh-compatible Available units.</div> }
                else
                {
                    <table class="bb" style="margin-top:.75rem;">
                        <thead><tr><th></th><th>Unit</th><th>Product</th><th>ABO/Rh</th><th>Expires</th><th>XM?</th></tr></thead>
                        <tbody>
                            @foreach (var u in _compatibleUnits)
                            {
                                <tr class="@(_selectedUnitId == u.BloodUnitId ? "selected" : null)">
                                    <td><input type="radio" name="alloc-unit" checked="@(_selectedUnitId == u.BloodUnitId)" @onchange="() => SelectAllocUnit(u)" /></td>
                                    <td class="mono">@u.UnitNumber</td>
                                    <td class="mono">@u.ProductCode</td>
                                    <td>@u.BloodType</td>
                                    <td class="nowrap">@u.ExpiresUtc.ToString("yyyy-MM-dd")</td>
                                    <td>@(u.RequiresCrossmatch ? "Yes" : "No")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }

                @if (_selectedUnit is not null && _selectedUnit.RequiresCrossmatch)
                {
                    <div class="form-row" style="margin-top:.75rem;">
                        <div class="field"><label>Crossmatch test</label>
                            <select @bind="_allocXmTestCode">
                                @foreach (var t in _crossmatchTests)
                                {
                                    <option value="@t.Code">@t.Name (@t.Code) — @t.ResultValueType</option>
                                }
                            </select>
                        </div>
                    </div>
                    @if (NeedsAbHistoryOverride)
                    {
                        <div class="bb-card" style="background:#fff8f0;margin-top:.75rem;border:1px solid #e8c48a;">
                            <strong>Exception: antibody history</strong>
                            <p class="muted">This patient has antibody history. Simple crossmatch requires an authorized override and comment. Prefer complex crossmatch.</p>
                            @if (Session.SecurityLevel < _allocXmMinLevel)
                            {
                                <div class="alert alert-warning">Your security level (@Session.SecurityLevel) is below the minimum (@_allocXmMinLevel) required to override.</div>
                            }
                            else
                            {
                                <div class="form-row">
                                    <div class="field"><label>Authorized by</label><input @bind="_allocAuthorizedBy" placeholder="@Session.UserName" /></div>
                                    <div class="field" style="grid-column:1/-1;"><label>Override comment</label><input @bind="_allocOverrideReason" /></div>
                                </div>
                            }
                        </div>
                    }
                }

                <div class="flex gap" style="margin-top:1rem;">
                    <button class="btn btn-primary" disabled="@(_busy || _selectedUnitId is null)" @onclick="AllocateUnitAsync">Reserve unit</button>
                </div>
            </div>
        }
    }

    @if (_tab == "history")
    {
        <div class="bb-card">
            <div class="bb-card-title"><h3>Product history</h3></div>
            @if (_historyLoading) { <div class="loading">Loading product history...</div> }
            else if (_productHistory.Count == 0) { <div class="empty">No product events.</div> }
            else
            {
                <table class="bb">
                    <thead><tr><th>Date/time</th><th>Event</th><th>Unit</th><th>Product</th><th>Unit type</th><th>Visit</th><th>Order</th><th>Compatibility</th><th>Disposition</th></tr></thead>
                    <tbody>
                        @foreach (var h in _productHistory)
                        {
                            <tr class="@HistoryRowClass(h)">
                                <td class="nowrap">@h.EventUtc.ToString("yyyy-MM-dd HH:mm")</td>
                                <td><strong>@h.EventType</strong></td>
                                <td class="mono">@(h.UnitNumber ?? "—")</td>
                                <td>@(h.ProductTypeName ?? "—")</td>
                                <td>@(h.UnitBloodType ?? "—")</td>
                                <td class="mono">@(h.HasMissingVisitContext ? "—" : (h.VisitNumber ?? "—"))</td>
                                <td class="mono">@(h.OrderNumber ?? "—")</td>
                                <td>@(h.CompatibilityStatus ?? "—")</td>
                                <td>@(h.FinalDisposition ?? "—")@if (h.ReactionSuspected) { <span class="badge badge-red">Reaction</span> }</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    }
}

