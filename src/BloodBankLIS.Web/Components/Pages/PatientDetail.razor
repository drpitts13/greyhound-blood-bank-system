    private async Task LoadPanelDefinitionAsync(string testCode)
    {
        var r = await Api.GetTestDefinitionForEntryAsync(testCode);
        if (!r.Succeeded || r.Value is null)
        {
            _panelSubtests = Array.Empty<ResolvedPanelSubtestDto>().ToList();
            _panelTestName = "ABO/Rh typing";
            return;
        }

        _panelTestCode = r.Value.Code;
        _panelTestName = r.Value.Name;
        _panelSubtests = r.Value.PanelSubtests.ToList();
        ResetSubtestValues();
    }

    private void ResetSubtestValues()
    {
        _subtestValues = _panelSubtests.ToDictionary(
            s => s.SubtestCode,
            s => !s.Required ? "NT" : (s.Choices.FirstOrDefault()?.Code ?? "0"),
            StringComparer.OrdinalIgnoreCase);
        _optionalSubtestPerformed = _panelSubtests
            .Where(s => !s.Required)
            .ToDictionary(s => s.SubtestCode, _ => false, StringComparer.OrdinalIgnoreCase);
    }

    private string GetSubtestValue(string code) =>
        _subtestValues.TryGetValue(code, out var v) ? v : string.Empty;

    private void SetSubtestValue(string code, ChangeEventArgs e) =>
        _subtestValues[code] = e.Value?.ToString() ?? string.Empty;

    private bool IsOptionalPerformed(string code) =>
        _optionalSubtestPerformed.TryGetValue(code, out var p) && p;

    private void OnOptionalPerformedChanged(string code, ChangeEventArgs e)
    {
        _optionalSubtestPerformed[code] = e.Value is bool b && b;
    }

    private async Task EnterAboRhAsync(long specimenId)
    {
        _busy = true;
        var subtests = BuildAboRhSubtests();
        var r = await Api.EnterAboRhAsync(new EnterAboRhRequest(specimenId, _resAbo, _resRh, subtests));
        _busy = false;
        _resultFb = r.ToFeedback("ABO/Rh panel entered.");
        if (r.Succeeded) await ReloadResults(specimenId);
    }

    private Dictionary<string, string> BuildAboRhSubtests()
    {
        var map = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        foreach (var st in _panelSubtests)
        {
            if (!st.Required && !IsOptionalPerformed(st.SubtestCode))
            {
                continue;
            }

            map[st.SubtestCode] = GetSubtestValue(st.SubtestCode);
        }

        return map;
    }

