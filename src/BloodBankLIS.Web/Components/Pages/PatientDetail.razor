    private IReadOnlyList<PatientTestHistoryRowDto> FilteredTestHistory
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_testHistorySearch))
            {
                return _testHistory;
            }

            var q = _testHistorySearch.Trim();
            return _testHistory.Where(h =>
                    h.TestCode.Contains(q, StringComparison.OrdinalIgnoreCase)
                    || h.TestName.Contains(q, StringComparison.OrdinalIgnoreCase)
                    || h.AccessionNumber.Contains(q, StringComparison.OrdinalIgnoreCase)
                    || (h.OrderNumber?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false))
                .ToList();
        }
    }

