    private static List<OrderLineInputDto> BuildLineInputs(IEnumerable<string> testCodes, IEnumerable<long> productTypeIds)
    {
        var lines = testCodes
            .Select(code => new OrderLineInputDto(OrderCategory.Test, code, null))
            .Concat(productTypeIds.Select(id => new OrderLineInputDto(OrderCategory.Product, null, id)))
            .ToList();
        return lines;
    }

    private async Task AddOrderAsync()
    {
        if (_newOrderEncounterId <= 0) { _orderFb = Feedback.Fail("Select a visit."); return; }
        if (_newOrderLocationId <= 0) { _orderFb = Feedback.Fail("Select an ordering location."); return; }
        var lines = BuildLineInputs(_newOrderTestCodes, _newOrderProductTypeIds);
        if (lines.Count == 0) { _orderFb = Feedback.Fail("Select at least one test or product."); return; }

        long? specimenId = _newOrderAccessionNow ? null : (_newOrderSpecimenId > 0 ? _newOrderSpecimenId : null);
        _busy = true;
        if (_newOrderAccessionNow)
        {
            if (!Session.Has(PermissionCodes.SpecimenAccession))
            {
                _busy = false;
                _orderFb = Feedback.Fail("You do not have permission to accession a specimen.");
                return;
            }

            var accessionNumber = string.IsNullOrWhiteSpace(_orderAcc.AccessionNumber)
                ? $"ACC-{Guid.NewGuid():N}"[..16].ToUpperInvariant()
                : _orderAcc.AccessionNumber.Trim();
            var accReq = new AccessionSpecimenRequest(
                accessionNumber,
                Id,
                string.IsNullOrWhiteSpace(_orderAcc.SpecimenType) ? "EDTA" : _orderAcc.SpecimenType,
                DateTime.SpecifyKind(_orderAcc.CollectedLocal, DateTimeKind.Utc),
                ValidityHours: _orderAcc.ValidityHours,
                Identifier1Value: string.IsNullOrWhiteSpace(_orderAcc.Identifier1Value) ? null : _orderAcc.Identifier1Value,
                Identifier2Value: string.IsNullOrWhiteSpace(_orderAcc.Identifier2Value) ? null : _orderAcc.Identifier2Value,
                Comment: string.IsNullOrWhiteSpace(_orderAcc.Comment) ? null : _orderAcc.Comment);
            var acc = await Api.AccessionSpecimenAsync(accReq);
            if (!acc.Succeeded || acc.Value is null)
            {
                _busy = false;
                _orderFb = acc.ToFeedback();
                return;
            }

            specimenId = acc.Value.Id;
            _specimens = (await Api.GetPatientSpecimensAsync(Id)).Value ?? _specimens;
        }

        var orderNumber = $"ORD-{Guid.NewGuid():N}"[..16].ToUpperInvariant();
        var req = new CreateOrderRequest(
            _newOrderEncounterId,
            _newOrderLocationId,
            orderNumber,
            lines,
            _newOrderPriority,
            DateTime.UtcNow,
            _newOrderProviderId is > 0 ? _newOrderProviderId : null,
            OrderSource.Manual,
            "Manual",
            null,
            specimenId,
            string.IsNullOrWhiteSpace(_newOrderComment) ? null : _newOrderComment);
        var r = await Api.CreatePatientOrderAsync(Id, req);
        _busy = false;
        if (!r.Succeeded) { _orderFb = r.ToFeedback(); return; }
        _orderFb = r.ToFeedback(specimenId is > 0
            ? $"Order {orderNumber} created and linked to the specimen."
            : $"Order {orderNumber} created.");
        _showAddOrder = false;
        _newOrderTestCodes.Clear();
        _newOrderGrouperCodes.Clear();
        _newOrderProductTypeIds.Clear();
        _newOrderSpecimenId = 0;
        _newOrderAccessionNow = false;
        _newOrderComment = null;
        _orderAcc = new();
        _ordersLoaded = false;
        await LoadOrdersAsync();
    }

