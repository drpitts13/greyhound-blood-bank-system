            AcknowledgmentSpecialRequirements="AcknowledgmentSpecialRequirements"
            Encounters="_encounters"
            LinkableSpecimens="LinkableSpecimens"
            CompatUnitsLoading="_compatUnitsLoading"
            CompatUnitsError="_compatUnitsError"
            CompatibleUnits="_compatibleUnits"
            SelectedUnitId="_selectedUnitId"
            SelectedUnit="_selectedUnit"
