@page "/patients/{Id:long}"
@using BloodBankLIS.Application.Admin
@using BloodBankLIS.Application.Immunohematology
@using BloodBankLIS.Application.Issuing
@using BloodBankLIS.Application.PatientWorkspace
@using BloodBankLIS.Application.Reference
@using BloodBankLIS.Domain.ValueObjects
@inject BloodBankApiClient Api
@inject UserSession Session
@inject NavigationManager Nav

<PageTitle>Patient &middot; Greyhound Blood Bank LIS</PageTitle>

@if (_loading)
{
    <div class="loading">Loading patient...</div>
}
else if (_patient is null)
{
    <div class="alert alert-danger">@(_error ?? "Patient not found.")</div>
    <a class="btn btn-secondary" href="/patients">Back to patients</a>
}
else
{
    <PatientChartHeader
        Patient="_patient"
        CurrentType="_currentType"
        Exm="_exm"
        Busy="_busy"
        CanEditDemographics="CanEditDemographics"
        CanMergePatients="CanMergePatients"
        EditingDemographics="_editingDemographics"
