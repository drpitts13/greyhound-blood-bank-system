    private string _issueIssuedTo = string.Empty;
    private string _issueComment = string.Empty;
    private bool _showIssueOverride;
    private string _issueOverrideReason = string.Empty;
    private string _issueAuthorizedBy = string.Empty;
    private string _issueSignatureMeaning = "I authorize issue override";
    private string _issueSignatureSecret = string.Empty;
    private string _issueId1 = string.Empty;
    private string _issueId2 = string.Empty;
    private string? _issueSecondVerifier;
    private UnitAppearance _issueAppearance = UnitAppearance.Acceptable;
    private readonly UnitScanModel _issueScan = new();
    private List<DirectoryUserDto> _directoryUsers = new();

    private IEnumerable<DirectoryUserDto> SecondVerifierChoices =>
        _directoryUsers.Where(u => !string.Equals(u.UserName, Session.UserName, StringComparison.OrdinalIgnoreCase));

    private string _editOverrideReason = string.Empty;
    private string _editAuthorizedBy = string.Empty;

    private bool NeedsOrderXmOverride =>
        _antibodyHistory.Count > 0
        && _editOrderTestCodes.Any(c => _crossmatchTests.Any(t =>
            string.Equals(t.Code, c, StringComparison.OrdinalIgnoreCase)
            && t.ResultValueType == ResultValueType.Crossmatch))
        && !_editOrderTestCodes.Any(c => _crossmatchTests.Any(t =>
            string.Equals(t.Code, c, StringComparison.OrdinalIgnoreCase)
            && t.ResultValueType == ResultValueType.ComplexCrossmatch));

    private ResultValueType SelectedXmResultType =>
        _crossmatchTests.FirstOrDefault(t => string.Equals(t.Code, _allocXmTestCode, StringComparison.OrdinalIgnoreCase))
            ?.ResultValueType
        ?? ResultValueType.Crossmatch;

    private static readonly HashSet<string> KnownTabs = new(StringComparer.OrdinalIgnoreCase)
    {
        "overview", "visits", "orders", "specimens", "tests", "test-history", "products", "history"
    };

    private bool _tabFromQueryApplied;
    private bool _panelFromQueryApplied;
    private long _tabQueryPatientId;

    protected override async Task OnParametersSetAsync()
    {
        if (_tabQueryPatientId != Id)
        {
            _tabFromQueryApplied = false;
            _tabQueryPatientId = Id;
            _visitsLoaded = false;
            _ordersLoaded = false;
            _allocLoaded = false;
            _historyLoaded = false;
            _testsLoaded = false;
            _testHistoryLoaded = false;
            _panelFromQueryApplied = false;
            _encounters = new();
            _orders = new();
            _allocations = new();
            _productHistory = new();
        }

        await LoadAsync();
        if (!_tabFromQueryApplied
            && !string.IsNullOrWhiteSpace(TabQuery)
            && KnownTabs.Contains(TabQuery))
        {
            _tabFromQueryApplied = true;
            await SelectTab(TabQuery.Trim().ToLowerInvariant());
        }

        if (!_panelFromQueryApplied
            && string.Equals(PanelQuery, "accession", StringComparison.OrdinalIgnoreCase))
        {
            _panelFromQueryApplied = true;
            await OpenAddOrderWithAccessionAsync();
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        var p = await Api.GetPatientAsync(Id);
        if (!p.Succeeded) { _patient = null; _error = p.FailureSummary(); _loading = false; return; }
        _patient = p.Value;

        _currentType = (await Api.GetCurrentBloodTypeAsync(Id)).Value;
        _exm = (await Api.GetPatientElectronicCrossmatchEligibilityAsync(Id)).Value;
        _typeHistory = (await Api.GetBloodTypeHistoryAsync(Id)).Value ?? new();
        _antibodyHistory = (await Api.GetAntibodyHistoryAsync(Id)).Value ?? new();
        if (Session.Has(PermissionCodes.ImmunoRecord) || Session.Has(PermissionCodes.ImmunoOverride))
        {
            _abidWorkups = (await Api.GetAntibodyIdWorkupsAsync(Id)).Value ?? new();
        }
        _antigenProfiles = (await Api.GetAntigenProfilesAsync(Id)).Value ?? new();
        _bloodAttributeCatalog = (await Api.GetReferenceBloodAttributesAsync()).Value ?? new();
        _specimens = (await Api.GetPatientSpecimensAsync(Id)).Value ?? new();
        _specimenTypes = (await Api.GetReferenceSpecimenTypesAsync()).Value ?? new();
        _specialRequirements = (await Api.GetSpecialRequirementsAsync(Id)).Value ?? new();
        _srCatalog = (await Api.GetReferenceSpecialRequirementsAsync()).Value ?? new();
        if (_srDefinitionId == 0 && _srCatalog.Count > 0)
        {
            _srDefinitionId = _srCatalog[0].Id;
        }
        await LoadPanelDefinitionAsync(_panelTestCode);
        await EnsureWorkflowRibbonAsync();
        _loading = false;
    }

    private async Task EnsureWorkflowRibbonAsync()
    {
        if (!_visitsLoaded) await LoadVisitsAsync();
        if (!_ordersLoaded) await LoadOrdersAsync();
        if (!_allocLoaded) await LoadAllocationsAsync();
        if (!_historyLoaded) await LoadProductHistoryAsync();
    }

    private IReadOnlyList<PatientWorkflowStep> WorkflowSteps
    {
        get
        {
            var visit = _encounters.Count > 0;
            var order = _orders.Count > 0;
            var linked = _orders.Any(o => o.SpecimenId is > 0);
            var typed = _currentType is not null;
            var reserved = _allocations.Count > 0;
            var issued = _productHistory.Any(h => h.EventType == PatientProductHistoryEventType.Issued);
            var states = new[] { visit, order, linked, typed, reserved, issued };
            var current = Array.FindIndex(states, s => !s);
            if (current < 0) current = 5;

            return
            [
                new("visit", 1, "Visit", visit, current == 0, visit ? $"{_encounters.Count} visit(s)" : "Add a visit before ordering"),
                new("order", 2, "Order", order, current == 1, order ? $"{_orders.Count} order(s)" : "Place tests or products"),
                new("specimen", 3, "Specimen linked", linked, current == 2, linked ? "Order has an accession" : "Accession and link so tests reach the worklist"),
                new("type", 4, "Type verified", typed, current == 3, typed ? Ui.BloodType(_currentType!.Abo, _currentType.RhD) : "Verify ABO/Rh on Tests"),
                new("xm", 5, "Crossmatch / reserve", reserved, current == 4, reserved ? $"{_allocations.Count} reserved" : "Record XM and reserve a unit"),
                new("issue", 6, "Issued", issued, current == 5, issued ? "Unit issued" : "Issue from Products")
            ];
        }
    }

    private string CompatibilityHref(long? specimenId = null, long? bloodUnitId = null)
    {
        var spec = specimenId
            ?? _allocations.FirstOrDefault(a => a.SpecimenId is > 0)?.SpecimenId
            ?? LinkableSpecimens.FirstOrDefault()?.Id
            ?? _orders.FirstOrDefault(o => o.SpecimenId is > 0)?.SpecimenId;
        var href = $"/compatibility?patientId={Id}";
        if (spec is > 0) href += $"&specimenId={spec}";
        if (bloodUnitId is > 0) href += $"&bloodUnitId={bloodUnitId}";
        return href;
    }

    private string AbidHref(long? workupId = null, long? specimenId = null)
    {
        if (workupId is > 0)
        {
            return $"/patients/{Id}/antibody-id/{workupId}";
        }

        var spec = specimenId
            ?? _allocations.FirstOrDefault(a => a.SpecimenId is > 0)?.SpecimenId
            ?? LinkableSpecimens.FirstOrDefault()?.Id
            ?? _orders.FirstOrDefault(o => o.SpecimenId is > 0)?.SpecimenId;
        var href = $"/patients/{Id}/antibody-id";
        if (spec is > 0) href += $"?specimenId={spec}";
        return href;
    }

    private async Task OpenWorkflowStepAsync(string key)
    {
        switch (key)
        {
            case "visit":
                await SelectTab("visits");
                if (_encounters.Count == 0) _showAddVisit = true;
                break;
            case "order":
                await SelectTab("orders");
                if (_orders.Count == 0 && !_showAddOrder) await ToggleAddOrder();
                break;
            case "specimen":
                await OpenAddOrderWithAccessionAsync();
                break;
            case "type":
                await SelectTab("tests");
                break;
            case "xm":
                Nav.NavigateTo(CompatibilityHref());
                break;
            case "issue":
                await SelectTab("products");
                break;
        }
    }

