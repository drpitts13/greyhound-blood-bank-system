        if (r.Succeeded) { _resValue = string.Empty; await ReloadResults(specimenId); }
    }

    private bool IsAboSelfVerifyBlocked(TestResultDto r) =>
        r.Status is ResultStatus.Entered or ResultStatus.Corrected
        && string.Equals(r.TestCode, ResultService.AboRhTestCode, StringComparison.OrdinalIgnoreCase)
        && !string.IsNullOrWhiteSpace(r.EnteredBy)
        && string.Equals(r.EnteredBy, Session.UserName, StringComparison.OrdinalIgnoreCase);

    private bool CanVerifyResult(TestResultDto r) =>
        r.Status is ResultStatus.Entered or ResultStatus.Corrected
        && Session.Has(PermissionCodes.ResultVerify)
        && !IsAboSelfVerifyBlocked(r);

    private async Task VerifyAsync(long resultId, long specimenId)
    {
        _busy = true;
        var r = await Api.VerifyResultAsync(resultId);
        _busy = false;

        if (r.Blocked && r.Overridable && r.Warnings.Any(w => w.Code == AboRhDeltaRule.DeltaCode))
        {
            _deltaOverrideResultId = resultId;
            _deltaOverrideSpecimenId = specimenId;
            var def = await Api.GetAdminExceptionByCodeAsync(AboRhDeltaRule.DeltaCode);
            if (def.Succeeded && def.Value is not null)
            {
                _deltaMinLevel = def.Value.MinSecurityLevel;
            }

            _resultFb = r.ToFeedback();
            return;
        }

        _resultFb = r.ToFeedback("Result verified.");
        if (r.Succeeded)
        {
            _deltaOverrideResultId = null;
            await ReloadResults(specimenId);
            await LoadHeaderType();
        }
    }

    private async Task VerifyWithDeltaOverrideAsync()
    {
        if (_deltaOverrideResultId is null || _deltaOverrideSpecimenId is null)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_deltaOverrideReason) || string.IsNullOrWhiteSpace(_deltaSignatureMeaning))
        {
            _resultFb = Feedback.Fail("An override reason and a meaning-of-signature are required.");
            return;
        }

        _busy = true;
        var sig = await Api.RecordSignatureAsync(new SignatureRequestVm("ResultOverride", _deltaSignatureMeaning, "TestResult", ReauthenticationSecret: _deltaSignatureSecret));
        if (!sig.Succeeded || sig.Value is null)
        {
            _busy = false;
            _resultFb = sig.ToFeedback();
            return;
        }

        var req = new VerifyResultRequest(
            _deltaOverrideReason.Trim(),
            string.IsNullOrWhiteSpace(_deltaAuthorizedBy) ? Session.UserName : _deltaAuthorizedBy.Trim(),
            _deltaHistoryResolution,
            sig.Value.Id);
        var r = await Api.VerifyResultAsync(_deltaOverrideResultId.Value, req, sig.Value.Id);
        _busy = false;
        _resultFb = r.ToFeedback("Result verified with ABO/Rh override.");
        if (r.Succeeded)
        {
            var specimenId = _deltaOverrideSpecimenId.Value;
            _deltaOverrideResultId = null;
            _deltaOverrideSpecimenId = null;
            _deltaOverrideReason = string.Empty;
            await ReloadResults(specimenId);
            await LoadHeaderType();
        }
    }

    private void CancelDeltaOverride()
    {
        _deltaOverrideResultId = null;
        _deltaOverrideSpecimenId = null;
        _deltaOverrideReason = string.Empty;
    }

    private void BeginCorrect(TestResultDto r) { _correctId = r.Id; _correctValue = r.Value ?? string.Empty; _correctReason = string.Empty; }

    private async Task CorrectAsync(long specimenId)
    {
        if (_correctId is null) return;
        _busy = true;
        var r = await Api.CorrectResultAsync(_correctId.Value, new CorrectResultRequest(_correctValue, _correctReason));
        _busy = false;
        _resultFb = r.ToFeedback("Result corrected.");
        if (r.Succeeded) { _correctId = null; await ReloadResults(specimenId); }
    }

    private async Task ReloadResults(long specimenId) =>
        _results = (await Api.GetSpecimenResultsAsync(specimenId)).Value ?? new();

    private async Task LoadHeaderType()
    {
        _currentType = (await Api.GetCurrentBloodTypeAsync(Id)).Value;
        _exm = (await Api.GetPatientElectronicCrossmatchEligibilityAsync(Id)).Value;
        _typeHistory = (await Api.GetBloodTypeHistoryAsync(Id)).Value ?? new();
    }

    private RenderFragment RenderResults(SpecimenDto s) => __builder =>
    {
        <div class="stack">
            <Outcome Value="_resultFb" />
            @if (_deltaOverrideResultId is not null)
            {
                <div class="bb-card" style="background:#fff8f0;margin:.5rem 0;border:1px solid #e8c48a;">
                    <div style="margin-bottom:.5rem;"><strong>ABO/Rh historical discrepancy</strong></div>
                    @if (!CanOverrideDelta)
                    {
                        <div class="alert alert-warning">Your security level (@Session.SecurityLevel) is below the minimum required (@_deltaMinLevel) to override this exception.</div>
                        <button class="btn btn-ghost btn-sm" @onclick="CancelDeltaOverride">Dismiss</button>
                    }
                    else
                    {
                        <div class="form-row">
                            <div class="field"><label>History resolution</label>
                                <select @bind="_deltaHistoryResolution">
                                    <option value="@AboRhHistoryResolution.Retain">Retain historical type</option>
                                    <option value="@AboRhHistoryResolution.Replace">Replace with current result</option>
                                </select>
                            </div>
                            <div class="field"><label>Authorized by</label><input @bind="_deltaAuthorizedBy" placeholder="@Session.UserName" /></div>
                        </div>
                        <div class="field"><label>Override reason</label><input @bind="_deltaOverrideReason" /></div>
                        <div class="field"><label>Meaning of signature</label><input @bind="_deltaSignatureMeaning" /></div>
                        <div class="field"><label>Password / PIN</label><input type="password" @bind="_deltaSignatureSecret" /></div>
                        <div class="flex gap" style="margin-top:.5rem;">
                            <button class="btn btn-danger btn-sm" disabled="@_busy" @onclick="VerifyWithDeltaOverrideAsync">Sign &amp; verify with override</button>
                            <button class="btn btn-ghost btn-sm" @onclick="CancelDeltaOverride">Cancel</button>
                        </div>
                    }
                </div>
            }
            @if (_results.Count == 0)
            {
                <div class="muted">No results for this specimen.</div>
            }
            else
            {
                <table class="bb">
                    <thead><tr><th>Test</th><th>Value</th><th>Ver.</th><th>Status</th><th>Verified by</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var r in _results.Where(r => r.SupersededByResultId is null))
                        {
                            <tr>
                                <td class="mono">@r.TestCode</td>
                                <td>@DisplayResultValue(r)</td>
                                <td>@r.Version</td>
                                <td><span class="@Ui.Badge(r.Status)">@r.Status</span></td>
                                <td>@r.VerifiedBy</td>
                                <td class="right">
                                    @if (CanVerifyResult(r))
                                    {
                                        <button class="btn btn-ghost btn-sm" disabled="@_busy" @onclick="() => VerifyAsync(r.Id, s.Id)">Verify</button>
                                    }
                                    else if (IsAboSelfVerifyBlocked(r))
                                    {
                                        <span class="muted">Different user must verify ABO/Rh</span>
                                    }
                                    @if (r.Status == ResultStatus.Verified && Session.Has(PermissionCodes.ResultCorrect))
                                    {
                                        <button class="btn btn-ghost btn-sm" @onclick="() => BeginCorrect(r)">Correct</button>
                                    }
                                </td>
                            </tr>
                            @if (_correctId == r.Id)
                            {
                                <tr><td colspan="6">
                                    <div class="form-row">
                                        <div class="field"><label>New value</label><input @bind="_correctValue" /></div>
                                        <div class="field"><label>Reason</label><input @bind="_correctReason" /></div>
                                    </div>
                                    <button class="btn btn-primary btn-sm" disabled="@_busy" @onclick="() => CorrectAsync(s.Id)">Save correction</button>
                                    <button class="btn btn-secondary btn-sm" @onclick="() => _correctId = null">Cancel</button>
                                </td></tr>
                            }
                        }
                    </tbody>
                </table>
            }

            @if (Session.Has(PermissionCodes.ResultEnter) && s.Status == SpecimenStatus.Accepted)
            {
                <div class="bb-card" style="background:#fafbfe;margin-top:.5rem;">
                    <h4>@_panelTestName <span class="mono muted">(@_panelTestCode)</span></h4>
                    @if (_panelSubtests.Count == 0)
                    {
                        <div class="muted">No panel subtests configured for this test. Define them under Administration → Test Definitions.</div>
                    }
                    else
                    {
                    <div class="form-row">
                        <div class="field"><label>Interpreted ABO</label><select @bind="_resAbo">@foreach (var a in Enum.GetValues<AboGroup>()) { <option value="@a">@a</option> }</select></div>
                        <div class="field"><label>Interpreted Rh(D)</label><select @bind="_resRh">@foreach (var rr in Enum.GetValues<RhType>()) { <option value="@rr">@rr</option> }</select></div>
                    </div>
                    <table class="bb" style="margin-top:.5rem;">
                        <thead><tr><th>Subtest</th><th>Reaction</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var st in _panelSubtests)
                            {
                                var optional = !st.Required;
                                var performed = !optional || IsOptionalPerformed(st.SubtestCode);
                                <tr>
                                    <td>@st.Label</td>
                                    <td>
                                        <select value="@GetSubtestValue(st.SubtestCode)" @onchange="e => SetSubtestValue(st.SubtestCode, e)" disabled="@(!performed)">
                                            @if (optional) { <option value="NT">NT</option> }
                                            @foreach (var c in st.Choices)
                                            {
                                                <option value="@c.Code">@c.Label</option>
                                            }
                                        </select>
                                    </td>
                                    <td>
                                        @if (optional)
                                        {
                                            <label class="flex" style="gap:.35rem;"><input type="checkbox" checked="@IsOptionalPerformed(st.SubtestCode)" @onchange="e => OnOptionalPerformedChanged(st.SubtestCode, e)" /> Performed</label>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <button class="btn btn-primary btn-sm" style="margin-top:.6rem;" disabled="@_busy" @onclick="() => EnterAboRhAsync(s.Id)">Enter @_panelTestCode panel</button>
                    }
                    <hr style="margin:.75rem 0;border:none;border-top:1px solid var(--bb-border);" />
                    <div class="form-row">
                        <div class="field"><label>Test code</label><input @bind="_resultTestCode" /></div>
                        <div class="field"><label>Value</label><input @bind="_resValue" /></div>
                    </div>
                    <button class="btn btn-secondary btn-sm" disabled="@_busy" @onclick="() => EnterGenericAsync(s.Id)">Enter result</button>
                </div>
            }
        </div>
    };

    private sealed class AccessionModel
    {
        public string AccessionNumber { get; set; } = string.Empty;
        public string SpecimenType { get; set; } = "EDTA";
        public DateTime CollectedLocal { get; set; } = DateTime.UtcNow;
        public int? ValidityHours { get; set; }
        public string? Identifier1Value { get; set; }
        public string? Identifier2Value { get; set; }
    }

