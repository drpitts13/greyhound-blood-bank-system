        Demo="_demo"
        DemoFeedback="_demoFb"
        MergeFeedback="_mergeFb"
        @bind-MergeMrn="_mergeMrn"
        @bind-MergeReason="_mergeReason"
        AntibodyHistory="_antibodyHistory"
        ActiveSpecialRequirements="ActiveSpecialRequirements"
