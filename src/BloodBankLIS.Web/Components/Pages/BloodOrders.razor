@page "/blood-orders"
@using BloodBankLIS.Application.PatientWorkspace
@inject BloodBankApiClient Api
@inject UserSession Session

<PageTitle>Blood orders to prepare &middot; HemoCore</PageTitle>

<h1>Blood orders to prepare</h1>
<p class="muted">
    Open blood (product) orders whose units are not all reserved or issued yet, across patients: rush orders first, then by
    when they are needed, then the oldest. Each row says what is still needed and the next step. A patient with no usable specimen needs one collected
    before units can be crossmatched; otherwise reserve the units from the patient's products, which runs the
    compatibility checks.
</p>

@if (!Session.Has(PermissionCodes.CompatibilityAllocate))
{
    <div class="alert alert-warning">This list needs the allocate permission.</div>
}
else if (_rows is null)
{
    <div class="loading">Loading orders...</div>
}
else if (_rows.Count == 0)
{
    <div class="empty">No blood orders are waiting for units.</div>
}
else
{
    <div class="bb-card">
        <div class="table-scroll">
        <table class="bb" data-blood-orders>
            <thead><tr><th>Patient</th><th>Type / antibodies</th><th>Order</th><th>Products</th><th>Still needed</th><th>Specimen</th><th></th></tr></thead>
            <tbody>
                @foreach (var r in _rows)
                {
                    <tr>
                        <td><a href="@($"/patients/{r.PatientId}")">@r.PatientName</a> <span class="sub mono">@r.Mrn</span></td>
                        <td>
                            <span class="mono">@(r.CurrentBloodType ?? "No type on file")</span>
                            @if (r.ActiveAntibodies.Count > 0)
                            {
                                <span class="badge badge-red">@string.Join(", ", r.ActiveAntibodies)</span>
                            }
                            @if (r.Requirements is { Count: > 0 } needs)
                            {
                                <span class="sub" data-order-requirements><span class="badge badge-amber">Units must be</span> @string.Join(", ", needs)</span>
                            }
                        </td>
                        <td>
                            <a class="mono" href="@PatientChartUrls.Order(r.PatientId, r.OrderNumber)" title="Open this order's history on the chart" data-order-history-link>@r.OrderNumber</a>
                            @if (r.Rush)
                            {
                                <span class="badge badge-red">@Ui.EnumText(r.Priority)</span>
                            }
                            else
                            {
                                <span class="sub">@Ui.EnumText(r.Priority)</span>
                            }
                            <span class="sub nowrap">ordered @r.OrderedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                            @if (r.NeededByUtc is DateTime neededBy)
                            {
                                <span class="@(r.NeededByPassed ? "badge badge-red" : r.NeededBySoon ? "badge badge-amber" : "sub") nowrap" data-needed-by>needed by @neededBy.ToLocalTime().ToString("yyyy-MM-dd HH:mm")@(r.NeededByPassed ? " (passed)" : r.NeededInMinutes is int inMinutes ? $" (in {inMinutes} min)" : "")</span>
                            }
                        </td>
                        <td>@r.Products</td>
                        <td>
                            <strong>@r.Remaining</strong> <span class="sub">of @r.Requested (@r.Reserved reserved, @r.Issued issued)</span>
                            @if (r.ExpiredReservations is { Count: > 0 } lost)
                            {
                                @* Why the order needs units again: its reserved unit expired and the sweep ended the reservation (Cycle 599). *@
                                <div data-expired-reservations>
                                    <span class="badge badge-amber">Reserved unit expired</span>
                                    @foreach (var reason in lost)
                                    {
                                        <span class="sub">@reason</span>
                                    }
                                </div>
                            }
                        </td>
                        <td>
                            @if (r.HasUsableSpecimen && r.TypeAndScreenPending)
                            {
                                <span class="badge badge-amber" data-type-screen-pending>Type and screen not verified</span>
                            }
                            else if (r.HasUsableSpecimen)
                            {
                                <span class="sub">Usable@(r.SpecimenExpiresUtc is DateTime until ? $" until {until.ToLocalTime():yyyy-MM-dd HH:mm}" : "")</span>
                            }
                            else
                            {
                                <span class="badge badge-amber">None usable</span>
                            }
                            @if (r.TubeAwaitingReceipt is { } tube)
                            {
                                @* Drawn and on its way: receive it rather than draw again (Cycle 650). *@
                                <span class="badge badge-blue" data-tube-awaiting>Tube <span class="mono">@tube</span> drawn, not yet received</span>
                            }
                            else if (r.SpecimenExpiresBeforeNeeded)
                            {
                                <span class="badge badge-amber" title="Units crossmatched on this specimen cannot be issued after it expires" data-specimen-before-needed>Expires before needed-by: draw a new specimen</span>
                            }
                        </td>
                        <td class="right"><a class="btn btn-primary btn-sm" href="@r.Href">@r.NextStep</a></td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    </div>
}

@code {
    private List<BloodOrderToPrepareDto>? _rows;

    protected override async Task OnInitializedAsync()
    {
        if (!Session.Has(PermissionCodes.CompatibilityAllocate))
        {
            return;
        }

        var r = await Api.GetBloodOrdersToPrepareAsync();
        _rows = r.Succeeded ? r.Value ?? new() : new();
    }
}
