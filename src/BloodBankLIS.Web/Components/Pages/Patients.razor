@page "/patients"
@inject BloodBankApiClient Api
@inject UserSession Session
@inject NavigationManager Nav

<PageTitle>Patients &middot; HemoCore</PageTitle>

<div class="flex-between" style="margin-bottom:1rem;">
    <h1>Patients</h1>
    @if (Session.Has(PermissionCodes.PatientWrite))
    {
        <div class="flex gap">
            <button class="btn btn-secondary" @onclick="ToggleUnidentified" data-register-unidentified>@(_showUnidentified ? "Cancel" : "Unidentified patient")</button>
            <button class="btn btn-primary" @onclick="ToggleCreate">@(_showCreate ? "Cancel" : "Register patient")</button>
        </div>
    }
</div>

@if (_showUnidentified)
{
    <UnidentifiedPatientRegister OnRegistered="OpenRegistered" />
}

@if (_unidentified.Count > 0)
{
    <div class="alert alert-warning" data-unidentified-list>
        <strong>Unidentified patients (@_unidentified.Count).</strong> Merge each into the identified patient's chart once known, so the type and antibody history are in one place:
        @foreach (var u in _unidentified)
        {
            <a class="mono" style="margin-left:.4rem;" href="@($"/patients/{u.Id}")">@u.MedicalRecordNumber</a>
            <span class="sub">(@u.Sex, registered @u.CreatedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm"))</span>
        }
    </div>
}

@if (_showCreate)
{
    <div class="bb-card" data-scroll-on-show>
        <div class="bb-card-title"><h3>Register a patient</h3></div>
        <Outcome Value="_createFb" />
        <EditForm Model="_new" OnValidSubmit="CreateAsync">
            <div class="form-row">
                <div class="field"><label>MRN</label><InputText class="" @bind-Value="_new.MedicalRecordNumber" /></div>
                <div class="field"><label>Date of birth</label><InputDate @bind-Value="_new.DateOfBirth" @bind-Value:after="CheckDuplicatesAsync" /></div>
                <div class="field"><label>Last name</label><InputText @bind-Value="_new.LastName" @bind-Value:after="CheckDuplicatesAsync" /></div>
                <div class="field"><label>First name</label><InputText @bind-Value="_new.FirstName" @bind-Value:after="CheckDuplicatesAsync" /></div>
                <div class="field"><label>Middle name</label><InputText @bind-Value="_new.MiddleName" /></div>
                <div class="field"><label>Sex</label>
                    <InputSelect @bind-Value="_new.Sex">
                        @foreach (var s in Enum.GetValues<Sex>())
                        {
                            <option value="@s">@Ui.EnumText(s)</option>
                        }
                    </InputSelect>
                </div>
            </div>
            <div class="field">
                <label>Comment</label>
                <CodedCommentField Page="CommentPage.Patient" @bind-Value="_new.Comment" />
            </div>
            @if (_possibleDuplicates.Count > 0)
            {
                @* A second chart for the same person splits the type and antibody history: open the existing one if it is them. *@
                <div class="alert alert-warning" style="margin:.5rem 0;" data-possible-duplicates>
                    <strong>This may be a patient who is already registered.</strong> Same date of birth and a matching name:
                    <div class="table-scroll">
                    <table class="bb" style="margin-top:.4rem;">
                        <thead><tr><th>MRN</th><th>Name</th><th>DOB</th><th>Sex</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var d in _possibleDuplicates)
                            {
                                <tr>
                                    <td class="mono">@d.MedicalRecordNumber</td>
                                    <td>@d.LastName, @d.FirstName</td>
                                    <td>@d.DateOfBirth.ToString("yyyy-MM-dd")</td>
                                    <td>@d.Sex</td>
                                    <td class="right"><a class="btn btn-secondary btn-sm" href="@($"/patients/{d.Id}")">Open chart</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    </div>
                    <label style="display:flex;gap:.4rem;align-items:center;margin-top:.4rem;">
                        <input type="checkbox" @bind="_confirmDifferent" data-confirm-different />
                        I checked: this is a different person (recorded with the registration)
                    </label>
                </div>
            }
            <button class="btn btn-primary" type="submit" disabled="@(_saving || (_possibleDuplicates.Count > 0 && !_confirmDifferent))">Register</button>
        </EditForm>
    </div>
}

@if (Session.Has(PermissionCodes.PatientMerge))
{
    <p class="muted" style="margin:.25rem 0 .75rem;"><a href="/patients/duplicates" data-duplicates-link>Possible duplicates</a>: charts that may be one person, to review and merge.</p>
}

<div class="bb-card">
    <div class="field" style="max-width:360px;">
        <label>Search by name or MRN</label>
        <input @ref="_searchInput" @bind="_filter" @bind:event="oninput" @onkeydown="OnSearchKey" placeholder="Type or scan a name or MRN..." />
        @if (!string.IsNullOrWhiteSpace(_filter) && Filtered.Count == 1)
        {
            <span class="muted" style="font-size:.82rem;">Press Enter to open @Filtered[0].LastName, @Filtered[0].FirstName.</span>
        }
    </div>

    @if (_loading)
    {
        <div class="loading">Loading patients...</div>
    }
    else if (_error is not null)
    {
        <div class="alert alert-danger">@_error</div>
    }
    else if (Filtered.Count == 0)
    {
        <div class="empty">
            No patients found.
            @if (!string.IsNullOrWhiteSpace(_filter) && Session.Has(PermissionCodes.PatientWrite))
            {
                <button class="btn btn-secondary btn-sm" style="margin-left:.5rem;" @onclick="RegisterFromSearch">Register "@_filter.Trim()"</button>
            }
        </div>
    }
    else
    {
        <div class="table-scroll">
        <table class="bb">
            <thead>
                <tr><th>MRN</th><th>Name</th><th>DOB</th><th>Sex</th><th>Location</th><th>ABO/Rh</th><th>Alerts</th><th>Status</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var p in Filtered)
                {
                    <tr>
                        <td class="mono"><a href="@($"/patients/{p.Id}")">@p.MedicalRecordNumber</a></td>
                        <td>
                            <a href="@($"/patients/{p.Id}")">@p.LastName, @p.FirstName @p.MiddleName</a>
                            @if (p.Aliases is { Count: > 0 })
                            {
                                <div class="muted" style="font-size:.85rem;">Also: @string.Join("; ", p.Aliases.Select(a => a.Value))</div>
                            }
                        </td>
                        <td>@p.DateOfBirth.ToString("yyyy-MM-dd")</td>
                        <td>@p.Sex</td>
                        <td data-location>
                            @if (p.CurrentVisitNumber is null)
                            {
                                <span class="muted">No open visit</span>
                            }
                            else
                            {
                                <span title="Current visit @p.CurrentVisitNumber">@(string.IsNullOrEmpty(p.CurrentVisitWhere) ? p.CurrentVisitNumber : p.CurrentVisitWhere)</span>
                                @if (p.OtherOpenVisits > 0)
                                {
                                    <span class="badge badge-amber" data-other-open title="More than one visit is open; check which one the work belongs to">+@p.OtherOpenVisits more open</span>
                                }
                            }
                        </td>
                        <td class="mono" data-blood-type>@(p.CurrentBloodType ?? "—")</td>
                        <td data-alerts>
                            <div class="flex" style="flex-wrap:wrap;gap:.25rem;">
                            @if (p.ActiveAntibodies is { Count: > 0 } abs)
                            {
                                <span class="badge badge-red" title="Active antibodies on file">@string.Join(", ", abs)</span>
                            }
                            @if (p.ActiveSpecialRequirements > 0)
                            {
                                <span class="badge badge-amber" title="Special requirements in effect; open the chart for details">@PatientBloodBankFlags.RequirementsLabel(p.ActiveSpecialRequirements)</span>
                            }
                            @if (p.InformationalNotes > 0)
                            {
                                <span class="badge badge-blue" title="Informational notes: shown, never enforced" data-note>@PatientBloodBankFlags.NotesLabel(p.InformationalNotes)</span>
                            }
                            </div>
                        </td>
                        <td><span class="badge badge-gray">@Ui.EnumText(p.Status)</span></td>
                        @* The MRN and name already open the chart; only the extra destination gets a button. *@
                        <td class="right nowrap">
                            @if (Session.Has(PermissionCodes.LookbackManage))
                            {
                                <a class="btn btn-ghost btn-sm" href="@($"/lookback?mrn={Uri.EscapeDataString(p.MedicalRecordNumber)}")">Open Lookback</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    }
</div>

@code {
    private List<PatientDto> _patients = new();
    private string _filter = string.Empty;
    private bool _loading = true;
    private string? _error;

    private bool _showCreate;
    private bool _saving;
    private Feedback? _createFb;
    private NewPatient _new = new();

    private bool _showUnidentified;
    private List<PatientDto> _unidentified = new();

    private void ToggleUnidentified()
    {
        _showUnidentified = !_showUnidentified;
        _showCreate = false;
    }

    private void OpenRegistered(PatientDto patient) => Nav.NavigateTo($"/patients/{patient.Id}");

    private List<PatientDto> Filtered => string.IsNullOrWhiteSpace(_filter)
        ? _patients
        : _patients.Where(p => p.MatchesSearch(_filter)).ToList();

    private ElementReference _searchInput;

    // A link may open the list already filtered (for example to the chart that also holds an identifier).
    [SupplyParameterFromQuery(Name = "q")] public string? Query { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(Query))
        {
            _filter = Query.Trim();
        }

        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Finding a patient is usually the first thing done here, so be ready to type or scan.
        if (!firstRender) return;
        try
        {
            await _searchInput.FocusAsync();
        }
        catch (JSException)
        {
        }
    }

    /// <summary>Enter opens the chart when the search narrows to one patient (e.g. a scanned wristband MRN).</summary>
    private void OnSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_filter) && Filtered.Count == 1)
        {
            Nav.NavigateTo($"/patients/{Filtered[0].Id}");
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        var result = await Api.GetPatientsAsync();
        _loading = false;
        if (result.Succeeded) { _patients = result.Value!; _error = null; }
        else _error = result.FailureSummary();
        _unidentified = _patients.Where(p => p.Unidentified && p.Status != PatientStatus.Merged).OrderBy(p => p.CreatedUtc).ToList();
    }

    private void ToggleCreate() => _showCreate = !_showCreate;

    /// <summary>
    /// Open Register with what was just searched for, so a new admission is not typed twice:
    /// "Last, First" fills the names, a single token with digits is an MRN, anything else a last name.
    /// </summary>
    private void RegisterFromSearch()
    {
        var text = _filter.Trim();
        _new = new NewPatient();
        if (text.Contains(','))
        {
            var parts = text.Split(',', 2, StringSplitOptions.TrimEntries);
            _new.LastName = parts[0];
            _new.FirstName = parts[1];
        }
        else if (!text.Contains(' ') && text.Any(char.IsDigit))
        {
            _new.MedicalRecordNumber = text;
        }
        else
        {
            _new.LastName = text;
        }

        _createFb = null;
        _showCreate = true;
    }

    private async Task CreateAsync()
    {
        // No default date: a skipped field must not register the patient with a made-up DOB.
        if (_new.DateOfBirth is not DateOnly dateOfBirth)
        {
            _createFb = Feedback.Fail("Enter the date of birth.");
            return;
        }

        _saving = true;
        var req = new CreatePatientRequest(_new.MedicalRecordNumber, _new.LastName, _new.FirstName,
            string.IsNullOrWhiteSpace(_new.MiddleName) ? null : _new.MiddleName, dateOfBirth, _new.Sex,
            string.IsNullOrWhiteSpace(_new.Comment) ? null : _new.Comment,
            _confirmDifferent ? _possibleDuplicates.Select(d => d.MedicalRecordNumber).ToList() : null);
        var result = await Api.CreatePatientAsync(req);
        _saving = false;
        _createFb = result.ToFeedback("Patient registered.");
        if (!result.Succeeded)
        {
            // Someone may have registered a match meanwhile: show it, and ask again.
            await CheckDuplicatesAsync();
        }
        if (result.Succeeded && result.Value is not null)
        {
            Nav.NavigateTo($"/patients/{result.Value.Id}");
            return;
        }
    }

    private List<PatientDto> _possibleDuplicates = new();
    private bool _confirmDifferent;

    // Once the name and date of birth are in, look for the person under another MRN.
    private async Task CheckDuplicatesAsync()
    {
        if (string.IsNullOrWhiteSpace(_new.LastName) || string.IsNullOrWhiteSpace(_new.FirstName) || _new.DateOfBirth is not DateOnly dob)
        {
            _possibleDuplicates = new();
            _confirmDifferent = false;
            return;
        }

        var r = await Api.GetPossibleDuplicatePatientsAsync(_new.LastName.Trim(), _new.FirstName.Trim(), dob);
        var found = r.Succeeded ? r.Value ?? new() : new();
        if (!found.Select(d => d.Id).SequenceEqual(_possibleDuplicates.Select(d => d.Id)))
        {
            _confirmDifferent = false;
        }

        _possibleDuplicates = found;
    }

    private sealed class NewPatient
    {
        public string MedicalRecordNumber { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
        public string FirstName { get; set; } = string.Empty;
        public string? MiddleName { get; set; }
        public DateOnly? DateOfBirth { get; set; }
        public Sex Sex { get; set; } = Sex.Unknown;
        public string? Comment { get; set; }
    }
}
