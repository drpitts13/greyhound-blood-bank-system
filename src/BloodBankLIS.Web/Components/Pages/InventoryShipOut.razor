@page "/inventory/ship-out"
@inject BloodBankApiClient Api
@inject UserSession Session

<PageTitle>Ship units &middot; HemoCore</PageTitle>

<div class="flex-between">
    <h1>Ship units to another facility</h1>
    <div class="flex gap">
        <button type="button" class="btn btn-ghost" onclick="window.print()" disabled="@(_run.Count(r => r.Unit is not null) == 0)">Print packing list</button>
        <a class="btn btn-ghost" href="/inventory">Inventory</a>
    </div>
</div>
<p class="muted">
    Pack an outbound shipment (stock balancing, a patient transferred with blood): name the receiving facility and the
    shipment reference once, then scan each unit. Each scan ships that unit at once and leaves your inventory; the unit keeps
    the facility, so a recall or lookback names who to notify. Only an unreserved, unexpired unit in stock ships; anything
    else is refused with its reason. <strong>Print packing list</strong> prints the units shipped in this run.
</p>

@if (!Session.Has(PermissionCodes.InventoryReceive))
{
    <div class="muted">No permission to ship units.</div>
}
else
{
    <div class="bb-card">
        <div class="form-row" style="align-items:flex-end;">
            <div class="field" style="flex:2;">
                <label>Shipped to (facility)</label>
                <input @bind="_facility" @bind:event="oninput" maxlength="@ShipOutRule.MaxFacilityLength" placeholder="e.g. St. Mary's Hospital blood bank" data-ship-facility />
            </div>
            <div class="field">
                <label>Shipment reference (optional)</label>
                <input @bind="_reference" maxlength="@ShipOutRule.MaxReferenceLength" placeholder="Packing list or courier number" data-ship-reference />
            </div>
            <div class="field">
                <label>Scan unit number</label>
                <input @bind="_scan" @bind:event="oninput" @onkeydown="OnScanKeyAsync" disabled="@string.IsNullOrWhiteSpace(_facility)"
                       placeholder="@(string.IsNullOrWhiteSpace(_facility) ? "Name the facility first" : "Scan, then the next")" autocomplete="off" data-ship-scan />
            </div>
        </div>
        <div class="field">
            <label>Note (optional)</label>
            <input @bind="_note" placeholder="e.g. Patient transfer, ED to St. Mary's ICU" />
        </div>
        <Outcome Value="_fb" />

        @if (_run.Count > 0)
        {
            <h3 style="margin-top:1rem;">This shipment: @_run.Count(r => r.Unit is not null) shipped@(_run.Any(r => r.Unit is null) ? $", {_run.Count(r => r.Unit is null)} not shipped" : "")</h3>
            <table class="bb" data-ship-run>
                <thead><tr><th>Unit</th><th>Product code</th><th>ABO/Rh</th><th>Expires</th><th>To</th><th>Result</th></tr></thead>
                <tbody>
                    @foreach (var row in _run)
                    {
                        <tr>
                            <td class="mono">@(row.Unit?.UnitNumber ?? row.Scan)</td>
                            <td class="mono">@(row.Unit?.Isbt128ProductCode ?? row.Unit?.ProductCodeData ?? "—")</td>
                            <td>@(row.Unit?.BloodType ?? "—")</td>
                            <td class="nowrap">@(row.Unit?.ExpiresUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                            <td>@row.Facility</td>
                            <td>
                                @if (row.Unit is not null)
                                {
                                    <span class="badge badge-gray">Shipped</span>
                                }
                                else
                                {
                                    <span class="badge badge-red">Not shipped</span> <span class="sub">@row.Error</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}

@code {
    private string _facility = string.Empty;
    private string? _reference;
    private string? _note;
    private string _scan = string.Empty;
    private Feedback? _fb;
    private bool _busy;

    private sealed record RunRow(string Scan, string Facility, BloodUnitDto? Unit, string? Error);
    // Newest first, so the unit just scanned is at the top.
    private readonly List<RunRow> _run = new();

    // A scanner ends with Enter: ship the scanned unit, record the outcome, clear for the next scan.
    private async Task OnScanKeyAsync(KeyboardEventArgs e)
    {
        if (e.Key != "Enter" || string.IsNullOrWhiteSpace(_scan) || string.IsNullOrWhiteSpace(_facility) || _busy)
        {
            return;
        }

        _busy = true;
        var scan = _scan.Trim();
        var facility = _facility.Trim();
        var r = await Api.ShipOutByScanAsync(new ShipOutByScanRequest(scan, facility, _reference, _note));
        _busy = false;
        _scan = string.Empty;
        if (r.Succeeded && r.Value is not null)
        {
            _run.Insert(0, new RunRow(scan, facility, r.Value, null));
            _fb = Feedback.Succeed($"Shipped {r.Value.UnitNumber} to {facility}. Scan the next unit.");
        }
        else
        {
            _fb = r.ToFeedback();
            _run.Insert(0, new RunRow(scan, facility, null, _fb.Error ?? string.Join(" ", _fb.HardStops.Select(h => h.Message))));
        }
    }
}
