@page "/inventory/orders"
@inject BloodBankApiClient Api
@inject UserSession Session
@inject ReportDownloadCache Downloads
@inject IJSRuntime Js

<PageTitle>Supplier orders &middot; HemoCore</PageTitle>

<h1>Supplier orders</h1>
<p class="muted">Build a blood order from the minimum stock shortfall, sign it, send it, and link the delivery when it arrives.</p>
<details class="bb-help">
    <summary>How it works</summary>
    <ul>
        <li>A new order has one line per minimum stock row that is short, for the shortfall. Change quantities before you submit. A zero removes the line.</li>
        <li>Submitting needs your electronic signature. The order is then fixed.</li>
        <li>Export PDF or CSV and send it to the supplier by your usual route. Nothing is sent electronically.</li>
        <li>When the delivery arrives, link it to the order. The delivery must be from the same supplier.</li>
    </ul>
</details>
<Outcome Value="_feedback" />

@if (CanEdit)
{
    <div class="bb-card">
        <div class="bb-card-title"><h3>New order from minimum stock</h3></div>
        <div class="form-row">
            <div class="field">
                <label>Supplier</label>
                <select @bind="_supplierId">
                    <option value="0">Select</option>
                    @foreach (var supplier in _suppliers)
                    {
                        <option value="@supplier.Id">@supplier.DisplayName</option>
                    }
                </select>
            </div>
        </div>
        <button class="btn btn-primary btn-sm" disabled="@(_busy || _supplierId == 0)" @onclick="CreateAsync">Create draft</button>
        @* A patient's units (irradiated, CMV-negative, antigen-negative...) are ordered on a special order. *@
        <button class="btn btn-secondary btn-sm" disabled="@(_busy || _supplierId == 0)" @onclick="CreateSpecialAsync" data-new-special-order>New special order</button>
    </div>
}

<div class="bb-card">
    <div class="bb-card-title"><h3>Orders</h3></div>
    @if (_orders.Count == 0)
    {
        <div class="muted">No supplier orders yet.</div>
    }
    else
    {
        <div class="table-scroll">
        <table class="bb">
            <thead><tr><th>Order</th><th>Supplier</th><th>Status</th><th class="right">Units</th><th>Created</th><th></th></tr></thead>
            <tbody>
                @foreach (var order in _orders)
                {
                    <tr class="@(order.Id == _selected?.Id ? "selected" : null)">
                        <td class="mono">@order.OrderNumber</td>
                        <td>@order.SupplierName</td>
                        <td>
                            <span class="badge @StatusClass(order.Status)">@Ui.EnumText(order.Status)</span>
                            @if (order.UnitsShort > 0)
                            {
                                <span class="badge badge-amber" style="margin-left:.25rem;" data-order-short>Short @order.UnitsShort</span>
                            }
                            @if (order.ArrivalOverdue)
                            {
                                <span class="badge badge-red" style="margin-left:.25rem;" title="Not received by @order.ArrivalDueUtc?.ToLocalTime().ToString("yyyy-MM-dd HH:mm"); chase the supplier" data-arrival-overdue>Arrival overdue</span>
                            }
                        </td>
                        <td class="right">@order.UnitsOrdered</td>
                        <td>@order.CreatedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm") &middot; @order.CreatedBy</td>
                        <td><button class="btn btn-ghost btn-sm" @onclick="() => Select(order)">Open</button></td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    }
</div>

@if (_selected is { } current)
{
    @* Keyed so opening another order scrolls its detail into view again. *@
    <div @key="current.Id" class="bb-card" data-scroll-on-show>
        <div class="bb-card-title"><h3>@current.OrderNumber &middot; @current.SupplierName &middot; @current.Status</h3></div>
        <div class="table-scroll">
        <table class="bb">
            <thead><tr><th>Product</th><th>ABO</th><th>Rh</th><th>Requirements</th><th>For patient</th><th class="right">Quantity</th>@if (current.DeliveryId is not null) { <th class="right">Received</th><th class="right">Short</th> }</tr></thead>
            <tbody>
                @foreach (var line in _editLines)
                {
                    <tr>
                        <td><span class="mono">@line.ProductCode</span> @line.ProductName</td>
                        <td>@(line.Abo?.ToString() ?? "Any")</td>
                        <td>@(line.RhD is RhType rh ? (rh == RhType.Positive ? "Pos" : "Neg") : "Any")</td>
                        <td>@(line.Requirements ?? "—")</td>
                        <td>@(line.PatientMrn is null ? "—" : $"{line.PatientName} ({line.PatientMrn})")</td>
                        <td class="right">
                            @if (IsDraft && CanEdit)
                            {
                                <input type="number" min="0" max="@SupplierOrderRule.MaxLineQuantity" style="width:6rem;" @bind="line.Quantity" />
                            }
                            else
                            {
                                @line.Quantity
                            }
                        </td>
                        @if (current.DeliveryId is not null && current.Lines.FirstOrDefault(l => l.Id == line.Id) is { } got)
                        {
                            <td class="right">@got.Received</td>
                            <td class="right">
                                @if (got.Short > 0)
                                {
                                    <span class="badge badge-amber" data-line-short>@got.Short</span>
                                }
                                else
                                {
                                    <span class="muted">0</span>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
        </div>
        @if (IsDraft && CanEdit)
        {
            <div class="form-row" style="margin-top:.75rem;align-items:flex-end;" data-add-order-line>
                <div class="field"><label>Product</label>
                    <select @bind="_newLine.ProductTypeId">
                        <option value="0">Select</option>
                        @foreach (var pt in _products) { <option value="@pt.Id">@pt.ProductCode @pt.Name</option> }
                    </select>
                </div>
                <div class="field" style="max-width:7rem;"><label>ABO</label>
                    <select @bind="_newLine.Abo">
                        <option value="">Any</option>
                        @foreach (var a in Enum.GetValues<AboGroup>()) { <option value="@a">@Ui.EnumText(a)</option> }
                    </select>
                </div>
                <div class="field" style="max-width:7rem;"><label>Rh</label>
                    <select @bind="_newLine.RhD">
                        <option value="">Any</option>
                        <option value="@RhType.Positive">Pos</option>
                        <option value="@RhType.Negative">Neg</option>
                    </select>
                </div>
                <div class="field" style="flex:2;"><label>Requirements</label><input @bind="_newLine.Requirements" maxlength="500" placeholder="e.g. irradiated, CMV-negative, K-negative" /></div>
                <div class="field"><label>For patient (MRN)</label><input @bind="_newLine.PatientMrn" placeholder="Blank for stock" /></div>
                <div class="field" style="max-width:6rem;"><label>Quantity</label><input type="number" min="1" max="@SupplierOrderRule.MaxLineQuantity" @bind="_newLine.Quantity" /></div>
                <button class="btn btn-secondary btn-sm" disabled="@(_busy || _newLine.ProductTypeId == 0 || _newLine.Quantity < 1)" @onclick="AddLineAsync">Add line</button>
            </div>
        }
        <div class="form-row" style="margin-top:.75rem;">
            <div class="field" style="flex:2;">
                <label>Notes</label>
                @if (IsDraft && CanEdit)
                {
                    <input @bind="_notes" maxlength="500" />
                }
                else
                {
                    <div>@(current.Notes ?? "—")</div>
                }
            </div>
        </div>
        @if (current.SubmittedUtc is DateTime submitted)
        {
            <p class="muted">Submitted by @current.SubmittedBy @submitted.ToLocalTime().ToString("yyyy-MM-dd HH:mm").@if (current.ArrivalDueUtc is DateTime due)
                {
                    <span class="@(current.ArrivalOverdue ? "text-danger" : null)" data-arrival-due> @(current.ArrivalPromised ? "Promised by the supplier for" : "Arrival due") @due.ToLocalTime().ToString("yyyy-MM-dd HH:mm")@(current.ArrivalOverdue ? ": overdue, chase the supplier" : "").</span>
                }</p>
            @if (current.FollowUpNote is not null)
            {
                <p class="muted" data-follow-up>Followed up @current.FollowUpUtc?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") by @current.FollowUpBy: @current.FollowUpNote</p>
            }
        }
        @if (current.ReceivedUtc is DateTime received)
        {
            <p class="muted">Received against <a href="@($"/inventory/deliveries/{current.DeliveryId}")">delivery @current.DeliveryId</a> at @received.ToString("yyyy-MM-dd HH:mm") UTC.</p>
        }
        @if (current.CancelReason is not null)
        {
            <p class="muted">Cancelled: @current.CancelReason</p>
        }

        <div class="flex gap" style="flex-wrap:wrap;">
            <button class="btn btn-secondary btn-sm" disabled="@_busy" @onclick='() => ExportAsync("pdf")'>Export PDF</button>
            <button class="btn btn-secondary btn-sm" disabled="@_busy" @onclick='() => ExportAsync("csv")'>Export CSV</button>
            @if (IsDraft && CanEdit)
            {
                <button class="btn btn-secondary btn-sm" disabled="@_busy" @onclick="SaveAsync">Save changes</button>
            }
        </div>

        @if (IsDraft && CanEdit)
        {
            <div class="form-row" style="margin-top:1rem;">
                <div class="field"><label>Password or PIN to sign</label><input type="password" @bind="_secret" @bind:event="oninput" autocomplete="off" /></div>
            </div>
            <button class="btn btn-primary btn-sm" disabled="@(_busy || string.IsNullOrWhiteSpace(_secret))" @onclick="SubmitAsync">Sign and submit</button>
        }

        @if (current.Status == SupplierOrderStatus.Submitted && CanEdit)
        {
            <div class="form-row" style="margin-top:1rem;">
                <div class="field">
                    <label>Delivery received</label>
                    <select @bind="_deliveryId">
                        <option value="0">Select</option>
                        @foreach (var delivery in _deliveries.Where(d => d.BloodSupplierId == current.SupplierId))
                        {
                            <option value="@delivery.Id">@(delivery.PackingListNumber ?? $"Delivery {delivery.Id}") &middot; @delivery.ReceivedUtc.ToLocalTime().ToString("yyyy-MM-dd")</option>
                        }
                    </select>
                </div>
            </div>
            <button class="btn btn-primary btn-sm" disabled="@(_busy || _deliveryId == 0)" @onclick="ReceiveAsync">Link delivery</button>

            @* End-user testing pass 45: an overdue order said "chase the supplier" with nowhere to record that it was chased. *@
            <div class="form-row" style="margin-top:1rem;" data-follow-up-form>
                <div class="field" style="flex:2;"><label>Follow-up with the supplier</label><input @bind="_followUpNote" @bind:event="oninput" maxlength="500" placeholder="Who you spoke to and what they said" /></div>
                <div class="field"><label>Promised arrival (optional)</label><input type="datetime-local" @bind="_followUpPromised" /></div>
            </div>
            <button class="btn btn-secondary btn-sm" disabled="@(_busy || string.IsNullOrWhiteSpace(_followUpNote))" @onclick="FollowUpAsync" data-follow-up-save>Record follow-up</button>
        }

        @if (current.Status is SupplierOrderStatus.Draft or SupplierOrderStatus.Submitted && CanEdit)
        {
            <div class="form-row" style="margin-top:1rem;">
                <div class="field" style="flex:2;"><label>Cancel reason</label><input @bind="_cancelReason" @bind:event="oninput" /></div>
            </div>
            <button class="btn btn-ghost btn-sm" disabled="@(_busy || string.IsNullOrWhiteSpace(_cancelReason))" @onclick="CancelAsync">Cancel order</button>
        }
    </div>
}

@code {
    private sealed class EditLine
    {
        public long Id { get; init; }
        public long ProductTypeId { get; init; }
        public string ProductCode { get; init; } = string.Empty;
        public string ProductName { get; init; } = string.Empty;
        public AboGroup? Abo { get; init; }
        public RhType? RhD { get; init; }
        public string? Requirements { get; init; }
        public string? PatientMrn { get; init; }
        public string? PatientName { get; init; }
        public int Quantity { get; set; }
    }

    private sealed class NewLine
    {
        public long ProductTypeId { get; set; }
        public AboGroup? Abo { get; set; }
        public RhType? RhD { get; set; }
        public string? Requirements { get; set; }
        public string? PatientMrn { get; set; }
        public int Quantity { get; set; } = 1;
    }

    private NewLine _newLine = new();
    private List<ProductTypeDto> _products = new();

    private IEnumerable<SupplierOrderLineInput> LineInputs(IEnumerable<EditLine> lines) =>
        lines.Select(l => new SupplierOrderLineInput(l.ProductTypeId, l.Abo, l.Quantity, l.RhD, l.Requirements, l.PatientMrn));

    private Task CreateSpecialAsync() =>
        RunAsync(() => Api.CreateSupplierOrderAsync(new CreateSupplierOrderRequest(_supplierId, FromShortfall: false)), "Special order drafted. Add a line for each product the patient needs.");

    private Task AddLineAsync()
    {
        var added = LineInputs(_editLines).Append(new SupplierOrderLineInput(
            _newLine.ProductTypeId, _newLine.Abo, _newLine.Quantity, _newLine.RhD, _newLine.Requirements, _newLine.PatientMrn)).ToList();
        _newLine = new NewLine();
        return RunAsync(() => Api.UpdateSupplierOrderAsync(_selected!.Id, new UpdateSupplierOrderRequest(added, _notes)), "Line added.");
    }

    private List<SupplierOrderDto> _orders = new();
    private List<BloodSupplierRefDto> _suppliers = new();
    private List<OpenDeliveryDto> _deliveries = new();
    private SupplierOrderDto? _selected;
    private List<EditLine> _editLines = new();
    private Feedback? _feedback;
    private bool _busy;
    private long _supplierId;
    private long _deliveryId;
    private string _notes = string.Empty;
    private string _secret = string.Empty;
    private string _cancelReason = string.Empty;

    private bool CanEdit => Session.Has(PermissionCodes.InventoryReceive);

    private bool IsDraft => _selected?.Status == SupplierOrderStatus.Draft;

    protected override async Task OnInitializedAsync()
    {
        var products = await Api.GetProductTypesAsync();
        if (products.Succeeded) _products = (products.Value ?? new()).OrderBy(pt => pt.ProductCode).ToList();
        var suppliers = await Api.GetBloodSuppliersAsync();
        if (suppliers.Succeeded) _suppliers = suppliers.Value ?? new();
        if (_suppliers.Count == 1) _supplierId = _suppliers[0].Id;
        await ReloadAsync();
        if (OrderId is long id && _orders.FirstOrDefault(o => o.Id == id) is { } linked)
        {
            Select(linked);
        }
    }

    // Opens one order from a link, such as the delivery that filled it.
    [SupplyParameterFromQuery(Name = "id")]
    public long? OrderId { get; set; }

    private async Task ReloadAsync()
    {
        var orders = await Api.GetSupplierOrdersAsync();
        if (orders.Succeeded) _orders = orders.Value ?? new();
        var deliveries = await Api.GetOpenDeliveriesAsync();
        if (deliveries.Succeeded) _deliveries = deliveries.Value ?? new();
        if (_selected is not null)
        {
            var fresh = _orders.FirstOrDefault(o => o.Id == _selected.Id);
            if (fresh is not null) Select(fresh);
        }
    }

    private void Select(SupplierOrderDto order)
    {
        _selected = order;
        _notes = order.Notes ?? string.Empty;
        _secret = string.Empty;
        _cancelReason = string.Empty;
        _deliveryId = 0;
        _editLines = order.Lines
            .Select(l => new EditLine
            {
                Id = l.Id, ProductTypeId = l.ProductTypeId, ProductCode = l.ProductCode, ProductName = l.ProductName, Abo = l.Abo,
                RhD = l.RhD, Requirements = l.Requirements, PatientMrn = l.PatientMrn, PatientName = l.PatientName, Quantity = l.Quantity
            })
            .ToList();
    }

    private async Task RunAsync(Func<Task<ApiResult<SupplierOrderDto>>> call, string success)
    {
        if (_busy) return;
        _busy = true;
        try
        {
            var result = await call();
            _feedback = result.ToFeedback(success);
            if (result.Succeeded && result.Value is not null)
            {
                _selected = result.Value;
                await ReloadAsync();
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private Task CreateAsync() =>
        RunAsync(() => Api.CreateSupplierOrderAsync(new CreateSupplierOrderRequest(_supplierId)), "Draft order created from the minimum stock shortfall.");

    private Task SaveAsync() =>
        RunAsync(() => Api.UpdateSupplierOrderAsync(_selected!.Id, new UpdateSupplierOrderRequest(
            LineInputs(_editLines).ToList(), _notes)), "Order saved.");

    private async Task SubmitAsync()
    {
        if (_selected is null || _busy) return;
        // Save edits first so the signed order is the one on screen.
        var saved = await Api.UpdateSupplierOrderAsync(_selected.Id, new UpdateSupplierOrderRequest(
            LineInputs(_editLines).ToList(), _notes));
        if (!saved.Succeeded)
        {
            _feedback = saved.ToFeedback();
            return;
        }

        var sig = await Api.RecordSignatureAsync(new SignatureRequestVm(
            SupplierOrderRule.SignatureAction, "I submit this blood order to the supplier", "SupplierOrder", _selected.Id, _secret));
        _secret = string.Empty;
        if (!sig.Succeeded || sig.Value is null)
        {
            _feedback = sig.ToFeedback();
            return;
        }

        await RunAsync(() => Api.SubmitSupplierOrderAsync(_selected.Id, new SubmitSupplierOrderRequest(sig.Value.Id)), "Order submitted.");
    }

    private Task ReceiveAsync() =>
        RunAsync(() => Api.ReceiveSupplierOrderAsync(_selected!.Id, new ReceiveSupplierOrderRequest(_deliveryId)), "Delivery linked. The order is received.");

    private string? _followUpNote;
    private DateTime? _followUpPromised;

    private Task FollowUpAsync() =>
        RunAsync(() => Api.RecordSupplierOrderFollowUpAsync(_selected!.Id,
            new SupplierOrderFollowUpRequest(_followUpNote ?? string.Empty, _followUpPromised?.ToUniversalTime())), "Follow-up recorded.");

    private Task CancelAsync() =>
        RunAsync(() => Api.CancelSupplierOrderAsync(_selected!.Id, new CancelSupplierOrderRequest(_cancelReason)), "Order cancelled.");

    private async Task ExportAsync(string format)
    {
        if (_selected is null || _busy) return;
        _busy = true;
        try
        {
            var file = await Api.ExportSupplierOrderAsync(_selected.Id, format);
            if (!file.Succeeded || file.Value is null)
            {
                _feedback = file.ToFeedback();
                return;
            }

            var contentType = format == "csv" ? BloodBankLIS.Domain.Reporting.CsvFormat.ContentType : "application/pdf";
            var token = Downloads.Put($"{_selected.OrderNumber}.{format}", contentType, file.Value);
            await Js.InvokeVoidAsync("open", $"/downloads/reports/{token}", "_blank");
        }
        finally
        {
            _busy = false;
        }
    }

    private static string StatusClass(SupplierOrderStatus status) => status switch
    {
        SupplierOrderStatus.Draft => "badge-gray",
        SupplierOrderStatus.Submitted => "badge-blue",
        SupplierOrderStatus.Received => "badge-green",
        _ => "badge-amber"
    };
}
