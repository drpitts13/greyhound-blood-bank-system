@page "/audit"
@using BloodBankLIS.Domain.Enums
@inject BloodBankApiClient Api
@inject ReportDownloadCache Downloads
@inject IJSRuntime Js
@using BloodBankLIS.Application.Search

<PageTitle>Audit Trail &middot; HemoCore</PageTitle>

<h1>Audit Trail</h1>
<p class="muted">Append-only record of clinical actions (who / what / when / where / old / new / why). Paginated (max 1000 per page); records are retained and not purged.</p>

<div class="bb-card">
    <div class="form-row">
        <div class="field">
            <label>Event type</label>
            <select @bind="_eventType">
                <option value="">All events</option>
                @foreach (var t in EventTypes)
                {
                    <option value="@t">@Ui.EnumText(t)</option>
                }
            </select>
        </div>
        <div class="field"><label>User</label>
            @* Exact-match filter, like Entity type: pick from the user names recorded in the trail. *@
            <select @bind="_userName">
                <option value="">All users</option>
                @foreach (var u in UserChoices)
                {
                    <option value="@u">@Ui.EnumText(u)</option>
                }
            </select>
        </div>
        <div class="field"><label>Entity type</label>
            @* Exact-match filter: pick from the types recorded in the trail rather than guessing the name. *@
            <select @bind="_entityType">
                <option value="">All types</option>
                @foreach (var t in EntityTypeChoices)
                {
                    <option value="@t">@Ui.EnumText(t)</option>
                }
            </select>
        </div>
        <div class="field"><label>Entity id (optional)</label><input type="number" @bind="_entityId" @bind:event="oninput" @onkeydown="OnFilterKey" /></div>
    </div>
    <div class="field">
        <label>Record: scan or type</label>
        <input @bind="_recordScan" @bind:event="oninput" @onkeydown="OnRecordScanKey" placeholder="DIN, MRN, accession, or order number; Enter to find its trail" autocomplete="off" data-audit-record-scan style="max-width:28rem;" />
        @if (_recordHits.Count > 0)
        {
            <div class="flex" style="gap:.35rem;flex-wrap:wrap;margin-top:.35rem;">
                @foreach (var hit in _recordHits)
                {
                    <button type="button" class="btn btn-ghost btn-sm" @onclick="() => UseRecordAsync(hit)">@hit.Identifier · @hit.Title</button>
                }
            </div>
        }
        @if (_recordMessage is not null)
        {
            <span class="sub" data-audit-record-message>@_recordMessage</span>
        }
    </div>
    <div class="form-row">
        <div class="field"><label>From date (UTC)</label><input type="date" @bind="_fromDate" /></div>
        <div class="field"><label>To date (UTC, inclusive)</label><input type="date" @bind="_toDate" /></div>
        <div class="field">
            <label>Quick range</label>
            <div class="flex gap" style="flex-wrap:wrap;">
                @foreach (var (label, days) in DatePresets)
                {
                    <button class="btn btn-ghost btn-sm" type="button" disabled="@_busy" @onclick="() => SearchRangeAsync(days)">@label</button>
                }
            </div>
        </div>
    </div>
    <button class="btn btn-secondary" disabled="@_busy" @onclick="() => LoadAsync(0)">Search</button>
    <button class="btn btn-ghost" disabled="@_busy" @onclick="ExportCsvAsync" title="Up to 50,000 rows with the current filters, newest first">Export CSV</button>
</div>

<div class="bb-card">
    @if (_loading)
    {
        <div class="loading">Loading audit events...</div>
    }
    else if (_fb is not null && !string.IsNullOrEmpty(_fb.Error))
    {
        <Outcome Value="_fb" />
    }
    else if (_events.Count == 0)
    {
        <div class="empty">No audit events found.</div>
    }
    else
    {
        <div class="table-scroll">
        <table class="bb">
            <thead><tr><th>When</th><th>Action</th><th>Entity</th><th>User</th><th>Workstation</th><th>Reason</th><th>Old / new</th><th>Sig</th></tr></thead>
            <tbody>
                @foreach (var e in _events)
                {
                    <tr>
                        <td class="nowrap">@e.OccurredUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td><span class="badge badge-blue">@e.EventType</span></td>
                        <td>
                            @if (EntityHref(e) is { } href)
                            {
                                <a href="@href">@e.EntityType @(e.EntityId is null ? "" : $"#{e.EntityId}")</a>
                            }
                            else
                            {
                                @e.EntityType @(e.EntityId is null ? "" : $"#{e.EntityId}")
                            }
                        </td>
                        <td>@e.UserName</td>
                        <td class="muted">@e.Workstation</td>
                        <td>@e.Reason</td>
                        <td>
                            @if (HasValues(e))
                            {
                                <details>
                                    <summary>Values</summary>
                                    @if (!string.IsNullOrWhiteSpace(e.OldValueJson))
                                    {
                                        <div class="muted">Old</div>
                                        <pre class="mono audit-json">@e.OldValueJson</pre>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(e.NewValueJson))
                                    {
                                        <div class="muted">New</div>
                                        <pre class="mono audit-json">@e.NewValueJson</pre>
                                    }
                                </details>
                            }
                        </td>
                        <td class="mono">@(e.SignatureId?.ToString() ?? "")</td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
        <div class="flex gap" style="margin-top:.75rem;">
            <span class="muted">@(_total == 0 ? 0 : _skip + 1)–@Math.Min(_skip + _events.Count, _total) of @_total</span>
            <button class="btn btn-ghost btn-sm" disabled="@(_busy || _skip == 0)" @onclick="() => LoadAsync(Math.Max(0, _skip - _take))">Previous</button>
            <button class="btn btn-ghost btn-sm" disabled="@(_busy || _skip + _take >= _total)" @onclick="() => LoadAsync(_skip + _take)">Next</button>
        </div>
    }
</div>

@code {
    private static readonly AuditEventType[] EventTypes =
        Enum.GetValues<AuditEventType>().OrderBy(t => t.ToString()).ToArray();

    private List<AuditEventVm> _events = new();
    private string? _eventType;
    private string? _userName;
    private string? _entityType;
    private long? _entityId;
    private DateTime? _fromDate;
    private DateTime? _toDate;

    // Most audit questions are about recent activity; one click sets both dates and searches. Null days = any date.
    private static readonly (string Label, int? Days)[] DatePresets =
        [("Today", 0), ("Last 7 days", 6), ("Last 30 days", 29), ("Any date", null)];

    private async Task SearchRangeAsync(int? days)
    {
        var today = DateTime.UtcNow.Date;
        _fromDate = days is int d ? today.AddDays(-d) : null;
        _toDate = days is null ? null : today;
        await LoadAsync(0);
    }
    private int _skip;
    private int _take = 200;
    private int _total;
    private bool _loading = true;
    private bool _busy;
    private Feedback? _fb;

    private List<string> _entityTypes = new();

    private IEnumerable<string> EntityTypeChoices =>
        string.IsNullOrWhiteSpace(_entityType) || _entityTypes.Contains(_entityType)
            ? _entityTypes
            : _entityTypes.Append(_entityType);

    private List<string> _users = new();

    private IEnumerable<string> UserChoices =>
        string.IsNullOrWhiteSpace(_userName) || _users.Contains(_userName!)
            ? _users
            : _users.Append(_userName!);

    // A record's page links here with its type and id: /audit?entityType=BloodUnit&entityId=12.
    [SupplyParameterFromQuery(Name = "entityType")] public string? EntityTypeQuery { get; set; }
    [SupplyParameterFromQuery(Name = "entityId")] public long? EntityIdQuery { get; set; }

    // Scan-first: the record in hand (DIN, MRN, accession, order number) fills the type and id and searches.
    private string _recordScan = string.Empty;
    private List<LookupHitDto> _recordHits = new();
    private string? _recordMessage;

    private async Task OnRecordScanKey(KeyboardEventArgs e)
    {
        if (e.Key != "Enter" || string.IsNullOrWhiteSpace(_recordScan)) return;
        var query = _recordScan;
        _recordHits = new();
        _recordMessage = null;
        var result = await Api.LookupAsync(new LookupRequest(query));
        if (_recordScan != query) return;
        if (!result.Succeeded || result.Value is null)
        {
            _recordMessage = result.Error ?? "The lookup failed.";
            return;
        }

        if (result.Value.OpenDirectly)
        {
            await UseRecordAsync(result.Value.Hits[0]);
            return;
        }

        _recordHits = result.Value.Hits.ToList();
        _recordMessage = _recordHits.Count == 0 ? result.Value.Message ?? "No record matches." : "Several records match; choose one.";
    }

    private async Task UseRecordAsync(LookupHitDto hit)
    {
        _entityType = LookupRecordType.For(hit.Kind);
        _entityId = hit.Id;
        _recordHits = new();
        _recordScan = string.Empty;
        _recordMessage = $"Showing the trail of {hit.Identifier} ({hit.Title}).";
        await LoadAsync(0);
    }

    protected override async Task OnInitializedAsync()
    {
        var types = await Api.GetAuditEntityTypesAsync();
        if (types.Succeeded) _entityTypes = types.Value ?? new();
        var users = await Api.GetAuditUsersAsync();
        if (users.Succeeded) _users = users.Value ?? new();
        // Applied once the type list has loaded, so the Entity type select shows the linked type rather than a stale option.
        if (!string.IsNullOrWhiteSpace(EntityTypeQuery) && EntityIdQuery is > 0)
        {
            _entityType = EntityTypeQuery.Trim();
            _entityId = EntityIdQuery;
        }

        await LoadAsync(0);
    }

    private static bool HasValues(AuditEventVm e) =>
        !string.IsNullOrWhiteSpace(e.OldValueJson) || !string.IsNullOrWhiteSpace(e.NewValueJson);

    private static string? EntityHref(AuditEventVm e)
    {
        if (e.EntityId is not long id)
        {
            return null;
        }

        return e.EntityType switch
        {
            "Patient" => $"/patients/{id}",
            "BloodUnit" => InventoryUrls.Unit(id),
            "Issue" => $"/printing?issueId={id}",
            "Specimen" => $"/printing?specimenId={id}",
            _ => null
        };
    }

    private async Task OnFilterKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !_busy) await LoadAsync(0);
    }

    private async Task ExportCsvAsync()
    {
        if (_busy) return;
        _busy = true;
        try
        {
            var fromUtc = _fromDate is DateTime from ? DateTime.SpecifyKind(from.Date, DateTimeKind.Utc) : (DateTime?)null;
            var toUtc = _toDate is DateTime to ? DateTime.SpecifyKind(to.Date.AddDays(1), DateTimeKind.Utc) : (DateTime?)null;
            var r = await Api.ExportAuditCsvAsync(
                string.IsNullOrWhiteSpace(_entityType) ? null : _entityType,
                _entityId is > 0 ? _entityId : null,
                string.IsNullOrWhiteSpace(_eventType) ? null : _eventType,
                string.IsNullOrWhiteSpace(_userName) ? null : _userName,
                fromUtc,
                toUtc);
            if (!r.Succeeded || r.Value is null)
            {
                _fb = r.ToFeedback();
                return;
            }

            var token = Downloads.Put($"audit-trail-{DateTime.UtcNow:yyyyMMdd-HHmmss}.csv", BloodBankLIS.Domain.Reporting.CsvFormat.ContentType, r.Value);
            await Js.InvokeVoidAsync("open", $"/downloads/reports/{token}", "_blank");
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task LoadAsync(int skip)
    {
        _loading = true;
        _busy = true;
        _skip = skip;
        var fromUtc = _fromDate is DateTime from ? DateTime.SpecifyKind(from.Date, DateTimeKind.Utc) : (DateTime?)null;
        var toUtc = _toDate is DateTime to ? DateTime.SpecifyKind(to.Date.AddDays(1), DateTimeKind.Utc) : (DateTime?)null;
        var r = await Api.GetAuditEventsAsync(
            string.IsNullOrWhiteSpace(_entityType) ? null : _entityType,
            _entityId is > 0 ? _entityId : null,
            _skip,
            _take,
            string.IsNullOrWhiteSpace(_eventType) ? null : _eventType,
            string.IsNullOrWhiteSpace(_userName) ? null : _userName,
            fromUtc,
            toUtc);
        _loading = false;
        _busy = false;
        _fb = null;
        if (r.Succeeded && r.Value is not null)
        {
            _events = r.Value.Items ?? new();
            _total = r.Value.Total;
        }
        else { _events = new(); _total = 0; _fb = r.ToFeedback(); }
    }
}
