        _returnSealOk = InspectionStart;
        _returnVisualOk = InspectionStart;
        _returnDestination = row.StorageTimeOutAcceptable ? UnitStatus.Available : UnitStatus.Quarantine;
    }

    private void SyncReturnDestination()
    {
        if (ReturnCanBeAvailable || _returnDestination != UnitStatus.Available)
        {
            return;
        }

        _returnDestination = _returnSealOk != false && _returnVisualOk != false
            ? UnitStatus.Quarantine
            : UnitStatus.Discarded;
    }

