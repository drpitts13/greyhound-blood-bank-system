    private async Task PrefillReadyIssueAsync(ReadyToIssueWorkItemDto row)
    {
        ResetRunIfOtherPatient(row.PatientId);
        _issue.BloodUnitId = row.BloodUnitId;
        _issue.PatientId = row.PatientId;
        (_issue.PatientIdentifier1Value, _issue.PatientIdentifier2Value) = PatientIdentifierEntryRule.Prefill(
            _prefillIdentifiers, row.MedicalRecordNumber, DateOnly.TryParse(row.DateOfBirth, out var dob) ? dob : null);
        _prefilledRow = row;
        // The ward said where the unit goes; keep anything already typed.
        if (!string.IsNullOrWhiteSpace(row.IssueRequestedTo) && string.IsNullOrWhiteSpace(_issue.IssuedToLocation))
        {
            _issue.IssuedToLocation = row.IssueRequestedTo;
        }

        await LoadIssueRequirementsAsync();
        await _issueForm.FocusAsync();
    }

    private string? _issueUnitNotice;

    /// <summary>A unit picked or scanned without going through Ready to issue still brings its reservation's patient.</summary>
    private async Task OnIssueUnitPickedAsync()
    {
        _issueUnitNotice = null;
        if (_issue.DowntimeBackEntry) return;
        var (fill, notice) = IssueRun.ForPickedUnit(_readyItems, _issue.BloodUnitId, _issue.PatientId);
        _issueUnitNotice = notice;
        if (fill is not null && (fill.PatientId != _issue.PatientId || _prefilledRow?.BloodUnitId != fill.BloodUnitId))
        {
            var samePatient = fill.PatientId == _issue.PatientId;
            var (id1, id2) = (_issue.PatientIdentifier1Value, _issue.PatientIdentifier2Value);
            await PrefillReadyIssueAsync(fill);
            // Identifiers already entered for this patient stay.
            if (samePatient) (_issue.PatientIdentifier1Value, _issue.PatientIdentifier2Value) = (id1, id2);
        }
    }

    private PatientDto? IssuePatient => _patients.FirstOrDefault(p => p.Id == _issue.PatientId);

    private void ResetRunIfOtherPatient(long patientId)
    {
        if (_runPatientId != patientId)
        {
            _issuedThisRun.Clear();
            _runPatientId = patientId;
        }
    }

    private async Task OnIssuePatientChangedAsync()
    {
        ResetRunIfOtherPatient(_issue.PatientId);
        _issueUnitNotice = IssueRun.ForPickedUnit(_readyItems, _issue.BloodUnitId, _issue.PatientId).Notice;
        var patient = _patients.FirstOrDefault(p => p.Id == _issue.PatientId);
        if (patient is null)
        {
            _issue.PatientIdentifier1Value = null;
            _issue.PatientIdentifier2Value = null;
            await LoadIssueRequirementsAsync();
            return;
        }

        (_issue.PatientIdentifier1Value, _issue.PatientIdentifier2Value) = PatientIdentifierEntryRule.Prefill(
            _prefillIdentifiers, patient.MedicalRecordNumber, patient.DateOfBirth);
        await LoadIssueRequirementsAsync();
    }

