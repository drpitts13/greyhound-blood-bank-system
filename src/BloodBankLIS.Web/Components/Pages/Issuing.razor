    protected override async Task OnInitializedAsync()
    {
        _desk = IssuingDeskQuery.Resolve(
            DeskQuery,
            Session.Has(PermissionCodes.IssueCreate),
            Session.Has(PermissionCodes.IssueCreate)
                || Session.Has(PermissionCodes.IssueReturn)
                || Session.Has(PermissionCodes.TransfusionDocument),
            QueryPatientId is not null || QueryBloodUnitId is not null,
            _desk);
        _focusUnitFor = _desk;

        var prefill = await Api.GetFacilityPolicyFlagAsync(FacilityPolicyKeys.PrefillPatientIdentifiers);
        _prefillIdentifiers = prefill.Succeeded && prefill.Value?.Enabled == true;
        var inspectionDefault = await Api.GetFacilityPolicyFlagAsync(FacilityPolicyKeys.InspectionDefaultAcceptable);
        _inspectionDefault = inspectionDefault.Succeeded && inspectionDefault.Value?.Enabled == true;

        if (Session.HasAny(PermissionCodes.PrintLabel, PermissionCodes.IssueCreate, PermissionCodes.TransfusionDocument))
        {
            var required = await Api.GetPtagIdRequiredAsync();
            _ptagRequired = required.Succeeded && required.Value?.Required == true;
        }

        var users = await Api.GetDirectoryUsersAsync();
        if (users.Succeeded) _directoryUsers = users.Value ?? new();
        var patients = await Api.GetPatientsAsync();
        if (patients.Succeeded) _patients = patients.Value ?? new();
        await LoadWorklistsAsync();
        if (QueryBloodUnitId is long unitId)
        {
            _issue.BloodUnitId = unitId;
        }

        if (QueryPatientId is long patientId)
        {
            _issue.PatientId = patientId;
            await OnIssuePatientChangedAsync();
        }
        else if (QueryBloodUnitId is not null)
        {
            // From the unit page: the reservation brings the patient, as if the unit had been scanned here.
            await OnIssueUnitPickedAsync();
        }

        // From the chart: open bedside documentation for that issue, with every check the form applies.
        if (QueryIssueId is long issueId && _desk == "transfuse")
        {
            if (_outstandingItems.FirstOrDefault(i => i.IssueId == issueId) is { } row)
            {
                SelectTransfusionIssue(row);
            }
            else
            {
                _txFb = Feedback.Fail($"Issue #{issueId} is not waiting for transfusion documentation. It may already be documented or returned.");
            }
        }

        // From the unit page: open ward receipt or return for that issue.
        if (QueryIssueId is long receiptIssueId && _desk == "receipt")
        {
            if (_inTransitItems.FirstOrDefault(i => i.IssueId == receiptIssueId) is { } t)
            {
                SelectWardIssue(t.IssueId, t.ProductName, t.UnitExpiresUtc, t.UnitBloodType, t.SpecimenAccession, t.CrossmatchExpiresUtc, t.LatestCrossmatchResult, t.IssuedTo, t.CoolerId, t.IssuedToLocation, t.IssuedBy, t.EmergencyReleaseDetails, t.SecondVerifier, t.EmergencyReleaseAuthorizer, t.IssueAppearance, t.PtagCode, t.CrossmatchStatus);
            }
            else
            {
                _wardFb = Feedback.Fail($"Issue #{receiptIssueId} is not waiting for ward receipt. It may already be received or returned.");
            }
        }

        if (QueryIssueId is long returnIssueId && _desk == "return")
        {
            if (_outstandingItems.FirstOrDefault(i => i.IssueId == returnIssueId) is { } r && IssueRun.CanReturn(r))
            {
                SelectReturnIssue(r);
            }
            else
            {
                _returnFb = Feedback.Fail($"Issue #{returnIssueId} cannot be returned here. Its transfusion may have started, or it was already returned.");
            }
        }
    }

