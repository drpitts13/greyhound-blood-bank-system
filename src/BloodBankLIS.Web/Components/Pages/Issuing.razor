@page "/issuing"
@using Microsoft.AspNetCore.Components
@inject BloodBankApiClient Api
@inject UserSession Session

<PageTitle>Issue &amp; Transfuse &middot; Greyhound Blood Bank LIS</PageTitle>

<h1>Issue &amp; Transfuse</h1>
@if (QueryPatientId is long chartPatientId)
{
    <p>
        <a href="@($"/patients/{chartPatientId}?tab=products")">Open chart · Products</a>
        <span class="muted"> · Patient and unit stay prefilled on this desk.</span>
    </p>
}
<p class="muted">The issue gate runs all safety checks, including storage-location policy and electronic / remote issue eligibility (AABB 5.16). Overrides require a reason and an electronic signature. Reserved units appear on Ready to issue so the desk does not re-key patient and unit after allocate.</p>

@if (Session.Has(PermissionCodes.IssueCreate))
{
    <div class="bb-card">
        <div class="bb-card-title"><h3>Second ABO/Rh due</h3></div>
        <p class="muted">Patients with reserved units who still need a concordant historical or second-sample type before routine red-cell issue (AABB 5.14 / CAP TRM.40650).</p>
        @if (_secondAboItems.Count == 0)
        {
            <div class="muted">No reserved units waiting on a second ABO/Rh.</div>
        }
        else
        {
            <table class="bb">
                <thead>
                    <tr>
                        <th>Patient</th>
                        <th>MRN</th>
                        <th>Current type</th>
                        <th>Reserved</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _secondAboItems)
                    {
                        <tr>
                            <td><a href="@($"/patients/{row.PatientId}?tab=tests")">@row.DisplayName</a></td>
                            <td class="mono">@row.MedicalRecordNumber</td>
                            <td class="mono">@row.CurrentAboRh</td>
                            <td>@row.ReservedUnitCount</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <div class="bb-card">
        <div class="bb-card-title"><h3>Ready to issue</h3></div>
        <p class="muted">Units reserved to a patient. Issue from the row prefills unit, MRN, and date of birth on the existing issue form. Red cells and whole blood that still need a second concordant ABO/Rh are marked and are not offered as a routine issue. Emergency release stays available for staff who can authorize it. A missing or expired current specimen is marked and is not offered for routine or emergency issue. An outdated unit says Outdated and is not offered for routine or emergency issue. An open antibody-identification workup is marked Open ABID and can still be issued. A unit inside the issue near-expiry window, including the shorter post-thaw window, is marked Expires soon and can still be issued. When electronic crossmatch is not eligible, the row shows the existing blocking reason. Serologic issue is unchanged. A unit that still needs a compatible crossmatch is marked and is not offered as a routine issue. An incompatible crossmatch is marked and can still be issued with the existing override. A unit that fails an active irradiated, CMV-negative, leukoreduced, washed, or antigen-negative requirement is marked Special need and is not offered for routine or emergency issue. A unit that is not antigen-negative for a clinically significant antibody is marked Antigen and can still be issued with the existing override. An unresolved ABO/Rh discrepancy on a crossmatch-required product is marked and is not offered for routine or emergency issue. On a product that does not require a crossmatch, the discrepancy is marked and can still be issued with the existing override. A patient with a recorded transfusion reaction is marked Reaction and can still be issued. Choosing Issue or Emergency repeats those marks on the issue form for that unit and patient. A reserved autologous or directed unit for this patient is marked with that selection cue and can still be issued. The issue gate still refuses another patient's restricted unit. Each reserved unit shows its product name, and that name is repeated on the issue form. Each reserved unit shows when it expires, and that time is repeated on the issue form. Each reserved unit shows its ABO/Rh next to the patient type, and that unit type is repeated on the issue form. When a reserved unit has a current compatible crossmatch, the row shows when that crossmatch expires, and that time is repeated on the issue form. Each reserved unit shows the storage location it is in, and that location is repeated on the issue form. Each reserved unit shows the accession of the current specimen for that issue, and that accession is repeated on the issue form. Each reserved unit shows the latest crossmatch result, and Issue or Emergency repeats that result. A unit with no crossmatch result shows none.</p>
        @if (_readyItems.Count == 0)
        {
            <div class="muted">No reserved units waiting to issue.</div>
        }
        else
        {
            <table class="bb">
                <thead>
                    <tr>
                        <th>Patient</th>
                        <th>MRN</th>
                        <th>Unit</th>
                        <th>Product</th>
                        <th>Expires</th>
                        <th>Unit type</th>
                        <th>Location</th>
                        <th>Patient type</th>
                        <th>Antibodies</th>
                        <th>XM</th>
                        <th>Status</th>
                        <th>Specimen</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _readyItems)
                    {
                        <tr>
                            <td><a href="@($"/patients/{row.PatientId}?tab=products")">@(row.PatientDisplayName ?? "—")</a></td>
                            <td class="mono">@(row.MedicalRecordNumber ?? "—")</td>
                            <td class="mono">@(row.UnitNumber ?? $"#{row.BloodUnitId}")</td>
                            <td>@(string.IsNullOrWhiteSpace(row.ProductName) ? "—" : row.ProductName)</td>
                            <td>@(row.UnitExpiresUtc is DateTime unitExpires ? unitExpires.ToString("yyyy-MM-dd HH:mm") : "—")</td>
                            <td><strong>@(string.IsNullOrWhiteSpace(row.UnitBloodType) ? "—" : row.UnitBloodType)</strong></td>
                            <td>@(string.IsNullOrWhiteSpace(row.StorageLocationName) ? "—" : row.StorageLocationName)</td>
                            <td>@(row.CurrentBloodType ?? "—")</td>
                            <td>@AntibodyCell(row.HasAntibodyHistory, row.AntibodySummary)</td>
                            <td>
                                @(row.LatestCrossmatchResult is CrossmatchResult readyXm ? readyXm.ToString() : "—")
                                @if (row.CrossmatchExpiresUtc is DateTime crossmatchExpires)
                                {
                                    <div class="muted">@crossmatchExpires.ToString("yyyy-MM-dd HH:mm")</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(row.ElectronicCrossmatchNotice))
                                {
                                    <div class="muted">@row.ElectronicCrossmatchNotice</div>
                                }
                            </td>
                            <td><span class="@Ui.Badge(row.DisplayStatus)">@Ui.StatusLabel(row.DisplayStatus)</span></td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(row.SpecimenAccession))
                                {
                                    <div class="mono">@row.SpecimenAccession</div>
                                }
                                @SpecimenExpiryCell(row.SpecimenExpiresUtc, row.SpecimenExpired)
                            </td>
                            <td class="right nowrap">
                                @if (row.OpenAntibodyWorkup)
                                {
                                    <span class="badge badge-amber" title="@row.OpenAntibodyWorkupNotice">Open ABID</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(row.ReactionNotice))
                                {
                                    <span class="badge badge-amber" title="@row.ReactionNotice">Reaction</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(row.DonationRestrictionNotice))
                                {
                                    <span class="badge badge-amber" title="@row.DonationRestrictionNotice">@row.DonationRestrictionNotice</span>
                                }
                                @if (row.ExpiresSoon)
                                {
                                    <span class="badge badge-amber">Expires soon</span>
                                }
                                @if (row.CrossmatchBlocksRoutineIssue)
                                {
                                    <span class="badge badge-red" title="@row.CrossmatchNotice">Crossmatch</span>
                                }
                                else if (!string.IsNullOrWhiteSpace(row.CrossmatchNotice))
                                {
                                    <span class="badge badge-amber" title="@row.CrossmatchNotice">XM incompatible</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(row.SpecialRequirementNotice))
                                {
                                    <span class="badge badge-red" title="@row.SpecialRequirementNotice">Special need</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(row.AntigenNotice))
                                {
                                    <span class="badge badge-amber" title="@row.AntigenNotice">Antigen</span>
                                }
                                @if (row.AboRhDiscrepancyBlocksIssue)
                                {
                                    <span class="badge badge-red" title="@row.AboRhDiscrepancyNotice">ABO discrepancy</span>
                                }
                                else if (!string.IsNullOrWhiteSpace(row.AboRhDiscrepancyNotice))
                                {
                                    <span class="badge badge-amber" title="@row.AboRhDiscrepancyNotice">ABO discrepancy</span>
                                }
                                @if (row.SpecimenBlocksIssue)
                                {
                                    <span class="badge badge-red" title="@row.SpecimenBlockReason">Specimen</span>
                                    <a class="btn btn-ghost btn-sm" href="@($"/patients/{row.PatientId}?tab=specimens")">New specimen</a>
                                }
                                else if (row.UnitOutdated)
                                {
                                    <span class="badge badge-red" title="@row.UnitBlockReason">Outdated</span>
                                }
                                else if (!string.IsNullOrWhiteSpace(row.SpecialRequirementNotice))
                                {
                                }
                                else if (row.AboRhDiscrepancyBlocksIssue)
                                {
                                }
                                else if (row.NeedsSecondAbo || row.CrossmatchBlocksRoutineIssue)
                                {
                                    @if (row.NeedsSecondAbo)
                                    {
                                        <span class="badge badge-amber" title="@ReadyToIssueFormCue.SecondAbo">Second ABO</span>
                                        <a class="btn btn-ghost btn-sm" href="@($"/patients/{row.PatientId}?tab=tests")">Enter type</a>
                                    }
                                    @if (Session.Has(PermissionCodes.IssueEmergencyRelease))
                                    {
                                        <button type="button" class="btn btn-secondary btn-sm" @onclick="() => SelectEmergencyIssue(row)">Emergency</button>
                                    }
                                }
                                else
                                {
                                    <button type="button" class="btn btn-primary btn-sm" @onclick="() => SelectReadyToIssue(row)">Issue</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <div class="bb-card">
        <div class="bb-card-title"><h3>Retrospective crossmatch due</h3></div>
        <p class="muted">Emergency and MTP issues released without a compatible crossmatch stay here until retrospective testing is recorded (21 CFR 606.151(b)). Each row shows the product name, when the unit expires, the unit ABO/Rh beside the patient type, the latest crossmatch result, and when a current compatible crossmatch expires. A unit with no crossmatch result shows none. Each row shows the person the unit was issued to. A unit with no issued-to person shows none. Each row shows the cooler or transport id. A unit with no cooler shows none. Each row shows the location the unit was issued to. A unit with no location shows none. Each row shows who issued the unit. The follow-up screen repeats that name. A unit with no issuing user shows none. Each row shows the second verifier recorded at issue. The follow-up screen repeats that name. A blank second verifier shows none. Each row shows the recorded emergency-release reason. The follow-up screen repeats that reason. A row with no reason shows none. Each row shows who authorized the emergency or massive-transfusion release. The follow-up screen repeats that name. A blank authorizer shows none. Each row shows the appearance recorded at issue. The follow-up screen repeats that code. Each row shows the pickup tag scanned at issue. The follow-up screen repeats that code. A blank pickup tag shows none. Retrospective completion is unchanged.</p>
        @if (_retroItems.Count == 0)
        {
            <div class="muted">No retrospective crossmatches pending.</div>
        }
        else
        {
            <table class="bb">
                <thead>
                    <tr>
                        <th>Patient</th>
                        <th>MRN</th>
                        <th>Unit</th>
                        <th>Product</th>
                        <th>Expires</th>
                        <th>Unit type</th>
                        <th>Patient type</th>
                        <th>Antibodies</th>
                        <th>Specimen</th>
                        <th>Crossmatch</th>
                        <th>Issue type</th>
                        <th>Release reason</th>
                        <th>Authorized by</th>
                        <th>Cooler</th>
                        <th>Location</th>
                        <th>Issued to</th>
                        <th>Issued by</th>
                        <th>Second verifier</th>
                        <th>Appearance</th>
                        <th>P-tag</th>
                        <th>Issued</th>
                        <th>Due</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _retroItems)
                    {
                        <tr>
                            <td><a href="@($"/patients/{row.PatientId}")">@(row.PatientDisplayName ?? $"Issue #{row.IssueId}")</a></td>
                            <td class="mono">@(row.MedicalRecordNumber ?? "—")</td>
                            <td class="mono">@(row.UnitNumber ?? $"#{row.BloodUnitId}")</td>
                            <td>@(string.IsNullOrWhiteSpace(row.ProductName) ? "—" : row.ProductName)</td>
                            <td>@(row.UnitExpiresUtc is DateTime retroExpires ? retroExpires.ToString("yyyy-MM-dd HH:mm") : "—")</td>
                            <td><strong>@(string.IsNullOrWhiteSpace(row.UnitBloodType) ? "—" : row.UnitBloodType)</strong></td>
                            <td>@(row.CurrentBloodType ?? "—")</td>
                            <td>@AntibodyCell(row.HasAntibodyHistory, row.AntibodySummary)</td>
                            <td>
                                @(row.AccessionNumber ?? "—")
                                <div>@SpecimenExpiryCell(row.SpecimenExpiresUtc, row.SpecimenExpired)</div>
                            </td>
                            <td>
                                @(row.LatestCrossmatchResult is CrossmatchResult retroXm ? retroXm.ToString() : "—")
                                @if (row.CrossmatchExpiresUtc is DateTime retroXmExpires)
                                {
                                    <div class="muted">@retroXmExpires.ToString("yyyy-MM-dd HH:mm")</div>
                                }
                            </td>
                            <td>@row.IssueType</td>
                            <td>@(string.IsNullOrWhiteSpace(row.EmergencyReleaseDetails) ? "—" : row.EmergencyReleaseDetails)</td>
                            <td>@(string.IsNullOrWhiteSpace(row.EmergencyReleaseAuthorizer) ? "—" : row.EmergencyReleaseAuthorizer)</td>
                            <td class="mono">@(string.IsNullOrWhiteSpace(row.CoolerId) ? "—" : row.CoolerId)</td>
                            <td>@(string.IsNullOrWhiteSpace(row.IssuedToLocation) ? "—" : row.IssuedToLocation)</td>
                            <td>@(string.IsNullOrWhiteSpace(row.IssuedTo) ? "—" : row.IssuedTo)</td>
                            <td>@(row.IssuedBy ?? "—")</td>
                            <td>@(string.IsNullOrWhiteSpace(row.SecondVerifier) ? "—" : row.SecondVerifier)</td>
                            <td>@row.IssueAppearance</td>
                            <td class="mono">@(string.IsNullOrWhiteSpace(row.PtagCode) ? "—" : row.PtagCode)</td>
                            <td>@row.IssuedUtc.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>
                                @(row.DueUtc?.ToString("yyyy-MM-dd HH:mm") ?? "—")
                                @if (row.IsOverdue)
                                {
                                    <span class="badge badge-amber">Overdue</span>
                                }
                            </td>
                            <td class="right nowrap">
                                @if (Session.Has(PermissionCodes.CompatibilityCrossmatch))
                                {
                                    <a class="btn btn-primary btn-sm" href="@RetroXmHref(row)">Record crossmatch</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <div class="bb-card">
        <div class="bb-card-title"><h3>In transit to ward</h3></div>
        <p class="muted">Issued units in a cooler or courier handoff until the receiving location acknowledges custody (SoftBank remote issue). Each row shows the product name, when the unit expires, the unit ABO/Rh, the specimen accession, the latest crossmatch result, and when a current compatible crossmatch expires. Receive repeats all five. A unit with no crossmatch result shows none. Each row shows the person the unit was issued to. Receive repeats that person. A unit with no issued-to person shows none. Receive repeats the cooler or transport id. A unit with no cooler shows none. Receive repeats the location the unit was issued to. A unit with no location shows none. Each row shows the recorded issue type. Each row shows the recorded emergency-release reason. Receive repeats that reason. A blank reason shows none. Each row shows who issued the unit. Receive repeats that name. A unit with no issuing user shows none. Each row shows the second verifier recorded at issue. Receive repeats that name. A blank second verifier shows none. Each row shows who authorized an emergency or massive-transfusion release. Receive repeats that name. A blank authorizer shows none. Each row shows the appearance recorded at issue. Receive repeats that code. Each row shows the pickup tag scanned at issue. Receive repeats that code. A blank pickup tag shows none. Each row shows the crossmatch status recorded at issue. Receive repeats that status. The issue gate is unchanged.</p>
        @if (_inTransitItems.Count == 0)
        {
            <div class="muted">No units currently in transit.</div>
        }
        else
        {
            <table class="bb">
                <thead>
                    <tr>
                        <th>Patient</th>
                        <th>MRN</th>
                        <th>Unit</th>
                        <th>Product</th>
                        <th>Expires</th>
                        <th>Unit type</th>
                        <th>Patient type</th>
                        <th>Antibodies</th>
                        <th>Specimen</th>
                        <th>Crossmatch</th>
                        <th>XM at issue</th>
                        <th>Issue type</th>
                        <th>Release reason</th>
                        <th>Authorized by</th>
                        <th>Cooler</th>
                        <th>Location</th>
                        <th>Issued to</th>
                        <th>Issued by</th>
                        <th>Second verifier</th>
                        <th>Appearance</th>
                        <th>P-tag</th>
                        <th>Issued</th>
                        <th>Due</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _inTransitItems)
                    {
                        <tr>
                            <td><a href="@($"/patients/{row.PatientId}")">@(row.PatientDisplayName ?? $"Issue #{row.IssueId}")</a></td>
                            <td class="mono">@(row.MedicalRecordNumber ?? "—")</td>
                            <td class="mono">@(row.UnitNumber ?? $"#{row.BloodUnitId}")</td>
                            <td>@(string.IsNullOrWhiteSpace(row.ProductName) ? "—" : row.ProductName)</td>
                            <td>@(row.UnitExpiresUtc is DateTime transitExpires ? transitExpires.ToString("yyyy-MM-dd HH:mm") : "—")</td>
                            <td><strong>@(string.IsNullOrWhiteSpace(row.UnitBloodType) ? "—" : row.UnitBloodType)</strong></td>
                            <td>@(row.CurrentBloodType ?? "—")</td>
                            <td>@AntibodyCell(row.HasAntibodyHistory, row.AntibodySummary)</td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(row.SpecimenAccession))
                                {
                                    <div class="mono">@row.SpecimenAccession</div>
                                }
                                @SpecimenExpiryCell(row.SpecimenExpiresUtc, row.SpecimenExpired)
                            </td>
                            <td>
                                @(row.LatestCrossmatchResult is CrossmatchResult transitXm ? transitXm.ToString() : "—")
                                @if (row.CrossmatchExpiresUtc is DateTime transitXmExpires)
                                {
                                    <div class="muted">@transitXmExpires.ToString("yyyy-MM-dd HH:mm")</div>
                                }
                            </td>
                            <td>@row.CrossmatchStatus</td>
                            <td>@row.IssueType</td>
                            <td>@(string.IsNullOrWhiteSpace(row.EmergencyReleaseDetails) ? "—" : row.EmergencyReleaseDetails)</td>
                            <td>@(string.IsNullOrWhiteSpace(row.EmergencyReleaseAuthorizer) ? "—" : row.EmergencyReleaseAuthorizer)</td>
                            <td class="mono">@(row.CoolerId ?? "—")</td>
                            <td>@(row.IssuedToLocation ?? "—")</td>
                            <td>@(string.IsNullOrWhiteSpace(row.IssuedTo) ? "—" : row.IssuedTo)</td>
                            <td>@(row.IssuedBy ?? "—")</td>
                            <td>@(string.IsNullOrWhiteSpace(row.SecondVerifier) ? "—" : row.SecondVerifier)</td>
                            <td>@row.IssueAppearance</td>
                            <td class="mono">@(string.IsNullOrWhiteSpace(row.PtagCode) ? "—" : row.PtagCode)</td>
                            <td>@row.IssuedUtc.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>
                                @(row.DueUtc?.ToString("yyyy-MM-dd HH:mm") ?? "—")
                                @if (row.IsOverdue)
                                {
                                    <span class="badge badge-amber">Overdue</span>
                                }
                            </td>
                            <td>
                                @if (Session.Has(PermissionCodes.TransfusionDocument))
                                {
                                    <button type="button" class="btn btn-ghost btn-sm" @onclick="() => SelectWardIssue(row.IssueId, row.ProductName, row.UnitExpiresUtc, row.UnitBloodType, row.SpecimenAccession, row.CrossmatchExpiresUtc, row.LatestCrossmatchResult, row.IssuedTo, row.CoolerId, row.IssuedToLocation, row.IssuedBy, row.EmergencyReleaseDetails, row.SecondVerifier, row.EmergencyReleaseAuthorizer, row.IssueAppearance, row.PtagCode, row.CrossmatchStatus)">Receive</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}

@if (Session.Has(PermissionCodes.IssueCreate) || Session.Has(PermissionCodes.IssueReturn) || Session.Has(PermissionCodes.TransfusionDocument))
{
    <div class="bb-card">
        <div class="bb-card-title"><h3>Issued units</h3></div>
        <p class="muted">Units still Issued — including after ward receipt — so return and transfusion identify the unit by number instead of a raw issue id. Each issued unit shows its product name, when it expires, its ABO/Rh, the specimen accession, the latest crossmatch result, and when a current compatible crossmatch expires. Return and Document repeat all five. A unit with no crossmatch result shows none. Each row shows the person the unit was issued to. Receive, Return, and Document repeat that person. A unit with no issued-to person shows none. Each row shows the cooler or transport id. Receive, Return, and Document repeat that id. A unit with no cooler shows none. Each row shows the location the unit was issued to. Receive, Return, and Document repeat that location. A unit with no location shows none. Each row shows the recorded issue type, including after ward receipt. Each row shows the recorded emergency-release reason, including after ward receipt. Receive, Return, and Document repeat that reason. A blank reason shows none. Each row shows who issued the unit, including after ward receipt. Receive, Return, and Document repeat that name. A unit with no issuing user shows none. Each row shows the second verifier recorded at issue, including after ward receipt. Receive, Return, and Document repeat that name. A blank second verifier shows none. Each row shows who authorized an emergency or massive-transfusion release, including after ward receipt. Receive, Return, and Document repeat that name. A blank authorizer shows none. Each row shows the appearance recorded at issue, including after ward receipt. Receive, Return, and Document repeat that code. The issue gate is unchanged. Each row shows the appearance recorded at ward receipt after the unit is received. A unit still awaiting receipt shows none. Return and Document repeat that code. The ward-receipt gate is unchanged. Each row shows the pickup tag scanned at issue, including after ward receipt. Receive, Return, and Document repeat that code. A blank pickup tag shows none. Each row shows the crossmatch status recorded at issue, including after ward receipt. Receive, Return, and Document repeat that status. Return, ward-receipt, and bedside identity gates are unchanged.</p>
        @if (_outstandingItems.Count == 0)
        {
            <div class="muted">No outstanding issued units.</div>
        }
        else
        {
            <table class="bb">
                <thead>
                    <tr>
                        <th>Patient</th>
                        <th>MRN</th>
                        <th>Unit</th>
                        <th>Product</th>
                        <th>Expires</th>
                        <th>Unit type</th>
                        <th>Patient type</th>
                        <th>Antibodies</th>
                        <th>Specimen</th>
                        <th>Crossmatch</th>
                        <th>XM at issue</th>
                        <th>Issue type</th>
                        <th>Release reason</th>
                        <th>Authorized by</th>
                        <th>Ward receipt</th>
                        <th>Ward appearance</th>
                        <th>Cooler</th>
                        <th>Location</th>
                        <th>Issued to</th>
                        <th>Issued by</th>
                        <th>Second verifier</th>
                        <th>Appearance</th>
                        <th>P-tag</th>
                        <th>Issued</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _outstandingItems)
                    {
                        <tr>
                            <td><a href="@($"/patients/{row.PatientId}")">@(row.PatientDisplayName ?? $"Issue #{row.IssueId}")</a></td>
                            <td class="mono">@(row.MedicalRecordNumber ?? "—")</td>
                            <td class="mono">@(row.UnitNumber ?? $"#{row.BloodUnitId}")</td>
                            <td>@(string.IsNullOrWhiteSpace(row.ProductName) ? "—" : row.ProductName)</td>
                            <td>@(row.UnitExpiresUtc is DateTime issuedExpires ? issuedExpires.ToString("yyyy-MM-dd HH:mm") : "—")</td>
                            <td><strong>@(string.IsNullOrWhiteSpace(row.UnitBloodType) ? "—" : row.UnitBloodType)</strong></td>
                            <td>@(row.CurrentBloodType ?? "—")</td>
                            <td>@AntibodyCell(row.HasAntibodyHistory, row.AntibodySummary)</td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(row.SpecimenAccession))
                                {
                                    <div class="mono">@row.SpecimenAccession</div>
                                }
                                @SpecimenExpiryCell(row.SpecimenExpiresUtc, row.SpecimenExpired)
                            </td>
                            <td>
                                @(row.LatestCrossmatchResult is CrossmatchResult issuedXm ? issuedXm.ToString() : "—")
                                @if (row.CrossmatchExpiresUtc is DateTime issuedXmExpires)
                                {
                                    <div class="muted">@issuedXmExpires.ToString("yyyy-MM-dd HH:mm")</div>
                                }
                            </td>
                            <td>@row.CrossmatchStatus</td>
                            <td>@row.IssueType</td>
                            <td>@(string.IsNullOrWhiteSpace(row.EmergencyReleaseDetails) ? "—" : row.EmergencyReleaseDetails)</td>
                            <td>@(string.IsNullOrWhiteSpace(row.EmergencyReleaseAuthorizer) ? "—" : row.EmergencyReleaseAuthorizer)</td>
                            <td>
                                @if (row.WardReceivedUtc is DateTime received)
                                {
                                    <span>@received.ToString("yyyy-MM-dd HH:mm") @(row.WardReceivedBy ?? "")</span>
                                }
                                else
                                {
                                    <span class="muted">Awaiting</span>
                                }
                            </td>
                            <td>@(string.IsNullOrWhiteSpace(row.WardAppearance) ? "—" : row.WardAppearance)</td>
                            <td class="mono">@(string.IsNullOrWhiteSpace(row.CoolerId) ? "—" : row.CoolerId)</td>
                            <td>@(string.IsNullOrWhiteSpace(row.IssuedToLocation) ? "—" : row.IssuedToLocation)</td>
                            <td>@(string.IsNullOrWhiteSpace(row.IssuedTo) ? "—" : row.IssuedTo)</td>
                            <td>@(row.IssuedBy ?? "—")</td>
                            <td>@(string.IsNullOrWhiteSpace(row.SecondVerifier) ? "—" : row.SecondVerifier)</td>
                            <td>@row.IssueAppearance</td>
                            <td class="mono">@(string.IsNullOrWhiteSpace(row.PtagCode) ? "—" : row.PtagCode)</td>
                            <td>@row.IssuedUtc.ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="right nowrap">
                                @if (row.WardReceivedUtc is null && Session.Has(PermissionCodes.TransfusionDocument))
                                {
                                    <button type="button" class="btn btn-ghost btn-sm" @onclick="() => SelectWardIssue(row.IssueId, row.ProductName, row.UnitExpiresUtc, row.UnitBloodType, row.SpecimenAccession, row.CrossmatchExpiresUtc, row.LatestCrossmatchResult, row.IssuedTo, row.CoolerId, row.IssuedToLocation, row.IssuedBy, row.EmergencyReleaseDetails, row.SecondVerifier, row.EmergencyReleaseAuthorizer, row.IssueAppearance, row.PtagCode, row.CrossmatchStatus)">Receive</button>
                                }
                                @if (Session.Has(PermissionCodes.IssueReturn))
                                {
                                    <button type="button" class="btn btn-secondary btn-sm" @onclick="() => SelectReturnIssue(row)">Return</button>
                                }
                                @if (row.WardReceivedUtc is not null && Session.Has(PermissionCodes.TransfusionDocument))
                                {
                                    <button type="button" class="btn btn-primary btn-sm" @onclick="() => SelectTransfusionIssue(row)">Document</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}

<div class="bb-card" @ref="_issueForm" tabindex="-1">
    <div class="bb-card-title"><h3>Issue a unit</h3></div>
    @if (!Session.Has(PermissionCodes.IssueCreate))
    {
        <div class="muted">You do not have permission to issue units.</div>
    }
    else
    {
        <Outcome Value="_issueFb" RequiresSignature="true" />
        <div class="form-row">
            <div class="field"><label>Unit number</label>
                <UnitPickerComboBox Scope="UnitPickerScope.Issuable" @bind-Value="_issue.BloodUnitId" />
            </div>
            <div class="field"><label>Patient</label>
                <FilterableComboBox TItem="PatientDto" TValue="long?"
                    Items="_patients"
                    @bind-Value="IssuePatientId"
                    @bind-Value:after="OnIssuePatientChangedAsync"
                    DisplayText="@(p => $"{p.LastName}, {p.FirstName} ({p.MedicalRecordNumber})")"
                    ItemValue="@(p => p.Id)"
                    SearchText="@(p => $"{p.LastName} {p.FirstName} {p.MedicalRecordNumber}")"
                    Clearable="true"
                    Placeholder="Search MRN or name" />
            </div>
            <div class="field"><label>Issued to (person)</label><input @bind="_issue.IssuedTo" /></div>
            <div class="field"><label>Issued to (location)</label><input @bind="_issue.IssuedToLocation" /></div>
            <div class="field"><label>Cooler / transport id</label><input @bind="_issue.CoolerId" placeholder="Optional cooler checkout" /></div>
            <div class="field"><label>Issue type</label>
                <select @bind="_issue.IssueType">@foreach (var t in AllowedIssueTypes) { <option value="@t">@t</option> }</select>
            </div>
        </div>
        <div class="form-row">
            <div class="field"><label>Patient ID 1 (MRN)</label><input @bind="_issue.PatientIdentifier1Value" /></div>
            <div class="field"><label>Patient ID 2 (DOB yyyy-MM-dd)</label><input @bind="_issue.PatientIdentifier2Value" /></div>
            <div class="field"><label>Second verifier</label>
                <FilterableComboBox TItem="DirectoryUserDto" TValue="string?"
                    Items="SecondVerifierChoices"
                    @bind-Value="_issue.SecondVerifier"
                    DisplayText="@(u => u.Label)"
                    ItemValue="@(u => u.UserName)"
                    SearchText="@(u => u.Label)"
                    Clearable="true"
                    Placeholder="Different active user" />
            </div>
        </div>
        <div class="flex gap" style="flex-wrap:wrap;margin:.5rem 0 1rem;">
            <div class="field" style="min-width:14rem;">
                <label>Appearance at issue</label>
                <select @bind="_issue.Appearance">
                    @foreach (var a in Enum.GetValues<UnitAppearance>()) { <option value="@a">@a</option> }
                </select>
            </div>
        </div>
        <UnitScanVerificationPanel Scan="_issueScan" />
        @if (_ptagRequired && Session.Has(PermissionCodes.PrintLabel))
        {
            <div class="alert alert-warning" style="margin-top:.75rem;">
                <strong>P-tag ID</strong>
                <p class="muted">Print the compatibility tag, then scan the P-tag ID before issuing.</p>
                <div class="flex gap" style="flex-wrap:wrap;align-items:end;">
                    <button type="button" class="btn btn-secondary btn-sm" disabled="@(_busy || _issue.BloodUnitId is null || _issue.PatientId <= 0)" @onclick="PrintPreparedPtagAsync">Print P-tag</button>
                    <div class="field" style="min-width:14rem;margin:0;">
                        <label>Scanned P-tag ID</label>
                        <input @bind="_ptagScan" autocomplete="off" />
                    </div>
                    @if (_ptagJobId is long preparedJob)
                    {
                        <a class="btn btn-ghost btn-sm" href="@($"/printing?jobId={preparedJob}")">Open preview</a>
                    }
                </div>
                <Outcome Value="_ptagFb" />
            </div>
        }
        @if (PrefillNotices.Count > 0)
        {
            <div class="alert alert-warning">
                <strong>This reserved unit</strong>
                <ul>
                    @foreach (var notice in PrefillNotices)
                    {
                        <li>@notice</li>
                    }
                </ul>
            </div>
        }
        @if (_issueAckRequirements.Count > 0)
        {
            <div class="alert alert-warning" style="margin-top:.75rem;">
                <strong>Acknowledge special requirements</strong>
                @foreach (var req in _issueAckRequirements)
                {
                    <label class="flex" style="gap:.35rem;margin-top:.35rem;">
                        <input type="checkbox" checked="@_issueAcks.Contains(req.Code ?? "")" @onchange="e => ToggleIssueAck(req.Code, (bool)(e.Value ?? false))" />
                        @(req.Name ?? req.Code) @(string.IsNullOrWhiteSpace(req.Instruction) ? "" : $"— {req.Instruction}")
                    </label>
                }
            </div>
        }

        <div class="alert alert-warning">
            <label class="flex"><input type="checkbox" @bind="_overrideOn" /> &nbsp;<strong>Override</strong> (emergency release / warning override)</label>
            @if (_overrideOn)
            {
                <div class="form-row" style="margin-top:.5rem;">
                    <div class="field"><label>Override reason</label><input @bind="_overrideReason" /></div>
                    <div class="field"><label>Authorized by</label><input @bind="_authorizedBy" /></div>
                    <div class="field"><label>Meaning of signature</label><input @bind="_signatureMeaning" placeholder="e.g. I authorize emergency release" /></div>
                    <div class="field"><label>Password / PIN</label><input type="password" @bind="_signatureSecret" /></div>
                </div>
            }
        </div>

        @if (_overrideOn)
        {
            <button class="btn btn-danger" disabled="@(_busy || _issue.BloodUnitId is null || _issue.PatientId <= 0 || PtagScanMissing)" @onclick="IssueWithOverrideAsync">Sign &amp; issue (override)</button>
        }
        else
        {
            <button class="btn btn-primary" disabled="@(_busy || _issue.BloodUnitId is null || _issue.PatientId <= 0 || PtagScanMissing)" @onclick="IssueAsync">Issue unit</button>
        }

        @if (_lastIssue is not null)
        {
            <div class="alert alert-success" style="margin-top:1rem;">
                Issue <strong>#@_lastIssue.Id</strong> created for unit @_lastIssue.BloodUnitId &middot; <span class="badge badge-amber">@_lastIssue.Status</span>
                <div class="flex gap" style="margin-top:.65rem;flex-wrap:wrap;">
                    @if (Session.Has(PermissionCodes.PrintLabel))
                    {
                        <button type="button" class="btn btn-primary btn-sm" disabled="@_busy" @onclick="PrintLastIssuePtagAsync">Print P-tag</button>
                    }
                    <a class="btn btn-secondary btn-sm" href="@PtagPrintHref()">Open Printing</a>
                    <a class="btn btn-ghost btn-sm" href="@($"/patients/{_lastIssue.PatientId}?tab=products")">Open chart · Products</a>
                </div>
                <Outcome Value="_ptagFb" />
            </div>
        }
    }
</div>

<div class="bb-card">
    <div class="bb-card-title"><h3>Ward receipt</h3></div>
    <p class="muted">The receiving location must acknowledge custody before transfusion can be documented (SoftBank remote-issue receipt).</p>
    @if (!Session.Has(PermissionCodes.TransfusionDocument))
    {
        <div class="muted">No permission to record ward receipt.</div>
    }
    else
    {
        <Outcome Value="_wardFb" />
        <div class="form-row">
            <div class="field"><label>Issue id</label><input type="number" @bind="_wardIssueId" placeholder="Or Receive from Issued units" /></div>
            <div class="field"><label>Received by</label><input @bind="_wardReceivedBy" placeholder="Nurse / ward staff" /></div>
            <div class="field"><label>Appearance at receipt</label>
                <select @bind="_wardAppearance">
                    @foreach (var a in Enum.GetValues<UnitAppearance>()) { <option value="@a">@a</option> }
                </select>
            </div>
        </div>
        <UnitScanVerificationPanel Scan="_wardScan"
            Title="Ward receipt scan"
            Help="Scan the unit label at the receiving location. Required for ISBT-labeled units (SoftBank remote-issue chain)." />
        <div class="flex gap" style="margin-top:.75rem;">
            <button class="btn btn-primary btn-sm" disabled="@_busy" @onclick="RecordWardReceiptAsync">Acknowledge receipt</button>
            <button class="btn btn-ghost btn-sm" disabled="@_busy" @onclick="LoadIssueAsync">Check status</button>
        </div>
        @if (!string.IsNullOrWhiteSpace(_wardProductName) || !string.IsNullOrWhiteSpace(_wardExpirationNotice) || !string.IsNullOrWhiteSpace(_wardUnitTypeNotice) || !string.IsNullOrWhiteSpace(_wardSpecimenNotice) || !string.IsNullOrWhiteSpace(_wardCrossmatchNotice) || !string.IsNullOrWhiteSpace(_wardIssuedToNotice) || !string.IsNullOrWhiteSpace(_wardCoolerNotice) || !string.IsNullOrWhiteSpace(_wardLocationNotice) || !string.IsNullOrWhiteSpace(_wardIssuedByNotice) || !string.IsNullOrWhiteSpace(_wardSecondVerifierNotice))
        {
            <p class="muted" style="margin-top:.75rem;">Receiving @if (!string.IsNullOrWhiteSpace(_wardProductName)) { <strong>@_wardProductName</strong> }@(string.IsNullOrWhiteSpace(_wardExpirationNotice) ? "" : $" · {_wardExpirationNotice}")@(string.IsNullOrWhiteSpace(_wardUnitTypeNotice) ? "" : $" · {_wardUnitTypeNotice}")@(string.IsNullOrWhiteSpace(_wardSpecimenNotice) ? "" : $" · {_wardSpecimenNotice}")@(string.IsNullOrWhiteSpace(_wardCrossmatchNotice) ? "" : $" · {_wardCrossmatchNotice}")@(string.IsNullOrWhiteSpace(_wardIssuedToNotice) ? "" : $" · {_wardIssuedToNotice}")@(string.IsNullOrWhiteSpace(_wardCoolerNotice) ? "" : $" · {_wardCoolerNotice}")@(string.IsNullOrWhiteSpace(_wardLocationNotice) ? "" : $" · {_wardLocationNotice}")@(string.IsNullOrWhiteSpace(_wardIssuedByNotice) ? "" : $" · {_wardIssuedByNotice}")@(string.IsNullOrWhiteSpace(_wardSecondVerifierNotice) ? "" : $" · {_wardSecondVerifierNotice}").</p>
        }
        @if (!string.IsNullOrWhiteSpace(_wardReleaseReason))
        {
            <p class="muted">@_wardReleaseReason</p>
        }
        @if (!string.IsNullOrWhiteSpace(_wardReleaseAuthorizer))
        {
            <p class="muted">@_wardReleaseAuthorizer</p>
        }
        @if (!string.IsNullOrWhiteSpace(_wardIssueAppearance))
        {
            <p class="muted">@_wardIssueAppearance</p>
        }
        @if (!string.IsNullOrWhiteSpace(_wardPtagNotice))
        {
            <p class="muted">@_wardPtagNotice</p>
        }
        @if (!string.IsNullOrWhiteSpace(_wardCrossmatchStatusNotice))
        {
            <p class="muted">@_wardCrossmatchStatusNotice</p>
        }
        @if (_wardIssue is not null)
        {
            <p class="muted" style="margin-top:.75rem;">
                Issue <strong>@_wardIssue.Id</strong> · @_wardIssue.Status
                @if (_wardIssue.WardReceivedUtc is not null)
                {
                    <span> · received @_wardIssue.WardReceivedUtc.Value.ToString("yyyy-MM-dd HH:mm") by @_wardIssue.WardReceivedBy · @_wardIssue.WardAppearance</span>
                }
                else
                {
                    <span> · awaiting ward receipt</span>
                }
                <span> · </span>
                <a href="@($"/patients/{_wardIssue.PatientId}?tab=products")">Open chart · Products</a>
                <span> · </span>
                <a href="@InventoryUrls.Unit(_wardIssue.BloodUnitId)">Open Inventory</a>
            </p>
        }
    }
</div>

<div class="bb-grid cols-2">
    <div class="bb-card">
        <div class="bb-card-title"><h3>Return a unit</h3></div>
        @if (!Session.Has(PermissionCodes.IssueReturn))
        {
            <div class="muted">No permission to return units.</div>
        }
        else
        {
            <Outcome Value="_returnFb" />
            <div class="form-row">
                <div class="field"><label>Issue id</label><input type="number" @bind="_returnIssueId" placeholder="Or Return from Issued units" /></div>
                <div class="field"><label>Reason</label><input @bind="_returnReason" /></div>
                <div class="field"><label>Destination</label>
                    <select @bind="_returnDestination">
                        @if (ReturnCanBeAvailable)
                        {
                            <option value="@UnitStatus.Available">Available</option>
                        }
                        <option value="@UnitStatus.Quarantine">Quarantine</option>
                        <option value="@UnitStatus.Discarded">Disposed</option>
                    </select>
                </div>
                @if (_returnUnitNumber is not null)
                {
                    <p class="muted" style="margin:0;">Returning <span class="mono">@_returnUnitNumber</span>@(string.IsNullOrWhiteSpace(_returnProductName) ? "" : $" · {_returnProductName}")@(string.IsNullOrWhiteSpace(_returnExpirationNotice) ? "" : $" · {_returnExpirationNotice}")@(string.IsNullOrWhiteSpace(_returnUnitTypeNotice) ? "" : $" · {_returnUnitTypeNotice}")@(string.IsNullOrWhiteSpace(_returnSpecimenNotice) ? "" : $" · {_returnSpecimenNotice}")@(string.IsNullOrWhiteSpace(_returnCrossmatchNotice) ? "" : $" · {_returnCrossmatchNotice}")@(string.IsNullOrWhiteSpace(_returnIssuedToNotice) ? "" : $" · {_returnIssuedToNotice}")@(string.IsNullOrWhiteSpace(_returnCoolerNotice) ? "" : $" · {_returnCoolerNotice}")@(string.IsNullOrWhiteSpace(_returnLocationNotice) ? "" : $" · {_returnLocationNotice}")@(string.IsNullOrWhiteSpace(_returnIssuedByNotice) ? "" : $" · {_returnIssuedByNotice}")@(string.IsNullOrWhiteSpace(_returnSecondVerifierNotice) ? "" : $" · {_returnSecondVerifierNotice}")@(string.IsNullOrWhiteSpace(_returnPatientName) ? "" : $" · {_returnPatientName}").</p>
                    @if (!string.IsNullOrWhiteSpace(_returnReleaseReason))
                    {
                        <p class="muted" style="margin:0;">@_returnReleaseReason</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(_returnReleaseAuthorizer))
                    {
                        <p class="muted" style="margin:0;">@_returnReleaseAuthorizer</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(_returnIssueAppearance))
                    {
                        <p class="muted" style="margin:0;">@_returnIssueAppearance</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(_returnPtagNotice))
                    {
                        <p class="muted" style="margin:0;">@_returnPtagNotice</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(_returnCrossmatchStatusNotice))
                    {
                        <p class="muted" style="margin:0;">@_returnCrossmatchStatusNotice</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(_returnWardAppearance))
                    {
                        <p class="muted" style="margin:0;">@_returnWardAppearance</p>
                    }
                }
            </div>
            <p class="muted">Record temperature, seal, and visual inspection. A failed seal or appearance cannot return to available stock. Time out of storage is still computed by the return rule.</p>
            <label class="checkbox-item"><input type="checkbox" @bind="_returnTempOk" @bind:after="SyncReturnDestination" /> Temperature acceptable</label>
            <label class="checkbox-item"><input type="checkbox" @bind="_returnSealOk" @bind:after="SyncReturnDestination" /> Seal intact</label>
            <label class="checkbox-item"><input type="checkbox" @bind="_returnVisualOk" @bind:after="SyncReturnDestination" /> Visual inspection acceptable</label>
            <button class="btn btn-secondary" disabled="@(_busy || string.IsNullOrWhiteSpace(_returnReason))" @onclick="ReturnAsync">Return unit</button>
            @if (_lastReturn is not null)
            {
                <p class="muted" style="margin-top:.75rem;">
                    Return #@_lastReturn.Id recorded@( _lastReturn.ReissueEligible ? " · eligible for reissue" : " · not eligible for reissue").
                    <a href="@InventoryUrls.Unit(_lastReturn.BloodUnitId)">Open Inventory</a>
                    @if (_returnPatientId is long returnedPatientId)
                    {
                        <span> · </span>
                        <a href="@($"/patients/{returnedPatientId}?tab=products")">Open chart · Products</a>
                    }
                </p>
            }
        }
    </div>

    <div class="bb-card">
        <div class="bb-card-title"><h3>Document transfusion</h3></div>
        @if (!Session.Has(PermissionCodes.TransfusionDocument))
        {
            <div class="muted">No permission to document transfusions.</div>
        }
        else
        {
            <Outcome Value="_txFb" />
            <div class="form-row">
                <div class="field"><label>Issue id</label><input type="number" @bind="_txIssueId" placeholder="Or Document from Issued units" /></div>
                <div class="field"><label>Disposition</label>
                    <select @bind="_txDisposition">@foreach (var d in Enum.GetValues<TransfusionDisposition>()) { <option value="@d">@d</option> }</select>
                </div>
                <div class="field"><label>Volume transfused (mL)</label><input type="number" @bind="_txVolume" /></div>
                <div class="field"><label>Transfusionist</label><input @bind="_txTransfusionist" /></div>
                <div class="field"><label>Second verifier</label>
                    <FilterableComboBox TItem="DirectoryUserDto" TValue="string?"
                        Items="SecondVerifierChoices"
                        @bind-Value="_txSecondVerifier"
                        DisplayText="@(u => u.Label)"
                        ItemValue="@(u => u.UserName)"
                        SearchText="@(u => u.Label)"
                        Clearable="true"
                        Placeholder="Different active user" />
                </div>
            </div>
            <p class="muted">The receiving location must acknowledge the unit (ward receipt) before this can succeed. Patient identifiers must match the issued patient — a checkbox is not positive identification.</p>
            @if (!string.IsNullOrWhiteSpace(_txProductName) || !string.IsNullOrWhiteSpace(_txExpirationNotice) || !string.IsNullOrWhiteSpace(_txUnitTypeNotice) || !string.IsNullOrWhiteSpace(_txSpecimenNotice) || !string.IsNullOrWhiteSpace(_txCrossmatchNotice) || !string.IsNullOrWhiteSpace(_txIssuedToNotice) || !string.IsNullOrWhiteSpace(_txCoolerNotice) || !string.IsNullOrWhiteSpace(_txLocationNotice) || !string.IsNullOrWhiteSpace(_txIssuedByNotice) || !string.IsNullOrWhiteSpace(_txSecondVerifierNotice))
            {
                <p class="muted">Documenting @if (!string.IsNullOrWhiteSpace(_txProductName)) { <strong>@_txProductName</strong> }@(string.IsNullOrWhiteSpace(_txExpirationNotice) ? "" : $" · {_txExpirationNotice}")@(string.IsNullOrWhiteSpace(_txUnitTypeNotice) ? "" : $" · {_txUnitTypeNotice}")@(string.IsNullOrWhiteSpace(_txSpecimenNotice) ? "" : $" · {_txSpecimenNotice}")@(string.IsNullOrWhiteSpace(_txCrossmatchNotice) ? "" : $" · {_txCrossmatchNotice}")@(string.IsNullOrWhiteSpace(_txIssuedToNotice) ? "" : $" · {_txIssuedToNotice}")@(string.IsNullOrWhiteSpace(_txCoolerNotice) ? "" : $" · {_txCoolerNotice}")@(string.IsNullOrWhiteSpace(_txLocationNotice) ? "" : $" · {_txLocationNotice}")@(string.IsNullOrWhiteSpace(_txIssuedByNotice) ? "" : $" · {_txIssuedByNotice}")@(string.IsNullOrWhiteSpace(_txSecondVerifierNotice) ? "" : $" · {_txSecondVerifierNotice}").</p>
            }
            @if (!string.IsNullOrWhiteSpace(_txReleaseReason))
            {
                <p class="muted">@_txReleaseReason</p>
            }
            @if (!string.IsNullOrWhiteSpace(_txReleaseAuthorizer))
            {
                <p class="muted">@_txReleaseAuthorizer</p>
            }
            @if (!string.IsNullOrWhiteSpace(_txIssueAppearance))
            {
                <p class="muted">@_txIssueAppearance</p>
            }
            @if (!string.IsNullOrWhiteSpace(_txPtagNotice))
            {
                <p class="muted">@_txPtagNotice</p>
            }
            @if (!string.IsNullOrWhiteSpace(_txCrossmatchStatusNotice))
            {
                <p class="muted">@_txCrossmatchStatusNotice</p>
            }
            @if (!string.IsNullOrWhiteSpace(_txWardAppearance))
            {
                <p class="muted">@_txWardAppearance</p>
            }
            <div class="form-row">
                <div class="field"><label>Patient ID 1 (MRN)</label><input @bind="_txPatientIdentifier1" /></div>
                <div class="field"><label>Patient ID 2 (DOB yyyy-MM-dd)</label><input @bind="_txPatientIdentifier2" /></div>
            </div>
            <label class="flex"><input type="checkbox" @bind="_txReaction" /> &nbsp;Reaction suspected</label>
            <UnitScanVerificationPanel Scan="_txScan" Title="Bedside unit scan" Help="Scan the unit at the bedside. Required for ISBT-labeled units together with matching patient identifiers." />
            <div style="margin-top:.75rem;">
                <button class="btn btn-secondary" disabled="@_busy" @onclick="DocumentTransfusionAsync">Document</button>
            </div>
            @if (_lastTransfusion is not null)
            {
                <p class="muted" style="margin-top:.75rem;">
                    Transfusion #@_lastTransfusion.Id documented for issue #@_lastTransfusion.IssueId.
                    <a href="@($"/patients/{_lastTransfusion.PatientId}?tab=products")">Open chart · Products</a>
                </p>
            }
            @if (_openedReactionId is long reactionId)
            {
                <div class="alert alert-warning" style="margin-top:.75rem;">
                    Reaction workup opened.
                    <a href="@($"/reactions?id={reactionId}")">Open investigation #@reactionId</a>
                </div>
            }
        }
    </div>
</div>

@code {
    private IEnumerable<IssueType> AllowedIssueTypes =>
        Enum.GetValues<IssueType>().Where(t =>
            t is not (IssueType.EmergencyRelease or IssueType.MassiveTransfusion)
            || Session.Has(PermissionCodes.IssueEmergencyRelease));

    private bool _busy;
    private ElementReference _issueForm;

    private IssueModel _issue = new();
    private List<SpecialRequirementDto> _issueAckRequirements = new();
    private HashSet<string> _issueAcks = new(StringComparer.OrdinalIgnoreCase);
    private Feedback? _issueFb;
    private Feedback? _ptagFb;
    private IssueDto? _lastIssue;
    private bool _ptagRequired;
    private string _ptagScan = string.Empty;
    private bool PtagScanMissing => _ptagRequired && string.IsNullOrWhiteSpace(_ptagScan);

    private bool _overrideOn;
    private string _overrideReason = string.Empty;
    private string _authorizedBy = string.Empty;
    private string _signatureMeaning = string.Empty;
    private string _signatureSecret = string.Empty;

    private long _wardIssueId;
    private string? _wardProductName;
    private string? _wardExpirationNotice;
    private string? _wardUnitTypeNotice;
    private string? _wardSpecimenNotice;
    private string? _wardCrossmatchNotice;
    private string? _wardIssuedToNotice;
    private string? _wardCoolerNotice;
    private string? _wardLocationNotice;
    private string? _wardIssuedByNotice;
    private string? _wardSecondVerifierNotice;
    private string? _wardReleaseReason;
    private string? _wardReleaseAuthorizer;
    private string? _wardIssueAppearance;
    private string? _wardPtagNotice;
    private string? _wardCrossmatchStatusNotice;
    private string _wardReceivedBy = string.Empty;
    private UnitAppearance _wardAppearance = UnitAppearance.Acceptable;
    private Feedback? _wardFb;
    private IssueDto? _wardIssue;

    private long _returnIssueId;
    private string _returnReason = string.Empty;
    private bool _returnTempOk = true;
    private bool _returnSealOk = true;
    private bool _returnVisualOk = true;
    private UnitStatus _returnDestination = UnitStatus.Available;
    private bool ReturnCanBeAvailable => _returnTempOk && _returnSealOk && _returnVisualOk;
    private Feedback? _returnFb;

    private long _txIssueId;
    private string? _txProductName;
    private string? _txExpirationNotice;
