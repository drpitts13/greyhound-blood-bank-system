@page "/issuing"
@inject BloodBankApiClient Api
@inject UserSession Session

<PageTitle>Issue &amp; Transfuse &middot; Greyhound Blood Bank LIS</PageTitle>

<h1>Issue &amp; Transfuse</h1>
<p class="muted">The issue gate runs all safety checks. Overrides require a reason and an electronic signature.</p>

@if (Session.Has(PermissionCodes.IssueCreate))
{
    <div class="bb-card">
        <div class="bb-card-title"><h3>Retrospective crossmatch due</h3></div>
        <p class="muted">Emergency and MTP issues released without a compatible crossmatch stay here until retrospective testing is recorded (21 CFR 606.151(b)).</p>
        @if (_retroItems.Count == 0)
        {
            <div class="muted">No retrospective crossmatches pending.</div>
        }
        else
        {
            <table class="bb">
                <thead>
                    <tr>
                        <th>Issue</th>
                        <th>MRN</th>
                        <th>Unit</th>
                        <th>Type</th>
                        <th>Issued</th>
                        <th>Due</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _retroItems)
                    {
                        <tr>
                            <td><a href="@($"/patients/{row.PatientId}")">#@row.IssueId</a></td>
                            <td class="mono">@(row.MedicalRecordNumber ?? "—")</td>
                            <td class="mono">@row.BloodUnitId</td>
                            <td>@row.IssueType</td>
                            <td>@row.IssuedUtc.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>
                                @(row.DueUtc?.ToString("yyyy-MM-dd HH:mm") ?? "—")
                                @if (row.IsOverdue)
                                {
                                    <span class="badge badge-amber">Overdue</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <div class="bb-card">
        <div class="bb-card-title"><h3>In transit to ward</h3></div>
        <p class="muted">Issued units in a cooler or courier handoff until the receiving location acknowledges custody (SoftBank remote issue).</p>
        @if (_inTransitItems.Count == 0)
        {
            <div class="muted">No units currently in transit.</div>
        }
        else
        {
            <table class="bb">
                <thead>
                    <tr>
                        <th>Issue</th>
                        <th>MRN</th>
                        <th>Unit</th>
                        <th>Cooler</th>
                        <th>Location</th>
                        <th>Issued</th>
                        <th>Due</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _inTransitItems)
                    {
                        <tr>
                            <td><a href="@($"/patients/{row.PatientId}")">#@row.IssueId</a></td>
                            <td class="mono">@(row.MedicalRecordNumber ?? "—")</td>
                            <td class="mono">@row.BloodUnitId</td>
                            <td class="mono">@(row.CoolerId ?? "—")</td>
                            <td>@(row.IssuedToLocation ?? "—")</td>
                            <td>@row.IssuedUtc.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>
                                @(row.DueUtc?.ToString("yyyy-MM-dd HH:mm") ?? "—")
                                @if (row.IsOverdue)
                                {
                                    <span class="badge badge-amber">Overdue</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}

<div class="bb-card">
    <div class="bb-card-title"><h3>Issue a unit</h3></div>
    @if (!Session.Has(PermissionCodes.IssueCreate))
    {
        <div class="muted">You do not have permission to issue units.</div>
    }
    else
    {
        <Outcome Value="_issueFb" RequiresSignature="true" />
        <div class="form-row">
            <div class="field"><label>Blood unit id</label><input type="number" @bind="_issue.BloodUnitId" /></div>
            <div class="field"><label>Patient id</label><input type="number" @bind="_issue.PatientId" /></div>
            <div class="field"><label>Issued to (person)</label><input @bind="_issue.IssuedTo" /></div>
            <div class="field"><label>Issued to (location)</label><input @bind="_issue.IssuedToLocation" /></div>
            <div class="field"><label>Cooler / transport id</label><input @bind="_issue.CoolerId" placeholder="Optional cooler checkout" /></div>
            <div class="field"><label>Issue type</label>
                <select @bind="_issue.IssueType">@foreach (var t in Enum.GetValues<IssueType>()) { <option value="@t">@t</option> }</select>
            </div>
        </div>
        <div class="form-row">
            <div class="field"><label>Patient ID 1 (MRN)</label><input @bind="_issue.PatientIdentifier1Value" /></div>
            <div class="field"><label>Patient ID 2 (DOB yyyy-MM-dd)</label><input @bind="_issue.PatientIdentifier2Value" /></div>
            <div class="field"><label>Second verifier</label>
                <FilterableComboBox TItem="DirectoryUserDto" TValue="string?"
                    Items="SecondVerifierChoices"
                    @bind-Value="_issue.SecondVerifier"
                    DisplayText="@(u => u.Label)"
                    ItemValue="@(u => u.UserName)"
                    SearchText="@(u => u.Label)"
                    Clearable="true"
                    Placeholder="Different active user" />
            </div>
        </div>
        <div class="flex gap" style="flex-wrap:wrap;margin:.5rem 0 1rem;">
            <label class="flex"><input type="checkbox" @bind="_issue.VisualInspectionAcceptable" /> &nbsp;Visual inspection acceptable</label>
        </div>
        <UnitScanVerificationPanel Scan="_issueScan" />

        <div class="alert alert-warning">
            <label class="flex"><input type="checkbox" @bind="_overrideOn" /> &nbsp;<strong>Override</strong> (emergency release / warning override)</label>
            @if (_overrideOn)
            {
                <div class="form-row" style="margin-top:.5rem;">
                    <div class="field"><label>Override reason</label><input @bind="_overrideReason" /></div>
                    <div class="field"><label>Authorized by</label><input @bind="_authorizedBy" /></div>
                    <div class="field"><label>Meaning of signature</label><input @bind="_signatureMeaning" placeholder="e.g. I authorize emergency release" /></div>
                    <div class="field"><label>Password / PIN</label><input type="password" @bind="_signatureSecret" /></div>
                </div>
            }
        </div>

        @if (_overrideOn)
        {
            <button class="btn btn-danger" disabled="@_busy" @onclick="IssueWithOverrideAsync">Sign &amp; issue (override)</button>
        }
        else
        {
            <button class="btn btn-primary" disabled="@_busy" @onclick="IssueAsync">Issue unit</button>
        }

        @if (_lastIssue is not null)
        {
            <div class="alert alert-success" style="margin-top:1rem;">
                Issue <strong>#@_lastIssue.Id</strong> created for unit @_lastIssue.BloodUnitId &middot; <span class="badge badge-amber">@_lastIssue.Status</span>
            </div>
        }
    }
</div>

<div class="bb-card">
    <div class="bb-card-title"><h3>Ward receipt</h3></div>
    <p class="muted">The receiving location must acknowledge custody before transfusion can be documented (SoftBank remote-issue receipt).</p>
    @if (!Session.Has(PermissionCodes.TransfusionDocument))
    {
        <div class="muted">No permission to record ward receipt.</div>
    }
    else
    {
        <Outcome Value="_wardFb" />
        <div class="form-row">
            <div class="field"><label>Issue id</label><input type="number" @bind="_wardIssueId" /></div>
            <div class="field"><label>Received by</label><input @bind="_wardReceivedBy" placeholder="Nurse / ward staff" /></div>
        </div>
        <label class="flex"><input type="checkbox" @bind="_wardVisualOk" /> &nbsp;Visual inspection acceptable at receipt</label>
        <UnitScanVerificationPanel Scan="_wardScan"
            Title="Ward receipt scan"
            Help="Scan the unit label at the receiving location. Required for ISBT-labeled units (SoftBank remote-issue chain)." />
        <div class="flex gap" style="margin-top:.75rem;">
            <button class="btn btn-primary btn-sm" disabled="@_busy" @onclick="RecordWardReceiptAsync">Acknowledge receipt</button>
            <button class="btn btn-ghost btn-sm" disabled="@_busy" @onclick="LoadIssueAsync">Check status</button>
        </div>
        @if (_wardIssue is not null)
        {
            <p class="muted" style="margin-top:.75rem;">
                Issue <strong>@_wardIssue.Id</strong> · @_wardIssue.Status
                @if (_wardIssue.WardReceivedUtc is not null)
                {
                    <span> · received @_wardIssue.WardReceivedUtc.Value.ToString("yyyy-MM-dd HH:mm") by @_wardIssue.WardReceivedBy</span>
                }
                else
                {
                    <span> · awaiting ward receipt</span>
                }
            </p>
        }
    }
</div>

<div class="bb-grid cols-2">
    <div class="bb-card">
        <div class="bb-card-title"><h3>Return a unit</h3></div>
        @if (!Session.Has(PermissionCodes.IssueReturn))
        {
            <div class="muted">No permission to return units.</div>
        }
        else
        {
            <Outcome Value="_returnFb" />
            <div class="form-row">
                <div class="field"><label>Issue id</label><input type="number" @bind="_returnIssueId" /></div>
                <div class="field"><label>Reason</label><input @bind="_returnReason" /></div>
            </div>
            <p class="muted">Reissue eligibility is computed from temperature, seal, visual inspection, and time out of storage.</p>
            <button class="btn btn-secondary" disabled="@_busy" @onclick="ReturnAsync">Return unit</button>
        }
    </div>

    <div class="bb-card">
        <div class="bb-card-title"><h3>Document transfusion</h3></div>
        @if (!Session.Has(PermissionCodes.TransfusionDocument))
        {
            <div class="muted">No permission to document transfusions.</div>
        }
        else
        {
            <Outcome Value="_txFb" />
            <div class="form-row">
                <div class="field"><label>Issue id</label><input type="number" @bind="_txIssueId" /></div>
                <div class="field"><label>Disposition</label>
                    <select @bind="_txDisposition">@foreach (var d in Enum.GetValues<TransfusionDisposition>()) { <option value="@d">@d</option> }</select>
                </div>
                <div class="field"><label>Volume transfused (mL)</label><input type="number" @bind="_txVolume" /></div>
                <div class="field"><label>Transfusionist</label><input @bind="_txTransfusionist" /></div>
                <div class="field"><label>Second verifier</label>
                    <FilterableComboBox TItem="DirectoryUserDto" TValue="string?"
                        Items="SecondVerifierChoices"
                        @bind-Value="_txSecondVerifier"
                        DisplayText="@(u => u.Label)"
                        ItemValue="@(u => u.UserName)"
                        SearchText="@(u => u.Label)"
                        Clearable="true"
                        Placeholder="Different active user" />
                </div>
            </div>
            <p class="muted">The receiving location must acknowledge the unit (ward receipt) before this can succeed.</p>
            <label class="flex"><input type="checkbox" @bind="_txPpid" /> &nbsp;Positive patient identification completed</label>
            <label class="flex"><input type="checkbox" @bind="_txReaction" /> &nbsp;Reaction suspected</label>
            <UnitScanVerificationPanel Scan="_txScan" Title="Bedside unit scan" Help="Scan the unit at the bedside. Required for ISBT-labeled units together with positive patient identification." />
            <div style="margin-top:.75rem;">
                <button class="btn btn-secondary" disabled="@_busy" @onclick="DocumentTransfusionAsync">Document</button>
            </div>
        }
    </div>
</div>

@code {
    private bool _busy;

    private IssueModel _issue = new();
    private Feedback? _issueFb;
    private IssueDto? _lastIssue;

    private bool _overrideOn;
    private string _overrideReason = string.Empty;
    private string _authorizedBy = string.Empty;
    private string _signatureMeaning = string.Empty;
    private string _signatureSecret = string.Empty;

    private long _wardIssueId;
    private string _wardReceivedBy = string.Empty;
    private bool _wardVisualOk = true;
    private Feedback? _wardFb;
    private IssueDto? _wardIssue;

    private long _returnIssueId;
    private string _returnReason = string.Empty;
    private Feedback? _returnFb;

    private long _txIssueId;
    private TransfusionDisposition _txDisposition = TransfusionDisposition.Completed;
    private decimal? _txVolume;
    private string? _txTransfusionist;
    private string? _txSecondVerifier;
    private bool _txReaction;
    private bool _txPpid;
    private Feedback? _txFb;
    private readonly UnitScanModel _issueScan = new();
    private readonly UnitScanModel _txScan = new();
    private readonly UnitScanModel _wardScan = new();
    private List<DirectoryUserDto> _directoryUsers = new();
    private List<RetrospectiveCrossmatchWorkItemDto> _retroItems = new();
    private List<InTransitWorkItemDto> _inTransitItems = new();

    private IEnumerable<DirectoryUserDto> SecondVerifierChoices =>
        _directoryUsers.Where(u => !string.Equals(u.UserName, Session.UserName, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        var users = await Api.GetDirectoryUsersAsync();
        if (users.Succeeded) _directoryUsers = users.Value ?? new();
        await LoadWorklistsAsync();
    }

    private async Task LoadWorklistsAsync()
    {
        if (!Session.Has(PermissionCodes.IssueCreate)) return;
        var retro = await Api.GetPendingRetrospectiveCrossmatchesAsync();
        if (retro.Succeeded) _retroItems = retro.Value ?? new();
        var transit = await Api.GetInTransitIssuesAsync();
        if (transit.Succeeded) _inTransitItems = transit.Value ?? new();
    }

    private IssueUnitRequest BuildRequest(string? overrideReason, string? authorizedBy) => new(
        _issue.BloodUnitId,
        _issue.PatientId,
        IdentityTokenType.MedicalRecordNumber,
        _issue.PatientIdentifier1Value,
        IdentityTokenType.DateOfBirth,
        _issue.PatientIdentifier2Value,
        string.IsNullOrWhiteSpace(_issue.IssuedTo) ? null : _issue.IssuedTo,
        string.IsNullOrWhiteSpace(_issue.IssuedToLocation) ? null : _issue.IssuedToLocation,
        _issue.IssueType,
        _issue.VisualInspectionAcceptable,
        _issue.SecondVerifier,
        OverrideReason: overrideReason,
        AuthorizedBy: authorizedBy,
        VerifiedScan: _issueScan.ToRequest(),
        CoolerId: string.IsNullOrWhiteSpace(_issue.CoolerId) ? null : _issue.CoolerId.Trim());

    private async Task IssueAsync()
    {
        _busy = true;
        var r = await Api.IssueUnitAsync(BuildRequest(null, null));
        _issueFb = r.ToFeedback("Unit issued.");
        if (r.Succeeded)
        {
            _lastIssue = r.Value;
            _wardIssueId = r.Value!.Id;
            _txIssueId = r.Value.Id;
            _returnIssueId = r.Value.Id;
            await LoadWorklistsAsync();
        }
        _busy = false;
    }

    private async Task IssueWithOverrideAsync()
    {
        if (string.IsNullOrWhiteSpace(_overrideReason) || string.IsNullOrWhiteSpace(_signatureMeaning))
        {
            _issueFb = new Feedback(false, null, Array.Empty<RuleMessage>(), false, false, Array.Empty<RuleMessage>(),
                "An override reason and a meaning-of-signature are required.");
            return;
        }

        _busy = true;
        // 1) record the electronic signature, 2) issue with the signature id.
        var sig = await Api.RecordSignatureAsync(new SignatureRequestVm("IssueOverride", _signatureMeaning, "Issue", ReauthenticationSecret: _signatureSecret));
        if (!sig.Succeeded || sig.Value is null)
        {
            _busy = false;
            _issueFb = sig.ToFeedback();
            return;
        }

        var r = await Api.IssueUnitAsync(BuildRequest(_overrideReason, string.IsNullOrWhiteSpace(_authorizedBy) ? Session.UserName : _authorizedBy), sig.Value.Id);
        _issueFb = r.ToFeedback("Unit issued under override.");
        if (r.Succeeded)
        {
            _lastIssue = r.Value;
            _wardIssueId = r.Value!.Id;
            _txIssueId = r.Value.Id;
            _returnIssueId = r.Value.Id;
            _overrideOn = false;
            await LoadWorklistsAsync();
        }
        _busy = false;
    }

    private async Task LoadIssueAsync()
    {
        _busy = true;
        var r = await Api.GetIssueAsync(_wardIssueId);
        _busy = false;
        _wardFb = r.ToFeedback("Issue loaded.");
        if (r.Succeeded) _wardIssue = r.Value;
    }

    private async Task RecordWardReceiptAsync()
    {
        _busy = true;
        var r = await Api.RecordWardReceiptAsync(_wardIssueId, new WardReceiptRequest(
            string.IsNullOrWhiteSpace(_wardReceivedBy) ? Session.UserName : _wardReceivedBy,
            _wardVisualOk,
            _wardScan.ToRequest()));
        _busy = false;
        _wardFb = r.ToFeedback("Ward receipt recorded.");
        if (r.Succeeded)
        {
            _wardIssue = r.Value;
            _wardScan.Clear();
            await LoadWorklistsAsync();
        }
    }

    private async Task ReturnAsync()
    {
        _busy = true;
        var r = await Api.ReturnUnitAsync(_returnIssueId, new ReturnUnitRequest(_returnReason));
        _returnFb = r.ToFeedback("Unit returned.");
        if (r.Succeeded) await LoadWorklistsAsync();
        _busy = false;
    }

    private async Task DocumentTransfusionAsync()
    {
        _busy = true;
        var r = await Api.DocumentTransfusionAsync(_txIssueId, new DocumentTransfusionRequest(
            _txDisposition, VolumeTransfused: _txVolume,
            Transfusionist: string.IsNullOrWhiteSpace(_txTransfusionist) ? null : _txTransfusionist,
            ReactionSuspected: _txReaction,
            BedsideScan: _txScan.ToRequest(),
            SecondVerifier: _txSecondVerifier,
            PositivePatientIdentification: _txPpid));
        _busy = false;
        _txFb = r.ToFeedback("Transfusion documented.");
    }

    private sealed class IssueModel
    {
        public long BloodUnitId { get; set; }
        public long PatientId { get; set; }
        public string? PatientIdentifier1Value { get; set; }
        public string? PatientIdentifier2Value { get; set; }
        public string? IssuedTo { get; set; }
        public string? IssuedToLocation { get; set; }
        public IssueType IssueType { get; set; } = IssueType.Standard;
        public bool VisualInspectionAcceptable { get; set; } = true;
        public string? SecondVerifier { get; set; }
        public string? CoolerId { get; set; }
    }
}
