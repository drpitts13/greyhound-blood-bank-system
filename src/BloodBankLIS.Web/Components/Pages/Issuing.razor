        if (patient is null)
        {
            _issue.PatientIdentifier1Value = null;
            _issue.PatientIdentifier2Value = null;
            await LoadIssueRequirementsAsync();
            return;
        }

        (_issue.PatientIdentifier1Value, _issue.PatientIdentifier2Value) = PatientIdentifierEntryRule.Prefill(
