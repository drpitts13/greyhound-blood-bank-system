    private string? UnitNumberForIssue(long issueId) =>
        _outstandingItems.FirstOrDefault(r => r.IssueId == issueId)?.UnitNumber
        ?? _inTransitItems.FirstOrDefault(r => r.IssueId == issueId)?.UnitNumber;

    private async Task<long?> FindIssueForUnitAsync(string unitNumber, Action<Feedback> report)
    {
        if (string.IsNullOrWhiteSpace(unitNumber)) return null;
        var issue = await Api.GetLatestIssueForUnitAsync(unitNumber);
        if (!issue.Succeeded || issue.Value is null)
        {
            report(issue.ToFeedback());
            return null;
        }

        return issue.Value.Id;
    }

    private async Task LookUpWardUnitAsync()
    {
        if (await FindIssueForUnitAsync(_wardUnitLookup, f => _wardFb = f) is not long issueId) return;
        if (_inTransitItems.FirstOrDefault(r => r.IssueId == issueId) is { } t)
        {
            SelectWardIssue(t.IssueId, t.ProductName, t.UnitExpiresUtc, t.UnitBloodType, t.SpecimenAccession, t.CrossmatchExpiresUtc, t.LatestCrossmatchResult, t.IssuedTo, t.CoolerId, t.IssuedToLocation, t.IssuedBy, t.EmergencyReleaseDetails, t.SecondVerifier, t.EmergencyReleaseAuthorizer, t.IssueAppearance, t.PtagCode, t.CrossmatchStatus);
        }
        else if (_outstandingItems.FirstOrDefault(r => r.IssueId == issueId) is { } o)
        {
            SelectWardIssue(o.IssueId, o.ProductName, o.UnitExpiresUtc, o.UnitBloodType, o.SpecimenAccession, o.CrossmatchExpiresUtc, o.LatestCrossmatchResult, o.IssuedTo, o.CoolerId, o.IssuedToLocation, o.IssuedBy, o.EmergencyReleaseDetails, o.SecondVerifier, o.EmergencyReleaseAuthorizer, o.IssueAppearance, o.PtagCode, o.CrossmatchStatus);
        }
        else
        {
            _wardFb = Feedback.Fail($"Unit {_wardUnitLookup.Trim()} has no issue waiting for ward receipt.");
        }
    }

    private async Task LookUpReturnUnitAsync()
    {
        if (await FindIssueForUnitAsync(_returnUnitLookup, f => _returnFb = f) is not long issueId) return;
        if (_outstandingItems.FirstOrDefault(r => r.IssueId == issueId) is { } row) SelectReturnIssue(row);
        else _returnFb = Feedback.Fail($"Unit {_returnUnitLookup.Trim()} is not currently issued, so it cannot be returned.");
    }

    private async Task LookUpTransfusionUnitAsync()
    {
        if (await FindIssueForUnitAsync(_txUnitLookup, f => _txFb = f) is not long issueId) return;
        if (_outstandingItems.FirstOrDefault(r => r.IssueId == issueId) is { } row) SelectTransfusionIssue(row);
        else _txFb = Feedback.Fail($"Unit {_txUnitLookup.Trim()} is not currently issued, so there is no transfusion to document.");
    }

