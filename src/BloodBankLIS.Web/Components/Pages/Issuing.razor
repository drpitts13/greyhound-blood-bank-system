@page "/issuing"
@using Microsoft.AspNetCore.Components
@inject BloodBankApiClient Api
@inject UserSession Session

<PageTitle>Issue &amp; Transfuse &middot; Greyhound Blood Bank LIS</PageTitle>

<h1>Issue &amp; Transfuse</h1>
<p class="muted">The issue gate runs all safety checks, including storage-location policy and electronic / remote issue eligibility (AABB 5.16). Overrides require a reason and an electronic signature. Reserved units appear on Ready to issue so the desk does not re-key patient and unit after allocate.</p>

@if (Session.Has(PermissionCodes.IssueCreate))
{
    <div class="bb-card">
        <div class="bb-card-title"><h3>Second ABO/Rh due</h3></div>
        <p class="muted">Patients with reserved units who still need a concordant historical or second-sample type before routine red-cell issue (AABB 5.14 / CAP TRM.40650).</p>
        @if (_secondAboItems.Count == 0)
        {
            <div class="muted">No reserved units waiting on a second ABO/Rh.</div>
        }
        else
        {
            <table class="bb">
                <thead>
                    <tr>
                        <th>Patient</th>
                        <th>MRN</th>
                        <th>Current type</th>
                        <th>Reserved</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _secondAboItems)
                    {
                        <tr>
                            <td><a href="@($"/patients/{row.PatientId}")">@row.DisplayName</a></td>
                            <td class="mono">@row.MedicalRecordNumber</td>
                            <td class="mono">@row.CurrentAboRh</td>
                            <td>@row.ReservedUnitCount</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <div class="bb-card">
        <div class="bb-card-title"><h3>Ready to issue</h3></div>
        <p class="muted">Units reserved to a patient. Issue from the row prefills unit, MRN, and date of birth on the existing issue form. The issue gate is unchanged.</p>
        @if (_readyItems.Count == 0)
        {
            <div class="muted">No reserved units waiting to issue.</div>
        }
        else
        {
            <table class="bb">
                <thead>
                    <tr>
                        <th>Patient</th>
                        <th>MRN</th>
                        <th>Unit</th>
                        <th>Type</th>
                        <th>Antibodies</th>
                        <th>XM</th>
                        <th>Status</th>
                        <th>Specimen</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _readyItems)
                    {
                        <tr>
                            <td><a href="@($"/patients/{row.PatientId}")">@(row.PatientDisplayName ?? "—")</a></td>
                            <td class="mono">@(row.MedicalRecordNumber ?? "—")</td>
                            <td class="mono">@(row.UnitNumber ?? $"#{row.BloodUnitId}")</td>
                            <td><strong>@(row.CurrentBloodType ?? "—")</strong></td>
                            <td>@AntibodyCell(row.HasAntibodyHistory, row.AntibodySummary)</td>
                            <td>@(row.LatestCrossmatchResult?.ToString() ?? "—")</td>
                            <td><span class="@Ui.Badge(row.DisplayStatus)">@Ui.StatusLabel(row.DisplayStatus)</span></td>
                            <td>@SpecimenExpiryCell(row.SpecimenExpiresUtc, row.SpecimenExpired)</td>
                            <td class="right">
                                <button type="button" class="btn btn-primary btn-sm" @onclick="() => SelectReadyToIssue(row)">Issue</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <div class="bb-card">
        <div class="bb-card-title"><h3>Retrospective crossmatch due</h3></div>
        <p class="muted">Emergency and MTP issues released without a compatible crossmatch stay here until retrospective testing is recorded (21 CFR 606.151(b)).</p>
        @if (_retroItems.Count == 0)
        {
            <div class="muted">No retrospective crossmatches pending.</div>
        }
        else
        {
            <table class="bb">
                <thead>
                    <tr>
                        <th>Patient</th>
                        <th>MRN</th>
                        <th>Unit</th>
                        <th>Type</th>
                        <th>Antibodies</th>
                        <th>Specimen</th>
                        <th>Issue type</th>
                        <th>Issued</th>
                        <th>Due</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _retroItems)
                    {
                        <tr>
                            <td><a href="@($"/patients/{row.PatientId}")">@(row.PatientDisplayName ?? $"Issue #{row.IssueId}")</a></td>
                            <td class="mono">@(row.MedicalRecordNumber ?? "—")</td>
                            <td class="mono">@(row.UnitNumber ?? $"#{row.BloodUnitId}")</td>
                            <td><strong>@(row.CurrentBloodType ?? "—")</strong></td>
                            <td>@AntibodyCell(row.HasAntibodyHistory, row.AntibodySummary)</td>
                            <td>
                                @(row.AccessionNumber ?? "—")
                                <div>@SpecimenExpiryCell(row.SpecimenExpiresUtc, row.SpecimenExpired)</div>
                            </td>
                            <td>@row.IssueType</td>
                            <td>@row.IssuedUtc.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>
                                @(row.DueUtc?.ToString("yyyy-MM-dd HH:mm") ?? "—")
                                @if (row.IsOverdue)
                                {
                                    <span class="badge badge-amber">Overdue</span>
                                }
                            </td>
                            <td class="right nowrap">
                                @if (Session.Has(PermissionCodes.CompatibilityCrossmatch))
                                {
                                    <a class="btn btn-primary btn-sm" href="@RetroXmHref(row)">Record crossmatch</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <div class="bb-card">
        <div class="bb-card-title"><h3>In transit to ward</h3></div>
        <p class="muted">Issued units in a cooler or courier handoff until the receiving location acknowledges custody (SoftBank remote issue).</p>
        @if (_inTransitItems.Count == 0)
        {
            <div class="muted">No units currently in transit.</div>
        }
        else
        {
            <table class="bb">
                <thead>
                    <tr>
                        <th>Patient</th>
                        <th>MRN</th>
                        <th>Unit</th>
                        <th>Type</th>
                        <th>Antibodies</th>
                        <th>Specimen</th>
                        <th>Cooler</th>
                        <th>Location</th>
                        <th>Issued</th>
                        <th>Due</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _inTransitItems)
                    {
                        <tr>
                            <td><a href="@($"/patients/{row.PatientId}")">@(row.PatientDisplayName ?? $"Issue #{row.IssueId}")</a></td>
                            <td class="mono">@(row.MedicalRecordNumber ?? "—")</td>
                            <td class="mono">@(row.UnitNumber ?? $"#{row.BloodUnitId}")</td>
                            <td><strong>@(row.CurrentBloodType ?? "—")</strong></td>
                            <td>@AntibodyCell(row.HasAntibodyHistory, row.AntibodySummary)</td>
                            <td>@SpecimenExpiryCell(row.SpecimenExpiresUtc, row.SpecimenExpired)</td>
                            <td class="mono">@(row.CoolerId ?? "—")</td>
                            <td>@(row.IssuedToLocation ?? "—")</td>
                            <td>@row.IssuedUtc.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>
                                @(row.DueUtc?.ToString("yyyy-MM-dd HH:mm") ?? "—")
                                @if (row.IsOverdue)
                                {
                                    <span class="badge badge-amber">Overdue</span>
                                }
                            </td>
                            <td>
                                @if (Session.Has(PermissionCodes.TransfusionDocument))
                                {
                                    <button type="button" class="btn btn-ghost btn-sm" @onclick="() => SelectWardIssue(row.IssueId)">Receive</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}

@if (Session.Has(PermissionCodes.IssueCreate) || Session.Has(PermissionCodes.IssueReturn) || Session.Has(PermissionCodes.TransfusionDocument))
{
    <div class="bb-card">
        <div class="bb-card-title"><h3>Issued units</h3></div>
        <p class="muted">Units still Issued — including after ward receipt — so return and transfusion identify the unit by number instead of a raw issue id. Return, ward-receipt, and bedside identity gates are unchanged.</p>
        @if (_outstandingItems.Count == 0)
        {
            <div class="muted">No outstanding issued units.</div>
        }
        else
        {
            <table class="bb">
                <thead>
                    <tr>
                        <th>Patient</th>
                        <th>MRN</th>
                        <th>Unit</th>
                        <th>Type</th>
                        <th>Antibodies</th>
                        <th>Specimen</th>
                        <th>Ward receipt</th>
                        <th>Issued</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _outstandingItems)
                    {
                        <tr>
                            <td><a href="@($"/patients/{row.PatientId}")">@(row.PatientDisplayName ?? $"Issue #{row.IssueId}")</a></td>
                            <td class="mono">@(row.MedicalRecordNumber ?? "—")</td>
                            <td class="mono">@(row.UnitNumber ?? $"#{row.BloodUnitId}")</td>
                            <td><strong>@(row.CurrentBloodType ?? "—")</strong></td>
                            <td>@AntibodyCell(row.HasAntibodyHistory, row.AntibodySummary)</td>
                            <td>@SpecimenExpiryCell(row.SpecimenExpiresUtc, row.SpecimenExpired)</td>
                            <td>
                                @if (row.WardReceivedUtc is DateTime received)
                                {
                                    <span>@received.ToString("yyyy-MM-dd HH:mm") @(row.WardReceivedBy ?? "")</span>
                                }
                                else
                                {
                                    <span class="muted">Awaiting</span>
                                }
                            </td>
                            <td>@row.IssuedUtc.ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="right nowrap">
                                @if (row.WardReceivedUtc is null && Session.Has(PermissionCodes.TransfusionDocument))
                                {
                                    <button type="button" class="btn btn-ghost btn-sm" @onclick="() => SelectWardIssue(row.IssueId)">Receive</button>
                                }
                                @if (Session.Has(PermissionCodes.IssueReturn))
                                {
                                    <button type="button" class="btn btn-secondary btn-sm" @onclick="() => SelectReturnIssue(row)">Return</button>
                                }
                                @if (row.WardReceivedUtc is not null && Session.Has(PermissionCodes.TransfusionDocument))
                                {
                                    <button type="button" class="btn btn-primary btn-sm" @onclick="() => SelectTransfusionIssue(row)">Document</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}

<div class="bb-card">
    <div class="bb-card-title"><h3>Issue a unit</h3></div>
    @if (!Session.Has(PermissionCodes.IssueCreate))
    {
        <div class="muted">You do not have permission to issue units.</div>
    }
    else
    {
        <Outcome Value="_issueFb" RequiresSignature="true" />
        <div class="form-row">
            <div class="field"><label>Unit number</label>
                <UnitPickerComboBox Scope="UnitPickerScope.Issuable" @bind-Value="_issue.BloodUnitId" />
            </div>
            <div class="field"><label>Patient</label>
                <FilterableComboBox TItem="PatientDto" TValue="long?"
                    Items="_patients"
                    @bind-Value="IssuePatientId"
                    @bind-Value:after="OnIssuePatientChangedAsync"
                    DisplayText="@(p => $"{p.LastName}, {p.FirstName} ({p.MedicalRecordNumber})")"
                    ItemValue="@(p => p.Id)"
                    SearchText="@(p => $"{p.LastName} {p.FirstName} {p.MedicalRecordNumber}")"
                    Clearable="true"
                    Placeholder="Search MRN or name" />
            </div>
            <div class="field"><label>Issued to (person)</label><input @bind="_issue.IssuedTo" /></div>
            <div class="field"><label>Issued to (location)</label><input @bind="_issue.IssuedToLocation" /></div>
            <div class="field"><label>Cooler / transport id</label><input @bind="_issue.CoolerId" placeholder="Optional cooler checkout" /></div>
            <div class="field"><label>Issue type</label>
                <select @bind="_issue.IssueType">@foreach (var t in AllowedIssueTypes) { <option value="@t">@t</option> }</select>
            </div>
        </div>
        <div class="form-row">
            <div class="field"><label>Patient ID 1 (MRN)</label><input @bind="_issue.PatientIdentifier1Value" /></div>
            <div class="field"><label>Patient ID 2 (DOB yyyy-MM-dd)</label><input @bind="_issue.PatientIdentifier2Value" /></div>
            <div class="field"><label>Second verifier</label>
                <FilterableComboBox TItem="DirectoryUserDto" TValue="string?"
                    Items="SecondVerifierChoices"
                    @bind-Value="_issue.SecondVerifier"
                    DisplayText="@(u => u.Label)"
                    ItemValue="@(u => u.UserName)"
                    SearchText="@(u => u.Label)"
                    Clearable="true"
                    Placeholder="Different active user" />
            </div>
        </div>
        <div class="flex gap" style="flex-wrap:wrap;margin:.5rem 0 1rem;">
            <div class="field" style="min-width:14rem;">
                <label>Appearance at issue</label>
                <select @bind="_issue.Appearance">
                    @foreach (var a in Enum.GetValues<UnitAppearance>()) { <option value="@a">@a</option> }
                </select>
            </div>
        </div>
        <UnitScanVerificationPanel Scan="_issueScan" />
        @if (_issueAckRequirements.Count > 0)
        {
            <div class="alert alert-warning" style="margin-top:.75rem;">
                <strong>Acknowledge special requirements</strong>
                @foreach (var req in _issueAckRequirements)
                {
                    <label class="flex" style="gap:.35rem;margin-top:.35rem;">
                        <input type="checkbox" checked="@_issueAcks.Contains(req.Code ?? "")" @onchange="e => ToggleIssueAck(req.Code, (bool)(e.Value ?? false))" />
                        @(req.Name ?? req.Code) @(string.IsNullOrWhiteSpace(req.Instruction) ? "" : $"— {req.Instruction}")
                    </label>
                }
            </div>
        }

        <div class="alert alert-warning">
            <label class="flex"><input type="checkbox" @bind="_overrideOn" /> &nbsp;<strong>Override</strong> (emergency release / warning override)</label>
            @if (_overrideOn)
            {
                <div class="form-row" style="margin-top:.5rem;">
                    <div class="field"><label>Override reason</label><input @bind="_overrideReason" /></div>
                    <div class="field"><label>Authorized by</label><input @bind="_authorizedBy" /></div>
                    <div class="field"><label>Meaning of signature</label><input @bind="_signatureMeaning" placeholder="e.g. I authorize emergency release" /></div>
                    <div class="field"><label>Password / PIN</label><input type="password" @bind="_signatureSecret" /></div>
                </div>
            }
        </div>

        @if (_overrideOn)
        {
            <button class="btn btn-danger" disabled="@(_busy || _issue.BloodUnitId is null || _issue.PatientId <= 0)" @onclick="IssueWithOverrideAsync">Sign &amp; issue (override)</button>
        }
        else
        {
            <button class="btn btn-primary" disabled="@(_busy || _issue.BloodUnitId is null || _issue.PatientId <= 0)" @onclick="IssueAsync">Issue unit</button>
        }

        @if (_lastIssue is not null)
        {
            <div class="alert alert-success" style="margin-top:1rem;">
                Issue <strong>#@_lastIssue.Id</strong> created for unit @_lastIssue.BloodUnitId &middot; <span class="badge badge-amber">@_lastIssue.Status</span>
            </div>
        }
    }
</div>

<div class="bb-card">
    <div class="bb-card-title"><h3>Ward receipt</h3></div>
    <p class="muted">The receiving location must acknowledge custody before transfusion can be documented (SoftBank remote-issue receipt).</p>
    @if (!Session.Has(PermissionCodes.TransfusionDocument))
    {
        <div class="muted">No permission to record ward receipt.</div>
    }
    else
    {
        <Outcome Value="_wardFb" />
        <div class="form-row">
            <div class="field"><label>Issue id</label><input type="number" @bind="_wardIssueId" placeholder="Or Receive from Issued units" /></div>
            <div class="field"><label>Received by</label><input @bind="_wardReceivedBy" placeholder="Nurse / ward staff" /></div>
            <div class="field"><label>Appearance at receipt</label>
                <select @bind="_wardAppearance">
                    @foreach (var a in Enum.GetValues<UnitAppearance>()) { <option value="@a">@a</option> }
                </select>
            </div>
        </div>
        <UnitScanVerificationPanel Scan="_wardScan"
            Title="Ward receipt scan"
            Help="Scan the unit label at the receiving location. Required for ISBT-labeled units (SoftBank remote-issue chain)." />
        <div class="flex gap" style="margin-top:.75rem;">
            <button class="btn btn-primary btn-sm" disabled="@_busy" @onclick="RecordWardReceiptAsync">Acknowledge receipt</button>
            <button class="btn btn-ghost btn-sm" disabled="@_busy" @onclick="LoadIssueAsync">Check status</button>
        </div>
        @if (_wardIssue is not null)
        {
            <p class="muted" style="margin-top:.75rem;">
                Issue <strong>@_wardIssue.Id</strong> · @_wardIssue.Status
                @if (_wardIssue.WardReceivedUtc is not null)
                {
                    <span> · received @_wardIssue.WardReceivedUtc.Value.ToString("yyyy-MM-dd HH:mm") by @_wardIssue.WardReceivedBy · @_wardIssue.WardAppearance</span>
                }
                else
                {
                    <span> · awaiting ward receipt</span>
                }
            </p>
        }
    }
</div>

<div class="bb-grid cols-2">
    <div class="bb-card">
        <div class="bb-card-title"><h3>Return a unit</h3></div>
        @if (!Session.Has(PermissionCodes.IssueReturn))
        {
            <div class="muted">No permission to return units.</div>
        }
        else
        {
            <Outcome Value="_returnFb" />
            <div class="form-row">
                <div class="field"><label>Issue id</label><input type="number" @bind="_returnIssueId" placeholder="Or Return from Issued units" /></div>
                <div class="field"><label>Reason</label><input @bind="_returnReason" /></div>
                @if (_returnUnitNumber is not null)
                {
                    <p class="muted" style="margin:0;">Returning <span class="mono">@_returnUnitNumber</span>@(string.IsNullOrWhiteSpace(_returnPatientName) ? "" : $" · {_returnPatientName}").</p>
                }
            </div>
            <p class="muted">Reissue eligibility is computed from temperature, seal, visual inspection, and time out of storage.</p>
            <button class="btn btn-secondary" disabled="@_busy" @onclick="ReturnAsync">Return unit</button>
        }
    </div>

    <div class="bb-card">
        <div class="bb-card-title"><h3>Document transfusion</h3></div>
        @if (!Session.Has(PermissionCodes.TransfusionDocument))
        {
            <div class="muted">No permission to document transfusions.</div>
        }
        else
        {
            <Outcome Value="_txFb" />
            <div class="form-row">
                <div class="field"><label>Issue id</label><input type="number" @bind="_txIssueId" placeholder="Or Document from Issued units" /></div>
                <div class="field"><label>Disposition</label>
                    <select @bind="_txDisposition">@foreach (var d in Enum.GetValues<TransfusionDisposition>()) { <option value="@d">@d</option> }</select>
                </div>
                <div class="field"><label>Volume transfused (mL)</label><input type="number" @bind="_txVolume" /></div>
                <div class="field"><label>Transfusionist</label><input @bind="_txTransfusionist" /></div>
                <div class="field"><label>Second verifier</label>
                    <FilterableComboBox TItem="DirectoryUserDto" TValue="string?"
                        Items="SecondVerifierChoices"
                        @bind-Value="_txSecondVerifier"
                        DisplayText="@(u => u.Label)"
                        ItemValue="@(u => u.UserName)"
                        SearchText="@(u => u.Label)"
                        Clearable="true"
                        Placeholder="Different active user" />
                </div>
            </div>
            <p class="muted">The receiving location must acknowledge the unit (ward receipt) before this can succeed. Patient identifiers must match the issued patient — a checkbox is not positive identification.</p>
            <div class="form-row">
                <div class="field"><label>Patient ID 1 (MRN)</label><input @bind="_txPatientIdentifier1" /></div>
                <div class="field"><label>Patient ID 2 (DOB yyyy-MM-dd)</label><input @bind="_txPatientIdentifier2" /></div>
            </div>
            <label class="flex"><input type="checkbox" @bind="_txReaction" /> &nbsp;Reaction suspected</label>
            <UnitScanVerificationPanel Scan="_txScan" Title="Bedside unit scan" Help="Scan the unit at the bedside. Required for ISBT-labeled units together with matching patient identifiers." />
            <div style="margin-top:.75rem;">
                <button class="btn btn-secondary" disabled="@_busy" @onclick="DocumentTransfusionAsync">Document</button>
            </div>
            @if (_openedReactionId is long reactionId)
            {
                <div class="alert alert-warning" style="margin-top:.75rem;">
                    Reaction workup opened.
                    <a href="@($"/reactions?id={reactionId}")">Open investigation #@reactionId</a>
                </div>
            }
        }
    </div>
</div>

@code {
    private IEnumerable<IssueType> AllowedIssueTypes =>
        Enum.GetValues<IssueType>().Where(t =>
            t is not (IssueType.EmergencyRelease or IssueType.MassiveTransfusion)
            || Session.Has(PermissionCodes.IssueEmergencyRelease));

    private bool _busy;

    private IssueModel _issue = new();
    private List<SpecialRequirementDto> _issueAckRequirements = new();
    private HashSet<string> _issueAcks = new(StringComparer.OrdinalIgnoreCase);
    private Feedback? _issueFb;
    private IssueDto? _lastIssue;

    private bool _overrideOn;
    private string _overrideReason = string.Empty;
    private string _authorizedBy = string.Empty;
    private string _signatureMeaning = string.Empty;
    private string _signatureSecret = string.Empty;

    private long _wardIssueId;
    private string _wardReceivedBy = string.Empty;
    private UnitAppearance _wardAppearance = UnitAppearance.Acceptable;
    private Feedback? _wardFb;
    private IssueDto? _wardIssue;

    private long _returnIssueId;
    private string _returnReason = string.Empty;
    private Feedback? _returnFb;

    private long _txIssueId;
    private TransfusionDisposition _txDisposition = TransfusionDisposition.Completed;
    private decimal? _txVolume;
    private string? _txTransfusionist;
    private string? _txSecondVerifier;
    private bool _txReaction;
    private string? _txPatientIdentifier1;
    private string? _txPatientIdentifier2;
    private Feedback? _txFb;
    private long? _openedReactionId;
    private readonly UnitScanModel _issueScan = new();
    private readonly UnitScanModel _txScan = new();
    private readonly UnitScanModel _wardScan = new();
    private List<DirectoryUserDto> _directoryUsers = new();
    private List<PatientDto> _patients = new();
    private List<RetrospectiveCrossmatchWorkItemDto> _retroItems = new();
    private List<InTransitWorkItemDto> _inTransitItems = new();
    private List<OutstandingIssueWorkItemDto> _outstandingItems = new();
    private List<SecondAboWorkItemDto> _secondAboItems = new();
    private List<ReadyToIssueWorkItemDto> _readyItems = new();

    [SupplyParameterFromQuery(Name = "patientId")] public long? QueryPatientId { get; set; }
    [SupplyParameterFromQuery(Name = "bloodUnitId")] public long? QueryBloodUnitId { get; set; }
    private string? _returnUnitNumber;
    private string? _returnPatientName;

    private long? IssuePatientId
    {
        get => _issue.PatientId == 0 ? null : _issue.PatientId;
        set => _issue.PatientId = value ?? 0;
    }

    private IEnumerable<DirectoryUserDto> SecondVerifierChoices =>
        _directoryUsers.Where(u => !string.Equals(u.UserName, Session.UserName, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        var users = await Api.GetDirectoryUsersAsync();
        if (users.Succeeded) _directoryUsers = users.Value ?? new();
        var patients = await Api.GetPatientsAsync();
        if (patients.Succeeded) _patients = patients.Value ?? new();
        await LoadWorklistsAsync();
        if (QueryBloodUnitId is long unitId)
        {
            _issue.BloodUnitId = unitId;
        }

        if (QueryPatientId is long patientId)
        {
            _issue.PatientId = patientId;
            await OnIssuePatientChangedAsync();
        }
    }

    private async Task SelectReadyToIssue(ReadyToIssueWorkItemDto row)
    {
        _issue.BloodUnitId = row.BloodUnitId;
        _issue.PatientId = row.PatientId;
        _issue.PatientIdentifier1Value = row.MedicalRecordNumber;
        _issue.PatientIdentifier2Value = row.DateOfBirth;
        await LoadIssueRequirementsAsync();
    }

    private async Task OnIssuePatientChangedAsync()
    {
        var patient = _patients.FirstOrDefault(p => p.Id == _issue.PatientId);
        if (patient is null)
        {
            _issue.PatientIdentifier1Value = null;
            _issue.PatientIdentifier2Value = null;
            await LoadIssueRequirementsAsync();
            return;
        }

        _issue.PatientIdentifier1Value = patient.MedicalRecordNumber;
        _issue.PatientIdentifier2Value = patient.DateOfBirth.ToString("yyyy-MM-dd");
        await LoadIssueRequirementsAsync();
    }

    private static string RetroXmHref(RetrospectiveCrossmatchWorkItemDto row)
    {
        var href = $"/compatibility?patientId={row.PatientId}&bloodUnitId={row.BloodUnitId}";
        if (row.SpecimenId is long specimenId)
        {
            href += $"&specimenId={specimenId}";
        }

        return href;
    }

    private void SelectWardIssue(long issueId)
    {
        _wardIssueId = issueId;
    }

    private void SelectReturnIssue(OutstandingIssueWorkItemDto row)
    {
        _returnIssueId = row.IssueId;
        _returnUnitNumber = row.UnitNumber;
        _returnPatientName = row.PatientDisplayName;
    }

    private void SelectTransfusionIssue(OutstandingIssueWorkItemDto row)
    {
        _txIssueId = row.IssueId;
        _txPatientIdentifier1 = row.MedicalRecordNumber;
        _txPatientIdentifier2 = row.DateOfBirth;
    }

    private static RenderFragment AntibodyCell(bool hasHistory, string? summary) => builder =>
    {
        if (hasHistory)
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", "badge badge-amber");
            builder.AddAttribute(2, "title", summary);
            builder.AddContent(3, summary);
            builder.CloseElement();
        }
        else
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", "muted");
            builder.AddContent(2, "None");
            builder.CloseElement();
        }
    };

    private static RenderFragment SpecimenExpiryCell(DateTime? expiresUtc, bool expired) => builder =>
    {
        if (expiresUtc is DateTime expires)
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", expired ? "badge badge-red" : "muted");
            builder.AddContent(2, expires.ToString("yyyy-MM-dd HH:mm"));
            builder.CloseElement();
        }
        else
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", "muted");
            builder.AddContent(2, "—");
            builder.CloseElement();
        }
    };

    private async Task LoadIssueRequirementsAsync()
    {
        _issueAckRequirements = [];
        _issueAcks.Clear();
        if (_issue.PatientId <= 0)
        {
            return;
        }

        var rows = (await Api.GetSpecialRequirementsAsync(_issue.PatientId)).Value ?? new();
        _issueAckRequirements = rows
            .Where(r => r.IsClinicallyActive && r.EnforcementKind == SpecialRequirementEnforcementKind.RequireIssueAcknowledgment)
            .ToList();
    }

    private void ToggleIssueAck(string? code, bool on)
    {
        if (string.IsNullOrWhiteSpace(code))
        {
            return;
        }

        if (on)
        {
            _issueAcks.Add(code);
        }
        else
        {
            _issueAcks.Remove(code);
        }
    }

    private async Task LoadWorklistsAsync()
    {
        if (Session.Has(PermissionCodes.IssueCreate))
        {
            var retro = await Api.GetPendingRetrospectiveCrossmatchesAsync();
            if (retro.Succeeded) _retroItems = retro.Value ?? new();
            var transit = await Api.GetInTransitIssuesAsync();
            if (transit.Succeeded) _inTransitItems = transit.Value ?? new();
            var secondAbo = await Api.GetPendingSecondAboAsync();
            if (secondAbo.Succeeded) _secondAboItems = secondAbo.Value ?? new();
            var ready = await Api.GetReadyToIssueAllocationsAsync();
            if (ready.Succeeded) _readyItems = ready.Value ?? new();
        }

        if (Session.Has(PermissionCodes.IssueCreate) || Session.Has(PermissionCodes.IssueReturn) || Session.Has(PermissionCodes.TransfusionDocument))
        {
            var outstanding = await Api.GetOutstandingIssuesAsync();
            if (outstanding.Succeeded) _outstandingItems = outstanding.Value ?? new();
        }
    }

    private IssueUnitRequest BuildRequest(string? overrideReason, string? authorizedBy) => new(
        _issue.BloodUnitId!.Value,
        _issue.PatientId,
        IdentityTokenType.MedicalRecordNumber,
        _issue.PatientIdentifier1Value,
        IdentityTokenType.DateOfBirth,
        _issue.PatientIdentifier2Value,
        string.IsNullOrWhiteSpace(_issue.IssuedTo) ? null : _issue.IssuedTo,
        string.IsNullOrWhiteSpace(_issue.IssuedToLocation) ? null : _issue.IssuedToLocation,
        _issue.IssueType,
        _issue.Appearance == UnitAppearance.Acceptable,
        _issue.SecondVerifier,
        OverrideReason: overrideReason,
        AuthorizedBy: authorizedBy,
        VerifiedScan: _issueScan.ToRequest(),
        CoolerId: string.IsNullOrWhiteSpace(_issue.CoolerId) ? null : _issue.CoolerId.Trim(),
        Appearance: _issue.Appearance,
        AcknowledgedSpecialRequirementCodes: _issueAcks.ToList());

    private async Task IssueAsync()
    {
        _busy = true;
        var r = await Api.IssueUnitAsync(BuildRequest(null, null));
        _issueFb = r.ToFeedback("Unit issued.");
        if (r.Succeeded)
        {
            _lastIssue = r.Value;
            _wardIssueId = r.Value!.Id;
            _txIssueId = r.Value.Id;
            _returnIssueId = r.Value.Id;
            await LoadWorklistsAsync();
        }
        _busy = false;
    }

    private async Task IssueWithOverrideAsync()
    {
        if (string.IsNullOrWhiteSpace(_overrideReason) || string.IsNullOrWhiteSpace(_signatureMeaning))
        {
            _issueFb = new Feedback(false, null, Array.Empty<RuleMessage>(), false, false, Array.Empty<RuleMessage>(),
                "An override reason and a meaning-of-signature are required.");
            return;
        }

        _busy = true;
        // 1) record the electronic signature, 2) issue with the signature id.
        var sig = await Api.RecordSignatureAsync(new SignatureRequestVm("IssueOverride", _signatureMeaning, "Issue", ReauthenticationSecret: _signatureSecret));
        if (!sig.Succeeded || sig.Value is null)
        {
            _busy = false;
            _issueFb = sig.ToFeedback();
            return;
        }

        var r = await Api.IssueUnitAsync(BuildRequest(_overrideReason, string.IsNullOrWhiteSpace(_authorizedBy) ? Session.UserName : _authorizedBy), sig.Value.Id);
        _issueFb = r.ToFeedback("Unit issued under override.");
        if (r.Succeeded)
        {
            _lastIssue = r.Value;
            _wardIssueId = r.Value!.Id;
            _txIssueId = r.Value.Id;
            _returnIssueId = r.Value.Id;
            _overrideOn = false;
            await LoadWorklistsAsync();
        }
        _busy = false;
    }

    private async Task LoadIssueAsync()
    {
        _busy = true;
        var r = await Api.GetIssueAsync(_wardIssueId);
        _busy = false;
        _wardFb = r.ToFeedback("Issue loaded.");
        if (r.Succeeded) _wardIssue = r.Value;
    }

    private async Task RecordWardReceiptAsync()
    {
        _busy = true;
        var r = await Api.RecordWardReceiptAsync(_wardIssueId, new WardReceiptRequest(
            string.IsNullOrWhiteSpace(_wardReceivedBy) ? Session.UserName : _wardReceivedBy,
            _wardAppearance == UnitAppearance.Acceptable,
            _wardScan.ToRequest(),
            _wardAppearance));
        _busy = false;
        _wardFb = r.ToFeedback("Ward receipt recorded.");
        if (r.Succeeded)
        {
            _wardIssue = r.Value;
            _wardScan.Clear();
            await LoadWorklistsAsync();
        }
    }

    private async Task ReturnAsync()
    {
        _busy = true;
        var r = await Api.ReturnUnitAsync(_returnIssueId, new ReturnUnitRequest(_returnReason));
        _returnFb = r.ToFeedback("Unit returned.");
        if (r.Succeeded)
        {
            _returnUnitNumber = null;
            _returnPatientName = null;
            await LoadWorklistsAsync();
        }
        _busy = false;
    }

    private async Task DocumentTransfusionAsync()
    {
        _busy = true;
        var r = await Api.DocumentTransfusionAsync(_txIssueId, new DocumentTransfusionRequest(
            _txDisposition, VolumeTransfused: _txVolume,
            Transfusionist: string.IsNullOrWhiteSpace(_txTransfusionist) ? null : _txTransfusionist,
            ReactionSuspected: _txReaction,
            BedsideScan: _txScan.ToRequest(),
            SecondVerifier: _txSecondVerifier,
            PatientIdentifier1Value: _txPatientIdentifier1,
            PatientIdentifier2Value: _txPatientIdentifier2));
        _busy = false;
        _txFb = r.ToFeedback("Transfusion documented.");
        _openedReactionId = null;
        if (r.Succeeded)
        {
            await LoadWorklistsAsync();
        }
        if (_txReaction && r.Succeeded && r.Value is not null)
        {
            var cases = await Api.GetReactionInvestigationsAsync();
            var opened = cases.Value?.FirstOrDefault(x => x.TransfusionEventId == r.Value.Id);
            if (opened is not null)
            {
                _openedReactionId = opened.Id;
            }
        }
    }

    private sealed class IssueModel
    {
        public long? BloodUnitId { get; set; }
        public long PatientId { get; set; }
        public string? PatientIdentifier1Value { get; set; }
        public string? PatientIdentifier2Value { get; set; }
        public string? IssuedTo { get; set; }
        public string? IssuedToLocation { get; set; }
        public IssueType IssueType { get; set; } = IssueType.Standard;
        public UnitAppearance Appearance { get; set; } = UnitAppearance.Acceptable;
        public string? SecondVerifier { get; set; }
        public string? CoolerId { get; set; }
    }
