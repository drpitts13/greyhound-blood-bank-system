    // Coolers in transit with their latest check before dispatch; null when not loaded (no issue.create), so nothing is claimed.
    private List<OpenCoolerDto>? _openCoolers;

    private OpenCoolerDto? CoolerCheckFor(string? coolerId) =>
        string.IsNullOrWhiteSpace(coolerId)
            ? null
            : _openCoolers?.FirstOrDefault(c => string.Equals(c.CoolerId.Trim(), coolerId.Trim(), StringComparison.OrdinalIgnoreCase));

    private RenderFragment CoolerCheckBadge(string? coolerId) => builder =>
    {
        if (string.IsNullOrWhiteSpace(coolerId) || _openCoolers is null)
        {
            return;
        }

        var check = CoolerCheckFor(coolerId);
        var (css, text) = check?.LastCheckedUtc is null
            ? ("badge-gray", "Cooler not checked")
            : check.LastCheckReady == true ? ("badge-green", "Cooler checked") : ("badge-amber", "Cooler differences");
        builder.OpenElement(0, "a");
        builder.AddAttribute(1, "class", $"badge {css}");
        builder.AddAttribute(2, "href", $"/issuing/cooler-check?cooler={Uri.EscapeDataString(coolerId.Trim())}");
        builder.AddAttribute(3, "title", check?.LastCheckedUtc is DateTime at ? $"Checked {at.ToLocalTime():yyyy-MM-dd HH:mm}" : "Open the cooler check");
        builder.AddAttribute(4, "data-cooler-check-badge", true);
        builder.AddContent(5, text);
        builder.CloseElement();
    };

    private static RenderFragment AntibodyCell(bool hasHistory, string? summary) => builder =>
    {
        if (hasHistory)
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", "badge badge-amber");
            builder.AddAttribute(2, "title", summary);
            builder.AddContent(3, summary);
            builder.CloseElement();
        }
        else
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", "muted");
            builder.AddContent(2, "None");
            builder.CloseElement();
        }
    };

    // "NotCrossmatchedEmergency" -> "Not Crossmatched Emergency", so a long status can wrap in a narrow column.
    // The issue's crossmatch status changes to Incompatible when a later crossmatch is incompatible,
    // so that value is not labeled as the status at issue.
    private static string CrossmatchStatusLine(CrossmatchClinicalStatus status) =>
        status == CrossmatchClinicalStatus.Incompatible ? "Incompatible after release" : $"At issue: {Words(status)}";

    private static string Words(object value) =>
        System.Text.RegularExpressions.Regex.Replace(value.ToString() ?? "", "(?<=[a-z])(?=[A-Z])", " ");

    // Issue facts recorded at issue, one labeled line each, so the worklists fit the page width
    // instead of spending a column on each fact. Blank facts show as —.
    private static RenderFragment IssueDetailsCell(string? issueType, string? releaseReason, string? authorizedBy, string? cooler, string? issuedBy, string? secondVerifier, string? appearance, string? ptag) => builder =>
    {
        builder.AddContent(0, string.IsNullOrWhiteSpace(issueType) ? "—" : issueType);
        (string Label, string? Value)[] facts =
        [
            ("Release reason", releaseReason), ("Authorized by", authorizedBy), ("Cooler", cooler), ("Issued by", issuedBy),
            ("Second verifier", secondVerifier), ("Appearance", appearance), ("P-tag", ptag)
        ];
        foreach (var (label, value) in facts)
        {
            builder.OpenElement(1, "span");
            builder.AddAttribute(2, "class", "sub");
            builder.AddContent(3, $"{label}: {(string.IsNullOrWhiteSpace(value) ? "—" : value)}");
            builder.CloseElement();
        }
    };

    private static RenderFragment SpecimenExpiryCell(DateTime? expiresUtc, bool expired) => builder =>
    {
        if (expiresUtc is DateTime expires)
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", expired ? "badge badge-red" : "muted");
            builder.AddContent(2, expires.ToString("yyyy-MM-dd HH:mm"));
            builder.CloseElement();
        }
        else
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", "muted");
            builder.AddContent(2, "—");
            builder.CloseElement();
        }
    };

    private async Task LoadIssueRequirementsAsync()
    {
        _issueAckRequirements = [];
        _issueInfoRequirements = [];
        _issueAcks.Clear();
        if (_issue.PatientId <= 0)
        {
            return;
        }

        var rows = (await Api.GetSpecialRequirementsAsync(_issue.PatientId)).Value ?? new();
        _issueAckRequirements = rows
            .Where(r => r.IsClinicallyActive && r.EnforcementKind == SpecialRequirementEnforcementKind.RequireIssueAcknowledgment)
            .ToList();
        _issueInfoRequirements = rows.Where(r => r.IsClinicallyActive && r.IsInformational).ToList();
    }

    private void ToggleIssueAck(string? code, bool on)
    {
        if (string.IsNullOrWhiteSpace(code))
        {
            return;
        }

        if (on)
        {
            _issueAcks.Add(code);
        }
        else
        {
            _issueAcks.Remove(code);
        }
    }

    private async Task LoadWorklistsAsync()
    {
        await LoadActiveMtpAsync();
        if (Session.Has(PermissionCodes.IssueCreate))
        {
            var retro = await Api.GetPendingRetrospectiveCrossmatchesAsync();
            if (retro.Succeeded) _retroItems = retro.Value ?? new();
            var transit = await Api.GetInTransitIssuesAsync();
            if (transit.Succeeded) _inTransitItems = transit.Value ?? new();
            var coolers = await Api.GetOpenCoolersAsync();
            _openCoolers = coolers.Succeeded ? coolers.Value ?? new() : null;
            var secondAbo = await Api.GetPendingSecondAboAsync();
            if (secondAbo.Succeeded) _secondAboItems = secondAbo.Value ?? new();
            var ready = await Api.GetReadyToIssueAllocationsAsync();
            if (ready.Succeeded) _readyItems = ready.Value ?? new();
        }

        if (Session.Has(PermissionCodes.IssueCreate) || Session.Has(PermissionCodes.IssueReturn) || Session.Has(PermissionCodes.TransfusionDocument))
        {
            var outstanding = await Api.GetOutstandingIssuesAsync();
            if (outstanding.Succeeded) _outstandingItems = outstanding.Value ?? new();
            var disposition = await Api.GetOverdueDispositionAsync();
            if (disposition.Succeeded) _dispositionItems = disposition.Value ?? new();
        }
    }

    private IssueUnitRequest BuildRequest(string? overrideReason, string? authorizedBy) => new(
        _issue.BloodUnitId!.Value,
        _issue.PatientId,
        IdentityTokenType.MedicalRecordNumber,
        _issue.PatientIdentifier1Value,
        IdentityTokenType.DateOfBirth,
        _issue.PatientIdentifier2Value,
        string.IsNullOrWhiteSpace(_issue.IssuedTo) ? null : _issue.IssuedTo,
        string.IsNullOrWhiteSpace(_issue.IssuedToLocation) ? null : _issue.IssuedToLocation,
        _issue.IssueType,
        _issue.Appearance == UnitAppearance.Acceptable,
        _issue.SecondVerifier,
        OverrideReason: overrideReason,
        AuthorizedBy: authorizedBy,
        VerifiedScan: _issueScan.ToRequest(),
        CoolerId: string.IsNullOrWhiteSpace(_issue.CoolerId) ? null : _issue.CoolerId.Trim(),
        Appearance: _issue.Appearance,
        AcknowledgedSpecialRequirementCodes: _issueAcks.ToList(),
        PtagId: string.IsNullOrWhiteSpace(_ptagScan) ? null : _ptagScan.Trim(),
        IssuedUtc: _issue.DowntimeBackEntry && _issue.BackEntryLocalTime is DateTime paper
            ? DateTime.SpecifyKind(paper, DateTimeKind.Local).ToUniversalTime()
            : null,
        LateEntryReason: _issue.DowntimeBackEntry && !string.IsNullOrWhiteSpace(_issue.LateEntryReason) ? _issue.LateEntryReason.Trim() : null,
        DowntimeBackEntry: _issue.DowntimeBackEntry,
        BackEntryDin: _issue.DowntimeBackEntry ? _issue.BackEntryDin : null);

    private void OnBackEntryToggled()
    {
        // The two pickers list different units, so a unit picked under one is not carried to the other.
        _issue.BloodUnitId = null;
        _issue.BackEntryLocalTime = null;
        _issue.BackEntryDin = null;
        _issue.LateEntryReason = null;
    }

    private async Task IssueAsync()
    {
        _busy = true;
        var r = await Api.IssueUnitAsync(BuildRequest(null, null));
        _issueFb = r.ToFeedback("Unit issued.");
        if (r.Succeeded)
        {
            AddToRun(r.Value!);
            _lastIssue = r.Value;
            _wardIssueId = r.Value!.Id;
            _txIssueId = r.Value.Id;
            _returnIssueId = r.Value.Id;
            await LoadWorklistsAsync();
            _ptagFb = null;
            _ptagScan = string.Empty; // a P-tag belongs to one issue
            _issue.Appearance = null; // the next unit gets its own look (OCD-040)
            _ptagJobId = null;
        }
        _busy = false;
    }

    private async Task PrintPreparedPtagAsync()
    {
        if (_issue.BloodUnitId is null || _issue.PatientId <= 0 || !Session.Has(PermissionCodes.PrintLabel))
        {
            return;
        }

        _busy = true;
        var r = await Api.PrepareCompatibilityTagAsync(_issue.BloodUnitId.Value, _issue.PatientId, _issue.IssueType);
        _busy = false;
        if (r.Succeeded)
        {
            _ptagJobId = r.Value!.Id;
        }

        _ptagFb = r.Succeeded
            ? r.ToFeedback($"PDF preview saved as job #{r.Value!.Id}. Scan the P-tag ID.")
            : r.ToFeedback();
    }

    private async Task PrintLastIssuePtagAsync()
    {
        if (_lastIssue is null || !Session.Has(PermissionCodes.PrintLabel)) return;
        _busy = true;
        var r = await Api.PrintCompatibilityTagAsync(_lastIssue.Id, new PrintRequestVm(LabelFormat.Pdf));
        _busy = false;
        if (r.Succeeded)
        {
            _ptagJobId = r.Value!.Id;
        }

        _ptagFb = r.Succeeded
            ? r.ToFeedback($"PDF preview saved as job #{r.Value!.Id}.")
            : r.ToFeedback();
    }

    private long? _ptagJobId;

    private string PtagPrintHref() => _ptagJobId is long jobId
        ? $"/printing?jobId={jobId}"
        : _lastIssue is null ? "/printing" : $"/printing?issueId={_lastIssue.Id}";

    private async Task IssueWithOverrideAsync()
    {
        if (string.IsNullOrWhiteSpace(_overrideReason) || string.IsNullOrWhiteSpace(_signatureMeaning))
        {
            _issueFb = new Feedback(false, null, Array.Empty<RuleMessage>(), false, false, Array.Empty<RuleMessage>(),
                "An override reason and a meaning-of-signature are required.");
            return;
        }

        _busy = true;
        // 1) record the electronic signature, 2) issue with the signature id.
        var sig = await Api.RecordSignatureAsync(new SignatureRequestVm("IssueOverride", _signatureMeaning, "Issue", ReauthenticationSecret: _signatureSecret));
        if (!sig.Succeeded || sig.Value is null)
        {
            _busy = false;
            _issueFb = sig.ToFeedback();
            return;
        }

        var r = await Api.IssueUnitAsync(BuildRequest(_overrideReason, _authorizedBy.Trim()), sig.Value.Id);
        _issueFb = r.ToFeedback("Unit issued under override.");
        if (r.Succeeded)
        {
            AddToRun(r.Value!);
            _lastIssue = r.Value;
            _wardIssueId = r.Value!.Id;
            _txIssueId = r.Value.Id;
            _returnIssueId = r.Value.Id;
            _overrideOn = false;
            await LoadWorklistsAsync();
            _ptagFb = null;
            _ptagScan = string.Empty; // a P-tag belongs to one issue
            _issue.Appearance = null; // the next unit gets its own look (OCD-040)
            _ptagJobId = null;
        }
        _busy = false;
    }

    private async Task LoadIssueAsync()
    {
        _busy = true;
        var r = await Api.GetIssueAsync(_wardIssueId);
        _busy = false;
        _wardFb = r.ToFeedback("Issue loaded.");
        if (r.Succeeded) _wardIssue = r.Value;
    }

    private async Task RecordWardReceiptAsync()
    {
        _busy = true;
        var receiving = _inTransitItems.FirstOrDefault(r => r.IssueId == _wardIssueId);
        var receivedBy = string.IsNullOrWhiteSpace(_wardReceivedBy) ? Session.UserName : _wardReceivedBy;
        var r = await Api.RecordWardReceiptAsync(_wardIssueId, new WardReceiptRequest(
            string.IsNullOrWhiteSpace(_wardReceivedBy) ? Session.UserName : _wardReceivedBy,
            _wardAppearance == UnitAppearance.Acceptable,
            _wardScan.ToRequest(),
            _wardAppearance,
            BackEntryDin: string.IsNullOrWhiteSpace(_wardBackEntryDin) ? null : _wardBackEntryDin.Trim(),
            ReceivedUtc: _wardBackEntryTime is DateTime paperTime ? DateTime.SpecifyKind(paperTime, DateTimeKind.Local).ToUniversalTime() : null));
        _busy = false;
        _wardFb = r.ToFeedback("Ward receipt recorded.");
        if (r.Succeeded)
        {
            if (receiving is not null) AddToReceiptRun(receiving, receivedBy);
            _wardIssue = r.Value;
            _wardScan.Clear();
            _wardAppearance = null;
            ClearWardUnit();
            await LoadWorklistsAsync();
            // Ready for the next unit in the cooler: the field is empty and takes the scan (Cycle 623).
            _focusUnitFor = "receipt";
        }
    }

    // The unit on the receipt form, cleared once it is received; who received it stays for the rest of the cooler.
    private void ClearWardUnit()
    {
        _wardIssueId = 0;
        _wardUnitLookup = string.Empty;
        _wardProductName = null;
        _wardExpirationNotice = null;
        _wardUnitTypeNotice = null;
        _wardSpecimenNotice = null;
        _wardCrossmatchNotice = null;
        _wardIssuedToNotice = null;
        _wardCoolerNotice = null;
        _wardLocationNotice = null;
        _wardIssuedByNotice = null;
        _wardSecondVerifierNotice = null;
        _wardReleaseReason = null;
        _wardReleaseAuthorizer = null;
        _wardIssueAppearance = null;
        _wardPtagNotice = null;
        _wardCrossmatchStatusNotice = null;
    }

    private async Task ReturnAsync()
    {
        if (string.IsNullOrWhiteSpace(_returnReason))
        {
            _returnFb = Feedback.Fail("A reason is required to return a unit.");
            return;
        }

        SyncReturnDestination();
        _busy = true;
        var r = await Api.ReturnUnitAsync(_returnIssueId, new ReturnUnitRequest(
            _returnReason.Trim(),
            _returnTempOk,
            _returnSealOk,
            _returnVisualOk,
            Destination: _returnDestination));
        _returnFb = r.Succeeded && r.Value is { RetypePending: true }
            ? Feedback.Succeed("Unit returned. Its ABO/Rh retype is not confirmed yet, so it went back to Received. Record the retype before it can be allocated or issued.")
            : r.ToFeedback("Unit returned.");
        if (r.Succeeded)
        {
            _lastReturn = r.Value;
            if (_outstandingItems.FirstOrDefault(i => i.IssueId == _returnIssueId) is { } returned)
            {
                if (_returnRun.Count == 0)
                {
                    (_returnRunPatientId, _returnRunCooler, _returnRunDestination) = (returned.PatientId, returned.CoolerId, returned.IssuedToLocation);
                }

                _returnRun.Add(new ReturnedInRun(returned.IssueId, returned.UnitNumber ?? _returnUnitLookup, returned.ProductName,
                    r.Value?.RetypePending == true ? UnitStatus.Received : _returnDestination, DateTime.Now));
            }

            var keepReason = _returnReason;
            _returnUnitNumber = null;
            _returnProductName = null;
            _returnExpirationNotice = null;
            _returnUnitTypeNotice = null;
            _returnSpecimenNotice = null;
            _returnCrossmatchNotice = null;
            _returnIssuedToNotice = null;
            _returnCoolerNotice = null;
            _returnLocationNotice = null;
            _returnIssuedByNotice = null;
            _returnSecondVerifierNotice = null;
            _returnReleaseReason = null;
            _returnReleaseAuthorizer = null;
            _returnIssueAppearance = null;
            _returnPtagNotice = null;
            _returnCrossmatchStatusNotice = null;
            _returnTimeOutNotice = null;
            _returnTimeOutAcceptable = true;
            _returnWardAppearance = null;
            _returnPatientName = null;
            _returnTempOk = InspectionStart;
            _returnSealOk = InspectionStart;
            _returnVisualOk = InspectionStart;
            _returnDestination = UnitStatus.Available;
            _returnIssueId = 0;
            _returnUnitLookup = string.Empty;
            await LoadWorklistsAsync();
            // The reason stays while more of the shipment is out; each unit is inspected again.
            _returnReason = NextToReturn.Count > 0 ? keepReason : string.Empty;
            // Ready for the next unit: the field is empty and takes the scan (Cycle 623).
            _focusUnitFor = "return";
        }
        _busy = false;
    }

    private async Task StartTransfusionAsync()
    {
        _busy = true;
        var r = await Api.StartTransfusionAsync(_txIssueId, new StartTransfusionRequest(
            Transfusionist: string.IsNullOrWhiteSpace(_txTransfusionist) ? null : _txTransfusionist,
            BedsideScan: _txScan.ToRequest(),
            SecondVerifier: _txSecondVerifier,
            PatientIdentifier1Value: _txPatientIdentifier1,
            PatientIdentifier2Value: _txPatientIdentifier2,
            BackEntryDin: string.IsNullOrWhiteSpace(_txBackEntryDin) ? null : _txBackEntryDin.Trim()));
        _busy = false;
        _txFb = r.ToFeedback("Transfusion started. Complete it here when it ends.");
        if (r.Succeeded && r.Value is not null)
        {
            AddToBedsideRun("Started", finished: false);
            _txStartedUtc = r.Value.StartUtc;
            await LoadWorklistsAsync();
        }
    }

    private async Task CompleteTransfusionAsync()
    {
        if (_txReaction is null)
        {
            _txFb = Feedback.Fail(ReactionAnswerRequired);
            return;
        }

        if (_txDisposition is null)
        {
            _txFb = Feedback.Fail(IssuingService.DispositionRequired);
            return;
        }

        _busy = true;
        var r = await Api.CompleteTransfusionAsync(_txIssueId, new CompleteTransfusionRequest(
            _txDisposition, VolumeTransfused: _txVolume, ReactionSuspected: _txReaction));
        _busy = false;
        _txFb = r.ToFeedback("Transfusion completed.");
        _openedReactionId = null;
        var reactionReported = _txReaction == true;
        if (r.Succeeded && r.Value is not null)
        {
            AddToBedsideRun($"Completed ({_txDisposition})", finished: true);
            _lastTransfusion = r.Value;
            _txStartedUtc = null;
            await LoadWorklistsAsync();
            if (reactionReported)
            {
                var cases = await Api.GetReactionInvestigationsAsync();
                _openedReactionId = cases.Value?.FirstOrDefault(x => x.TransfusionEventId == r.Value.Id)?.Id;
            }
        }
    }

    private async Task DocumentTransfusionAsync()
    {
        if (_txReaction is null)
        {
            _txFb = Feedback.Fail(ReactionAnswerRequired);
            return;
        }

        if (_txDisposition is null)
        {
            _txFb = Feedback.Fail(IssuingService.DispositionRequired);
            return;
        }

        _busy = true;
        var r = await Api.DocumentTransfusionAsync(_txIssueId, new DocumentTransfusionRequest(
            _txDisposition, VolumeTransfused: _txVolume,
            Transfusionist: string.IsNullOrWhiteSpace(_txTransfusionist) ? null : _txTransfusionist,
            ReactionSuspected: _txReaction,
            BedsideScan: _txScan.ToRequest(),
            SecondVerifier: _txSecondVerifier,
            PatientIdentifier1Value: _txPatientIdentifier1,
            PatientIdentifier2Value: _txPatientIdentifier2,
            BackEntryDin: string.IsNullOrWhiteSpace(_txBackEntryDin) ? null : _txBackEntryDin.Trim()));
        _busy = false;
        _txFb = r.ToFeedback("Transfusion documented.");
        _openedReactionId = null;
        var reactionReported = _txReaction == true;
        if (r.Succeeded)
        {
            AddToBedsideRun($"Documented ({_txDisposition})", finished: true);
            _lastTransfusion = r.Value;
            await LoadWorklistsAsync();
        }
        if (reactionReported && r.Succeeded && r.Value is not null)
        {
            var cases = await Api.GetReactionInvestigationsAsync();
            var opened = cases.Value?.FirstOrDefault(x => x.TransfusionEventId == r.Value.Id);
            if (opened is not null)
            {
                _openedReactionId = opened.Id;
            }
        }
    }

    private sealed class IssueModel
    {
        public long? BloodUnitId { get; set; }
        public long PatientId { get; set; }
        public string? PatientIdentifier1Value { get; set; }
        public string? PatientIdentifier2Value { get; set; }
        public string? IssuedTo { get; set; }
        public string? IssuedToLocation { get; set; }
        public IssueType IssueType { get; set; } = IssueType.Standard;
        public UnitAppearance? Appearance { get; set; }
        public string? SecondVerifier { get; set; }
        public string? CoolerId { get; set; }
        public bool DowntimeBackEntry { get; set; }
        public DateTime? BackEntryLocalTime { get; set; }
        public string? BackEntryDin { get; set; }
        public string? LateEntryReason { get; set; }
    }
}
