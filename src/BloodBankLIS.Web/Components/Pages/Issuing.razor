                                <UnitLink Id="row.BloodUnitId" Number="@row.UnitNumber" />
                                <span class="sub">@(string.IsNullOrWhiteSpace(row.ProductName) ? "—" : row.ProductName)</span>
                                <span class="sub nowrap">@(row.UnitExpiresUtc is DateTime transitExpires ? transitExpires.ToString("yyyy-MM-dd HH:mm") : "—")</span>
                            </td>
                            <td class="nowrap">Unit <strong>@(string.IsNullOrWhiteSpace(row.UnitBloodType) ? "—" : row.UnitBloodType)</strong><span class="sub">Patient @(row.CurrentBloodType ?? "—")</span></td>
                            <td>@AntibodyCell(row.HasAntibodyHistory, row.AntibodySummary)</td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(row.SpecimenAccession))
                                {
                                    <div class="mono">@row.SpecimenAccession</div>
                                }
                                @SpecimenExpiryCell(row.SpecimenExpiresUtc, row.SpecimenExpired)
                            </td>
                            <td>
                                @(row.LatestCrossmatchResult is CrossmatchResult transitXm ? transitXm.ToString() : "—")
                                @if (row.CrossmatchExpiresUtc is DateTime transitXmExpires)
                                {
                                    <div class="muted">@transitXmExpires.ToString("yyyy-MM-dd HH:mm")</div>
                                }
                                <span class="sub">@CrossmatchStatusLine(row.CrossmatchStatus)</span>
                            </td>
                            <td>
