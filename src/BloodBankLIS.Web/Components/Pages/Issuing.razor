    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusUnitFor is not { } desk || desk != _desk)
        {
            return;
        }

        _focusUnitFor = null;
        var (input, filled) = desk switch
        {
            "receipt" => (_wardUnitInput, !string.IsNullOrWhiteSpace(_wardUnitLookup)),
            "return" => (_returnUnitInput, !string.IsNullOrWhiteSpace(_returnUnitLookup)),
            "transfuse" => (_txUnitInput, !string.IsNullOrWhiteSpace(_txUnitLookup)),
            _ => (default(ElementReference), true)
        };
        if (filled || input.Context is null)
        {
            return;
        }

        try
        {
            await input.FocusAsync(preventScroll: true);
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or TaskCanceledException)
        {
            // Not rendered (no permission for that desk) or the circuit is going away: nothing to focus.
        }
    }

