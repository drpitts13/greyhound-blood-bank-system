                <thead>
                    <tr>
                        <th>Patient / MRN</th>
                        <th>Unit / product / expires</th>
                        <th>Unit / patient type</th>
                        <th>Antibodies</th>
                        <th>Specimen</th>
                        <th>Crossmatch / at issue</th>
                        <th>Issue details</th>
                        <th>Issued to</th>
