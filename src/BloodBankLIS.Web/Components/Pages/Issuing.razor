@page "/issuing"
@using Microsoft.AspNetCore.Components
@inject BloodBankApiClient Api
@inject UserSession Session

<PageTitle>Issue &amp; Transfuse &middot; Greyhound Blood Bank LIS</PageTitle>

<h1>Issue &amp; Transfuse</h1>
@if (QueryPatientId is long chartPatientId)
{
    <p>
        <a href="@($"/patients/{chartPatientId}?tab=products")">Open chart · Products</a>
        <span class="muted"> · Patient and unit stay prefilled on this desk.</span>
    </p>
}
<p class="muted">Reserved units appear on Ready to issue so the desk does not re-key patient and unit after allocate.</p>
<details class="bb-help">
    <summary>How it works</summary>
    <ul>
        <li>The issue gate runs all safety checks, including storage-location policy and electronic / remote issue eligibility (AABB 5.16).</li>
        <li>Overrides require a reason and an electronic signature.</li>
    </ul>
</details>

@* Worklists show how many items wait on each, so nobody clicks through empty desks; the forms are grouped apart. *@
<div class="desk-nav">
    @if (Session.Has(PermissionCodes.IssueCreate) || Session.Has(PermissionCodes.IssueReturn) || Session.Has(PermissionCodes.TransfusionDocument))
    {
        <div class="desk-group">
            <span class="desk-group-label">Worklists</span>
            @if (Session.Has(PermissionCodes.IssueCreate))
            {
                <button type="button" class="btn btn-sm @DeskClass("ready")" @onclick='() => SelectDesk("ready")'>Ready to issue@(CountBadge(_readyItems.Count))</button>
                <button type="button" class="btn btn-sm @DeskClass("second")" @onclick='() => SelectDesk("second")'>Second ABO/Rh@(CountBadge(_secondAboItems.Count))</button>
                <button type="button" class="btn btn-sm @DeskClass("retro")" @onclick='() => SelectDesk("retro")'>Retrospective@(CountBadge(_retroItems.Count))</button>
                <button type="button" class="btn btn-sm @DeskClass("transit")" @onclick='() => SelectDesk("transit")'>In transit@(CountBadge(_inTransitItems.Count))</button>
            }
            <button type="button" class="btn btn-sm @DeskClass("issued")" @onclick='() => SelectDesk("issued")'>Issued units@(CountBadge(_outstandingItems.Count))</button>
            <button type="button" class="btn btn-sm @DeskClass("disposition")" @onclick='() => SelectDesk("disposition")'>Final disposition@(CountBadge(_dispositionItems.Count))</button>
        </div>
    }
    <div class="desk-group">
        <span class="desk-group-label">Forms</span>
        <button type="button" class="btn btn-sm @DeskClass("issue")" @onclick='() => SelectDesk("issue")'>Issue</button>
        <button type="button" class="btn btn-sm @DeskClass("receipt")" @onclick='() => SelectDesk("receipt")'>Ward receipt</button>
        <button type="button" class="btn btn-sm @DeskClass("return")" @onclick='() => SelectDesk("return")'>Return</button>
        <button type="button" class="btn btn-sm @DeskClass("transfuse")" @onclick='() => SelectDesk("transfuse")'>Document transfusion</button>
    </div>
</div>

@if (_activeMtp.Count > 0)
{
    @* Every active massive transfusion protocol stays in view on every desk until someone closes it. *@
    <div class="alert alert-danger" role="status" style="margin-top:.75rem;">
        <strong>Massive transfusion protocol active</strong>
        <Outcome Value="_mtpBoardFb" />
        @foreach (var mtp in _activeMtp)
        {
            <div style="margin-top:.5rem;">
                <strong>@mtp.PatientName</strong> @(mtp.MedicalRecordNumber is null ? "" : $"({mtp.MedicalRecordNumber})")
                &middot; MTP #@mtp.Id, @mtp.MinutesActive min &middot; called by @mtp.RequestedBy &middot; @mtp.Reason
                <div class="muted">
                    @if (mtp.Counts.Count == 0)
                    {
                        <span>No units issued yet.</span>
                    }
                    else
                    {
                        @string.Join(" · ", mtp.Counts.Select(c => $"{ComponentLabel(c.ComponentClass)} {c.Issued} issued" + (c.Returned > 0 ? $", {c.Returned} returned" : "") + (c.Transfused > 0 ? $", {c.Transfused} transfused" : "")))
                    }
                </div>
                @if (mtp.Pack is { } pack)
                {
                    @* Guidance only: the pack never blocks or adds a unit. *@
                    <div>
                        Pack <span class="mono">@pack.Code</span>: round @pack.CurrentRound
                        @(pack.CompletedRounds > 0 ? $"({pack.CompletedRounds} complete)" : "")
                        &middot; @string.Join(" · ", pack.Components.Select(c => $"{ComponentLabel(c.ComponentClass)} {c.InCurrentRound}/{c.PerRound}"))
                    </div>
                }
                @if (_mtpPackRecords.TryGetValue(mtp.Id, out var packed) && packed.Count > 0)
                {
                    <div>
                        Packs sent:
                        @foreach (var pr in packed)
                        {
                            <a class="btn btn-ghost btn-sm" href="@($"/mtp/pack-records/{pr.Id}")">
                                Pack @pr.PackNumber · @pr.ContainerName@(pr.ContainerLabel is null ? "" : $" {pr.ContainerLabel}") · @pr.UnitCount unit@(pr.UnitCount == 1 ? "" : "s") · @pr.TemperatureC.ToString("0.0") °C@(pr.TemperatureOutsideRange ? " (out of range)" : "")
                            </a>
                        }
                    </div>
                }
                @if (_packingMtpId == mtp.Id)
                {
                    var unpacked = mtp.Units.Where(u => u.IssueStatus == IssueStatus.Issued && u.PackRecordId is null).ToList();
                    <div class="bb-card" style="margin-top:.5rem;">
                        <strong>Record a pack for MTP #@mtp.Id</strong>
                        @if (_containers.Count == 0)
                        {
                            <p class="muted">No transport containers are set up. An administrator adds them under Admin › Transport Containers.</p>
                        }
                        else
                        {
                            <div class="form-row" style="margin-top:.5rem;">
                                <div class="field"><label>Container</label>
                                    <select @bind="_packContainerId">
                                        <option value="">Choose…</option>
                                        @foreach (var tc in _containers)
                                        {
                                            <option value="@tc.Id">@tc.Name (@tc.RangeText)</option>
                                        }
                                    </select>
                                </div>
                                <div class="field"><label>Which one (optional)</label><input @bind="_packContainerLabel" placeholder="e.g. Cooler 3" /></div>
                                <div class="field"><label>Temperature °C</label><input type="number" step="0.1" @bind="_packTemperature" placeholder="Read it now" /></div>
                                <div class="field" style="flex:2;"><label>Comment</label><input @bind="_packComment" placeholder="Optional" /></div>
                            </div>
                            @if (unpacked.Count == 0)
                            {
                                <p class="muted">Every unit issued under this protocol is already in a pack. Issue more units first.</p>
                            }
                            else
                            {
                                <div class="muted">Units issued under this protocol and not yet packed:</div>
                                @foreach (var u in unpacked)
                                {
                                    <label class="flex" style="gap:.35rem;margin-top:.25rem;">
                                        <input type="checkbox" checked="@_packIssueIds.Contains(u.IssueId)" @onchange="e => TogglePackUnit(u.IssueId, (bool)(e.Value ?? false))" />
                                        <span class="mono">@u.UnitNumber</span> · @u.ProductName · @u.BloodType
                                    </label>
                                }
                                <button type="button" class="btn btn-ghost btn-sm" @onclick="() => { foreach (var u in unpacked) _packIssueIds.Add(u.IssueId); }">Select all @unpacked.Count</button>
                            }
                            <div class="flex gap" style="margin-top:.5rem;">
                                <button type="button" class="btn btn-sm btn-primary" disabled="@(_busy || _packIssueIds.Count == 0)" @onclick="() => RecordPackAsync(mtp)">Record pack</button>
                                <button type="button" class="btn btn-sm btn-ghost" @onclick="() => _packingMtpId = null">Cancel</button>
                            </div>
                        }
                    </div>
                }
                <div class="flex gap" style="flex-wrap:wrap;align-items:end;margin-top:.35rem;">
                    @if (Session.Has(PermissionCodes.IssueCreate))
                    {
                        <button type="button" class="btn btn-sm btn-danger" @onclick="() => IssueUnderMtpAsync(mtp)">Issue under this MTP</button>
                        <button type="button" class="btn btn-sm btn-secondary" @onclick="() => StartPacking(mtp)">Pack a cooler…</button>
                    }
                    @if (Session.Has(PermissionCodes.IssueEmergencyRelease))
                    {
                        @if (_closingMtpId == mtp.Id)
                        {
                            <div class="field" style="min-width:16rem;margin:0;">
                                <label>Why is it ending?</label>
                                <input @bind="_mtpCloseReason" placeholder="e.g. Bleeding controlled; protocol stood down" />
                            </div>
                            <button type="button" class="btn btn-sm btn-secondary" disabled="@_busy" @onclick="() => CloseMtpAsync(mtp)">Close MTP</button>
                            <button type="button" class="btn btn-sm btn-ghost" @onclick="() => _closingMtpId = null">Cancel</button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-sm btn-ghost" @onclick="() => { _closingMtpId = mtp.Id; _mtpCloseReason = null; }">Close…</button>
                        }
                    }
                </div>
            </div>
        }
    </div>
}

@if (Session.Has(PermissionCodes.IssueCreate) && _desk == "second")
{
    <div class="bb-card">
        <div class="bb-card-title"><h3>Second ABO/Rh due</h3></div>
        <p class="muted">Patients with reserved units who still need a concordant historical or second-sample type before routine red-cell issue (AABB 5.14 / CAP TRM.40650).</p>
        @if (_secondAboItems.Count == 0)
        {
            <div class="muted">No reserved units waiting on a second ABO/Rh.</div>
        }
        else
        {
            <table class="bb">
                <thead>
                    <tr>
                        <th>Patient</th>
                        <th>MRN</th>
                        <th>Current type</th>
                        <th>Reserved</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _secondAboItems)
                    {
                        <tr>
                            <td class="nowrap"><a href="@($"/patients/{row.PatientId}?tab=tests")">@row.DisplayName</a></td>
                            <td class="mono">@row.MedicalRecordNumber</td>
                            <td class="mono">@row.CurrentAboRh</td>
                            <td>@row.ReservedUnitCount</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}

@if (Session.Has(PermissionCodes.IssueCreate) && _desk == "ready")
{
    <div class="bb-card">
        <div class="bb-card-title"><h3>Ready to issue</h3></div>
        <p class="muted">Reserved units waiting to issue. Issue on the row fills the issue form with the unit and patient. Scan or type the two patient identifiers from the wristband or requisition, unless your facility pre-fills them. Marks on the row are repeated on that form.</p>
        @if (_readyItems.Count == 0)
        {
            <div class="muted">No reserved units waiting to issue.</div>
        }
        else
        {
            <table class="bb">
                <thead>
                    <tr>
                        <th>Patient / MRN</th>
                        <th>Unit / product / expires</th>
                        <th>Unit type</th>
                        <th>Location</th>
                        <th>Patient type</th>
                        <th>Antibodies</th>
                        <th>XM</th>
                        <th>Status</th>
                        <th>Specimen</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _readyItems)
                    {
                        <tr>
                            <td><a href="@($"/patients/{row.PatientId}?tab=products")">@(row.PatientDisplayName ?? "—")</a><span class="sub mono">@(row.MedicalRecordNumber ?? "—")</span></td>
                            <td>
                                <UnitLink Id="row.BloodUnitId" Number="@row.UnitNumber" />
                                <span class="sub">@(string.IsNullOrWhiteSpace(row.ProductName) ? "—" : row.ProductName)</span>
                                <span class="sub nowrap">@(row.UnitExpiresUtc is DateTime unitExpires ? unitExpires.ToString("yyyy-MM-dd HH:mm") : "—")</span>
                            </td>
                            <td><strong>@(string.IsNullOrWhiteSpace(row.UnitBloodType) ? "—" : row.UnitBloodType)</strong></td>
                            <td>@(string.IsNullOrWhiteSpace(row.StorageLocationName) ? "—" : row.StorageLocationName)</td>
                            <td>@(row.CurrentBloodType ?? "—")</td>
                            <td>@AntibodyCell(row.HasAntibodyHistory, row.AntibodySummary)</td>
                            <td>
                                @(row.LatestCrossmatchResult is CrossmatchResult readyXm ? readyXm.ToString() : "—")
                                @if (row.CrossmatchExpiresUtc is DateTime crossmatchExpires)
                                {
                                    <div class="muted">@crossmatchExpires.ToString("yyyy-MM-dd HH:mm")</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(row.ElectronicCrossmatchNotice))
                                {
                                    <div class="muted">@row.ElectronicCrossmatchNotice</div>
                                }
                            </td>
                            <td><span class="@Ui.Badge(row.DisplayStatus)">@Ui.StatusLabel(row.DisplayStatus)</span></td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(row.SpecimenAccession))
                                {
                                    <div class="mono">@row.SpecimenAccession</div>
                                }
                                @SpecimenExpiryCell(row.SpecimenExpiresUtc, row.SpecimenExpired)
                            </td>
                            <td class="right nowrap">
                                @if (row.OpenAntibodyWorkup)
                                {
                                    <span class="badge badge-amber" title="@row.OpenAntibodyWorkupNotice">Open ABID</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(row.ReactionNotice))
                                {
                                    <span class="badge badge-amber" title="@row.ReactionNotice">Reaction</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(row.DonationRestrictionNotice))
                                {
                                    <span class="badge badge-amber" title="@row.DonationRestrictionNotice">@row.DonationRestrictionNotice</span>
                                }
                                @if (row.ExpiresSoon)
                                {
                                    <span class="badge badge-amber">Expires soon</span>
                                }
                                @if (row.CrossmatchBlocksRoutineIssue)
                                {
                                    <span class="badge badge-red" title="@row.CrossmatchNotice">Crossmatch</span>
                                }
                                else if (!string.IsNullOrWhiteSpace(row.CrossmatchNotice))
                                {
                                    <span class="badge badge-amber" title="@row.CrossmatchNotice">XM incompatible</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(row.SpecialRequirementNotice))
                                {
                                    <span class="badge badge-red" title="@row.SpecialRequirementNotice">Special need</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(row.AntigenNotice))
                                {
                                    <span class="badge badge-amber" title="@row.AntigenNotice">Antigen</span>
                                }
                                @if (row.AboRhDiscrepancyBlocksIssue)
                                {
                                    <span class="badge badge-red" title="@row.AboRhDiscrepancyNotice">ABO discrepancy</span>
                                }
                                else if (!string.IsNullOrWhiteSpace(row.AboRhDiscrepancyNotice))
                                {
                                    <span class="badge badge-amber" title="@row.AboRhDiscrepancyNotice">ABO discrepancy</span>
                                }
                                @if (row.SpecimenBlocksIssue)
                                {
                                    <span class="badge badge-red" title="@row.SpecimenBlockReason">Specimen</span>
                                    <a class="btn btn-ghost btn-sm" href="@($"/patients/{row.PatientId}?tab=specimens")">New specimen</a>
                                }
                                else if (row.UnitOutdated)
                                {
                                    <span class="badge badge-red" title="@row.UnitBlockReason">Outdated</span>
                                }
                                else if (!string.IsNullOrWhiteSpace(row.SpecialRequirementNotice))
                                {
                                }
                                else if (row.AboRhDiscrepancyBlocksIssue)
                                {
                                }
                                else if (row.NeedsSecondAbo || row.CrossmatchBlocksRoutineIssue)
                                {
                                    @if (row.NeedsSecondAbo)
                                    {
                                        <span class="badge badge-amber" title="@ReadyToIssueFormCue.SecondAbo">Second ABO</span>
                                        <a class="btn btn-ghost btn-sm" href="@($"/patients/{row.PatientId}?tab=tests")">Enter type</a>
                                    }
                                    @if (Session.Has(PermissionCodes.IssueEmergencyRelease))
                                    {
                                        <button type="button" class="btn btn-secondary btn-sm" @onclick="() => SelectEmergencyIssue(row)">Emergency</button>
                                    }
                                }
                                else
                                {
                                    <button type="button" class="btn btn-primary btn-sm" @onclick="() => SelectReadyToIssue(row)">Issue</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}

@if (Session.Has(PermissionCodes.IssueCreate) && _desk == "retro")
{
    <div class="bb-card">
        <div class="bb-card-title"><h3>Retrospective crossmatch due</h3></div>
        <p class="muted">Emergency and massive-transfusion issues stay here until a compatible crossmatch is recorded.</p>
        @if (_retroItems.Count == 0)
        {
            <div class="muted">No retrospective crossmatches pending.</div>
        }
        else
        {
            <table class="bb">
                <thead>
                    <tr>
                        <th>Patient / MRN</th>
                        <th>Unit / product / expires</th>
                        <th>Unit / patient type</th>
                        <th>Antibodies</th>
                        <th>Specimen</th>
                        <th>Crossmatch / at issue</th>
                        <th>Issue details</th>
                        <th>Issued to</th>
                        <th>Issued / due</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _retroItems)
                    {
                        <tr>
                            <td><a href="@($"/patients/{row.PatientId}")">@(row.PatientDisplayName ?? $"Issue #{row.IssueId}")</a><span class="sub mono">@(row.MedicalRecordNumber ?? "—")</span></td>
                            <td>
                                <UnitLink Id="row.BloodUnitId" Number="@row.UnitNumber" />
                                <span class="sub">@(string.IsNullOrWhiteSpace(row.ProductName) ? "—" : row.ProductName)</span>
                                <span class="sub nowrap">@(row.UnitExpiresUtc is DateTime retroExpires ? retroExpires.ToString("yyyy-MM-dd HH:mm") : "—")</span>
                            </td>
                            <td class="nowrap">Unit <strong>@(string.IsNullOrWhiteSpace(row.UnitBloodType) ? "—" : row.UnitBloodType)</strong><span class="sub">Patient @(row.CurrentBloodType ?? "—")</span></td>
                            <td>@AntibodyCell(row.HasAntibodyHistory, row.AntibodySummary)</td>
                            <td>
                                @(row.AccessionNumber ?? "—")
                                <div>@SpecimenExpiryCell(row.SpecimenExpiresUtc, row.SpecimenExpired)</div>
                            </td>
                            <td>
                                @(row.LatestCrossmatchResult is CrossmatchResult retroXm ? retroXm.ToString() : "—")
                                @if (row.CrossmatchExpiresUtc is DateTime retroXmExpires)
                                {
                                    <div class="muted">@retroXmExpires.ToString("yyyy-MM-dd HH:mm")</div>
                                }
                                <span class="sub">At issue: @Words(row.CrossmatchStatus)</span>
                            </td>
                            <td>@IssueDetailsCell(row.IssueType.ToString(), row.EmergencyReleaseDetails, row.EmergencyReleaseAuthorizer, row.CoolerId, row.IssuedBy, row.SecondVerifier, row.IssueAppearance.ToString(), row.PtagCode)</td>
                            <td>@(string.IsNullOrWhiteSpace(row.IssuedToLocation) ? "—" : row.IssuedToLocation)<span class="sub">@(string.IsNullOrWhiteSpace(row.IssuedTo) ? "—" : row.IssuedTo)</span></td>
                            <td class="nowrap">
                                @row.IssuedUtc.ToString("yyyy-MM-dd HH:mm")
                                <span class="sub">Due @(row.DueUtc?.ToString("yyyy-MM-dd HH:mm") ?? "—")</span>
                                @if (row.IsOverdue)
                                {
                                    <span class="badge badge-amber">Overdue</span>
                                }
                            </td>
                            <td class="right nowrap">
                                @if (Session.Has(PermissionCodes.CompatibilityCrossmatch))
                                {
                                    <a class="btn btn-primary btn-sm" href="@RetroXmHref(row)">Record crossmatch</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}

@if (Session.Has(PermissionCodes.IssueCreate) && _desk == "transit")
{
    <div class="bb-card">
        <div class="bb-card-title"><h3>In transit to ward</h3></div>
        <p class="muted">Issued units stay here until the receiving location acknowledges custody.</p>
        @if (_inTransitItems.Count == 0)
        {
            <div class="muted">No units currently in transit.</div>
        }
        else
        {
            <table class="bb">
                <thead>
                    <tr>
                        <th>Patient / MRN</th>
                        <th>Unit / product / expires</th>
                        <th>Unit / patient type</th>
                        <th>Antibodies</th>
                        <th>Specimen</th>
                        <th>Crossmatch / at issue</th>
                        <th>Issue details</th>
                        <th>Issued to</th>
                        <th>Issued / due</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _inTransitItems)
                    {
                        <tr>
                            <td><a href="@($"/patients/{row.PatientId}")">@(row.PatientDisplayName ?? $"Issue #{row.IssueId}")</a><span class="sub mono">@(row.MedicalRecordNumber ?? "—")</span></td>
                            <td>
                                <UnitLink Id="row.BloodUnitId" Number="@row.UnitNumber" />
                                <span class="sub">@(string.IsNullOrWhiteSpace(row.ProductName) ? "—" : row.ProductName)</span>
                                <span class="sub nowrap">@(row.UnitExpiresUtc is DateTime transitExpires ? transitExpires.ToString("yyyy-MM-dd HH:mm") : "—")</span>
                            </td>
                            <td class="nowrap">Unit <strong>@(string.IsNullOrWhiteSpace(row.UnitBloodType) ? "—" : row.UnitBloodType)</strong><span class="sub">Patient @(row.CurrentBloodType ?? "—")</span></td>
                            <td>@AntibodyCell(row.HasAntibodyHistory, row.AntibodySummary)</td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(row.SpecimenAccession))
                                {
                                    <div class="mono">@row.SpecimenAccession</div>
                                }
                                @SpecimenExpiryCell(row.SpecimenExpiresUtc, row.SpecimenExpired)
                            </td>
                            <td>
                                @(row.LatestCrossmatchResult is CrossmatchResult transitXm ? transitXm.ToString() : "—")
                                @if (row.CrossmatchExpiresUtc is DateTime transitXmExpires)
                                {
                                    <div class="muted">@transitXmExpires.ToString("yyyy-MM-dd HH:mm")</div>
                                }
                                <span class="sub">At issue: @Words(row.CrossmatchStatus)</span>
                            </td>
                            <td>@IssueDetailsCell(row.IssueType.ToString(), row.EmergencyReleaseDetails, row.EmergencyReleaseAuthorizer, row.CoolerId, row.IssuedBy, row.SecondVerifier, row.IssueAppearance.ToString(), row.PtagCode)</td>
                            <td>@(row.IssuedToLocation ?? "—")<span class="sub">@(string.IsNullOrWhiteSpace(row.IssuedTo) ? "—" : row.IssuedTo)</span></td>
                            <td class="nowrap">
                                @row.IssuedUtc.ToString("yyyy-MM-dd HH:mm")
                                <span class="sub">Due @(row.DueUtc?.ToString("yyyy-MM-dd HH:mm") ?? "—")</span>
                                @if (row.IsOverdue)
                                {
                                    <span class="badge badge-amber">Overdue</span>
                                }
                            </td>
                            <td>
                                @if (Session.Has(PermissionCodes.TransfusionDocument))
                                {
                                    <button type="button" class="btn btn-ghost btn-sm" @onclick="() => SelectWardIssue(row.IssueId, row.ProductName, row.UnitExpiresUtc, row.UnitBloodType, row.SpecimenAccession, row.CrossmatchExpiresUtc, row.LatestCrossmatchResult, row.IssuedTo, row.CoolerId, row.IssuedToLocation, row.IssuedBy, row.EmergencyReleaseDetails, row.SecondVerifier, row.EmergencyReleaseAuthorizer, row.IssueAppearance, row.PtagCode, row.CrossmatchStatus)">Receive</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}

@if ((Session.Has(PermissionCodes.IssueCreate) || Session.Has(PermissionCodes.IssueReturn) || Session.Has(PermissionCodes.TransfusionDocument)) && _desk == "issued")
{
    <div class="bb-card">
        <div class="bb-card-title"><h3>Issued units</h3></div>
        <p class="muted">Units still issued, including after ward receipt. Return, Receive, and Document on the row open the matching form.</p>
        @if (_outstandingItems.Count == 0)
        {
            <div class="muted">No outstanding issued units.</div>
        }
        else
        {
            <table class="bb">
                <thead>
                    <tr>
                        <th>Patient / MRN</th>
                        <th>Unit / product / expires</th>
                        <th>Unit / patient type</th>
                        <th>Antibodies</th>
                        <th>Specimen</th>
                        <th>Crossmatch / at issue</th>
                        <th>Issue details</th>
                        <th>Ward receipt</th>
                        <th>Issued to</th>
                        <th>Issued / time out</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _outstandingItems)
                    {
                        <tr>
                            <td><a href="@($"/patients/{row.PatientId}")">@(row.PatientDisplayName ?? $"Issue #{row.IssueId}")</a><span class="sub mono">@(row.MedicalRecordNumber ?? "—")</span></td>
                            <td>
                                <UnitLink Id="row.BloodUnitId" Number="@row.UnitNumber" />
                                <span class="sub">@(string.IsNullOrWhiteSpace(row.ProductName) ? "—" : row.ProductName)</span>
                                <span class="sub nowrap">@(row.UnitExpiresUtc is DateTime issuedExpires ? issuedExpires.ToString("yyyy-MM-dd HH:mm") : "—")</span>
                            </td>
                            <td class="nowrap">Unit <strong>@(string.IsNullOrWhiteSpace(row.UnitBloodType) ? "—" : row.UnitBloodType)</strong><span class="sub">Patient @(row.CurrentBloodType ?? "—")</span></td>
                            <td>@AntibodyCell(row.HasAntibodyHistory, row.AntibodySummary)</td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(row.SpecimenAccession))
                                {
                                    <div class="mono">@row.SpecimenAccession</div>
                                }
                                @SpecimenExpiryCell(row.SpecimenExpiresUtc, row.SpecimenExpired)
                            </td>
                            <td>
                                @(row.LatestCrossmatchResult is CrossmatchResult issuedXm ? issuedXm.ToString() : "—")
                                @if (row.CrossmatchExpiresUtc is DateTime issuedXmExpires)
                                {
                                    <div class="muted">@issuedXmExpires.ToString("yyyy-MM-dd HH:mm")</div>
                                }
                                <span class="sub">At issue: @Words(row.CrossmatchStatus)</span>
                            </td>
                            <td>@IssueDetailsCell(row.IssueType.ToString(), row.EmergencyReleaseDetails, row.EmergencyReleaseAuthorizer, row.CoolerId, row.IssuedBy, row.SecondVerifier, row.IssueAppearance.ToString(), row.PtagCode)</td>
                            <td>
                                @if (row.WardReceivedUtc is DateTime received)
                                {
                                    <span>@received.ToString("yyyy-MM-dd HH:mm") @(row.WardReceivedBy ?? "")</span>
                                }
                                else
                                {
                                    <span class="muted">Awaiting</span>
                                }
                                <span class="sub">Appearance: @(string.IsNullOrWhiteSpace(row.WardAppearance) ? "—" : row.WardAppearance)</span>
                            </td>
                            <td>@(string.IsNullOrWhiteSpace(row.IssuedToLocation) ? "—" : row.IssuedToLocation)<span class="sub">@(string.IsNullOrWhiteSpace(row.IssuedTo) ? "—" : row.IssuedTo)</span></td>
                            <td><span class="nowrap">@row.IssuedUtc.ToString("yyyy-MM-dd HH:mm")</span><span class="sub">@ReturnReissueRule.TimeOutLabel(row.StorageTimeOutGoverned, row.StorageTimeOutAcceptable)</span></td>
                            <td class="right nowrap">
                                @if (row.WardReceivedUtc is null && Session.Has(PermissionCodes.TransfusionDocument))
                                {
                                    <button type="button" class="btn btn-ghost btn-sm" @onclick="() => SelectWardIssue(row.IssueId, row.ProductName, row.UnitExpiresUtc, row.UnitBloodType, row.SpecimenAccession, row.CrossmatchExpiresUtc, row.LatestCrossmatchResult, row.IssuedTo, row.CoolerId, row.IssuedToLocation, row.IssuedBy, row.EmergencyReleaseDetails, row.SecondVerifier, row.EmergencyReleaseAuthorizer, row.IssueAppearance, row.PtagCode, row.CrossmatchStatus)">Receive</button>
                                }
                                @if (Session.Has(PermissionCodes.IssueReturn))
                                {
                                    <button type="button" class="btn btn-secondary btn-sm" @onclick="() => SelectReturnIssue(row)">Return</button>
                                }
                                @if (row.WardReceivedUtc is not null && Session.Has(PermissionCodes.TransfusionDocument))
                                {
                                    <button type="button" class="btn btn-primary btn-sm" @onclick="() => SelectTransfusionIssue(row)">Document</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}

@if ((Session.Has(PermissionCodes.IssueCreate) || Session.Has(PermissionCodes.IssueReturn) || Session.Has(PermissionCodes.TransfusionDocument)) && _desk == "disposition")
{
    <div class="bb-card">
        <div class="bb-card-title"><h3>Overdue final disposition</h3></div>
        <p class="muted">Issued units past the facility window with no transfusion document, return, or discard. The default window is 24 hours. This board warns. It does not block issue or documentation.</p>
        @if (_dispositionItems.Count > 0)
        {
            <blockquote>Warning. These units are past the final-disposition window.</blockquote>
        }
        @if (_dispositionItems.Count == 0)
        {
            <div class="muted">No issued units are past the final-disposition window.</div>
        }
        else
        {
            <table class="bb">
                <thead><tr><th>Unit</th><th>Patient</th><th>Issued</th><th>Due</th></tr></thead>
                <tbody>
                    @foreach (var row in _dispositionItems)
                    {
                        <tr>
                            <td class="mono"><a href="@InventoryUrls.Unit(row.UnitId)">@row.UnitNumber</a></td>
                            <td>@row.PatientLabel</td>
                            <td>@row.IssuedUtc.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@row.DueUtc.ToString("yyyy-MM-dd HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}

@if (_desk == "issue")
{
<div class="bb-card" @ref="_issueForm" tabindex="-1" data-enter-flow>
    <div class="bb-card-title"><h3>Issue a unit</h3></div>
    @if (!Session.Has(PermissionCodes.IssueCreate))
    {
        <div class="muted">You do not have permission to issue units.</div>
    }
    else
    {
        <Outcome Value="_issueFb" RequiresSignature="true" />
        <div class="form-row">
            <div class="field"><label>Unit number</label>
                <UnitPickerComboBox Scope="UnitPickerScope.Issuable" @bind-Value="_issue.BloodUnitId" />
            </div>
            <div class="field"><label>Patient</label>
                <FilterableComboBox TItem="PatientDto" TValue="long?"
                    Items="_patients"
                    @bind-Value="IssuePatientId"
                    @bind-Value:after="OnIssuePatientChangedAsync"
                    DisplayText="@(p => $"{p.LastName}, {p.FirstName} ({p.MedicalRecordNumber})")"
                    ItemValue="@(p => p.Id)"
                    SearchText="@(p => $"{p.LastName} {p.FirstName} {p.MedicalRecordNumber}")"
                    Clearable="true"
                    Placeholder="Search MRN or name" />
            </div>
            <div class="field"><label>Issued to (person)</label><input @bind="_issue.IssuedTo" /></div>
            <div class="field"><label>Issued to (location)</label><input @bind="_issue.IssuedToLocation" /></div>
            <div class="field"><label>Cooler / transport id</label><input @bind="_issue.CoolerId" placeholder="Optional cooler checkout" /></div>
            <div class="field"><label>Issue type</label>
                <select @bind="_issue.IssueType">@foreach (var t in AllowedIssueTypes) { <option value="@t">@t</option> }</select>
            </div>
        </div>
        <div class="form-row">
            <div class="field"><label>Patient ID 1 (MRN)</label>
                <input @bind="_issue.PatientIdentifier1Value" @bind:event="oninput" autocomplete="off" placeholder="Scan wristband or type" data-enter-step />
                <IdentifierMatchHint Type="IdentityTokenType.MedicalRecordNumber" Value="@_issue.PatientIdentifier1Value" Patient="IssuePatient" />
            </div>
            <div class="field"><label>Patient ID 2 (DOB yyyy-MM-dd)</label>
                <input @bind="_issue.PatientIdentifier2Value" @bind:event="oninput" autocomplete="off" placeholder="From wristband or requisition" data-enter-step />
                <IdentifierMatchHint Type="IdentityTokenType.DateOfBirth" Value="@_issue.PatientIdentifier2Value" Patient="IssuePatient" />
            </div>
            <div class="field"><label>Second verifier</label>
                <FilterableComboBox TItem="DirectoryUserDto" TValue="string?"
                    Items="SecondVerifierChoices"
                    @bind-Value="_issue.SecondVerifier"
                    DisplayText="@(u => u.Label)"
                    ItemValue="@(u => u.UserName)"
                    SearchText="@(u => u.Label)"
                    Clearable="true"
                    Placeholder="Different active user" />
            </div>
        </div>
        @if (_issue.IssueType == IssueType.MassiveTransfusion && _issue.PatientId > 0)
        {
            @if (IssueMtp is { } activeMtp)
            {
                <div class="alert alert-info" style="margin-top:.5rem;">
                    Issuing under <strong>MTP #@activeMtp.Id</strong>, active @activeMtp.MinutesActive min, called by @activeMtp.RequestedBy: @activeMtp.Reason.
                    <button type="button" class="btn btn-sm btn-ghost" @onclick="() => UseMtpReason(activeMtp)">Use as override reason</button>
                </div>
            }
            else
            {
                <div class="alert alert-warning" style="margin-top:.5rem;">
                    <strong>No massive transfusion protocol is active for this patient.</strong>
                    Record who called it and why before issuing under MTP.
                    @if (Session.Has(PermissionCodes.IssueEmergencyRelease))
                    {
                        <div class="form-row" style="margin-top:.5rem;">
                            <div class="field"><label>Called by (clinician)</label><input @bind="_mtpRequestedBy" placeholder="e.g. Dr. Rivera, trauma" /></div>
                            <div class="field"><label>Reason</label><input @bind="_mtpReason" placeholder="e.g. Hemorrhagic shock" /></div>
                            <div class="field"><label>Location</label><input @bind="_mtpLocation" placeholder="Optional, e.g. ED trauma 1" /></div>
                            @if (_mtpPacks.Count > 0)
                            {
                                <div class="field"><label>Pack (optional)</label>
                                    <select @bind="_mtpPackId">
                                        <option value="">No pack</option>
                                        @foreach (var pk in _mtpPacks)
                                        {
                                            <option value="@pk.Id">@pk.Name (@pk.Summary)</option>
                                        }
                                    </select>
                                </div>
                            }
                        </div>
                        <button type="button" class="btn btn-sm btn-danger" disabled="@_busy" @onclick="ActivateMtpAsync">Activate MTP</button>
                    }
                    <Outcome Value="_mtpFb" />
                </div>
            }
        }
        <div class="flex gap" style="flex-wrap:wrap;margin:.5rem 0 1rem;">
            <AppearanceSelect Label="Appearance at issue" Style="min-width:14rem;" @bind-Value="_issue.Appearance" />
        </div>
        <UnitScanVerificationPanel Scan="_issueScan" />
        @if (_ptagRequired)
        {
            <div class="alert alert-warning" style="margin-top:.75rem;">
                <strong>P-tag ID</strong>
                <p class="muted">Print the compatibility tag, then scan the P-tag ID before issuing.</p>
                <div class="flex gap" style="flex-wrap:wrap;align-items:end;">
                    @if (Session.Has(PermissionCodes.PrintLabel))
                    {
                        <button type="button" class="btn btn-secondary btn-sm" disabled="@(_busy || _issue.BloodUnitId is null || _issue.PatientId <= 0)" @onclick="PrintPreparedPtagAsync">Print P-tag</button>
                    }
                    <div class="field" style="min-width:14rem;margin:0;">
                        <label>Scanned P-tag ID</label>
                        <input @bind="_ptagScan" @bind:event="oninput" autocomplete="off" />
                    </div>
                    @if (_ptagJobId is long preparedJob)
                    {
                        <a class="btn btn-ghost btn-sm" href="@($"/printing?jobId={preparedJob}")">Open preview</a>
                    }
                </div>
                <Outcome Value="_ptagFb" />
            </div>
        }
        @if (PrefillNotices.Count > 0)
        {
            <div class="alert alert-warning">
                <strong>This reserved unit</strong>
                <ul>
                    @foreach (var notice in PrefillNotices)
                    {
                        <li>@notice</li>
                    }
                </ul>
            </div>
        }
        @if (_issueAckRequirements.Count > 0)
        {
            <div class="alert alert-warning" style="margin-top:.75rem;">
                <strong>Acknowledge special requirements</strong>
                @foreach (var req in _issueAckRequirements)
                {
                    <label class="flex" style="gap:.35rem;margin-top:.35rem;">
                        <input type="checkbox" checked="@_issueAcks.Contains(req.Code ?? "")" @onchange="e => ToggleIssueAck(req.Code, (bool)(e.Value ?? false))" />
                        @(req.Name ?? req.Code) @(string.IsNullOrWhiteSpace(req.Instruction) ? "" : $"— {req.Instruction}")
                    </label>
                }
            </div>
        }

        <div class="alert alert-warning">
            <label class="flex"><input type="checkbox" @bind="_overrideOn" /> &nbsp;<strong>Override</strong> (emergency release / warning override)</label>
            @if (_overrideOn)
            {
                <div class="form-row" style="margin-top:.5rem;">
                    <div class="field"><label>Override reason</label><input @bind="_overrideReason" /></div>
                    <AuthorizerField @bind-Value="_authorizedBy" />
                    <div class="field"><label>Meaning of signature</label><input @bind="_signatureMeaning" placeholder="e.g. I authorize emergency release" /></div>
                    <div class="field"><label>Password / PIN</label><input type="password" @bind="_signatureSecret" /></div>
                </div>
            }
        </div>

        @if (_overrideOn)
        {
            <button class="btn btn-danger" disabled="@(_busy || _issue.BloodUnitId is null || _issue.PatientId <= 0 || PtagScanMissing)" @onclick="IssueWithOverrideAsync">Sign &amp; issue (override)</button>
        }
        else
        {
            <button class="btn btn-primary" disabled="@(_busy || _issue.BloodUnitId is null || _issue.PatientId <= 0 || PtagScanMissing)" @onclick="IssueAsync">Issue unit</button>
        }

        @if (_lastIssue is not null)
        {
            <div class="alert alert-success" style="margin-top:1rem;">
                Issue <strong>#@_lastIssue.Id</strong> created for unit @_lastIssue.BloodUnitId &middot; <span class="badge badge-amber">@_lastIssue.Status</span>
                <div class="flex gap" style="margin-top:.65rem;flex-wrap:wrap;">
                    @if (Session.Has(PermissionCodes.PrintLabel))
                    {
                        <button type="button" class="btn btn-primary btn-sm" disabled="@_busy" @onclick="PrintLastIssuePtagAsync">Print P-tag</button>
                    }
                    <a class="btn btn-secondary btn-sm" href="@PtagPrintHref()">Open Printing</a>
                    <a class="btn btn-ghost btn-sm" href="@($"/patients/{_lastIssue.PatientId}?tab=products")">Open chart · Products</a>
                </div>
                <Outcome Value="_ptagFb" />
            </div>
        }
    }
</div>
}

@if (_desk == "receipt")
{
<div class="bb-card" tabindex="-1" data-enter-flow>
    <div class="bb-card-title"><h3>Ward receipt</h3></div>
    <p class="muted">The receiving location must acknowledge custody before transfusion can be documented (SoftBank remote-issue receipt).</p>
    @if (!Session.Has(PermissionCodes.TransfusionDocument))
    {
        <div class="muted">No permission to record ward receipt.</div>
    }
    else
    {
        <Outcome Value="_wardFb" />
        <div class="form-row">
            <div class="field"><label>Unit number</label><input class="mono" @bind="_wardUnitLookup" @bind:after="LookUpWardUnitAsync" placeholder="Type or scan, or Receive from a list" data-enter-step autocomplete="off" /></div>
            <div class="field"><label>Received by</label><input @bind="_wardReceivedBy" placeholder="Nurse / ward staff" data-enter-step /></div>
            <AppearanceSelect Label="Appearance at receipt" @bind-Value="_wardAppearance" />
        </div>
        <UnitScanVerificationPanel Scan="_wardScan"
            Title="Ward receipt scan"
            Help="Scan the unit label at the receiving location. Required for ISBT-labeled units (SoftBank remote-issue chain)." />
        <div class="flex gap" style="margin-top:.75rem;">
            <button class="btn btn-primary btn-sm" disabled="@_busy" @onclick="RecordWardReceiptAsync">Acknowledge receipt</button>
            <button class="btn btn-ghost btn-sm" disabled="@_busy" @onclick="LoadIssueAsync">Check status</button>
        </div>
        @if (!string.IsNullOrWhiteSpace(_wardProductName) || !string.IsNullOrWhiteSpace(_wardExpirationNotice) || !string.IsNullOrWhiteSpace(_wardUnitTypeNotice) || !string.IsNullOrWhiteSpace(_wardSpecimenNotice) || !string.IsNullOrWhiteSpace(_wardCrossmatchNotice) || !string.IsNullOrWhiteSpace(_wardIssuedToNotice) || !string.IsNullOrWhiteSpace(_wardCoolerNotice) || !string.IsNullOrWhiteSpace(_wardLocationNotice) || !string.IsNullOrWhiteSpace(_wardIssuedByNotice) || !string.IsNullOrWhiteSpace(_wardSecondVerifierNotice))
        {
            <FactList Facts="@(new string?[] { _wardExpirationNotice, _wardUnitTypeNotice, _wardSpecimenNotice, _wardCrossmatchNotice, _wardIssuedToNotice, _wardCoolerNotice, _wardLocationNotice, _wardIssuedByNotice, _wardSecondVerifierNotice })" Style="margin-top:.75rem;">Receiving @if (!string.IsNullOrWhiteSpace(_wardProductName)) { <strong>@_wardProductName</strong> }</FactList>
        }
        @if (!string.IsNullOrWhiteSpace(_wardReleaseReason))
        {
            <p class="muted">@_wardReleaseReason</p>
        }
        @if (!string.IsNullOrWhiteSpace(_wardReleaseAuthorizer))
        {
            <p class="muted">@_wardReleaseAuthorizer</p>
        }
        @if (!string.IsNullOrWhiteSpace(_wardIssueAppearance))
        {
            <p class="muted">@_wardIssueAppearance</p>
        }
        @if (!string.IsNullOrWhiteSpace(_wardPtagNotice))
        {
            <p class="muted">@_wardPtagNotice</p>
        }
        @if (!string.IsNullOrWhiteSpace(_wardCrossmatchStatusNotice))
        {
            <p class="muted">@_wardCrossmatchStatusNotice</p>
        }
        @if (_wardIssue is not null)
        {
            <p class="muted" style="margin-top:.75rem;">
                Issue <strong>@_wardIssue.Id</strong> · @_wardIssue.Status
                @if (_wardIssue.WardReceivedUtc is not null)
                {
                    <span> · received @_wardIssue.WardReceivedUtc.Value.ToString("yyyy-MM-dd HH:mm") by @_wardIssue.WardReceivedBy · @_wardIssue.WardAppearance</span>
                }
                else
                {
                    <span> · awaiting ward receipt</span>
                }
                <span> · </span>
                <a href="@($"/patients/{_wardIssue.PatientId}?tab=products")">Open chart · Products</a>
                <span> · </span>
                <a href="@InventoryUrls.Unit(_wardIssue.BloodUnitId)">Open Inventory</a>
            </p>
        }
    }
</div>
}

@if (_desk == "return")
{
    <div class="bb-card">
        <div class="bb-card-title"><h3>Return a unit</h3></div>
        @if (!Session.Has(PermissionCodes.IssueReturn))
        {
            <div class="muted">No permission to return units.</div>
        }
        else
        {
            <Outcome Value="_returnFb" />
            <div class="form-row">
                <div class="field"><label>Unit number</label><input class="mono" @bind="_returnUnitLookup" @bind:after="LookUpReturnUnitAsync" placeholder="Type or scan, or Return from Issued units" /></div>
                <div class="field"><label>Reason</label><input @bind="_returnReason" @bind:event="oninput" /></div>
                <div class="field"><label>Destination</label>
                    <select @bind="_returnDestination">
                        @if (ReturnCanBeAvailable)
                        {
                            <option value="@UnitStatus.Available">Available</option>
                        }
                        <option value="@UnitStatus.Quarantine">Quarantine</option>
                        <option value="@UnitStatus.Discarded">Disposed</option>
                    </select>
                </div>
                @if (_returnUnitNumber is not null)
                {
                    <FactList Facts="@(new string?[] { _returnProductName, _returnExpirationNotice, _returnUnitTypeNotice, _returnSpecimenNotice, _returnCrossmatchNotice, _returnIssuedToNotice, _returnCoolerNotice, _returnLocationNotice, _returnIssuedByNotice, _returnSecondVerifierNotice, _returnPatientName })">Returning <span class="mono">@_returnUnitNumber</span></FactList>
                    @if (!string.IsNullOrWhiteSpace(_returnReleaseReason))
                    {
                        <p class="muted" style="margin:0;">@_returnReleaseReason</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(_returnReleaseAuthorizer))
                    {
                        <p class="muted" style="margin:0;">@_returnReleaseAuthorizer</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(_returnIssueAppearance))
                    {
                        <p class="muted" style="margin:0;">@_returnIssueAppearance</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(_returnPtagNotice))
                    {
                        <p class="muted" style="margin:0;">@_returnPtagNotice</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(_returnCrossmatchStatusNotice))
                    {
                        <p class="muted" style="margin:0;">@_returnCrossmatchStatusNotice</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(_returnTimeOutNotice))
                    {
                        <p class="muted" style="margin:0;">@_returnTimeOutNotice</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(_returnWardAppearance))
                    {
                        <p class="muted" style="margin:0;">@_returnWardAppearance</p>
                    }
                }
            </div>
            <p class="muted">Record temperature, seal, and visual inspection. A failed seal or appearance cannot return to available stock. The storage device decides the return-to-available window. A governed device cannot be declared acceptable after that window. An exempt device does not fail the window.</p>
            <InspectionAnswer Label="Temperature" @bind-Value="_returnTempOk" @bind-Value:after="SyncReturnDestination" />
            <InspectionAnswer Label="Seal" YesText="Intact" NoText="Broken" @bind-Value="_returnSealOk" @bind-Value:after="SyncReturnDestination" />
            <InspectionAnswer Label="Visual inspection" @bind-Value="_returnVisualOk" @bind-Value:after="SyncReturnDestination" />
            @if (ReturnInspectionMissing)
            {
                <p class="muted">Answer all three inspections before the unit can go back to available stock. Choose Quarantine or Disposed to return it without them.</p>
            }
            <button class="btn btn-secondary" disabled="@(_busy || string.IsNullOrWhiteSpace(_returnReason) || ReturnInspectionMissing)" @onclick="ReturnAsync">Return unit</button>
            @if (_lastReturn is not null)
            {
                <p class="muted" style="margin-top:.75rem;">
                    Return #@_lastReturn.Id recorded@( _lastReturn.ReissueEligible ? " · eligible for reissue" : " · not eligible for reissue").
                    <a href="@InventoryUrls.Unit(_lastReturn.BloodUnitId)">Open Inventory</a>
                    @if (_returnPatientId is long returnedPatientId)
                    {
                        <span> · </span>
                        <a href="@($"/patients/{returnedPatientId}?tab=products")">Open chart · Products</a>
                    }
                </p>
            }
        }
    </div>
}

@if (_desk == "transfuse")
{
    <div class="bb-card" tabindex="-1" data-enter-flow>
        <div class="bb-card-title"><h3>Document transfusion</h3></div>
        @if (!Session.Has(PermissionCodes.TransfusionDocument))
        {
            <div class="muted">No permission to document transfusions.</div>
        }
        else
        {
            <Outcome Value="_txFb" />
            <div class="form-row">
                <div class="field"><label>Unit number</label><input class="mono" @bind="_txUnitLookup" @bind:after="LookUpTransfusionUnitAsync" placeholder="Type or scan, or Document from Issued units" data-enter-step autocomplete="off" /></div>
                <div class="field"><label>Disposition</label>
                    <select @bind="_txDisposition">@foreach (var d in Enum.GetValues<TransfusionDisposition>()) { <option value="@d">@d</option> }</select>
                </div>
                <div class="field"><label>Volume transfused (mL)</label><input type="number" @bind="_txVolume" /></div>
                <div class="field"><label>Transfusionist</label><input @bind="_txTransfusionist" /></div>
                <div class="field"><label>Second verifier</label>
                    <FilterableComboBox TItem="DirectoryUserDto" TValue="string?"
                        Items="SecondVerifierChoices"
                        @bind-Value="_txSecondVerifier"
                        DisplayText="@(u => u.Label)"
                        ItemValue="@(u => u.UserName)"
                        SearchText="@(u => u.Label)"
                        Clearable="true"
                        Placeholder="Different active user" />
                </div>
            </div>
            <p class="muted">The receiving location must acknowledge the unit (ward receipt) before this can succeed. Patient identifiers must match the issued patient — a checkbox is not positive identification.</p>
            @if (!string.IsNullOrWhiteSpace(_txProductName) || !string.IsNullOrWhiteSpace(_txExpirationNotice) || !string.IsNullOrWhiteSpace(_txUnitTypeNotice) || !string.IsNullOrWhiteSpace(_txSpecimenNotice) || !string.IsNullOrWhiteSpace(_txCrossmatchNotice) || !string.IsNullOrWhiteSpace(_txIssuedToNotice) || !string.IsNullOrWhiteSpace(_txCoolerNotice) || !string.IsNullOrWhiteSpace(_txLocationNotice) || !string.IsNullOrWhiteSpace(_txIssuedByNotice) || !string.IsNullOrWhiteSpace(_txSecondVerifierNotice))
            {
                <FactList Facts="@(new string?[] { _txExpirationNotice, _txUnitTypeNotice, _txSpecimenNotice, _txCrossmatchNotice, _txIssuedToNotice, _txCoolerNotice, _txLocationNotice, _txIssuedByNotice, _txSecondVerifierNotice })">Documenting @if (!string.IsNullOrWhiteSpace(_txProductName)) { <strong>@_txProductName</strong> }</FactList>
            }
            @if (!string.IsNullOrWhiteSpace(_txReleaseReason))
            {
                <p class="muted">@_txReleaseReason</p>
            }
            @if (!string.IsNullOrWhiteSpace(_txReleaseAuthorizer))
            {
                <p class="muted">@_txReleaseAuthorizer</p>
            }
            @if (!string.IsNullOrWhiteSpace(_txIssueAppearance))
            {
                <p class="muted">@_txIssueAppearance</p>
            }
            @if (!string.IsNullOrWhiteSpace(_txPtagNotice))
            {
                <p class="muted">@_txPtagNotice</p>
            }
            @if (!string.IsNullOrWhiteSpace(_txCrossmatchStatusNotice))
            {
                <p class="muted">@_txCrossmatchStatusNotice</p>
            }
            @if (!string.IsNullOrWhiteSpace(_txWardAppearance))
            {
                <p class="muted">@_txWardAppearance</p>
            }
            <div class="form-row">
                <div class="field"><label>Patient ID 1 (MRN)</label>
                    <input @bind="_txPatientIdentifier1" @bind:event="oninput" autocomplete="off" placeholder="Scan wristband or type" data-enter-step />
                    <IdentifierMatchHint Type="IdentityTokenType.MedicalRecordNumber" Value="@_txPatientIdentifier1" Patient="_txPatient" />
                </div>
                <div class="field"><label>Patient ID 2 (DOB yyyy-MM-dd)</label>
                    <input @bind="_txPatientIdentifier2" @bind:event="oninput" autocomplete="off" placeholder="From wristband" data-enter-step />
                    <IdentifierMatchHint Type="IdentityTokenType.DateOfBirth" Value="@_txPatientIdentifier2" Patient="_txPatient" />
                </div>
            </div>
            <label class="flex"><input type="checkbox" @bind="_txReaction" /> &nbsp;Reaction suspected</label>
            <UnitScanVerificationPanel Scan="_txScan" Title="Bedside unit scan" Help="Scan the unit at the bedside. Required for ISBT-labeled units together with matching patient identifiers." />
            <div style="margin-top:.75rem;">
                <button class="btn btn-secondary" disabled="@_busy" @onclick="DocumentTransfusionAsync">Document</button>
            </div>
            @if (_lastTransfusion is not null)
            {
                <p class="muted" style="margin-top:.75rem;">
                    Transfusion #@_lastTransfusion.Id documented for issue #@_lastTransfusion.IssueId.
                    <a href="@($"/patients/{_lastTransfusion.PatientId}?tab=products")">Open chart · Products</a>
                </p>
            }
            @if (_openedReactionId is long reactionId)
            {
                <div class="alert alert-warning" style="margin-top:.75rem;">
                    Reaction workup opened.
                    <a href="@($"/reactions?id={reactionId}")">Open investigation #@reactionId</a>
                </div>
            }
        }
    </div>
}

