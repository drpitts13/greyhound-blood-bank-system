@page "/issuing"
@using Microsoft.AspNetCore.Components
@inject BloodBankApiClient Api
@inject UserSession Session

<PageTitle>Issue &amp; Transfuse &middot; HemoCore</PageTitle>

<h1>Issue &amp; Transfuse</h1>
@if (QueryPatientId is long chartPatientId)
{
    <p>
        <a href="@($"/patients/{chartPatientId}?tab=products")">Open chart · Products</a>
        <span class="muted"> · Patient and unit stay prefilled on this desk.</span>
    </p>
}
<p class="muted">Reserved units appear on Ready to issue so the desk does not re-key patient and unit after allocate.</p>
<details class="bb-help">
    <summary>How it works</summary>
    <ul>
        <li>The issue gate runs all safety checks, including storage-location policy and electronic / remote issue eligibility (AABB 5.16).</li>
        <li>Overrides require a reason and an electronic signature.</li>
    </ul>
</details>

@* Worklists show how many items wait on each, so nobody clicks through empty desks; the forms are grouped apart. *@
<div class="desk-nav">
    @if (Session.Has(PermissionCodes.IssueCreate) || Session.Has(PermissionCodes.IssueReturn) || Session.Has(PermissionCodes.TransfusionDocument))
    {
        <div class="desk-group">
            <span class="desk-group-label">Worklists</span>
            @if (Session.Has(PermissionCodes.IssueCreate))
            {
                <button type="button" class="btn btn-sm @DeskClass("ready")" @onclick='() => SelectDesk("ready")'>Ready to issue@(CountBadge(_readyItems.Count))</button>
                <button type="button" class="btn btn-sm @DeskClass("second")" @onclick='() => SelectDesk("second")'>Second ABO/Rh@(CountBadge(_secondAboItems.Count))</button>
                <button type="button" class="btn btn-sm @DeskClass("retro")" @onclick='() => SelectDesk("retro")'>Retrospective@(CountBadge(_retroItems.Count))</button>
                <button type="button" class="btn btn-sm @DeskClass("transit")" @onclick='() => SelectDesk("transit")'>In transit@(CountBadge(_inTransitItems.Count))</button>
            }
            <button type="button" class="btn btn-sm @DeskClass("issued")" @onclick='() => SelectDesk("issued")'>Issued units@(CountBadge(_outstandingItems.Count))</button>
            <button type="button" class="btn btn-sm @DeskClass("disposition")" @onclick='() => SelectDesk("disposition")'>Final disposition@(CountBadge(_dispositionItems.Count))</button>
        </div>
    }
    <div class="desk-group">
        <span class="desk-group-label">Forms</span>
        <button type="button" class="btn btn-sm @DeskClass("issue")" @onclick='() => SelectDesk("issue")'>Issue</button>
        <button type="button" class="btn btn-sm @DeskClass("receipt")" @onclick='() => SelectDesk("receipt")'>Ward receipt</button>
        <button type="button" class="btn btn-sm @DeskClass("return")" @onclick='() => SelectDesk("return")'>Return</button>
        <button type="button" class="btn btn-sm @DeskClass("transfuse")" @onclick='() => SelectDesk("transfuse")'>Transfusion</button>
    </div>
</div>

@if (_activeMtp.Count > 0)
{
    @* Every active massive transfusion protocol stays in view on every desk until someone closes it. *@
    <div class="alert alert-danger" role="status" style="margin-top:.75rem;">
        <strong>Massive transfusion protocol active</strong>
        <Outcome Value="_mtpBoardFb" />
        @foreach (var mtp in _activeMtp)
        {
            <div style="margin-top:.5rem;">
                <strong>@mtp.PatientName</strong> @(mtp.MedicalRecordNumber is null ? "" : $"({mtp.MedicalRecordNumber})")
                &middot; MTP #@mtp.Id, @mtp.MinutesActive min &middot; called by @mtp.RequestedBy &middot; @mtp.Reason
                @if (!string.IsNullOrWhiteSpace(mtp.IdleNotice))
                {
                    <div data-mtp-idle><span class="badge badge-amber">Still open</span> @mtp.IdleNotice</div>
                }
                <div class="muted">
                    @if (mtp.Counts.Count == 0)
                    {
                        <span>No units issued yet.</span>
                    }
                    else
                    {
                        @string.Join(" · ", mtp.Counts.Select(c => $"{ComponentLabel(c.ComponentClass)} {c.Issued} issued" + (c.Returned > 0 ? $", {c.Returned} returned" : "") + (c.Transfused > 0 ? $", {c.Transfused} transfused" : "")))
                    }
                </div>
                @if (mtp.Pack is { } pack)
                {
                    @* Guidance only: the pack never blocks or adds a unit. *@
                    <div>
                        Pack <span class="mono">@pack.Code</span>: round @pack.CurrentRound
                        @(pack.CompletedRounds > 0 ? $"({pack.CompletedRounds} complete)" : "")
                        &middot; @string.Join(" · ", pack.Components.Select(c => $"{ComponentLabel(c.ComponentClass)} {c.InCurrentRound}/{c.PerRound}"))
                    </div>
                }
                @if (_mtpPackRecords.TryGetValue(mtp.Id, out var packed) && packed.Count > 0)
                {
                    <div>
                        Packs sent:
                        @foreach (var pr in packed)
                        {
                            <a class="btn btn-ghost btn-sm" href="@($"/mtp/pack-records/{pr.Id}")">
                                Pack @pr.PackNumber · @pr.ContainerName@(pr.ContainerLabel is null ? "" : $" {pr.ContainerLabel}") · @pr.UnitCount unit@(pr.UnitCount == 1 ? "" : "s") · @pr.TemperatureC.ToString("0.0") °C@(pr.TemperatureOutsideRange ? " (out of range)" : "")
                            </a>
                        }
                    </div>
                }
                @if (_packingMtpId == mtp.Id)
                {
                    var unpacked = mtp.Units.Where(u => u.IssueStatus == IssueStatus.Issued && u.PackRecordId is null).ToList();
                    <div class="bb-card" style="margin-top:.5rem;">
                        <strong>Record a pack for MTP #@mtp.Id</strong>
                        @if (_containers.Count == 0)
                        {
                            <p class="muted">No transport containers are set up. An administrator adds them under Admin › Transport Containers.</p>
                        }
                        else
                        {
                            <div class="form-row" style="margin-top:.5rem;">
                                <div class="field"><label>Container</label>
                                    <select @bind="_packContainerId">
                                        <option value="">Choose…</option>
                                        @foreach (var tc in _containers)
                                        {
                                            <option value="@tc.Id">@tc.Name (@tc.RangeText)</option>
                                        }
                                    </select>
                                </div>
                                <div class="field"><label>Which one (optional)</label><input @bind="_packContainerLabel" placeholder="e.g. Cooler 3" /></div>
                                <div class="field"><label>Temperature °C</label><input type="number" step="0.1" @bind="_packTemperature" placeholder="Read it now" /></div>
                                <div class="field" style="flex:2;"><label>Comment</label><input @bind="_packComment" placeholder="Optional" /></div>
                            </div>
                            @if (unpacked.Count == 0)
                            {
                                <p class="muted">Every unit issued under this protocol is already in a pack. Issue more units first.</p>
                            }
                            else
                            {
                                <div class="muted">Units issued under this protocol and not yet packed:</div>
                                @foreach (var u in unpacked)
                                {
                                    <label class="flex" style="gap:.35rem;margin-top:.25rem;">
                                        <input type="checkbox" checked="@_packIssueIds.Contains(u.IssueId)" @onchange="e => TogglePackUnit(u.IssueId, (bool)(e.Value ?? false))" />
                                        <span class="mono">@u.UnitNumber</span> · @u.ProductName · @u.BloodType
                                    </label>
                                }
                                <button type="button" class="btn btn-ghost btn-sm" @onclick="() => { foreach (var u in unpacked) _packIssueIds.Add(u.IssueId); }">Select all @unpacked.Count</button>
                            }
                            <div class="flex gap" style="margin-top:.5rem;">
                                <button type="button" class="btn btn-sm btn-primary" disabled="@(_busy || _packIssueIds.Count == 0)" @onclick="() => RecordPackAsync(mtp)">Record pack</button>
                                <button type="button" class="btn btn-sm btn-ghost" @onclick="() => _packingMtpId = null">Cancel</button>
                            </div>
                        }
                    </div>
                }
                <div class="flex gap" style="flex-wrap:wrap;align-items:end;margin-top:.35rem;">
                    @if (Session.Has(PermissionCodes.IssueCreate))
                    {
                        <button type="button" class="btn btn-sm btn-danger" @onclick="() => IssueUnderMtpAsync(mtp)">Issue under this MTP</button>
                        <button type="button" class="btn btn-sm btn-secondary" @onclick="() => StartPacking(mtp)">Pack a cooler…</button>
                    }
                    @if (Session.Has(PermissionCodes.IssueEmergencyRelease))
                    {
                        @if (_closingMtpId == mtp.Id)
                        {
                            <div class="field" style="min-width:16rem;margin:0;">
                                <label>Why is it ending?</label>
                                <input @bind="_mtpCloseReason" placeholder="e.g. Bleeding controlled; protocol stood down" />
                            </div>
                            <button type="button" class="btn btn-sm btn-secondary" disabled="@_busy" @onclick="() => CloseMtpAsync(mtp)">Close MTP</button>
                            <button type="button" class="btn btn-sm btn-ghost" @onclick="() => _closingMtpId = null">Cancel</button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-sm btn-ghost" @onclick="() => { _closingMtpId = mtp.Id; _mtpCloseReason = null; }">Close…</button>
                        }
                    }
                </div>
            </div>
        }
    </div>
}

@if (Session.Has(PermissionCodes.IssueCreate) && _desk == "second")
{
    <div class="bb-card">
        <div class="bb-card-title"><h3>Second ABO/Rh due</h3></div>
        <p class="muted">Patients with reserved units who still need a concordant historical or second-sample type before routine red-cell issue (AABB 5.14 / CAP TRM.40650). The second type must come from a separately collected specimen. Each row says whether an ABO/Rh is already ordered, or orders one.</p>
        @if (_secondAboItems.Count == 0)
        {
            <div class="muted">No reserved units waiting on a second ABO/Rh.</div>
        }
        else
        {
            <div class="table-scroll">
            <table class="bb">
                <thead>
                    <tr>
                        <th>Patient</th>
                        <th>MRN</th>
                        <th>Current type</th>
                        <th>Reserved</th>
                        <th>ABO/Rh order</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _secondAboItems)
                    {
                        <tr>
                            <td class="nowrap"><a href="@($"/patients/{row.PatientId}?tab=tests")">@row.DisplayName</a></td>
                            <td class="mono">@row.MedicalRecordNumber</td>
                            <td class="mono">@row.CurrentAboRh</td>
                            <td>@row.ReservedUnitCount</td>
                            <td class="nowrap" data-second-abo-next="@row.PatientId">
                                @if (row.AboOrderNumber is { } aboOrder)
                                {
                                    <span class="muted">Ordered</span> <a class="mono" href="@PatientChartUrls.Order(row.PatientId, aboOrder)">@aboOrder</a>
                                }
                                else if (Session.Has(PermissionCodes.PatientWrite))
                                {
                                    <a class="btn btn-primary btn-sm" href="@PatientChartUrls.OrderAboRh(row.PatientId)">Order ABO/Rh</a>
                                }
                                else
                                {
                                    <span class="badge badge-amber">Not ordered</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        }
    </div>
}

@if (Session.Has(PermissionCodes.IssueCreate) && _desk == "ready")
{
    <div class="bb-card">
        <div class="bb-card-title"><h3>Ready to issue</h3></div>
        <p class="muted">Reserved units waiting to issue. Issue on the row fills the issue form with the unit and patient. Scan or type the two patient identifiers from the wristband or requisition, unless your facility pre-fills them. Marks on the row are repeated on that form.</p>
        @if (_readyItems.Count == 0)
        {
            <div class="muted">No reserved units waiting to issue.</div>
        }
        else
        {
            <p role="status"><strong>@ReadyToIssueAttentionRule.Summary(_readyItems)</strong></p>
            @* A notice every row shares is a facility setting: said once here, not repeated on each row. *@
            @if (ReadyToIssueAttentionRule.SharedElectronicCrossmatchNotice(_readyItems) is { } sharedExm)
            {
                <div class="alert alert-info" data-ready-shared-exm>@sharedExm</div>
            }
            <Outcome Value="_releaseReadyFb" />
            @if (Session.Has(PermissionCodes.CompatibilityAllocate) && ReadyToIssueAttentionRule.ReleaseCandidates(_readyItems, DateTime.UtcNow) is { Count: > 0 } candidates)
            {
                <div class="alert alert-info" data-release-review>
                    @if (!_reviewingRelease)
                    {
                        <span>@candidates.Count reserved @(candidates.Count == 1 ? "unit is" : "units are") past @(candidates.Count == 1 ? "its" : "their") reservation, or @(candidates.Count == 1 ? "has" : "have") an expired crossmatch on an expired specimen.</span>
                        <button type="button" class="btn btn-secondary btn-sm" @onclick="() => BeginReleaseReview(candidates)" data-release-review-open>Review and release to stock</button>
                    }
                    else
                    {
                        <div class="muted">Untick any unit the patient still needs. A unit reserved for an order still open starts unticked: tick it only once you know the order no longer needs it. Each ticked unit is released to stock with this reason and audited on its own.</div>
                        <div class="table-scroll">
                        <table class="bb" style="margin:.4rem 0;">
                            <thead><tr><th></th><th>Unit</th><th>Patient</th><th>Why offered</th><th>Still wanted?</th></tr></thead>
                            <tbody>
                                @foreach (var c in candidates)
                                {
                                    <tr data-release-row="@c.UnitNumber">
                                        <td><input type="checkbox" checked="@_releaseChosen.Contains(c.AllocationId)" @onchange="e => ToggleReleaseChoice(c.AllocationId, e)" data-release-choice /></td>
                                        <td class="mono">@c.UnitNumber <span class="sub">@c.ProductName</span></td>
                                        <td>@(c.PatientDisplayName ?? "—") <span class="sub mono">@c.MedicalRecordNumber</span></td>
                                        <td>@ReadyToIssueAttentionRule.ReleaseReason(c, DateTime.UtcNow)</td>
                                        <td>
                                            @if (ReadyToIssueAttentionRule.StillWanted(c) is { } wanted)
                                            {
                                                <span class="badge badge-amber" data-release-still-wanted>@wanted</span>
                                            }
                                            else
                                            {
                                                <span class="muted">—</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        </div>
                        <div class="flex gap" style="align-items:flex-end;flex-wrap:wrap;">
                            <div class="field" style="flex:1;min-width:14rem;"><label>Reason</label><input @bind="_releaseBatchReason" @bind:event="oninput" placeholder="e.g. Reservations ended, transfusion not needed" data-release-reason /></div>
                            <button type="button" class="btn btn-secondary btn-sm" disabled="@(_busy || _releaseChosen.Count == 0 || string.IsNullOrWhiteSpace(_releaseBatchReason))" @onclick="ReleaseChosenAsync" data-release-submit>Release @_releaseChosen.Count to stock</button>
                            <button type="button" class="btn btn-ghost btn-sm" @onclick="() => _reviewingRelease = false">Cancel</button>
                        </div>
                    }
                </div>
            }
            <div class="table-scroll">
            <table class="bb">
                <thead>
                    <tr>
                        <th>Patient / MRN</th>
                        <th>Unit / product / expires</th>
                        <th>Unit type</th>
                        <th>Location</th>
                        <th>Patient type</th>
                        <th>Antibodies</th>
                        <th>XM</th>
                        <th>Status</th>
                        <th>Specimen</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _readyItems)
                    {
                        <tr>
                            <td><a href="@($"/patients/{row.PatientId}?tab=products")">@(row.PatientDisplayName ?? "—")</a><span class="sub mono">@(row.MedicalRecordNumber ?? "—")</span></td>
                            <td>
                                <UnitLink Id="row.BloodUnitId" Number="@row.UnitNumber" />
                                <span class="sub">@(string.IsNullOrWhiteSpace(row.ProductName) ? "—" : row.ProductName)</span>
                                <span class="sub nowrap">@(row.UnitExpiresUtc is DateTime unitExpires ? unitExpires.ToString("yyyy-MM-dd HH:mm") : "—")</span>
                            </td>
                            <td><strong>@(string.IsNullOrWhiteSpace(row.UnitBloodType) ? "—" : row.UnitBloodType)</strong></td>
                            <td>@(string.IsNullOrWhiteSpace(row.StorageLocationName) ? "—" : row.StorageLocationName)</td>
                            <td>@(row.CurrentBloodType ?? "—")</td>
                            <td>@AntibodyCell(row.HasAntibodyHistory, row.AntibodySummary)</td>
                            <td>
                                @(row.LatestCrossmatchResult is CrossmatchResult readyXm ? readyXm.ToString() : "—")
                                @if (row.CrossmatchExpiresUtc is DateTime crossmatchExpires)
                                {
                                    <div class="muted">@crossmatchExpires.ToString("yyyy-MM-dd HH:mm")</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(row.ElectronicCrossmatchNotice)
                                    && ReadyToIssueAttentionRule.SharedElectronicCrossmatchNotice(_readyItems) is null)
                                {
                                    <div class="muted" data-ready-row-exm>@row.ElectronicCrossmatchNotice</div>
                                }
                            </td>
                            <td><span class="@Ui.Badge(row.DisplayStatus)">@Ui.StatusLabel(row.DisplayStatus)</span></td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(row.SpecimenAccession))
                                {
                                    <div class="mono">@row.SpecimenAccession</div>
                                }
                                @SpecimenExpiryCell(row.SpecimenExpiresUtc, row.SpecimenExpired)
                            </td>
                            <td class="right nowrap">
                                @if (row.IssueRequestedUtc is DateTime requestedAt)
                                {
                                    <span class="badge badge-blue" title="Requested @requestedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm") by @row.IssueRequestedBy" data-ready-requested>Requested → @row.IssueRequestedTo @ClockText.Short(requestedAt)</span>
                                }
                                @if (row.NeededByUtc is DateTime readyNeededBy)
                                {
                                    @* When the order this unit is reserved for is needed: red once passed, amber inside the facility's window. *@
                                    <span class="@(row.NeededByPassed ? "badge badge-red" : row.NeededBySoon ? "badge badge-amber" : "badge badge-gray")"
                                          title="Needed by @readyNeededBy.ToLocalTime().ToString("yyyy-MM-dd HH:mm") for order @row.OrderNumber" data-ready-needed-by>Needed @ClockText.Short(readyNeededBy)@(row.NeededByPassed ? " (passed)" : row.NeededInMinutes is int readyIn ? $" (in {readyIn} min)" : "")</span>
                                }
                                @if (row.ExpiresBeforeNeeded)
                                {
                                    <span class="badge badge-amber" title="The crossmatch or its specimen expires before the order is needed: issue before then, or draw a new specimen" data-ready-expires-before-needed>Expires before needed-by</span>
                                }
                                @if (row.OpenAntibodyWorkup)
                                {
                                    <span class="badge badge-amber" title="@row.OpenAntibodyWorkupNotice">Open ABID</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(row.ReactionNotice))
                                {
                                    <span class="badge badge-amber" title="@row.ReactionNotice">Reaction</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(row.DonationRestrictionNotice))
                                {
                                    <span class="badge badge-amber" title="@row.DonationRestrictionNotice">@row.DonationRestrictionNotice</span>
                                }
                                @if (row.ExpiresSoon)
                                {
                                    <span class="badge badge-amber">Expires soon</span>
                                }
                                @if (ReadyToIssueAttentionRule.ReservationLapsed(row, DateTime.UtcNow))
                                {
                                    <span class="badge badge-amber" title="The reservation was set to end at @row.ReservationExpiresUtc!.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm"). The unit stays held for this patient until it is issued or released." data-reservation-ended>Reservation ended @row.ReservationExpiresUtc!.Value.ToLocalTime().ToString("MM-dd HH:mm")</span>
                                }
                                @if (row.CrossmatchBlocksRoutineIssue)
                                {
                                    <span class="badge badge-red" title="@row.CrossmatchNotice">Crossmatch</span>
                                }
                                else if (!string.IsNullOrWhiteSpace(row.CrossmatchNotice))
                                {
                                    <span class="badge badge-amber" title="@row.CrossmatchNotice">XM incompatible</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(row.SpecialRequirementNotice))
                                {
                                    <span class="badge badge-red" title="@row.SpecialRequirementNotice">Special need</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(row.AntigenNotice))
                                {
                                    <span class="badge badge-amber" title="@row.AntigenNotice">Antigen</span>
                                }
                                @if (row.AboRhDiscrepancyBlocksIssue)
                                {
                                    <span class="badge badge-red" title="@row.AboRhDiscrepancyNotice">ABO discrepancy</span>
                                }
                                else if (!string.IsNullOrWhiteSpace(row.AboRhDiscrepancyNotice))
                                {
                                    <span class="badge badge-amber" title="@row.AboRhDiscrepancyNotice">ABO discrepancy</span>
                                }
                                @if (row.SpecimenBlocksIssue)
                                {
                                    <span class="badge badge-red" title="@row.SpecimenBlockReason">Specimen</span>
                                    <a class="btn btn-ghost btn-sm" href="@BloodOrderPreparationRule.CollectSpecimenHref(row.PatientId)" data-ready-new-specimen>New specimen</a>
                                    @if (row.PreSpecimenEmergencyAllowed && Session.Has(PermissionCodes.IssueEmergencyRelease))
                                    {
                                        <button type="button" class="btn btn-secondary btn-sm" title="@row.SpecimenBlockReason" @onclick="() => SelectEmergencyIssue(row)">Emergency</button>
                                    }
                                }
                                else if (row.UnitOutdated)
                                {
                                    <span class="badge badge-red" title="@row.UnitBlockReason">Outdated</span>
                                }
                                else if (!string.IsNullOrWhiteSpace(row.SpecialRequirementNotice))
                                {
                                }
                                else if (row.AboRhDiscrepancyBlocksIssue)
                                {
                                }
                                else if (row.NeedsSecondAbo || row.CrossmatchBlocksRoutineIssue)
                                {
                                    @if (row.NeedsSecondAbo)
                                    {
                                        <span class="badge badge-amber" title="@ReadyToIssueFormCue.SecondAbo">Second ABO</span>
                                        <a class="btn btn-ghost btn-sm" href="@($"/patients/{row.PatientId}?tab=tests")">Enter type</a>
                                    }
                                    @if (Session.Has(PermissionCodes.IssueEmergencyRelease))
                                    {
                                        <button type="button" class="btn btn-secondary btn-sm" @onclick="() => SelectEmergencyIssue(row)">Emergency</button>
                                    }
                                }
                                else
                                {
                                    <button type="button" class="btn btn-primary btn-sm" @onclick="() => SelectReadyToIssue(row)">Issue</button>
                                }
                                @if (ReadyToIssueAttentionRule.ReleaseReason(row, DateTime.UtcNow) is not null && Session.Has(PermissionCodes.CompatibilityAllocate))
                                {
                                    <button type="button" class="btn btn-ghost btn-sm" @onclick="() => BeginReleaseReady(row)">Release</button>
                                }
                            </td>
                        </tr>
                        @if (_releasingReadyId == row.AllocationId)
                        {
                            <tr>
                                <td colspan="10">
                                    <div class="alert alert-info" style="margin:.25rem 0;">
                                        <div class="muted">Release <span class="mono">@row.UnitNumber</span> from @(row.PatientDisplayName ?? "this patient") back to stock (@ReadyToIssueAttentionRule.ReleaseReason(row, DateTime.UtcNow)). If the patient still needs it, reserve it again from the chart.</div>
                                        <div class="flex gap" style="align-items:flex-end;flex-wrap:wrap;margin-top:.35rem;">
                                            <div class="field" style="flex:1;min-width:14rem;"><label>Reason</label><input @bind="_releaseReadyReason" @bind:event="oninput" placeholder="e.g. Reservation ended, transfusion not needed" /></div>
                                            <button type="button" class="btn btn-secondary btn-sm" disabled="@(_busy || string.IsNullOrWhiteSpace(_releaseReadyReason))" @onclick="() => ReleaseReadyAsync(row)">Release to stock</button>
                                            <button type="button" class="btn btn-ghost btn-sm" @onclick="() => _releasingReadyId = null">Cancel</button>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
            </div>
        }
    </div>
}

@if (Session.Has(PermissionCodes.IssueCreate) && _desk == "retro")
{
    <div class="bb-card">
        <div class="bb-card-title"><h3>Retrospective crossmatch due</h3></div>
        <p class="muted">Emergency and massive-transfusion issues stay here until a compatible crossmatch is recorded. An incompatible result is listed first and raises a critical alert.</p>
        @if (_retroItems.Count == 0)
        {
            <div class="muted">No retrospective crossmatches pending.</div>
        }
        else
        {
            <div class="table-scroll">
            <table class="bb">
                <thead>
                    <tr>
                        <th>Patient / MRN</th>
                        <th>Unit / product / expires</th>
                        <th>Unit / patient type</th>
                        <th>Antibodies</th>
                        <th>Specimen</th>
                        <th>Crossmatch / at issue</th>
                        <th>Issue details</th>
                        <th>Issued to</th>
                        <th>Issued / due</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _retroItems)
                    {
                        <tr>
                            <td><a href="@($"/patients/{row.PatientId}")">@(row.PatientDisplayName ?? $"Issue #{row.IssueId}")</a><span class="sub mono">@(row.MedicalRecordNumber ?? "—")</span></td>
                            <td>
                                <UnitLink Id="row.BloodUnitId" Number="@row.UnitNumber" />
                                <span class="sub">@(string.IsNullOrWhiteSpace(row.ProductName) ? "—" : row.ProductName)</span>
                                <span class="sub nowrap">@(row.UnitExpiresUtc is DateTime retroExpires ? retroExpires.ToString("yyyy-MM-dd HH:mm") : "—")</span>
                            </td>
                            <td class="nowrap">Unit <strong>@(string.IsNullOrWhiteSpace(row.UnitBloodType) ? "—" : row.UnitBloodType)</strong><span class="sub">Patient @(row.CurrentBloodType ?? "—")</span></td>
                            <td>@AntibodyCell(row.HasAntibodyHistory, row.AntibodySummary)</td>
                            <td>
                                @(row.AccessionNumber ?? "—")
                                <div>@SpecimenExpiryCell(row.SpecimenExpiresUtc, row.SpecimenExpired)</div>
                                @if (row.SpecimenId is null || row.SpecimenExpired)
                                {
                                    @* OCD-053: released before a usable specimen; the retrospective crossmatch needs one. *@
                                    <span class="badge badge-red">@(row.SpecimenId is null ? "No specimen on file: collect one" : "Specimen expired: collect a new one")</span>
                                    <a class="btn btn-ghost btn-sm" href="@BloodOrderPreparationRule.CollectSpecimenHref(row.PatientId)">Accession</a>
                                }
                            </td>
                            <td>
                                @(row.LatestCrossmatchResult is CrossmatchResult retroXm ? retroXm.ToString() : "—")
                                @if (row.CrossmatchExpiresUtc is DateTime retroXmExpires)
                                {
                                    <div class="muted">@retroXmExpires.ToString("yyyy-MM-dd HH:mm")</div>
                                }
                                @if (row.CrossmatchStatus == CrossmatchClinicalStatus.Incompatible)
                                {
                                    <span class="badge badge-red">Incompatible after release</span>
                                    <span class="sub">See the critical alert; record who was told when acknowledging it.</span>
                                }
                                else
                                {
                                    <span class="sub">At issue: @Words(row.CrossmatchStatus)</span>
                                }
                            </td>
                            <td>@IssueDetailsCell(row.IssueType.ToString(), row.EmergencyReleaseDetails, row.EmergencyReleaseAuthorizer, row.CoolerId, row.IssuedBy, row.SecondVerifier, row.IssueAppearance.ToString(), row.PtagCode)</td>
                            <td>@(string.IsNullOrWhiteSpace(row.IssuedToLocation) ? "—" : row.IssuedToLocation)<span class="sub">@(string.IsNullOrWhiteSpace(row.IssuedTo) ? "—" : row.IssuedTo)</span></td>
                            <td class="nowrap">
                                @row.IssuedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                                <span class="sub">Due @(row.DueUtc?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "—")</span>
                                @if (row.IsOverdue)
                                {
                                    <span class="badge badge-amber">Overdue</span>
                                }
                            </td>
                            <td class="right nowrap">
                                @if (Session.Has(PermissionCodes.CompatibilityCrossmatch))
                                {
                                    <a class="btn btn-primary btn-sm" href="@RetroXmHref(row)">Record crossmatch</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        }
    </div>
}

@if (Session.Has(PermissionCodes.IssueCreate) && _desk == "transit")
{
    <div class="bb-card">
