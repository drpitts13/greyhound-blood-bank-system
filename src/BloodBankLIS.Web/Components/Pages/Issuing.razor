                            <td>
                                @if (Session.Has(PermissionCodes.TransfusionDocument))
                                {
                                    <button type="button" class="btn btn-ghost btn-sm" @onclick="() => SelectWardIssue(row.IssueId, row.ProductName, row.UnitExpiresUtc, row.UnitBloodType, row.SpecimenAccession, row.CrossmatchExpiresUtc, row.LatestCrossmatchResult, row.IssuedTo, row.CoolerId, row.IssuedToLocation, row.IssuedBy, row.EmergencyReleaseDetails, row.SecondVerifier, row.EmergencyReleaseAuthorizer, row.IssueAppearance, row.PtagCode, row.CrossmatchStatus)">Receive</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        }
    </div>
}

@if ((Session.Has(PermissionCodes.IssueCreate) || Session.Has(PermissionCodes.IssueReturn) || Session.Has(PermissionCodes.TransfusionDocument)) && _desk == "issued")
{
    <div class="bb-card">
        <div class="bb-card-title"><h3>Issued units</h3></div>
        <p class="muted">Units still issued, including after ward receipt. Return, Receive, and Document on the row open the matching form.</p>
        @if (_outstandingItems.Count(r => r.TransfusionCompletionOverdue) is var completionOverdue and > 0)
        {
            <div class="alert alert-warning" data-completion-overdue>@(completionOverdue == 1 ? "1 transfusion was" : $"{completionOverdue} transfusions were") started and not completed within the facility's reminder hours. @(completionOverdue == 1 ? "It is" : "They are") listed first: record the stop time, volume, and outcome with <strong>Complete</strong>, or check whether @(completionOverdue == 1 ? "it is" : "they are") still running.</div>
        }
        @if (_outstandingItems.Count == 0)
        {
            <div class="muted">No outstanding issued units.</div>
        }
        else
        {
            <div class="table-scroll">
            <table class="bb">
                <thead>
                    <tr>
                        <th>Patient / MRN</th>
                        <th>Unit / product / expires</th>
                        <th>Unit / patient type</th>
                        <th>Antibodies</th>
                        <th>Specimen</th>
                        <th>Crossmatch / at issue</th>
                        <th>Issue details</th>
                        <th>Ward receipt</th>
                        <th>Issued to</th>
                        <th>Issued / time out</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _outstandingItems)
                    {
                        <tr>
                            <td><a href="@($"/patients/{row.PatientId}")">@(row.PatientDisplayName ?? $"Issue #{row.IssueId}")</a><span class="sub mono">@(row.MedicalRecordNumber ?? "—")</span>
                                @if (row.IssuedUnderEarlierMrn is { } earlierMrn)
                                {
                                    <span class="badge badge-amber" data-issued-under-earlier title="The wristband or unit tag may still show the earlier MRN">Issued under @earlierMrn</span>
                                }
                            </td>
                            <td>
                                <UnitLink Id="row.BloodUnitId" Number="@row.UnitNumber" />
                                <span class="sub">@(string.IsNullOrWhiteSpace(row.ProductName) ? "—" : row.ProductName)</span>
                                <span class="sub nowrap">@(row.UnitExpiresUtc is DateTime issuedExpires ? issuedExpires.ToString("yyyy-MM-dd HH:mm") : "—")</span>
                            </td>
                            <td class="nowrap">Unit <strong>@(string.IsNullOrWhiteSpace(row.UnitBloodType) ? "—" : row.UnitBloodType)</strong><span class="sub">Patient @(row.CurrentBloodType ?? "—")</span></td>
                            <td>@AntibodyCell(row.HasAntibodyHistory, row.AntibodySummary)</td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(row.SpecimenAccession))
                                {
                                    <div class="mono">@row.SpecimenAccession</div>
                                }
                                @SpecimenExpiryCell(row.SpecimenExpiresUtc, row.SpecimenExpired)
                            </td>
                            <td>
                                @(row.LatestCrossmatchResult is CrossmatchResult issuedXm ? issuedXm.ToString() : "—")
                                @if (row.CrossmatchExpiresUtc is DateTime issuedXmExpires)
                                {
                                    <div class="muted">@issuedXmExpires.ToString("yyyy-MM-dd HH:mm")</div>
                                }
                                <span class="sub">@CrossmatchStatusLine(row.CrossmatchStatus)</span>
                            </td>
                            <td>@IssueDetailsCell(row.IssueType.ToString(), row.EmergencyReleaseDetails, row.EmergencyReleaseAuthorizer, row.CoolerId, row.IssuedBy, row.SecondVerifier, row.IssueAppearance.ToString(), row.PtagCode)</td>
                            <td>
                                @if (row.WardReceivedUtc is DateTime received)
                                {
                                    <span>@received.ToString("yyyy-MM-dd HH:mm") @(row.WardReceivedBy ?? "")</span>
                                }
                                else
                                {
                                    <span class="muted">Awaiting</span>
                                }
                                <span class="sub">Appearance: @(string.IsNullOrWhiteSpace(row.WardAppearance) ? "—" : row.WardAppearance)</span>
                            </td>
                            <td>@(string.IsNullOrWhiteSpace(row.IssuedToLocation) ? "—" : row.IssuedToLocation)<span class="sub">@(string.IsNullOrWhiteSpace(row.IssuedTo) ? "—" : row.IssuedTo)</span></td>
                            <td>
                                <span class="nowrap">@row.IssuedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                                @if (row.TransfusionStartedUtc is DateTime transfusingSince)
                                {
                                    <span class="badge @(row.TransfusionCompletionOverdue ? "badge-red" : "badge-amber")">Transfusing since @ClockText.Short(transfusingSince)@(row.TransfusionCompletionOverdue ? " · completion overdue" : "")</span>
                                }
                                else
                                {
                                    <span class="sub">@ReturnReissueRule.TimeOutLabel(row.StorageTimeOutGoverned, row.StorageTimeOutAcceptable)</span>
                                }
                            </td>
                            <td class="right nowrap">
                                @if (IssueRun.NextStepForIssued(row) == IssuedNextStep.ReceiveOnWard && Session.Has(PermissionCodes.TransfusionDocument))
                                {
                                    <button type="button" class="btn btn-ghost btn-sm" @onclick="() => SelectWardIssue(row.IssueId, row.ProductName, row.UnitExpiresUtc, row.UnitBloodType, row.SpecimenAccession, row.CrossmatchExpiresUtc, row.LatestCrossmatchResult, row.IssuedTo, row.CoolerId, row.IssuedToLocation, row.IssuedBy, row.EmergencyReleaseDetails, row.SecondVerifier, row.EmergencyReleaseAuthorizer, row.IssueAppearance, row.PtagCode, row.CrossmatchStatus)">Receive</button>
                                }
                                @if (Session.Has(PermissionCodes.IssueReturn) && row.TransfusionStartedUtc is null)
                                {
                                    <button type="button" class="btn btn-secondary btn-sm" @onclick="() => SelectReturnIssue(row)">Return</button>
                                }
                                @if (IssueRun.NextStepForIssued(row) != IssuedNextStep.ReceiveOnWard && CanRecordTransfusion)
                                {
                                    <button type="button" class="btn btn-primary btn-sm" @onclick="() => SelectTransfusionIssue(row)">@(row.TransfusionStartedUtc is null ? "Start / document" : "Complete")</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        }
    </div>
}

@if ((Session.Has(PermissionCodes.IssueCreate) || Session.Has(PermissionCodes.IssueReturn) || Session.Has(PermissionCodes.TransfusionDocument)) && _desk == "disposition")
{
    <div class="bb-card">
        <div class="bb-card-title"><h3>Overdue final disposition</h3></div>
        <p class="muted">Issued units past the facility window with no transfusion document, return, or discard. The default window is 24 hours. This board warns. It does not block issue or documentation.</p>
        @if (_dispositionItems.Count > 0)
        {
            <blockquote>Warning. These units are past the final-disposition window.</blockquote>
        }
        @if (_dispositionItems.Count == 0)
        {
            <div class="muted">No issued units are past the final-disposition window.</div>
        }
        else
        {
            <div class="table-scroll">
            <table class="bb">
                <thead><tr><th>Unit</th><th>Patient</th><th>Issued</th><th>Due</th><th></th></tr></thead>
                <tbody>
                    @foreach (var row in _dispositionItems)
                    {
                        @* The next step from the row, as on Issued units, so the unit is not looked up again (Cycle 611). *@
                        var issued = _outstandingItems.FirstOrDefault(i => i.IssueId == row.IssueId);
                        <tr data-disposition-row="@row.IssueId">
                            <td class="mono"><a href="@InventoryUrls.Unit(row.UnitId)">@row.UnitNumber</a></td>
                            <td>@row.PatientLabel</td>
                            <td>@row.IssuedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@row.DueUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm") <span class="muted" data-past-due>@AlertInboxView.OpenFor(row.DueUtc, DateTime.UtcNow) past due</span></td>
                            <td class="right nowrap">
                                @if (issued is not null)
                                {
                                    @if (IssueRun.NextStepForIssued(issued) == IssuedNextStep.ReceiveOnWard && Session.Has(PermissionCodes.TransfusionDocument))
                                    {
                                        <button type="button" class="btn btn-ghost btn-sm" @onclick="() => SelectWardIssue(issued.IssueId, issued.ProductName, issued.UnitExpiresUtc, issued.UnitBloodType, issued.SpecimenAccession, issued.CrossmatchExpiresUtc, issued.LatestCrossmatchResult, issued.IssuedTo, issued.CoolerId, issued.IssuedToLocation, issued.IssuedBy, issued.EmergencyReleaseDetails, issued.SecondVerifier, issued.EmergencyReleaseAuthorizer, issued.IssueAppearance, issued.PtagCode, issued.CrossmatchStatus)">Receive</button>
                                    }
                                    @if (Session.Has(PermissionCodes.IssueReturn) && issued.TransfusionStartedUtc is null)
                                    {
                                        <button type="button" class="btn btn-secondary btn-sm" @onclick="() => SelectReturnIssue(issued)">Return</button>
                                    }
                                    @if (IssueRun.NextStepForIssued(issued) != IssuedNextStep.ReceiveOnWard && CanRecordTransfusion)
                                    {
                                        <button type="button" class="btn btn-primary btn-sm" @onclick="() => SelectTransfusionIssue(issued)">@(issued.TransfusionStartedUtc is null ? "Document transfusion" : "Complete")</button>
                                    }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        }
    </div>
}

@if (_desk == "issue")
{
<div class="bb-card" @ref="_issueForm" tabindex="-1" data-enter-flow>
    <div class="bb-card-title"><h3>Issue a unit</h3></div>
    @if (!Session.Has(PermissionCodes.IssueCreate))
    {
        <div class="muted">You do not have permission to issue units.</div>
    }
    else
    {
        <Outcome Value="_issueFb" RequiresSignature="true" />
        @if (Session.Has(PermissionCodes.IssueDowntimeBackEntry))
        {
            @* OCD-054: an issue made on paper during downtime, judged as of the paper record's time. *@
            <label class="flex" style="margin-bottom:.5rem;"><input type="checkbox" @bind="_issue.DowntimeBackEntry" @bind:after="OnBackEntryToggled" />&nbsp;Downtime back-entry from a paper issue record</label>
            @if (_issue.DowntimeBackEntry)
            {
                <div class="alert alert-info">
                    Expiration is checked as of the time on the paper record, so a unit or specimen that has expired since can be entered. Every other check still applies. Type the unit number from the paper record in place of a scan.
                </div>
                <div class="form-row">
                    <div class="field"><label>Issued at (from paper record)</label>
                        <input type="datetime-local" @bind="_issue.BackEntryLocalTime" />
                    </div>
                    <div class="field"><label>Unit number on the paper record</label>
                        <input @bind="_issue.BackEntryDin" autocomplete="off" placeholder="DIN as written on the record" />
                    </div>
                    <div class="field"><label>Reason</label>
                        <input @bind="_issue.LateEntryReason" placeholder="e.g. Issued on paper during LIS downtime" />
                    </div>
                </div>
            }
        }
        <div class="form-row">
            <div class="field"><label>Unit number</label>
                <UnitPickerComboBox @key="_issue.DowntimeBackEntry" Scope="@(_issue.DowntimeBackEntry ? UnitPickerScope.DowntimeBackEntry : UnitPickerScope.Issuable)" @bind-Value="_issue.BloodUnitId" @bind-Value:after="OnIssueUnitPickedAsync" />
                @if (!string.IsNullOrWhiteSpace(_issueUnitNotice))
                {
                    <div class="muted" style="color:var(--bb-danger, #a12);" data-unit-reserved-for>@_issueUnitNotice</div>
                }
            </div>
            <div class="field"><label>Patient</label>
                <FilterableComboBox TItem="PatientDto" TValue="long?"
                    Items="_patients"
                    @bind-Value="IssuePatientId"
                    @bind-Value:after="OnIssuePatientChangedAsync"
                    DisplayText="@(p => p.PickerLabel)"
                    ItemValue="@(p => p.Id)"
                    SearchText="@(p => $"{p.LastName} {p.FirstName} {p.MedicalRecordNumber}")"
                    Clearable="true"
                    Placeholder="Search MRN or name" />
                @if (CanRegisterUnidentified && !_showUnidentified)
                {
                    <button type="button" class="btn btn-ghost btn-sm" @onclick="() => _showUnidentified = true" data-issue-unidentified
                            title="Emergency patient without identification: register with a temporary MRN and choose them here">Unidentified patient…</button>
                }
            </div>
            <div class="field"><label>Issued to (person)</label><input @bind="_issue.IssuedTo" /></div>
            <div class="field"><label>Issued to (location)</label><input @bind="_issue.IssuedToLocation" @bind:event="oninput" />
                @if (string.IsNullOrWhiteSpace(_issue.IssuedToLocation) && _prefilledRow?.PatientVisitLocation is { Length: > 0 } visitLocation && _prefilledRow.BloodUnitId == _issue.BloodUnitId)
                {
                    <div class="sub" data-visit-location>
                        Patient's visit: @visitLocation
                        <button type="button" class="btn btn-ghost btn-sm" @onclick="() => _issue.IssuedToLocation = visitLocation" title="Confirm the patient is still there; a visit location can lag behind a move to theatre or imaging">Use it</button>
                    </div>
                }
            </div>
            <div class="field"><label>Cooler / transport id</label><input @bind="_issue.CoolerId" placeholder="Optional cooler checkout" /></div>
            <div class="field"><label>Issue type</label>
                <select @bind="_issue.IssueType">@foreach (var t in AllowedIssueTypes) { <option value="@t">@Ui.EnumText(t)</option> }</select>
            </div>
        </div>
        @if (_showUnidentified)
        {
            <UnidentifiedPatientRegister OnRegistered="UseUnidentifiedAsync" OnCancel="() => _showUnidentified = false" />
        }
        <div class="form-row">
            <div class="field"><label>Patient ID 1 (MRN)</label>
                <input @bind="_issue.PatientIdentifier1Value" @bind:event="oninput" autocomplete="off" placeholder="Scan wristband or type" data-enter-step />
                <IdentifierMatchHint Type="IdentityTokenType.MedicalRecordNumber" Value="@_issue.PatientIdentifier1Value" Patient="IssuePatient" />
            </div>
            <div class="field"><label>Patient ID 2 (DOB yyyy-MM-dd)</label>
                <input @bind="_issue.PatientIdentifier2Value" @bind:event="oninput" autocomplete="off" placeholder="From wristband or requisition" data-enter-step />
                <IdentifierMatchHint Type="IdentityTokenType.DateOfBirth" Value="@_issue.PatientIdentifier2Value" Patient="IssuePatient" />
            </div>
            <div class="field"><label>Second verifier</label>
                <FilterableComboBox TItem="DirectoryUserDto" TValue="string?"
                    Items="SecondVerifierChoices"
                    @bind-Value="_issue.SecondVerifier"
                    DisplayText="@(u => u.Label)"
                    ItemValue="@(u => u.UserName)"
                    SearchText="@(u => u.Label)"
                    Clearable="true"
                    Placeholder="Different active user" />
            </div>
        </div>
        @if (_issue.IssueType == IssueType.MassiveTransfusion && _issue.PatientId > 0)
        {
            @if (IssueMtp is { } activeMtp)
            {
                <div class="alert alert-info" style="margin-top:.5rem;">
                    Issuing under <strong>MTP #@activeMtp.Id</strong>, active @activeMtp.MinutesActive min, called by @activeMtp.RequestedBy: @activeMtp.Reason.
                    <button type="button" class="btn btn-sm btn-ghost" @onclick="() => UseMtpReason(activeMtp)">Use as override reason</button>
                </div>
            }
            else
            {
                <div class="alert alert-warning" style="margin-top:.5rem;">
                    <strong>No massive transfusion protocol is active for this patient.</strong>
                    Record who called it and why before issuing under MTP.
                    @if (Session.Has(PermissionCodes.IssueEmergencyRelease))
                    {
                        <div class="form-row" style="margin-top:.5rem;">
                            <div class="field"><label>Called by (clinician)</label><input @bind="_mtpRequestedBy" placeholder="e.g. Dr. Rivera, trauma" /></div>
                            <div class="field"><label>Reason</label><input @bind="_mtpReason" placeholder="e.g. Hemorrhagic shock" /></div>
                            <div class="field"><label>Location</label><input @bind="_mtpLocation" placeholder="Optional, e.g. ED trauma 1" /></div>
                            @if (_mtpPacks.Count > 0)
                            {
                                <div class="field"><label>Pack (optional)</label>
                                    <select @bind="_mtpPackId">
                                        <option value="">No pack</option>
                                        @foreach (var pk in _mtpPacks)
                                        {
                                            <option value="@pk.Id">@pk.Name (@pk.Summary)</option>
                                        }
                                    </select>
                                </div>
                            }
                        </div>
                        <button type="button" class="btn btn-sm btn-danger" disabled="@_busy" @onclick="ActivateMtpAsync">Activate MTP</button>
                    }
                    <Outcome Value="_mtpFb" />
                </div>
            }
        }
        <div class="flex gap" style="flex-wrap:wrap;margin:.5rem 0 1rem;">
            <AppearanceSelect Label="Appearance at issue" Style="min-width:14rem;" @bind-Value="_issue.Appearance" />
        </div>
        @if (!_issue.DowntimeBackEntry)
        {
            <UnitScanVerificationPanel Scan="_issueScan" />
        }
        @if (_ptagRequired)
        {
            <div class="alert alert-warning" style="margin-top:.75rem;">
                <strong>P-tag ID</strong>
                <p class="muted">Print the compatibility tag, then scan the P-tag ID before issuing.</p>
                <div class="flex gap" style="flex-wrap:wrap;align-items:end;">
                    @if (Session.Has(PermissionCodes.PrintLabel))
                    {
                        <button type="button" class="btn btn-secondary btn-sm" disabled="@(_busy || _issue.BloodUnitId is null || _issue.PatientId <= 0)" @onclick="PrintPreparedPtagAsync">Print P-tag</button>
                    }
                    <div class="field" style="min-width:14rem;margin:0;">
                        <label>Scanned P-tag ID</label>
                        <input @bind="_ptagScan" @bind:event="oninput" autocomplete="off" />
                    </div>
                    @if (_ptagJobId is long preparedJob)
                    {
                        <a class="btn btn-ghost btn-sm" href="@($"/printing?jobId={preparedJob}")">Open preview</a>
                    }
                </div>
                <Outcome Value="_ptagFb" />
            </div>
        }
        @if (PrefillNotices.Count > 0)
        {
            <div class="alert alert-warning">
                <strong>This reserved unit</strong>
                <ul>
                    @foreach (var notice in PrefillNotices)
                    {
                        <li>@notice</li>
                    }
                </ul>
            </div>
        }
        @foreach (var info in _issueInfoRequirements)
        {
            <div class="alert alert-info" style="margin-top:.75rem;" data-special-requirement-banner>
                <strong>@(info.Name ?? info.Code):</strong> @(info.Instruction ?? info.Reason)
            </div>
        }
        @if (_issueAckRequirements.Count > 0)
        {
            <div class="alert alert-warning" style="margin-top:.75rem;">
                <strong>Acknowledge special requirements</strong>
                @foreach (var req in _issueAckRequirements)
                {
                    <label class="flex" style="gap:.35rem;margin-top:.35rem;">
                        <input type="checkbox" checked="@_issueAcks.Contains(req.Code ?? "")" @onchange="e => ToggleIssueAck(req.Code, (bool)(e.Value ?? false))" />
                        @(req.Name ?? req.Code) @(string.IsNullOrWhiteSpace(req.Instruction) ? "" : $"— {req.Instruction}")
                    </label>
                }
            </div>
        }

        <div class="alert alert-warning">
            <label class="flex"><input type="checkbox" @bind="_overrideOn" /> &nbsp;<strong>Override</strong> (emergency release / warning override)</label>
            @if (_overrideOn)
            {
                <div class="form-row" style="margin-top:.5rem;">
                    <div class="field"><label>Override reason</label><input @bind="_overrideReason" /></div>
                    <AuthorizerField @bind-Value="_authorizedBy" />
                    <div class="field"><label>Meaning of signature</label><input @bind="_signatureMeaning" placeholder="e.g. I authorize emergency release" /></div>
                    <div class="field"><label>Password / PIN</label><input type="password" @bind="_signatureSecret" /></div>
                </div>
            }
        </div>

        @if (_overrideOn)
        {
            <button class="btn btn-danger" disabled="@(_busy || _issue.BloodUnitId is null || _issue.PatientId <= 0 || PtagScanMissing)" @onclick="IssueWithOverrideAsync">Sign &amp; issue (override)</button>
        }
        else
        {
            <button class="btn btn-primary" disabled="@(_busy || _issue.BloodUnitId is null || _issue.PatientId <= 0 || PtagScanMissing)" @onclick="IssueAsync">Issue unit</button>
        }

        @if (_issue.PatientId > 0 && (_issuedThisRun.Count > 0 || NextInRun.Count > 0))
        {
            @* Several units for one patient: the form keeps the patient, identifiers, destination, and cooler. *@
            <div class="bb-card" style="margin-top:1rem;" data-issue-run>
                <div class="bb-card-title"><h3>This patient's units</h3></div>
                @if (_issuedThisRun.Count > 0)
                {
                    <div><strong>Issued now (@_issuedThisRun.Count)</strong></div>
                    <div class="table-scroll">
                    <table class="bb">
                        <thead><tr><th>Unit</th><th>Product</th><th>To</th><th>Cooler</th><th>Issued</th></tr></thead>
                        <tbody>
                            @foreach (var done in _issuedThisRun)
                            {
                                <tr>
                                    <td class="mono">@done.UnitNumber</td>
                                    <td>@done.ProductName</td>
                                    <td>@done.Destination</td>
                                    <td class="mono">@done.CoolerId</td>
                                    <td class="nowrap">@done.IssuedLocal.ToString("HH:mm")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    </div>
                    @foreach (var cooler in _issuedThisRun.Select(d => d.CoolerId?.Trim()).Where(c => !string.IsNullOrEmpty(c)).Distinct(StringComparer.OrdinalIgnoreCase))
                    {
                        <a class="btn btn-ghost btn-sm" style="margin-top:.5rem;" href="@($"/issuing/cooler-check?cooler={Uri.EscapeDataString(cooler!)}")" data-cooler-check-run>Check cooler @cooler before it leaves</a>
                    }
                }
                @if (NextInRun.Count > 0)
                {
                    <div style="margin-top:.5rem;"><strong>Ready next</strong> <span class="muted">Patient, identifiers, destination, and cooler stay filled in. Scan the next unit and record its appearance.</span></div>
                    <div class="flex gap" style="flex-wrap:wrap;margin-top:.35rem;">
                        @foreach (var next in NextInRun)
                        {
                            var row = next;
                            <button type="button" class="btn @(row == NextInRun[0] ? "btn-primary" : "btn-secondary") btn-sm" disabled="@_busy" @onclick="() => IssueNextInRunAsync(row)">
                                Issue next: <span class="mono">@row.UnitNumber</span> @row.ProductName
                            </button>
                        }
                    </div>
                }
                else if (_issuedThisRun.Count > 0)
                {
                    <div class="muted" style="margin-top:.5rem;">No other reserved unit for this patient is ready for routine issue.</div>
                }
                @if (HeldBackInRun > 0)
                {
                    <div class="muted" style="margin-top:.35rem;">@HeldBackInRun other reserved unit(s) for this patient need attention first; see Ready to issue.</div>
                }
            </div>
        }

        @if (_lastIssue is not null)
        {
            <div class="alert alert-success" style="margin-top:1rem;">
                Issue <strong>#@_lastIssue.Id</strong> created for unit @_lastIssue.BloodUnitId &middot; <span class="badge badge-amber">@Ui.EnumText(_lastIssue.Status)</span>
                <div class="flex gap" style="margin-top:.65rem;flex-wrap:wrap;">
                    @if (Session.Has(PermissionCodes.PrintLabel))
                    {
                        <button type="button" class="btn btn-primary btn-sm" disabled="@_busy" @onclick="PrintLastIssuePtagAsync">Print P-tag</button>
                    }
                    <a class="btn btn-secondary btn-sm" href="@PtagPrintHref()">Open Printing</a>
                    <a class="btn btn-ghost btn-sm" href="@($"/patients/{_lastIssue.PatientId}?tab=products")">Open chart · Products</a>
                </div>
                <Outcome Value="_ptagFb" />
            </div>
        }
    }
</div>
}

@if (_desk == "receipt")
{
<div class="bb-card" tabindex="-1" data-enter-flow>
    <div class="bb-card-title"><h3>Ward receipt</h3></div>
    <p class="muted">The receiving location must acknowledge custody before transfusion can be documented (SoftBank remote-issue receipt).</p>
    @if (!Session.Has(PermissionCodes.TransfusionDocument))
    {
        <div class="muted">No permission to record ward receipt.</div>
    }
    else
    {
        <Outcome Value="_wardFb" />
        <div class="form-row">
            <div class="field"><label>Unit number</label><input class="mono" @ref="_wardUnitInput" @bind="_wardUnitLookup" @bind:after="LookUpWardUnitAsync" data-desk-unit="receipt" placeholder="Type or scan, or Receive from a list" data-enter-step autocomplete="off" /></div>
            <div class="field"><label>Received by</label><input @bind="_wardReceivedBy" placeholder="Nurse / ward staff" data-enter-step /></div>
            <AppearanceSelect Label="Appearance at receipt" @bind-Value="_wardAppearance" />
        </div>
        <UnitScanVerificationPanel Scan="_wardScan"
            Title="Ward receipt scan"
            Help="Scan the unit label at the receiving location. Required for ISBT-labeled units (SoftBank remote-issue chain)." />
        <PaperRecordDinField @bind-Value="_wardBackEntryDin" TimeLabel="Received at (from paper record)" @bind-Time="_wardBackEntryTime" />
        <div class="flex gap" style="margin-top:.75rem;">
            <button class="btn btn-primary btn-sm" disabled="@(_busy || _wardIssueId == 0)" @onclick="RecordWardReceiptAsync" data-ward-submit>Acknowledge receipt</button>
            <button class="btn btn-ghost btn-sm" disabled="@(_busy || _wardIssueId == 0)" @onclick="LoadIssueAsync">Check status</button>
        </div>
        @if (!string.IsNullOrWhiteSpace(_wardProductName) || !string.IsNullOrWhiteSpace(_wardExpirationNotice) || !string.IsNullOrWhiteSpace(_wardUnitTypeNotice) || !string.IsNullOrWhiteSpace(_wardSpecimenNotice) || !string.IsNullOrWhiteSpace(_wardCrossmatchNotice) || !string.IsNullOrWhiteSpace(_wardIssuedToNotice) || !string.IsNullOrWhiteSpace(_wardCoolerNotice) || !string.IsNullOrWhiteSpace(_wardLocationNotice) || !string.IsNullOrWhiteSpace(_wardIssuedByNotice) || !string.IsNullOrWhiteSpace(_wardSecondVerifierNotice))
        {
            <FactList Facts="@(new string?[] { _wardExpirationNotice, _wardUnitTypeNotice, _wardSpecimenNotice, _wardCrossmatchNotice, _wardIssuedToNotice, _wardCoolerNotice, _wardLocationNotice, _wardIssuedByNotice, _wardSecondVerifierNotice })" Style="margin-top:.75rem;">Receiving @if (!string.IsNullOrWhiteSpace(_wardProductName)) { <strong>@_wardProductName</strong> }</FactList>
        }
        @if (_wardReceivedRun.Count > 0 || NextToReceive.Count > 0)
        {
            @* A cooler or several units for one patient: received by stays; each unit is still scanned and inspected. *@
            <div class="bb-card" style="margin-top:1rem;" data-receipt-run>
                <div class="bb-card-title"><h3>@ReceiptRunTitle</h3></div>
                @if (_wardReceivedRun.Count > 0)
                {
                <div class="table-scroll">
                <table class="bb">
                    <thead><tr><th>Unit</th><th>Product</th><th>Received by</th><th>Received</th></tr></thead>
                    <tbody>
                        @foreach (var done in _wardReceivedRun)
                        {
                            <tr>
                                <td class="mono">@done.UnitNumber</td>
                                <td>@done.ProductName</td>
                                <td>@done.ReceivedBy</td>
                                <td class="nowrap">@done.ReceivedLocal.ToString("HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
                }
                @if (NextToReceive.Count > 0)
                {
                    <div style="margin-top:.5rem;"><strong>Still to receive (@NextToReceive.Count)</strong> <span class="muted">Received by stays filled in. Scan each unit and record its appearance.</span></div>
                    <div class="flex gap" style="flex-wrap:wrap;margin-top:.35rem;">
                        @foreach (var next in NextToReceive)
                        {
                            var row = next;
                            <button type="button" class="btn @(row == NextToReceive[0] ? "btn-primary" : "btn-secondary") btn-sm" disabled="@_busy" @onclick="() => ReceiveNext(row)">
                                Receive next: <span class="mono">@row.UnitNumber</span> @row.ProductName
                            </button>
                        }
                    </div>
                }
                else
                {
                    <div class="muted" style="margin-top:.5rem;">Every unit that went out with these has been received.</div>
                }
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(_wardReleaseReason))
        {
            <p class="muted">@_wardReleaseReason</p>
        }
        @if (!string.IsNullOrWhiteSpace(_wardReleaseAuthorizer))
        {
            <p class="muted">@_wardReleaseAuthorizer</p>
        }
        @if (!string.IsNullOrWhiteSpace(_wardIssueAppearance))
        {
            <p class="muted">@_wardIssueAppearance</p>
        }
        @if (!string.IsNullOrWhiteSpace(_wardPtagNotice))
        {
            <p class="muted">@_wardPtagNotice</p>
        }
        @if (!string.IsNullOrWhiteSpace(_wardCrossmatchStatusNotice))
        {
            <p class="muted">@_wardCrossmatchStatusNotice</p>
        }
        @if (_wardIssue is not null)
        {
            <p class="muted" style="margin-top:.75rem;">
                Issue <strong>@_wardIssue.Id</strong> · @_wardIssue.Status
                @if (_wardIssue.WardReceivedUtc is not null)
                {
                    <span> · received @_wardIssue.WardReceivedUtc.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm") by @_wardIssue.WardReceivedBy · @_wardIssue.WardAppearance</span>
                }
                else
                {
                    <span> · awaiting ward receipt</span>
                }
                <span> · </span>
                <a href="@($"/patients/{_wardIssue.PatientId}?tab=products")">Open chart · Products</a>
                <span> · </span>
                <a href="@InventoryUrls.Unit(_wardIssue.BloodUnitId)">Open Inventory</a>
            </p>
        }
    }
</div>
}

@if (_desk == "return")
{
    <div class="bb-card">
        <div class="bb-card-title"><h3>Return a unit</h3></div>
        @if (!Session.Has(PermissionCodes.IssueReturn))
        {
            <div class="muted">No permission to return units.</div>
        }
        else
        {
            <Outcome Value="_returnFb" />
            <div class="form-row">
                <div class="field"><label>Unit number</label><input class="mono" @ref="_returnUnitInput" @bind="_returnUnitLookup" @bind:after="LookUpReturnUnitAsync" data-desk-unit="return" placeholder="Type or scan, or Return from Issued units" /></div>
                <div class="field"><label>Reason</label><input @bind="_returnReason" @bind:event="oninput" /></div>
                <div class="field"><label>Destination</label>
                    <select @bind="_returnDestination">
                        @if (ReturnCanBeAvailable)
                        {
                            <option value="@UnitStatus.Available">Available</option>
                        }
                        <option value="@UnitStatus.Quarantine">Quarantine</option>
                    </select>
                </div>
                @if (_returnUnitNumber is not null)
                {
                    <FactList Facts="@(new string?[] { _returnProductName, _returnExpirationNotice, _returnUnitTypeNotice, _returnSpecimenNotice, _returnCrossmatchNotice, _returnIssuedToNotice, _returnCoolerNotice, _returnLocationNotice, _returnIssuedByNotice, _returnSecondVerifierNotice, _returnPatientName })">Returning <span class="mono">@_returnUnitNumber</span></FactList>
                    @if (!string.IsNullOrWhiteSpace(_returnReleaseReason))
                    {
                        <p class="muted" style="margin:0;">@_returnReleaseReason</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(_returnReleaseAuthorizer))
                    {
                        <p class="muted" style="margin:0;">@_returnReleaseAuthorizer</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(_returnIssueAppearance))
                    {
                        <p class="muted" style="margin:0;">@_returnIssueAppearance</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(_returnPtagNotice))
                    {
                        <p class="muted" style="margin:0;">@_returnPtagNotice</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(_returnCrossmatchStatusNotice))
                    {
                        <p class="muted" style="margin:0;">@_returnCrossmatchStatusNotice</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(_returnTimeOutNotice))
                    {
                        <p class="muted" style="margin:0;">@_returnTimeOutNotice</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(_returnWardAppearance))
                    {
                        <p class="muted" style="margin:0;">@_returnWardAppearance</p>
                    }
                }
            </div>
            <p class="muted">Record temperature, seal, and visual inspection. A failed seal or appearance cannot return to available stock. A unit to be thrown away goes to Quarantine; discard it on the unit page with a discard reason. The storage device decides the return-to-available window. A governed device cannot be declared acceptable after that window. An exempt device does not fail the window.</p>
            <InspectionAnswer Label="Temperature" @bind-Value="_returnTempOk" @bind-Value:after="SyncReturnDestination" />
            <InspectionAnswer Label="Seal" YesText="Intact" NoText="Broken" @bind-Value="_returnSealOk" @bind-Value:after="SyncReturnDestination" />
            <InspectionAnswer Label="Visual inspection" @bind-Value="_returnVisualOk" @bind-Value:after="SyncReturnDestination" />
            @if (ReturnInspectionMissing)
            {
                <p class="muted">Answer all three inspections before the unit can go back to available stock. Choose Quarantine to return it without them.</p>
            }
            <button class="btn btn-secondary" disabled="@(_busy || _returnIssueId == 0 || string.IsNullOrWhiteSpace(_returnReason) || ReturnInspectionMissing)" @onclick="ReturnAsync" data-return-submit>Return unit</button>
            @if (_returnRun.Count > 0 || NextToReturn.Count > 0)
            {
                @* A cooler coming back: the reason stays; each unit is still inspected on its own. *@
                <div class="bb-card" style="margin-top:1rem;" data-return-run>
                    <div class="bb-card-title"><h3>@ReturnRunTitle</h3></div>
                    @if (_returnRun.Count > 0)
                    {
                        <div class="table-scroll">
                        <table class="bb">
                            <thead><tr><th>Unit</th><th>Product</th><th>Returned to</th><th>Returned</th></tr></thead>
                            <tbody>
                                @foreach (var done in _returnRun)
                                {
                                    <tr>
                                        <td class="mono">@done.UnitNumber</td>
                                        <td>@done.ProductName</td>
                                        <td>@done.Destination</td>
                                        <td class="nowrap">@done.ReturnedLocal.ToString("HH:mm")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        </div>
                    }
                    @if (NextToReturn.Count > 0)
                    {
                        <div style="margin-top:.5rem;"><strong>Still out (@NextToReturn.Count)</strong> <span class="muted">The reason stays filled in. Answer temperature, seal, and visual inspection for each unit.</span></div>
                        <div class="flex gap" style="flex-wrap:wrap;margin-top:.35rem;">
                            @foreach (var next in NextToReturn)
                            {
                                var row = next;
                                <button type="button" class="btn @(row == NextToReturn[0] ? "btn-primary" : "btn-secondary") btn-sm" disabled="@_busy" @onclick="() => ReturnNext(row)" data-return-next>
                                    Return next: <span class="mono">@row.UnitNumber</span> @row.ProductName
                                </button>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="muted" style="margin-top:.5rem;">Nothing else from this shipment can be returned.</div>
                    }
                </div>
            }
            @if (_lastReturn is not null)
            {
                <p class="muted" style="margin-top:.75rem;">
                    Return #@_lastReturn.Id recorded@( _lastReturn.ReissueEligible ? " · eligible for reissue" : " · not eligible for reissue").
                    <a href="@InventoryUrls.Unit(_lastReturn.BloodUnitId)">Open Inventory</a>
                    @if (_returnPatientId is long returnedPatientId)
                    {
                        <span> · </span>
                        <a href="@($"/patients/{returnedPatientId}?tab=products")">Open chart · Products</a>
                    }
                </p>
                @if (_lastReturn.ReserveAgainHref is string reserveAgain && Session.Has(PermissionCodes.CompatibilityAllocate))
                {
                    <p class="muted" style="margin:0;">
                        The unit is back in stock and no longer reserved for this patient.
                        <a class="btn btn-secondary btn-sm" href="@reserveAgain">Reserve again for this patient</a>
                    </p>
                }
            }
        }
    </div>
}

@if (_desk == "transfuse")
{
    <div class="bb-card" tabindex="-1" data-enter-flow>
        <div class="bb-card-title"><h3>@(_txStartedUtc is null ? "Start or document transfusion" : "Complete transfusion")</h3></div>
        @if (!CanRecordTransfusion)
        {
            <div class="muted">No permission to record transfusions.</div>
        }
        else
        {
            <Outcome Value="_txFb" />
            <div class="form-row">
                <div class="field"><label>Unit number</label><input class="mono" @ref="_txUnitInput" @bind="_txUnitLookup" @bind:after="LookUpTransfusionUnitAsync" data-desk-unit="transfuse" placeholder="Type or scan, or Document from Issued units" data-enter-step autocomplete="off" /></div>
                <div class="field"><label>Disposition</label>
                    <select @bind="_txDisposition" data-tx-disposition><option value="">— Answer when finishing —</option>@foreach (var d in Enum.GetValues<TransfusionDisposition>().Where(d => d != TransfusionDisposition.Returned)) { <option value="@d">@Ui.EnumText(d)</option> }</select>
                </div>
                <div class="field"><label>Volume transfused (mL)</label><input type="number" @bind="_txVolume" /></div>
                <div class="field"><label>Transfusionist</label><input @bind="_txTransfusionist" /></div>
                <div class="field"><label>Second verifier</label>
                    <FilterableComboBox TItem="DirectoryUserDto" TValue="string?"
                        Items="SecondVerifierChoices"
                        @bind-Value="_txSecondVerifier"
                        DisplayText="@(u => u.Label)"
                        ItemValue="@(u => u.UserName)"
                        SearchText="@(u => u.Label)"
                        Clearable="true"
                        Placeholder="Different active user" />
                </div>
            </div>
            <p class="muted">The receiving location must acknowledge the unit (ward receipt) before this can succeed. Patient identifiers must match the issued patient — a checkbox is not positive identification.</p>
            @if (!string.IsNullOrWhiteSpace(_txProductName) || !string.IsNullOrWhiteSpace(_txExpirationNotice) || !string.IsNullOrWhiteSpace(_txUnitTypeNotice) || !string.IsNullOrWhiteSpace(_txSpecimenNotice) || !string.IsNullOrWhiteSpace(_txCrossmatchNotice) || !string.IsNullOrWhiteSpace(_txIssuedToNotice) || !string.IsNullOrWhiteSpace(_txCoolerNotice) || !string.IsNullOrWhiteSpace(_txLocationNotice) || !string.IsNullOrWhiteSpace(_txIssuedByNotice) || !string.IsNullOrWhiteSpace(_txSecondVerifierNotice))
            {
                <FactList Facts="@(new string?[] { _txExpirationNotice, _txUnitTypeNotice, _txSpecimenNotice, _txCrossmatchNotice, _txIssuedToNotice, _txCoolerNotice, _txLocationNotice, _txIssuedByNotice, _txSecondVerifierNotice })">Documenting @if (!string.IsNullOrWhiteSpace(_txProductName)) { <strong>@_txProductName</strong> }</FactList>
            }
            @if (!string.IsNullOrWhiteSpace(_txEarlierIdentityNotice))
            {
                <div class="alert alert-warning" data-tx-earlier-identity>@_txEarlierIdentityNotice</div>
            }
            @if (!string.IsNullOrWhiteSpace(_txReleaseReason))
            {
                <p class="muted">@_txReleaseReason</p>
            }
            @if (!string.IsNullOrWhiteSpace(_txReleaseAuthorizer))
            {
                <p class="muted">@_txReleaseAuthorizer</p>
            }
            @if (!string.IsNullOrWhiteSpace(_txIssueAppearance))
            {
                <p class="muted">@_txIssueAppearance</p>
            }
            @if (!string.IsNullOrWhiteSpace(_txPtagNotice))
            {
                <p class="muted">@_txPtagNotice</p>
            }
            @if (!string.IsNullOrWhiteSpace(_txCrossmatchStatusNotice))
            {
                <p class="muted">@_txCrossmatchStatusNotice</p>
            }
            @if (!string.IsNullOrWhiteSpace(_txWardAppearance))
            {
                <p class="muted">@_txWardAppearance</p>
            }
            <div class="form-row">
                <div class="field"><label>Patient ID 1 (MRN)</label>
                    <input @bind="_txPatientIdentifier1" @bind:event="oninput" autocomplete="off" placeholder="Scan wristband or type" data-enter-step />
                    <IdentifierMatchHint Type="IdentityTokenType.MedicalRecordNumber" Value="@_txPatientIdentifier1" Patient="_txPatient" />
                </div>
                <div class="field"><label>Patient ID 2 (DOB yyyy-MM-dd)</label>
                    <input @bind="_txPatientIdentifier2" @bind:event="oninput" autocomplete="off" placeholder="From wristband" data-enter-step />
                    <IdentifierMatchHint Type="IdentityTokenType.DateOfBirth" Value="@_txPatientIdentifier2" Patient="_txPatient" />
                </div>
            </div>
            @* Asked, never assumed: an unticked box recorded "no reaction" without anyone answering (Cycle 596). *@
            <div class="field" style="max-width:320px;"><label>Transfusion reaction suspected?</label>
                <select @bind="_txReaction" data-tx-reaction>
                    <option value="">— Answer when finishing —</option>
                    <option value="@false">No reaction</option>
                    <option value="@true">Yes, reaction suspected</option>
                </select>
            </div>
            <UnitScanVerificationPanel Scan="_txScan" Title="Bedside unit scan" Help="Scan the unit at the bedside. Required for ISBT-labeled units together with matching patient identifiers." />
            <PaperRecordDinField @bind-Value="_txBackEntryDin" />
            @if (_txStartedUtc is DateTime txStarted)
            {
                <div class="alert alert-info" style="margin-top:.75rem;">
                    Transfusion started at @txStarted.ToLocalTime().ToString("yyyy-MM-dd HH:mm"). The patient was identified then.
                    Set the disposition, volume, and any suspected reaction, then complete it when it ends.
                </div>
                <div style="margin-top:.75rem;">
                    <button class="btn btn-primary" disabled="@_busy" @onclick="CompleteTransfusionAsync">Complete transfusion</button>
                </div>
            }
            else
            {
                <p class="muted" style="margin-top:.75rem;">Start records the bedside check when the unit is spiked; complete it when it ends. Document records start and finish together, for a transfusion charted afterwards.</p>
                <div class="flex gap" style="margin-top:.5rem;">
                    <button class="btn btn-primary" disabled="@_busy" @onclick="StartTransfusionAsync">Start transfusion</button>
                    <button class="btn btn-secondary" disabled="@_busy" @onclick="DocumentTransfusionAsync">Document start and finish</button>
                </div>
            }
            @if (_lastTransfusion is not null)
            {
                <p class="muted" style="margin-top:.75rem;">
                    Transfusion #@_lastTransfusion.Id documented for issue #@_lastTransfusion.IssueId.
                    <a href="@($"/patients/{_lastTransfusion.PatientId}?tab=products")">Open chart · Products</a>
                </p>
            }
            @if (_openedReactionId is long reactionId)
            {
                <div class="alert alert-warning" style="margin-top:.75rem;">
                    Reaction workup opened.
                    <a href="@($"/reactions?id={reactionId}")">Open investigation #@reactionId</a>
                </div>
            }
            @if (_txRun.Count > 0 || NextAtBedside.Count > 0)
            {
                @* Several units for one patient at the bedside: the transfusionist and identifiers stay; each unit is scanned. *@
                <div class="bb-card" style="margin-top:1rem;" data-bedside-run>
                    <div class="bb-card-title"><h3>This patient at the bedside</h3></div>
                    @if (_txRun.Count > 0)
                    {
                    <div class="table-scroll">
                    <table class="bb">
                        <thead><tr><th>Unit</th><th>Product</th><th>Done</th><th>At</th></tr></thead>
                        <tbody>
                            @foreach (var done in _txRun)
                            {
                                <tr>
                                    <td class="mono">@done.UnitNumber</td>
                                    <td>@done.ProductName</td>
                                    <td>@done.Action</td>
                                    <td class="nowrap">@done.AtLocal.ToString("HH:mm")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    </div>
                    }
                    @if (NextAtBedside.Count > 0)
                    {
                        <div style="margin-top:.5rem;"><strong>Next at the bedside</strong> <span class="muted">Transfusionist and patient identifiers stay filled in. Scan each unit; the second verifier, volume, and reaction are asked again.</span></div>
                        <div class="flex gap" style="flex-wrap:wrap;margin-top:.35rem;">
                            @foreach (var next in NextAtBedside)
                            {
                                var row = next;
                                <button type="button" class="btn @(row == NextAtBedside[0] ? "btn-primary" : "btn-secondary") btn-sm" disabled="@_busy" @onclick="() => NextBedsideUnit(row)">
                                    @(row.TransfusionStartedUtc is null ? "Start next" : "Complete"): <span class="mono">@row.UnitNumber</span> @row.ProductName
                                </button>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="muted" style="margin-top:.5rem;">No other unit received on the ward for this patient is waiting.</div>
                    }
                </div>
            }
        }
    </div>
}

