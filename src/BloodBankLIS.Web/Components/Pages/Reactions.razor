@page "/reactions"
@inject BloodBankApiClient Api
@inject UserSession Session

<PageTitle>Reaction investigations &middot; HemoCore</PageTitle>

<h1>Transfusion reaction investigations</h1>
<p class="muted">Opened automatically when a transfusion is documented with a suspected reaction. The board lists work still due.</p>
<details class="bb-help">
    <summary>About this page</summary>
    <ul>
        <li>A closed fatality stays here until CBER notification and the written report are both recorded.</li>
        <li>Each of those steps is recorded once.</li>
        <li>Choosing severity Fatal starts that same follow-up.</li>
        <li>Fatality fields support 21 CFR 606.170 record-keeping; this LIS does not file with FDA.</li>
        <li>Close requires the clerical and visual checks, both workup specimens, and every Test Group test on them verified.</li>
    </ul>
</details>

@if (!Session.Has(PermissionCodes.ReactionInvestigate))
{
    <div class="muted">No permission to investigate reactions.</div>
}
else
{
    <div class="bb-card">
        <div class="bb-card-title"><h3>Investigations still due</h3>
            <label class="flex"><input type="checkbox" @bind="_showClosed" /> &nbsp;Show closed</label>
            <button class="btn btn-secondary btn-sm" disabled="@_busy" @onclick="LoadAsync">Refresh</button>
        </div>
        <Outcome Value="_fb" />
        @if (_rows.Count == 0)
        {
            <div class="empty">No reaction investigations.</div>
        }
        else if (!VisibleRows.Any())
        {
            <div class="empty">No investigations still need work. Show closed to review finished cases.</div>
        }
        else
        {
            <table class="bb">
                <thead>
                    <tr>
                        <th>Patient / MRN</th>
                        <th>Next step</th>
                        <th>Unit</th>
                        <th>Patient type</th>
                        <th>Unit type</th>
                        <th>Issue</th>
                        <th>Antibodies</th>
                        <th>Workup</th>
                        <th>Remainder</th>
                        <th>Severity / status</th>
                        <th>Fatality / report due</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in VisibleRows)
                    {
                        <tr>
                            <td><a href="@($"/patients/{r.PatientId}")">@(r.PatientDisplayName ?? $"Patient #{r.PatientId}")</a><span class="sub mono">@(r.MedicalRecordNumber ?? "—")</span></td>
                            <td>
                                @if (r.NextStep.Priority <= 3)
                                {
                                    <span class="badge badge-red">@r.NextStep.Text</span>
                                }
                                else
                                {
                                    @r.NextStep.Text
                                }
                            </td>
                            <td><UnitLink Id="r.BloodProductId" Number="@r.UnitNumber" /></td>
                            <td>
                                <strong>@(r.CurrentBloodType ?? "—")</strong>
                                @if (r.RepeatPatientAboRhDiscrepancy)
                                {
                                    <span class="badge badge-red" title="@r.RepeatAboRhDetail">Repeat disagrees</span>
                                }
                            </td>
                            <td>
                                <strong>@(r.UnitBloodType ?? "—")</strong>
                                @if (r.AboRhIncompatible)
                                {
                                    <span class="badge badge-red" title="@r.AboRhCompatibilityAlert">ABO/Rh incompatible</span>
                                }
                                @if (r.RepeatUnitAboRhDiscrepancy)
                                {
                                    <span class="badge badge-red" title="@r.RepeatAboRhDetail">Repeat disagrees</span>
                                }
                            </td>
                            <td>
                                @(r.IssueType?.ToString() ?? "—")
                                @if (r.CrossmatchStatus is { } xm)
                                {
                                    <div class="muted">@xm</div>
                                }
                                @if (r.TestsIncompleteAtIssue)
                                {
                                    <span class="badge badge-amber">Uncrossmatched</span>
                                }
                            </td>
                            <td>
                                @if (r.HasAntibodyHistory)
                                {
                                    <span class="badge badge-amber" title="@r.AntibodySummary">@r.AntibodySummary</span>
                                }
                                else
                                {
                                    <span class="muted">None</span>
                                }
                            </td>
                            <td>
                                @if (r.WorkupIncomplete)
                                {
                                    <span class="badge badge-amber" title="@r.WorkupHoldReason">@(r.WorkupHoldReason ?? "Incomplete")</span>
                                }
                                else
                                {
                                    <span class="muted">Ready to close</span>
                                }
                            </td>
                            <td>
                                @if (r.RemainderQuarantined)
                                {
                                    <span class="badge badge-amber">Held</span>
                                }
                                else if (!string.IsNullOrWhiteSpace(r.RemainderHoldNote))
                                {
                                    <span class="badge badge-amber" title="@r.RemainderHoldNote">Cannot hold</span>
                                }
                                else
                                {
                                    <span class="badge badge-red">Not held</span>
                                }
                            </td>
                            <td>@r.Severity<span class="sub">@r.Status</span></td>
                            <td>
                                @if (r.IsFatality)
                                {
                                    <div>@r.FatalityNotificationStatus</div>
                                    @if (r.FatalityFollowUpDue)
                                    {
                                        <span class="badge badge-amber" title="@r.FatalityFollowUpDetail">Follow-up due</span>
                                    }
                                }
                                <span class="sub nowrap">Report due @(r.WrittenReportDueUtc?.ToString("yyyy-MM-dd") ?? "—")</span>
                            </td>
                            @* The patient name and unit number already open the chart and the unit. *@
                            <td class="right nowrap">
                                <a class="btn btn-ghost btn-sm" href="@($"/reactions?id={r.Id}")">Open investigation</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    @if (_selected is not null)
    {
        @* Keyed so opening another investigation scrolls its editor into view again. *@
        <div @key="_selected.Id" class="bb-card" data-scroll-on-show>
            <div class="bb-card-title">
                <h3>Investigation #@_selected.Id</h3>
                <a class="btn btn-ghost btn-sm" href="@($"/patients/{_selected.PatientId}")">Open chart</a>
                @if (Session.Has(PermissionCodes.ImmunoRecord))
                {
                    @* What this reaction means for future products is the medical director's decision (OCD-057); this records it, linked here. *@
                    <a class="btn btn-ghost btn-sm" href="@($"/patients/{_selected.PatientId}?reaction={_selected.Id}")" title="Record a special requirement for this patient, linked to this investigation">Add special requirement</a>
                }
                <a class="btn btn-ghost btn-sm" href="@InventoryUrls.Unit(_selected.BloodProductId)">Open Inventory</a>
            </div>
            @if (AlreadyClosed)
            {
                @* A signed investigation is read-only; changing it is an explicit, reasoned reopen. *@
                <div class="alert alert-info">
                    <strong>Closed and signed</strong>@(_selected.ClosedBy is null ? "" : $" by {_selected.ClosedBy}")@(_selected.ClosedUtc is DateTime closedAt ? $" on {closedAt:yyyy-MM-dd HH:mm} UTC" : "").
                    The workup and conclusions are locked. To change them, reopen the investigation with a reason; it must then be closed again with a new signature.
                    <div class="form-row" style="margin-top:.5rem;align-items:end;">
                        <div class="field" style="flex:2;"><label>Reason for reopening</label><input @bind="_reopenReason" placeholder="e.g. Late culture result changes the conclusion" /></div>
                        <button type="button" class="btn btn-secondary" disabled="@_busy" @onclick="ReopenAsync">Reopen…</button>
                    </div>
                </div>
            }
            else if (_selected.ReopenedBy is not null)
            {
                <div class="alert alert-warning">
                    Reopened by @_selected.ReopenedBy@(_selected.ReopenedUtc is DateTime reopenedAt ? $" on {reopenedAt:yyyy-MM-dd HH:mm} UTC" : ""): @_selected.ReopenReason. Close it again with a new signature when the changes are done.
                </div>
            }
            <fieldset disabled="@AlreadyClosed" style="border:0;padding:0;margin:0;min-width:0;">
            <div class="form-row">
                <div class="field"><label>Type</label><input @bind="_type" /></div>
                <div class="field"><label>Severity</label>
                    <select @bind="_severity" @bind:after="SyncFatalityFromSeverity">@foreach (var s in Enum.GetValues<ReactionSeverity>()) { <option value="@s">@s</option> }</select>
                </div>
                <div class="field"><label>Status</label>
                    <select @bind="_status">@foreach (var s in CloseableStatuses) { <option value="@s">@s</option> }</select>
                </div>
                <div class="field"><label>Disposition</label><input @bind="_disposition" /></div>
            </div>
            @* OCD-057: the provider's conclusion, from the admin lists. Both are required to close. *@
            <h4>Provider conclusion</h4>
            <p class="muted">Choose the reaction concluded and the treatment for future transfusions. Both are required to close; <strong>No reaction</strong> and <strong>No treatment</strong> are always available. The lists are kept in Administration › Reactions and Treatments.</p>
            <div class="form-row">
                <div class="field"><label>Reaction concluded</label>
                    <select @bind="_concludedReaction">
                        <option value="">Not decided yet</option>
                        @foreach (var e in _catalog.Where(e => e.Kind == ReactionCatalogKind.ReactionType))
                        {
                            <option value="@e.Code">@e.Text</option>
                        }
                    </select>
                </div>
                <div class="field" style="flex:2;"><label>Treatment for future transfusions</label>
                    <div class="flex gap" style="flex-wrap:wrap;">
                        @foreach (var e in _catalog.Where(e => e.Kind == ReactionCatalogKind.Treatment))
                        {
                            <label class="flex"><input type="checkbox" checked="@_treatments.Contains(e.Code)" @onchange="() => ToggleTreatment(e.Code)" />&nbsp;@e.Text</label>
                        }
                    </div>
                </div>
            </div>
            @if (AlreadyClosed && !string.IsNullOrWhiteSpace(_selected.ConcludedReactionText))
            {
                <p class="muted">Recorded at close: @_selected.ConcludedReactionText; treatment: @(_selected.TreatmentTexts ?? "—").</p>
            }
            <h4>Workup specimens</h4>
            <p class="muted">The pre-transfusion specimen (collected before the unit was issued) and a post-transfusion specimen each get the tests of their Test Group (Administration › Reaction Workup), as a Stat order resulted on the bench. Repeat ABO/Rh and DAT come from these results.</p>
            <div class="form-row" style="align-items:flex-start;" data-workup-specimens>
                @foreach (var role in new[] { ReactionWorkupSpecimenDto.PreRole, ReactionWorkupSpecimenDto.PostRole })
                {
                    var isPre = role == ReactionWorkupSpecimenDto.PreRole;
                    var workup = isPre ? _selected.PreWorkup : _selected.PostWorkup;
                    <div class="field" style="flex:1;min-width:18rem;" data-workup-role="@(isPre ? "pre" : "post")">
                        <label>@role specimen</label>
                        @if (workup is not null)
                        {
                            <div>
                                <span class="mono">@workup.AccessionNumber</span>
                                <span class="sub">collected @workup.CollectedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm") · order <span class="mono">@workup.OrderNumber</span></span>
                                @if (workup.Expired)
                                {
                                    <span class="badge badge-gray" title="Reaction workup orders may use an expired pre-transfusion tube (OCD-058)">Expired: workup allowed</span>
                                }
                            </div>
                            <table class="bb" style="margin-top:.35rem;">
                                <thead><tr><th>Test</th><th>Result</th><th>Status</th></tr></thead>
                                <tbody>
                                    @foreach (var line in workup.Lines)
                                    {
                                        <tr>
                                            <td>@line.TestName <span class="sub mono">@line.TestCode</span></td>
                                            <td class="mono">@(line.Value is null ? "—" : AboRhResultValue.FormatDisplay(line.Value))</td>
                                            <td>
                                                @if (line.Verified)
                                                {
                                                    <span class="badge badge-green">Verified</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-amber">@(line.Status?.ToString() ?? "Pending")</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            @if (workup.Pending > 0)
                            {
                                <a class="btn btn-secondary btn-sm" style="margin-top:.35rem;" href="@($"/test-worklist?accession={Uri.EscapeDataString(workup.AccessionNumber)}")" data-result-on-bench>Result on bench (@workup.Pending)</a>
                            }
                        }
                        else if (AlreadyClosed)
                        {
                            <span class="muted">None recorded (closed before the specimen workup).</span>
                        }
                        else if (_workupOptions is null)
                        {
                            <span class="muted">@(_workupOptionsError ?? "Loading specimens…")</span>
                        }
                        else if (string.IsNullOrWhiteSpace(isPre ? _workupOptions.PreTransfusionTestGroupCode : _workupOptions.PostTransfusionTestGroupCode))
                        {
                            <span class="alert alert-warning">No Test Group is chosen for this specimen. An administrator chooses it in Administration › Reaction Workup.</span>
                        }
                        else
                        {
                            var candidates = isPre ? _workupOptions.PreCandidates : _workupOptions.PostCandidates;
                            var group = isPre ? _workupOptions.PreTransfusionTestGroupCode : _workupOptions.PostTransfusionTestGroupCode;
                            @if (candidates.Count > 0)
                            {
                                <select value="@(isPre ? _preChoice : _postChoice)" @onchange="e => SetChoice(isPre, e.Value)" data-workup-pick>
                                    <option value="0">Choose a specimen</option>
                                    @foreach (var c in candidates)
                                    {
                                        <option value="@c.SpecimenId">@c.AccessionNumber · @c.SpecimenType · collected @c.CollectedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")@(c.Expired ? " · expired" : "")@(c.Suggested ? " · crossmatch tube" : "")</option>
                                    }
                                </select>
                                <button type="button" class="btn btn-primary btn-sm" style="margin-top:.35rem;" disabled="@(_busy || (isPre ? _preChoice : _postChoice) <= 0)"
                                        @onclick="() => AttachAsync(isPre)">Use and order @group</button>
                            }
                            else
                            {
                                <span class="muted">@(isPre ? $"No specimen of this patient was collected before the unit was issued ({_workupOptions.IssuedUtc.ToLocalTime():yyyy-MM-dd HH:mm})." : "No specimen has been collected since the transfusion began.")</span>
                            }
                            @if (!isPre)
                            {
                                <div class="form-row" style="margin-top:.5rem;" data-post-accession>
                                    <div class="field"><label>New tube accession</label><input @bind="_postAccession" placeholder="Scan or type" autocomplete="off" /></div>
                                    <div class="field"><label>Type</label><input @bind="_postType" /></div>
                                    <div class="field"><label>Collected</label><input type="datetime-local" @bind="_postCollected" /></div>
                                </div>
                                <button type="button" class="btn btn-secondary btn-sm" disabled="@(_busy || string.IsNullOrWhiteSpace(_postAccession))" @onclick="AccessionPostAsync">Accession and order @group</button>
                            }
                        }
                    </div>
                }
            </div>
            <h4>AABB workup checklist</h4>
            <p class="muted">The clerical check and visual inspection are recorded here; the workup specimens above must have every test verified before close. Compare patient <strong>@(_selected.CurrentBloodType ?? "—")</strong> with labeled unit <strong>@(_selected.UnitBloodType ?? "—")</strong> <span class="mono">@(_selected.UnitNumber ?? "")</span>. Checking remainder holds the bag in quality quarantine when the unit is still Issued, stopped, or Transfused.</p>
            @if (_selected.AboRhIncompatible)
            {
                <p class="badge badge-red" title="@_selected.AboRhCompatibilityAlert">Labeled ABO/Rh is incompatible with the current patient type — existing issue-path rule; this does not block close.</p>
            }
            @if (_selected.RepeatPatientAboRhDiscrepancy || _selected.RepeatUnitAboRhDiscrepancy)
            {
                <p class="badge badge-red" title="@_selected.RepeatAboRhDetail">@(_selected.RepeatAboRhDetail ?? "Repeat ABO/Rh disagrees with the current or labeled type.") Review it before closing.</p>
            }
            @if (WorkupHoldMessage is not null && _selected.Status != ReactionInvestigationStatus.Closed)
            {
                <p class="alert alert-warning">@WorkupHoldMessage Close stays unavailable until this step is recorded.</p>
            }
            <label class="flex"><input type="checkbox" @bind="_clerical" @bind:after="SyncCloseAvailability" /> &nbsp;Clerical check completed (patient ID, unit number, ABO/Rh)</label>
            <div class="field"><label>Clerical notes</label><input @bind="_clericalNotes" /></div>
            <label class="flex"><input type="checkbox" @bind="_visual" @bind:after="SyncCloseAvailability" /> &nbsp;Visual inspection of bag / tubing / segments completed</label>
            <label class="flex"><input type="checkbox" @bind="_visualOk" /> &nbsp;Visual inspection acceptable</label>
            @if (_selected.PreWorkup is null && _selected.PostWorkup is null && (_selected.DatResult != DatWorkupResult.NotRecorded || !string.IsNullOrWhiteSpace(_selected.RepeatPatientAboRh)))
            {
                @* Recorded before the specimen workup: kept as typed, read only. *@
                <p class="muted" data-legacy-workup>Recorded before the specimen workup: repeat patient ABO/Rh @(_selected.RepeatPatientAboRh ?? "—"), DAT @_selected.DatResult.</p>
            }
            <div class="form-row">
                <div class="field"><label>Repeat unit ABO/Rh</label><input @bind="_repeatUnit" placeholder="@(_selected.UnitBloodType is { } ut ? $"labeled {ut}" : "e.g. A+")" /></div>
                <div class="field"><label>Elution (required if the post-transfusion DAT is positive)</label><input @bind="_elution" @bind:after="SyncCloseAvailability" /></div>
            </div>
            <label class="flex"><input type="checkbox" @bind="_remainderHeld" disabled="@(_selected.RemainderQuarantined)" title="@(_selected.RemainderQuarantined ? "Already recorded; this cannot be undone." : null)" /> &nbsp;Remainder / segments quarantined or retained</label>
            @if (!string.IsNullOrWhiteSpace(_selected.RemainderHoldNote))
            {
                <p class="alert alert-warning">@_selected.RemainderHoldNote</p>
            }
            <div class="form-row">
                <div class="field" style="grid-column:1/-1;"><label>Findings</label><textarea rows="2" @bind="_findings"></textarea></div>
                <div class="field" style="grid-column:1/-1;"><label>Conclusions</label><textarea rows="2" @bind="_conclusions"></textarea></div>
                <div class="field" style="grid-column:1/-1;"><label>Follow-up</label><textarea rows="2" @bind="_followUp"></textarea></div>
            </div>
            <label class="flex"><input type="checkbox" @bind="_productAtFault" /> &nbsp;Product at fault</label>
            <label class="flex"><input type="checkbox" @bind="_isFatality" disabled="@(_selected.IsFatality)" title="@(_selected.IsFatality ? "Already recorded; this cannot be undone." : null)" /> &nbsp;Fatality (sets 7-day written-report due date)</label>
            </fieldset>
            @if (ClosingNow)
            {
                <div class="field"><label>Password / PIN to close</label><input type="password" @bind="_closeSecret" /></div>
            }
            <div class="flex gap" style="margin-top:.75rem;">
                @if (!AlreadyClosed)
                {
                    <button class="btn btn-primary" disabled="@_busy" @onclick="SaveAsync">Save</button>
                }
                @if (_selected.IsFatality)
                {
                    @if (_selected.FatalityFollowUpDue)
                    {
                        <p class="alert alert-warning">@_selected.FatalityFollowUpDetail</p>
                    }
                    @if (_selected.CberNotifiedUtc is DateTime cberAt)
                    {
                        <span class="muted">CBER recorded @cberAt.ToString("yyyy-MM-dd HH:mm")</span>
                    }
                    else
                    {
                        <button class="btn btn-secondary" disabled="@_busy" @onclick="CberAsync">Record CBER notified</button>
                    }
                    @if (_selected.WrittenReportSubmittedUtc is DateTime writtenAt)
                    {
                        <span class="muted">Written report recorded @writtenAt.ToString("yyyy-MM-dd HH:mm")</span>
                    }
                    else
                    {
                        <button class="btn btn-secondary" disabled="@_busy" @onclick="WrittenAsync">Record written report</button>
                    }
                }
            </div>
        </div>
    }
}

@code {
    [SupplyParameterFromQuery]
    public long? Id { get; set; }

    [SupplyParameterFromQuery]
    public long? PatientId { get; set; }

    private List<ReactionInvestigationDto> _rows = new();
    private ReactionInvestigationDto? _selected;

    private bool _showClosed;

    // Worked top down: the most urgent next step first, then the oldest report.
    private IEnumerable<ReactionInvestigationDto> VisibleRows => _rows.Where(IncludeOnBoard)
        .OrderBy(r => r.NextStep.Priority)
        .ThenBy(r => r.ReportedUtc);

    private string? WorkupHoldMessage
    {
        get
        {
            var workup = _selected is null
                ? RuleResult.Pass(ReactionWorkupCompletenessRule.Code)
                : ReactionWorkupCompletenessRule.Evaluate(_clerical, _visual, _selected.SpecimenWorkupState, _elution);
            return workup.Severity == RuleSeverity.HardStop ? $"{workup.Code}: {workup.Message}" : null;
        }
    }

    private IEnumerable<ReactionInvestigationStatus> CloseableStatuses =>
        Enum.GetValues<ReactionInvestigationStatus>().Where(status =>
            status != ReactionInvestigationStatus.Closed
            || _selected?.Status == ReactionInvestigationStatus.Closed
            || WorkupHoldMessage is null);

    private void SyncFatalityFromSeverity()
    {
        if (_severity == ReactionSeverity.Fatal)
        {
            _isFatality = true;
        }
    }

    private void SyncCloseAvailability()
    {
        if (_selected is null || _selected.Status == ReactionInvestigationStatus.Closed)
        {
            return;
        }

        if (WorkupHoldMessage is not null && _status == ReactionInvestigationStatus.Closed)
        {
            _status = _selected.Status;
        }
    }

    private bool IncludeOnBoard(ReactionInvestigationDto row)
    {
        if (PatientId is long patientId && row.PatientId == patientId)
        {
            return true;
        }

        if (Id is long id && row.Id == id)
        {
            return true;
        }

        if (_showClosed)
        {
            return true;
        }

        return row.Status != ReactionInvestigationStatus.Closed || row.FatalityFollowUpDue;
    }
    private Feedback? _fb;
    private bool _busy;
    private string? _type;
    private ReactionSeverity _severity;
    private ReactionInvestigationStatus _status;
    private string? _disposition;
    private string? _findings;
    private string? _conclusions;
    private string? _followUp;
    private bool _productAtFault;
    private bool _isFatality;
    private bool _clerical;
    private string? _clericalNotes;
    private bool _visual;
    private bool _visualOk;
    private string? _repeatPatient;
    private string? _repeatUnit;
    private DatWorkupResult _dat;
    private string? _elution;
    private bool _remainderHeld;
    private string _closeSecret = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var catalog = await Api.GetReactionCatalogAsync();
        _catalog = catalog.Value ?? [];
        await LoadAsync();
    }

    private List<ReactionCatalogEntryDto> _catalog = [];
    private string? _concludedReaction;
    private readonly HashSet<string> _treatments = new(StringComparer.OrdinalIgnoreCase);

    // No treatment stands alone: choosing it clears the others, and choosing another clears it.
    private void ToggleTreatment(string code)
    {
        if (!_treatments.Remove(code))
        {
            if (string.Equals(code, ReactionConclusionRule.NoneCode, StringComparison.OrdinalIgnoreCase))
            {
                _treatments.Clear();
            }
            else
            {
                _treatments.Remove(ReactionConclusionRule.NoneCode);
            }

            _treatments.Add(code);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_rows.Count > 0)
        {
            ApplyQuerySelection();
            await LoadWorkupOptionsAsync();
        }
    }

    // Specimens offered for each workup role, and what each new post-transfusion tube is accessioned as.
    private ReactionWorkupOptionsDto? _workupOptions;
    private string? _workupOptionsError;
    private long? _workupOptionsFor;
    private long _preChoice;
    private long _postChoice;
    private string? _postAccession;
    private string _postType = "EDTA";
    private DateTime _postCollected = DateTime.Now;

    private async Task LoadWorkupOptionsAsync(bool force = false)
    {
        if (_selected is null || AlreadyClosed || (_selected.PreWorkup is not null && _selected.PostWorkup is not null))
        {
            return;
        }

        if (!force && _workupOptionsFor == _selected.Id && _workupOptions is not null)
        {
            return;
        }

        _workupOptionsFor = _selected.Id;
        var r = await Api.GetReactionWorkupOptionsAsync(_selected.Id);
        _workupOptions = r.Succeeded ? r.Value : null;
        _workupOptionsError = r.Succeeded ? null : r.Error;
        _preChoice = _workupOptions?.PreCandidates.FirstOrDefault(c => c.Suggested)?.SpecimenId ?? 0;
        _postChoice = 0;
        _postAccession = null;
        _postCollected = DateTime.Now;
    }

    private void SetChoice(bool preTransfusion, object? value)
    {
        var id = long.TryParse(value?.ToString(), out var parsed) ? parsed : 0;
        if (preTransfusion)
        {
            _preChoice = id;
        }
        else
        {
            _postChoice = id;
        }
    }

    private async Task AttachAsync(bool preTransfusion)
    {
        if (_selected is null) return;
        _busy = true;
        var id = _selected.Id;
        var r = preTransfusion
            ? await Api.AttachReactionPreSpecimenAsync(id, _preChoice)
            : await Api.AttachReactionPostSpecimenAsync(id, _postChoice);
        _busy = false;
        _fb = r.ToFeedback(preTransfusion
            ? "Pre-transfusion specimen added; its workup tests are ordered. Result them on the bench."
            : "Post-transfusion specimen added; its workup tests are ordered. Result them on the bench.");
        if (r.Succeeded)
        {
            await ReloadSelectedAsync(id);
        }
    }

    private async Task AccessionPostAsync()
    {
        if (_selected is null || string.IsNullOrWhiteSpace(_postAccession)) return;
        _busy = true;
        var id = _selected.Id;
        var r = await Api.AccessionReactionPostSpecimenAsync(id, new AccessionPostTransfusionSpecimenRequest(
            _postAccession.Trim(), string.IsNullOrWhiteSpace(_postType) ? "EDTA" : _postType.Trim(), _postCollected.ToUniversalTime()));
        _busy = false;
        _fb = r.ToFeedback("Post-transfusion specimen accessioned; its workup tests are ordered. Result them on the bench.");
        if (r.Succeeded)
        {
            await ReloadSelectedAsync(id);
        }
    }

    private async Task ReloadSelectedAsync(long id)
    {
        await LoadAsync();
        var row = _rows.FirstOrDefault(x => x.Id == id);
        if (row is not null)
        {
            Select(row);
        }

        await LoadWorkupOptionsAsync(force: true);
    }

    private async Task LoadAsync()
    {
        _busy = true;
        var r = await Api.GetReactionInvestigationsAsync();
        _busy = false;
        if (r.Succeeded)
        {
            _rows = r.Value ?? new();
            ApplyQuerySelection();
            await LoadWorkupOptionsAsync();
        }
        else _fb = r.ToFeedback();
    }

    private void ApplyQuerySelection()
    {
        if (Id is long id)
        {
            var match = _rows.FirstOrDefault(r => r.Id == id);
            if (match is not null)
            {
                Select(match);
                return;
            }
        }

        if (PatientId is long patientId)
        {
            var match = _rows.FirstOrDefault(r => r.PatientId == patientId);
            if (match is not null)
            {
                Select(match);
            }
        }
    }

    private void Select(ReactionInvestigationDto r)
    {
        _selected = r;
        _type = r.ReactionType;
        _severity = r.Severity;
        _status = r.Status;
        _disposition = r.Disposition;
        _findings = r.Findings;
        _conclusions = r.Conclusions;
        _followUp = r.FollowUp;
        _productAtFault = r.ProductAtFault;
        _isFatality = r.IsFatality;
        _clerical = r.ClericalCheckCompleted;
        _clericalNotes = r.ClericalCheckNotes;
        _visual = r.VisualInspectionCompleted;
        _visualOk = r.VisualInspectionAcceptable;
        _repeatPatient = r.RepeatPatientAboRh;
        _repeatUnit = r.RepeatUnitAboRh;
        _dat = r.DatResult;
        _elution = r.ElutionResult;
        _remainderHeld = r.RemainderQuarantined;
        _concludedReaction = r.ConcludedReactionCode;
        _treatments.Clear();
        foreach (var code in (r.TreatmentCodes ?? string.Empty).Split('|', StringSplitOptions.RemoveEmptyEntries))
        {
            _treatments.Add(code);
        }

        _closeSecret = string.Empty;
    }

    private bool AlreadyClosed => _selected?.Status == ReactionInvestigationStatus.Closed;

    private string? _reopenReason;

    private async Task ReopenAsync()
    {
        if (_selected is null) return;
        _busy = true;
        var r = await Api.ReopenReactionInvestigationAsync(_selected.Id, _reopenReason);
        _busy = false;
        _fb = r.ToFeedback("Investigation reopened. Make the changes, then close it again with your signature.");
        if (r.Succeeded)
        {
            _reopenReason = null;
            await LoadAsync();
            _selected = _rows.FirstOrDefault(x => x.Id == _selected.Id) ?? r.Value;
            if (_selected is not null) _status = _selected.Status;
        }
    }

    /// <summary>Only a change to Closed needs the close signature.</summary>
    private bool ClosingNow => _status == ReactionInvestigationStatus.Closed && !AlreadyClosed;

    private async Task SaveAsync()
    {
        if (_selected is null) return;
        long? sigId = null;
        if (ClosingNow)
        {
            var sig = await Api.RecordSignatureAsync(new SignatureRequestVm(
                "ReactionInvestigationClose", "I close this reaction investigation", "ReactionInvestigation", _selected.Id, _closeSecret));
            if (!sig.Succeeded || sig.Value is null)
            {
                _fb = sig.ToFeedback();
                return;
            }

            sigId = sig.Value.Id;
        }

        _busy = true;
        var r = await Api.UpdateReactionInvestigationAsync(_selected.Id, new UpdateReactionInvestigationRequest(
            // An already-closed case keeps its original close signature, so do not resend the Closed status.
            _type, _severity, _findings, _conclusions, _followUp, _disposition, _productAtFault, _isFatality, AlreadyClosed && _status == ReactionInvestigationStatus.Closed ? null : _status, sigId,
            _clerical, _clericalNotes, _visual, _visualOk, _repeatPatient, _repeatUnit, _dat, _elution, _remainderHeld,
            ConcludedReactionCode: _concludedReaction ?? string.Empty,
            TreatmentCodes: _treatments.ToList()));
        _busy = false;
        _fb = r.ToFeedback("Investigation updated.");
        if (r.Succeeded)
        {
            await LoadAsync();
            _selected = _rows.FirstOrDefault(x => x.Id == _selected.Id) ?? r.Value;
        }
    }

    private async Task CberAsync()
    {
        if (_selected is null) return;
        _busy = true;
        var r = await Api.RecordCberNotificationAsync(_selected.Id);
        _busy = false;
        _fb = r.ToFeedback("CBER notification recorded.");
        if (r.Succeeded) { _selected = r.Value; await LoadAsync(); }
    }

    private async Task WrittenAsync()
    {
        if (_selected is null) return;
        _busy = true;
        var r = await Api.RecordWrittenReportAsync(_selected.Id);
        _busy = false;
        _fb = r.ToFeedback("Written report recorded.");
        if (r.Succeeded) { _selected = r.Value; await LoadAsync(); }
    }
}
