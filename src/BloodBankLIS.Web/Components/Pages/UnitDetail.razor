    private async Task ReceiveExpectedAsync(long id)
    {
        _busy = true;
        var r = await Api.ReceiveExpectedUnitAsync(id, new ReceiveExpectedUnitRequest(
            VisualInspectionAcceptable: _arrivalAppearance == UnitAppearance.Acceptable,
            VisualInspectionNotes: string.IsNullOrWhiteSpace(_arrivalVisualNotes) ? null : _arrivalVisualNotes,
            SecondVerifier: _requireReceiveVerifier ? _arrivalSecondVerifier : null,
            Appearance: _arrivalAppearance,
            ReceiveTemperatureCelsius: _arrivalTemperatureCelsius));
        _busy = false;
        if (r.Succeeded)
        {
            _arrivalAppearance = UnitAppearance.Acceptable;
            _arrivalVisualNotes = null;
            _arrivalSecondVerifier = null;
            _arrivalTemperatureCelsius = null;
            _tab = "retype";
        }

        await AfterActionAsync(r, r.Value?.Status == UnitStatus.Received
            ? "Arrival confirmed. Pending retype until results are entered and verified."
            : "Arrival confirmed into quarantine.");
    }

