@page "/inventory/units/{UnitId:long}"
@using BloodBankLIS.Application.Inventory
@using BloodBankLIS.Application.Issuing
@using BloodBankLIS.Application.Reference
@inject BloodBankApiClient Api
@inject UserSession Session
@inject NavigationManager Nav

<PageTitle>@(UnitNumberTitle) &middot; Greyhound Blood Bank LIS</PageTitle>

<InventoryDeskRibbon Current="InventoryDeskRibbon.Desk.Inventory" />

@if (_loading)
{
    <div class="loading">Loading unit...</div>
}
else if (_unit is null)
{
    <div class="alert alert-danger">@(_error ?? "Unit not found.")</div>
    <a class="btn btn-secondary" href="/inventory">Back to inventory</a>
}
else
{
    <UnitChartHeader Unit="_unit" ProductCode="@ProductCode(_unit)" ProductName="@ProductName(_unit.ProductTypeId)" LocationName="@LocationName(_unit.CurrentLocationId)" />
    <UnitChartTabBar Current="_tab" OnSelect="SelectTab" />
    <Outcome Value="_actionFb" />

    @if (_autoThawAllocationId is long thawAllocationId)
    {
        <div class="bb-dialog-backdrop">
            <div class="bb-dialog" role="dialog" aria-modal="true" aria-labelledby="unit-auto-thaw-title" @onclick:stopPropagation="true">
                <h2 id="unit-auto-thaw-title" style="margin:0;">Auto thaw @_autoThawProductCode?</h2>
                <p class="muted">Thaw this product now? The product code stays @_autoThawProductCode. Expiration becomes 24 hours after the thaw date and time. A thaw billing message is sent and the product ID tag prints.</p>
                <div class="field">
                    <label>Thaw date/time</label>
                    <input type="datetime-local" @bind="_autoThawLocal" />
                </div>
                <div class="flex gap" style="margin-top:.75rem;">
                    <button type="button" class="btn btn-primary" disabled="@_busy" @onclick="() => ConfirmUnitAutoThawAsync(thawAllocationId)">Yes</button>
                    <button type="button" class="btn btn-ghost" disabled="@_busy" @onclick="() => DeclineUnitAutoThawAsync(thawAllocationId)">No</button>
                </div>
            </div>
        </div>
    }

    @if (_tab == "overview")
    {
        <div class="bb-card">
            <div class="bb-card-title"><h3>Unit identity</h3></div>
            <div class="form-row">
                <div class="field"><label>Unit number</label><div class="mono">@_unit.UnitNumber</div></div>
                <div class="field"><label>Component identity</label><div class="mono">@(_unit.ComponentIdentity ?? "—")</div></div>
                <div class="field"><label>DIN</label><div class="mono">@(_unit.Din ?? "—")</div></div>
                <div class="field"><label>Product code</label><div class="mono">@ProductCode(_unit)</div></div>
                <div class="field"><label>Product</label><div>@ProductName(_unit.ProductTypeId)</div></div>
                <div class="field"><label>ABO/Rh</label><div><strong>@Ui.BloodType(_unit.Abo, _unit.RhD)</strong></div></div>
                <div class="field"><label>Expires</label><div class="nowrap">@_unit.ExpiresUtc.ToString("yyyy-MM-dd HH:mm")</div></div>
                <div class="field"><label>Status</label><div><span class="@Ui.Badge(_unit.Status)">@Ui.StatusLabel(_unit.Status)</span></div></div>
                <div class="field"><label>Location</label><div>@LocationName(_unit.CurrentLocationId)</div></div>
                <div class="field"><label>Volume</label><div>@(_unit.Volume is { } vol ? vol.ToString("0.###") : "—")</div></div>
                <div class="field"><label>Supplier</label><div>@(string.IsNullOrWhiteSpace(_unit.Supplier) ? "—" : _unit.Supplier)</div></div>
                <div class="field"><label>Collection facility</label><div>@(string.IsNullOrWhiteSpace(_unit.CollectionFacility) ? "—" : _unit.CollectionFacility)</div></div>
                <div class="field"><label>Collected</label><div>@(_unit.CollectionDateTime?.ToString("yyyy-MM-dd HH:mm") ?? "—")</div></div>
                <div class="field"><label>Processing facility</label><div>@(string.IsNullOrWhiteSpace(_unit.ProcessingFacilityCode) ? "—" : _unit.ProcessingFacilityCode)</div></div>
                <div class="field"><label>Shipment</label><div class="mono">@(_unit.ShipmentId ?? "—")</div></div>
                <div class="field"><label>Delivery</label><div class="mono">@if (_unit.DeliveryId is long deliveryId) { <a href="@($"/inventory/deliveries/{deliveryId}")">@deliveryId</a> } else { <span>—</span> }</div></div>
                <div class="field"><label>Donation</label><div>@_unit.DonationRestriction@(_unit.ReservedPatientId is long pid ? $" — {RecipientLabel(pid)}" : "")</div></div>
            </div>
            @if (!string.IsNullOrWhiteSpace(_unit.HoldReason) || _unit.QuarantineReasonCode != UnitQuarantineReason.Unspecified || !string.IsNullOrWhiteSpace(_unit.QuarantineReason) || !string.IsNullOrWhiteSpace(_unit.MissingReason) || !string.IsNullOrWhiteSpace(_unit.DamagedReason) || !string.IsNullOrWhiteSpace(_unit.SupplierReturnReason) || !string.IsNullOrWhiteSpace(_unit.ReceiveVisualNotes) || _unit.ReceiveAppearance != UnitAppearance.Acceptable || _unit.ReceiveTemperatureCelsius is not null || !string.IsNullOrWhiteSpace(_unit.DirectedConversionReason) || _unit.ExpectedArrivalDueUtc is not null)
            {
                <p class="muted">
                    @if (_unit.ExpectedArrivalDueUtc is DateTime due)
                    {
                        <span>Expected by: @due.ToString("yyyy-MM-dd HH:mm") UTC@(due < DateTime.UtcNow && _unit.Status == UnitStatus.Expected ? " (overdue)" : "")</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(_unit.HoldReason))
                    {
                        <span>Hold: @_unit.HoldReason</span>
                    }
                    @if (_unit.QuarantineReasonCode != UnitQuarantineReason.Unspecified || !string.IsNullOrWhiteSpace(_unit.QuarantineReason))
                    {
                        <span>Quarantine: @_unit.QuarantineReasonCode@(string.IsNullOrWhiteSpace(_unit.QuarantineReason) ? "" : $" — {_unit.QuarantineReason}")</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(_unit.MissingReason))
                    {
                        <span>Missing: @_unit.MissingReason</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(_unit.DamagedReason))
                    {
                        <span>Damaged: @_unit.DamagedReason</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(_unit.SupplierReturnReason))
                    {
                        <span>Returned to supplier: @_unit.SupplierReturnReason</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(_unit.DirectedConversionReason))
                    {
                        <span>Converted from directed@(_unit.DirectedConvertedBy is string by ? $" by {by}" : ""): @_unit.DirectedConversionReason</span>
                    }
                    @if (_unit.ReceiveAppearance != UnitAppearance.Acceptable || !string.IsNullOrWhiteSpace(_unit.ReceiveVisualNotes))
                    {
                        <span>Appearance: @_unit.ReceiveAppearance@(string.IsNullOrWhiteSpace(_unit.ReceiveVisualNotes) ? "" : $" — {_unit.ReceiveVisualNotes}")</span>
                    }
                    @if (_unit.ReceiveTemperatureCelsius is decimal temp)
                    {
                        <span>Receipt temperature: @temp.ToString("0.#") °C</span>
                    }
                </p>
            }
        </div>
    }

    @if (_tab == "actions")
    {
        <div class="bb-card">
            <div class="bb-card-title"><h3>Actions</h3></div>
            <div class="stack">
                <div class="flex gap" style="flex-wrap:wrap;">
                    @if (_unit.Status == UnitStatus.Quarantine && Session.Has(PermissionCodes.InventoryRelease))
                    {
                        <div class="field" style="min-width:16rem;">
                            <label>Second verifier</label>
                            <FilterableComboBox TItem="DirectoryUserDto" TValue="string?"
                                Items="VerifierChoices"
                                @bind-Value="_releaseSecondVerifier"
                                DisplayText="@(x => x.Label)"
                                ItemValue="@(x => x.UserName)"
                                SearchText="@(x => x.Label)"
                                Clearable="true"
                                Placeholder="Different active user" />
                        </div>
                        <button class="btn btn-secondary btn-sm" disabled="@_busy" @onclick="() => ReleaseAsync(_unit.Id)">Release from quarantine</button>
                    }
                    @if (_unit.Status == UnitStatus.Expected && Session.Has(PermissionCodes.InventoryReceive))
                    {
                        @if (BloodUnitExpirationRule.IsExpired(_unit.ExpiresUtc, DateTime.UtcNow))
                        {
                            <p class="muted" style="margin:0;">This unit is outdated and cannot be received. Return it to the supplier.</p>
                        }
                        else
                        {
                        <div class="field" style="min-width:14rem;">
                            <label>Appearance</label>
                            <select @bind="_arrivalAppearance">
                                @foreach (var a in Enum.GetValues<UnitAppearance>()) { <option value="@a">@a</option> }
                            </select>
                        </div>
                        <div class="field" style="min-width:16rem;">
                            <label>Arrival notes</label>
                            <input @bind="_arrivalVisualNotes" placeholder="Appearance, defects" />
                        </div>
                        <div class="field" style="min-width:12rem;">
                            <label>Receipt temperature (°C)</label>
                            <input type="number" step="0.1" @bind="_arrivalTemperatureCelsius" placeholder="e.g. 4.0" />
                        </div>
                        @if (_requireReceiveVerifier)
                        {
                            <div class="field" style="min-width:16rem;">
                                <label>Second verifier</label>
                                <FilterableComboBox TItem="DirectoryUserDto" TValue="string?"
                                    Items="VerifierChoices"
                                    @bind-Value="_arrivalSecondVerifier"
                                    DisplayText="@(x => x.Label)"
                                    ItemValue="@(x => x.UserName)"
                                    SearchText="@(x => x.Label)"
                                    Clearable="true"
                                    Placeholder="Different active user" />
                            </div>
                        }
                        <button class="btn btn-primary btn-sm" disabled="@_busy" @onclick="() => ReceiveExpectedAsync(_unit.Id)">Confirm arrival</button>
                        }
                        <div class="field" style="min-width:16rem;">
                            <label>Cancel reason</label>
                            <input @bind="_cancelExpectedReason" placeholder="Not shipped / cancelled ASN" />
                        </div>
                        <button class="btn btn-danger btn-sm" disabled="@(_busy || string.IsNullOrWhiteSpace(_cancelExpectedReason))" @onclick="() => CancelExpectedAsync(_unit.Id)">Cancel expected</button>
                        <div class="field" style="min-width:16rem;">
                            <label>Return to supplier</label>
                            <input @bind="_supplierReturnReason" placeholder="Failed inspection / refused at dock" />
                        </div>
                        <button class="btn btn-danger btn-sm" disabled="@(_busy || string.IsNullOrWhiteSpace(_supplierReturnReason))" @onclick="() => ReturnToSupplierAsync(_unit.Id)">Return to supplier</button>
                    }
                    @if (_unit.Status == UnitStatus.OnHold && Session.Has(PermissionCodes.InventoryRelease))
                    {
                        <button class="btn btn-secondary btn-sm" disabled="@_busy" @onclick="() => ReleaseHoldAsync(_unit.Id)">Release from hold</button>
                    }
                    @if (_unit.Status == UnitStatus.Missing && Session.Has(PermissionCodes.InventoryRelease))
                    {
                        <button class="btn btn-primary btn-sm" disabled="@_busy" @onclick="() => LocateMissingAsync(_unit.Id)">Unit located</button>
                    }
                    @if (_unit.Status == UnitStatus.Damaged && Session.Has(PermissionCodes.InventoryRelease))
                    {
                        <button class="btn btn-primary btn-sm" disabled="@_busy" @onclick="() => InspectDamagedAsync(_unit.Id)">Inspect into quarantine</button>
                    }
                    @if (Session.Has(PermissionCodes.PrintLabel))
                    {
                        <button class="btn btn-secondary btn-sm" disabled="@_busy" @onclick="() => PrintComponentLabelAsync(_unit.Id)">Print component label</button>
                        <a class="btn btn-ghost btn-sm" href="@(_componentJobId is long jobId ? $"/printing?jobId={jobId}" : $"/printing?unitId={_unit.Id}")">Open Printing</a>
                    }
                    @if (_unit.Status is UnitStatus.Received or UnitStatus.Quarantine)
                    {
                        <a class="btn btn-ghost btn-sm" href="@($"/inventory?board=retype&unitId={_unit.Id}#pending-retype")">Open retype desk</a>
                    }
                    @if (Session.Has(PermissionCodes.InventoryModify) && _unit.Status is UnitStatus.Assigned or UnitStatus.Allocated or UnitStatus.Crossmatched)
                    {
                        <div class="field" style="min-width:20rem;">
                            <label>Eligible modification</label>
                            <select @bind="_selectedEligibleRuleId">
                                <option value="0">— Select modification for this product —</option>
                                @foreach (var m in _eligibleMods.Where(m => m.IsAvailable))
                                {
                                    <option value="@m.RuleId">@m.ModificationCode — @m.ModificationType → @m.TargetProductCode</option>
                                }
                            </select>
                        </div>
                        <a class="btn btn-ghost btn-sm" href="@ModifyHref(_unit.Id, _selectedEligibleRuleId)">Modify</a>
                    }
                    @if (_unit.Status is UnitStatus.Available or UnitStatus.Selected && Session.Has(PermissionCodes.CompatibilityAllocate))
                    {
                        <div class="field" style="min-width:22rem;">
                            <label>Allocate to open order</label>
                            <select @bind="_allocateOrderId">
                                <option value="0">— Current open orders for this product —</option>
                                @foreach (var o in _allocatableOrders)
                                {
                                    <option value="@o.OrderId">@o.OrderNumber — @o.PatientName (@o.MedicalRecordNumber) @(o.AccessionNumber is null ? "" : $"· {o.AccessionNumber}")</option>
                                }
                            </select>
                        </div>
                        <button class="btn btn-primary btn-sm" disabled="@(_busy || _allocateOrderId <= 0)" @onclick="() => AllocateSelectedAsync(_unit)">Allocate</button>
                        @if (_showAllocOverride)
                        {
                            <div class="field"><label>Override reason</label><input @bind="_allocOverrideReason" /></div>
                            <div class="field"><label>Authorized by</label><input @bind="_allocAuthorizedBy" /></div>
                        }
                    }
                    @if (_unit.Status == UnitStatus.Issued && _selectedIssueId is long issuedId && Session.Has(PermissionCodes.TransfusionDocument))
                    {
                        <button type="button" class="btn btn-link btn-sm" disabled="@_busy" @onclick="() => MarkInventoryTransfusedAsync(issuedId)">Transfuse</button>
                    }
                    @if (_unit.Status == UnitStatus.Issued && Session.Has(PermissionCodes.IssueReturn))
                    {
                        <div class="field" style="min-width:22rem;">
                            <label>Change status</label>
                            <select @bind="_changeStatusDestination">
                                @if (IssuedCanReturnToAvailable)
                                {
                                    <option value="@UnitStatus.Available">Available</option>
                                }
                                <option value="@UnitStatus.Quarantine">Quarantine</option>
                                <option value="@UnitStatus.Discarded">Disposed</option>
                            </select>
                        </div>
                        <input @bind="_changeStatusReason" placeholder="Reason" style="flex:1;min-width:12rem;" />
                        @if (_changeStatusDestination == UnitStatus.Available)
                        {
                            <label class="checkbox-item"><input type="checkbox" @bind="_changeTempOk" /> Temperature acceptable</label>
                            <label class="checkbox-item"><input type="checkbox" @bind="_changeSealOk" /> Seal intact</label>
                            <label class="checkbox-item"><input type="checkbox" @bind="_changeVisualOk" /> Visual inspection acceptable</label>
                        }
                        <button class="btn btn-secondary btn-sm" disabled="@(_busy || string.IsNullOrWhiteSpace(_changeStatusReason))" @onclick="() => ChangeIssuedStatusAsync(_unit.Id)">Change status</button>
                    }
                </div>

                @if (CanPlaceOnHold(_unit.Status) && Session.Has(PermissionCodes.InventoryRelease))
                {
                    <div class="flex gap">
                        <input @bind="_holdReason" placeholder="Hold reason (paperwork, pending review)" style="flex:1;" />
                        <button class="btn btn-secondary btn-sm" disabled="@(_busy || string.IsNullOrWhiteSpace(_holdReason))" @onclick="() => HoldAsync(_unit.Id)">Place on hold</button>
                    </div>
                }

                @if (CanQuarantine(_unit.Status) && Session.Has(PermissionCodes.InventoryRelease))
                {
                    <div class="flex gap" style="flex-wrap:wrap;">
                        <select @bind="_quarantineCode">
                            @foreach (var q in Enum.GetValues<UnitQuarantineReason>().Where(x => x != UnitQuarantineReason.Unspecified))
                            {
                                <option value="@q">@q</option>
                            }
                        </select>
                        <input @bind="_quarantineNotes" placeholder="Notes (required when Other)" style="flex:1;min-width:12rem;" />
                        <button class="btn btn-secondary btn-sm" disabled="@(_busy || (_quarantineCode == UnitQuarantineReason.Other && string.IsNullOrWhiteSpace(_quarantineNotes)))" @onclick="() => PlaceInQuarantineAsync(_unit.Id)">Place in quarantine</button>
                    </div>
                }

                @if (CanMarkMissing(_unit.Status) && Session.Has(PermissionCodes.InventoryRelease))
                {
                    <div class="flex gap">
                        <input @bind="_missingReason" placeholder="Missing reason (physical inventory, lost in transit)" style="flex:1;" />
                        <button class="btn btn-secondary btn-sm" disabled="@(_busy || string.IsNullOrWhiteSpace(_missingReason))" @onclick="() => MarkMissingAsync(_unit.Id)">Mark missing</button>
                    </div>
                }

                @if (CanMarkDamaged(_unit.Status) && Session.Has(PermissionCodes.InventoryRelease))
                {
                    <div class="flex gap">
                        <input @bind="_damagedReason" placeholder="Damage reason (leaking bag, crushed, storage mishandling)" style="flex:1;" />
                        <button class="btn btn-secondary btn-sm" disabled="@(_busy || string.IsNullOrWhiteSpace(_damagedReason))" @onclick="() => MarkDamagedAsync(_unit.Id)">Mark damaged</button>
                    </div>
                }

                @if (CanReturnToSupplier(_unit.Status) && Session.Has(PermissionCodes.InventoryReceive))
                {
                    <div class="flex gap">
                        <input @bind="_supplierReturnReason" placeholder="Return-to-supplier reason (failed inspection, unused credit)" style="flex:1;" />
                        <button class="btn btn-secondary btn-sm" disabled="@(_busy || string.IsNullOrWhiteSpace(_supplierReturnReason))" @onclick="() => ReturnToSupplierAsync(_unit.Id)">Return to supplier</button>
                    </div>
                }

                @if (CanConvertDirected(_unit) && Session.Has(PermissionCodes.InventoryRelease))
                {
                    <div class="flex gap" style="flex-wrap:wrap;">
                        <input @bind="_directedConversionReason" placeholder="Why this directed unit can enter volunteer inventory" style="flex:1;min-width:12rem;" />
                        <div class="field" style="min-width:16rem;">
                            <label>Second verifier</label>
                            <FilterableComboBox TItem="DirectoryUserDto" TValue="string?"
                                Items="VerifierChoices"
                                @bind-Value="_directedConversionVerifier"
                                DisplayText="@(x => x.Label)"
                                ItemValue="@(x => x.UserName)"
                                SearchText="@(x => x.Label)"
                                Clearable="true"
                                Placeholder="Different active user" />
                        </div>
                        <button class="btn btn-secondary btn-sm" disabled="@(_busy || string.IsNullOrWhiteSpace(_directedConversionReason))" @onclick="() => ConvertDirectedAsync(_unit.Id)">Convert to allogeneic</button>
                    </div>
                }

                @if (Session.Has(PermissionCodes.InventoryTransfer))
                {
                    <div class="flex gap">
                        <select @bind="_transferTo"><option value="0">— location —</option>@foreach (var l in _locations) { <option value="@l.Id">@l.ChoiceLabel</option> }</select>
                        <p class="muted">The location code stays on the choice. A blank name stays the location id.</p>
                        <input @bind="_transferReason" placeholder="Reason (optional)" />
                        <button class="btn btn-secondary btn-sm" disabled="@(_busy || _transferTo == 0)" @onclick="() => TransferAsync(_unit.Id)">Transfer</button>
                    </div>
                }

                @if (Session.Has(PermissionCodes.InventoryDiscard))
                {
                    <div class="flex gap" style="flex-wrap:wrap;">
                        <input @bind="_discardReason" placeholder="Discard reason" style="flex:1;min-width:12rem;" />
                        <div class="field" style="min-width:16rem;">
                            <label>Second verifier</label>
                            <FilterableComboBox TItem="DirectoryUserDto" TValue="string?"
                                Items="VerifierChoices"
                                @bind-Value="_discardSecondVerifier"
                                DisplayText="@(x => x.Label)"
                                ItemValue="@(x => x.UserName)"
                                SearchText="@(x => x.Label)"
                                Clearable="true"
                                Placeholder="Different active user" />
                        </div>
                        <button class="btn btn-danger btn-sm" disabled="@(_busy || string.IsNullOrWhiteSpace(_discardReason))" @onclick="() => DiscardAsync(_unit.Id)">Discard</button>
                    </div>
                }
            </div>
        </div>
    }

    @if (_tab == "attributes")
    {
        <div class="bb-card">
            <div class="bb-card-title"><h3>Blood attributes</h3></div>
            <p class="muted">Antigen and antibody typing on this unit. Record supplier label typings or in-house results. Contributing tests post as Test result.</p>
            @if (_unitAttributes.Count == 0)
            {
                <div class="muted">No extended typing on record.</div>
            }
            else
            {
                <table class="bb">
                    <thead><tr><th>Kind</th><th>Antigen</th><th>Antibody</th><th>Result</th><th>Source</th><th>Recorded</th><th>By</th></tr></thead>
                    <tbody>
                        @foreach (var a in _unitAttributes)
                        {
                            <tr>
                                <td>@a.AttributeKind</td>
                                <td class="mono">@a.AntigenCode — @a.AntigenName</td>
                                <td>@a.AntibodyName</td>
                                <td>@a.Result</td>
                                <td>@TypingSourceLabel(a.TypingSource)</td>
                                <td class="nowrap">@a.CreatedUtc.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>@(string.IsNullOrWhiteSpace(a.CreatedBy) ? "—" : a.CreatedBy)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            @if (Session.Has(PermissionCodes.InventoryReceive))
            {
                <div class="form-row" style="margin-top:.5rem;">
                    <div class="field"><label>Attribute</label>
                        <FilterableComboBox TItem="BloodAttributeListItemDto" TValue="long?"
                                            Items="_bloodAttributeCatalog"
                                            @bind-Value="_uaCatalogId"
                                            DisplayText="@(a => $"{a.Name} ({a.Code})")"
                                            ItemValue="@(a => a.Id)"
                                            Placeholder="Select" />
                    </div>
                    <div class="field"><label>Kind</label>
                        <select @bind="_uaKind">@foreach (var k in Enum.GetValues<BloodAttributeKind>()) { <option value="@k">@k</option> }</select>
                    </div>
                    <div class="field"><label>Result</label>
                        <select @bind="_uaResult">@foreach (var r in Enum.GetValues<AntigenResult>()) { <option value="@r">@r</option> }</select>
                    </div>
                    <div class="field"><label>Source</label>
                        <select @bind="_uaSource">
                            <option value="@UnitAttributeTypingSource.Supplier">Supplier</option>
                            <option value="@UnitAttributeTypingSource.InHouse">In-house</option>
                        </select>
                    </div>
                </div>
                <button class="btn btn-secondary btn-sm" disabled="@(_busy || _uaCatalogId is null)" @onclick="() => SaveUnitAttributeAsync(_unit.Id)">Save attribute</button>
            }
        </div>
    }

    @if (_tab == "history")
    {
        <div class="bb-card">
            <div class="bb-card-title"><h3>Status history</h3></div>
            <p class="muted">Actions performed on this unit — receive, allocate, crossmatch, issue, return, transfuse, modifications, and status changes. An allocation, an issue, a crossmatch, a transfusion, a return, and an order-linked modification name the patient the same way, including the medical record number when it is recorded. An issue names the storage location when the issued-to place is that location's code. A blank location name stays the location id. A place that is not one location code stays as typed. A blank place is omitted. A missing or blank name stays the patient id. A return whose issue cannot be read, and a modification whose order cannot be read, do not invent a patient. A bench modification that no product order points at says no patient order was recorded. A bench row that a product order points at names that patient the same way. A status row linked to a modification names that patient the same way and does not change the recorded reason. A status row with no modification id does not invent a patient. A missing order does not invent a patient. Linked orders that do not name one patient do not pick one. A blank reason is omitted. A move names the storage locations. A blank location name stays the location id. A row that stays in the same place does not say it moved. Use this trail for product dispositions.</p>
            @if (_activity.Count == 0)
            {
                <div class="muted">No activity.</div>
            }
            else
            {
                <table class="bb">
                    <thead><tr><th>When</th><th>Event</th><th>Detail</th><th>By</th></tr></thead>
                    <tbody>
                        @foreach (var row in _activity)
                        {
                            <tr>
                                <td class="nowrap">@row.WhenUtc.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>@row.EventType</td>
                                <td>@row.Summary</td>
                                <td>@(row.ChangedBy ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    }

    @if (_tab == "retype")
    {
        <div class="bb-card">
            <div class="bb-card-title"><h3>Retype</h3></div>
            <p class="muted" style="margin:0 0 .5rem;">
                The pending retype board is the product-retype desk.
                <a href="@($"/inventory?board=retype&unitId={_unit.Id}#pending-retype")">Open this unit on the board</a>
                if you want the worklist context. Recording here still uses the same panel and gates.
            </p>
            @if (_retypeDetail is null)
            {
                <div class="muted">Unable to load retype details for this unit.</div>
            }
            else
            {
                <ProductRetypeEntryPanel Detail="_retypeDetail" OnSaved="OnRetypeSaved" EntryInDialog="true" />
            }
        </div>
    }
}

@code {
    [Parameter] public long UnitId { get; set; }
    [SupplyParameterFromQuery(Name = "tab")] public string? TabQuery { get; set; }

