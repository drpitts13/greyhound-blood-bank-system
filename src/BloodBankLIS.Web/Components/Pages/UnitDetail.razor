    private IEnumerable<DirectoryUserDto> VerifierChoices =>
        _directoryUsers.Where(u => !string.Equals(u.UserName, Session.UserName, StringComparison.OrdinalIgnoreCase));

    private bool IssuedCanReturnToAvailable =>
        _selectedIssuedUtc is DateTime issued
        && ReturnReissueRule.IsWithinReturnToAvailableWindow(
            issued, DateTime.UtcNow, ReturnReissueRule.DefaultReturnToAvailableMinutes);

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrWhiteSpace(TabQuery) && KnownTabs.Contains(TabQuery))
        {
            _tab = TabQuery.Trim().ToLowerInvariant();
        }

        if (_loadedId == UnitId && _unit is not null)
        {
            return;
        }

        _loadedId = UnitId;
        await LoadAsync();
    }

    private Task SelectTab(string tab)
    {
        _tab = tab;
        var href = InventoryUrls.Unit(UnitId, tab == "overview" ? null : tab);
        if (!Nav.Uri.EndsWith(href, StringComparison.OrdinalIgnoreCase)
            && !Nav.ToBaseRelativePath(Nav.Uri).Equals(href.TrimStart('/'), StringComparison.OrdinalIgnoreCase))
        {
            Nav.NavigateTo(href, replace: true);
        }

        return Task.CompletedTask;
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        var policy = await Api.GetReceivePolicyAsync();
        _requireReceiveVerifier = policy.Succeeded && policy.Value?.RequireSecondVerifier == true;
        if (_productTypes.Count == 0)
        {
            _productTypes = (await Api.GetProductTypesAsync()).Value ?? new();
        }

        if (_locations.Count == 0)
        {
            _locations = (await Api.GetLocationsAsync()).Value ?? new();
        }

        if (_directoryUsers.Count == 0)
        {
            var users = await Api.GetDirectoryUsersAsync();
            if (users.Succeeded) _directoryUsers = users.Value ?? new();
        }

        if (_patients.Count == 0)
        {
            var patients = await Api.GetPatientsAsync();
            if (patients.Succeeded) _patients = patients.Value ?? new();
        }

        if (_bloodAttributeCatalog.Count == 0)
        {
            _bloodAttributeCatalog = (await Api.GetReferenceBloodAttributesAsync()).Value ?? new();
        }

        var r = await Api.GetUnitAsync(UnitId);
        if (!r.Succeeded || r.Value is null)
        {
            _unit = null;
            _error = r.FailureSummary() ?? "Unit not found.";
            _loading = false;
            return;
        }

        _unit = r.Value;
        await RefreshDetailsAsync();
        _loading = false;
    }

    private async Task RefreshDetailsAsync()
    {
        if (_unit is null) return;
        var id = _unit.Id;
        var unit = await Api.GetUnitAsync(id);
        if (unit.Succeeded && unit.Value is not null) _unit = unit.Value;

        _activity = (await Api.GetUnitActivityAsync(id)).Value ?? new();
        _unitAttributes = (await Api.GetUnitBloodAttributesAsync(id)).Value ?? new();
        _retypeDetail = (await Api.GetUnitRetypeAsync(id)).Value;
        _allocatableOrders = (await Api.GetUnitAllocatableOrdersAsync(id)).Value ?? new();
        _eligibleMods = (await Api.GetEligibleModificationsAsync(id)).Value ?? new();
        _selectedIssueId = null;
        _selectedIssuedUtc = null;
        if (_unit.Status == UnitStatus.Issued)
        {
            var outstanding = await Api.GetOutstandingIssuesAsync();
            var row = outstanding.Value?.FirstOrDefault(i => i.BloodUnitId == id);
            _selectedIssueId = row?.IssueId;
            _selectedIssuedUtc = row?.IssuedUtc
                ?? _activity.LastOrDefault(a => a.EventType == "Issue")?.WhenUtc;
            _changeStatusDestination = IssuedCanReturnToAvailable ? UnitStatus.Available : UnitStatus.Quarantine;
        }
    }

    private string ProductCode(BloodUnitDto u)
    {
        if (!string.IsNullOrWhiteSpace(u.ProductDescriptionCode)) return u.ProductDescriptionCode;
        if (!string.IsNullOrWhiteSpace(u.ProductCodeData) && u.ProductCodeData.Length >= 5) return u.ProductCodeData[..5];
        if (!string.IsNullOrWhiteSpace(u.Isbt128ProductCode))
        {
            return u.Isbt128ProductCode.Length >= 5 ? u.Isbt128ProductCode[..5] : u.Isbt128ProductCode;
        }

        return _productTypes.FirstOrDefault(t => t.Id == u.ProductTypeId)?.DisplayProductCode
            ?? u.ProductTypeId.ToString();
    }

    private string ProductName(long productTypeId) =>
        _productTypes.FirstOrDefault(t => t.Id == productTypeId)?.Name ?? "—";

    private string LocationName(long? id) =>
        StorageLocationLabel.ForUnitChart(
            id,
            _locations.Select(l => new StorageLocationLabel.CatalogLocation(l.Id, l.Name, l.Code)));

    private string RecipientLabel(long patientId)
    {
        var p = _patients.FirstOrDefault(x => x.Id == patientId);
        return p is null ? $"patient #{patientId}" : $"{p.LastName}, {p.FirstName} ({p.MedicalRecordNumber})";
    }

    private static string TypingSourceLabel(UnitAttributeTypingSource source) => source switch
    {
        UnitAttributeTypingSource.Supplier => "Supplier",
        UnitAttributeTypingSource.InHouse => "In-house",
        UnitAttributeTypingSource.TestResult => "Test result",
        _ => source.ToString()
    };

    private static string ModifyHref(long unitId, long ruleId)
    {
        var href = $"/inventory/modify?unitId={unitId}";
        return ruleId > 0 ? $"{href}&ruleId={ruleId}" : href;
    }

    private static bool CanPlaceOnHold(UnitStatus status) => status is
        UnitStatus.Available or UnitStatus.Selected or UnitStatus.Assigned or UnitStatus.Allocated
        or UnitStatus.Crossmatched or UnitStatus.Received or UnitStatus.Returned
        or UnitStatus.Transferred or UnitStatus.CancelledAssignment;

    private static bool CanQuarantine(UnitStatus status) =>
        CanPlaceOnHold(status) || status == UnitStatus.OnHold;

    private static bool CanMarkMissing(UnitStatus status) => status is
        UnitStatus.Available or UnitStatus.Selected or UnitStatus.Assigned or UnitStatus.Allocated
        or UnitStatus.Crossmatched or UnitStatus.Received or UnitStatus.Returned
        or UnitStatus.Transferred or UnitStatus.CancelledAssignment or UnitStatus.Quarantine
        or UnitStatus.OnHold or UnitStatus.Expected or UnitStatus.Recalled;

    private static bool CanMarkDamaged(UnitStatus status) => status is
        UnitStatus.Available or UnitStatus.Selected or UnitStatus.Assigned or UnitStatus.Allocated
        or UnitStatus.Crossmatched or UnitStatus.Received or UnitStatus.Returned
        or UnitStatus.Transferred or UnitStatus.CancelledAssignment or UnitStatus.Quarantine
        or UnitStatus.OnHold or UnitStatus.Missing;

    private static bool CanReturnToSupplier(UnitStatus status) => status is
        UnitStatus.Received or UnitStatus.Quarantine or UnitStatus.OnHold
        or UnitStatus.Available or UnitStatus.Damaged;

    private static bool CanConvertDirected(BloodUnitDto u) =>
        u.DonationRestriction == DonationRestriction.Directed
        && AutologousDirectedRule.IsConvertibleStatus(u.Status);

    private async Task AfterActionAsync<T>(ApiResult<T> r, string success)
    {
        _actionFb = r.ToFeedback(success);
        if (r.Succeeded) await RefreshDetailsAsync();
    }

    private async Task AllocateSelectedAsync(BloodUnitDto unit)
    {
        var order = _allocatableOrders.FirstOrDefault(o => o.OrderId == _allocateOrderId);
        if (order is null)
        {
            _actionFb = Feedback.Fail("Select an open order that includes this product.");
            return;
        }

        if (_showAllocOverride && (string.IsNullOrWhiteSpace(_allocOverrideReason) || string.IsNullOrWhiteSpace(_allocAuthorizedBy)))
        {
            _actionFb = Feedback.Fail("An override reason and authorizer are required to reserve a unit that is not antigen-negative.");
            return;
        }

        _busy = true;
        var r = await Api.AllocatePatientUnitAsync(order.PatientId, new AllocatePatientUnitRequest(
            unit.Id,
            SpecimenId: order.SpecimenId,
            OrderId: order.OrderId,
            OverrideReason: _showAllocOverride ? _allocOverrideReason.Trim() : null,
            AuthorizedBy: _showAllocOverride ? _allocAuthorizedBy.Trim() : null));
        _busy = false;
        if (r.Blocked && r.Overridable)
        {
            _showAllocOverride = true;
            if (string.IsNullOrWhiteSpace(_allocAuthorizedBy))
            {
                _allocAuthorizedBy = Session.UserName ?? string.Empty;
            }

            _actionFb = r.ToFeedback();
            return;
        }

        if (r.Succeeded)
        {
            _showAllocOverride = false;
            _allocOverrideReason = string.Empty;
            _allocAuthorizedBy = string.Empty;
        }

        await AfterActionAsync(r, "Unit allocated to the selected order.");
        if (r.Succeeded && r.Value?.AutoThawEligible == true)
        {
            _autoThawPatientId = order.PatientId;
            _autoThawAllocationId = r.Value.Allocation.AllocationId;
            _autoThawProductCode = r.Value.Allocation.AutoThawProductCode ?? r.Value.Allocation.ProductCode;
            _autoThawLocal = LocalMinuteNow();
        }
    }

    private async Task ConfirmUnitAutoThawAsync(long allocationId)
    {
        var thawUtc = DateTime.SpecifyKind(_autoThawLocal, DateTimeKind.Local).ToUniversalTime();
        _busy = true;
        var result = await Api.ApplyAutoThawAsync(_autoThawPatientId, allocationId, thawUtc);
        _busy = false;
        _autoThawAllocationId = null;
        if (!result.Succeeded || result.Value is null)
        {
            _actionFb = result.ToFeedback();
            return;
        }

        _actionFb = result.Value.PrintSucceeded
            ? Feedback.Succeed($"Auto thawed. Product ID tag sent to the printer. Expiration is {result.Value.ExpiresUtc.ToLocalTime():yyyy-MM-dd HH:mm}.")
            : Feedback.Fail($"Auto thawed, but the product ID tag did not print. {result.Value.PrintError}");
        await RefreshDetailsAsync();
    }

    private async Task DeclineUnitAutoThawAsync(long allocationId)
    {
        _busy = true;
        var result = await Api.DeclineAutoThawAsync(_autoThawPatientId, allocationId);
        _busy = false;
        _autoThawAllocationId = null;
        _actionFb = result.Succeeded
            ? Feedback.Succeed("Auto thaw was not applied. Use Auto thaw on the patient's allocated products when you are ready.")
            : result.ToFeedback();
    }

    private static DateTime LocalMinuteNow()
    {
        var now = DateTime.Now;
        return new DateTime(now.Year, now.Month, now.Day, now.Hour, now.Minute, 0, DateTimeKind.Local);
    }

    private async Task ChangeIssuedStatusAsync(long unitId)
    {
        if (string.IsNullOrWhiteSpace(_changeStatusReason))
        {
            _actionFb = Feedback.Fail("A reason is required to change status.");
            return;
        }

        _busy = true;
        var r = await Api.ChangeIssuedUnitStatusAsync(unitId, new ReturnUnitRequest(
            _changeStatusReason.Trim(), _changeTempOk, _changeSealOk, _changeVisualOk,
            Destination: _changeStatusDestination));
        _busy = false;
        if (r.Succeeded) _changeStatusReason = string.Empty;
        await AfterActionAsync(r, $"Unit status changed to {_changeStatusDestination}.");
    }

