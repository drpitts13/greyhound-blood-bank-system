@page "/test-worklist"
@inject BloodBankApiClient Api
@inject UserSession Session
@inject NavigationManager Nav

<PageTitle>Test Worklist &middot; Greyhound Blood Bank LIS</PageTitle>

<h1>Test Worklist</h1>
<p class="muted">Pending patient tests and product ABO/Rh retypes. Each row shows current ABO/Rh, antibody history, specimen expiry, electronic-XM eligibility, and an open antibody-identification workup so the bench does not open the chart just to check dating, history, or eXM holds. Expand a row to enter results, or Verify a posted interface/instrument value without re-keying it.</p>

<Outcome Value="_fb" />

<div class="flex gap" style="margin-bottom:1rem;flex-wrap:wrap;">
    <button type="button" class="btn @TabClass("tests")" @onclick='() => SelectTab("tests")'>Patient tests</button>
    <button type="button" class="btn @TabClass("retype")" @onclick='() => SelectTab("retype")'>Retype</button>
</div>

@if (_tab == "tests")
{
<div class="bb-card">
    <div class="bb-card-title">
        <h3>Pending tests</h3>
        <button class="btn btn-secondary btn-sm" @onclick="LoadAsync">Refresh</button>
    </div>

    @if (_loading)
    {
        <div class="loading">Loading worklist...</div>
    }
    else if (_items.Count == 0)
    {
        <div class="empty">No pending tests in the worklist.</div>
    }
    else
    {
        <table class="bb">
            <thead>
                <tr>
                    <th>Patient</th>
                    <th>MRN</th>
                    <th>ABO/Rh</th>
                    <th>Antibodies</th>
                    <th>Test</th>
                    <th>Order #</th>
                    <th>Accession</th>
                    <th>Expires</th>
                    <th>eXM</th>
                    <th>Status</th>
                    <th>Source</th>
                    <th>Priority</th>
                    <th>Ordered</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in _items)
                {
                    <tr class="@RowClass(item)">
                        <td>@item.PatientName</td>
                        <td class="mono">@item.Mrn</td>
                        <td><strong>@(item.CurrentBloodType ?? "—")</strong></td>
                        <td>
                            @if (item.HasAntibodyHistory)
                            {
                                <span class="badge badge-amber" title="@item.AntibodySummary">@item.AntibodySummary</span>
                            }
                            else
                            {
                                <span class="muted">None</span>
                            }
                        </td>
                        <td><strong>@item.TestName</strong> <span class="mono muted">@item.TestCode</span></td>
                        <td class="mono">@item.OrderNumber</td>
                        <td class="mono">@(item.AccessionNumber ?? "—")</td>
                        <td class="nowrap">
                            @if (item.SpecimenExpiresUtc is DateTime expires)
                            {
                                <span class="@(item.SpecimenExpired ? "badge badge-red" : "muted")">@expires.ToString("yyyy-MM-dd HH:mm")</span>
                            }
                            else
                            {
                                <span class="muted">—</span>
                            }
                        </td>
                        <td>
                            @if (item.ElectronicXmEligible)
                            {
                                <span class="badge badge-green">Eligible</span>
                            }
                            else
                            {
                                <span class="badge badge-amber" title="@(item.ElectronicXmClinicalBlockReason ?? item.ElectronicXmBlockReason ?? "Not eligible")">
                                    @(item.FacilityAllowsElectronicCrossmatch || !string.IsNullOrWhiteSpace(item.ElectronicXmClinicalBlockReason) ? "Not eligible" : "Policy off")
                                </span>
                            }
                        </td>
                        <td>
                            @if (item.CurrentResultStatus is not null)
                            {
                                <span class="@Ui.Badge(item.CurrentResultStatus.Value)">@item.CurrentResultStatus</span>
                            }
                            else
                            {
                                <span class="badge badge-gray">Pending</span>
                            }
                        </td>
                        <td>@(item.CurrentResultSource?.ToString() ?? "—")</td>
                        <td>@item.Priority</td>
                        <td class="nowrap">@item.OrderedUtc.ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="right nowrap">
                            <button class="btn btn-ghost btn-sm" @onclick='() => Nav.NavigateTo($"/patients/{item.PatientId}?tab=tests")'>Patient</button>
                            @if (item.HasOpenAntibodyIdWorkup && item.OpenAntibodyIdWorkupId is long workupId)
                            {
                                <button class="btn btn-ghost btn-sm" @onclick='() => Nav.NavigateTo($"/patients/{item.PatientId}/antibody-id/{workupId}")'>ABID</button>
                            }
                            <button class="btn btn-ghost btn-sm" @onclick="() => ToggleEntry(item.OrderLineId)">
                                @(_expandedLineId == item.OrderLineId ? "Hide" : WorklistActionLabel(item))
                            </button>
                        </td>
                    </tr>
                    @if (_expandedLineId == item.OrderLineId)
                    {
                        <tr><td colspan="14">
                            <TestResultEntryPanel WorkItem="item" OnSaved="OnResultSaved" />
                        </td></tr>
                    }
                }
            </tbody>
        </table>
    }
</div>
}

@if (_tab == "retype")
{
<div class="bb-card">
    <div class="bb-card-title">
        <h3>Pending product retypes</h3>
        <button class="btn btn-secondary btn-sm" @onclick="LoadRetypesAsync">Refresh</button>
    </div>

    @if (_retypesLoading)
    {
        <div class="loading">Loading retypes...</div>
    }
    else if (_retypes.Count == 0)
    {
        <div class="empty">No units are waiting for an ABO/Rh retype.</div>
    }
    else
    {
        <table class="bb">
            <thead>
                <tr>
                    <th>Unit #</th>
                    <th>Product</th>
                    <th>Name</th>
                    <th>Test</th>
                    <th>Labeled ABO/Rh</th>
                    <th>Received</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in _retypes)
                {
                    <tr>
                        <td class="mono">@item.UnitNumber</td>
                        <td class="mono">@item.ProductCode</td>
                        <td>@item.ProductName</td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(item.TestCode))
                            {
                                <strong>@(item.TestName ?? item.TestCode)</strong>
                                <span class="mono muted">@item.TestCode</span>
                            }
                            else
                            {
                                <span class="muted">—</span>
                            }
                        </td>
                        <td><strong>@Ui.BloodType(item.Abo, item.RhD)</strong></td>
                        <td class="nowrap">@item.ReceivedUtc.ToString("yyyy-MM-dd HH:mm")</td>
                        <td><span class="@Ui.Badge(item.Status)">@Ui.StatusLabel(item.Status)</span></td>
                        <td class="right nowrap">
                            <button class="btn btn-ghost btn-sm" @onclick="() => ToggleRetype(item.UnitId)">
                                @(_expandedUnitId == item.UnitId ? "Hide" : "Enter")
                            </button>
                        </td>
                    </tr>
                    @if (_expandedUnitId == item.UnitId)
                    {
                        <tr><td colspan="8">
                            @if (_retypeDetail?.UnitId == item.UnitId)
                            {
                                <ProductRetypeEntryPanel Detail="_retypeDetail" OnSaved="OnRetypeSaved" />
                            }
                            else
                            {
                                <div class="loading">Loading retype...</div>
                            }
                        </td></tr>
                    }
                }
            </tbody>
        </table>
    }
</div>
}

@code {
    private string _tab = "tests";
    private List<TestWorkItemDto> _items = new();
    private bool _loading = true;
    private long? _expandedLineId;
    private Feedback? _fb;

    private List<ProductRetypeWorkItemDto> _retypes = new();
    private bool _retypesLoading;
    private bool _retypesLoaded;
    private long? _expandedUnitId;
    private ProductRetypeDetailDto? _retypeDetail;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task SelectTab(string tab)
    {
        _tab = tab;
        if (tab == "retype" && !_retypesLoaded)
        {
            await LoadRetypesAsync();
        }
    }

    private string TabClass(string tab) => _tab == tab ? "btn-primary" : "btn-secondary";

    private async Task LoadAsync()
    {
        _loading = true;
        var r = await Api.GetPendingTestWorklistAsync();
        _loading = false;
        if (!r.Succeeded)
        {
            _fb = r.ToFeedback();
            _items = new();
            return;
        }

        _items = r.Value ?? new();
    }

    private async Task LoadRetypesAsync()
    {
        _retypesLoading = true;
        var r = await Api.GetPendingRetypesAsync();
        _retypesLoading = false;
        _retypesLoaded = true;
        if (!r.Succeeded)
        {
            _fb = r.ToFeedback();
            _retypes = new();
            return;
        }

        _retypes = r.Value ?? new();
    }

    private void ToggleEntry(long orderLineId) =>
        _expandedLineId = _expandedLineId == orderLineId ? null : orderLineId;

    private async Task ToggleRetype(long unitId)
    {
        if (_expandedUnitId == unitId)
        {
            _expandedUnitId = null;
            _retypeDetail = null;
            return;
        }

        _expandedUnitId = unitId;
        var r = await Api.GetUnitRetypeAsync(unitId);
        _retypeDetail = r.Value;
        if (!r.Succeeded) _fb = r.ToFeedback();
    }

    private async Task OnResultSaved()
    {
        _expandedLineId = null;
        await LoadAsync();
    }

    private async Task OnRetypeSaved()
    {
        _expandedUnitId = null;
        _retypeDetail = null;
        await LoadRetypesAsync();
    }

    private static string RowClass(TestWorkItemDto item) =>
        item.Priority is OrderPriority.Stat or OrderPriority.Urgent or OrderPriority.EmergencyRelease or OrderPriority.MassiveTransfusionProtocol
            ? "row-urgent" : string.Empty;

    private static string WorklistActionLabel(TestWorkItemDto item) =>
        item.CurrentResultStatus is ResultStatus.PendingVerification
        && item.CurrentResultSource is ResultSource.Interface or ResultSource.Instrument
            ? "Verify"
            : "Enter";
}
