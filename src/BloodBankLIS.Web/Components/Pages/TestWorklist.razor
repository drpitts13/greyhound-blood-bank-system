@page "/test-worklist"
@inject BloodBankApiClient Api
@inject UserSession Session

<PageTitle>Test Worklist &middot; HemoCore</PageTitle>

<h1>Test Worklist</h1>
<p class="muted">Pending patient tests. Expand a row to enter results, or Verify a value already entered (by a colleague, the instrument, or the interface) without re-keying it.</p>
<details class="bb-help">
    <summary>About this worklist</summary>
    <ul>
        <li>Collected and received tubes that are not yet accepted live on the Specimens tab — receive and accept from the row before result entry.</li>
        <li>Product ABO/Rh retypes are listed on the Retype tab and entered on the Inventory pending-retype board so there is one product-retype desk.</li>
        <li>Each patient-test row shows current ABO/Rh, antibody history, specimen expiry, electronic-XM eligibility, an open antibody-identification workup, a historical ABO/Rh discrepancy on an entered type, and the posted result so the bench does not open the chart just to check dating, history, eXM holds, or the interface value.</li>
        <li>The same Verify cue and Result column appear on the patient Tests tab.</li>
        <li>An order on hold is left off this list; on the chart it says Blocked and does not take a result until it is released.</li>
    </ul>
</details>

<Outcome Value="_fb" />

<div class="flex gap" style="margin-bottom:1rem;flex-wrap:wrap;">
    <button type="button" class="btn @TabClass("tests")" @onclick='() => SelectTab("tests")'>Patient tests</button>
    @if (Session.Has(PermissionCodes.SpecimenAccession))
    {
        <button type="button" class="btn @TabClass("specimens")" @onclick='() => SelectTab("specimens")'>Specimens</button>
    }
    <button type="button" class="btn @TabClass("retype")" @onclick='() => SelectTab("retype")'>Retype</button>
</div>

@if (_tab == "tests")
{
<div class="bb-card">
    <div class="bb-card-title">
        <h3>Pending tests</h3>
        <button class="btn btn-secondary btn-sm" @onclick="LoadAsync">Refresh</button>
    </div>

    @if (!_loading && _items.Count > 0 && Session.Has(PermissionCodes.ResultVerify))
    {
        <div class="flex gap" role="group" aria-label="Show" style="margin-bottom:.5rem;">
            <button type="button" class="btn btn-sm @(_toVerifyOnly ? "btn-secondary" : "btn-primary")" aria-pressed="@(_toVerifyOnly ? "false" : "true")" @onclick="() => _toVerifyOnly = false">All (@_items.Count)</button>
            <button type="button" class="btn btn-sm @(_toVerifyOnly ? "btn-primary" : "btn-secondary")" aria-pressed="@(_toVerifyOnly ? "true" : "false")" @onclick="() => _toVerifyOnly = true" data-to-verify>To verify (@TestWorklistView.ToVerify(_items, Session.UserName).Count)</button>
        </div>
    }

    @if (!_loading && _items.Count > 0)
    {
        <div class="flex gap" style="align-items:flex-end;flex-wrap:wrap;margin-bottom:.5rem;">
            <div class="field" style="max-width:20rem;margin:0;">
                <label>Scan a tube to work its tests</label>
                <input @bind="_tubeScan" @bind:event="oninput" @onkeydown="OnTubeScanKey" placeholder="Scan the label or type the accession" autocomplete="off" data-tube-scan />
            </div>
            @if (_tube.Length > 0)
            {
                var onTube = TestWorklistView.ForTube(_items, _tube).Count;
                <span class="badge badge-blue" data-tube-filter>Tube <span class="mono">@TestWorklistView.TubeLabel(_items, _tube)</span>: @onTube @(onTube == 1 ? "test" : "tests")</span>
                <button type="button" class="btn btn-ghost btn-sm" @onclick="ClearTube">Show all tubes</button>
            }
        </div>
    }

    @if (_loading)
    {
        <div class="loading">Loading worklist...</div>
    }
    else if (_items.Count > 0 && ShownItems.Count == 0 && _tube.Length > 0)
    {
        <div class="empty" data-tube-empty>
            No pending @(_toVerifyOnly ? "results to verify" : "tests") on tube <span class="mono">@_tube</span>. A tube that is not yet accepted is on the Specimens tab;
            an order not linked to it is linked from the chart's Orders tab.
        </div>
    }
    else if (_items.Count > 0 && ShownItems.Count == 0)
    {
        <div class="empty">Nothing is waiting for you to verify. Results you entered yourself are verified by someone else.</div>
    }
    else if (_items.Count == 0)
    {
        <div class="empty">
            No pending tests on this bench. Orders without a linked accepted specimen do not appear here.
            Open the patient chart Tests tab to teach the sequence, or Accession and link on Orders.
        </div>
    }
    else
    {
        <table class="bb">
            <thead>
                <tr>
                    <th>Patient / MRN</th>
                    <th>ABO/Rh</th>
                    <th>Antibodies</th>
                    <th>Test</th>
                    <th>Order / accession</th>
                    <th>eXM</th>
                    <th>Result</th>
                    <th>Priority / ordered</th>
                    <th>Comment</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in ShownItems)
                {
                    <tr class="@RowClass(item)">
                        <td><a href="@($"/patients/{item.PatientId}?tab=tests")">@item.PatientName</a><span class="sub mono">@item.Mrn</span></td>
                        <td><strong>@(item.CurrentBloodType ?? "—")</strong></td>
                        <td>
                            @if (item.HasAntibodyHistory)
                            {
                                <span class="badge badge-amber" title="@item.AntibodySummary">@item.AntibodySummary</span>
                            }
                            else
                            {
                                <span class="muted">None</span>
                            }
                        </td>
                        <td><strong>@item.TestName</strong> <span class="mono muted">@item.TestCode</span>@if (item.ReactionWorkup) { <a class="badge badge-red" style="margin-left:.35rem;" href="@item.ReactionHref" title="This test is part of a transfusion reaction workup; the investigation closes only when it is verified" data-reaction-workup>Reaction workup</a> }</td>
                        <td>
                            <span class="mono">@item.OrderNumber</span>
                            <span class="sub mono">@(item.AccessionNumber ?? "—")</span>
                            @if (item.SpecimenExpiresUtc is DateTime expires)
                            {
                                <span class="@(item.SpecimenExpired ? "badge badge-red" : "sub") nowrap">@expires.ToString("yyyy-MM-dd HH:mm")</span>
                                <VerificationDeadlineBadge Item="item" />
                            }
                            else
                            {
                                <span class="sub">—</span>
                            }
                        </td>
                        <td>
                            @if (item.ElectronicXmEligible)
                            {
                                <span class="badge badge-green">Eligible</span>
                            }
                            else
                            {
                                <span class="badge badge-amber" title="@(item.ElectronicXmClinicalBlockReason ?? item.ElectronicXmBlockReason ?? "Not eligible")">
                                    @(item.FacilityAllowsElectronicCrossmatch || !string.IsNullOrWhiteSpace(item.ElectronicXmClinicalBlockReason) ? "Not eligible" : "Policy off")
                                </span>
                            }
                        </td>
                        <td>
                            @if (item.CurrentResultStatus is not null)
                            {
                                <span class="@Ui.Badge(item.CurrentResultStatus.Value)">@item.CurrentResultStatus</span>
                            }
                            else
                            {
                                <span class="badge badge-gray">Pending</span>
                            }
                            <span class="sub mono">@(item.CurrentResultValue ?? "—")</span>
                            @if (item.AboRhDeltaHold)
                            {
                                <span class="badge badge-amber" title="@(item.AboRhDeltaDetail ?? "ABO/Rh disagrees with history")">Discrepancy</span>
                            }
                            <span class="sub">Source: @(item.CurrentResultSource?.ToString() ?? "—")</span>
                        </td>
                        <td>
                            @if (IsRush(item.Priority))
                            {
                                <span class="badge badge-red">@item.Priority</span>
                            }
                            else
                            {
                                @item.Priority
                            }
                            <span class="sub nowrap">@item.OrderedUtc.ToString("yyyy-MM-dd HH:mm")</span>
                        </td>
                        <td>@(string.IsNullOrWhiteSpace(item.Comment) ? "—" : item.Comment)</td>
                        <td class="right nowrap">
                            <a class="btn btn-ghost btn-sm" href="@($"/patients/{item.PatientId}?tab=tests")">Open chart · Tests</a>
                            @if (item.NeedsSpecimenLink)
                            {
                                <a class="btn btn-ghost btn-sm" href="@item.ChartAccessionHref">Accession</a>
                            }
                            @if (item.OffersAntibodyIdHandoff)
                            {
                                <a class="btn btn-ghost btn-sm" href="@item.AntibodyIdHref">@item.AntibodyIdHandoffLabel</a>
                            }
                            <button class="btn btn-ghost btn-sm" title="@item.BlockReason" @onclick="() => ToggleEntry(item.OrderLineId)">
                                @(_expandedLineId == item.OrderLineId ? "Hide" : item.BenchActionLabelFor(Session.UserName))
                            </button>
                        </td>
                    </tr>
                    @if (_expandedLineId == item.OrderLineId)
                    {
                        <tr><td colspan="10">
                            <TestLineCommentEditor WorkItem="item" />
                            <TestResultEntryPanel WorkItem="item" OnSaved="OnResultSaved" />
                        </td></tr>
                    }
                }
            </tbody>
        </table>
    }
</div>
}

@if (_tab == "specimens" && Session.Has(PermissionCodes.SpecimenAccession))
{
<div class="bb-card">
    <div class="bb-card-title">
        <h3>Pending specimens</h3>
        <button class="btn btn-secondary btn-sm" @onclick="LoadPendingSpecimensAsync">Refresh</button>
    </div>
    <p class="muted">Collected tubes waiting for receipt, and received tubes waiting for acceptance. Result entry and order linking still require Accepted. An expired tube cannot be received or accepted — reject it. Scan a tube to receive it: the scan picks the specimen, so the tube in hand is the one received. Typing filters the list.</p>
    <div class="flex gap" style="align-items:flex-end;flex-wrap:wrap;margin-bottom:.75rem;">
        <div class="field" style="max-width:20rem;margin:0;">
            <label>Scan tube to @(_scanAccepts ? "accept" : "receive")</label>
            <input @bind="_specimenScan" @bind:event="oninput" @onkeydown="OnSpecimenScanKeyAsync" placeholder="Scan accession or label barcode" autocomplete="off" />
        </div>
        <div role="radiogroup" aria-label="What a scan does" class="flex gap" style="align-items:center;">
            <label class="flex" style="gap:.25rem;"><input type="radio" name="scan-mode" checked="@(!_scanAccepts)" @onchange="() => _scanAccepts = false" /> Receive</label>
            <label class="flex" style="gap:.25rem;"><input type="radio" name="scan-mode" checked="@_scanAccepts" @onchange="() => _scanAccepts = true" /> Accept</label>
        </div>
    </div>

    @if (_acceptedTube is { Length: > 0 } accepted)
    {
        var waiting = TestWorklistView.ForTube(_items, accepted).Count;
        <div class="alert alert-info flex gap" style="align-items:center;flex-wrap:wrap;" data-accepted-next>
            <span>Tube <span class="mono">@accepted</span> accepted. @(waiting == 0 ? "No tests are waiting on it yet; link its orders from the chart." : $"{waiting} {(waiting == 1 ? "test is" : "tests are")} waiting on it.")</span>
            @if (waiting > 0)
            {
                <button type="button" class="btn btn-primary btn-sm" @onclick="() => StartTesting(accepted)">Start testing</button>
            }
        </div>
    }

    @if (_specimensLoading)
    {
        <div class="loading">Loading specimens...</div>
    }
    else if (VisiblePendingSpecimens.Count == 0)
    {
        <div class="empty">No collected or received specimens are waiting. In-lab accession still accepts immediately unless Accept now is unchecked on the chart.</div>
    }
    else
    {
        <table class="bb">
            <thead>
                <tr>
                    <th>Patient</th>
                    <th>MRN</th>
                    <th>Accession</th>
                    <th>Type</th>
                    <th>Collected</th>
                    <th>Expires</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in VisiblePendingSpecimens)
                {
                    <tr>
                        <td class="nowrap"><a href="@($"/patients/{row.PatientId}?tab=specimens")">@row.PatientName</a></td>
                        <td class="mono">@row.Mrn</td>
                        <td class="mono">@row.AccessionNumber</td>
                        <td>@row.SpecimenType</td>
                        <td class="nowrap">@row.CollectedUtc.ToString("yyyy-MM-dd HH:mm")@if (!string.IsNullOrWhiteSpace(row.TransitNote)) { <span class="sub">@row.TransitNote</span> }</td>
                        <td class="nowrap">
                            @(row.ExpiresUtc?.ToString("yyyy-MM-dd HH:mm") ?? "—")
                            @if (row.IsExpired)
                            {
                                <span class="badge badge-red">Expired</span>
                            }
                        </td>
                        <td><span class="@Ui.Badge(row.Status)">@row.Status</span></td>
                        <td class="right nowrap">
                            @if (row.IsExpired)
                            {
                                @* An expired tube can no longer be received or accepted; say what to do instead of showing a dead button. *@
                                <span class="badge badge-red" title="The tube expired before it was accepted. Reject it and request a new specimen.">@PendingSpecimenAttentionRule.ExpiredNextStep</span>
                            }
                            else if (row.Status == SpecimenStatus.Collected && Session.Has(PermissionCodes.SpecimenAccession))
                            {
                                @if (_receiptByScanOnly)
                                {
                                    <span class="sub" title="Your facility requires receipt by scan">Scan to receive</span>
                                }
                                else
                                {
                                    <button class="btn btn-primary btn-sm" disabled="@_busy" @onclick="() => ReceivePendingAsync(row.SpecimenId)">Receive</button>
                                }
                            }
                            else if (row.Status == SpecimenStatus.Received && Session.Has(PermissionCodes.SpecimenAccession))
                            {
                                <button class="btn btn-primary btn-sm" disabled="@_busy" @onclick="() => AcceptPendingAsync(row.SpecimenId)">Accept</button>
                            }
                            @if (Session.Has(PermissionCodes.SpecimenReject) && _rejectingSpecimenId != row.SpecimenId)
                            {
                                <button class="btn @(row.IsExpired ? "btn-danger" : "btn-ghost") btn-sm" disabled="@_busy" @onclick="() => _rejectingSpecimenId = row.SpecimenId">Reject</button>
                            }
                            <a class="btn btn-ghost btn-sm" href="@($"/patients/{row.PatientId}?tab=specimens")">Chart</a>
                        </td>
                    </tr>
                    @if (_rejectingSpecimenId == row.SpecimenId && Session.Has(PermissionCodes.SpecimenReject))
                    {
                        <tr>
                            <td colspan="8">
                                <div class="flex gap" style="flex-wrap:wrap;">
                                    <SpecimenRejectReasonPicker @bind-Code="_rejectReason" @bind-Comment="_rejectComment" />
                                    <button class="btn btn-danger btn-sm" disabled="@(_busy || string.IsNullOrWhiteSpace(_rejectReason))" @onclick="() => RejectPendingAsync(row.SpecimenId)">Confirm reject</button>
                                    <button class="btn btn-secondary btn-sm" @onclick="() => { _rejectingSpecimenId = null; _rejectReason = string.Empty; _rejectComment = string.Empty; }">Cancel</button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    }
</div>
}

@if (_tab == "retype")
{
<div class="bb-card">
    <div class="bb-card-title">
        <h3>Pending product retypes</h3>
        <div class="flex gap">
            <a class="btn btn-primary btn-sm" href="/inventory?board=retype#pending-retype">Open retype desk</a>
            <button class="btn btn-secondary btn-sm" @onclick="LoadRetypesAsync">Refresh</button>
        </div>
    </div>
    <p class="muted">Same units as Inventory → Pending ABO/Rh retype. Enter there so students and operators use one product-retype desk. This list stays so the bench can see what is waiting without leaving the worklist.</p>

    @if (_retypesLoading)
    {
        <div class="loading">Loading retypes...</div>
    }
    else if (_retypes.Count == 0)
    {
        <div class="empty">No units are waiting for an ABO/Rh retype.</div>
    }
    else
    {
        <table class="bb">
            <thead>
                <tr>
                    <th>Unit #</th>
                    <th>Product</th>
                    <th>Name</th>
                    <th>Test</th>
                    <th>Labeled ABO/Rh</th>
                    <th>Received</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in _retypes)
                {
                    <tr>
                        <td class="mono">@item.UnitNumber</td>
                        <td class="mono">@item.ProductCode</td>
                        <td>@item.ProductName</td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(item.TestCode))
                            {
                                <strong>@(item.TestName ?? item.TestCode)</strong>
                                <span class="mono muted">@item.TestCode</span>
                            }
                            else
                            {
                                <span class="muted">—</span>
                            }
                        </td>
                        <td><strong>@Ui.BloodType(item.Abo, item.RhD)</strong></td>
                        <td class="nowrap">@item.ReceivedUtc.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            <span class="@Ui.Badge(item.Status)">@Ui.StatusLabel(item.Status)</span>
                            @if (item.Expired)
                            {
                                <span class="badge badge-red" title="A matching retype records the type and moves this unit to Expired.">Outdated</span>
                            }
                        </td>
                        <td class="right nowrap">
                            <a class="btn btn-primary btn-sm" href="@($"/inventory?board=retype&unitId={item.UnitId}#pending-retype")">Enter on Inventory</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
}

@code {
    private string _tab = "tests";
    private List<TestWorkItemDto> _items = new();
    // Only the lines this user can verify now (a colleague's, the instrument's, or the interface's result).
    private bool _toVerifyOnly;
    // The tube in hand: only its lines are shown (normalized accession; empty for all tubes).
    private string _tube = string.Empty;
    private string _tubeScan = string.Empty;
    // The tube accepted last on the Specimens tab, offered as the next thing to test.
    private string? _acceptedTube;
    private IReadOnlyList<TestWorkItemDto> ShownItems => TestWorklistView.ForTube(
        _toVerifyOnly ? TestWorklistView.ToVerify(_items, Session.UserName) : _items, _tube);

    [SupplyParameterFromQuery(Name = "accession")]
    public string? AccessionQuery { get; set; }

    [SupplyParameterFromQuery(Name = "show")]
    public string? ShowQuery { get; set; }
    private bool _loading = true;
    private long? _expandedLineId;
    private Feedback? _fb;

    private List<ProductRetypeWorkItemDto> _retypes = new();
    private bool _retypesLoading;
    private bool _retypesLoaded;
    private List<PendingSpecimenWorkItemDto> _pendingSpecimens = new();
    private bool _specimensLoading;
    private bool _specimensLoaded;
    private bool _busy;
    private string _specimenScan = string.Empty;
    // OCD-056: when the facility requires receipt by scan, rows offer no Receive button.
    private bool _receiptByScanOnly;
    // What a scan does on the pending list: receive (default) or accept. Accepting is a deliberate mode.
    private bool _scanAccepts;
    private long? _rejectingSpecimenId;
    private string _rejectReason = string.Empty;
    private string _rejectComment = string.Empty;

    [SupplyParameterFromQuery(Name = "tab")]
    public string? TabQuery { get; set; }

    private IReadOnlyList<PendingSpecimenWorkItemDto> VisiblePendingSpecimens
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_specimenScan))
            {
                return _pendingSpecimens;
            }

            var q = _specimenScan.Trim();
            return _pendingSpecimens
                .Where(s => s.AccessionNumber.Contains(q, StringComparison.OrdinalIgnoreCase)
                    || s.Mrn.Contains(q, StringComparison.OrdinalIgnoreCase)
                    || s.PatientName.Contains(q, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _toVerifyOnly = string.Equals(ShowQuery, "verify", StringComparison.OrdinalIgnoreCase);
        _tube = TestWorklistView.NormalizeTube(AccessionQuery);
        var scanOnly = await Api.GetFacilityPolicyFlagAsync(FacilityPolicyKeys.RequireSpecimenReceiptByScan);
        _receiptByScanOnly = scanOnly.Succeeded && scanOnly.Value?.Enabled == true;
        if (string.Equals(TabQuery, "retype", StringComparison.OrdinalIgnoreCase))
        {
            _tab = "retype";
            await LoadRetypesAsync();
        }
        else if (string.Equals(TabQuery, "specimens", StringComparison.OrdinalIgnoreCase))
        {
            _tab = "specimens";
            await LoadPendingSpecimensAsync();
        }

        await LoadAsync();
    }

    private async Task SelectTab(string tab)
    {
        _tab = tab;
        if (tab == "retype" && !_retypesLoaded)
        {
            await LoadRetypesAsync();
        }
        else if (tab == "specimens" && !_specimensLoaded)
        {
            await LoadPendingSpecimensAsync();
        }
    }

    private string TabClass(string tab) => _tab == tab ? "btn-primary" : "btn-secondary";

    private async Task LoadAsync()
    {
        _loading = true;
        var r = await Api.GetPendingTestWorklistAsync();
        _loading = false;
        if (!r.Succeeded)
        {
            _fb = r.ToFeedback();
            _items = new();
            return;
        }

        _items = r.Value ?? new();
    }

    private async Task LoadRetypesAsync()
    {
        _retypesLoading = true;
        var r = await Api.GetPendingRetypesAsync();
        _retypesLoading = false;
        _retypesLoaded = true;
        if (!r.Succeeded)
        {
            _fb = r.ToFeedback();
            _retypes = new();
            return;
        }

        _retypes = r.Value ?? new();
    }

    private async Task LoadPendingSpecimensAsync()
    {
        _specimensLoading = true;
        var r = await Api.GetPendingSpecimensAsync();
        _specimensLoading = false;
        _specimensLoaded = true;
        if (!r.Succeeded)
        {
            _fb = r.ToFeedback();
            _pendingSpecimens = new();
            return;
        }

        _pendingSpecimens = r.Value ?? new();
    }

    // A scanner ends with Enter: receive the tube the scan names, then clear the field for the next tube.
    private async Task OnSpecimenScanKeyAsync(KeyboardEventArgs e)
    {
        if (e.Key != "Enter" || string.IsNullOrWhiteSpace(_specimenScan) || _busy)
        {
            return;
        }

        _busy = true;
        var r = _scanAccepts
            ? await Api.AcceptSpecimenByScanAsync(_specimenScan)
            : await Api.ReceiveSpecimenByScanAsync(_specimenScan);
        _busy = false;
        var verb = _scanAccepts ? "Accepted" : "Received";
        _fb = r.ToFeedback(r.Value is null ? $"{verb}." : $"{verb} {r.Value.AccessionNumber}. Scan the next tube.");
        if (r.Succeeded)
        {
            _specimenScan = string.Empty;
            await LoadPendingSpecimensAsync();
            if (_scanAccepts)
            {
                await OfferTestingAsync(r.Value?.AccessionNumber);
            }
        }
    }

    private async Task ReceivePendingAsync(long specimenId)
    {
        _busy = true;
        var r = await Api.ReceiveSpecimenAsync(specimenId);
        _busy = false;
        _fb = r.ToFeedback("Specimen received in the blood bank.");
        if (r.Succeeded) await LoadPendingSpecimensAsync();
    }

    private async Task AcceptPendingAsync(long specimenId)
    {
        _busy = true;
        var r = await Api.AcceptSpecimenAsync(specimenId);
        _busy = false;
        _fb = r.ToFeedback("Specimen accepted for testing.");
        if (r.Succeeded)
        {
            await LoadPendingSpecimensAsync();
            await OfferTestingAsync(r.Value?.AccessionNumber);
        }
    }

    private async Task RejectPendingAsync(long specimenId)
    {
        _busy = true;
        var r = await Api.RejectSpecimenAsync(specimenId, _rejectReason, _rejectComment);
        _busy = false;
        _fb = r.ToFeedback("Specimen rejected.");
        if (r.Succeeded)
        {
            _rejectingSpecimenId = null;
            _rejectReason = string.Empty;
            _rejectComment = string.Empty;
            await LoadPendingSpecimensAsync();
        }
    }

    // After a tube is accepted its tests are the next work: reload the list so the count is current.
    private async Task OfferTestingAsync(string? accession)
    {
        _acceptedTube = string.IsNullOrWhiteSpace(accession) ? null : TestWorklistView.NormalizeTube(accession);
        if (_acceptedTube is not null)
        {
            await LoadAsync();
        }
    }

    private void StartTesting(string accession)
    {
        _tab = "tests";
        _toVerifyOnly = false;
        _acceptedTube = null;
        ShowTube(accession);
    }

    // A scanner ends with Enter: show that tube's tests and open the first one that can take a result.
    private void OnTubeScanKey(KeyboardEventArgs e)
    {
        if (e.Key != "Enter" || string.IsNullOrWhiteSpace(_tubeScan))
        {
            return;
        }

        ShowTube(_tubeScan);
        _tubeScan = string.Empty;
    }

    private void ShowTube(string accession)
    {
        _tube = TestWorklistView.NormalizeTube(accession);
        var first = TestWorklistView.FirstToWork(ShownItems);
        _expandedLineId = first?.OrderLineId;
        _fb = first is null
            ? null
            : Feedback.Succeed($"Tube {TestWorklistView.TubeLabel(_items, _tube)}: {ShownItems.Count} {(ShownItems.Count == 1 ? "test" : "tests")}. Opened {first.TestName}.");
    }

    private void ClearTube()
    {
        _tube = string.Empty;
        _expandedLineId = null;
    }

    private void ToggleEntry(long orderLineId) =>
        _expandedLineId = _expandedLineId == orderLineId ? null : orderLineId;

    private async Task OnResultSaved()
    {
        var savedLineId = _expandedLineId;
        // Follow the rows as shown, so with a tube scanned the next test is on the same tube.
        var previousOrder = ShownItems.Select(i => i.OrderLineId).ToList();
        _expandedLineId = null;
        await LoadAsync();

        // Open the next test below the one just saved, so the bench can key results row after row
        // without an extra click each time. Rows that cannot take a result yet are skipped.
        var next = savedLineId is long savedId
            ? previousOrder
                .SkipWhile(id => id != savedId)
                .Skip(1)
                .Select(id => _items.FirstOrDefault(i => i.OrderLineId == id))
                .FirstOrDefault(i => i is { CanEnterResults: true, NeedsSpecimenLink: false })
            : null;
        _expandedLineId = next?.OrderLineId;

        // The row's own confirmation disappears when it collapses, so confirm at page level.
        if (_fb is null || _fb.Success)
        {
            _fb = Feedback.Succeed(next is null
                ? "Result saved."
                : $"Result saved. Next: {next.TestName} for {next.PatientName}.");
        }
    }

    private static bool IsRush(OrderPriority priority) =>
        priority is OrderPriority.Stat or OrderPriority.Urgent or OrderPriority.EmergencyRelease or OrderPriority.MassiveTransfusionProtocol;

    private static string RowClass(TestWorkItemDto item) =>
        IsRush(item.Priority) ? "row-urgent" : string.Empty;

}
