@page "/compatibility"
@inject BloodBankApiClient Api
@inject UserSession Session

<PageTitle>Compatibility &middot; Greyhound Blood Bank LIS</PageTitle>

<h1>Compatibility Testing</h1>
@if (PatientId is long chartPatientId)
{
    <p>
        <a href="@($"/patients/{chartPatientId}")">Open chart</a>
        <span class="muted"> · Prefill stays on this desk so you do not re-search MRN.</span>
    </p>
}
<p class="muted">Record crossmatches and reserve units for a patient identified by MRN and name, not an internal id. ABO/Rh incompatibility is a hard stop. Electronic XM HardStops while an antibody-identification workup is open. Serologic XM warns (`ABID-XM-OPEN`) and still records. Allocation warns (`ABID-ALLOC-OPEN`) but still reserves so serologic XM can proceed.</p>

<div class="bb-grid cols-2">
    <div class="bb-card">
        <div class="bb-card-title"><h3>Record crossmatch</h3></div>
        @if (_fromRetro)
        {
            <p class="muted">Prefill from retrospective emergency / MTP follow-up. A compatible result closes the issuing queue through the existing post-issue path.</p>
        }
        @if (!Session.Has(PermissionCodes.CompatibilityCrossmatch))
        {
            <div class="muted">You do not have permission to record crossmatches.</div>
        }
        else
        {
            <Outcome Value="_xmFb" RequiresSignature="false" />
            <div class="form-row">
                <div class="field"><label>Unit number</label>
                    <UnitPickerComboBox Scope="UnitPickerScope.Crossmatch" @bind-Value="_xm.BloodUnitId" />
                </div>
                <div class="field"><label>Patient</label>
                    <FilterableComboBox TItem="PatientDto" TValue="long?"
                        Items="_patients"
                        @bind-Value="XmPatientId"
                        @bind-Value:after="LoadXmSpecimensAsync"
                        DisplayText="@(p => $"{p.LastName}, {p.FirstName} ({p.MedicalRecordNumber})")"
                        ItemValue="@(p => p.Id)"
                        SearchText="@(p => $"{p.LastName} {p.FirstName} {p.MedicalRecordNumber}")"
                        Clearable="true"
                        Placeholder="Search MRN or name" />
                </div>
                <div class="field"><label>Specimen</label>
                    <FilterableComboBox TItem="SpecimenDto" TValue="long?"
                        Items="_xmSpecimens"
                        @bind-Value="XmSpecimenId"
                        DisplayText="@FormatSpecimen"
                        ItemValue="@(s => s.Id)"
                        SearchText="@(s => $"{s.AccessionNumber} {s.SpecimenType}")"
                        Clearable="true"
                        Placeholder="Search accession" />
                </div>
                <div class="field"><label>Method</label>
                    <select @bind="_xm.Method">@foreach (var m in Enum.GetValues<CrossmatchMethod>()) { <option value="@m">@m</option> }</select>
                </div>
                <div class="field"><label>Result</label>
                    <select @bind="_xm.Result">@foreach (var r in Enum.GetValues<CrossmatchResult>()) { <option value="@r">@r</option> }</select>
                </div>
                <div class="field"><label>Antibody screen</label>
                    <select @bind="_xm.ScreenNegative"><option value="true">Negative</option><option value="false">Positive</option></select>
                </div>
            </div>
            <div class="field"><label>Comment</label><input @bind="_xm.Comment" /></div>
            <button class="btn btn-primary" disabled="@(_busy || _xm.BloodUnitId is null || _xm.PatientId == 0 || _xm.SpecimenId == 0)" @onclick="RecordCrossmatchAsync">Record crossmatch</button>
            @if (_lastCrossmatch is not null)
            {
                <p class="muted" style="margin-top:.75rem;">
                    Crossmatch #@_lastCrossmatch.Id recorded. Allocate below is prefilled with the same unit, patient, and specimen.
                    <a href="@($"/patients/{_lastCrossmatch.PatientId}?tab=products")">Open chart · Products</a>
                    · <a href="@($"/inventory?unitId={_lastCrossmatch.BloodUnitId}")">Open Inventory</a>
                </p>
            }
        }
    </div>

    <div class="bb-card">
        <div class="bb-card-title"><h3>Allocate unit</h3></div>
        @if (!Session.Has(PermissionCodes.CompatibilityAllocate))
        {
            <div class="muted">You do not have permission to allocate units.</div>
        }
        else
        {
            <Outcome Value="_allocFb" />
            <div class="form-row">
                <div class="field"><label>Unit number</label>
                    <UnitPickerComboBox Scope="UnitPickerScope.Available" @bind-Value="_alloc.BloodUnitId" />
                </div>
                <div class="field"><label>Patient</label>
                    <FilterableComboBox TItem="PatientDto" TValue="long?"
                        Items="_patients"
                        @bind-Value="AllocPatientId"
                        @bind-Value:after="LoadAllocSpecimensAsync"
                        DisplayText="@(p => $"{p.LastName}, {p.FirstName} ({p.MedicalRecordNumber})")"
                        ItemValue="@(p => p.Id)"
                        SearchText="@(p => $"{p.LastName} {p.FirstName} {p.MedicalRecordNumber}")"
                        Clearable="true"
                        Placeholder="Search MRN or name" />
                </div>
                <div class="field"><label>Specimen (optional)</label>
                    <FilterableComboBox TItem="SpecimenDto" TValue="long?"
                        Items="_allocSpecimens"
                        @bind-Value="AllocSpecimenId"
                        DisplayText="@FormatSpecimen"
                        ItemValue="@(s => s.Id)"
                        SearchText="@(s => $"{s.AccessionNumber} {s.SpecimenType}")"
                        Clearable="true"
                        Placeholder="Search accession" />
                </div>
            </div>
            <button class="btn btn-primary" disabled="@(_busy || _alloc.BloodUnitId is null || _alloc.PatientId == 0)" @onclick="AllocateAsync">Reserve unit</button>

            @if (_lastAllocation is not null)
            {
                <div class="alert alert-info" style="margin-top:1rem;">
                    Allocation <strong>#@_lastAllocation.Id</strong> for unit @_lastAllocation.BloodUnitId &mdash; <span class="@Ui.Badge(_lastAllocation.Status)">@_lastAllocation.Status</span>
                    <div class="flex gap" style="margin-top:.5rem;">
                        <input @bind="_releaseReason" placeholder="Release reason" style="flex:1;" />
                        <button class="btn btn-danger btn-sm" disabled="@_busy" @onclick="() => ReleaseAsync(_lastAllocation.Id)">Release</button>
                        @if (Session.Has(PermissionCodes.IssueCreate))
                        {
                            <a class="btn btn-primary btn-sm" href="@($"/issuing?patientId={_lastAllocation.PatientId}&bloodUnitId={_lastAllocation.BloodUnitId}")">Issue</a>
                        }
                        <a class="btn btn-ghost btn-sm" href="@($"/inventory?unitId={_lastAllocation.BloodUnitId}")">Open Inventory</a>
                        <a class="btn btn-ghost btn-sm" href="@($"/patients/{_lastAllocation.PatientId}?tab=products")">Open chart · Products</a>
                    </div>
                </div>
            }
        }
    </div>
</div>

@code {
    private bool _busy;
    private List<PatientDto> _patients = new();
    private List<SpecimenDto> _xmSpecimens = new();
    private List<SpecimenDto> _allocSpecimens = new();

    private XmModel _xm = new();
    private Feedback? _xmFb;

    private long? XmPatientId
    {
        get => _xm.PatientId == 0 ? null : _xm.PatientId;
        set
        {
            var next = value ?? 0;
            if (_xm.PatientId != next)
            {
                _xm.SpecimenId = 0;
            }

            _xm.PatientId = next;
        }
    }

    private long? XmSpecimenId
    {
        get => _xm.SpecimenId == 0 ? null : _xm.SpecimenId;
        set => _xm.SpecimenId = value ?? 0;
    }

    private long? AllocPatientId
    {
        get => _alloc.PatientId == 0 ? null : _alloc.PatientId;
        set
        {
            var next = value ?? 0;
            if (_alloc.PatientId != next)
            {
                _alloc.SpecimenId = 0;
            }

            _alloc.PatientId = next;
        }
    }

    private long? AllocSpecimenId
    {
        get => _alloc.SpecimenId == 0 ? null : _alloc.SpecimenId;
        set => _alloc.SpecimenId = value ?? 0;
    }

    private AllocModel _alloc = new();
    private Feedback? _allocFb;
    private AllocationDto? _lastAllocation;
    private CrossmatchDto? _lastCrossmatch;
    private string _releaseReason = string.Empty;

    [SupplyParameterFromQuery]
    public long? PatientId { get; set; }

    [SupplyParameterFromQuery]
    public long? BloodUnitId { get; set; }

    [SupplyParameterFromQuery]
    public long? SpecimenId { get; set; }

    [SupplyParameterFromQuery(Name = "from")]
    public string? From { get; set; }

    private bool _fromRetro;

    protected override async Task OnInitializedAsync()
    {
        var patients = await Api.GetPatientsAsync();
        _patients = patients.Value ?? new();
        if (!patients.Succeeded)
        {
            _xmFb = patients.ToFeedback();
        }

        _fromRetro = string.Equals(From, "retro", StringComparison.OrdinalIgnoreCase);

        if (PatientId is long patientId)
        {
            _xm.PatientId = patientId;
            _alloc.PatientId = patientId;
            await LoadXmSpecimensAsync();
            await LoadAllocSpecimensAsync();
            if (SpecimenId is not > 0)
            {
                PreferCurrentSpecimen();
            }
        }

        if (BloodUnitId is long bloodUnitId)
        {
            _xm.BloodUnitId = bloodUnitId;
            _alloc.BloodUnitId = bloodUnitId;
        }

        if (SpecimenId is long specimenId)
        {
            _xm.SpecimenId = specimenId;
            _alloc.SpecimenId = specimenId;
        }
    }

    private void PreferCurrentSpecimen()
    {
        var preferred = _xmSpecimens.FirstOrDefault(s =>
            s.Status == SpecimenStatus.Accepted
            && (s.ExpiresUtc is null || s.ExpiresUtc > DateTime.UtcNow))
            ?? _xmSpecimens.FirstOrDefault();
        if (preferred is null) return;
        if (_xm.SpecimenId == 0) _xm.SpecimenId = preferred.Id;
        if (_alloc.SpecimenId == 0) _alloc.SpecimenId = preferred.Id;
    }

    private async Task LoadXmSpecimensAsync()
    {
        if (_xm.PatientId == 0)
        {
            _xmSpecimens = new();
            return;
        }

        var r = await Api.GetPatientSpecimensAsync(_xm.PatientId);
        _xmSpecimens = r.Value ?? new();
        if (!r.Succeeded)
        {
            _xmFb = r.ToFeedback();
        }
    }

    private async Task LoadAllocSpecimensAsync()
    {
        if (_alloc.PatientId == 0)
        {
            _allocSpecimens = new();
            return;
        }

        var r = await Api.GetPatientSpecimensAsync(_alloc.PatientId);
        _allocSpecimens = r.Value ?? new();
        if (!r.Succeeded)
        {
            _allocFb = r.ToFeedback();
        }
    }

    private static string FormatSpecimen(SpecimenDto s)
    {
        var expires = s.ExpiresUtc is DateTime exp ? $" expires {exp:yyyy-MM-dd HH:mm}" : "";
        return $"{s.AccessionNumber} — {s.SpecimenType} ({s.Status}{expires})";
    }

    private async Task RecordCrossmatchAsync()
    {
        _busy = true;
        var req = new RecordCrossmatchRequest(_xm.BloodUnitId!.Value, _xm.PatientId, _xm.SpecimenId, _xm.Method, _xm.Result, _xm.ScreenNegative,
            string.IsNullOrWhiteSpace(_xm.Comment) ? null : _xm.Comment);
        var r = await Api.RecordCrossmatchAsync(req);
        _busy = false;
        if (r.Succeeded && r.Value is not null)
        {
            _lastCrossmatch = r.Value;
            _alloc.BloodUnitId = _xm.BloodUnitId;
            _alloc.PatientId = _xm.PatientId;
            if (_xm.SpecimenId != 0)
            {
                _alloc.SpecimenId = _xm.SpecimenId;
            }

            await LoadAllocSpecimensAsync();
            _xmFb = r.ToFeedback(CrossmatchEntryCopy.Recorded(r.Value.Method, r.Value.Result, r.Value.Id));
        }
        else
        {
            _xmFb = r.ToFeedback();
        }
    }

    private async Task AllocateAsync()
    {
        _busy = true;
        var req = new AllocateUnitRequest(_alloc.BloodUnitId!.Value, _alloc.PatientId, _alloc.SpecimenId == 0 ? null : _alloc.SpecimenId);
        var r = await Api.AllocateUnitAsync(req);
        _busy = false;
        _allocFb = r.ToFeedback("Unit reserved.");
        if (r.Succeeded) _lastAllocation = r.Value;
    }

    private async Task ReleaseAsync(long id)
    {
        _busy = true;
        var r = await Api.ReleaseAllocationAsync(id, _releaseReason);
        _busy = false;
        _allocFb = r.ToFeedback("Allocation released.");
        if (r.Succeeded) _lastAllocation = r.Value;
    }

    private sealed class XmModel
    {
        public long? BloodUnitId { get; set; }
        public long PatientId { get; set; }
        public long SpecimenId { get; set; }
        public CrossmatchMethod Method { get; set; } = CrossmatchMethod.Serologic;
        public CrossmatchResult Result { get; set; } = CrossmatchResult.Compatible;
        public bool ScreenNegative { get; set; } = true;
        public string? Comment { get; set; }
    }

    private sealed class AllocModel
    {
        public long? BloodUnitId { get; set; }
        public long PatientId { get; set; }
        public long SpecimenId { get; set; }
    }
}
