@page "/compatibility"
@inject BloodBankApiClient Api
@inject UserSession Session

<PageTitle>Compatibility &middot; Greyhound Blood Bank LIS</PageTitle>

<h1>Compatibility Testing</h1>
@if (PatientId is long chartPatientId)
{
    <p>
        <a href="@($"/patients/{chartPatientId}")">Open chart</a>
        <span class="muted"> · Prefill stays on this desk so you do not re-search MRN.</span>
    </p>
}
<p class="muted">Record crossmatches and reserve units for a patient. ABO/Rh incompatibility is a hard stop.</p>
<details class="bb-help">
    <summary>Antibody-workup rules</summary>
    <ul>
        <li>Electronic XM is blocked while an antibody-identification workup is open.</li>
        <li>Serologic XM warns (<span class="mono">ABID-XM-OPEN</span>) and still records.</li>
        <li>Allocation warns (<span class="mono">ABID-ALLOC-OPEN</span>) but still reserves so serologic XM can proceed.</li>
    </ul>
</details>

<div class="bb-grid cols-2">
    <div class="bb-card">
        <div class="bb-card-title"><h3>Record crossmatch</h3></div>
        @if (_fromRetro)
        {
            <p class="muted">Prefill from retrospective emergency / MTP follow-up. A compatible result closes the issuing queue through the existing post-issue path.</p>
            @if (!string.IsNullOrWhiteSpace(_retroCustodyNotice))
            {
                <p class="muted">@($"{_retroCustodyNotice}.")</p>
            }
            @if (!string.IsNullOrWhiteSpace(_retroReleaseReason))
            {
                <p class="muted">@_retroReleaseReason</p>
            }
            @if (!string.IsNullOrWhiteSpace(_retroReleaseAuthorizer))
            {
                <p class="muted">@_retroReleaseAuthorizer</p>
            }
            @if (!string.IsNullOrWhiteSpace(_retroIssueAppearance))
            {
                <p class="muted">@_retroIssueAppearance</p>
            }
            @if (!string.IsNullOrWhiteSpace(_retroPtagNotice))
            {
                <p class="muted">@_retroPtagNotice</p>
            }
            @if (!string.IsNullOrWhiteSpace(_retroCrossmatchStatusNotice))
            {
                <p class="muted">@_retroCrossmatchStatusNotice</p>
            }
        }
        @if (!Session.Has(PermissionCodes.CompatibilityCrossmatch) || !Session.Has(PermissionCodes.ResultEnter))
        {
            <div class="muted">Recording a crossmatch needs both the crossmatch and result entry permissions.</div>
        }
        else
        {
            <Outcome Value="_xmFb" RequiresSignature="false" />
            <div class="form-row">
                <div class="field"><label>Unit number</label>
                    <UnitPickerComboBox Scope="UnitPickerScope.Crossmatch" @bind-Value="_xm.BloodUnitId" />
                </div>
                <div class="field"><label>Patient</label>
                    <FilterableComboBox TItem="PatientDto" TValue="long?"
                        Items="_patients"
                        @bind-Value="XmPatientId"
                        @bind-Value:after="LoadXmSpecimensAsync"
                        DisplayText="@(p => $"{p.LastName}, {p.FirstName} ({p.MedicalRecordNumber})")"
                        ItemValue="@(p => p.Id)"
                        SearchText="@(p => $"{p.LastName} {p.FirstName} {p.MedicalRecordNumber}")"
                        Clearable="true"
                        Placeholder="Search MRN or name" />
                </div>
                <div class="field"><label>Specimen</label>
                    <FilterableComboBox TItem="SpecimenDto" TValue="long?"
                        Items="_xmSpecimens"
                        @bind-Value="XmSpecimenId"
                        DisplayText="@FormatSpecimen"
                        ItemValue="@(s => s.Id)"
                        SearchText="@(s => $"{s.AccessionNumber} {s.SpecimenType}")"
                        Clearable="true"
                        Placeholder="Search accession" />
                </div>
                <div class="field"><label>Method</label>
                    <select @bind="_xm.Method" @bind:after="OnXmMethodChanged">@foreach (var m in Enum.GetValues<CrossmatchMethod>()) { <option value="@m">@m</option> }</select>
                </div>
                @if (_xm.Method != CrossmatchMethod.Electronic)
                {
                    <div class="field"><label>Crossmatch test</label>
                        <select value="@_xmTestCode" @onchange="OnXmTestChanged">
                            <option value="">Select test</option>
                            @foreach (var test in _xmTests)
                            {
                                <option value="@test.Code">@test.Code — @test.Name</option>
                            }
                        </select>
                    </div>
                }
                <div class="field"><label>Result</label>
                    <select @bind="_xm.Result">@foreach (var r in Enum.GetValues<CrossmatchResult>()) { <option value="@r">@r</option> }</select>
                </div>
                <div class="field"><label>Antibody screen</label>
                    <select @bind="_xm.ScreenNegative"><option value="true">Negative</option><option value="false">Positive</option></select>
                </div>
            </div>
            @if (_xm.Method != CrossmatchMethod.Electronic && _xmDefinition is not null)
            {
                <CrossmatchReactionFields Subtests="_xmDefinition.PanelSubtests" Values="_xmReactions" ValuesChanged="OnXmReactionsChanged" />
            }
            <div class="field"><label>Comment</label><input @bind="_xm.Comment" /></div>
            <button class="btn btn-primary" disabled="@(_busy || _xm.BloodUnitId is null || _xm.PatientId == 0 || _xm.SpecimenId == 0)" @onclick="RecordCrossmatchAsync">Record crossmatch</button>
            @if (CrossmatchMissing.Count > 0)
            {
                <span class="muted" style="margin-left:.5rem;">Choose @string.Join(", ", CrossmatchMissing) first.</span>
            }
            @if (_lastCrossmatch is not null)
            {
                <p class="muted" style="margin-top:.75rem;">
                    Crossmatch #@_lastCrossmatch.Id recorded. Allocate below is prefilled with the same unit, patient, and specimen.
                    <a href="@($"/patients/{_lastCrossmatch.PatientId}?tab=products")">Open chart · Products</a>
                    · <a href="@InventoryUrls.Unit(_lastCrossmatch.BloodUnitId)">Open Inventory</a>
                </p>
            }
        }
    </div>

    <div class="bb-card">
        <div class="bb-card-title"><h3>Allocate unit</h3></div>
        @if (!Session.Has(PermissionCodes.CompatibilityAllocate))
        {
            <div class="muted">You do not have permission to allocate units.</div>
        }
        else
        {
            <Outcome Value="_allocFb" />
            <div class="form-row">
                <div class="field"><label>Unit number</label>
                    <UnitPickerComboBox Scope="UnitPickerScope.Available" @bind-Value="_alloc.BloodUnitId" />
                </div>
                <div class="field"><label>Patient</label>
                    <FilterableComboBox TItem="PatientDto" TValue="long?"
                        Items="_patients"
                        @bind-Value="AllocPatientId"
                        @bind-Value:after="LoadAllocSpecimensAsync"
                        DisplayText="@(p => $"{p.LastName}, {p.FirstName} ({p.MedicalRecordNumber})")"
                        ItemValue="@(p => p.Id)"
                        SearchText="@(p => $"{p.LastName} {p.FirstName} {p.MedicalRecordNumber}")"
                        Clearable="true"
                        Placeholder="Search MRN or name" />
                </div>
                <div class="field"><label>Specimen (optional)</label>
                    <FilterableComboBox TItem="SpecimenDto" TValue="long?"
                        Items="_allocSpecimens"
                        @bind-Value="AllocSpecimenId"
                        DisplayText="@FormatSpecimen"
                        ItemValue="@(s => s.Id)"
                        SearchText="@(s => $"{s.AccessionNumber} {s.SpecimenType}")"
                        Clearable="true"
                        Placeholder="Search accession" />
                </div>
            </div>
            @if (_showAllocOverride)
            {
                <div class="alert alert-warning" style="margin-top:.75rem;">This unit is not antigen-negative for the patient's antibody. Reserve requires an authorized override.</div>
                <div class="form-row">
                    <div class="field"><label>Override reason</label><input @bind="_allocOverrideReason" /></div>
                    <div class="field"><label>Authorized by</label><input @bind="_allocAuthorizedBy" /></div>
                </div>
            }
            <button class="btn btn-primary" disabled="@(_busy || _alloc.BloodUnitId is null || _alloc.PatientId == 0)" @onclick="AllocateAsync">Reserve unit</button>

            @if (_lastAllocation is not null)
            {
                <div class="alert alert-info" style="margin-top:1rem;">
                    Allocation <strong>#@_lastAllocation.Id</strong> for unit @_lastAllocation.BloodUnitId &mdash; <span class="@Ui.Badge(_lastAllocation.Status)">@_lastAllocation.Status</span>
                    <div class="flex gap" style="margin-top:.5rem;">
                        <input @bind="_releaseReason" placeholder="Release reason" style="flex:1;" />
                        <button class="btn btn-danger btn-sm" disabled="@_busy" @onclick="() => ReleaseAsync(_lastAllocation.Id)">Release</button>
                        @if (Session.Has(PermissionCodes.IssueCreate))
                        {
                            <a class="btn btn-primary btn-sm" href="@($"/issuing?patientId={_lastAllocation.PatientId}&bloodUnitId={_lastAllocation.BloodUnitId}")">Issue</a>
                        }
                        <a class="btn btn-ghost btn-sm" href="@InventoryUrls.Unit(_lastAllocation.BloodUnitId)">Open Inventory</a>
                        <a class="btn btn-ghost btn-sm" href="@($"/patients/{_lastAllocation.PatientId}?tab=products")">Open chart · Products</a>
                    </div>
                </div>
            }
        }
    </div>
</div>

@code {
    private bool _busy;
    private List<PatientDto> _patients = new();
    private List<SpecimenDto> _xmSpecimens = new();
    private List<SpecimenDto> _allocSpecimens = new();

    private XmModel _xm = new();

    private List<string> CrossmatchMissing
    {
        get
        {
            var missing = new List<string>();
            if (_xm.PatientId == 0) missing.Add("a patient");
            if (_xm.SpecimenId == 0) missing.Add("a specimen (accession one on the patient chart if none is listed)");
            if (_xm.BloodUnitId is null) missing.Add("a unit");
            return missing;
        }
    }
    private Feedback? _xmFb;

    private long? XmPatientId
    {
        get => _xm.PatientId == 0 ? null : _xm.PatientId;
        set
        {
            var next = value ?? 0;
            if (_xm.PatientId != next)
            {
                _xm.SpecimenId = 0;
            }

            _xm.PatientId = next;
        }
    }

    private long? XmSpecimenId
    {
        get => _xm.SpecimenId == 0 ? null : _xm.SpecimenId;
        set => _xm.SpecimenId = value ?? 0;
    }

    private long? AllocPatientId
    {
        get => _alloc.PatientId == 0 ? null : _alloc.PatientId;
        set
        {
            var next = value ?? 0;
            if (_alloc.PatientId != next)
            {
                _alloc.SpecimenId = 0;
            }

            _alloc.PatientId = next;
        }
    }

    private long? AllocSpecimenId
    {
        get => _alloc.SpecimenId == 0 ? null : _alloc.SpecimenId;
        set => _alloc.SpecimenId = value ?? 0;
    }

    private AllocModel _alloc = new();
    private Feedback? _allocFb;
    private bool _showAllocOverride;
    private string _allocOverrideReason = string.Empty;
    private string _allocAuthorizedBy = string.Empty;
    private AllocationDto? _lastAllocation;
    private CrossmatchDto? _lastCrossmatch;
    private string _releaseReason = string.Empty;

    [SupplyParameterFromQuery]
    public long? PatientId { get; set; }

    [SupplyParameterFromQuery]
    public long? BloodUnitId { get; set; }

    [SupplyParameterFromQuery]
    public long? SpecimenId { get; set; }

    [SupplyParameterFromQuery(Name = "from")]
    public string? From { get; set; }

    private bool _fromRetro;
    private string? _retroCustodyNotice;
    private string? _retroReleaseReason;
    private string? _retroReleaseAuthorizer;
    private string? _retroIssueAppearance;
    private string? _retroPtagNotice;
    private string? _retroCrossmatchStatusNotice;

    protected override async Task OnInitializedAsync()
    {
        var patients = await Api.GetPatientsAsync();
        _patients = patients.Value ?? new();
        if (!patients.Succeeded)
        {
            _xmFb = patients.ToFeedback();
        }

        _fromRetro = string.Equals(From, "retro", StringComparison.OrdinalIgnoreCase);
        if (_fromRetro && PatientId is long retroPatientId && BloodUnitId is long retroUnitId)
        {
            var pending = await Api.GetPendingRetrospectiveCrossmatchesAsync();
            var match = pending.Value?.FirstOrDefault(row => row.PatientId == retroPatientId && row.BloodUnitId == retroUnitId);
            _retroCustodyNotice = ReadyToIssueFormCue.RetrospectiveFollowUpNotice(match?.IssuedTo, match?.CoolerId, match?.IssuedToLocation, match?.IssuedBy, match?.SecondVerifier);
            _retroReleaseReason = ReadyToIssueFormCue.EmergencyReleaseReasonNotice(match?.EmergencyReleaseDetails);
            _retroReleaseAuthorizer = ReadyToIssueFormCue.EmergencyReleaseAuthorizerNotice(match?.EmergencyReleaseAuthorizer);
            _retroIssueAppearance = match is null ? null : ReadyToIssueFormCue.IssueAppearanceNotice(match.IssueAppearance);
            _retroPtagNotice = ReadyToIssueFormCue.PtagNotice(match?.PtagCode);
            _retroCrossmatchStatusNotice = match is null ? null : ReadyToIssueFormCue.CrossmatchStatusNotice(match.CrossmatchStatus);
        }

        if (PatientId is long patientId)
        {
            _xm.PatientId = patientId;
            _alloc.PatientId = patientId;
            await LoadXmSpecimensAsync();
            await LoadAllocSpecimensAsync();
            if (SpecimenId is not > 0)
            {
                PreferCurrentSpecimen();
            }
        }

        if (BloodUnitId is long bloodUnitId)
        {
            _xm.BloodUnitId = bloodUnitId;
            _alloc.BloodUnitId = bloodUnitId;
        }

        if (SpecimenId is long specimenId)
        {
            _xm.SpecimenId = specimenId;
            _alloc.SpecimenId = specimenId;
        }

        if (_xm.PatientId != 0)
        {
            await LoadXmTestsAsync();
        }
    }

    private void PreferCurrentSpecimen()
    {
        var preferred = _xmSpecimens.FirstOrDefault(s =>
            s.Status == SpecimenStatus.Accepted
            && (s.ExpiresUtc is null || s.ExpiresUtc > DateTime.UtcNow))
            ?? _xmSpecimens.FirstOrDefault();
        if (preferred is null) return;
        if (_xm.SpecimenId == 0) _xm.SpecimenId = preferred.Id;
        if (_alloc.SpecimenId == 0) _alloc.SpecimenId = preferred.Id;
    }

    private async Task LoadXmSpecimensAsync()
    {
        if (_xm.PatientId == 0)
        {
            _xmSpecimens = new();
            _xmTests = [];
            _xmTestCode = null;
            _xmDefinition = null;
            return;
        }

        var r = await Api.GetPatientSpecimensAsync(_xm.PatientId);
        _xmSpecimens = r.Value ?? new();
        if (!r.Succeeded)
        {
            _xmFb = r.ToFeedback();
        }

        await LoadXmTestsAsync();
    }

    private async Task LoadXmTestsAsync()
    {
        if (_xm.PatientId == 0)
        {
            _xmTests = [];
            _xmTestCode = null;
            _xmDefinition = null;
            return;
        }

        var tests = await Api.GetPatientCrossmatchTestsAsync(_xm.PatientId);
        _xmTests = (tests.Value ?? [])
            .Where(t => !CrossmatchEntryNeed.IsElectronic(t.Code))
            .OrderBy(t => t.Code, StringComparer.OrdinalIgnoreCase)
            .ToList();
        if (!tests.Succeeded)
        {
            _xmFb = tests.ToFeedback();
        }

        if (!string.IsNullOrWhiteSpace(_xmTestCode)
            && _xmTests.Any(t => string.Equals(t.Code, _xmTestCode, StringComparison.OrdinalIgnoreCase)))
        {
            return;
        }

        _xmTestCode = null;
        _xmDefinition = null;
        _xmReactions = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        if (_xm.BloodUnitId is long unitId)
        {
            var allocations = await Api.GetPatientAllocationsAsync(_xm.PatientId);
            var match = allocations.Value?.FirstOrDefault(a => a.BloodUnitId == unitId);
            if (!string.IsNullOrWhiteSpace(match?.CrossmatchTestCode)
                && _xmTests.Any(t => string.Equals(t.Code, match.CrossmatchTestCode, StringComparison.OrdinalIgnoreCase)))
            {
                _xmTestCode = match.CrossmatchTestCode;
                await LoadXmDefinitionAsync();
            }
        }
    }

    private Task OnXmMethodChanged()
    {
        if (_xm.Method == CrossmatchMethod.Electronic)
        {
            _xmDefinition = null;
            _xmReactions = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        }

        return Task.CompletedTask;
    }

    private async Task OnXmTestChanged(ChangeEventArgs e)
    {
        _xmTestCode = string.IsNullOrWhiteSpace(e.Value?.ToString()) ? null : e.Value!.ToString();
        _xmReactions = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        await LoadXmDefinitionAsync();
    }

    private Task OnXmReactionsChanged(Dictionary<string, string> values)
    {
        _xmReactions = values;
        return Task.CompletedTask;
    }

    private async Task LoadXmDefinitionAsync()
    {
        if (string.IsNullOrWhiteSpace(_xmTestCode))
        {
            _xmDefinition = null;
            return;
        }

        var definition = await Api.GetTestDefinitionForEntryAsync(_xmTestCode);
        _xmDefinition = definition.Succeeded ? definition.Value : null;
        if (!definition.Succeeded)
        {
            _xmFb = definition.ToFeedback();
        }
    }

    private async Task LoadAllocSpecimensAsync()
    {
        if (_alloc.PatientId == 0)
        {
            _allocSpecimens = new();
            return;
        }

        var r = await Api.GetPatientSpecimensAsync(_alloc.PatientId);
        _allocSpecimens = r.Value ?? new();
        if (!r.Succeeded)
        {
            _allocFb = r.ToFeedback();
        }
    }

    private static string FormatSpecimen(SpecimenDto s)
    {
        var expires = s.ExpiresUtc is DateTime exp ? $" expires {exp:yyyy-MM-dd HH:mm}" : "";
        return $"{s.AccessionNumber} — {s.SpecimenType} ({s.Status}{expires})";
    }

    private List<CrossmatchTestOptionDto> _xmTests = [];
    private string? _xmTestCode;
    private TestDefinitionForEntryDto? _xmDefinition;
    private Dictionary<string, string> _xmReactions = new(StringComparer.OrdinalIgnoreCase);

    private async Task RecordCrossmatchAsync()
    {
        if (_xm.Method != CrossmatchMethod.Electronic)
        {
            if (string.IsNullOrWhiteSpace(_xmTestCode))
            {
                _xmFb = Feedback.Fail("Select the crossmatch test type.");
                return;
            }

            var missing = CrossmatchReactionValidation.MissingRequired(_xmDefinition?.PanelSubtests, _xmReactions);
            if (missing.Count > 0)
            {
                _xmFb = Feedback.Fail($"Enter cell reactions: {string.Join(", ", missing)}.");
                return;
            }

            if (_xmDefinition?.PanelSubtests.Any(s => s.Required) == true)
            {
                await RecordCrossmatchOnOrderAsync();
                return;
            }
        }

        _busy = true;
        var req = new RecordCrossmatchRequest(_xm.BloodUnitId!.Value, _xm.PatientId, _xm.SpecimenId, _xm.Method, _xm.Result, _xm.ScreenNegative,
            string.IsNullOrWhiteSpace(_xm.Comment) ? null : _xm.Comment);
        var r = await Api.RecordCrossmatchAsync(req);
        _busy = false;
        if (r.Succeeded && r.Value is not null)
        {
            _lastCrossmatch = r.Value;
            _alloc.BloodUnitId = _xm.BloodUnitId;
            _alloc.PatientId = _xm.PatientId;
            if (_xm.SpecimenId != 0)
            {
                _alloc.SpecimenId = _xm.SpecimenId;
            }

            await LoadAllocSpecimensAsync();
            _xmFb = r.ToFeedback(CrossmatchEntryCopy.Recorded(r.Value.Method, r.Value.Result, r.Value.Id));
        }
        else
        {
            _xmFb = r.ToFeedback();
        }
    }

    private async Task RecordCrossmatchOnOrderAsync()
    {
        if (_xm.Result is not (CrossmatchResult.Compatible or CrossmatchResult.Incompatible))
        {
            _xmFb = Feedback.Fail("Crossmatch result must be Compatible or Incompatible.");
            return;
        }

        _busy = true;
        var allocations = await Api.GetPatientAllocationsAsync(_xm.PatientId);
        var allocation = allocations.Value?.FirstOrDefault(a =>
            a.BloodUnitId == _xm.BloodUnitId
            && a.AllocationStatus == AllocationStatus.Reserved
            && a.IssueId is null);
        if (!allocations.Succeeded || allocation is null)
        {
            _busy = false;
            _xmFb = allocations.Succeeded
                ? Feedback.Fail("Allocate this unit on the patient's product order before recording cell reactions.")
                : allocations.ToFeedback();
            return;
        }

        var line = await Api.EnsureManualCrossmatchLineAsync(_xm.PatientId, allocation.AllocationId, _xmTestCode!);
        if (!line.Succeeded || line.Value is null)
        {
            _busy = false;
            _xmFb = line.ToFeedback();
            return;
        }

        var save = await Api.SaveTestResultAsync(new SaveTestResultRequest(
            line.Value.SpecimenId,
            line.Value.OrderId,
            line.Value.OrderLineId,
            line.Value.TestCode,
            null,
            null,
            string.IsNullOrWhiteSpace(_xm.Comment) ? null : _xm.Comment,
            null,
            null,
            _xmReactions,
            MarkComplete: false,
            CorrectionReason: null,
            UnitNumber: allocation.UnitNumber,
            CrossmatchMethod: _xm.Method,
            CrossmatchResult: _xm.Result,
            AntibodyScreenNegative: _xm.ScreenNegative));
        _busy = false;
        _xmFb = save.Succeeded
            ? Feedback.Succeed($"Crossmatch recorded for unit {allocation.UnitNumber}.")
            : save.ToFeedback();
        if (save.Succeeded)
        {
            _alloc.BloodUnitId = _xm.BloodUnitId;
            _alloc.PatientId = _xm.PatientId;
            if (_xm.SpecimenId != 0)
            {
                _alloc.SpecimenId = _xm.SpecimenId;
            }
        }
    }

    private async Task AllocateAsync()
    {
        if (_showAllocOverride && (string.IsNullOrWhiteSpace(_allocOverrideReason) || string.IsNullOrWhiteSpace(_allocAuthorizedBy)))
        {
            _allocFb = Feedback.Fail("An override reason and authorizer are required to reserve a unit that is not antigen-negative.");
            return;
        }

        _busy = true;
        var req = new AllocateUnitRequest(
            _alloc.BloodUnitId!.Value,
            _alloc.PatientId,
            _alloc.SpecimenId == 0 ? null : _alloc.SpecimenId,
            OverrideReason: _showAllocOverride ? _allocOverrideReason.Trim() : null,
            AuthorizedBy: _showAllocOverride ? _allocAuthorizedBy.Trim() : null);
        var r = await Api.AllocateUnitAsync(req);
        _busy = false;
        if (r.Blocked && r.Overridable)
        {
            _showAllocOverride = true;
            if (string.IsNullOrWhiteSpace(_allocAuthorizedBy))
            {
                _allocAuthorizedBy = Session.UserName ?? string.Empty;
            }

            _allocFb = r.ToFeedback();
            return;
        }

        _allocFb = r.ToFeedback("Unit reserved.");
        if (r.Succeeded)
        {
            _lastAllocation = r.Value;
            _showAllocOverride = false;
            _allocOverrideReason = string.Empty;
            _allocAuthorizedBy = string.Empty;
        }
    }

    private async Task ReleaseAsync(long id)
    {
        _busy = true;
        var r = await Api.ReleaseAllocationAsync(id, _releaseReason);
        _busy = false;
        _allocFb = r.ToFeedback("Allocation released.");
        if (r.Succeeded) _lastAllocation = r.Value;
    }

    private sealed class XmModel
    {
        public long? BloodUnitId { get; set; }
        public long PatientId { get; set; }
        public long SpecimenId { get; set; }
        public CrossmatchMethod Method { get; set; } = CrossmatchMethod.Serologic;
        public CrossmatchResult Result { get; set; } = CrossmatchResult.Compatible;
        public bool ScreenNegative { get; set; } = true;
        public string? Comment { get; set; }
    }

    private sealed class AllocModel
    {
        public long? BloodUnitId { get; set; }
        public long PatientId { get; set; }
        public long SpecimenId { get; set; }
    }
}
