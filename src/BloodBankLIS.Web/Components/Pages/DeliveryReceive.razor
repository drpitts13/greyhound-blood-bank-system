@page "/inventory/deliveries/{Id:long}/receive"
@using BloodBankLIS.Application.Inventory
@using BloodBankLIS.Application.Reference
@using BloodBankLIS.Domain.Enums
@inject BloodBankApiClient Api
@inject UserSession Session
@inject NavigationManager Nav

<PageTitle>Enter units &middot; Delivery @Id</PageTitle>

<InventoryDeskRibbon Current="InventoryDeskRibbon.Desk.Inventory" />

<div class="flex-between" style="margin-bottom:1rem;">
    <h1>Enter units</h1>
    <a class="btn btn-ghost" href="@($"/inventory/deliveries/{Id}")">Back to delivery</a>
</div>

<Outcome Value="_feedback" />

@if (_delivery is null)
{
    <div class="loading">@(_missing ? "Delivery not found." : "Loading...")</div>
}
else if (_delivery.Status != DeliveryStatus.Open)
{
    <div class="bb-card">
        <p>Delivery @Id is @_delivery.Status. Units can only be added to an open delivery.</p>
        <a class="btn btn-secondary" href="@($"/inventory/deliveries/{Id}")">Open delivery record</a>
    </div>
}
else
{
    <div class="bb-card">
        <div class="form-row">
            <div class="field"><label>Delivery</label><div class="mono">@_delivery.Id</div></div>
            <div class="field"><label>Supplier</label><div>@_delivery.SupplierName</div></div>
            <div class="field"><label>Packing list</label><div class="mono">@(_delivery.PackingListNumber ?? "—")</div></div>
        </div>
        <table class="bb">
            <thead><tr><th>Product</th><th>Expected</th><th>Received</th><th>Variance</th></tr></thead>
            <tbody>
                @foreach (var line in _delivery.Lines)
                {
                    <tr>
                        <td>@line.ProductLabel</td>
                        <td>@line.ExpectedQuantity</td>
                        <td>@line.ReceivedQuantity</td>
                        <td>@VarianceLabel(line.Variance)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="bb-card">
        <div class="bb-card-title"><h3>Receive a unit</h3></div>
        <p class="muted">The supplier comes from this delivery. Choose a catalog product in one of the products counted above.</p>
        <div class="form-row">
            <div class="field"><label>Unit number</label><input @bind="_rec.UnitNumber" /></div>
            <div class="field"><label>Product</label>
                <select @bind="_rec.ProductTypeId">
                    <option value="0">— select —</option>
                    @foreach (var product in EligibleProducts)
                    {
                        <option value="@product.Id">@product.Name</option>
                    }
                </select>
            </div>
            <div class="field"><label>ABO</label><select @bind="_rec.Abo">@foreach (var a in Enum.GetValues<AboGroup>()) { <option value="@a">@a</option> }</select></div>
            <div class="field"><label>Rh(D)</label><select @bind="_rec.RhD">@foreach (var r in Enum.GetValues<RhType>()) { <option value="@r">@r</option> }</select></div>
            <div class="field"><label>Expires (UTC)</label><input type="datetime-local" @bind="_rec.ExpiresLocal" /></div>
            <div class="field"><label>Location</label>
                <select @bind="_rec.LocationId">
                    <option value="0">— none —</option>
                    @foreach (var l in _locations) { <option value="@l.Id">@l.Code — @l.Name</option> }
                </select>
            </div>
            <div class="field"><label>Product description code</label>
                <input @bind="_rec.ProductDescriptionCode" placeholder="E0336 or E0336000" maxlength="8" />
            </div>
        </div>
        <div class="form-row">
            <div class="field"><label>Appearance</label>
                <select @bind="_rec.Appearance">
                    @foreach (var a in Enum.GetValues<UnitAppearance>()) { <option value="@a">@a</option> }
                </select>
            </div>
            <div class="field"><label>Visual notes</label><input @bind="_rec.VisualInspectionNotes" /></div>
            <div class="field"><label>Receipt temperature (°C)</label>
                <input type="number" step="0.1" @bind="_rec.ReceiveTemperatureCelsius" placeholder="e.g. 4.0" />
                <span class="muted">Shipping cooler 1–10 °C</span>
            </div>
            <div class="field"><label>Donation</label>
                <select @bind="_rec.DonationRestriction">
                    @foreach (var d in Enum.GetValues<DonationRestriction>()) { <option value="@d">@d</option> }
                </select>
            </div>
            @if (_rec.DonationRestriction != DonationRestriction.Allogeneic)
            {
                <div class="field" style="min-width:16rem;">
                    <label>Intended recipient</label>
                    <FilterableComboBox TItem="PatientDto" TValue="long?"
                        Items="_patients"
                        @bind-Value="_rec.ReservedPatientId"
                        DisplayText="@(p => $"{p.LastName}, {p.FirstName} ({p.MedicalRecordNumber})")"
                        ItemValue="@(p => p.Id)"
                        SearchText="@(p => $"{p.LastName} {p.FirstName} {p.MedicalRecordNumber}")"
                        Clearable="true"
                        Placeholder="Autologous / directed patient" />
                </div>
            }
            @if (_requireReceiveVerifier)
            {
                <div class="field" style="min-width:16rem;">
                    <label>Second verifier</label>
                    <FilterableComboBox TItem="DirectoryUserDto" TValue="string?"
                        Items="ReceiveVerifierChoices"
                        @bind-Value="_rec.SecondVerifier"
                        DisplayText="@(x => x.Label)"
                        ItemValue="@(x => x.UserName)"
                        SearchText="@(x => x.Label)"
                        Clearable="true"
                        Placeholder="Different active user" />
                </div>
            }
        </div>
        <button class="btn btn-primary" disabled="@_busy" @onclick="ReceiveAsync">Receive</button>
    </div>
}

@code {
    [Parameter] public long Id { get; set; }

    private DeliveryDetailDto? _delivery;
    private bool _missing;
    private bool _busy;
    private Feedback? _feedback;
    private List<ProductTypeDto> _productTypes = new();
    private List<InventoryLocationDto> _locations = new();
    private List<DirectoryUserDto> _directoryUsers = new();
    private List<PatientDto> _patients = new();
    private bool _requireReceiveVerifier;
    private ReceiveModel _rec = new();

    private IEnumerable<DirectoryUserDto> ReceiveVerifierChoices =>
        _directoryUsers.Where(u => !string.Equals(u.UserName, Session.UserName, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<ProductTypeDto> EligibleProducts =>
        _productTypes.Where(p => _delivery?.Lines.Any(l => l.ComponentClass == p.ComponentClass) == true)
            .OrderBy(p => p.Name);

    protected override async Task OnParametersSetAsync()
    {
        if (!Session.Has(PermissionCodes.InventoryReceive))
        {
            Nav.NavigateTo($"/inventory/deliveries/{Id}");
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var policy = await Api.GetReceivePolicyAsync();
        _requireReceiveVerifier = policy.Succeeded && policy.Value?.RequireSecondVerifier == true;
        _productTypes = (await Api.GetProductTypesAsync()).Value ?? new();
        _locations = (await Api.GetLocationsAsync()).Value ?? new();
        var users = await Api.GetDirectoryUsersAsync();
        if (users.Succeeded) _directoryUsers = users.Value ?? new();
        var patients = await Api.GetPatientsAsync();
        if (patients.Succeeded) _patients = patients.Value ?? new();

        var r = await Api.GetDeliveryAsync(Id);
        if (!r.Succeeded || r.Value is null)
        {
            _delivery = null;
            _missing = true;
            _feedback = r.ToFeedback();
            return;
        }

        _missing = false;
        _delivery = r.Value;
        if (_rec.ProductTypeId == 0 || EligibleProducts.All(p => p.Id != _rec.ProductTypeId))
        {
            _rec.ProductTypeId = EligibleProducts.FirstOrDefault()?.Id ?? 0;
        }
    }

    private async Task ReceiveAsync()
    {
        if (_rec.ProductTypeId <= 0 || string.IsNullOrWhiteSpace(_rec.UnitNumber))
        {
            _feedback = Feedback.Fail("Unit number and product are required.");
            return;
        }

        _busy = true;
        var req = new ReceiveUnitRequest(
            _rec.UnitNumber.Trim(),
            _rec.ProductTypeId,
            _rec.Abo,
            _rec.RhD,
            DateTime.SpecifyKind(_rec.ExpiresLocal, DateTimeKind.Utc),
            _rec.LocationId == 0 ? null : _rec.LocationId,
            Isbt128ProductCode: string.IsNullOrWhiteSpace(_rec.ProductDescriptionCode) ? null : _rec.ProductDescriptionCode.Trim(),
            VisualInspectionAcceptable: _rec.Appearance == UnitAppearance.Acceptable,
            VisualInspectionNotes: string.IsNullOrWhiteSpace(_rec.VisualInspectionNotes) ? null : _rec.VisualInspectionNotes,
            SecondVerifier: _requireReceiveVerifier ? _rec.SecondVerifier : null,
            Appearance: _rec.Appearance,
            ReceiveTemperatureCelsius: _rec.ReceiveTemperatureCelsius,
            DonationRestriction: _rec.DonationRestriction,
            ReservedPatientId: _rec.DonationRestriction == DonationRestriction.Allogeneic ? null : _rec.ReservedPatientId,
            DeliveryId: Id);
        var r = await Api.ReceiveUnitAsync(req);
        _busy = false;
        _feedback = r.ToFeedback(r.Value?.Status == UnitStatus.Received
            ? "Unit received. Pending retype until results are entered and verified."
            : "Unit received.");
        if (r.Succeeded)
        {
            var productTypeId = _rec.ProductTypeId;
            _rec = new ReceiveModel { ProductTypeId = productTypeId };
            await LoadAsync();
        }
    }

    private static string VarianceLabel(int variance) =>
        variance == 0 ? "Even" : variance > 0 ? $"+{variance} over" : $"{variance} short";

    private sealed class ReceiveModel
    {
        public string UnitNumber { get; set; } = string.Empty;
        public long ProductTypeId { get; set; }
        public AboGroup Abo { get; set; } = AboGroup.O;
        public RhType RhD { get; set; } = RhType.Positive;
        public DateTime ExpiresLocal { get; set; } = DateTime.UtcNow.AddDays(30);
        public long LocationId { get; set; }
        public string ProductDescriptionCode { get; set; } = string.Empty;
        public string? VisualInspectionNotes { get; set; }
        public UnitAppearance Appearance { get; set; } = UnitAppearance.Acceptable;
        public decimal? ReceiveTemperatureCelsius { get; set; }
        public DonationRestriction DonationRestriction { get; set; } = DonationRestriction.Allogeneic;
        public long? ReservedPatientId { get; set; }
        public string? SecondVerifier { get; set; }
    }
}
