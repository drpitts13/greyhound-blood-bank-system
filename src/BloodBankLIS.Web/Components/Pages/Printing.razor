@page "/printing"
@inject BloodBankApiClient Api
@inject UserSession Session

<PageTitle>Printing &middot; Greyhound Blood Bank LIS</PageTitle>

<h1>Label &amp; Tag Printing</h1>
@if (!CanPrint)
{
    <div class="alert alert-warning">You can view print jobs, but printing requires the print label permission.</div>
}
<p class="muted">Print specimen labels, ISBT component labels, and compatibility tags. After issue, print the P-tag from Issue &amp; Transfuse or the patient Products tab — this page is for other labels and audited reprints.</p>

<div class="bb-grid cols-3">
    <div class="bb-card">
        <div class="bb-card-title"><h3>Print specimen label</h3></div>
        <Outcome Value="_specFb" />
        <div class="form-row">
            <div class="field"><label>Accession number</label><input class="mono" @bind="_specimenAccession" @bind:event="oninput" @onkeydown="OnSpecimenKey" placeholder="Type or scan, e.g. ACC0001" /></div>
            <div class="field"><label>Format</label>
                <select @bind="_specFormat">@foreach (var f in Enum.GetValues<LabelFormat>()) { <option value="@f">@FormatLabel(f)</option> }</select>
            </div>
        </div>
        <button class="btn btn-primary" disabled="@(_busy || !CanPrint)" @onclick="PrintSpecimenAsync">Print</button>
    </div>

    <div class="bb-card">
        <div class="bb-card-title"><h3>Print compatibility tag</h3></div>
        <Outcome Value="_tagFb" />
        <div class="form-row">
            <div class="field"><label>Unit number</label><input class="mono" @bind="_tagUnitNumber" @bind:event="oninput" @onkeydown="OnTagKey" placeholder="Issued unit; prints its latest issue" /></div>
            <div class="field"><label>Format</label>
                <select @bind="_tagFormat">@foreach (var f in Enum.GetValues<LabelFormat>()) { <option value="@f">@FormatLabel(f)</option> }</select>
            </div>
        </div>
        <button class="btn btn-primary" disabled="@(_busy || !CanPrint)" @onclick="PrintTagAsync">Print</button>
    </div>

    <div class="bb-card">
        <div class="bb-card-title"><h3>Print component label</h3></div>
        <Outcome Value="_compFb" />
        <div class="form-row">
            <div class="field"><label>Unit number</label>
                <UnitPickerComboBox Scope="UnitPickerScope.OnHand" @bind-Value="_unitId" />
            </div>
            <div class="field"><label>Format</label>
                <select @bind="_compFormat">@foreach (var f in Enum.GetValues<LabelFormat>()) { <option value="@f">@FormatLabel(f)</option> }</select>
            </div>
        </div>
        <button class="btn btn-primary" disabled="@(_busy || _unitId is null || !CanPrint)" @onclick="PrintComponentAsync">Print</button>
    </div>
</div>

@if (_lastJob is not null && (_lastJob.HasPdf || !string.IsNullOrEmpty(_lastJob.RenderedZpl)))
{
    <div class="bb-card">
        <Outcome Value="_outputFb" />
        <div class="bb-card-title"><h3>Rendered output &middot; job #@_lastJob.Id</h3>
            <span class="@Ui.Badge(_lastJob.Status)">@_lastJob.Status</span>
            <span class="muted">@_lastJob.DeliveryStatus</span>
        </div>
        @if (!string.IsNullOrEmpty(_lastJob.DeliveryError))
        {
            <div class="alert alert-danger">@_lastJob.DeliveryError</div>
        }
        @if (_lastJob.Format == LabelFormat.Pdf && _pdfUrl is not null)
        {
            <iframe title="PDF preview" src="@_pdfUrl" style="width:100%;height:420px;border:1px solid var(--line);background:#fff;"></iframe>
            <div class="flex gap" style="margin-top:.6rem;flex-wrap:wrap;align-items:end;">
                <a class="btn btn-secondary btn-sm" href="@_pdfUrl" download="@($"label-{_lastJob.Id}.pdf")">Download PDF</a>
                @if (_pdfPrinters.Count > 0)
                {
                    <div class="field" style="margin:0;min-width:14rem;">
                        <label>Print to</label>
                        <select @bind="_deliverPdfId">
                            @foreach (var p in _pdfPrinters)
                            {
                                <option value="@p.Id">@p.Name</option>
                            }
                        </select>
                    </div>
                    <button class="btn btn-primary btn-sm" disabled="@(_busy || !CanPrint)" @onclick="DeliverPdfAsync">Print to</button>
                }
            </div>
        }
        else if (!string.IsNullOrEmpty(_lastJob.RenderedZpl))
        {
            <div class="pre">@_lastJob.RenderedZpl</div>
            @if (_lastJob.Format == LabelFormat.Zpl && _zebraPrinters.Count > 0)
            {
                <div class="flex gap" style="margin-top:.6rem;flex-wrap:wrap;align-items:end;">
                    <div class="field" style="margin:0;min-width:14rem;">
                        <label>Send to Zebra</label>
                        <select @bind="_deliverZebraId">
                            @foreach (var p in _zebraPrinters)
                            {
                                <option value="@p.Id">@p.Name</option>
                            }
                        </select>
                    </div>
                    <button class="btn btn-primary btn-sm" disabled="@(_busy || !CanPrint)" @onclick="DeliverZebraAsync">Send to Zebra</button>
                </div>
            }
        }
    </div>
}

<div class="bb-card">
    <div class="bb-card-title"><h3>Print jobs</h3>
        <button class="btn btn-secondary btn-sm" disabled="@_busy" @onclick="LoadJobsAsync">Refresh</button>
    </div>
    <Outcome Value="_jobsFb" />
    @if (_loading)
    {
        <div class="loading">Loading jobs...</div>
    }
    else if (_jobs.Count == 0)
    {
        <div class="empty">No print jobs yet.</div>
    }
    else
    {
        <table class="bb">
            <thead><tr><th>Id</th><th>Type</th><th>Template</th><th>Format</th><th>Context</th><th>Status</th><th>By</th><th></th></tr></thead>
            <tbody>
                @foreach (var j in _jobs)
                {
                    <tr>
                        <td>@j.Id</td>
                        <td>@j.JobType @(j.IsReprint ? "(reprint)" : "")</td>
                        <td class="mono">@j.TemplateCode</td>
                        <td>@j.Format</td>
                        <td class="muted">
                            @if (ContextHref(j) is { } href)
                            {
                                <a href="@href">@j.ContextType @(j.ContextId is null ? "" : $"#{j.ContextId}")</a>
                            }
                            else
                            {
                                @j.ContextType @(j.ContextId is null ? "" : $"#{j.ContextId}")
                            }
                        </td>
                        <td><span class="@Ui.Badge(j.Status)">@j.Status</span></td>
                        <td>@j.PrintedBy</td>
                        <td class="right nowrap">
                            <button class="btn btn-ghost btn-sm" @onclick="() => ViewJobAsync(j.Id)">View</button>
                            @if (Session.Has(PermissionCodes.PrintReprint))
                            {
                                <button class="btn btn-ghost btn-sm" @onclick="() => BeginReprint(j.Id)">Reprint</button>
                            }
                        </td>
                    </tr>
                    @if (_reprintId == j.Id)
                    {
                        <tr><td colspan="8">
                            <div class="flex gap">
                                <input @bind="_reprintReason" placeholder="Reprint reason" style="flex:1;" />
                                <button class="btn btn-danger btn-sm" disabled="@_busy" @onclick="() => ReprintAsync(j.Id)">Confirm reprint</button>
                                <button class="btn btn-secondary btn-sm" @onclick="() => _reprintId = null">Cancel</button>
                            </div>
                        </td></tr>
                    }
                }
            </tbody>
        </table>
    }
</div>

@code {
    private string _specimenAccession = string.Empty;
    private LabelFormat _specFormat = LabelFormat.Pdf;
    private Feedback? _specFb;
    private Feedback? _outputFb;
    private bool CanPrint => Session.Has(PermissionCodes.PrintLabel);
    private Feedback? _jobsFb;

    private string _tagUnitNumber = string.Empty;
    private (long IssueId, string UnitNumber)? _prefilledIssue;
    private LabelFormat _tagFormat = LabelFormat.Pdf;
    private Feedback? _tagFb;

    [SupplyParameterFromQuery]
    public long? IssueId { get; set; }

    [SupplyParameterFromQuery]
    public long? SpecimenId { get; set; }

    [SupplyParameterFromQuery]
    public long? UnitId { get; set; }

    [SupplyParameterFromQuery]
    public long? JobId { get; set; }

    private long? _unitId;
    private LabelFormat _compFormat = LabelFormat.Pdf;
    private Feedback? _compFb;

    private List<PrintJobVm> _jobs = new();
    private bool _loading = true;
    private bool _busy;
    private PrintJobVm? _lastJob;
    private string? _pdfUrl;
    private List<PrinterChoiceDto> _pdfPrinters = new();
    private List<PrinterChoiceDto> _zebraPrinters = new();
    private long _deliverPdfId;
    private long _deliverZebraId;
    private long? _reprintId;
    private string _reprintReason = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        if (IssueId is long issueId)
        {
            // Links from an issue pass its id; show the unit number on the bag and keep printing that exact issue.
            var issue = await Api.GetIssueAsync(issueId);
            if (issue.Succeeded && issue.Value is not null)
            {
                var unit = await Api.GetUnitAsync(issue.Value.BloodUnitId);
                if (unit.Succeeded && unit.Value is not null)
                {
                    _tagUnitNumber = unit.Value.UnitNumber;
                    _prefilledIssue = (issueId, unit.Value.UnitNumber);
                }
            }
        }

        if (SpecimenId is long specimenId)
        {
            // Links from other pages still pass the id; show the accession number people recognize.
            var specimen = await Api.GetSpecimenAsync(specimenId);
            if (specimen.Succeeded && specimen.Value is not null) _specimenAccession = specimen.Value.AccessionNumber;
        }

        if (UnitId is long unitId)
        {
            _unitId = unitId;
        }

        await LoadJobsAsync();
        await LoadPrintersAsync();
        if (JobId is long jobId)
        {
            await ViewJobAsync(jobId);
        }
    }

    private static string FormatLabel(LabelFormat format) => format switch
    {
        LabelFormat.Pdf => "PDF preview",
        LabelFormat.Preview => "Text preview",
        LabelFormat.Zpl => "ZPL",
        _ => format.ToString()
    };

    private async Task LoadPrintersAsync()
    {
        var pdf = await Api.GetActivePdfPrintersAsync();
        var zebra = await Api.GetActiveZebraPrintersAsync();
        _pdfPrinters = pdf.Succeeded ? pdf.Value ?? new() : new();
        _zebraPrinters = zebra.Succeeded ? zebra.Value ?? new() : new();
        _deliverPdfId = _pdfPrinters.FirstOrDefault(p => p.IsDefault)?.Id ?? _pdfPrinters.FirstOrDefault()?.Id ?? 0;
        _deliverZebraId = _zebraPrinters.FirstOrDefault(p => p.IsDefault)?.Id ?? _zebraPrinters.FirstOrDefault()?.Id ?? 0;
    }

    private async Task LoadJobsAsync()
    {
        _loading = true;
        var r = await Api.GetPrintJobsAsync();
        _loading = false;
        if (r.Succeeded) _jobs = r.Value!;
    }

    private async Task OnSpecimenKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !_busy && CanPrint) await PrintSpecimenAsync();
    }

    private async Task PrintSpecimenAsync()
    {
        if (string.IsNullOrWhiteSpace(_specimenAccession))
        {
            _specFb = Feedback.Fail("Enter the specimen's accession number.");
            return;
        }

        _busy = true;
        var specimen = await Api.GetSpecimenByAccessionAsync(_specimenAccession);
        if (!specimen.Succeeded || specimen.Value is null)
        {
            _busy = false;
            _specFb = specimen.ToFeedback();
            return;
        }

        var r = await Api.PrintSpecimenLabelAsync(specimen.Value.Id, new PrintRequestVm(_specFormat));
        _busy = false;
        _specFb = r.ToFeedback("Specimen label queued.");
        if (r.Succeeded) { await ShowJobAsync(r.Value); await LoadJobsAsync(); }
    }

    private async Task OnTagKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !_busy && CanPrint) await PrintTagAsync();
    }

    private async Task PrintTagAsync()
    {
        if (string.IsNullOrWhiteSpace(_tagUnitNumber))
        {
            _tagFb = Feedback.Fail("Enter the issued unit's number.");
            return;
        }

        _busy = true;
        // A link from an issue names that exact issue; a typed or scanned number prints the unit's latest issue.
        long issueId;
        if (_prefilledIssue is { } prefilled && string.Equals(prefilled.UnitNumber, _tagUnitNumber.Trim(), StringComparison.OrdinalIgnoreCase))
        {
            issueId = prefilled.IssueId;
        }
        else
        {
            var issue = await Api.GetLatestIssueForUnitAsync(_tagUnitNumber);
            if (!issue.Succeeded || issue.Value is null)
            {
                _busy = false;
                _tagFb = issue.ToFeedback();
                return;
            }

            issueId = issue.Value.Id;
        }

        var r = await Api.PrintCompatibilityTagAsync(issueId, new PrintRequestVm(_tagFormat));
        _busy = false;
        _tagFb = r.ToFeedback("Compatibility tag queued.");
        if (r.Succeeded) { await ShowJobAsync(r.Value); await LoadJobsAsync(); }
    }

    private async Task PrintComponentAsync()
    {
        _busy = true;
        var r = await Api.PrintComponentLabelAsync(_unitId!.Value, new PrintRequestVm(_compFormat));
        _busy = false;
        _compFb = r.ToFeedback("Component label queued.");
        if (r.Succeeded) { await ShowJobAsync(r.Value); await LoadJobsAsync(); }
    }

    private async Task ViewJobAsync(long id)
    {
        var r = await Api.GetPrintJobAsync(id);
        if (r.Succeeded) await ShowJobAsync(r.Value);
        else _jobsFb = r.ToFeedback();
    }

    private async Task ShowJobAsync(PrintJobVm? job)
    {
        _lastJob = job;
        _pdfUrl = null;
        if (job is not { Format: LabelFormat.Pdf, HasPdf: true })
        {
            return;
        }

        var pdf = await Api.GetPrintJobPdfAsync(job.Id);
        if (pdf.Succeeded && pdf.Value is { Length: > 0 })
        {
            _pdfUrl = "data:application/pdf;base64," + Convert.ToBase64String(pdf.Value);
        }
    }

    private async Task DeliverPdfAsync()
    {
        if (_lastJob is null || _deliverPdfId <= 0) return;
        _busy = true;
        var r = await Api.DeliverPrintJobAsync(_lastJob.Id, new DeliverPrintRequestVm(_deliverPdfId, null));
        _busy = false;
        _outputFb = r.ToFeedback(r.Succeeded ? "PDF sent to the printer." : null);
        if (r.Succeeded) await ShowJobAsync(r.Value);
        else if (r.Error is not null) _outputFb = r.ToFeedback();
        await ViewJobAsync(_lastJob.Id);
    }

    private async Task DeliverZebraAsync()
    {
        if (_lastJob is null || _deliverZebraId <= 0) return;
        _busy = true;
        var r = await Api.DeliverPrintJobAsync(_lastJob.Id, new DeliverPrintRequestVm(null, _deliverZebraId));
        _busy = false;
        _outputFb = r.ToFeedback(r.Succeeded ? "ZPL sent to the Zebra printer." : null);
        await ViewJobAsync(_lastJob.Id);
    }

    private static string? ContextHref(PrintJobVm j)
    {
        if (j.ContextId is not long id)
        {
            return null;
        }

        return j.ContextType switch
        {
            "Patient" => $"/patients/{id}",
            "BloodUnit" or "Unit" => InventoryUrls.Unit(id),
            "Issue" => "/issuing",
            "Specimen" => null,
            _ => null
        };
    }

    private void BeginReprint(long id) { _reprintId = id; _reprintReason = string.Empty; }

    private async Task ReprintAsync(long id)
    {
        _busy = true;
        var r = await Api.ReprintJobAsync(id, _reprintReason);
        _busy = false;
        _jobsFb = r.ToFeedback(r.Succeeded ? $"Reprint recorded as job #{r.Value?.Id}." : null);
        if (r.Succeeded) { _reprintId = null; await ShowJobAsync(r.Value); await LoadJobsAsync(); }
        else _jobsFb = r.ToFeedback();
    }
}
