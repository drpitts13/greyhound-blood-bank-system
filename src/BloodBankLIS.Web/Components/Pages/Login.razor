@page "/login"
@layout LoginLayout
@inject UserSession Session
@inject BloodBankApiClient Api
@inject NavigationManager Nav
@inject DesktopHostLifetime DesktopHost

<PageTitle>Sign in &middot; HemoCore</PageTitle>

<div class="bb-login">
    <div class="bb-login-card">
        <h1><span class="dot" style="width:14px;height:14px;border-radius:50%;background:var(--bb-primary);display:inline-block;"></span> HemoCore</h1>
        <p class="muted">Sign in with your operator identity. Authorization is enforced by the API.</p>

        <div class="field">
            <label>Username</label>
            <input @ref="_userInput" @bind="_userName" @bind:event="oninput" placeholder="e.g. tech1" autocomplete="username" @onkeydown="OnUserKey" />
        </div>
        <div class="field">
            <label>Password</label>
            <input @ref="_passwordInput" type="password" @bind="_password" @bind:event="oninput" placeholder="Demo password is demo" autocomplete="current-password" @onkeydown="OnKey" />
        </div>
        @if (_challenge is { Kind: "EnrollmentRequired" } setup)
        {
            <div class="alert alert-danger" style="margin-bottom:.75rem;">
                Facility policy requires an authenticator app for your account before you can sign in.
                In the app, add an account by scanning this code, then enter the code it shows.
                @if (!string.IsNullOrEmpty(setup.ProvisioningUri))
                {
                    <div style="width:180px;margin:.5rem 0;">@((MarkupString)QrSvg.Render(setup.ProvisioningUri))</div>
                }
                <div>Can't scan? Enter this key instead:</div>
                <div class="mono" style="font-size:1.05em;letter-spacing:.08em;margin:.4rem 0;">@Grouped(setup.SecretBase32 ?? "")</div>
                <details><summary>Setup link</summary><div class="mono" style="word-break:break-all;">@setup.ProvisioningUri</div></details>
            </div>
        }
        @if (_challenge is not null)
        {
            <div class="field">
                <label>Authenticator code</label>
                <input @ref="_codeInput" inputmode="numeric" maxlength="6" @bind="_oneTimeCode" @bind:event="oninput" autocomplete="one-time-code" placeholder="6-digit code" @onkeydown="OnKey" />
            </div>
        }
        <div class="field">
            <label>Workstation</label>
            <input @bind="_workstation" @bind:event="oninput" placeholder="Workstation id" @onkeydown="OnKey" />
        </div>

        <button class="btn btn-primary" style="width:100%;" disabled="@_busy" @onclick="SignInAsync">
            @(_busy ? "Signing in..." : "Sign in")
        </button>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-danger" style="margin-top:1rem;">@_error</div>
        }

        <div style="margin-top:1.25rem;">
            <div class="muted" style="font-size:.78rem;margin-bottom:.4rem;">Demo accounts (password: demo)</div>
            <div class="flex gap" style="flex-wrap:wrap;">
                @foreach (var demo in _demoUsers)
                {
                    <button class="btn btn-secondary btn-sm" @onclick="() => Quick(demo)">@demo</button>
                }
            </div>
        </div>
        <p style="margin-top:1rem;text-align:center;"><a href="/help/clinical/signing-in">Help with signing in</a></p>
        @if (DesktopHost.ShutdownOnExit)
        {
            <button class="btn btn-ghost btn-sm" style="margin-top:1rem;" @onclick="ExitApplication">Exit</button>
        }
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }

    private string _userName = string.Empty;
    private string _password = string.Empty;
    private string _workstation = Environment.MachineName;
    private string? _error;
    private LoginChallengeVm? _challenge;
    private string _oneTimeCode = string.Empty;
    private ElementReference _codeInput;
    private bool _busy;

    private static readonly string[] _demoUsers = { "admin", "supervisor", "tech1", "viewer" };

    private async Task Quick(string user)
    {
        _userName = user;
        _password = "demo";
        await SignInAsync();
    }

    private ElementReference _userInput;
    private ElementReference _passwordInput;

    private bool _focusCode;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusCode && _codeInput.Context is not null)
        {
            _focusCode = false;
            try
            {
                await _codeInput.FocusAsync();
            }
            catch (JSException)
            {
            }

            return;
        }

        if (!firstRender) return;
        try
        {
            await _userInput.FocusAsync();
        }
        catch (JSException)
        {
        }
    }

    private async Task OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SignInAsync();
        }
    }

    /// <summary>Enter after the username moves to Password instead of failing a sign-in with no password.</summary>
    private async Task OnUserKey(KeyboardEventArgs e)
    {
        if (e.Key != "Enter") return;
        if (string.IsNullOrEmpty(_password) && !string.IsNullOrWhiteSpace(_userName))
        {
            try
            {
                await _passwordInput.FocusAsync();
            }
            catch (JSException)
            {
            }

            return;
        }

        await SignInAsync();
    }

    private async Task SignInAsync()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_userName))
        {
            _error = "Enter a username.";
            return;
        }

        _busy = true;
        var login = await Api.LoginAsync(new LoginRequestVm(
            _userName.Trim(), _password, _workstation, _challenge is not null ? _oneTimeCode.Trim() : null));
        _busy = false;

        if (!login.Succeeded || login.Value is null)
        {
            _oneTimeCode = string.Empty;
            _error = login.StatusCode is 401 or 404
                ? _challenge is not null
                    ? "Sign-in failed. Check the password and the current code."
                    : "Sign-in failed. Check the username and password."
                : login.FailureSummary();
            return;
        }

        if (login.Value.Challenge is { } challenge || string.IsNullOrEmpty(login.Value.SessionToken))
        {
            // Password accepted, no session yet: ask for the code (and show the key to set up).
            _challenge = login.Value.Challenge ?? new LoginChallengeVm("Challenge");
            _oneTimeCode = string.Empty;
            _error = _challenge.Kind == "EnrollmentRequired"
                ? null
                : "Enter the 6-digit code from your authenticator app.";
            // The code field appears with this render; it takes the focus once it is on the page (Cycle 628).
            _focusCode = true;
            return;
        }

        Session.SignIn(
            login.Value.UserName,
            login.Value.DisplayName,
            _workstation,
            login.Value.Permissions,
            login.Value.SecurityLevel,
            login.Value.SessionToken);
        Nav.NavigateTo(string.IsNullOrWhiteSpace(ReturnUrl) ? "" : ReturnUrl);
    }

    private void ExitApplication() => DesktopHost.RequestImmediateStop();

    private static string Grouped(string key) =>
        string.Join(' ', Enumerable.Range(0, (key.Length + 3) / 4).Select(i => key.Substring(i * 4, Math.Min(4, key.Length - i * 4))));
}
