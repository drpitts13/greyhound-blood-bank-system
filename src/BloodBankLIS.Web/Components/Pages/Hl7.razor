@page "/hl7"
@inject BloodBankApiClient Api

<PageTitle>HL7 Interface &middot; Greyhound Blood Bank LIS</PageTitle>

<h1>HL7 Interface</h1>
<p class="muted">Operational view of the HL7 v2.x message log.</p>
<details class="bb-help">
    <summary>About this page</summary>
    <ul>
        <li>Submit inbound messages, send queued outbound ORU/DFT over MLLP or a file-drop folder, poll inbound drop folders, inspect raw content, replay, and review the error queue.</li>
        <li>Resolve clears a queue row after the chart was handled by hand.</li>
        <li>It does not reprocess the message.</li>
        <li>An errored copy says Applied once another inbound message with that control id has already applied, and replay does not run it again.</li>
    </ul>
</details>

@* The error queue is the operational work, so it leads at full width; manual submit is occasional. *@
<div class="bb-card">
    <div class="bb-card-title"><h3>Error queue</h3>
        <button class="btn btn-secondary btn-sm" disabled="@_busy" @onclick="LoadAsync">Refresh</button>
    </div>
    <Outcome Value="_queueFb" />
    @if (_errors.Count == 0)
    {
        <div class="empty">No unresolved errors.</div>
    }
    else
    {
        <table class="bb">
            <thead>
                <tr>
                    <th>Control id</th>
                    <th>Dir</th>
                    <th>Patient</th>
                    <th>MRN</th>
                    <th>Order / test / unit</th>
                    <th>Message</th>
                    <th>Error</th>
                    <th>Detail</th>
                    <th>Retries</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in _errors)
                {
                    <tr>
                        <td class="mono">@(e.MessageControlId ?? "—")</td>
                        <td>@(e.Direction?.ToString() ?? "—")</td>
                        <td class="nowrap">
                            @if (e.PatientId is long patientId)
                            {
                                <a href="@($"/patients/{patientId}")">@(e.PatientDisplayName ?? e.PatientMrn)</a>
                            }
                            else
                            {
                                @(e.PatientDisplayName ?? "—")
                            }
                        </td>
                        <td class="mono">@(e.PatientMrn ?? "—")</td>
                        <td class="mono">@FormatContext(e.PlacerOrderNumber, e.TestCode, e.UnitNumber)</td>
                        <td>@(string.IsNullOrEmpty(e.MessageType) ? $"#{e.Hl7MessageId}" : $"{e.MessageType}{(string.IsNullOrEmpty(e.TriggerEvent) ? "" : $"^{e.TriggerEvent}")}")</td>
                        <td>@e.ErrorType</td>
                        <td>@e.ErrorDetail</td>
                        <td>@e.RetryCount</td>
                        <td class="right nowrap">
                            <button class="btn btn-ghost btn-sm" @onclick="() => ViewAsync(e.Hl7MessageId)">View</button>
                            @if (e.Direction is null or Hl7Direction.Inbound)
                            {
                                @if (e.ReplayAllowed == false)
                                {
                                    <span class="muted">Replay off</span>
                                }
                                else if (e.ControlAlreadyApplied == true)
                                {
                                    <span class="muted" title="This control id already applied. Replay is not offered.">Applied</span>
                                }
                                else
                                {
                                    <button class="btn btn-ghost btn-sm" disabled="@_busy" @onclick="() => ReplayAsync(e.Hl7MessageId)">Replay</button>
                                }
                            }
                            <button class="btn btn-ghost btn-sm" disabled="@_busy" @onclick="() => BeginResolve(e)">Resolve</button>
                            @if (e.Direction == Hl7Direction.Outbound)
                            {
                                @if (e.RetriesExhausted == true)
                                {
                                    <span class="muted" title="This outbound message has used the endpoint retry limit. Resolve the row, or raise Max retries on the interface.">Retries used</span>
                                }
                                else
                                {
                                    <button class="btn btn-ghost btn-sm" disabled="@_busy" @onclick="() => SendAsync(e.Hl7MessageId)">Send</button>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (_resolveId is not null)
        {
            <div @key="_resolveId" class="alert alert-info" style="margin-top:1rem;" data-scroll-on-show>
                <strong>Resolve @_resolveLabel without replay</strong>
                <div class="field" style="margin-top:.5rem;"><label>Reason for resolving without replay</label><input @bind="_resolveReason" /></div>
                <button class="btn btn-primary btn-sm" disabled="@_busy" @onclick="ResolveAsync">Resolve without replay</button>
                <button class="btn btn-ghost btn-sm" @onclick="() => _resolveId = null">Cancel</button>
            </div>
        }
    }
</div>

<div class="bb-card">
    <div class="bb-card-title"><h3>Submit inbound message</h3></div>
    @if (_ackFb is not null)
    {
        <Outcome Value="_ackFb" />
    }
    @if (!string.IsNullOrEmpty(_ack))
    {
        <div class="bb-card-title"><strong>ACK / NAK</strong></div>
        <div class="pre">@_ack</div>
    }
    <div class="field">
        <label>Raw HL7 (use \r or new lines between segments)</label>
        <textarea rows="8" class="mono" @bind="_raw" placeholder="MSH|^~\&amp;|..."></textarea>
    </div>
    <button class="btn btn-primary" disabled="@_busy" @onclick="SubmitAsync">Submit</button>
    <button class="btn btn-secondary" @onclick="LoadSample">Load ADT sample</button>
</div>

<div class="bb-card">
    <div class="bb-card-title"><h3>Message log</h3>
        <div class="flex gap">
            <button class="btn btn-secondary btn-sm" disabled="@_busy" @onclick="LoadAsync">Refresh</button>
            <button class="btn btn-secondary btn-sm" disabled="@_busy" @onclick="FlushAsync">Send queued outbound</button>
            <button class="btn btn-secondary btn-sm" disabled="@_busy" @onclick="PollFileDropAsync">Poll file drop</button>
        </div>
    </div>
    <Outcome Value="_logFb" />
    @if (_loading)
    {
        <div class="loading">Loading messages...</div>
    }
    else if (_messages.Count == 0)
    {
        <div class="empty">No messages logged.</div>
    }
    else
    {
        <table class="bb">
            <thead><tr><th>Id</th><th>Dir</th><th>Type</th><th>Patient</th><th>MRN</th><th>Order / test / unit</th><th>Control id</th><th>Received</th><th>Status</th><th>Ack</th><th></th></tr></thead>
            <tbody>
                @foreach (var m in _messages)
                {
                    <tr>
                        <td>@m.Id</td>
                        <td>@m.Direction</td>
                        <td>@m.MessageType@(string.IsNullOrEmpty(m.TriggerEvent) ? "" : $"^{m.TriggerEvent}")</td>
                        <td>
                            @if (m.PatientId is long patientId)
                            {
                                <a href="@($"/patients/{patientId}")">@(m.PatientDisplayName ?? m.PatientMrn)</a>
                            }
                            else
                            {
                                @(m.PatientDisplayName ?? "—")
                            }
                        </td>
                        <td class="mono">@(m.PatientMrn ?? "—")</td>
                        <td class="mono">@FormatContext(m.PlacerOrderNumber, m.TestCode, m.UnitNumber)</td>
                        <td class="mono">@m.MessageControlId</td>
                        <td class="nowrap">@m.ReceivedUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td><span class="@Ui.Badge(m.Status)">@m.Status</span></td>
                        <td class="mono">@m.AckCode</td>
                        <td class="right nowrap">
                            @if (m.PatientId is long logChartId)
                            {
                                <a class="btn btn-ghost btn-sm" href="@($"/patients/{logChartId}")">Open chart</a>
                            }
                            <button class="btn btn-ghost btn-sm" @onclick="() => ViewAsync(m.Id)">View</button>
                            @if (m.Direction == Hl7Direction.Inbound)
                            {
                                @if (m.ReplayAllowed == false)
                                {
                                    <span class="muted">Replay off</span>
                                }
                                else if (m.Status is Hl7MessageStatus.Processed or Hl7MessageStatus.Acked or Hl7MessageStatus.Replayed
                                    || m.ControlAlreadyApplied == true)
                                {
                                    <span class="muted" title="This control id already applied. Replay is not offered.">Applied</span>
                                }
                                else
                                {
                                    <button class="btn btn-ghost btn-sm" disabled="@_busy" @onclick="() => ReplayAsync(m.Id)">Replay</button>
                                }
                            }
                            @if (m.Direction == Hl7Direction.Outbound && m.ErrorDetail == BillingService.UnsentDftWithheldDetail)
                            {
                                <span class="muted" title="The charge was cancelled before this DFT was sent.">Charge cancelled</span>
                            }
                            else if (m.Direction == Hl7Direction.Outbound && m.Status is Hl7MessageStatus.Received or Hl7MessageStatus.Errored or Hl7MessageStatus.Nacked)
                            {
                                @if (m.RetriesExhausted == true)
                                {
                                    <span class="muted" title="This outbound message has used the endpoint retry limit. Resolve the error, or raise Max retries on the interface.">Retries used</span>
                                }
                                else
                                {
                                    <button class="btn btn-ghost btn-sm" disabled="@_busy" @onclick="() => SendAsync(m.Id)">Send</button>
                                }
                            }
                        </td>
                    </tr>
                    @if (_viewId == m.Id && _detail is not null)
                    {
                        <tr><td colspan="11">
                            @if (!string.IsNullOrEmpty(m.ErrorDetail))
                            {
                                <div class="alert alert-danger">@m.ErrorDetail</div>
                            }
                            <div class="pre">@_detail.Raw</div>
                        </td></tr>
                    }
                }
            </tbody>
        </table>
    }
    @if (_detail is not null && _viewId is long viewedId && !_messages.Any(m => m.Id == viewedId))
    {
        @* The message is not in the loaded page of the log (e.g. opened from the error queue). *@
        <div class="bb-card" style="margin-top:1rem;" data-scroll-on-show>
            <div class="flex-between">
                <h4 style="margin:0;">Message #@viewedId</h4>
                <button class="btn btn-ghost btn-sm" @onclick="() => { _viewId = null; _detail = null; }">Close</button>
            </div>
            <div class="pre">@_detail.Raw</div>
        </div>
    }
</div>

@code {
    private string _raw = string.Empty;
    private string? _ack;
    private Feedback? _ackFb;
    private Feedback? _logFb;
    // Results show in the card whose button was pressed, not in the manual-submit card.
    private Feedback? _queueFb;
    private string? _resolveLabel;

    private List<Hl7MessageVm> _messages = new();
    private List<Hl7ErrorVm> _errors = new();
    private bool _loading = true;
    private bool _busy;
    private long? _viewId;
    private Hl7MessageDetailVm? _detail;
    private long? _resolveId;
    private string _resolveReason = string.Empty;

    [SupplyParameterFromQuery]
    public long? MessageId { get; set; }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    protected override async Task OnParametersSetAsync()
    {
        if (MessageId is long id && _viewId != id)
        {
            await ViewAsync(id);
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _busy = true;
        var messages = await Api.GetHl7MessagesAsync();
        var errors = await Api.GetHl7ErrorsAsync();
        _messages = messages.Value ?? new();
        _errors = errors.Value ?? new();
        // A refused or failed load must not look like an empty log.
        _logFb = !messages.Succeeded ? messages.ToFeedback() : !errors.Succeeded ? errors.ToFeedback() : null;
        _loading = false;
        _busy = false;
    }

    private async Task SubmitAsync()
    {
        _busy = true;
        _ack = null;
        var normalized = _raw.Replace("\r\n", "\r").Replace("\n", "\r");
        var r = await Api.SendInboundHl7Async(normalized);
        _busy = false;
        _ack = r.Value ?? r.Error;
        _ackFb = r.Succeeded
            ? new Feedback(true, "Message accepted (AA).", Array.Empty<RuleMessage>(), false, false, Array.Empty<RuleMessage>(), null)
            : new Feedback(false, null, Array.Empty<RuleMessage>(), false, false, Array.Empty<RuleMessage>(), "Message rejected — see NAK below.");
        await LoadAsync();
    }

    private async Task ViewAsync(long id)
    {
        if (_viewId == id) { _viewId = null; _detail = null; return; }
        var r = await Api.GetHl7MessageAsync(id);
        if (r.Succeeded) { _detail = r.Value; _viewId = id; _logFb = null; }
        else _logFb = r.ToFeedback();
    }

    private void BeginResolve(Hl7ErrorVm error)
    {
        _resolveId = error.Id;
        _resolveLabel = error.MessageControlId is { Length: > 0 } control ? $"message {control}" : $"message #{error.Hl7MessageId}";
        _resolveReason = string.Empty;
    }

    private async Task ResolveAsync()
    {
        if (_resolveId is null) return;
        _busy = true;
        var r = await Api.ResolveHl7ErrorAsync(_resolveId.Value, _resolveReason);
        _busy = false;
        _queueFb = r.ToFeedback("Error queue row resolved. The stored message was not replayed.");
        if (r.Succeeded)
        {
            _resolveId = null;
            _resolveReason = string.Empty;
        }

        await LoadAsync();
    }

    private async Task ReplayAsync(long id)
    {
        _busy = true;
        var r = await Api.ReplayHl7Async(id);
        _busy = false;
        _ack = r.Value?.Ack;
        _queueFb = r.Succeeded
            ? new Feedback(
                true,
                r.Value?.AckCode == "AA" ? "Replay accepted (AA). Mapping error cleared when the work item resolved." : $"Replay completed ({r.Value?.AckCode}).",
                Array.Empty<RuleMessage>(),
                false,
                false,
                Array.Empty<RuleMessage>(),
                null)
            : r.ToFeedback();
        await LoadAsync();
    }

    private static string FormatContext(string? placer, string? test, string? unit)
    {
        var parts = new[] { placer, test, unit }.Where(v => !string.IsNullOrWhiteSpace(v));
        var text = string.Join(" · ", parts);
        return string.IsNullOrEmpty(text) ? "—" : text;
    }

    private async Task SendAsync(long id)
    {
        _busy = true;
        var r = await Api.SendOutboundHl7Async(id);
        _busy = false;
        _queueFb = r.ToFeedback(r.Value?.AckCode == "AA" ? "Outbound message acknowledged (AA)." : "Outbound send completed.");
        await LoadAsync();
    }

    private async Task FlushAsync()
    {
        _busy = true;
        var r = await Api.FlushOutboundHl7Async();
        _busy = false;
        var fb = r.Succeeded
            ? new Feedback(true, $"Sent {r.Value!.Sent} queued outbound message(s).", Array.Empty<RuleMessage>(), false, false, Array.Empty<RuleMessage>(), null)
            : r.ToFeedback();
        await LoadAsync();
        // LoadAsync clears the log message on success, so report after it (unless the reload failed).
        _logFb ??= fb;
    }

    private async Task PollFileDropAsync()
    {
        _busy = true;
        var r = await Api.PollHl7FileDropAsync();
        _busy = false;
        var fb = r.Succeeded
            ? new Feedback(true, $"Processed {r.Value!.Processed} inbound file-drop message(s).", Array.Empty<RuleMessage>(), false, false, Array.Empty<RuleMessage>(), null)
            : r.ToFeedback();
        await LoadAsync();
        // LoadAsync clears the log message on success, so report after it (unless the reload failed).
        _logFb ??= fb;
    }

    private void LoadSample()
    {
        _raw = "MSH|^~\\&|ADT|HOSP|LIS|LAB|20260101120000||ADT^A04|MSG0001|P|2.5\n"
             + "EVN|A04|20260101120000\n"
             + "PID|1||MRN12345^^^HOSP^MR||DOE^JOHN^A||19800101|M";
    }
}
