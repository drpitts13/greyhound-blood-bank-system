@page "/antibody-id"
@inject BloodBankApiClient Api
@inject UserSession Session
@inject NavigationManager Nav

<PageTitle>Antibody identification worklist &middot; Greyhound Blood Bank LIS</PageTitle>

<h1>Antibody identification</h1>
<p class="muted">
    Open workups across patients. Assistance does not identify antibodies.
    An unscoped open workup, or one linked to a rejected, cancelled, expired, not-yet-received, or not-yet-accepted specimen, is the identification of record for the whole patient and blocks antibody-history verify until completed, voided, or re-linked.
</p>

<Outcome Value="_fb" />

@if (!Session.Has(PermissionCodes.ImmunoRecord) && !Session.Has(PermissionCodes.ImmunoOverride))
{
    <div class="muted">Antibody-identification workups require immuno.record or immuno.override.</div>
}
else
{
    <div class="bb-card">
        <div class="bb-card-title">
            <h3>Open workups</h3>
            <button class="btn btn-secondary btn-sm" type="button" @onclick="LoadAsync">Refresh</button>
        </div>
        @if (!_loading && _items.Count > 0)
        {
            <div class="field" style="max-width:20rem;margin-bottom:.6rem;">
                <label>Filter</label>
                <input @bind="_filter" @bind:event="oninput" placeholder="Patient, MRN, lot, or manufacturer" />
            </div>
            @if (HasSpecimenAttentionFilter || HasActionFilter || HasLotAttentionFilter || HasWithdrawnFilter || HasPendingTypeFilter || HasProductsFilter)
            {
                <div class="alert alert-warning">
                    @if (HasSpecimenAttentionFilter)
                    {
                        @if (string.Equals(SpecimenFilter, AntibodyIdentificationWorklistRule.UnusableSpecimenFilter, StringComparison.OrdinalIgnoreCase))
                        {
                            <span>Showing open workups with a rejected or cancelled specimen. They remain the identification of record until voided or re-linked.</span>
                        }
                        else if (string.Equals(SpecimenFilter, AntibodyIdentificationWorklistRule.UnacceptedSpecimenFilter, StringComparison.OrdinalIgnoreCase))
                        {
                            <span>Showing open workups with a received, not-yet-accepted specimen. They remain the identification of record until accepted, voided, completed, or re-linked.</span>
                        }
                        else if (string.Equals(SpecimenFilter, AntibodyIdentificationWorklistRule.NotReadySpecimenFilter, StringComparison.OrdinalIgnoreCase))
                        {
                            <span>Showing open workups with a collected, not-yet-received specimen. They remain the identification of record until received, voided, or re-linked. Complete HardStops.</span>
                        }
                        else
                        {
                            <span>Showing open workups with an expired specimen. They remain the identification of record until completed, voided, or re-linked.</span>
                        }
                    }
                    @if (HasActionFilter)
                    {
                        <span> Showing workups whose next step is @ActionFilterLabel.</span>
                    }
                    @if (HasLotAttentionFilter)
                    {
                        <span> Showing workups with a withdrawn or expired attached lot. Named lot badges still open a single reagent.</span>
                    }
                    @if (HasWithdrawnFilter)
                    {
                        <span> Showing workups whose interpretation was withdrawn after a later panel, specimen, ABO/Rh, or antigen-type change. Re-interpret before completing.</span>
                    }
                    @if (HasPendingTypeFilter)
                    {
                        <span> Showing workups with an unverified ABO/Rh or antigen correction. Complete and Accept HardStop until it is verified or invalidated.</span>
                    }
                    @if (HasProductsFilter)
                    {
                        <span> Showing workups for patients who have reserved or issued units. Completing requires acknowledgment and does not release those units.</span>
                    }
                    <button class="btn btn-secondary btn-sm" type="button" @onclick="ClearWorklistFilters">Show all open</button>
                </div>
            }
            <p class="muted">
                @_items.Count open.
                @if (RecordReactionsCount > 0)
                {
                    <button class="btn btn-ghost btn-sm" type="button" @onclick="OpenReactionsFilter">
                        @RecordReactionsCount need reactions.
                    </button>
                }
                @if (InterpretCount > 0)
                {
                    <button class="btn btn-ghost btn-sm" type="button" @onclick="OpenInterpretFilter">
                        @InterpretCount need interpretation.
                    </button>
                }
                @if (WithdrawnJudgmentCount > 0)
                {
                    <button class="btn btn-ghost btn-sm" type="button" @onclick="OpenWithdrawnFilter">
                        @WithdrawnJudgmentCount have withdrawn judgment.
                    </button>
                }
                @if (PendingTypeCorrectionCount > 0)
                {
                    <button class="btn btn-ghost btn-sm" type="button" @onclick="OpenPendingTypeFilter">
                        @PendingTypeCorrectionCount have a pending type correction.
                    </button>
                }
                @if (ReservedOrIssuedUnitCount > 0)
                {
                    <button class="btn btn-ghost btn-sm" type="button" @onclick="OpenProductsFilter">
                        @ReservedOrIssuedUnitCount have reserved or issued units.
                    </button>
                }
                @if (ReviewCount > 0)
                {
                    <button class="btn btn-ghost btn-sm" type="button" @onclick="OpenReviewFilter">
                        @ReviewCount need supervisor review.
                    </button>
                }
                @if (UnusableSpecimenCount > 0)
                {
                    <button class="btn btn-ghost btn-sm" type="button" @onclick="OpenUnusableFilter">
                        @UnusableSpecimenCount have a rejected or cancelled specimen.
                    </button>
                }
                @if (NotReadySpecimenCount > 0)
                {
                    <button class="btn btn-ghost btn-sm" type="button" @onclick="OpenNotReadyFilter">
                        @NotReadySpecimenCount have a not-yet-received specimen.
                    </button>
                }
                @if (ExpiredSpecimenCount > 0)
                {
                    <button class="btn btn-ghost btn-sm" type="button" @onclick="OpenExpiredFilter">
                        @ExpiredSpecimenCount have an expired specimen.
                    </button>
                }
                @if (UnacceptedSpecimenCount > 0)
                {
                    <button class="btn btn-ghost btn-sm" type="button" @onclick="OpenUnacceptedFilter">
                        @UnacceptedSpecimenCount have a not-yet-accepted specimen.
                    </button>
                }
                @if (LotAttentionCount > 0)
                {
                    <button class="btn btn-ghost btn-sm" type="button" @onclick="OpenLotAttentionFilter">
                        @LotAttentionCount have a withdrawn or expired lot.
                    </button>
                }
            </p>
        }
        @if (_loading)
        {
            <div class="loading">Loading worklist...</div>
        }
        else if (_items.Count == 0)
        {
            <div class="empty">No open antibody-identification workups. Open a workup from a patient's Antibodies card.</div>
        }
        else if (!Visible.Any())
        {
            <div class="empty">No open workups match that patient, MRN, lot, manufacturer, specimen, next-action, lot-attention, withdrawn-judgment, pending-type, or reserved-unit filter.</div>
        }
        else
        {
            <table class="bb">
                <thead>
                    <tr>
                        <th>Patient</th>
                        <th>MRN</th>
                        <th>Specimen</th>
                        <th>Panel</th>
                        <th>Manufacturer</th>
                        <th>Lot</th>
                        <th>Next</th>
                        <th>Opened</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var w in Visible)
                    {
                        <tr>
                            <td>@(w.PatientName ?? "—")</td>
                            <td class="mono">@(w.PatientMrn ?? "—")</td>
                            <td>
                                @if (string.IsNullOrWhiteSpace(w.SpecimenAccession))
                                {
                                    <span class="muted">Unscoped</span>
                                }
                                else
                                {
                                    <span class="mono">@w.SpecimenAccession</span>
                                    @if (w.HasUnusableSpecimen)
                                    {
                                        <span class="badge badge-red">Rejected/cancelled</span>
                                    }
                                    else if (w.HasNotReadySpecimen)
                                    {
                                        <span class="badge badge-red">Not received</span>
                                    }
                                    else if (w.HasUnacceptedSpecimen)
                                    {
                                        <span class="badge badge-blue">Not accepted</span>
                                    }
                                    else if (w.HasExpiredSpecimen)
                                    {
                                        <span class="badge badge-amber">Expired specimen</span>
                                    }
                                }
                            </td>
                            <td>@w.PanelName</td>
                            <td>@ManufacturerLabel(w)</td>
                            <td class="mono">
                                @LotNumbersLabel(w)
                                @foreach (var lot in w.InactiveLotNumbers ?? [])
                                {
                                    <span class="badge badge-red">Inactive @lot</span>
                                }
                                @foreach (var lot in w.ExpiredLotNumbers ?? [])
                                {
                                    <span class="badge badge-amber">Expired @lot</span>
                                }
                            </td>
                            <td>
                                @NextActionLabel(w.NextAction)
                                @if (w.HasWithdrawnJudgment)
                                {
                                    <span class="badge badge-amber">Judgment withdrawn</span>
                                }
                                @if (w.HasPendingTypeCorrection)
                                {
                                    <span class="badge badge-red">Pending type correction</span>
                                }
                                @if (w.HasReservedOrIssuedUnits)
                                {
                                    <span class="badge badge-amber">Reserved/issued units</span>
                                }
                            </td>
                            <td class="nowrap">@w.CreatedUtc.ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="right nowrap">
                                <button class="btn btn-ghost btn-sm" type="button" @onclick="() => OpenPatient(w.PatientId)">Patient</button>
                                <button class="btn btn-primary btn-sm" type="button" @onclick="() => OpenWorkup(w)">Open</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}

@code {
    [SupplyParameterFromQuery]
    public string? Lot { get; set; }

    [SupplyParameterFromQuery]
    public string? Manufacturer { get; set; }

    [SupplyParameterFromQuery]
    public string? Unusable { get; set; }

    [SupplyParameterFromQuery]
    public string? Expired { get; set; }

    [SupplyParameterFromQuery]
    public string? Unaccepted { get; set; }

    [SupplyParameterFromQuery]
    public string? Notready { get; set; }

    [SupplyParameterFromQuery]
    public string? Action { get; set; }

    [SupplyParameterFromQuery]
    public string? LotAttention { get; set; }

    [SupplyParameterFromQuery]
    public string? Withdrawn { get; set; }

    [SupplyParameterFromQuery]
    public string? TypePending { get; set; }

    [SupplyParameterFromQuery]
    public string? Products { get; set; }

    private readonly List<AntibodyIdWorkupListItemDto> _items = new();
    private Feedback? _fb;
    private bool _loading = true;
    private string _filter = "";

    private string? SpecimenFilter =>
        QueryFlag(Unusable)
            ? AntibodyIdentificationWorklistRule.UnusableSpecimenFilter
            : QueryFlag(Expired)
                ? AntibodyIdentificationWorklistRule.ExpiredSpecimenFilter
                : QueryFlag(Unaccepted)
                    ? AntibodyIdentificationWorklistRule.UnacceptedSpecimenFilter
                    : QueryFlag(Notready)
                        ? AntibodyIdentificationWorklistRule.NotReadySpecimenFilter
                        : null;

    private bool HasSpecimenAttentionFilter => !string.IsNullOrWhiteSpace(SpecimenFilter);

    private string? ActionFilter =>
        string.IsNullOrWhiteSpace(Action) ? null : Action.Trim();

    private bool HasActionFilter =>
        string.Equals(ActionFilter, AntibodyIdentificationWorklistRule.RecordReactionsFilter, StringComparison.OrdinalIgnoreCase)
        || string.Equals(ActionFilter, AntibodyIdentificationWorklistRule.InterpretFilter, StringComparison.OrdinalIgnoreCase)
        || string.Equals(ActionFilter, AntibodyIdentificationWorklistRule.ReviewFilter, StringComparison.OrdinalIgnoreCase);

    private string ActionFilterLabel =>
        string.Equals(ActionFilter, AntibodyIdentificationWorklistRule.InterpretFilter, StringComparison.OrdinalIgnoreCase)
            ? "interpret"
            : string.Equals(ActionFilter, AntibodyIdentificationWorklistRule.ReviewFilter, StringComparison.OrdinalIgnoreCase)
                ? "supervisor review"
                : "record reactions";

    private bool HasLotAttentionFilter => QueryFlag(LotAttention);

    private string? LotAttentionFilter =>
        HasLotAttentionFilter
            ? AntibodyIdentificationWorklistRule.LotAttentionFilter
            : null;

    private bool HasWithdrawnFilter => QueryFlag(Withdrawn);

    private string? WithdrawnFilter =>
        HasWithdrawnFilter
            ? AntibodyIdentificationWorklistRule.WithdrawnJudgmentFilter
            : null;

    private bool HasPendingTypeFilter => QueryFlag(TypePending);

    private string? PendingTypeFilter =>
        HasPendingTypeFilter
            ? AntibodyIdentificationWorklistRule.PendingTypeCorrectionFilter
            : null;

    private bool HasProductsFilter => QueryFlag(Products);

    private string? ProductsFilter =>
        HasProductsFilter
            ? AntibodyIdentificationWorklistRule.OpenProductsFilter
            : null;

    private IEnumerable<AntibodyIdWorkupListItemDto> Visible =>
        _items.Where(w =>
            AntibodyIdentificationWorklistRule.MatchesSpecimenAttention(
                w.HasUnusableSpecimen, w.HasExpiredSpecimen, SpecimenFilter, w.HasUnacceptedSpecimen, w.HasNotReadySpecimen)
            && AntibodyIdentificationWorklistRule.MatchesNextAction(w.NextAction, ActionFilter)
            && AntibodyIdentificationWorklistRule.MatchesLotAttention(
                w.HasInactiveLot, w.HasExpiredLot, LotAttentionFilter)
            && AntibodyIdentificationWorklistRule.MatchesWithdrawnJudgment(
                w.HasWithdrawnJudgment, WithdrawnFilter)
            && AntibodyIdentificationWorklistRule.MatchesPendingTypeCorrection(
                w.HasPendingTypeCorrection, PendingTypeFilter)
            && AntibodyIdentificationWorklistRule.MatchesOpenProducts(
                w.HasReservedOrIssuedUnits, ProductsFilter)
            && MatchesFilter(w, _filter));

    private int RecordReactionsCount => _items.Count(w => w.NextAction == AntibodyIdWorklistNextAction.RecordReactions);
    private int InterpretCount => _items.Count(w => w.NextAction == AntibodyIdWorklistNextAction.Interpret);
    private int ReviewCount => _items.Count(w => w.NextAction == AntibodyIdWorklistNextAction.Review);
    private int LotAttentionCount => _items.Count(w => w.HasInactiveLot || w.HasExpiredLot);
    private int UnusableSpecimenCount => _items.Count(w => w.HasUnusableSpecimen);
    private int ExpiredSpecimenCount => _items.Count(w => w.HasExpiredSpecimen);
    private int UnacceptedSpecimenCount => _items.Count(w => w.HasUnacceptedSpecimen);
    private int NotReadySpecimenCount => _items.Count(w => w.HasNotReadySpecimen);
    private int WithdrawnJudgmentCount => _items.Count(w => w.HasWithdrawnJudgment);
    private int PendingTypeCorrectionCount => _items.Count(w => w.HasPendingTypeCorrection);
    private int ReservedOrIssuedUnitCount => _items.Count(w => w.HasReservedOrIssuedUnits);

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(Lot))
        {
            _filter = Lot;
        }
        else if (!string.IsNullOrWhiteSpace(Manufacturer))
        {
            _filter = Manufacturer;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        var r = await Api.GetOpenAntibodyIdWorkupsAsync();
        _items.Clear();
        if (r.Succeeded && r.Value is not null)
        {
            _items.AddRange(r.Value);
        }
        else
        {
            _fb = r.ToFeedback();
        }
        _loading = false;
    }

    private static string NextActionLabel(AntibodyIdWorklistNextAction action) =>
        action switch
        {
            AntibodyIdWorklistNextAction.Interpret => "Interpret",
            AntibodyIdWorklistNextAction.Review => "Supervisor review",
            AntibodyIdWorklistNextAction.None => "—",
            _ => "Record reactions"
        };

    private static bool MatchesFilter(AntibodyIdWorkupListItemDto workup, string filter)
    {
        if (string.IsNullOrWhiteSpace(filter))
        {
            return true;
        }

        return Contains(workup.PatientMrn, filter)
            || Contains(workup.PatientName, filter)
            || Contains(workup.LotNumber, filter)
            || Contains(workup.PanelName, filter)
            || Contains(workup.SpecimenAccession, filter)
            || (workup.AttachedLotNumbers?.Any(n => Contains(n, filter)) ?? false)
            || Contains(workup.ManufacturerName, filter)
            || (workup.AttachedManufacturers?.Any(n => Contains(n, filter)) ?? false);
    }

    private static bool Contains(string? value, string filter) =>
        !string.IsNullOrWhiteSpace(value)
        && value.Contains(filter, StringComparison.OrdinalIgnoreCase);

    private static string ManufacturerLabel(AntibodyIdWorkupListItemDto workup) =>
        string.IsNullOrWhiteSpace(workup.ManufacturerName) ? "—" : workup.ManufacturerName;

    private static string LotNumbersLabel(AntibodyIdWorkupListItemDto workup)
    {
        var extras = (workup.AttachedLotNumbers ?? [])
            .Where(n => !string.Equals(n, workup.LotNumber, StringComparison.Ordinal))
            .ToList();
        return extras.Count == 0
            ? workup.LotNumber
            : $"{workup.LotNumber} · {string.Join(", ", extras)}";
    }

    private static bool QueryFlag(string? value) =>
        !string.IsNullOrWhiteSpace(value)
        && !string.Equals(value, "0", StringComparison.Ordinal)
        && !string.Equals(value, "false", StringComparison.OrdinalIgnoreCase);

    private void OpenUnusableFilter() =>
        Nav.NavigateTo("/antibody-id?unusable=1");

    private void OpenExpiredFilter() =>
        Nav.NavigateTo("/antibody-id?expired=1");

    private void OpenUnacceptedFilter() =>
        Nav.NavigateTo("/antibody-id?unaccepted=1");

    private void OpenNotReadyFilter() =>
        Nav.NavigateTo("/antibody-id?notready=1");

    private void OpenReactionsFilter() =>
        Nav.NavigateTo("/antibody-id?action=reactions");

    private void OpenInterpretFilter() =>
        Nav.NavigateTo("/antibody-id?action=interpret");

    private void OpenReviewFilter() =>
        Nav.NavigateTo("/antibody-id?action=review");

    private void OpenLotAttentionFilter() =>
        Nav.NavigateTo("/antibody-id?lotAttention=1");

    private void OpenWithdrawnFilter() =>
        Nav.NavigateTo("/antibody-id?withdrawn=1");

    private void OpenPendingTypeFilter() =>
        Nav.NavigateTo("/antibody-id?typePending=1");

    private void OpenProductsFilter() =>
        Nav.NavigateTo("/antibody-id?products=1");

    private void ClearWorklistFilters() => Nav.NavigateTo("/antibody-id");

    private void OpenPatient(long patientId) => Nav.NavigateTo($"/patients/{patientId}");

    private void OpenWorkup(AntibodyIdWorkupListItemDto workup) =>
        Nav.NavigateTo($"/patients/{workup.PatientId}/antibody-id/{workup.Id}");
}
