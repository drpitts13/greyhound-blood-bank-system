@page "/reports"
@inject BloodBankApiClient Api
@inject UserSession Session
@inject NavigationManager Nav

<PageTitle>Reports · Greyhound Blood Bank LIS</PageTitle>

<h1>Reports</h1>
<p class="muted">Facility operational reports for review and export. This starter set is not an FDA, AABB, or CAP compliance claim.</p>

@if (!Session.HasAny(PermissionCodes.ReportRun, PermissionCodes.ReportDesign))
{
    <div class="muted">No permission to run reports.</div>
}
else
{
    <div class="bb-card">
        <div class="bb-card-title">
            <h3>Catalog</h3>
            <span>
                @if (Session.Has(PermissionCodes.ReportDesign))
                {
                    <button class="btn btn-secondary btn-sm" @onclick='() => Nav.NavigateTo("reports/design?kind=visual")'>New visual report</button>
                    <button class="btn btn-secondary btn-sm" @onclick='() => Nav.NavigateTo("reports/design?kind=sql")'>New SQL report</button>
                }
                <button class="btn btn-secondary btn-sm" disabled="@_busy" @onclick="LoadAsync">Refresh</button>
            </span>
        </div>
        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-danger">@_error</div>
        }
        @if (_rows.Count == 0)
        {
            <div class="empty">No reports are available.</div>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr><th>Name</th><th>Code</th><th>Kind</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var row in _rows)
                    {
                        <tr>
                            <td>
                                <strong>@row.Name</strong>
                                @if (row.IsSystemOwned)
                                {
                                    <span class="muted"> · ready to run</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(row.Description))
                                {
                                    <div class="muted">@row.Description</div>
                                }
                            </td>
                            <td class="mono">@row.Code</td>
                            <td>@(row.Kind == ReportKind.Sql ? "SQL" : "Visual")</td>
                            <td>
                                <a class="btn btn-primary btn-sm" href="@($"reports/{row.Id}")">Run</a>
                                @if (Session.Has(PermissionCodes.ReportDesign))
                                {
                                    <a class="btn btn-secondary btn-sm" href="@($"reports/design/{row.Id}")">Design</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}

@code {
    private List<ReportSummaryDto> _rows = new();
    private string? _error;
    private bool _busy;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _busy = true;
        var result = await Api.GetReportsAsync();
        _rows = result.Succeeded && result.Value is not null ? result.Value : new();
        _error = result.Succeeded ? null : result.Error;
        _busy = false;
    }
}
