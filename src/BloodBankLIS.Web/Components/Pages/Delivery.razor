@page "/inventory/deliveries/{Id:long}"
@using BloodBankLIS.Application.Inventory
@using BloodBankLIS.Application.Reference
@using BloodBankLIS.Domain.Enums
@using BloodBankLIS.Domain.Rules
@inject BloodBankApiClient Api
@inject UserSession Session

<PageTitle>Delivery @Id &middot; Greyhound Blood Bank LIS</PageTitle>

<InventoryDeskRibbon Current="InventoryDeskRibbon.Desk.Inventory" />

<div class="flex-between" style="margin-bottom:1rem;">
    <h1>Delivery @Id</h1>
    <div class="flex gap">
        @if (_delivery?.Status == DeliveryStatus.Open && Session.Has(PermissionCodes.InventoryReceive))
        {
            <a class="btn btn-primary" href="@($"/inventory/deliveries/{Id}/receive")">Enter units</a>
        }
        <a class="btn btn-ghost" href="/inventory">Back to inventory</a>
    </div>
</div>

<Outcome Value="_feedback" />

@if (_delivery is null)
{
    <div class="loading">@(_missing ? "Delivery not found." : "Loading...")</div>
}
else
{
    <div class="bb-card">
        <div class="form-row">
            <div class="field"><label>Supplier</label>
                @if (_delivery.SupplierLocked || _delivery.Status != DeliveryStatus.Open)
                {
                    <div>@_delivery.SupplierCode — @_delivery.SupplierName</div>
                }
                else
                {
                    <select @bind="_supplierId">
                        @foreach (var s in _suppliers) { <option value="@s.Id">@s.DisplayName</option> }
                    </select>
                }
            </div>
            <div class="field"><label>Ordered (UTC)</label>
                @if (_delivery.Status == DeliveryStatus.Open)
                {
                    <input type="datetime-local" @bind="_orderedLocal" />
                }
                else
                {
                    <div>@_delivery.OrderedUtc.ToString("yyyy-MM-dd HH:mm")</div>
                }
            </div>
            <div class="field"><label>Received</label><div>@_delivery.ReceivedUtc.ToString("yyyy-MM-dd HH:mm")</div></div>
            <div class="field"><label>Packing list</label>
                @if (_delivery.Status == DeliveryStatus.Open)
                {
                    <input @bind="_packingList" placeholder="Optional" />
                }
                else
                {
                    <div class="mono">@(_delivery.PackingListNumber ?? "—")</div>
                }
            </div>
            <div class="field"><label>Status</label><div>@_delivery.Status</div></div>
        </div>
    </div>

    <div class="bb-card">
        <div class="bb-card-title"><h3>Expected counts</h3></div>
        <p class="muted">Counts are by product, such as RBC or FFP. Received counts come from the units entered on this delivery. More units than expected is allowed and shows as over.</p>
        <table class="bb">
            <thead><tr><th>Product</th><th>Expected</th><th>Received</th><th>Variance</th></tr></thead>
            <tbody>
                @foreach (var line in _lines)
                {
                    <tr>
                        <td>
                            @if (_delivery.Status == DeliveryStatus.Open)
                            {
                                <select @bind="line.ComponentClass" disabled="@(line.ReceivedQuantity > 0 && line.Id > 0)">
                                    @foreach (var product in Enum.GetValues<ComponentClass>())
                                    {
                                        <option value="@product">@ComponentClassLabels.Label(product)</option>
                                    }
                                </select>
                            }
                            else
                            {
                                @line.ProductLabel
                            }
                        </td>
                        <td>
                            @if (_delivery.Status == DeliveryStatus.Open)
                            {
                                <input type="number" min="1" @bind="line.ExpectedQuantity" />
                            }
                            else
                            {
                                @line.ExpectedQuantity
                            }
                        </td>
                        <td>@line.ReceivedQuantity</td>
                        <td>@VarianceLabel(line.ReceivedQuantity - line.ExpectedQuantity)</td>
                    </tr>
                }
            </tbody>
        </table>
        @if (_delivery.Status == DeliveryStatus.Open && Session.Has(PermissionCodes.InventoryReceive))
        {
            <div class="flex gap" style="margin-top:.6rem;">
                <button class="btn btn-secondary" type="button" @onclick="AddLine">Add product</button>
                <button class="btn btn-primary" disabled="@_busy" @onclick="SaveDeliveryAsync">Save delivery</button>
                <button class="btn btn-secondary" disabled="@_busy" @onclick="CompleteAsync">Complete delivery</button>
            </div>
        }
    </div>

    <div class="bb-card">
        <div class="bb-card-title"><h3>Units on this delivery</h3></div>
        @if (_delivery.Units.Count == 0)
        {
            <div class="muted">No units entered yet.</div>
        }
        else
        {
            <table class="bb">
                <thead><tr><th>Unit</th><th>Product</th><th>ABO/Rh</th><th>Status</th><th></th></tr></thead>
                <tbody>
                    @foreach (var unit in _delivery.Units)
                    {
                        <tr>
                            <td class="mono">@unit.UnitNumber</td>
                            <td>@ProductName(unit.ProductTypeId)</td>
                            <td><strong>@Ui.BloodType(unit.Abo, unit.RhD)</strong></td>
                            <td><span class="@Ui.Badge(unit.Status)">@Ui.StatusLabel(unit.Status)</span></td>
                            <td class="right"><a class="btn btn-ghost btn-sm" href="@InventoryUrls.Unit(unit.Id)">Open</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}

@code {
    [Parameter] public long Id { get; set; }

    private DeliveryDetailDto? _delivery;
    private bool _missing;
    private bool _busy;
    private Feedback? _feedback;
    private List<BloodSupplierRefDto> _suppliers = new();
    private List<ProductTypeDto> _productTypes = new();
    private List<LineDraft> _lines = new();
    private long _supplierId;
    private DateTime _orderedLocal;
    private string? _packingList;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _productTypes = (await Api.GetProductTypesAsync()).Value ?? new();
        _suppliers = (await Api.GetBloodSuppliersAsync()).Value ?? new();

        var r = await Api.GetDeliveryAsync(Id);
        if (!r.Succeeded || r.Value is null)
        {
            _delivery = null;
            _missing = true;
            _feedback = r.ToFeedback();
            return;
        }

        _missing = false;
        Apply(r.Value);
    }

    private void Apply(DeliveryDetailDto delivery)
    {
        _delivery = delivery;
        _supplierId = delivery.BloodSupplierId;
        _orderedLocal = delivery.OrderedUtc;
        _packingList = delivery.PackingListNumber;
        _lines = delivery.Lines.Select(l => new LineDraft
        {
            Id = l.Id,
            ComponentClass = l.ComponentClass,
            ProductLabel = l.ProductLabel,
            ExpectedQuantity = l.ExpectedQuantity,
            ReceivedQuantity = l.ReceivedQuantity
        }).ToList();
    }

    private void AddLine()
    {
        var next = Enum.GetValues<ComponentClass>().FirstOrDefault(c => _lines.All(l => l.ComponentClass != c));
        _lines.Add(new LineDraft
        {
            ComponentClass = next,
            ExpectedQuantity = 1
        });
    }

    private async Task SaveDeliveryAsync()
    {
        if (_delivery is null) return;
        var lines = _lines
            .Select(l => new SaveDeliveryLineRequest(l.ComponentClass, l.ExpectedQuantity))
            .ToList();
        _busy = true;
        var r = await Api.UpdateDeliveryAsync(Id, new UpdateDeliveryRequest(
            _delivery.SupplierLocked ? _delivery.BloodSupplierId : _supplierId,
            DateTime.SpecifyKind(_orderedLocal, DateTimeKind.Utc),
            string.IsNullOrWhiteSpace(_packingList) ? null : _packingList.Trim(),
            lines));
        _busy = false;
        _feedback = r.Succeeded ? r.ToFeedback("Delivery saved.") : r.ToFeedback();
        if (r.Succeeded && r.Value is not null) Apply(r.Value);
    }

    private async Task CompleteAsync()
    {
        _busy = true;
        var r = await Api.CompleteDeliveryAsync(Id);
        _busy = false;
        _feedback = r.Succeeded ? r.ToFeedback("Delivery completed.") : r.ToFeedback();
        if (r.Succeeded && r.Value is not null) Apply(r.Value);
    }

    private string ProductName(long productTypeId) =>
        _productTypes.FirstOrDefault(t => t.Id == productTypeId)?.Name ?? "—";

    private static string VarianceLabel(int variance) =>
        variance == 0 ? "Even" : variance > 0 ? $"+{variance} over" : $"{variance} short";

    private sealed class LineDraft
    {
        public long Id { get; set; }
        public ComponentClass ComponentClass { get; set; }
        public string ProductLabel { get; set; } = string.Empty;
        public int ExpectedQuantity { get; set; } = 1;
        public int ReceivedQuantity { get; set; }
    }
}
