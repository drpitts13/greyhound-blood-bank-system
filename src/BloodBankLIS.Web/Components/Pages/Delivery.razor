@page "/inventory/deliveries/{Id:long}"
@using BloodBankLIS.Application.Inventory
@using BloodBankLIS.Application.Reference
@inject BloodBankApiClient Api
@inject UserSession Session
@inject NavigationManager Nav

<PageTitle>Delivery @Id &middot; Greyhound Blood Bank LIS</PageTitle>

<InventoryDeskRibbon Current="InventoryDeskRibbon.Desk.Inventory" />

<div class="flex-between" style="margin-bottom:1rem;">
    <h1>Delivery @Id</h1>
    <a class="btn btn-ghost" href="/inventory">Back to inventory</a>
</div>

<Outcome Value="_feedback" />

@if (_delivery is null)
{
    <div class="loading">@(_missing ? "Delivery not found." : "Loading...")</div>
}
else
{
    <div class="bb-card">
        <div class="form-row">
            <div class="field"><label>Supplier</label>
                @if (_delivery.SupplierLocked || _delivery.Status != DeliveryStatus.Open)
                {
                    <div>@_delivery.SupplierCode — @_delivery.SupplierName</div>
                }
                else
                {
                    <select @bind="_supplierId">
                        @foreach (var s in _suppliers) { <option value="@s.Id">@s.DisplayName</option> }
                    </select>
                }
            </div>
            <div class="field"><label>Ordered (UTC)</label>
                @if (_delivery.Status == DeliveryStatus.Open)
                {
                    <input type="datetime-local" @bind="_orderedLocal" />
                }
                else
                {
                    <div>@_delivery.OrderedUtc.ToString("yyyy-MM-dd HH:mm")</div>
                }
            </div>
            <div class="field"><label>Received</label><div>@_delivery.ReceivedUtc.ToString("yyyy-MM-dd HH:mm")</div></div>
            <div class="field"><label>Packing list</label>
                @if (_delivery.Status == DeliveryStatus.Open)
                {
                    <input @bind="_packingList" placeholder="Optional" />
                }
                else
                {
                    <div class="mono">@(_delivery.PackingListNumber ?? "—")</div>
                }
            </div>
            <div class="field"><label>Status</label><div>@_delivery.Status</div></div>
        </div>
    </div>

    <div class="bb-card">
        <div class="bb-card-title"><h3>Expected counts</h3></div>
        <p class="muted">Received counts come from the units entered on this delivery. More units than expected is allowed and shows as over.</p>
        <table class="bb">
            <thead><tr><th>Product</th><th>Expected</th><th>Received</th><th>Variance</th></tr></thead>
            <tbody>
                @foreach (var line in _lines)
                {
                    <tr>
                        <td>
                            @if (_delivery.Status == DeliveryStatus.Open)
                            {
                                <select @bind="line.ProductTypeId" disabled="@line.ReceivedQuantity > 0 && line.Id > 0">
                                    @foreach (var t in _productTypes)
                                    {
                                        <option value="@t.Id">@t.DisplayProductCode — @t.Name</option>
                                    }
                                </select>
                            }
                            else
                            {
                                @line.ProductCode <span> — @line.ProductName</span>
                            }
                        </td>
                        <td>
                            @if (_delivery.Status == DeliveryStatus.Open)
                            {
                                <input type="number" min="1" @bind="line.ExpectedQuantity" />
                            }
                            else
                            {
                                @line.ExpectedQuantity
                            }
                        </td>
                        <td>@line.ReceivedQuantity</td>
                        <td>@VarianceLabel(line.ReceivedQuantity - line.ExpectedQuantity)</td>
                    </tr>
                }
            </tbody>
        </table>
        @if (_delivery.Status == DeliveryStatus.Open && Session.Has(PermissionCodes.InventoryReceive))
        {
            <div class="flex gap" style="margin-top:.6rem;">
                <button class="btn btn-secondary" type="button" @onclick="AddLine">Add product type</button>
                <button class="btn btn-primary" disabled="@_busy" @onclick="SaveDeliveryAsync">Save delivery</button>
                <button class="btn btn-secondary" disabled="@_busy" @onclick="CompleteAsync">Complete delivery</button>
            </div>
        }
    </div>

    <div class="bb-card">
        <div class="bb-card-title"><h3>Units on this delivery</h3></div>
        @if (_delivery.Units.Count == 0)
        {
            <div class="muted">No units entered yet.</div>
        }
        else
        {
            <table class="bb">
                <thead><tr><th>Unit</th><th>Product</th><th>ABO/Rh</th><th>Status</th><th></th></tr></thead>
                <tbody>
                    @foreach (var unit in _delivery.Units)
                    {
                        <tr>
                            <td class="mono">@unit.UnitNumber</td>
                            <td>@ProductName(unit.ProductTypeId)</td>
                            <td><strong>@Ui.BloodType(unit.Abo, unit.RhD)</strong></td>
                            <td><span class="@Ui.Badge(unit.Status)">@Ui.StatusLabel(unit.Status)</span></td>
                            <td class="right"><a class="btn btn-ghost btn-sm" href="@InventoryUrls.Unit(unit.Id)">Open</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    @if (_delivery.Status == DeliveryStatus.Open && Session.Has(PermissionCodes.InventoryReceive))
    {
        <div class="bb-card">
            <div class="bb-card-title"><h3>Receive a unit</h3></div>
            <p class="muted">The supplier comes from this delivery. Choose a product type that is on the expected counts.</p>
            <div class="form-row">
                <div class="field"><label>Unit number</label><input @bind="_rec.UnitNumber" /></div>
                <div class="field"><label>Product type</label>
                    <select @bind="_rec.ProductTypeId">
                        <option value="0">— select —</option>
                        @foreach (var line in _delivery.Lines)
                        {
                            <option value="@line.ProductTypeId">@line.ProductCode — @line.ProductName</option>
                        }
                    </select>
                </div>
                <div class="field"><label>ABO</label><select @bind="_rec.Abo">@foreach (var a in Enum.GetValues<AboGroup>()) { <option value="@a">@a</option> }</select></div>
                <div class="field"><label>Rh(D)</label><select @bind="_rec.RhD">@foreach (var r in Enum.GetValues<RhType>()) { <option value="@r">@r</option> }</select></div>
                <div class="field"><label>Expires (UTC)</label><input type="datetime-local" @bind="_rec.ExpiresLocal" /></div>
                <div class="field"><label>Location</label>
                    <select @bind="_rec.LocationId">
                        <option value="0">— none —</option>
                        @foreach (var l in _locations) { <option value="@l.Id">@l.Code — @l.Name</option> }
                    </select>
                </div>
                <div class="field"><label>Product description code</label>
                    <input @bind="_rec.ProductDescriptionCode" placeholder="E0336 or E0336000" maxlength="8" />
                </div>
                <div class="field"><label>Collection facility</label><input @bind="_rec.CollectionFacility" /></div>
            </div>
            <div class="form-row">
                <div class="field"><label>Appearance</label>
                    <select @bind="_rec.Appearance">
                        @foreach (var a in Enum.GetValues<UnitAppearance>()) { <option value="@a">@a</option> }
                    </select>
                </div>
                <div class="field"><label>Visual notes</label><input @bind="_rec.VisualInspectionNotes" /></div>
                <div class="field"><label>Receipt temperature (°C)</label>
                    <input type="number" step="0.1" @bind="_rec.ReceiveTemperatureCelsius" placeholder="e.g. 4.0" />
                    <span class="muted">Shipping cooler 1–10 °C</span>
                </div>
                <div class="field"><label>Donation</label>
                    <select @bind="_rec.DonationRestriction">
                        @foreach (var d in Enum.GetValues<DonationRestriction>()) { <option value="@d">@d</option> }
                    </select>
                </div>
                @if (_rec.DonationRestriction != DonationRestriction.Allogeneic)
                {
                    <div class="field" style="min-width:16rem;">
                        <label>Intended recipient</label>
                        <FilterableComboBox TItem="PatientDto" TValue="long?"
                            Items="_patients"
                            @bind-Value="_rec.ReservedPatientId"
                            DisplayText="@(p => $"{p.LastName}, {p.FirstName} ({p.MedicalRecordNumber})")"
                            ItemValue="@(p => p.Id)"
                            SearchText="@(p => $"{p.LastName} {p.FirstName} {p.MedicalRecordNumber}")"
                            Clearable="true"
                            Placeholder="Autologous / directed patient" />
                    </div>
                }
                <div class="field" style="min-width:16rem;">
                    <label>Second verifier</label>
                    <FilterableComboBox TItem="DirectoryUserDto" TValue="string?"
                        Items="ReceiveVerifierChoices"
                        @bind-Value="_rec.SecondVerifier"
                        DisplayText="@(x => x.Label)"
                        ItemValue="@(x => x.UserName)"
                        SearchText="@(x => x.Label)"
                        Clearable="true"
                        Placeholder="Different active user" />
                </div>
            </div>
            <button class="btn btn-primary" disabled="@_busy" @onclick="ReceiveAsync">Receive</button>
        </div>
    }
}

@code {
    [Parameter] public long Id { get; set; }

    private DeliveryDetailDto? _delivery;
    private bool _missing;
    private bool _busy;
    private Feedback? _feedback;
    private List<BloodSupplierRefDto> _suppliers = new();
    private List<ProductTypeDto> _productTypes = new();
    private List<InventoryLocationDto> _locations = new();
    private List<DirectoryUserDto> _directoryUsers = new();
    private List<PatientDto> _patients = new();
    private List<LineDraft> _lines = new();
    private long _supplierId;
    private DateTime _orderedLocal;
    private string? _packingList;
    private ReceiveModel _rec = new();

    private IEnumerable<DirectoryUserDto> ReceiveVerifierChoices =>
        _directoryUsers.Where(u => !string.Equals(u.UserName, Session.UserName, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _productTypes = (await Api.GetProductTypesAsync()).Value ?? new();
        _locations = (await Api.GetLocationsAsync()).Value ?? new();
        _suppliers = (await Api.GetBloodSuppliersAsync()).Value ?? new();
        var users = await Api.GetDirectoryUsersAsync();
        if (users.Succeeded) _directoryUsers = users.Value ?? new();
        var patients = await Api.GetPatientsAsync();
        if (patients.Succeeded) _patients = patients.Value ?? new();

        var r = await Api.GetDeliveryAsync(Id);
        if (!r.Succeeded || r.Value is null)
        {
            _delivery = null;
            _missing = true;
            _feedback = r.ToFeedback();
            return;
        }

        _missing = false;
        Apply(r.Value);
    }

    private void Apply(DeliveryDetailDto delivery)
    {
        _delivery = delivery;
        _supplierId = delivery.BloodSupplierId;
        _orderedLocal = delivery.OrderedUtc;
        _packingList = delivery.PackingListNumber;
        _lines = delivery.Lines.Select(l => new LineDraft
        {
            Id = l.Id,
            ProductTypeId = l.ProductTypeId,
            ProductCode = l.ProductCode,
            ProductName = l.ProductName,
            ExpectedQuantity = l.ExpectedQuantity,
            ReceivedQuantity = l.ReceivedQuantity
        }).ToList();
        if (_rec.ProductTypeId == 0 && delivery.Lines.Count > 0)
        {
            _rec.ProductTypeId = delivery.Lines[0].ProductTypeId;
        }
    }

    private void AddLine()
    {
        var next = _productTypes.FirstOrDefault(t => _lines.All(l => l.ProductTypeId != t.Id));
        _lines.Add(new LineDraft
        {
            ProductTypeId = next?.Id ?? 0,
            ExpectedQuantity = 1
        });
    }

    private async Task SaveDeliveryAsync()
    {
        if (_delivery is null) return;
        var lines = _lines
            .Where(l => l.ProductTypeId > 0)
            .Select(l => new SaveDeliveryLineRequest(l.ProductTypeId, l.ExpectedQuantity))
            .ToList();
        _busy = true;
        var r = await Api.UpdateDeliveryAsync(Id, new UpdateDeliveryRequest(
            _delivery.SupplierLocked ? _delivery.BloodSupplierId : _supplierId,
            DateTime.SpecifyKind(_orderedLocal, DateTimeKind.Utc),
            string.IsNullOrWhiteSpace(_packingList) ? null : _packingList.Trim(),
            lines));
        _busy = false;
        _feedback = r.Succeeded ? r.ToFeedback("Delivery saved.") : r.ToFeedback();
        if (r.Succeeded && r.Value is not null) Apply(r.Value);
    }

    private async Task CompleteAsync()
    {
        _busy = true;
        var r = await Api.CompleteDeliveryAsync(Id);
        _busy = false;
        _feedback = r.Succeeded ? r.ToFeedback("Delivery completed.") : r.ToFeedback();
        if (r.Succeeded && r.Value is not null) Apply(r.Value);
    }

    private async Task ReceiveAsync()
    {
        if (_rec.ProductTypeId <= 0 || string.IsNullOrWhiteSpace(_rec.UnitNumber))
        {
            _feedback = Feedback.Fail("Unit number and product type are required.");
            return;
        }

        _busy = true;
        var req = new ReceiveUnitRequest(
            _rec.UnitNumber.Trim(),
            _rec.ProductTypeId,
            _rec.Abo,
            _rec.RhD,
            DateTime.SpecifyKind(_rec.ExpiresLocal, DateTimeKind.Utc),
            _rec.LocationId == 0 ? null : _rec.LocationId,
            string.IsNullOrWhiteSpace(_rec.CollectionFacility) ? null : _rec.CollectionFacility.Trim(),
            Isbt128ProductCode: string.IsNullOrWhiteSpace(_rec.ProductDescriptionCode) ? null : _rec.ProductDescriptionCode.Trim(),
            VisualInspectionAcceptable: _rec.Appearance == UnitAppearance.Acceptable,
            VisualInspectionNotes: string.IsNullOrWhiteSpace(_rec.VisualInspectionNotes) ? null : _rec.VisualInspectionNotes,
            SecondVerifier: _rec.SecondVerifier,
            Appearance: _rec.Appearance,
            ReceiveTemperatureCelsius: _rec.ReceiveTemperatureCelsius,
            DonationRestriction: _rec.DonationRestriction,
            ReservedPatientId: _rec.DonationRestriction == DonationRestriction.Allogeneic ? null : _rec.ReservedPatientId,
            DeliveryId: Id);
        var r = await Api.ReceiveUnitAsync(req);
        _busy = false;
        _feedback = r.ToFeedback(r.Value?.Status == UnitStatus.Received
            ? "Unit received. Pending retype until results are entered and verified."
            : "Unit received.");
        if (r.Succeeded)
        {
            _rec = new ReceiveModel();
            await LoadAsync();
        }
    }

    private string ProductName(long productTypeId) =>
        _delivery?.Lines.FirstOrDefault(l => l.ProductTypeId == productTypeId)?.ProductName
        ?? _productTypes.FirstOrDefault(t => t.Id == productTypeId)?.Name
        ?? "—";

    private static string VarianceLabel(int variance) =>
        variance == 0 ? "Even" : variance > 0 ? $"+{variance} over" : $"{variance} short";

    private sealed class LineDraft
    {
        public long Id { get; set; }
        public long ProductTypeId { get; set; }
        public string ProductCode { get; set; } = string.Empty;
        public string ProductName { get; set; } = string.Empty;
        public int ExpectedQuantity { get; set; } = 1;
        public int ReceivedQuantity { get; set; }
    }

    private sealed class ReceiveModel
    {
        public string UnitNumber { get; set; } = string.Empty;
        public long ProductTypeId { get; set; }
        public AboGroup Abo { get; set; } = AboGroup.O;
        public RhType RhD { get; set; } = RhType.Positive;
        public DateTime ExpiresLocal { get; set; } = DateTime.UtcNow.AddDays(30);
        public long LocationId { get; set; }
        public string ProductDescriptionCode { get; set; } = string.Empty;
        public string? CollectionFacility { get; set; }
        public string? VisualInspectionNotes { get; set; }
        public UnitAppearance Appearance { get; set; } = UnitAppearance.Acceptable;
        public decimal? ReceiveTemperatureCelsius { get; set; }
        public DonationRestriction DonationRestriction { get; set; } = DonationRestriction.Allogeneic;
        public long? ReservedPatientId { get; set; }
        public string? SecondVerifier { get; set; }
    }
}
