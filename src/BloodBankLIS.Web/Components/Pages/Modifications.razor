@page "/inventory/modify"
@using BloodBankLIS.Domain.Isbt128
@inject BloodBankApiClient Api
@inject UserSession Session

<PageTitle>Modify Products &middot; Greyhound Blood Bank LIS</PageTitle>

<h1>Modify Blood Products</h1>
<p class="muted">
    Divide, pool, irradiate, thaw, volume-reduce, or leukoreduce a unit into a new product under an
    admin-configured modification rule. The source unit(s) are retired and new result unit(s) are created
    in Quarantine with the rule's target product code and a recalculated expiration.
</p>

<div class="bb-card">
    <div class="bb-card-title"><h3>1. Find the source unit</h3></div>
    <div class="field">
        <label>Unit number</label>
        <UnitPickerComboBox Scope="UnitPickerScope.Available"
            Value="_sourceUnitId"
            ValueChanged="OnSourceIdChanged"
            SelectedItemChanged="OnSourceSelectedAsync" />
    </div>
    <Outcome Value="_searchFb" />
</div>

@if (_unit is not null)
{
    <div class="bb-card">
        <div class="bb-card-title"><h3>2. Selected unit</h3></div>
        <div class="form-row">
            <div class="field"><label>Unit number</label><div class="mono">@_unit.UnitNumber</div></div>
            <div class="field"><label>Product code</label><div class="mono">@(SourceProductCode ?? "—")</div></div>
            <div class="field"><label>Volume</label><div>@FormatVolume(_unit.Volume)</div></div>
            <div class="field"><label>ABO/Rh</label><div><strong>@Ui.BloodType(_unit.Abo, _unit.RhD)</strong></div></div>
            <div class="field"><label>Status</label><div><span class="@Ui.Badge(_unit.Status)">@_unit.Status</span></div></div>
            <div class="field"><label>Expires</label><div>@_unit.ExpiresUtc.ToString("yyyy-MM-dd HH:mm")</div></div>
        </div>

        @if (_eligible.Count == 0)
        {
            <div class="empty">No active modification rules apply to this unit's current product.</div>
        }
        else
        {
            <div class="field"><label>Modification</label>
                <select @bind="_selectedRuleId" @bind:after="OnRuleChanged">
                    <option value="0">-- select a modification --</option>
                    @foreach (var e in _eligible)
                    {
                        <option value="@e.RuleId" disabled="@(!e.IsAvailable)">
                            @e.ModificationCode — @e.ModificationType &rarr; @e.TargetProductCode (@e.ExpirationOffsetCode from @RelativeLabel(e.ExpirationRelativeTo))@(e.IsAvailable ? "" : " — collection date required")
                        </option>
                    }
                </select>
            </div>
        }
    </div>
}

@if (_unit is not null && _selectedRule is not null && !_selectedRule.IsAvailable)
{
    <div class="bb-card">
        <div class="empty">
            This expiration code is relative to collection date/time, but the selected unit has no collection date/time.
        </div>
    </div>
}

@if (_unit is not null && _selectedRule is not null && _selectedRule.IsAvailable)
{
    <div class="bb-card">
        <div class="bb-card-title"><h3>3. Modification details</h3></div>
        <div class="form-row">
            <div class="field"><label>Modification code</label><div class="mono">@_selectedRule.ModificationCode</div></div>
            <div class="field"><label>New product</label><div class="mono">@_selectedRule.TargetProductCode</div></div>
            <div class="field"><label>New expiration</label>
                <div>@(_selectedRule.PreviewExpiresUtc?.ToString("yyyy-MM-dd HH:mm") ?? "—")</div>
                <div class="muted">@_selectedRule.ExpirationOffsetCode from @RelativeLabel(_selectedRule.ExpirationRelativeTo), capped at source expiration</div>
            </div>
        </div>
        <Outcome Value="_actionFb" />

        @if (_selectedRule.ModificationType == ModificationType.Divide)
        {
            <div class="field"><label>Number of result units</label>
                <input type="number" min="2" @bind="_childCount" @bind:after="SyncChildRows" />
            </div>
            @if (_children.Count > 0)
            {
                <table class="bb">
                    <thead><tr><th>#</th><th>Generated product code</th><th>Volume (mL, required)</th></tr></thead>
                    <tbody>
                        @for (var i = 0; i < _children.Count; i++)
                        {
                            var row = _children[i];
                            <tr>
                                <td>@(i + 1)</td>
                                <td class="mono">@(row.PreviewProductCode ?? "—")</td>
                                <td><input type="number" step="0.01" min="0.01" @bind="row.Volume" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        }
        else if (_selectedRule.ModificationType == ModificationType.Pool)
        {
            <p class="muted">
                Add two or more units of the same product, ABO, and Rh(D) to pool (the selected unit above is
                included automatically as the first source).
            </p>
            <div class="field">
                <label>Additional unit number</label>
                <UnitPickerComboBox Scope="UnitPickerScope.Available"
                    Value="_poolPickId"
                    ValueChanged="OnPoolIdChanged"
                    SelectedItemChanged="OnPoolUnitSelected"
                    ExcludeIds="PoolExcludeIds" />
            </div>
            <table class="bb" style="margin-top:.6rem;">
                <thead><tr><th>Unit #</th><th>ABO/Rh</th><th></th></tr></thead>
                <tbody>
                    <tr>
                        <td class="mono">@_unit.UnitNumber</td>
                        <td>@Ui.BloodType(_unit.Abo, _unit.RhD)</td>
                        <td class="muted">primary</td>
                    </tr>
                    @foreach (var p in _poolUnits)
                    {
                        <tr>
                            <td class="mono">@p.UnitNumber</td>
                            <td>@Ui.BloodType(p.Abo, p.RhD)</td>
                            <td class="right"><button class="btn btn-ghost btn-sm" @onclick="() => _poolUnits.Remove(p)">Remove</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="field"><label>Result volume (optional; defaults to source volume)</label>
                <input type="number" step="0.01" @bind="_singleResultVolume" />
            </div>
        }

        <div class="field" style="margin-top:.6rem;"><label>Reason (required)</label>
            <input @bind="_reason" placeholder="Why is this modification being performed?" style="width:100%;" />
        </div>

        <button class="btn btn-primary" style="margin-top:.6rem;" disabled="@(_busy || string.IsNullOrWhiteSpace(_reason))" @onclick="SubmitAsync">
            Perform @_selectedRule.ModificationType
        </button>
    </div>
}

@if (_lastResult is not null)
{
    <div class="bb-card">
        <div class="bb-card-title"><h3>Result</h3></div>
        <table class="bb">
            <thead><tr><th>New unit #</th><th>Product code</th><th>Volume</th><th>ABO/Rh</th><th>Status</th><th>Expires</th></tr></thead>
            <tbody>
                @foreach (var u in _lastResult.ResultUnits)
                {
                    <tr>
                        <td class="mono">@u.UnitNumber</td>
                        <td class="mono">@(u.ProductCodeData ?? u.Isbt128ProductCode ?? "—")</td>
                        <td>@FormatVolume(u.Volume)</td>
                        <td>@Ui.BloodType(u.Abo, u.RhD)</td>
                        <td><span class="@Ui.Badge(u.Status)">@u.Status</span></td>
                        <td class="nowrap">@u.ExpiresUtc.ToString("yyyy-MM-dd HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (_unit is not null && _history.Count > 0)
{
    <div class="bb-card">
        <div class="bb-card-title"><h3>Modification history for this unit</h3></div>
        <table class="bb">
            <thead><tr><th>Type</th><th>Source</th><th>Target</th><th>Results</th><th>Offset</th><th>New expiry</th><th>Reason</th><th>By</th><th>When</th></tr></thead>
            <tbody>
                @foreach (var h in _history)
                {
                    <tr>
                        <td>@h.ModificationType</td>
                        <td class="mono">@h.SourceProductCode</td>
                        <td class="mono">@h.TargetProductCode</td>
                        <td class="mono">@FormatHistoryResults(h)</td>
                        <td class="mono">@h.ExpirationOffsetCodeApplied</td>
                        <td class="nowrap">@h.ResultExpiresUtc.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@h.Reason</td>
                        <td>@h.PerformedBy</td>
                        <td class="nowrap">@h.PerformedUtc.ToString("yyyy-MM-dd HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private long? _sourceUnitId;
    private Feedback? _searchFb;
    private bool _busy;

    private BloodUnitDto? _unit;
    private List<EligibleModificationDto> _eligible = new();
    private long _selectedRuleId;
    private EligibleModificationDto? _selectedRule;

    private int _childCount = 2;
    private List<DivideChildRow> _children = new();

    private long? _poolPickId;
    private List<BloodUnitDto> _poolUnits = new();

    private IEnumerable<long> PoolExcludeIds =>
        _unit is null
            ? _poolUnits.Select(p => p.Id)
            : _poolUnits.Select(p => p.Id).Append(_unit.Id);

    private decimal? _singleResultVolume;

    private string _reason = string.Empty;
    private Feedback? _actionFb;
    private ModificationResultVm? _lastResult;

    private List<UnitModificationDto> _history = new();

    private static string RelativeLabel(ExpirationRelativeTo relativeTo) =>
        relativeTo == ExpirationRelativeTo.CollectionDateTime ? "collection" : "modification";

    private string? SourceProductCode =>
        _unit is null
            ? null
            : _unit.ProductCodeData
                ?? _unit.Isbt128ProductCode
                ?? _unit.ProductDescriptionCode;

    private static string FormatVolume(decimal? volume) =>
        volume is null ? "—" : $"{volume.Value:0.##} mL";

    private static string FormatHistoryResults(UnitModificationDto history)
    {
        var parts = history.Units
            .Where(u => u.Role == ModificationUnitRole.Result)
            .Select(u =>
            {
                var code = string.IsNullOrWhiteSpace(u.ProductCodeData) ? u.UnitNumber : u.ProductCodeData;
                return u.Volume is null ? code : $"{code} ({u.Volume.Value:0.##} mL)";
            })
            .ToList();
        return parts.Count == 0 ? "—" : string.Join(", ", parts);
    }

    private Task OnSourceIdChanged(long? id)
    {
        _sourceUnitId = id;
        return Task.CompletedTask;
    }

    private async Task OnSourceSelectedAsync(BloodUnitDto? u)
    {
        if (u is null)
        {
            _unit = null;
            _selectedRuleId = 0;
            _selectedRule = null;
            _eligible.Clear();
            _history.Clear();
            _poolUnits.Clear();
            _poolPickId = null;
            return;
        }

        await SelectUnitAsync(u);
    }

    private Task OnPoolIdChanged(long? id)
    {
        _poolPickId = id;
        return Task.CompletedTask;
    }

    private void OnPoolUnitSelected(BloodUnitDto? unit)
    {
        if (unit is null || _unit is null) return;
        if (unit.Id == _unit.Id || _poolUnits.Any(p => p.Id == unit.Id))
        {
            _actionFb = Feedback.Fail("That unit is already in the pool.");
            _poolPickId = null;
            return;
        }

        _poolUnits.Add(unit);
        _poolPickId = null;
        _actionFb = null;
    }

    private async Task SelectUnitAsync(BloodUnitDto u)
    {
        _unit = u;
        _selectedRuleId = 0;
        _selectedRule = null;
        _lastResult = null;
        _actionFb = null;
        _poolUnits.Clear();
        _reason = string.Empty;

        var eligible = await Api.GetEligibleModificationsAsync(u.Id);
        _eligible = eligible.Value ?? new();

        var history = await Api.GetUnitModificationHistoryAsync(u.Id);
        _history = history.Value ?? new();
    }

    private void OnRuleChanged()
    {
        _selectedRule = _eligible.FirstOrDefault(e => e.RuleId == _selectedRuleId);
        _actionFb = null;
        _lastResult = null;
        _childCount = 2;
        SyncChildRows();
    }

    private void SyncChildRows()
    {
        if (_childCount < 2) _childCount = 2;
        while (_children.Count < _childCount) _children.Add(new DivideChildRow());
        while (_children.Count > _childCount) _children.RemoveAt(_children.Count - 1);
        ApplyDividePreviews();
    }

    private void ApplyDividePreviews()
    {
        if (_unit is null || _selectedRule is null)
        {
            foreach (var row in _children)
            {
                row.PreviewProductCode = null;
            }

            return;
        }

        var sourcePdc = IsbtDivisionCode.ResolveProductDescriptionCode(
            _unit.ProductDescriptionCode, _unit.ProductCodeData);
        var targetPdc = IsbtDivisionCode.ResolveProductDescriptionCode(_selectedRule.TargetProductCode, null);
        var pdc = IsbtDivisionCode.ResolveBaseProductDescriptionCode(sourcePdc, targetPdc);
        var collection = IsbtDivisionCode.ResolveCollectionType(_unit.CollectionTypeCode, _unit.ProductCodeData);
        var sourceDivision = IsbtDivisionCode.ResolveDivision(_unit.DivisionCode, _unit.ProductCodeData);
        if (!IsbtDivisionCode.TryAllocate(sourceDivision, _children.Count, null, out var divisions, out _, out _))
        {
            foreach (var row in _children)
            {
                row.PreviewProductCode = null;
            }

            return;
        }

        for (var i = 0; i < _children.Count; i++)
        {
            _children[i].PreviewProductCode = pdc is null
                ? IsbtDivisionCode.FormatCollectionAndDivision(collection, divisions[i])
                : IsbtDivisionCode.BuildProductCodeData(pdc, collection, divisions[i]);
        }
    }

    private async Task SubmitAsync()
    {
        if (_unit is null || _selectedRule is null || string.IsNullOrWhiteSpace(_reason)) return;

        _busy = true;
        ApiResult<ModificationResultVm> r;

        if (_selectedRule.ModificationType == ModificationType.Divide)
        {
            if (_children.Any(c => c.Volume is null or <= 0m))
            {
                _busy = false;
                _actionFb = Feedback.Fail("Each result unit of a divide must have a volume greater than zero.");
                return;
            }

            var children = _children.Select(c => new DivideChildSpec(null, c.Volume)).ToList();
            r = await Api.DivideUnitAsync(_unit.Id, new PerformDivideRequest(_selectedRule.RuleId, children, _reason));
        }
        else if (_selectedRule.ModificationType == ModificationType.Pool)
        {
            var sourceIds = new List<long> { _unit.Id };
            sourceIds.AddRange(_poolUnits.Select(p => p.Id));
            r = await Api.PoolUnitsAsync(new PerformPoolRequest(sourceIds, _selectedRule.RuleId, _reason));
        }
        else
        {
            r = await Api.ApplyModificationAsync(_unit.Id, new PerformSingleModificationRequest(_selectedRule.RuleId, _singleResultVolume, _reason));
        }

        _busy = false;
        _actionFb = r.ToFeedback("Modification completed.");
        if (r.Succeeded)
        {
            _lastResult = r.Value;
            _reason = string.Empty;
            _poolUnits.Clear();
            var history = await Api.GetUnitModificationHistoryAsync(_unit.Id);
            _history = history.Value ?? new();
        }
    }

    private sealed class DivideChildRow
    {
        public string? PreviewProductCode { get; set; }
        public decimal? Volume { get; set; }
    }
}
