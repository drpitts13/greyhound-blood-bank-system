@page "/inventory/modify"
@using BloodBankLIS.Domain.Isbt128
@inject BloodBankApiClient Api
@inject UserSession Session
@inject NavigationManager Nav

<PageTitle>Modify Products &middot; Greyhound Blood Bank LIS</PageTitle>

<InventoryDeskRibbon Current="InventoryDeskRibbon.Desk.Modify" />
<h1>Modify Blood Products</h1>
<p class="muted">
    Divide, pool, irradiate, thaw, volume-reduce, leukoreduce, wash, or aliquot a unit under an
    admin-configured modification rule. Divide, pool, and the other modifications retire the source.
    An aliquot leaves the parent available and reduces its volume.
</p>
@if (OrderActionId is > 0)
{
    <div class="alert alert-info">
        Completing this modification will update the product order and return you to the patient chart.
    </div>
}

<div class="bb-card">
    <div class="bb-card-title"><h3>1. Find the source unit</h3></div>
    <div class="field">
        <label>Unit number</label>
        <UnitPickerComboBox Scope="UnitPickerScope.Available"
            Value="_sourceUnitId"
            ValueChanged="OnSourceIdChanged"
            SelectedItemChanged="OnSourceSelectedAsync" />
    </div>
    <Outcome Value="_searchFb" />
</div>

@if (_unit is not null)
{
    <div class="bb-card">
        <div class="bb-card-title"><h3>2. Selected unit</h3></div>
        <div class="form-row">
            <div class="field"><label>Unit number</label><div class="mono">@_unit.UnitNumber</div></div>
            <div class="field"><label>Product code</label><div class="mono">@(SourceProductCode ?? "—")</div></div>
            <div class="field"><label>Volume</label><div>@FormatVolume(_unit.Volume)</div></div>
            <div class="field"><label>Location</label><div>@FormatUnitLocation(_unit.CurrentLocationId)</div></div>
            <div class="field"><label>ABO/Rh</label><div><strong>@Ui.BloodType(_unit.Abo, _unit.RhD)</strong></div></div>
            <div class="field"><label>Status</label><div><span class="@Ui.Badge(_unit.Status)">@_unit.Status</span></div></div>
            <div class="field"><label>Expires</label><div>@_unit.ExpiresUtc.ToString("yyyy-MM-dd HH:mm")</div></div>
        </div>

        @if (_retiredOfferClosed)
        {
            <div class="empty">This unit was retired and cannot be modified again. Its current status could not be confirmed.</div>
        }
        else if (!CanOfferModification)
        {
            <div class="empty">This unit is @_unit.Status and is not eligible for modification.</div>
        }
        else if (_eligible.Count == 0)
        {
            <div class="empty">No active modification rules apply to this unit's current product.</div>
        }
        else
        {
            <div class="field"><label>Modification</label>
                <select @bind="_selectedRuleId" @bind:after="OnRuleChanged">
                    <option value="0">-- select a modification --</option>
                    @foreach (var e in _eligible)
                    {
                        <option value="@e.RuleId" disabled="@(!e.IsAvailable)">
                            @e.ModificationCode — @e.ModificationType &rarr; @e.TargetProductCode (@e.ExpirationOffsetCode from @RelativeLabel(e.ExpirationRelativeTo))@(e.IsAvailable ? "" : " — collection date required")
                        </option>
                    }
                </select>
            </div>
        }
    </div>
}

@if (_unit is not null && CanOfferModification && _selectedRule is not null && !_selectedRule.IsAvailable)
{
    <div class="bb-card">
        <div class="empty">
            This expiration code is relative to collection date/time, but the selected unit has no collection date/time.
        </div>
    </div>
}

@if (_unit is not null && CanOfferModification && _selectedRule is not null && _selectedRule.IsAvailable)
{
    <div class="bb-card">
        <div class="bb-card-title"><h3>3. Modification details</h3></div>
        <div class="form-row">
            <div class="field"><label>Modification code</label><div class="mono">@_selectedRule.ModificationCode</div></div>
            <div class="field"><label>New product</label><div class="mono">@_selectedRule.TargetProductCode</div></div>
            <div class="field"><label>New expiration</label>
                <div>@(_selectedRule.PreviewExpiresUtc?.ToString("yyyy-MM-dd HH:mm") ?? "—")</div>
                <div class="muted">@_selectedRule.ExpirationOffsetCode from @RelativeLabel(_selectedRule.ExpirationRelativeTo), capped at source expiration</div>
            </div>
        </div>
        <Outcome Value="_actionFb" />

        @if (_selectedRule.ModificationType == ModificationType.Divide)
        {
            <div class="field"><label>Number of result units</label>
                <input type="number" min="2" @bind="_childCount" @bind:after="SyncChildRows" />
                <div class="muted">Recorded antigen and antibody typing on the source is copied onto each result unit. An autologous or directed reservation is copied with it. When the source has a volume, the result volumes must add up to it.</div>
            </div>
            @if (_children.Count > 0)
            {
                <table class="bb">
                    <thead><tr><th>#</th><th>Generated product code</th><th>Volume (mL, required)</th></tr></thead>
                    <tbody>
                        @for (var i = 0; i < _children.Count; i++)
                        {
                            var row = _children[i];
                            <tr>
                                <td>@(i + 1)</td>
                                <td class="mono">@(row.PreviewProductCode ?? "—")</td>
                                <td><input type="number" step="0.01" min="0.01" @bind="row.Volume" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (_unit.Volume is decimal sourceVolume)
                {
                    <div class="muted">
                        Result volumes @DivideVolumeSum.ToString("0.##") of @sourceVolume.ToString("0.##") mL.
                        They must add up to the source volume. A remainder belongs on another result, or use Aliquot to leave the parent available.
                    </div>
                }
                else
                {
                    <div class="muted">This source has no recorded volume, so the result volumes are stored as entered.</div>
                }
            }
        }
        else if (_selectedRule.ModificationType == ModificationType.Pool)
        {
            <p class="muted">
                Add two or more units of the same product, ABO, and Rh(D) to pool (the selected unit above is
                included automatically as the first source). Antigen typing follows the sources: a positive on
                any unit makes the pool positive, and conflicting results stop the pool. Autologous and directed
                units pool only when they share the same reservation. When any unit has a volume, every unit
                needs one so the pool total can include each source. Units must already be in the same
                storage location; transfer them together before pooling.
            </p>
            <div class="field">
                <label>Additional unit number</label>
                <UnitPickerComboBox Scope="UnitPickerScope.Available"
                    Value="_poolPickId"
                    ValueChanged="OnPoolIdChanged"
                    SelectedItemChanged="OnPoolUnitSelected"
                    ExcludeIds="PoolExcludeIds" />
            </div>
            <table class="bb" style="margin-top:.6rem;">
                <thead><tr><th>Unit #</th><th>ABO/Rh</th><th>Location</th><th class="right">Volume</th><th></th></tr></thead>
                <tbody>
                    <tr>
                        <td class="mono">@_unit.UnitNumber</td>
                        <td>@Ui.BloodType(_unit.Abo, _unit.RhD)</td>
                        <td>@FormatUnitLocation(_unit.CurrentLocationId)</td>
                        <td class="right">@FormatVolume(_unit.Volume)</td>
                        <td class="muted">primary</td>
                    </tr>
                    @foreach (var p in _poolUnits)
                    {
                        <tr>
                            <td class="mono">@p.UnitNumber</td>
                            <td>@Ui.BloodType(p.Abo, p.RhD)</td>
                            <td>@FormatUnitLocation(p.CurrentLocationId)</td>
                            <td class="right">@FormatVolume(p.Volume)</td>
                            <td class="right"><button class="btn btn-ghost btn-sm" @onclick="() => _poolUnits.Remove(p)">Remove</button></td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (PoolLocationGap)
            {
                <div class="muted">These units are not in the same storage location. Transfer them to one location before pooling.</div>
            }
            @if (PoolVolumeGap)
            {
                <div class="muted">Every pooled unit needs a recorded volume greater than zero so the pool total can include each source.</div>
            }
            else if (PoolVolumeSum is decimal poolSum)
            {
                <div class="muted">Pool volume will be @poolSum.ToString("0.##") mL, the sum of these units.</div>
            }
            else
            {
                <div class="muted">None of these units has a recorded volume, so the pool volume stays unrecorded.</div>
            }
        }
        else if (_selectedRule.ModificationType == ModificationType.Aliquot)
        {
            <div class="field">
                <label>Aliquot volume (mL)</label>
                <input type="number" step="0.01" min="0.01" @bind="_singleResultVolume" />
                <div class="muted">The parent stays available. Its volume is reduced by this amount, and the aliquot is a new unit that keeps the parent's typing and reservation.</div>
            </div>
        }
        else
        {
            <div class="field"><label>Result volume (optional)</label>
                <input type="number" step="0.01" min="0.01" @bind="_singleResultVolume" />
                <div class="muted">Leave blank to keep the source volume. A result volume cannot be larger than the source.</div>
            </div>
        }

        <div class="field" style="margin-top:.6rem;"><label>Reason (required)</label>
            <input @bind="_reason" placeholder="Why is this modification being performed?" style="width:100%;" />
        </div>

        <button class="btn btn-primary" style="margin-top:.6rem;" disabled="@(_busy || string.IsNullOrWhiteSpace(_reason))" @onclick="SubmitAsync">
            Perform @_selectedRule.ModificationType
        </button>
    </div>
}

@if (_lastResult is not null)
{
    <div class="bb-card">
        <div class="bb-card-title"><h3>Result</h3></div>
        @if (_lastWasAliquot)
        {
            <p>@AliquotParentCue</p>
        }
        else if (RetiredSourceCue is not null)
        {
            <p>@RetiredSourceCue</p>
        }
        <table class="bb">
            <thead><tr><th>New unit #</th><th>Product code</th><th>Volume</th><th>ABO/Rh</th><th>Status</th><th>Location</th><th>Expires</th><th></th></tr></thead>
            <tbody>
                @foreach (var u in _lastResult.ResultUnits)
                {
                    var location = FormatUnitLocation(u.CurrentLocationId);
                    var releaseCue = ModificationResultNextStep.ReleaseCue(u.Status, location);
                    var releaseHref = ModificationResultNextStep.ReleaseHref(u.Status, u.Id, Session.Has(PermissionCodes.InventoryRelease));
                    <tr>
                        <td class="mono">@u.UnitNumber</td>
                        <td class="mono">@(u.ProductCodeData ?? u.Isbt128ProductCode ?? "—")</td>
                        <td>@FormatVolume(u.Volume)</td>
                        <td>@Ui.BloodType(u.Abo, u.RhD)</td>
                        <td>
                            <span class="@Ui.Badge(u.Status)">@u.Status</span>
                            @if (releaseCue is not null)
                            {
                                <div class="muted">@releaseCue</div>
                            }
                        </td>
                        <td>@location</td>
                        <td class="nowrap">@u.ExpiresUtc.ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="right nowrap">
                            <a class="btn btn-secondary btn-sm" href="@InventoryUrls.Unit(u.Id)">Open unit</a>
                            @if (releaseHref is not null)
                            {
                                <a class="btn btn-primary btn-sm" href="@releaseHref">Release from quarantine</a>
                            }
                            @if (u.Status == UnitStatus.Received)
                            {
                                <a class="btn btn-ghost btn-sm" href="@($"/inventory?board=retype&unitId={u.Id}#pending-retype")">Open retype desk</a>
                            }
                            @if (Session.Has(PermissionCodes.PrintLabel))
                            {
                                <a class="btn btn-ghost btn-sm" href="@($"/printing?unitId={u.Id}")">Open Printing</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (_unit is not null && _history.Count > 0)
{
    <div class="bb-card">
        <div class="bb-card-title"><h3>Modification history for this unit</h3></div>
        <table class="bb">
            <thead><tr><th>Type</th><th>Source</th><th>Target</th><th>Results</th><th>Result location</th><th>Offset</th><th>New expiry</th><th>Reason</th><th>By</th><th>When</th></tr></thead>
            <tbody>
                @foreach (var h in _history)
                {
                    <tr>
                        <td>@h.ModificationType</td>
                        <td class="mono">@h.SourceProductCode</td>
                        <td class="mono">@h.TargetProductCode</td>
                        <td class="mono">@FormatHistoryResults(h)</td>
                        <td>@FormatHistoryLocations(h)</td>
                        <td class="mono">@h.ExpirationOffsetCodeApplied</td>
                        <td class="nowrap">@h.ResultExpiresUtc.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@h.Reason</td>
                        <td>@h.PerformedBy</td>
                        <td class="nowrap">@h.PerformedUtc.ToString("yyyy-MM-dd HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private long? _sourceUnitId;
    private Feedback? _searchFb;
    private bool _busy;

    private readonly Dictionary<long, string?> _locationNames = new();
    private BloodUnitDto? _unit;
    private List<EligibleModificationDto> _eligible = new();
    private long _selectedRuleId;
    private EligibleModificationDto? _selectedRule;

    private int _childCount = 2;
    private List<DivideChildRow> _children = new();

    private long? _poolPickId;
    private List<BloodUnitDto> _poolUnits = new();

    private IEnumerable<long> PoolExcludeIds =>
        _unit is null
            ? _poolUnits.Select(p => p.Id)
            : _poolUnits.Select(p => p.Id).Append(_unit.Id);

    private decimal? _singleResultVolume;

    private decimal DivideVolumeSum => _children.Sum(c => c.Volume ?? 0m);

    private IReadOnlyList<decimal?> PoolVolumes =>
        _unit is null
            ? Array.Empty<decimal?>()
            : new[] { _unit.Volume }.Concat(_poolUnits.Select(unit => unit.Volume)).ToList();

    private IReadOnlyList<long?> PoolLocationIds =>
        _unit is null
            ? Array.Empty<long?>()
            : new[] { _unit.CurrentLocationId }.Concat(_poolUnits.Select(unit => unit.CurrentLocationId)).ToList();

    private bool PoolLocationGap =>
        UnitModificationEligibilityRule.EvaluatePoolLocations(PoolLocationIds).IsHardStopped;

    private bool PoolVolumeGap =>
        PoolVolumes.Any(volume => volume is not null) && PoolVolumes.Any(volume => volume is null or <= 0m);

    private decimal? PoolVolumeSum =>
        PoolVolumeGap || PoolVolumes.Count == 0 || PoolVolumes.All(volume => volume is null)
            ? null
            : PoolVolumes.Sum(volume => volume!.Value);

    private string _reason = string.Empty;
    private Feedback? _actionFb;
    private ModificationResultVm? _lastResult;
    private bool _lastWasAliquot;
    private bool _aliquotParentConfirmed;
    private bool _retiredOfferClosed;
    private List<ModificationResultNextStep.RetiredSourceFact> _retiredSources = new();

    private List<UnitModificationDto> _history = new();

    [SupplyParameterFromQuery]
    public long? UnitId { get; set; }

    [SupplyParameterFromQuery]
    public long? RuleId { get; set; }

    [SupplyParameterFromQuery]
    public long? OrderActionId { get; set; }

    [SupplyParameterFromQuery(Name = "modificationType")]
    public string? ActionModificationType { get; set; }

    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    private bool _unitQueryApplied;

    protected override async Task OnInitializedAsync()
    {
        var locations = await Api.GetLocationsAsync();
        if (!locations.Succeeded || locations.Value is null)
        {
            return;
        }

        foreach (var location in locations.Value)
        {
            if (!string.IsNullOrWhiteSpace(location.Name))
            {
                _locationNames[location.Id] = location.Name.Trim();
            }
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_unitQueryApplied || UnitId is not long unitId)
        {
            return;
        }

        _unitQueryApplied = true;
        _sourceUnitId = unitId;
        var r = await Api.GetUnitAsync(unitId);
        if (r.Succeeded && r.Value is not null)
        {
            await SelectUnitAsync(r.Value);
        }
        else
        {
            _searchFb = r.ToFeedback();
        }
    }

    private static string RelativeLabel(ExpirationRelativeTo relativeTo) =>
        relativeTo == ExpirationRelativeTo.CollectionDateTime ? "collection" : "modification";

    private string? SourceProductCode =>
        _unit is null
            ? null
            : _unit.ProductCodeData
                ?? _unit.Isbt128ProductCode
                ?? _unit.ProductDescriptionCode;

    private static string FormatVolume(decimal? volume) =>
        volume is null ? "—" : $"{volume.Value:0.##} mL";

    private string FormatUnitLocation(long? locationId) =>
        StorageLocationLabel.Format(locationId, _locationNames);

    private static string FormatHistoryResults(UnitModificationDto history)
    {
        var parts = history.Units
            .Where(u => u.Role == ModificationUnitRole.Result)
            .Select(u =>
            {
                var code = string.IsNullOrWhiteSpace(u.ProductCodeData) ? u.UnitNumber : u.ProductCodeData;
                return u.Volume is null ? code : $"{code} ({u.Volume.Value:0.##} mL)";
            })
            .ToList();
        return parts.Count == 0 ? "—" : string.Join(", ", parts);
    }

    private static string FormatHistoryLocations(UnitModificationDto history)
    {
        var results = history.Units.Where(unit => unit.Role == ModificationUnitRole.Result).ToList();
        if (results.Count == 0)
        {
            return "—";
        }

        var labels = results.Select(FormatHistoryLocation).Distinct().ToList();
        if (labels.Count == 1)
        {
            return labels[0];
        }

        return string.Join(", ", results.Select(unit => $"{unit.UnitNumber}: {FormatHistoryLocation(unit)}"));
    }

    private static string FormatHistoryLocation(ModificationUnitSummaryDto unit)
    {
        var made = StorageLocationLabel.Format(unit.ResultLocationId, unit.ResultLocationName);
        if (!unit.ResultHasLeftCreationLocation)
        {
            return made;
        }

        var now = StorageLocationLabel.Format(unit.CurrentLocationId, unit.CurrentLocationName);
        var when = unit.LocationLeftUtc?.ToString("yyyy-MM-dd HH:mm");
        var why = string.IsNullOrWhiteSpace(unit.LocationLeftReason) ? null : unit.LocationLeftReason.Trim();
        var who = string.IsNullOrWhiteSpace(unit.LocationLeftBy) ? null : $"by {unit.LocationLeftBy.Trim()}";
        var details = new[] { when, why, who }.Where(part => part is not null).Cast<string>().ToList();
        if (details.Count == 0)
        {
            return $"{made}; now at {now}";
        }

        return $"{made}; now at {now} ({string.Join(", ", details)})";
    }

    private Task OnSourceIdChanged(long? id)
    {
        _sourceUnitId = id;
        return Task.CompletedTask;
    }

    private async Task OnSourceSelectedAsync(BloodUnitDto? u)
    {
        if (u is null)
        {
            _unit = null;
            _selectedRuleId = 0;
            _selectedRule = null;
            _eligible.Clear();
            _history.Clear();
            _poolUnits.Clear();
            _poolPickId = null;
            return;
        }

        await SelectUnitAsync(u);
    }

    private Task OnPoolIdChanged(long? id)
    {
        _poolPickId = id;
        return Task.CompletedTask;
    }

    private void OnPoolUnitSelected(BloodUnitDto? unit)
    {
        if (unit is null || _unit is null) return;
        if (unit.Id == _unit.Id || _poolUnits.Any(p => p.Id == unit.Id))
        {
            _actionFb = Feedback.Fail("That unit is already in the pool.");
            _poolPickId = null;
            return;
        }

        _poolUnits.Add(unit);
        _poolPickId = null;
        _actionFb = null;
    }

    private async Task SelectUnitAsync(BloodUnitDto u)
    {
        _unit = u;
        _selectedRuleId = 0;
        _selectedRule = null;
        _retiredOfferClosed = false;
        ClearLastResult();
        _actionFb = null;
        _poolUnits.Clear();
        _reason = string.Empty;

        var eligible = await Api.GetEligibleModificationsAsync(u.Id);
        _eligible = eligible.Value ?? new();
        if (OrderActionId is > 0
            && Enum.TryParse<ModificationType>(ActionModificationType, true, out var requiredType))
        {
            _eligible = _eligible.Where(e => e.ModificationType == requiredType).ToList();
            if (_eligible.Count == 1)
            {
                _selectedRuleId = _eligible[0].RuleId;
                _selectedRule = _eligible[0];
            }
        }
        else if (RuleId is long ruleId && _eligible.FirstOrDefault(e => e.RuleId == ruleId) is { } preselected)
        {
            _selectedRuleId = preselected.RuleId;
            _selectedRule = preselected;
        }

        var history = await Api.GetUnitModificationHistoryAsync(u.Id);
        _history = history.Value ?? new();
    }

    private void ClearLastResult()
    {
        _lastResult = null;
        _lastWasAliquot = false;
        _aliquotParentConfirmed = false;
        _retiredSources = new();
    }

    private bool CanOfferModification =>
        _unit is not null
        && !_retiredOfferClosed
        && UnitModificationEligibilityRule.OfferModification(_unit.Status, OrderActionId is > 0);

    private string? RetiredSourceCue =>
        _lastWasAliquot ? null : ModificationResultNextStep.RetiredSourceCue(_retiredSources);

    private string AliquotParentCue =>
        ModificationResultNextStep.AliquotParentCue(
            _aliquotParentConfirmed && _unit is not null,
            _unit?.UnitNumber,
            _unit?.Status ?? UnitStatus.Available,
            _unit?.Volume);

    private void OnRuleChanged()
    {
        _selectedRule = _eligible.FirstOrDefault(e => e.RuleId == _selectedRuleId);
        _actionFb = null;
        ClearLastResult();
        _childCount = 2;
        SyncChildRows();
    }

    private void SyncChildRows()
    {
        if (_childCount < 2) _childCount = 2;
        while (_children.Count < _childCount) _children.Add(new DivideChildRow());
        while (_children.Count > _childCount) _children.RemoveAt(_children.Count - 1);
        ApplyDividePreviews();
    }

    private void ApplyDividePreviews()
    {
        if (_unit is null || _selectedRule is null)
        {
            foreach (var row in _children)
            {
                row.PreviewProductCode = null;
            }

            return;
        }

        var sourcePdc = IsbtDivisionCode.ResolveProductDescriptionCode(
            _unit.ProductDescriptionCode, _unit.ProductCodeData);
        var targetPdc = IsbtDivisionCode.ResolveProductDescriptionCode(_selectedRule.TargetProductCode, null);
        var pdc = IsbtDivisionCode.ResolveBaseProductDescriptionCode(sourcePdc, targetPdc);
        var collection = IsbtDivisionCode.ResolveCollectionType(_unit.CollectionTypeCode, _unit.ProductCodeData);
        var sourceDivision = IsbtDivisionCode.ResolveDivision(_unit.DivisionCode, _unit.ProductCodeData);
        if (!IsbtDivisionCode.TryAllocate(sourceDivision, _children.Count, null, out var divisions, out _, out _))
        {
            foreach (var row in _children)
            {
                row.PreviewProductCode = null;
            }

            return;
        }

        for (var i = 0; i < _children.Count; i++)
        {
            _children[i].PreviewProductCode = pdc is null
                ? IsbtDivisionCode.FormatCollectionAndDivision(collection, divisions[i])
                : IsbtDivisionCode.BuildProductCodeData(pdc, collection, divisions[i]);
        }
    }

    private async Task SubmitAsync()
    {
        if (_unit is null || _selectedRule is null || string.IsNullOrWhiteSpace(_reason)) return;

        _busy = true;
        ApiResult<ModificationResultVm> r;

        if (_selectedRule.ModificationType == ModificationType.Divide)
        {
            if (_children.Any(c => c.Volume is null or <= 0m))
            {
                _busy = false;
                _actionFb = Feedback.Fail("Each result unit of a divide must have a volume greater than zero.");
                return;
            }

            if (_unit.Volume is decimal divideSourceVolume)
            {
                var sum = DivideVolumeSum;
                if (sum > divideSourceVolume)
                {
                    _busy = false;
                    _actionFb = Feedback.Fail($"Requested child volumes ({sum}) exceed the source unit's volume ({divideSourceVolume}).");
                    return;
                }

                if (sum < divideSourceVolume)
                {
                    _busy = false;
                    _actionFb = Feedback.Fail($"Requested child volumes ({sum}) leave {divideSourceVolume - sum} mL of the source unit unaccounted. Record the remaining volume as another result, or remove an aliquot instead of dividing.");
                    return;
                }
            }

            var children = _children.Select(c => new DivideChildSpec(null, c.Volume)).ToList();
            r = await Api.DivideUnitAsync(_unit.Id, new PerformDivideRequest(_selectedRule.RuleId, children, _reason));
        }
        else if (_selectedRule.ModificationType == ModificationType.Pool)
        {
            var poolVolumeEval = UnitModificationEligibilityRule.EvaluatePoolVolumes(PoolVolumes);
            if (poolVolumeEval.IsHardStopped)
            {
                _busy = false;
                _actionFb = Feedback.Fail(poolVolumeEval.HardStops[0].Message);
                return;
            }

            var poolLocationEval = UnitModificationEligibilityRule.EvaluatePoolLocations(PoolLocationIds);
            if (poolLocationEval.IsHardStopped)
            {
                _busy = false;
                _actionFb = Feedback.Fail(poolLocationEval.HardStops[0].Message);
                return;
            }

            var sourceIds = new List<long> { _unit.Id };
            sourceIds.AddRange(_poolUnits.Select(p => p.Id));
            r = await Api.PoolUnitsAsync(new PerformPoolRequest(sourceIds, _selectedRule.RuleId, _reason));
        }
        else if (_selectedRule.ModificationType == ModificationType.Aliquot)
        {
            r = await Api.AliquotUnitAsync(_unit.Id, new PerformAliquotRequest(_selectedRule.RuleId, _singleResultVolume, _reason));
        }
        else
        {
            if (_singleResultVolume is decimal resultVolume && resultVolume <= 0m)
            {
                _busy = false;
                _actionFb = Feedback.Fail("A result volume must be greater than zero.");
                return;
            }

            if (_singleResultVolume is decimal requestedVolume
                && _unit.Volume is decimal singleSourceVolume
                && requestedVolume > singleSourceVolume)
            {
                _busy = false;
                _actionFb = Feedback.Fail($"Result volume ({requestedVolume}) exceeds the source unit's volume ({singleSourceVolume}).");
                return;
            }

            r = await Api.ApplyModificationAsync(
                _unit.Id,
                new PerformSingleModificationRequest(_selectedRule.RuleId, _singleResultVolume, _reason, OrderActionId));
        }

        _busy = false;
        _actionFb = r.ToFeedback("Modification completed.");
        if (r.Succeeded)
        {
            _lastResult = r.Value;
            _lastWasAliquot = _selectedRule.ModificationType == ModificationType.Aliquot;
            _aliquotParentConfirmed = false;
            _retiredSources = new();
            _reason = string.Empty;
            _singleResultVolume = null;
            var retiredSources = new List<(long Id, string? Number)>();
            if (!_lastWasAliquot && _unit is not null)
            {
                retiredSources.Add((_unit.Id, _unit.UnitNumber));
                foreach (var pooled in _poolUnits)
                {
                    retiredSources.Add((pooled.Id, pooled.UnitNumber));
                }
            }

            _poolUnits.Clear();
            if (_lastWasAliquot)
            {
                var refreshed = await Api.GetUnitAsync(_unit.Id);
                if (refreshed.Succeeded && refreshed.Value is not null)
                {
                    _unit = refreshed.Value;
                    _aliquotParentConfirmed = true;
                }
            }
            else
            {
                var facts = new List<ModificationResultNextStep.RetiredSourceFact>();
                var primaryReread = false;
                foreach (var source in retiredSources)
                {
                    var refreshed = await Api.GetUnitAsync(source.Id);
                    if (refreshed.Succeeded && refreshed.Value is not null)
                    {
                        facts.Add(new ModificationResultNextStep.RetiredSourceFact(
                            refreshed.Value.UnitNumber,
                            true,
                            refreshed.Value.Status));
                        if (_unit?.Id == source.Id)
                        {
                            _unit = refreshed.Value;
                            primaryReread = true;
                        }
                    }
                    else
                    {
                        facts.Add(new ModificationResultNextStep.RetiredSourceFact(source.Number, false, null));
                    }
                }

                _retiredSources = facts;
                _retiredOfferClosed = !primaryReread
                    || _unit is null
                    || !UnitModificationEligibilityRule.OfferModification(_unit.Status, OrderActionId is > 0);
                _selectedRule = null;
                _selectedRuleId = 0;
                if (_retiredOfferClosed || _unit is null)
                {
                    _eligible.Clear();
                }
                else
                {
                    var eligible = await Api.GetEligibleModificationsAsync(_unit.Id);
                    _eligible = eligible.Succeeded ? eligible.Value ?? new() : new();
                }
            }
            var history = await Api.GetUnitModificationHistoryAsync(_unit.Id);
            _history = history.Value ?? new();
            if (!string.IsNullOrWhiteSpace(ReturnUrl) && ReturnUrl.StartsWith("/", StringComparison.Ordinal))
            {
                Nav.NavigateTo(ReturnUrl);
            }
        }
    }

    private sealed class DivideChildRow
    {
        public string? PreviewProductCode { get; set; }
        public decimal? Volume { get; set; }
    }
}
