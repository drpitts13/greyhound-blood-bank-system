@inject BloodBankApiClient Api
@inject UserSession Session

<div class="bb-card" style="margin:0 0 .75rem;">
    <div class="field" style="margin-bottom:.4rem;">
        <label>Comment</label>
        @if (Session.Has(PermissionCodes.PatientWrite))
        {
            <CodedCommentField Page="CommentPage.Test" @bind-Value="_draft" />
        }
        else
        {
            <div class="muted">@(string.IsNullOrWhiteSpace(_draft) ? "No comment." : _draft)</div>
        }
    </div>
    @if (Session.Has(PermissionCodes.PatientWrite))
    {
        @* End-user testing pass 39: an empty, unchanged box saved and said "Comment saved." *@
        <button type="button" class="btn btn-secondary btn-sm" disabled="@(_busy || !Changed)" @onclick="SaveAsync" data-save-comment>Save comment</button>
    }
    <Outcome Value="_feedback" />
</div>

@code {
    [Parameter, EditorRequired] public TestWorkItemDto WorkItem { get; set; } = default!;
    [Parameter] public EventCallback OnSaved { get; set; }

    private string? _draft;
    private bool _busy;
    private Feedback? _feedback;
    private long _lineId;
    private string? _saved;

    private bool Changed => (_draft ?? string.Empty).Trim() != (_saved ?? string.Empty).Trim();

    protected override void OnParametersSet()
    {
        if (_lineId == WorkItem.OrderLineId)
        {
            return;
        }

        _lineId = WorkItem.OrderLineId;
        _draft = WorkItem.Comment;
        _saved = WorkItem.Comment;
    }

    private async Task SaveAsync()
    {
        _busy = true;
        var r = await Api.UpdatePatientOrderLineCommentAsync(
            WorkItem.PatientId,
            WorkItem.OrderId,
            WorkItem.OrderLineId,
            new UpdateOrderLineCommentRequest(_draft));
        _busy = false;
        _feedback = r.ToFeedback(string.IsNullOrWhiteSpace(_draft) ? "Comment removed." : "Comment saved.");
        if (r.Succeeded)
        {
            _saved = _draft;
            await OnSaved.InvokeAsync();
        }
    }
}
