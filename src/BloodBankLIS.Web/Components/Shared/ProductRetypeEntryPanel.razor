@inject BloodBankApiClient Api
@inject UserSession Session

<div class="stack">
    <div class="flex gap" style="flex-wrap:wrap;">
        <div><span class="muted">Labeled type</span> <strong>@Ui.BloodType(Detail.LabeledAbo, Detail.LabeledRh)</strong></div>
        <div><span class="muted">Product</span> <strong>@Detail.ProductCode</strong> @Detail.ProductName</div>
        @if (!string.IsNullOrWhiteSpace(Detail.TestCode))
        {
            <div><span class="muted">Retype test</span> <strong>@(Detail.TestName ?? Detail.TestCode)</strong> <span class="mono">@Detail.TestCode</span></div>
        }
        <div><span class="@Ui.Badge(Detail.Status)">@Ui.StatusLabel(Detail.Status)</span></div>
    </div>

    @if (HasPerformedRetype)
    {
        <div class="bb-card" style="background:#fafbfe;">
            <h4>ABO retype</h4>
            <p>
                <strong>@ProductRetypeEntryCopy.Format(Detail.Latest!.InterpretedAbo, Detail.Latest.InterpretedRh)</strong>
                <span class="@Ui.Badge(Detail.Latest.Status)">@Detail.Latest.Status</span>
                entered by @Detail.Latest.EnteredBy at @Detail.Latest.EnteredUtc.ToString("yyyy-MM-dd HH:mm")
                @if (!string.IsNullOrWhiteSpace(Detail.Latest.VerifiedBy))
                {
                    <span> · verified by @Detail.Latest.VerifiedBy</span>
                }
            </p>
            @if (Detail.Latest.CellReactions is { Count: > 0 })
            {
                <table class="bb">
                    <thead><tr><th>Cell</th><th>Reaction</th></tr></thead>
                    <tbody>
                        @foreach (var cell in Detail.Latest.CellReactions)
                        {
                            <tr>
                                <td>@cell.Label</td>
                                <td><strong>@cell.Grade</strong></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else if (!string.IsNullOrWhiteSpace(Detail.Latest.DisplayValue))
            {
                <p>@Detail.Latest.DisplayValue</p>
            }
            @if (!Detail.Latest.MatchesLabel)
            {
                <div class="alert alert-warning">@(Detail.Latest.DiscrepancyDetail ?? "Retype does not match the labeled ABO/Rh.")</div>
            }
            else
            {
                <p class="muted">Confirmed against the labeled type.</p>
            }
        </div>
    }

    <Outcome Value="_fb" />

    @if (Detail.CanVerify)
    {
        <div class="alert alert-warning">@(Detail.BlockReason ?? "An entered retype has not been confirmed.")</div>
        @if (Session.Has(PermissionCodes.ResultVerify) || Session.Has(PermissionCodes.ResultEnter))
        {
            <button class="btn btn-primary btn-sm" disabled="@_busy" @onclick="VerifyAsync">Confirm retype</button>
        }
    }
    else if (!HasPerformedRetype && !string.IsNullOrWhiteSpace(Detail.BlockReason) && !Detail.CanRecord)
    {
        <p class="muted">@Detail.BlockReason</p>
    }

    @if (ShowEnterButton)
    {
        <button type="button" class="btn btn-primary btn-sm" disabled="@_busy" @onclick="OpenEntry">Enter ABORH retype</button>
    }
    else if (ShowInlineEntry)
    {
        @EntryForm
    }
</div>

@if (_entryOpen)
{
    <div class="bb-dialog-backdrop" @onclick="CloseEntry">
        <div class="bb-dialog" role="dialog" aria-modal="true" aria-labelledby="aborh-retype-entry-title" @onclick:stopPropagation="true">
            <div class="flex-between">
                <h2 id="aborh-retype-entry-title" style="margin:0;">Enter ABORH retype</h2>
                <button type="button" class="btn btn-secondary btn-sm" @onclick="CloseEntry">Close</button>
            </div>
            <div style="margin-top:.8rem;">
                @EntryForm
            </div>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public ProductRetypeDetailDto Detail { get; set; } = default!;
    [Parameter] public EventCallback OnSaved { get; set; }

    /// <summary>
    /// Unit chart keeps the form closed until the operator chooses to enter.
    /// The retype desk still shows the form inline after Enter.
    /// </summary>
    [Parameter] public bool EntryInDialog { get; set; }

    private AboGroup _abo = AboGroup.Unknown;
    private RhType _rh = RhType.Unknown;
    private Dictionary<string, string> _subtests = new(StringComparer.OrdinalIgnoreCase);
    private HashSet<string> _optionalPerformed = new(StringComparer.OrdinalIgnoreCase);
    private bool _busy;
    private bool _entryOpen;
    private Feedback? _fb;
    private long _boundUnitId;

    private bool HasPerformedRetype =>
        Detail.Latest is { Status: not ResultStatus.Pending };

    private bool CanEnter =>
        Detail.CanRecord && Session.Has(PermissionCodes.ResultEnter);

    private bool ShowEnterButton => EntryInDialog && !HasPerformedRetype && CanEnter;

    private bool ShowInlineEntry => !EntryInDialog && CanEnter;

    private RenderFragment EntryForm => @<div>
        <div class="form-row">
            <div class="field"><label>Interpreted ABO</label>
                <select @bind="_abo">@foreach (var a in Enum.GetValues<AboGroup>()) { <option value="@a">@a</option> }</select>
            </div>
            @if (Detail.AntiDRequired)
            {
                <div class="field"><label>Interpreted Rh(D)</label>
                    <select @bind="_rh">@foreach (var r in Enum.GetValues<RhType>()) { <option value="@r">@r</option> }</select>
                </div>
            }
        </div>
        <table class="bb" style="margin-top:.5rem;">
            <thead><tr><th>Subtest</th><th>Reaction</th><th></th></tr></thead>
            <tbody>
                @foreach (var st in Detail.Subtests)
                {
                    var optional = !st.Required;
                    var performed = !optional || IsOptionalPerformed(st.Code);
                    <tr>
                        <td>@st.Label</td>
                        <td>
                            <select value="@GetSubtest(st.Code)" @onchange="e => SetSubtest(st.Code, e)" disabled="@(!performed)">
                                @if (optional) { <option value="NT">NT</option> }
                                @foreach (var grade in Detail.GradeChoices)
                                {
                                    <option value="@grade">@grade</option>
                                }
                            </select>
                        </td>
                        <td>
                            @if (optional)
                            {
                                <label class="flex" style="gap:.35rem;">
                                    <input type="checkbox" checked="@IsOptionalPerformed(st.Code)" @onchange="e => OnOptionalChanged(st.Code, e)" /> Performed
                                </label>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <Outcome Value="_fb" />
        <button class="btn btn-primary btn-sm" style="margin-top:.6rem;" disabled="@_busy" @onclick="SaveAsync">Record retype</button>
    </div>;

    protected override void OnParametersSet()
    {
        if (_boundUnitId == Detail.UnitId && _subtests.Count > 0)
        {
            return;
        }

        _boundUnitId = Detail.UnitId;
        _abo = Detail.LabeledAbo;
        _rh = Detail.LabeledRh;
        _fb = null;
        _entryOpen = false;
        _optionalPerformed.Clear();
        _subtests = Detail.Subtests.ToDictionary(
            s => s.Code,
            s => s.Required ? (Detail.GradeChoices.FirstOrDefault() ?? "0") : "NT",
            StringComparer.OrdinalIgnoreCase);
    }

    private void OpenEntry() => _entryOpen = true;

    private void CloseEntry() => _entryOpen = false;

    private string GetSubtest(string code) =>
        _subtests.TryGetValue(code, out var v) ? v : "NT";

    private void SetSubtest(string code, ChangeEventArgs e) =>
        _subtests[code] = e.Value?.ToString() ?? "NT";

    private bool IsOptionalPerformed(string code) => _optionalPerformed.Contains(code);

    private void OnOptionalChanged(string code, ChangeEventArgs e)
    {
        var on = e.Value is true;
        if (on)
        {
            _optionalPerformed.Add(code);
            if (!_subtests.TryGetValue(code, out var current) || current == "NT")
            {
                _subtests[code] = Detail.GradeChoices.FirstOrDefault() ?? "0";
            }
        }
        else
        {
            _optionalPerformed.Remove(code);
            _subtests[code] = "NT";
        }
    }

    private async Task SaveAsync()
    {
        _busy = true;
        var payload = _subtests
            .Where(kv => !string.Equals(kv.Value, "NT", StringComparison.OrdinalIgnoreCase))
            .ToDictionary(kv => kv.Key, kv => kv.Value, StringComparer.OrdinalIgnoreCase);
        var req = new RecordProductRetypeRequest(
            _abo,
            Detail.AntiDRequired ? _rh : null,
            payload);
        var r = await Api.RecordUnitRetypeAsync(Detail.UnitId, req);
        _busy = false;
        if (r.Succeeded && r.Value is not null)
        {
            var latest = r.Value.Latest;
            _fb = latest is null
                ? r.ToFeedback("Retype recorded.")
                : r.ToFeedback(OutcomeCopy(r.Value.Status, latest));
            _entryOpen = false;
            await OnSaved.InvokeAsync();
        }
        else
        {
            _fb = r.ToFeedback();
        }
    }

    private static string OutcomeCopy(UnitStatus status, ProductRetypeResultDto latest)
    {
        if (!latest.MatchesLabel)
        {
            return ProductRetypeEntryCopy.SavedQuarantine(
                latest.InterpretedAbo, latest.InterpretedRh, latest.DiscrepancyDetail);
        }

        return status == UnitStatus.Expired
            ? ProductRetypeEntryCopy.SavedOutdated(latest.InterpretedAbo, latest.InterpretedRh)
            : ProductRetypeEntryCopy.Saved(latest.InterpretedAbo, latest.InterpretedRh);
    }

    private async Task VerifyAsync()
    {
        if (Detail.Latest is null) return;
        _busy = true;
        var r = await Api.VerifyUnitRetypeAsync(Detail.UnitId, Detail.Latest.Id);
        _busy = false;
        if (r.Succeeded && r.Value is not null)
        {
            _fb = r.ToFeedback(OutcomeCopy(r.Value.Status, r.Value.Latest!));
            await OnSaved.InvokeAsync();
        }
        else
        {
            _fb = r.ToFeedback();
        }
    }
}
