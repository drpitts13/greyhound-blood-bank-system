@inject UserSession Session
@inject BloodBankApiClient Api

    <div class="bb-card">
    <div class="bb-card-title"><h3>Product history</h3></div>
    <Outcome Value="Feedback" />
    <p class="muted">Every product event for this patient, newest first. Empty facts show as —.</p>
    <details class="bb-help">
        <summary>About this table</summary>
        <ul>
            <li>Each assigned, issued, returned, or transfused unit shows the latest crossmatch result for that patient and unit.</li>
            <li>A crossmatch event shows that event's result.</li>
            <li>A unit or event with no crossmatch result shows none.</li>
            <li>Issued, returned, and transfused rows show the specimen accession linked to that issue.</li>
            <li>A row with no linked specimen shows none.</li>
            <li>Each row shows when that unit expires.</li>
            <li>A row with no unit expiration shows none.</li>
            <li>Each row shows who performed that event.</li>
            <li>A row with no performer shows none.</li>
            <li>A returned unit shows why it came back and whether it was marked eligible to reissue.</li>
            <li>A row that is not a return shows none for those facts.</li>
            <li>Issued, returned, and transfused rows show the person the unit was issued to.</li>
            <li>A row with no issued-to person shows none.</li>
            <li>Those rows also show the cooler or transport id.</li>
            <li>A row with no cooler shows none.</li>
            <li>Issued, returned, and transfused rows show the recorded issue type.</li>
            <li>A row that is not one of those events shows none.</li>
            <li>Those rows also show the recorded emergency-release reason.</li>
            <li>A blank reason shows none.</li>
            <li>Issued, returned, and transfused rows show the second verifier recorded at issue.</li>
            <li>A row that is not one of those events shows none.</li>
            <li>A blank second verifier shows none.</li>
            <li>Those rows also show who authorized an emergency or massive-transfusion release.</li>
            <li>A row that is not one of those events shows none.</li>
            <li>A blank authorizer shows none.</li>
            <li>Issued, returned, and transfused rows show the appearance recorded at issue.</li>
            <li>A row that is not one of those events shows none.</li>
            <li>The issue gate is unchanged.</li>
            <li>Issued, returned, and transfused rows show the appearance recorded at ward receipt after the unit is received.</li>
            <li>A row that is not one of those events, or a unit that has not been received, shows none.</li>
            <li>The ward-receipt gate is unchanged.</li>
            <li>Issued, returned, and transfused rows show the pickup tag scanned at issue.</li>
            <li>A row that is not one of those events shows none.</li>
            <li>A blank pickup tag shows none.</li>
            <li>The issue gate is unchanged.</li>
            <li>Issued, returned, and transfused rows show the crossmatch status recorded at issue.</li>
            <li>A row that is not one of those events shows none.</li>
            <li>The issue gate is unchanged.</li>
        </ul>
    </details>
    @if (Loading) { <div class="loading">Loading product history...</div> }
    else if (Rows.Count == 0) { <div class="empty">No product events.</div> }
    else
    {
        <div class="flex gap" style="justify-content:flex-end;margin-bottom:.4rem;">
            <button type="button" class="btn btn-ghost btn-sm" aria-pressed="@_showAllColumns" @onclick="() => _showAllColumns = !_showAllColumns">
                @(_showAllColumns ? "Show key columns only" : "Show all details (19 more)")
            </button>
        </div>
        <div class="table-scroll">
        <table class="bb">
            <thead><tr><th>Date/time</th><th>Event</th><th>Unit / product</th><th>Unit type</th><th>Location</th><th>Performed by</th><th>Compatibility</th><th>Disposition</th></tr></thead>
                @foreach (var h in Rows)
                {
                    @* One record per tbody: the facts, any details, then the row's actions on a line underneath. *@
                    <tbody class="record">
                    <tr class="@HistoryRowClass(h)">
                        <td class="nowrap">@h.EventUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                        <td><strong>@h.EventType</strong></td>
                        <td>
                            @if (h.UnitId is long historyUnitId)
                            {
                                <a class="mono" href="@InventoryUrls.Unit(historyUnitId)">@(h.UnitNumber ?? $"#{historyUnitId}")</a>
                            }
                            else
                            {
                                <span class="mono">@(h.UnitNumber ?? "—")</span>
                            }
                            <span class="sub">@(h.ProductTypeName ?? "—")</span>
                        </td>
                        <td>@(h.UnitBloodType ?? "—")</td>
                        <td>@(h.IssuedToLocation ?? "—")</td>
                        <td>@(string.IsNullOrWhiteSpace(h.PerformedBy) ? "—" : h.PerformedBy)</td>
                        <td>@(h.CompatibilityStatus ?? "—")</td>
                        <td>@(h.FinalDisposition ?? "—")@if (h.ReactionSuspected) { <a class="badge badge-red" href="@($"/reactions?patientId={PatientId}")">Reaction</a> }</td>
                    </tr>
                    @if (_showAllColumns)
                    {
                        @* The secondary facts sit under their row in a grid, so the full history fits the page width. *@
                        <tr class="@HistoryRowClass(h)">
                            <td colspan="8" class="bb-facts" style="padding-top:0;">
                                <ul>
                                    <li>Issue type: @(string.IsNullOrWhiteSpace(h.IssueType) ? "—" : h.IssueType)</li>
                                    <li>Release reason: @(string.IsNullOrWhiteSpace(h.EmergencyReleaseReason) ? "—" : h.EmergencyReleaseReason)</li>
                                    <li>Second verifier: @(string.IsNullOrWhiteSpace(h.SecondVerifier) ? "—" : h.SecondVerifier)</li>
                                    <li>Authorized by: @(string.IsNullOrWhiteSpace(h.EmergencyReleaseAuthorizer) ? "—" : h.EmergencyReleaseAuthorizer)</li>
                                    <li>Appearance: @(string.IsNullOrWhiteSpace(h.IssueAppearance) ? "—" : h.IssueAppearance)</li>
                                    <li>Ward appearance: @(string.IsNullOrWhiteSpace(h.WardAppearance) ? "—" : h.WardAppearance)</li>
                                    <li>P-tag: <span class="mono">@(string.IsNullOrWhiteSpace(h.PtagCode) ? "—" : h.PtagCode)</span></li>
                                    <li>XM at issue: @(string.IsNullOrWhiteSpace(h.IssueCrossmatchStatus) ? "—" : h.IssueCrossmatchStatus)</li>
                                    <li>Expires: @(h.UnitExpiresUtc is DateTime unitExpires ? unitExpires.ToLocalTime().ToString("yyyy-MM-dd HH:mm") : "—")</li>
                                    <li>Visit: <span class="mono">@(h.HasMissingVisitContext ? "—" : (h.VisitNumber ?? "—"))</span></li>
                                    <li>Order: <span class="mono">@(h.OrderNumber ?? "—")</span></li>
                                    <li>Specimen: <span class="mono">@(h.AccessionNumber ?? "—")</span></li>
                                    <li>Issued to: @(string.IsNullOrWhiteSpace(h.IssuedTo) ? "—" : h.IssuedTo)</li>
                                    <li>Cooler: <span class="mono">@(string.IsNullOrWhiteSpace(h.CoolerId) ? "—" : h.CoolerId)</span></li>
                                    <li>Volume: <span class="mono">@(h.VolumeTransfused is { } vol ? vol.ToString("0.###") : "—")</span></li>
                                    <li>Transfusionist: @(h.Transfusionist ?? "—")</li>
                                    <li>Return reason: @(string.IsNullOrWhiteSpace(h.ReturnReason) ? "—" : h.ReturnReason)</li>
                                    <li>Reissue: @(h.ReissueEligible is bool eligible ? (eligible ? "Eligible" : "Not eligible") : "—")</li>
                                    <li>Source: <span class="mono">@(h.PatientIdentificationMethod ?? "—")</span></li>
                                </ul>
                            </td>
                        </tr>
                    }
                    <tr class="row-actions @HistoryRowClass(h)">
                        <td colspan="8">
                            <div class="row-actions-bar">
                                @if (h.UnitId is long inventoryUnitId)
                                {
                                    <a class="btn btn-ghost btn-sm" href="@InventoryUrls.Unit(inventoryUnitId)">Open unit</a>
                                }
                                @if (CanReportReaction(h) && _reportRow != h)
                                {
                                    <button type="button" class="btn btn-ghost btn-sm" @onclick="() => BeginReport(h)">Report reaction</button>
                                }
                                @if (h.IssueId is long historyIssueId && h.UnitId is long issueUnitId)
                                {
                                    <a class="btn btn-ghost btn-sm" href="@($"/issuing?bloodUnitId={issueUnitId}")">Open Issuing</a>
                                    @if (h.EventType == PatientProductHistoryEventType.Issued && Session.Has(PermissionCodes.TransfusionDocument))
                                    {
                                        @* The full bedside form: identifiers, unit scan, verifier, and expiration are all checked there. *@
                                        <a class="btn btn-secondary btn-sm" href="@($"/issuing?desk=transfuse&issueId={historyIssueId}")">Document transfusion</a>
                                    }
                                    @if (h.EventType == PatientProductHistoryEventType.TransfusionStarted
                                         && (Session.Has(PermissionCodes.TransfusionComplete) || Session.Has(PermissionCodes.TransfusionDocument)))
                                    {
                                        <a class="btn btn-primary btn-sm" href="@($"/issuing?desk=transfuse&issueId={historyIssueId}")">Complete transfusion</a>
                                    }
                                }
                            </div>
                            @if (_reportRow is not null && _reportRow == h)
                            {
                                @* A reaction noticed after the transfusion was documented without one opens the same investigation. *@
                                <div class="alert alert-warning" style="margin-top:.5rem;" data-scroll-on-show>
                                    <strong>Report a reaction to this transfusion</strong>
                                    <div class="form-row" style="margin-top:.5rem;">
                                        <div class="field"><label>What was seen, and who reported it</label>
                                            <input @bind="_reportDescription" @bind:event="oninput" placeholder="e.g. Fever 39.2 °C and chills 6 hours after; reported by RN Lee" />
                                        </div>
                                        <div class="field"><label>Onset (optional)</label>
                                            <input type="datetime-local" @bind="_reportOnsetLocal" />
                                        </div>
                                    </div>
                                    <Outcome Value="_reportFb" />
                                    <div class="flex gap">
                                        <button type="button" class="btn btn-danger btn-sm" disabled="@(_reporting || string.IsNullOrWhiteSpace(_reportDescription))" @onclick="ReportAsync">Open investigation</button>
                                        <button type="button" class="btn btn-ghost btn-sm" @onclick="() => _reportRow = null">Cancel</button>
                                    </div>
                                </div>
                            }
                        </td>
                    </tr>
                    </tbody>
                }
        </table>
        </div>
    }
</div>

@code {
    [Parameter] public long PatientId { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public IReadOnlyList<PatientProductHistoryRowDto> Rows { get; set; } = [];
    [Parameter] public bool Busy { get; set; }
    [Parameter] public Feedback? Feedback { get; set; }

    // Most reviews need only the key columns; the other 19 are one click away.
    private bool _showAllColumns;

    /// <summary>Called after a late reaction report so the chart reloads the history.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    // The transfused row being reported on (its Issued row shares the issue id, so the row itself is tracked).
    private PatientProductHistoryRowDto? _reportRow;
    private string? _reportDescription;
    private DateTime? _reportOnsetLocal;
    private Feedback? _reportFb;
    private bool _reporting;

    private bool CanReportReaction(PatientProductHistoryRowDto h) =>
        !h.ReactionSuspected
        && h.IssueId is not null
        && h.EventType is PatientProductHistoryEventType.Transfused or PatientProductHistoryEventType.PartiallyTransfused
        && (Session.Has(PermissionCodes.TransfusionDocument) || Session.Has(PermissionCodes.ReactionInvestigate));

    private void BeginReport(PatientProductHistoryRowDto row)
    {
        _reportRow = row;
        _reportDescription = null;
        _reportOnsetLocal = null;
        _reportFb = null;
    }

    private async Task ReportAsync()
    {
        if (_reportRow?.IssueId is not long issueId) return;
        _reporting = true;
        var onset = _reportOnsetLocal is DateTime local ? DateTime.SpecifyKind(local, DateTimeKind.Local).ToUniversalTime() : (DateTime?)null;
        var r = await Api.ReportLateReactionAsync(new ReportLateReactionRequest(issueId, _reportDescription, onset));
        _reporting = false;
        _reportFb = r.ToFeedback("Reaction investigation opened. The remainder of the unit is held and the investigation is on Reactions.");
        if (r.Succeeded)
        {
            _reportRow = null;
            await OnChanged.InvokeAsync();
        }
    }

    private static string HistoryRowClass(PatientProductHistoryRowDto h)
    {
        if (h.ReactionSuspected) return "row-urgent";
        if (h.IsOpenAssignment) return "row-active";
        return string.Empty;
    }
}
