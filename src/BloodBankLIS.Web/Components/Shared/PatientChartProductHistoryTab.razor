@inject UserSession Session

    <div class="bb-card">
    <div class="bb-card-title"><h3>Product history</h3></div>
    <Outcome Value="Feedback" />
    <p class="muted">Every product event for this patient, newest first. Empty facts show as —.</p>
    <details class="bb-help">
        <summary>About this table</summary>
        <ul>
            <li>Each assigned, issued, returned, or transfused unit shows the latest crossmatch result for that patient and unit.</li>
            <li>A crossmatch event shows that event's result.</li>
            <li>A unit or event with no crossmatch result shows none.</li>
            <li>Issued, returned, and transfused rows show the specimen accession linked to that issue.</li>
            <li>A row with no linked specimen shows none.</li>
            <li>Each row shows when that unit expires.</li>
            <li>A row with no unit expiration shows none.</li>
            <li>Each row shows who performed that event.</li>
            <li>A row with no performer shows none.</li>
            <li>A returned unit shows why it came back and whether it was marked eligible to reissue.</li>
            <li>A row that is not a return shows none for those facts.</li>
            <li>Issued, returned, and transfused rows show the person the unit was issued to.</li>
            <li>A row with no issued-to person shows none.</li>
            <li>Those rows also show the cooler or transport id.</li>
            <li>A row with no cooler shows none.</li>
            <li>Issued, returned, and transfused rows show the recorded issue type.</li>
            <li>A row that is not one of those events shows none.</li>
            <li>Those rows also show the recorded emergency-release reason.</li>
            <li>A blank reason shows none.</li>
            <li>Issued, returned, and transfused rows show the second verifier recorded at issue.</li>
            <li>A row that is not one of those events shows none.</li>
            <li>A blank second verifier shows none.</li>
            <li>Those rows also show who authorized an emergency or massive-transfusion release.</li>
            <li>A row that is not one of those events shows none.</li>
            <li>A blank authorizer shows none.</li>
            <li>Issued, returned, and transfused rows show the appearance recorded at issue.</li>
            <li>A row that is not one of those events shows none.</li>
            <li>The issue gate is unchanged.</li>
            <li>Issued, returned, and transfused rows show the appearance recorded at ward receipt after the unit is received.</li>
            <li>A row that is not one of those events, or a unit that has not been received, shows none.</li>
            <li>The ward-receipt gate is unchanged.</li>
            <li>Issued, returned, and transfused rows show the pickup tag scanned at issue.</li>
            <li>A row that is not one of those events shows none.</li>
            <li>A blank pickup tag shows none.</li>
            <li>The issue gate is unchanged.</li>
            <li>Issued, returned, and transfused rows show the crossmatch status recorded at issue.</li>
            <li>A row that is not one of those events shows none.</li>
            <li>The issue gate is unchanged.</li>
        </ul>
    </details>
    @if (Loading) { <div class="loading">Loading product history...</div> }
    else if (Rows.Count == 0) { <div class="empty">No product events.</div> }
    else
    {
        <div class="flex gap" style="justify-content:flex-end;margin-bottom:.4rem;">
            <button type="button" class="btn btn-ghost btn-sm" aria-pressed="@_showAllColumns" @onclick="() => _showAllColumns = !_showAllColumns">
                @(_showAllColumns ? "Show key columns only" : "Show all columns (19 more)")
            </button>
        </div>
        <table class="bb @(_showAllColumns ? null : "hide-detail-cols")">
            <thead><tr><th>Date/time</th><th>Event</th><th class="detail-col">Issue type</th><th class="detail-col">Release reason</th><th class="detail-col">Second verifier</th><th class="detail-col">Authorized by</th><th class="detail-col">Appearance</th><th class="detail-col">Ward appearance</th><th class="detail-col">P-tag</th><th class="detail-col">XM at issue</th><th>Unit</th><th>Product</th><th>Unit type</th><th class="detail-col">Expires</th><th class="detail-col">Visit</th><th class="detail-col">Order</th><th class="detail-col">Specimen</th><th>Location</th><th class="detail-col">Issued to</th><th class="detail-col">Cooler</th><th class="detail-col">Volume</th><th class="detail-col">Transfusionist</th><th>Performed by</th><th>Compatibility</th><th>Disposition</th><th class="detail-col">Return reason</th><th class="detail-col">Reissue</th><th class="detail-col">Source</th><th></th></tr></thead>
            <tbody>
                @foreach (var h in Rows)
                {
                    <tr class="@HistoryRowClass(h)">
                        <td class="nowrap">@h.EventUtc.ToString("yyyy-MM-dd HH:mm")</td>
                        <td><strong>@h.EventType</strong></td>
                        <td class="detail-col">@(string.IsNullOrWhiteSpace(h.IssueType) ? "—" : h.IssueType)</td>
                        <td class="detail-col">@(string.IsNullOrWhiteSpace(h.EmergencyReleaseReason) ? "—" : h.EmergencyReleaseReason)</td>
                        <td class="detail-col">@(string.IsNullOrWhiteSpace(h.SecondVerifier) ? "—" : h.SecondVerifier)</td>
                        <td class="detail-col">@(string.IsNullOrWhiteSpace(h.EmergencyReleaseAuthorizer) ? "—" : h.EmergencyReleaseAuthorizer)</td>
                        <td class="detail-col">@(string.IsNullOrWhiteSpace(h.IssueAppearance) ? "—" : h.IssueAppearance)</td>
                        <td class="detail-col">@(string.IsNullOrWhiteSpace(h.WardAppearance) ? "—" : h.WardAppearance)</td>
                        <td class="detail-col mono">@(string.IsNullOrWhiteSpace(h.PtagCode) ? "—" : h.PtagCode)</td>
                        <td class="detail-col">@(string.IsNullOrWhiteSpace(h.IssueCrossmatchStatus) ? "—" : h.IssueCrossmatchStatus)</td>
                        <td class="mono">
                            @if (h.UnitId is long historyUnitId)
                            {
                                <a href="@InventoryUrls.Unit(historyUnitId)">@(h.UnitNumber ?? $"#{historyUnitId}")</a>
                            }
                            else
                            {
                                @(h.UnitNumber ?? "—")
                            }
                        </td>
                        <td>@(h.ProductTypeName ?? "—")</td>
                        <td>@(h.UnitBloodType ?? "—")</td>
                        <td class="detail-col nowrap">@(h.UnitExpiresUtc is DateTime unitExpires ? unitExpires.ToString("yyyy-MM-dd HH:mm") : "—")</td>
                        <td class="detail-col mono">@(h.HasMissingVisitContext ? "—" : (h.VisitNumber ?? "—"))</td>
                        <td class="detail-col mono">@(h.OrderNumber ?? "—")</td>
                        <td class="detail-col mono">@(h.AccessionNumber ?? "—")</td>
                        <td>@(h.IssuedToLocation ?? "—")</td>
                        <td class="detail-col">@(string.IsNullOrWhiteSpace(h.IssuedTo) ? "—" : h.IssuedTo)</td>
                        <td class="detail-col mono">@(string.IsNullOrWhiteSpace(h.CoolerId) ? "—" : h.CoolerId)</td>
                        <td class="detail-col mono">@(h.VolumeTransfused is { } vol ? vol.ToString("0.###") : "—")</td>
                        <td class="detail-col">@(h.Transfusionist ?? "—")</td>
                        <td>@(string.IsNullOrWhiteSpace(h.PerformedBy) ? "—" : h.PerformedBy)</td>
                        <td>@(h.CompatibilityStatus ?? "—")</td>
                        <td>@(h.FinalDisposition ?? "—")@if (h.ReactionSuspected) { <a class="badge badge-red" href="@($"/reactions?patientId={PatientId}")">Reaction</a> }</td>
                        <td class="detail-col">@(string.IsNullOrWhiteSpace(h.ReturnReason) ? "—" : h.ReturnReason)</td>
                        <td class="detail-col">@(h.ReissueEligible is bool eligible ? (eligible ? "Eligible" : "Not eligible") : "—")</td>
                        <td class="detail-col mono">@(h.PatientIdentificationMethod ?? "—")</td>
                        <td class="right nowrap">
                            @if (h.UnitId is long inventoryUnitId)
                            {
                                <a class="btn btn-ghost btn-sm" href="@InventoryUrls.Unit(inventoryUnitId)">Open unit</a>
                            }
                            @if (h.IssueId is long historyIssueId && h.UnitId is long issueUnitId)
                            {
                                <a class="btn btn-ghost btn-sm" href="@($"/issuing?bloodUnitId={issueUnitId}")">Open Issuing</a>
                                @if (h.EventType == PatientProductHistoryEventType.Issued && OnMarkTransfused.HasDelegate && Session.Has(PermissionCodes.TransfusionDocument))
                                {
                                    @if (_confirmIssueId == historyIssueId)
                                    {
                                        <button type="button" class="btn btn-primary btn-sm" disabled="@Busy" @onclick="() => ConfirmTransfusedAsync(historyIssueId)">Confirm transfused</button>
                                        <button type="button" class="btn btn-ghost btn-sm" @onclick="() => _confirmIssueId = null">Cancel</button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-secondary btn-sm" disabled="@Busy" @onclick="() => _confirmIssueId = historyIssueId">Transfuse</button>
                                    }
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    [Parameter] public long PatientId { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public IReadOnlyList<PatientProductHistoryRowDto> Rows { get; set; } = [];
    [Parameter] public EventCallback<long> OnMarkTransfused { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public Feedback? Feedback { get; set; }

    private long? _confirmIssueId;

    // Most reviews need only the key columns; the other 19 are one click away.
    private bool _showAllColumns;

    private async Task ConfirmTransfusedAsync(long issueId)
    {
        _confirmIssueId = null;
        await OnMarkTransfused.InvokeAsync(issueId);
    }

    private static string HistoryRowClass(PatientProductHistoryRowDto h)
    {
        if (h.ReactionSuspected) return "row-urgent";
        if (h.IsOpenAssignment) return "row-active";
        return string.Empty;
    }
}
