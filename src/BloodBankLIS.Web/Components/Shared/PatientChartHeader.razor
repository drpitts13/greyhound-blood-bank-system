@inject UserSession Session
@inject NavigationManager Nav
@inject BloodBankApiClient Api

<div class="flex-between" style="margin-bottom:1rem;flex-wrap:wrap;">
    <div>
        <h1>@DisplayName(Patient)</h1>
        <div class="muted">
            MRN <span class="mono">@Patient.MedicalRecordNumber</span>
            &middot; DOB @Patient.DateOfBirth.ToString("yyyy-MM-dd")
            &middot; @Patient.Sex
            @if (PatientDemographicCodes.RaceLabel(Patient.Race) is { } race)
            {
                <span data-patient-race> &middot; @race</span>
            }
            @if (PatientDemographicCodes.EthnicityLabel(Patient.Ethnicity) is { } ethnicity)
            {
                <span data-patient-ethnicity> &middot; @ethnicity</span>
            }
            &middot; <span class="badge @(Patient.Status == PatientStatus.Merged ? "badge-amber" : "badge-gray")">@Ui.EnumText(Patient.Status)</span>
            @if (!string.IsNullOrWhiteSpace(Patient.Comment))
            {
                <span> &middot; @Patient.Comment</span>
            }
        </div>
        @if (Patient.Unidentified && Patient.Status != PatientStatus.Merged)
        {
            <div class="alert alert-warning" style="margin-top:.5rem;" data-unidentified-banner>
                <strong>Unidentified patient.</strong> The name and MRN are temporary and the date of birth is estimated.
                When the patient is identified, merge this chart into theirs so the type, antibodies, and units are in one chart.
                @if (Session.Has(PermissionCodes.PatientMerge))
                {
                    <div class="form-row" style="margin-top:.4rem;align-items:flex-end;">
                        <div class="field"><label>Identified patient's MRN</label><input @bind="_identifiedMrn" placeholder="Scan or type the MRN" data-identified-mrn /></div>
                        <div class="field" style="flex:2;"><label>How identified</label><input @bind="_identifyReason" placeholder="For example: ID from family, matched to wristband" data-identify-reason /></div>
                        <button class="btn btn-primary btn-sm" disabled="@_identifying" @onclick="IdentifyAsync" data-identify-submit>Merge into identified chart</button>
                    </div>
                    <Outcome Value="_identifyFb" />
                }
                else
                {
                    <span> Someone with the patient merge permission does this.</span>
                }
            </div>
        }
        @if (_issuedUnderEarlier.Count > 0)
        {
            <div class="alert alert-warning" style="margin-top:.5rem;" data-issued-under-earlier>
                <strong>@_issuedUnderEarlier.Count @(_issuedUnderEarlier.Count == 1 ? "unit is" : "units are") still out under @string.Join(", ", _issuedUnderEarlier.Select(i => i.IssuedUnder).Distinct(StringComparer.OrdinalIgnoreCase)).</strong>
                The patient's wristband may still show that identity; the bedside check now uses MRN <span class="mono">@Patient.MedicalRecordNumber</span>.
                Make sure the wristband and the unit tags agree before transfusing.
                <div class="sub">
                    @foreach (var i in _issuedUnderEarlier)
                    {
                        <span style="margin-right:.6rem;"><a class="mono" href="@($"/inventory/units/{i.BloodUnitId}")">@i.UnitNumber</a> issued @i.IssuedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")@(string.IsNullOrWhiteSpace(i.IssuedToLocation) ? "" : $" to {i.IssuedToLocation}")</span>
                    }
                </div>
            </div>
        }
        @if (_family is { } family)
        {
            <div class="muted" style="margin-top:.25rem;" data-family>
                @if (family.Mother is { } mother)
                {
                    <span data-family-mother>Mother: <a href="@($"/patients/{mother.Id}")">@mother.Name</a> <span class="mono">@mother.MedicalRecordNumber</span>
                        &middot; @(mother.CurrentBloodType ?? "type not on file")@(mother.ActiveAntibodies.Count > 0 ? $" · {string.Join(", ", mother.ActiveAntibodies)}" : "")</span>
                    @if (Session.Has(PermissionCodes.PatientWrite) && !_unlinking)
                    {
                        <button type="button" class="btn btn-ghost btn-sm" @onclick="() => _unlinking = true">Remove link</button>
                    }
                }
                @if (family.Infants.Count > 0)
                {
                    <span data-family-infants>@(family.Mother is null ? "" : " · ")Infants:
                        @foreach (var infant in family.Infants)
                        {
                            <a style="margin-left:.3rem;" href="@($"/patients/{infant.Id}")">@infant.Name</a>
                            <span class="mono">@infant.MedicalRecordNumber</span>
                            <span class="sub">(born @infant.DateOfBirth.ToString("yyyy-MM-dd"), @(infant.CurrentBloodType ?? "type not on file"))</span>
                        }
                    </span>
                }
                @if (family.Mother is null && Session.Has(PermissionCodes.PatientWrite) && Patient.Status != PatientStatus.Merged
                     && MotherInfantLinkRule.OfferLink(Patient.DateOfBirth, DateOnly.FromDateTime(DateTime.UtcNow)))
                {
                    @if (_linking)
                    {
                        <span class="flex gap" style="display:inline-flex;align-items:center;">
                            <input @bind="_motherMrn" placeholder="Mother's MRN" style="max-width:12rem;" data-mother-mrn />
                            <button type="button" class="btn btn-primary btn-sm" disabled="@_familyBusy" @onclick="LinkMotherAsync" data-mother-link>Link</button>
                            <button type="button" class="btn btn-ghost btn-sm" @onclick="() => _linking = false">Cancel</button>
                        </span>
                    }
                    else
                    {
                        <button type="button" class="btn btn-ghost btn-sm" @onclick="() => _linking = true" data-mother-link-open>Link mother</button>
                    }
                }
            </div>
            @if (family.Mother is { ActiveAntibodies.Count: > 0 } antibodyMother)
            {
                <div class="alert alert-info" style="margin-top:.4rem;" data-maternal-antibodies>
                    The mother has @string.Join(", ", antibodyMother.ActiveAntibodies) on record. Maternal antibodies can be present in the infant's blood.
                </div>
            }
            @if (_unlinking)
            {
                <div class="flex gap" style="align-items:flex-end;margin-top:.4rem;">
                    <div class="field" style="flex:1;"><label>Why remove the mother link?</label><input @bind="_unlinkReason" placeholder="e.g. Linked to the wrong chart" /></div>
                    <button type="button" class="btn btn-secondary btn-sm" disabled="@_familyBusy" @onclick="UnlinkMotherAsync">Remove link</button>
                    <button type="button" class="btn btn-ghost btn-sm" @onclick="() => _unlinking = false">Cancel</button>
                </div>
            }
            <Outcome Value="_familyFb" />
        }
        @if (VisitsLoaded)
        {
            var (visit, otherOpen) = CurrentVisit.For(Encounters);
            <div class="muted" style="margin-top:.25rem;" data-current-visit>
                @if (visit is null)
                {
                    <span>No open visit</span>
                }
                else
                {
                    <span>Current visit <a href="@PatientChartUrls.VisitOrders(Patient.Id, visit.Id)" class="mono" title="This visit's orders">@visit.VisitNumber</a></span>
                    @if (CurrentVisit.Describe(visit) is { Length: > 0 } described)
                    {
                        <span> &middot; @described</span>
                    }
                    @if (otherOpen > 0)
                    {
                        <span class="badge badge-amber" style="margin-left:.35rem;" title="More than one visit is open; check which one this work belongs to">+@otherOpen more open</span>
                    }
                }
            </div>
        }
        @if (Patient.Aliases is { Count: > 0 })
        {
            <div class="muted" style="margin-top:.35rem;">
                Other identifiers and aliases:
                @foreach (var alias in Patient.Aliases)
                {
                    @if (alias.AlsoOnMrn is { } otherMrn)
                    {
                        <a class="badge badge-amber" style="margin-right:.35rem;" href="@($"/patients?q={Uri.EscapeDataString(otherMrn)}")"
                           title="Another chart holds this identifier: possibly the same person. Opens that chart in the patient list." data-also-on="@otherMrn">@alias.KindLabel: @alias.Value</a>
                    }
                    else
                    {
                        <span class="badge badge-gray" style="margin-right:.35rem;">@alias.KindLabel: @alias.Value</span>
                    }
                }
            </div>
        }
    </div>
    <div class="flex gap" style="flex-wrap:wrap;justify-content:flex-end;">
        <div class="stat" style="text-align:center;padding:.6rem 1rem;">
            <div class="label">Blood type</div>
            <div class="value" style="font-size:1.4rem;">@(CurrentType is null ? "—" : Ui.BloodType(CurrentType.Abo, CurrentType.RhD))</div>
            @if (RequireSecondAbo && SecondAboOnFile)
            {
                <div class="muted" style="font-size:.8rem;">Second ABO on file</div>
            }
        </div>
        <div class="stat" style="text-align:center;padding:.6rem 1rem;">
            <div class="label">Current specimen</div>
            <div class="value" style="font-size:1rem;">@(SpecimenCue.AccessionNumber ?? "—")</div>
        </div>
        @if (Exm is not null)
        {
            <div class="stat" style="text-align:center;padding:.6rem 1rem;">
                <div class="label">Electronic XM</div>
                <div class="value" style="font-size:1rem;">
                    <span class="badge @(Exm.Eligible ? "badge-green" : "badge-amber")">@(Exm.Eligible ? "Eligible" : "Not eligible")</span>
                </div>
            </div>
        }
        @if (CanEditDemographics)
        {
            <button class="btn btn-secondary" @onclick="OnToggleEdit">@(EditingDemographics ? "Cancel edit" : "Edit demographics")</button>
        }
        @if (CanMergePatients)
        {
            <button class="btn btn-secondary" @onclick="OnToggleMerge">@(ShowMerge ? "Cancel merge" : "Merge duplicate")</button>
        }
        @if (Session.Has(PermissionCodes.LookbackManage))
        {
            <a class="btn btn-secondary" href="@RecipientTraceHref">Recipient traceback</a>
        }
        @if (Session.Has(PermissionCodes.IssueCreate) && Patient.MergedIntoPatientId is null)
        {
            <a class="btn btn-secondary" href="@($"/downtime/patients?patientId={Patient.Id}")" title="Blood type, antibodies, special requirements, specimens, and units on one sheet" data-print-summary>Print summary</a>
        }
        @if (Session.Has(PermissionCodes.ResultEnter) && Patient.MergedIntoPatientId is null)
        {
            <a class="btn btn-secondary" href="@($"/patients/{Patient.Id}/antibody-card")" title="A card for the patient to carry: blood type, antibodies, and special requirements" data-antibody-card>Antibody card</a>
        }
        <a class="btn btn-secondary" href="/patients">Back to patients</a>
    </div>
</div>

@if (EditingDemographics)
{
    <div class="bb-card" style="margin-bottom:1rem;">
        <div class="bb-card-title"><h3>Edit demographics</h3></div>
        <Outcome Value="DemoFeedback" />
        <div class="form-row">
            <div class="field"><label>MRN</label><input value="@Patient.MedicalRecordNumber" disabled /></div>
            <div class="field"><label>Last name</label><input @bind="Demo.LastName" /></div>
            <div class="field"><label>First name</label><input @bind="Demo.FirstName" /></div>
            <div class="field"><label>Middle name</label><input @bind="Demo.MiddleName" /></div>
            <div class="field"><label>Date of birth</label><input type="date" @bind="Demo.DateOfBirth" /></div>
            <div class="field"><label>Sex</label>
                <select @bind="Demo.Sex">
                    @foreach (var s in Enum.GetValues<Sex>())
                    {
                        <option value="@s">@Ui.EnumText(s)</option>
                    }
                </select>
            </div>
            <div class="field"><label>Race</label>
                <select @bind="Demo.Race">
                    <option value="">Not recorded</option>
                    @foreach (var r in PatientDemographicCodes.Races)
                    {
                        <option value="@r.Code">@r.Label</option>
                    }
                </select>
            </div>
            <div class="field"><label>Ethnicity</label>
                <select @bind="Demo.Ethnicity">
                    <option value="">Not recorded</option>
                    @foreach (var e in PatientDemographicCodes.Ethnicities)
                    {
                        <option value="@e.Code">@e.Label</option>
                    }
                </select>
            </div>
            <div class="field"><label>Status</label>
                <select @bind="Demo.Status">
                    <option value="@PatientStatus.Active">Active</option>
                    <option value="@PatientStatus.Inactive">Inactive</option>
                </select>
            </div>
        </div>
        <div class="field">
            <label>Comment</label>
            <CodedCommentField Page="CommentPage.Patient" @bind-Value="Demo.Comment" />
        </div>
        <div class="field">
            <label>Name-change reason</label>
            <input @bind="Demo.NameChangeReason" placeholder="Required when first, middle, or last name changes" />
        </div>
        <p class="muted">MRN cannot be changed. Changing the name keeps the previous name as a historical alias and requires a reason. Later ADT messages may overwrite name, date of birth, and sex.</p>
        <div class="flex gap">
            <button class="btn btn-primary" disabled="@Busy" @onclick="OnSaveDemo">Save</button>
            <button class="btn btn-secondary" @onclick="OnCancelEdit">Cancel</button>
        </div>
    </div>
}

        @if (Patient.Status == PatientStatus.Merged)
        {
            <div class="alert alert-danger">
                <strong>Merged record.</strong>
                This patient record is merged. Continue testing, allocation, and issue on the surviving patient record.
                @if (Patient.MergedIntoPatientId is long survivorId)
                {
                    <button class="btn btn-primary btn-sm" style="margin-left:.75rem;" @onclick="() => OpenSurvivor(survivorId)">Open surviving patient</button>
                }
            </div>
            @if (CanUnmerge)
            {
                <div class="bb-card" style="margin-bottom:1rem;">
                    <div class="bb-card-title"><h3>Undo this merge</h3></div>
                    <p class="muted">Unmerge puts this record back to Active and returns the history that moved, when nothing new has been ordered, resulted, or issued on the surviving patient since the merge. A reason is required. Merges recorded before this ledger cannot be undone here.</p>
                    <Outcome Value="UnmergeFeedback" />
                    <div class="field"><label>Reason</label><input @bind="UnmergeReason" @bind:after="() => UnmergeReasonChanged.InvokeAsync(UnmergeReason)" placeholder="Why these records are not the same person" /></div>
                    <button class="btn btn-primary" disabled="@Busy" @onclick="OnUnmerge">Unmerge</button>
                </div>
            }
        }

@if (ShowMerge && CanMergePatients)
{
    <div class="bb-card" style="margin-bottom:1rem;">
        <div class="bb-card-title"><h3>Merge a duplicate into this patient</h3></div>
        <p class="muted">The duplicate is marked Merged and is no longer used for testing, allocation, or issue. History and antibody-identification workups are reassigned to this record and are not deleted. Merge HardStops if both records have an open workup.</p>
        <Outcome Value="MergeFeedback" />
        <div class="form-row">
            <div class="field"><label>Duplicate MRN</label><input @bind="MergeMrn" @bind:after="() => MergeMrnChanged.InvokeAsync(MergeMrn)" placeholder="MRN of the losing record" /></div>
            <div class="field" style="flex:2;"><label>Reason</label><input @bind="MergeReason" @bind:after="() => MergeReasonChanged.InvokeAsync(MergeReason)" placeholder="Why these records are the same person" /></div>
        </div>
        <div class="flex gap">
            <button class="btn btn-primary" disabled="@Busy" @onclick="OnMerge">Merge into this patient</button>
            <button class="btn btn-secondary" @onclick="OnCancelMerge">Cancel</button>
        </div>
    </div>
}

@if (AboDiscrepancyNotice is not null)
{
    <div class="alert alert-warning">
        <strong>@AboDiscrepancyNotice</strong>
    </div>
}

@if (ExmNotice is not null)
{
    <div class="alert alert-warning">
        <strong>@ExmNotice</strong>
    </div>
}

@if (SecondAboNotice is not null)
{
    <div class="alert alert-warning">
        <strong>@SecondAboNotice</strong>
        Routine red-cell issue stays blocked until that type is on file. Emergency release can still be authorized.
    </div>
}

@if (SpecimenCue.BlocksIssue || SpecimenCue.ExpiresSoon)
{
    <div class="alert @(SpecimenCue.BlocksIssue ? "alert-danger" : "alert-warning")">
        <strong>@SpecimenCue.Message</strong>
        The issue gate reads this specimen.
    </div>
}

@if (ReactionNotice is not null)
{
    <div class="alert alert-warning">
        <strong>@ReactionNotice</strong>
        <a href="@($"/patients/{Patient.Id}?tab=history")">Product history</a>
    </div>
}

@if (AntibodyHistory.Count > 0)
{
    <div class="alert alert-warning" data-header-antibodies>
        <strong>Antibody history:</strong>
        @string.Join(", ", AntibodyHistory.Select(AntibodyLabel))
    </div>
}

@* Informational requirements are a banner only; the rest are enforced at selection and issue. *@
@foreach (var info in ActiveSpecialRequirements.Where(r => r.IsInformational))
{
    <div class="alert alert-info" data-special-requirement-banner>
        <strong>@(info.Name ?? info.Code):</strong> @(info.Instruction ?? info.Reason)
    </div>
}
@if (ActiveSpecialRequirements.Any(r => !r.IsInformational))
{
    <div class="alert alert-warning" data-header-requirements>
        <strong>Special transfusion requirements:</strong>
        @string.Join(", ", ActiveSpecialRequirements.Where(r => !r.IsInformational).Select(EnforcedLabel))
    </div>
}

@code {
    private string _identifiedMrn = string.Empty;
    private string _identifyReason = string.Empty;
    private bool _identifying;
    private Feedback? _identifyFb;

    // The identified chart survives; open it, where everything from this chart now is.
    private async Task IdentifyAsync()
    {
        _identifying = true;
        var r = await Api.IdentifyPatientAsync(Patient.Id, new IdentifyPatientRequest(_identifiedMrn, _identifyReason));
        _identifying = false;
        if (r.Succeeded && r.Value is { } survivor)
        {
            Nav.NavigateTo($"/patients/{survivor.Id}", forceLoad: true);
            return;
        }

        _identifyFb = r.ToFeedback();
    }

    [Parameter, EditorRequired] public PatientDto Patient { get; set; } = default!;

    // Mother and infant charts (information only): loaded when the chart changes.
    private PatientFamilyDto? _family;
    private long _familyFor;
    private bool _linking;
    private bool _unlinking;
    private bool _familyBusy;
    private string _motherMrn = string.Empty;
    private string _unlinkReason = string.Empty;
    private Feedback? _familyFb;

    protected override async Task OnParametersSetAsync()
    {
        if (Patient.Id != _familyFor)
        {
            _familyFor = Patient.Id;
            _linking = _unlinking = false;
            _familyFb = null;
            await LoadFamilyAsync();
        }
    }

    private List<IssuedUnderEarlierIdentityDto> _issuedUnderEarlier = new();

    private async Task LoadFamilyAsync()
    {
        var r = await Api.GetPatientFamilyAsync(Patient.Id);
        _family = r.Succeeded ? r.Value : null;
        var issued = await Api.GetIssuedUnderEarlierIdentityAsync(Patient.Id);
        _issuedUnderEarlier = issued.Succeeded ? issued.Value ?? new() : new();
    }

    private async Task LinkMotherAsync()
    {
        _familyBusy = true;
        var r = await Api.LinkMotherAsync(Patient.Id, new LinkMotherRequest(_motherMrn));
        _familyBusy = false;
        _familyFb = r.ToFeedback("Mother linked.");
        if (r.Succeeded)
        {
            _linking = false;
            _motherMrn = string.Empty;
            await LoadFamilyAsync();
        }
    }

    private async Task UnlinkMotherAsync()
    {
        _familyBusy = true;
        var r = await Api.UnlinkMotherAsync(Patient.Id, new UnlinkMotherRequest(_unlinkReason));
        _familyBusy = false;
        _familyFb = r.ToFeedback("Mother link removed.");
        if (r.Succeeded)
        {
            _unlinking = false;
            _unlinkReason = string.Empty;
            await LoadFamilyAsync();
        }
    }
    [Parameter] public BloodTypeDto? CurrentType { get; set; }
    [Parameter] public IReadOnlyList<EncounterDto> Encounters { get; set; } = [];
    [Parameter] public bool VisitsLoaded { get; set; }
    [Parameter] public IReadOnlyList<BloodTypeDto> TypeHistory { get; set; } = [];
    [Parameter] public bool RequireSecondAbo { get; set; } = true;
    [Parameter] public ElectronicCrossmatchEligibilityDto? Exm { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public bool CanEditDemographics { get; set; }
    [Parameter] public bool CanMergePatients { get; set; }
    [Parameter] public bool CanUnmerge { get; set; }
    [Parameter] public bool EditingDemographics { get; set; }
    [Parameter] public bool ShowMerge { get; set; }
    [Parameter] public PatientDemoEditModel Demo { get; set; } = new();
    [Parameter] public Feedback? DemoFeedback { get; set; }
    [Parameter] public Feedback? MergeFeedback { get; set; }
    [Parameter] public Feedback? UnmergeFeedback { get; set; }
    [Parameter] public string MergeMrn { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> MergeMrnChanged { get; set; }
    [Parameter] public string MergeReason { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> MergeReasonChanged { get; set; }
    [Parameter] public string UnmergeReason { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> UnmergeReasonChanged { get; set; }
    [Parameter] public bool HasRecordedReaction { get; set; }
    [Parameter] public IReadOnlyList<AntibodyDto> AntibodyHistory { get; set; } = [];
    [Parameter] public IEnumerable<SpecialRequirementDto> ActiveSpecialRequirements { get; set; } = [];

    /// <summary>
    /// "Anti-K", "Anti-E (historical / currently undetectable)", and for one known only from another facility's report
    /// "Anti-Jka (reported by St. Mary's, identified 2025-02-01)", as the downtime sheet and antibody card say it.
    /// </summary>
    private static string AntibodyLabel(AntibodyDto a) =>
        OutsideAntibodyReportRule.HistoryEntry(a.AntibodySpecificity, a.IsActive, a.ReportingFacility, a.IdentifiedOn);

    private static string EnforcedLabel(SpecialRequirementDto r)
    {
        var name = SpecialRequirementLabel.Display(r.Name ?? r.Code, r.RequirementType, r.AntigenCode);
        return r.ComponentClass is { } c && !name.Contains(ComponentClassLabels.Label(c), StringComparison.OrdinalIgnoreCase)
            ? $"{name} ({ComponentClassLabels.Label(c)})"
            : name;
    }
    [Parameter] public IReadOnlyList<SpecimenDto> Specimens { get; set; } = [];
    [Parameter] public EventCallback OnToggleEdit { get; set; }
    [Parameter] public EventCallback OnToggleMerge { get; set; }
    [Parameter] public EventCallback OnSaveDemo { get; set; }
    [Parameter] public EventCallback OnCancelEdit { get; set; }
    [Parameter] public EventCallback OnMerge { get; set; }
    [Parameter] public EventCallback OnCancelMerge { get; set; }
    [Parameter] public EventCallback OnUnmerge { get; set; }

    private CurrentSpecimenBanner.Cue SpecimenCue =>
        CurrentSpecimenBanner.Describe(
            Specimens.Select(s => new CurrentSpecimenBanner.Fact(s.AccessionNumber, s.Status, s.CollectedUtc, s.ExpiresUtc)),
            DateTime.UtcNow);

    private IReadOnlyList<SecondAboDeterminationRule.Determination> AboHistory =>
        BloodTypeDto.Determinations(TypeHistory);

    private bool SecondAboOnFile => SecondAboDeterminationRule.HasSecondConcordant(AboHistory);

    private string? SecondAboNotice => SecondAboDeterminationRule.MissingCellularIssueNotice(RequireSecondAbo, AboHistory);

    private string? AboDiscrepancyNotice =>
        IssueGate.PatientBannerNotice(BloodTypeDto.DiscrepancyInput(TypeHistory));

    private string? ReactionNotice => ReactionHistoryBanner.Notice(HasRecordedReaction);

    private string? ExmNotice => Exm is null
        ? null
        : ElectronicCrossmatchBanner.Notice(Exm.Eligible, Exm.BlockingReason);

    private string RecipientTraceHref =>
        $"/lookback?mrn={Uri.EscapeDataString(Patient.MedicalRecordNumber)}";

    private void OpenSurvivor(long survivorId) =>
        Nav.NavigateTo($"/patients/{survivorId}");

    private static string DisplayName(PatientDto p) =>
        string.IsNullOrWhiteSpace(p.MiddleName)
            ? $"{p.LastName}, {p.FirstName}"
            : $"{p.LastName}, {p.FirstName} {p.MiddleName}";
}
