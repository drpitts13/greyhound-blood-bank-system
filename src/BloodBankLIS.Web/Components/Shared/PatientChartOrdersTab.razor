    private async Task OnNewProviderChanged(long? value)
    {
        NewOrderProviderId = value;
        await NewOrderProviderIdChanged.InvokeAsync(value);
    }

    private async Task OnEditProviderChanged(long? value)
    {
        EditOrderProviderId = value;
        await EditOrderProviderIdChanged.InvokeAsync(value);
    }

    private async Task OnNewCommentChanged(string? value)
    {
        NewOrderComment = value;
        await NewOrderCommentChanged.InvokeAsync(value);
    }

    private async Task OnEditCommentChanged(string? value)
    {
        EditOrderComment = value;
        await EditOrderCommentChanged.InvokeAsync(value);
    }

    private async Task OnAccessionNowChanged()
    {
        await NewOrderAccessionNowChanged.InvokeAsync(NewOrderAccessionNow);
        await OnAccessionNowAfter.InvokeAsync();
    }

    private async Task OnFilterChanged()
    {
        await OrderVisitFilterChanged.InvokeAsync(OrderVisitFilter);
        await OrderCategoryFilterChanged.InvokeAsync(OrderCategoryFilter);
        await OrderActiveFilterChanged.InvokeAsync(OrderActiveFilter);
        await OnRefresh.InvokeAsync();
    }

    private static bool IsGrouperSelected(string code, HashSet<string> selected) => selected.Contains(code);

    private IEnumerable<SpecimenDto> SpecimensForNewOrder =>
        NewOrderProductTypeIds.Count > 0
            ? LinkableSpecimens.Where(s => s.HasCompletedTypeAndScreen)
            : LinkableSpecimens;

    private IEnumerable<SpecimenDto> SpecimensFor(PatientOrderDto order) =>
        order.Lines.Any(l => l.LineCategory == OrderCategory.Product)
            ? LinkableSpecimens.Where(s => s.HasCompletedTypeAndScreen)
            : LinkableSpecimens;

    private bool HasAllocatedUnitFor(PatientOrderDto order) =>
        Allocations.Any(a => a.OrderId == order.Id && a.AllocationStatus == AllocationStatus.Reserved);

    private static HashSet<long> OrderProductTypeIds(PatientOrderDto order) =>
        order.Lines.Where(l => l.LineCategory == OrderCategory.Product && l.ProductTypeId is > 0)
            .Select(l => l.ProductTypeId!.Value)
            .ToHashSet();

    private static long? ParseLong(object? value) =>
        long.TryParse(value?.ToString(), out var id) ? id : null;

    private static string OrderRowClass(PatientOrderDto o)
    {
        if (o.Status == OrderStatus.Cancelled || o.Status == OrderStatus.Completed) return "row-muted";
        return o.IsUrgentPriority ? "row-urgent" : string.Empty;
    }

    private DateTime? AccessionPreviewExpires =>
        SpecimenTypeOrderHint.PreviewExpiresUtc(OrderAcc.CollectedLocal, OrderAcc.SpecimenType, SpecimenTypes);

    private string? AccessionMismatch =>
        SpecimenTypeOrderHint.MismatchWarning(TestDefs, NewOrderTestCodes, OrderAcc.SpecimenType);

    private string? LinkExistingMismatch =>
        SpecimenTypeOrderHint.MismatchWarning(TestDefs, NewOrderTestCodes, SelectedOrLatestSpecimenType);

    private string? SelectedOrLatestSpecimenType
    {
        get
        {
            if (NewOrderSpecimenId > 0)
            {
                return LinkableSpecimens.FirstOrDefault(s => s.Id == NewOrderSpecimenId)?.SpecimenType;
            }

            return LinkableSpecimens.FirstOrDefault()?.SpecimenType;
        }
    }

    private string? LinkRowMismatch(PatientOrderDto order)
    {
        var specimen = LinkableSpecimens.FirstOrDefault(s => s.Id == LinkSpecimenId);
        var codes = order.Lines
            .Where(l => l.LineCategory == OrderCategory.Test && !string.IsNullOrWhiteSpace(l.TestCode))
            .Select(l => l.TestCode!);
        return SpecimenTypeOrderHint.MismatchWarning(TestDefs, codes, specimen?.SpecimenType);
    }

    private static string FormatProvider(OrderingProviderRefDto p) => $"{p.Name} ({p.ProviderId})";
    private static string SearchProvider(OrderingProviderRefDto p) =>
        $"{p.Name} {p.ProviderId} {p.Specialty} {p.Location}";
    private static long? ProviderItemValue(OrderingProviderRefDto p) => p.Id;
