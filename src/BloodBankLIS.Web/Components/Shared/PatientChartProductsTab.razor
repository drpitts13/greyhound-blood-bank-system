@inject UserSession Session

<div class="bb-card">
    <div class="bb-card-title flex-between">
        <h3>Allocated products</h3>
        <div class="flex gap">
            <label class="checkbox-item">
                <input type="checkbox" checked="@ShowIssuedTransfused" @onchange="OnToggleIssued" />
                Show issued/transfused
            </label>
            @if (Session.Has(PermissionCodes.CompatibilityAllocate))
            {
                <button type="button" class="btn btn-primary btn-sm" @onclick="OnToggleAllocate">@(ShowAllocate ? "Cancel" : "Allocate unit")</button>
            }
        </div>
    </div>
    <p class="muted">A blank storage location name stays the location id. A location code is not shown.</p>
    <Outcome Value="AllocFeedback" />
    @if (AllocLoading) { <div class="loading">Loading allocations...</div> }
                else if (Allocations.Count == 0) { <div class="empty">@(ShowIssuedTransfused ? "No product allocations." : "No active product allocations.")</div> }
    else
    {
        <table class="bb">
                    <thead><tr><th>Unit number</th><th>Product code</th><th>Product</th><th>Expires</th><th>Unit type</th><th>Location</th><th>Crossmatch</th><th>Status</th><th>Unit</th><th></th></tr></thead>
            <tbody>
                @foreach (var a in Allocations)
                {
                    <tr>
                        <td class="mono">
                            @if (a.BloodUnitId > 0)
                            {
                                <a href="@InventoryUrls.Unit(a.BloodUnitId)">@(string.IsNullOrWhiteSpace(a.UnitNumber) ? $"#{a.BloodUnitId}" : a.UnitNumber)</a>
                            }
                            else
                            {
                                @(string.IsNullOrWhiteSpace(a.UnitNumber) ? "—" : a.UnitNumber)
                            }
                        </td>
                        <td class="mono">@a.ProductCode</td>
                        <td>@(string.IsNullOrWhiteSpace(a.ProductName) ? "—" : a.ProductName)</td>
                        <td class="nowrap">@(a.UnitExpiresUtc is DateTime unitExpires ? unitExpires.ToString("yyyy-MM-dd HH:mm") : "—")</td>
                        <td><strong>@(string.IsNullOrWhiteSpace(a.UnitBloodType) ? "—" : a.UnitBloodType)</strong></td>
                        <td>@(string.IsNullOrWhiteSpace(a.StorageLocationName) ? "—" : a.StorageLocationName)</td>
                        <td class="nowrap">
                            @(a.CrossmatchResult is CrossmatchResult chartXm ? chartXm.ToString() : "—")
                            @if (a.CrossmatchExpiresUtc is DateTime chartXmExpires)
                            {
                                <div class="muted">@chartXmExpires.ToString("yyyy-MM-dd HH:mm")</div>
                            }
                        </td>
                        <td><span class="@Ui.Badge(a.DisplayStatus)">@DisplayAllocationStatus(a.DisplayStatus)</span></td>
                        <td><span class="@Ui.Badge(a.UnitStatus)">@Ui.StatusLabel(a.UnitStatus)</span></td>
                        <td>
                            <div class="flex gap" style="flex-wrap:wrap;">
                                @if (Session.Has(PermissionCodes.CompatibilityCrossmatch) && Session.Has(PermissionCodes.ResultEnter) && NeedsCrossmatchEntry(a))
                                {
                                    @if (a.OrderSpecimenLinked)
                                    {
                                        <button type="button" class="btn btn-ghost btn-sm" disabled="@Busy" @onclick="() => OnBeginCrossmatch.InvokeAsync(a)">Crossmatch</button>
                                    }
                                    else
                                    {
                                        <span class="muted">Link a specimen to the order before crossmatch.</span>
                                    }
                                }
                                @if (Session.Has(PermissionCodes.InventoryModify) && a.IssueId is null && a.AllocationStatus == AllocationStatus.Reserved)
                                {
                                    <a class="btn btn-ghost btn-sm" href="@ModifyUnitHref(a)">Modify</a>
                                }
                                @if (CanTypeUnitAntigens(a))
                                {
                                    <a class="btn btn-secondary btn-sm" href="@UnitAntigenTypingHref(a)">Unit antigen typing</a>
                                }
                                @foreach (var action in (a.PendingActions ?? []).Where(x => x.Category == ActionCategory.Modification))
                                {
                                    <a class="btn btn-secondary btn-sm" href="@ModifyActionHref(a, action)">@action.ActionName</a>
                                }
                                @if (CanOfferAutoThaw(a))
                                {
                                    <button type="button" class="btn btn-secondary btn-sm" disabled="@Busy" @onclick="() => OnBeginAutoThaw.InvokeAsync(a)">Auto thaw @a.AutoThawProductCode</button>
                                }
                                @if (Session.Has(PermissionCodes.IssueCreate) && a.IssueId is null)
                                {
                                    @if (a.UnitOutdated)
                                    {
                                        <span class="badge badge-red" title="This unit is outdated and cannot be issued.">Outdated</span>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-primary btn-sm" disabled="@Busy" @onclick="() => OnBeginIssue.InvokeAsync(a)">Issue</button>
                                    }
                                }
                                @if (a.IssueId is long issueId && a.IssueStatus == IssueStatus.Issued && Session.Has(PermissionCodes.TransfusionDocument))
                                {
                                    <button type="button" class="btn btn-link btn-sm" disabled="@Busy" @onclick="() => OnMarkTransfused.InvokeAsync(issueId)">Transfuse</button>
                                }
                                @if (Session.Has(PermissionCodes.CompatibilityAllocate) && a.IssueId is null && a.AllocationStatus == AllocationStatus.Reserved)
                                {
                                    <button type="button" class="btn btn-ghost btn-sm" disabled="@Busy" @onclick="() => OnBeginRelease.InvokeAsync(a)">Release</button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (LastIssue is not null)
    {
        <div class="alert alert-success" style="margin-top:1rem;">
            Issue <strong>#@LastIssue.Id</strong> created for unit @LastIssue.BloodUnitId.
            <div class="flex gap" style="margin-top:.65rem;flex-wrap:wrap;">
                @if (Session.Has(PermissionCodes.PrintLabel))
                {
                    <button type="button" class="btn btn-primary btn-sm" disabled="@Busy" @onclick="OnPrintPtag">Print P-tag</button>
                }
                <a class="btn btn-secondary btn-sm" href="@(PrintedJobId is long jobId ? $"/printing?jobId={jobId}" : $"/printing?issueId={LastIssue.Id}")">Open Printing</a>
            </div>
            <Outcome Value="PtagFeedback" />
        </div>
    }

    @if (IssuingAllocation is not null)
    {
        <div class="bb-dialog-backdrop">
        <div class="bb-dialog" role="dialog" aria-modal="true" aria-labelledby="issue-unit-title" style="width:min(960px,100%);">
            <div class="bb-card-title"><h3 id="issue-unit-title">Issue unit <span class="mono">@IssuingAllocation.UnitNumber</span></h3></div>
            @if (OpenAbidWorkups.Count > 0)
            {
                <div class="alert alert-warning">
                    Open antibody-identification workup(s). Issue may proceed; antigen-negative needs may change when the workup completes.
                    This does not identify antibodies.
                    <a href="@AbidHref">Open antibody identification</a>.
                </div>
            }
            <Outcome Value="IssueFeedback" RequiresSignature="true" />
            <div class="form-row">
                <div class="field"><label>Date/time of issue</label>
                    <input type="datetime-local" @bind="IssueLocalDateTime" @bind:after="() => IssueLocalDateTimeChanged.InvokeAsync(IssueLocalDateTime)" />
                </div>
                <div class="field"><label>Location to issue</label>
                    <input @bind="IssueLocation" @bind:after="() => IssueLocationChanged.InvokeAsync(IssueLocation)" placeholder="Ward / OR / location" />
                </div>
                <div class="field"><label>Person issued to</label>
                    <input @bind="IssueIssuedTo" @bind:after="() => IssueIssuedToChanged.InvokeAsync(IssueIssuedTo)" placeholder="Nurse / courier / recipient" />
                </div>
                <div class="field"><label>Patient ID 1 (MRN)</label>
                    <input @bind="IssueId1" @bind:after="() => IssueId1Changed.InvokeAsync(IssueId1)" />
                </div>
                <div class="field"><label>Patient ID 2 (DOB yyyy-MM-dd)</label>
                    <input @bind="IssueId2" @bind:after="() => IssueId2Changed.InvokeAsync(IssueId2)" />
                </div>
                <div class="field"><label>Second verifier</label>
                    <FilterableComboBox TItem="DirectoryUserDto" TValue="string?"
                        Items="SecondVerifierChoices"
                        Value="IssueSecondVerifier"
                        ValueChanged="OnSecondVerifierChanged"
                        DisplayText="@(u => u.Label)"
                        ItemValue="@(u => u.UserName)"
                        SearchText="@(u => u.Label)"
                        Clearable="true"
                        Placeholder="Different active user" />
                </div>
                <div class="field"><label>User id issuing</label>
                    <input value="@(Session.UserName ?? "—")" disabled />
                </div>
                <div class="field" style="grid-column:1/-1;"><label>Comments (optional)</label>
                    <textarea rows="2" @bind="IssueComment" @bind:after="() => IssueCommentChanged.InvokeAsync(IssueComment)"></textarea>
                </div>
            </div>
            <div class="field" style="min-width:14rem;"><label>Appearance at issue</label>
                <select @bind="IssueAppearance" @bind:after="() => IssueAppearanceChanged.InvokeAsync(IssueAppearance)">
                    @foreach (var a in Enum.GetValues<UnitAppearance>()) { <option value="@a">@a</option> }
                </select>
            </div>
            <UnitScanVerificationPanel Scan="IssueScan" />
            @if (PtagRequired)
            {
                <div class="alert alert-warning" style="margin-top:.75rem;">
                    <strong>P-tag ID</strong>
                    <p class="muted">Print the compatibility tag, then scan the P-tag ID before issuing.</p>
                    <div class="flex gap" style="flex-wrap:wrap;align-items:end;">
                        @if (Session.Has(PermissionCodes.PrintLabel))
                        {
                            <button type="button" class="btn btn-secondary btn-sm" disabled="@Busy" @onclick="OnPrintPreparedPtag">Print P-tag</button>
                        }
                        <div class="field" style="min-width:14rem;margin:0;">
                            <label>Scanned P-tag ID</label>
                            <input value="@PtagId" @oninput="OnPtagTyped" autocomplete="off" />
                        </div>
                        @if (PreparedJobId is long preparedJob)
                        {
                            <a class="btn btn-ghost btn-sm" href="@($"/printing?jobId={preparedJob}")">Open preview</a>
                        }
                    </div>
                    <Outcome Value="PtagPrepareFeedback" />
                </div>
            }
            @if (AcknowledgmentSpecialRequirements.Any())
            {
                <div class="alert alert-warning" style="margin-top:.75rem;">
                    <strong>Acknowledge special requirements</strong>
                    @foreach (var req in AcknowledgmentSpecialRequirements)
                    {
                        <label class="flex" style="gap:.35rem;margin-top:.35rem;">
                            <input type="checkbox" checked="@IssueAcks.Contains(req.Code ?? "")" @onchange="e => OnToggleIssueAck.InvokeAsync((req.Code, IsChecked(e)))" />
                            @(req.Name ?? req.Code) @(string.IsNullOrWhiteSpace(req.Instruction) ? "" : $"— {req.Instruction}")
                        </label>
                    }
                </div>
            }

            @if (ShowIssueOverride)
            {
                <div class="bb-card" style="background:#fff8f0;margin-top:.75rem;border:1px solid #e8c48a;">
                    <strong>Issue override required</strong>
                    <p class="muted">The issue gate reported warnings. Provide a reason, authorizer, and electronic signature to proceed.</p>
                    <div class="form-row">
                        <div class="field"><label>Override reason</label><input @bind="IssueOverrideReason" @bind:after="() => IssueOverrideReasonChanged.InvokeAsync(IssueOverrideReason)" /></div>
                        <div class="field"><label>Authorized by</label><input @bind="IssueAuthorizedBy" @bind:after="() => IssueAuthorizedByChanged.InvokeAsync(IssueAuthorizedBy)" placeholder="@Session.UserName" /></div>
                        <div class="field"><label>Meaning of signature</label><input @bind="IssueSignatureMeaning" @bind:after="() => IssueSignatureMeaningChanged.InvokeAsync(IssueSignatureMeaning)" placeholder="I authorize issue override" /></div>
                        <div class="field"><label>Password / PIN</label><input type="password" @bind="IssueSignatureSecret" @bind:after="() => IssueSignatureSecretChanged.InvokeAsync(IssueSignatureSecret)" /></div>
                    </div>
                    <div class="flex gap" style="margin-top:.5rem;">
                        <button type="button" class="btn btn-danger btn-sm" disabled="@(Busy || PtagScanMissing)" @onclick="OnIssueOverride">Sign &amp; issue</button>
                        <button type="button" class="btn btn-ghost btn-sm" @onclick="OnCancelIssue">Cancel</button>
                    </div>
                </div>
            }
            else
            {
                <div class="flex gap" style="margin-top:.75rem;">
                    <button type="button" class="btn btn-primary" disabled="@(Busy || PtagScanMissing)" @onclick="OnConfirmIssue">Confirm issue</button>
                    <button type="button" class="btn btn-ghost" @onclick="OnCancelIssue">Cancel</button>
                </div>
            }
        </div>
        </div>
    }

    @if (ReleasingAllocationId is not null)
    {
        <div class="bb-card" style="margin-top:1rem;background:#fff8f0;">
            <div class="field"><label>Release reason</label><input @bind="ReleaseReason" @bind:after="() => ReleaseReasonChanged.InvokeAsync(ReleaseReason)" placeholder="Reason for releasing allocation" /></div>
            <div class="flex gap" style="margin-top:.5rem;">
                <button class="btn btn-danger btn-sm" disabled="@Busy" @onclick="OnConfirmRelease">Confirm release</button>
                <button class="btn btn-ghost btn-sm" @onclick="OnCancelRelease">Cancel</button>
            </div>
        </div>
    }
</div>

@if (ShowAllocate && Session.Has(PermissionCodes.CompatibilityAllocate))
{
    <div class="bb-card" style="margin-top:1rem;">
        <div class="bb-card-title"><h3>Allocate unit</h3></div>
        <p class="muted">Choose an open product order, then a unit. Only units this patient can safely receive are offered.</p>
        <details class="bb-help">
            <summary>How units are offered</summary>
            <ul>
                <li>Select an open product order and an in-date ABO/Rh-compatible Available unit that has completed retype when the product requires it.</li>
                <li>An outdated unit is not offered.</li>
                <li>A unit that does not meet an active irradiated, CMV-negative, leukoreduced, washed, or antigen-negative requirement is not offered.</li>
                <li>A unit inside the facility near-expiry window is marked expires soon.</li>
                <li>A unit that already has a compatible crossmatch for this patient is listed ahead of an unmatched unit in the same group and marked Crossmatch compatible.</li>
                <li>A unit with an incompatible crossmatch for this patient stays listed, after unmatched units in the same group, and is marked Crossmatch incompatible.</li>
                <li>Issue of that unit still uses the existing override.</li>
                <li>Crossmatch-required products attach EXM, XM, or CXM automatically.</li>
                <li>An unretyped unit can leave inventory only through emergency or MTP issue.</li>
                <li>Each choice shows the product and when the unit expires, including the time, and where that unit is stored.</li>
                <li>A blank storage location name stays the location id.</li>
                <li>A location code is not shown.</li>
                <li>Allocated products show that same product name and expiration, the unit ABO/Rh, and that storage location.</li>
                <li>They also show the latest crossmatch result and when a current compatible crossmatch expires.</li>
                <li>A unit with no crossmatch result shows none.</li>
                <li>Unit choices and the selected unit show the latest crossmatch result, and a current compatible expiration stays beside that result.</li>
                <li>Allocation and issue eligibility are unchanged.</li>
            </ul>
        </details>
        @if (OpenAbidWorkups.Count > 0)
        {
            <div class="alert alert-warning">
                Open antibody-identification workup(s). Allocation may proceed for serologic crossmatch; antigen-negative needs may change when the workup completes.
                Serologic XM warns (`ABID-XM-OPEN`) and still records. Electronic XM is blocked.
                <a href="@AbidHref">Open antibody identification</a>.
            </div>
        }
        <div class="form-row">
            <div class="field"><label>Visit</label>
                <select @bind="AllocEncounterId" @bind:after="() => AllocEncounterIdChanged.InvokeAsync(AllocEncounterId)">
                    <option value="0">— Active visit (auto) —</option>
                    @foreach (var v in Encounters.Where(e => e.Status == EncounterStatus.Active))
                    {
                        <option value="@v.Id">@v.VisitNumber</option>
                    }
                </select>
            </div>
            <div class="field"><label>Order</label>
                <select value="@AllocOrderId" @onchange="e => OnAllocOrderPicked.InvokeAsync(ParseLong(e.Value))">
                    <option value="0">— Select open product order —</option>
                    @foreach (var o in AllocatableOrders.Where(o => SelectedUnit is null || o.ProductTypeId == SelectedUnit.ProductTypeId))
                    {
                        <option value="@o.OrderId">@o.OrderNumber — @o.OrderName @(o.AccessionNumber is null ? "" : $"({o.AccessionNumber})")</option>
                    }
                </select>
            </div>
            <div class="field"><label>Specimen</label>
                <select @bind="AllocSpecimenId" @bind:after="() => AllocSpecimenIdChanged.InvokeAsync(AllocSpecimenId)">
                    <option value="0">— Order specimen —</option>
                    @foreach (var s in LinkableSpecimens.Where(x => x.HasCompletedTypeAndScreen))
                    {
                        <option value="@s.Id">@s.AccessionNumber</option>
                    }
                </select>
            </div>
        </div>

        @if (CompatUnitsLoading) { <div class="loading">Loading compatible units...</div> }
        else if (!string.IsNullOrWhiteSpace(CompatUnitsError)) { <div class="alert alert-warning">@CompatUnitsError</div> }
        else if (CompatibleUnits.Count == 0) { <div class="empty">No in-date ABO/Rh-compatible Available units.</div> }
        else
        {
            @if (HasPatientRestrictedUnit)
            {
                <div class="alert alert-warning" style="margin-top:.75rem;">
                    This patient has an available autologous or directed unit. Select that unit before allogeneic stock.
                </div>
            }
            <div class="field" style="margin-top:.75rem;">
                <label>Unit number</label>
                <FilterableComboBox TItem="CompatibleUnitDto" TValue="long?"
                    Items="CompatibleUnits"
                    Value="SelectedUnitId"
                    ValueChanged="OnAllocUnitChanged"
                    DisplayText="Ui.CompatibleUnitChoiceLabel"
                    ItemValue="@(u => u.BloodUnitId)"
                    SearchText="@(u => $"{u.UnitNumber} {u.ProductCode} {u.BloodType} {u.StorageLocationName} {u.BloodUnitId}")"
                    Clearable="true"
                    Placeholder="Type unit number" />
            </div>
            @if (SelectedUnit is not null)
            {
                <div class="form-row" style="margin-top:.5rem;">
                    <div class="field"><label>Product</label><div class="mono">@SelectedUnit.ProductCode — @SelectedUnit.ProductName</div></div>
                    <div class="field"><label>ABO/Rh</label><div>@SelectedUnit.BloodType</div></div>
                    <div class="field"><label>Expires</label><div class="nowrap">@SelectedUnit.ExpiresUtc.ToString("yyyy-MM-dd HH:mm")</div></div>
                    <div class="field"><label>Location</label><div>@(string.IsNullOrWhiteSpace(SelectedUnit.StorageLocationName) ? "—" : SelectedUnit.StorageLocationName)</div></div>
                    <div class="field"><label>Crossmatch</label>
                        <div class="nowrap">
                            @(SelectedUnit.LatestCrossmatchResult is CrossmatchResult selectedXm ? selectedXm.ToString() : "—")
                            @if (SelectedUnit.CrossmatchExpiresUtc is DateTime selectedXmExpires)
                            {
                                <div class="muted">@selectedXmExpires.ToString("yyyy-MM-dd HH:mm")</div>
                            }
                        </div>
                    </div>
                    <div class="field"><label>Crossmatch required</label><div>@(SelectedUnit.RequiresCrossmatch ? "Yes" : "No")</div></div>
                </div>
                @if (NeedsAllocOverride)
                {
                    <div class="alert alert-warning" style="margin-top:.75rem;">
                        @(string.IsNullOrWhiteSpace(SelectedUnit.AntigenNegDetail)
                            ? "This unit is not antigen-negative for the patient's antibody. Reserve requires an authorized override."
                            : SelectedUnit.AntigenNegDetail)
                    </div>
                    <div class="form-row" style="margin-top:.5rem;">
                        <div class="field"><label>Override reason</label><input @bind="AllocOverrideReason" @bind:after="() => AllocOverrideReasonChanged.InvokeAsync(AllocOverrideReason)" /></div>
                        <div class="field"><label>Authorized by</label><input @bind="AllocAuthorizedBy" @bind:after="() => AllocAuthorizedByChanged.InvokeAsync(AllocAuthorizedBy)" /></div>
                    </div>
                }
            }
        }

        @if (SelectedUnit is not null && SelectedUnit.RequiresCrossmatch)
        {
            <p class="muted" style="margin-top:.75rem;">
                @if (ExmEligible)
                {
                    <text>This patient is eligible for electronic crossmatch. Selecting a unit will add and result EXM on the open product order.</text>
                }
                else
                {
                    <text>Crossmatch tests attach to the open product order after the current antibody screen is completed. Change XM vs CXM on the order; downgrading to simple XM requires an exception.</text>
                }
            </p>
        }

        <div class="flex gap" style="margin-top:1rem;">
            <button class="btn btn-primary" disabled="@(Busy || SelectedUnitId is null || AllocOrderId <= 0)" @onclick="OnReserve">Reserve unit</button>
            @if (AllocOrderId <= 0)
            {
                <span class="muted">Choose an open product order. If none is listed, add a product order on the Orders tab.</span>
            }
            else if (SelectedUnitId is null)
            {
                <span class="muted">Select a compatible unit above.</span>
            }
        </div>
    </div>
}

@code {
    [Parameter] public bool Busy { get; set; }
    [Parameter] public bool ShowAllocate { get; set; }
    [Parameter] public Feedback? AllocFeedback { get; set; }
    [Parameter] public bool AllocLoading { get; set; }
    [Parameter] public IReadOnlyList<PatientAllocationRowDto> Allocations { get; set; } = [];
    [Parameter] public IssueDto? LastIssue { get; set; }
    [Parameter] public Feedback? PtagFeedback { get; set; }
    [Parameter] public long? PrintedJobId { get; set; }
    [Parameter] public PatientAllocationRowDto? IssuingAllocation { get; set; }
    [Parameter] public Feedback? IssueFeedback { get; set; }
    [Parameter] public DateTime IssueLocalDateTime { get; set; }
    [Parameter] public EventCallback<DateTime> IssueLocalDateTimeChanged { get; set; }
    [Parameter] public string IssueLocation { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> IssueLocationChanged { get; set; }
    [Parameter] public string IssueIssuedTo { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> IssueIssuedToChanged { get; set; }
    [Parameter] public string IssueId1 { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> IssueId1Changed { get; set; }
    [Parameter] public string IssueId2 { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> IssueId2Changed { get; set; }
    [Parameter] public string? IssueSecondVerifier { get; set; }
    [Parameter] public EventCallback<string?> IssueSecondVerifierChanged { get; set; }
    [Parameter] public string IssueComment { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> IssueCommentChanged { get; set; }
    [Parameter] public UnitAppearance IssueAppearance { get; set; } = UnitAppearance.Acceptable;
    [Parameter] public EventCallback<UnitAppearance> IssueAppearanceChanged { get; set; }
    [Parameter] public UnitScanModel IssueScan { get; set; } = new();
    [Parameter] public IReadOnlyCollection<string> IssueAcks { get; set; } = new HashSet<string>();
    [Parameter] public bool ShowIssueOverride { get; set; }
    [Parameter] public string IssueOverrideReason { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> IssueOverrideReasonChanged { get; set; }
    [Parameter] public string IssueAuthorizedBy { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> IssueAuthorizedByChanged { get; set; }
    [Parameter] public string IssueSignatureMeaning { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> IssueSignatureMeaningChanged { get; set; }
    [Parameter] public string IssueSignatureSecret { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> IssueSignatureSecretChanged { get; set; }
    [Parameter] public long? ReleasingAllocationId { get; set; }
    [Parameter] public string ReleaseReason { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ReleaseReasonChanged { get; set; }
    [Parameter] public IReadOnlyList<AntibodyIdWorkupListItemDto> OpenAbidWorkups { get; set; } = [];
    [Parameter] public string AbidHref { get; set; } = "/antibody-id";
    [Parameter] public IEnumerable<DirectoryUserDto> SecondVerifierChoices { get; set; } = [];
    [Parameter] public IEnumerable<SpecialRequirementDto> AcknowledgmentSpecialRequirements { get; set; } = [];
    [Parameter] public IReadOnlyList<EncounterDto> Encounters { get; set; } = [];
    [Parameter] public IEnumerable<SpecimenDto> LinkableSpecimens { get; set; } = [];
    [Parameter] public IReadOnlyList<AllocatableOrderDto> AllocatableOrders { get; set; } = [];
    [Parameter] public long AllocOrderId { get; set; }
    [Parameter] public EventCallback<long?> OnAllocOrderPicked { get; set; }
    [Parameter] public bool ShowIssuedTransfused { get; set; }
    [Parameter] public EventCallback OnToggleIssuedTransfused { get; set; }
    [Parameter] public EventCallback<long> OnMarkTransfused { get; set; }
    [Parameter] public bool CompatUnitsLoading { get; set; }
    [Parameter] public string? CompatUnitsError { get; set; }
    [Parameter] public IReadOnlyList<CompatibleUnitDto> CompatibleUnits { get; set; } = [];
    [Parameter] public long? SelectedUnitId { get; set; }
    [Parameter] public CompatibleUnitDto? SelectedUnit { get; set; }
    [Parameter] public bool ExmEligible { get; set; }
    [Parameter] public long AllocEncounterId { get; set; }
    [Parameter] public EventCallback<long> AllocEncounterIdChanged { get; set; }
    [Parameter] public long AllocSpecimenId { get; set; }
    [Parameter] public EventCallback<long> AllocSpecimenIdChanged { get; set; }
    [Parameter] public EventCallback OnToggleAllocate { get; set; }
    [Parameter] public EventCallback<PatientAllocationRowDto> OnBeginIssue { get; set; }
    [Parameter] public EventCallback<PatientAllocationRowDto> OnBeginRelease { get; set; }
    [Parameter] public EventCallback OnPrintPtag { get; set; }
    [Parameter] public bool PtagRequired { get; set; }
    [Parameter] public string PtagId { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> PtagIdChanged { get; set; }
    [Parameter] public EventCallback OnPrintPreparedPtag { get; set; }
    [Parameter] public Feedback? PtagPrepareFeedback { get; set; }
    [Parameter] public long? PreparedJobId { get; set; }
    [Parameter] public EventCallback<(string? Code, bool On)> OnToggleIssueAck { get; set; }
    [Parameter] public EventCallback OnConfirmIssue { get; set; }
    [Parameter] public EventCallback OnIssueOverride { get; set; }
    [Parameter] public EventCallback OnCancelIssue { get; set; }
    [Parameter] public EventCallback OnConfirmRelease { get; set; }
    [Parameter] public EventCallback OnCancelRelease { get; set; }
    [Parameter] public EventCallback<long?> OnAllocUnitChanged { get; set; }
    [Parameter] public EventCallback<PatientAllocationRowDto> OnBeginAutoThaw { get; set; }
    [Parameter] public EventCallback<PatientAllocationRowDto> OnBeginCrossmatch { get; set; }
    [Parameter] public EventCallback OnReserve { get; set; }
    [Parameter] public long PatientId { get; set; }
    [Parameter] public bool ShowAllocOverride { get; set; }
    [Parameter] public string AllocOverrideReason { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> AllocOverrideReasonChanged { get; set; }
    [Parameter] public string AllocAuthorizedBy { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> AllocAuthorizedByChanged { get; set; }

    private bool NeedsAllocOverride =>
        ShowAllocOverride || SelectedUnit?.AntigenNegFlag is not null;

    private bool HasPatientRestrictedUnit =>
        CompatibleUnits.Any(u => u.DonationRestriction is DonationRestriction.Autologous or DonationRestriction.Directed);

    private bool PtagScanMissing => PtagRequired && string.IsNullOrWhiteSpace(PtagId);

    private Task OnPtagTyped(ChangeEventArgs e) => PtagIdChanged.InvokeAsync(e.Value?.ToString() ?? string.Empty);

    private Task OnSecondVerifierChanged(string? value)
    {
        IssueSecondVerifier = value;
        return IssueSecondVerifierChanged.InvokeAsync(value);
    }

    private static bool IsChecked(ChangeEventArgs e) =>
        e.Value is true || string.Equals(Convert.ToString(e.Value), "true", StringComparison.OrdinalIgnoreCase);

    private string ModifyActionHref(PatientAllocationRowDto allocation, OrderActionDto action)
    {
        var returnUrl = Uri.EscapeDataString($"/patients/{PatientId}?tab=products");
        var type = action.ModificationType?.ToString() ?? string.Empty;
        return $"/inventory/modify?unitId={allocation.BloodUnitId}&orderActionId={action.Id}&modificationType={type}&returnUrl={returnUrl}";
    }

    private static bool NeedsCrossmatchEntry(PatientAllocationRowDto allocation) =>
        CrossmatchEntryNeed.ForAllocation(
            allocation.RequiresCrossmatch,
            allocation.CrossmatchResult,
            allocation.CrossmatchTestCode,
            allocation.AllocationStatus,
            allocation.IssueId);

    private bool CanOfferAutoThaw(PatientAllocationRowDto allocation) =>
        Session.Has(PermissionCodes.CompatibilityAllocate)
        && !string.IsNullOrEmpty(allocation.AutoThawProductCode)
        && allocation.IssueId is null
        && allocation.AllocationStatus == AllocationStatus.Reserved
        && allocation.UnitStatus is not UnitStatus.Issued
            and not UnitStatus.Transfused
            and not UnitStatus.TransfusionStarted
            and not UnitStatus.Discarded
            and not UnitStatus.Modified;

    private bool CanTypeUnitAntigens(PatientAllocationRowDto allocation) =>
        Session.Has(PermissionCodes.ResultEnter)
        && allocation.IssueId is null
        && allocation.AllocationStatus == AllocationStatus.Reserved
        && allocation.UnitStatus is UnitStatus.Assigned or UnitStatus.Allocated or UnitStatus.Crossmatched;

    private string UnitAntigenTypingHref(PatientAllocationRowDto allocation) =>
        $"/patients/{PatientId}/unit-antigen-typing/{allocation.BloodUnitId}?allocationId={allocation.AllocationId}";

    private string ModifyUnitHref(PatientAllocationRowDto allocation)
    {
        var returnUrl = Uri.EscapeDataString($"/patients/{PatientId}?tab=products");
        return $"/inventory/modify?unitId={allocation.BloodUnitId}&returnUrl={returnUrl}";
    }

    private static string DisplayAllocationStatus(ProductAllocationDisplayStatus status) => status switch
    {
        ProductAllocationDisplayStatus.ReadyForIssue => "Ready for Issue",
        ProductAllocationDisplayStatus.Exception => "Exception",
        ProductAllocationDisplayStatus.Reserved => "Reserved",
        _ => status.ToString()
    };

    private Task OnToggleIssued() => OnToggleIssuedTransfused.InvokeAsync();

    private static long? ParseLong(object? value) =>
        long.TryParse(value?.ToString(), out var id) ? id : null;
}
