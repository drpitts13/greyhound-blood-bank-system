@typeparam TItem
@typeparam TValue

<div class="bb-combobox @( _open ? "open" : null)" @onfocusout="OnFocusOutAsync">
    <input type="text"
           class="bb-combobox-input"
           value="@_inputText"
           placeholder="@Placeholder"
           autocomplete="off"
           @oninput="OnInput"
           @onfocus="Open" />
    @if (_open && (_showClearOption || Filtered.Any()))
    {
        <ul class="bb-combobox-menu" @onmousedown:preventDefault>
            @if (_showClearOption)
            {
                <li class="bb-combobox-item bb-combobox-clear" @onmousedown="ClearAsync">@ClearLabel</li>
            }
            @foreach (var item in Filtered)
            {
                <li class="bb-combobox-item" @onmousedown="() => SelectItemAsync(item)">@DisplayText(item)</li>
            }
            @if (!Filtered.Any() && !_showClearOption)
            {
                <li class="bb-combobox-item bb-combobox-empty">No matches</li>
            }
        </ul>
    }
</div>

@code {
    [Parameter] public TValue? Value { get; set; }
    [Parameter] public EventCallback<TValue?> ValueChanged { get; set; }
    [Parameter] public IEnumerable<TItem> Items { get; set; } = [];
    [Parameter] public Func<TItem, string> DisplayText { get; set; } = _ => string.Empty;
    [Parameter] public Func<TItem, TValue?> ItemValue { get; set; } = default!;
    [Parameter] public Func<TItem, string>? SearchText { get; set; }
    /// <summary>When true, the bound value follows typed text (for free-text fields such as provider location).</summary>
    [Parameter] public bool AllowCustom { get; set; }

    /// <summary>Text for a value whose item is not (yet) in <see cref="Items"/>. Defaults to the value itself.</summary>
    [Parameter] public Func<TValue, string>? UnresolvedText { get; set; }
    [Parameter] public bool Clearable { get; set; }
    [Parameter] public string ClearLabel { get; set; } = "—";
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public int MaxSuggestions { get; set; } = 40;

    private string _inputText = string.Empty;
    private bool _open;
    private bool _suppressSync;
    private TValue? _lastSyncedValue;
    private bool _resolved = true;

    private bool _showClearOption => Clearable;

    private IEnumerable<TItem> Filtered
    {
        get
        {
            var term = _inputText?.Trim() ?? string.Empty;
            IEnumerable<TItem> q = Items;
            if (!string.IsNullOrWhiteSpace(term))
            {
                q = q.Where(i => Matches(i, term));
            }

            return q.Take(MaxSuggestions);
        }
    }

    protected override void OnParametersSet()
    {
        var changed = !EqualityComparer<TValue?>.Default.Equals(Value, _lastSyncedValue);
        if (!ComboBoxDisplay.ShouldResolve(changed, _resolved))
        {
            return;
        }

        _lastSyncedValue = Value;
        if (_suppressSync)
        {
            return;
        }

        // A value set before its list loaded is resolved again on every render until its item appears.
        var display = ComboBoxDisplay.Resolve(Value, Items, ItemValue, DisplayText, UnresolvedText, AllowCustom && IsStringValue);
        _inputText = display.Text;
        _resolved = display.Resolved;
    }

    private bool Matches(TItem item, string term) =>
        (SearchText?.Invoke(item) ?? DisplayText(item))
            .Contains(term, StringComparison.OrdinalIgnoreCase);

    private void Open() => _open = true;

    private void OnInput(ChangeEventArgs e)
    {
        _inputText = e.Value?.ToString() ?? string.Empty;
        _resolved = true;
        _open = true;

        if (AllowCustom)
        {
            _ = CommitCustomAsync(_inputText);
        }
    }

    private async Task SelectItemAsync(TItem item)
    {
        _suppressSync = true;
        _inputText = DisplayText(item);
        _resolved = true;
        var value = ItemValue(item);
        _lastSyncedValue = value;
        await ValueChanged.InvokeAsync(value);
        _suppressSync = false;
        _open = false;
    }

    private async Task ClearAsync()
    {
        _suppressSync = true;
        _inputText = string.Empty;
        _resolved = true;
        _lastSyncedValue = default;
        await ValueChanged.InvokeAsync(default);
        _suppressSync = false;
        _open = false;
    }

    private async Task OnFocusOutAsync()
    {
        // No delay: menu items cancel mousedown so picking one never blurs the input, and
        // committing right away means a Save button clicked next sees the typed value.
        _open = false;
        await TryCommitTypedSelectionAsync();
    }

    private async Task TryCommitTypedSelectionAsync()
    {
        // Unresolved text came from code, not the user: never search with it, or it could pick a different item.
        if (!_resolved)
        {
            return;
        }

        if (AllowCustom)
        {
            // Text that is an item's display text means that item was picked: keep its value, not the label.
            var picked = Items.FirstOrDefault(i =>
                DisplayText(i).Equals(_inputText, StringComparison.OrdinalIgnoreCase));
            if (picked is not null)
            {
                await SelectItemAsync(picked);
                return;
            }

            await CommitCustomAsync(_inputText);
            return;
        }

        if (string.IsNullOrWhiteSpace(_inputText))
        {
            if (Clearable)
            {
                await ClearAsync();
            }

            return;
        }

        var exact = Items.FirstOrDefault(i =>
            DisplayText(i).Equals(_inputText, StringComparison.OrdinalIgnoreCase));
        if (exact is not null)
        {
            await SelectItemAsync(exact);
            return;
        }

        var partial = Items.Where(i => Matches(i, _inputText)).Take(2).ToList();
        if (partial.Count == 1)
        {
            await SelectItemAsync(partial[0]);
        }
    }

    private async Task CommitCustomAsync(string text)
    {
        if (!IsStringValue)
        {
            return;
        }

        var value = (TValue?)(object?)NullIfEmpty(text);
        _lastSyncedValue = value;
        await ValueChanged.InvokeAsync(value);
    }

    private bool IsStringValue =>
        typeof(TValue) == typeof(string) || Nullable.GetUnderlyingType(typeof(TValue)) == typeof(string);

    private static string? NullIfEmpty(string? s) => string.IsNullOrWhiteSpace(s) ? null : s.Trim();

    private static bool ValuesEqual(TValue? a, TValue? b) =>
        EqualityComparer<TValue?>.Default.Equals(a, b);
}
