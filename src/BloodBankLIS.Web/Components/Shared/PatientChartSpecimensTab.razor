@inject UserSession Session
@inject BloodBankApiClient Api

<div class="bb-card">
    <p class="muted" style="margin:0 0 .75rem;">For order-driven result entry, use the <strong>Tests</strong> tab.</p>
    <div class="bb-card-title">
        <h3>Specimens</h3>
        @if (Session.Has(PermissionCodes.SpecimenAccession))
        {
            <button class="btn btn-primary btn-sm" @onclick="OnToggleAccession">@(ShowAccession ? "Cancel" : "Accession specimen")</button>
        }
    </div>
    <Outcome Value="Feedback" />
    @if (OpenAbidWorkups.Any(w => w.SpecimenId is not null))
    {
        <div class="alert alert-warning">
            Open antibody-identification workup(s) are linked to a specimen. Rejecting that specimen withdraws interpretation and review; the workup remains the identification of record for the patient until it is voided or linked to a usable specimen.
            This does not identify antibodies or block reject.
            <a href="@AbidHref">Open antibody identification</a>.
        </div>
    }

    @if (ShowAccession)
    {
        <div class="alert alert-info">
            <Outcome Value="Feedback" />
            <div class="form-row">
                <div class="field"><label>Accession #</label><input @bind="Accession.AccessionNumber" /></div>
                <div class="field"><label>Specimen type</label>
                    <select @bind="Accession.SpecimenType" @bind:after="RefreshAccessionPreviewAsync">
                        @if (SpecimenTypes.Count == 0)
                        {
                            <option value="EDTA">EDTA — EDTA Whole Blood</option>
                        }
                        else
                        {
                            @foreach (var t in SpecimenTypes)
                            {
                                <option value="@t.Code">@t.Code — @t.Description</option>
                            }
                        }
                    </select>
                </div>
                <div class="field"><label>Collected (UTC)</label><input type="datetime-local" @bind="Accession.CollectedLocal" @bind:after="RefreshAccessionPreviewAsync" /></div>
                @if (AccessionPreviewExpires is { } preview)
                {
                    <div class="field"><label>Expires (preview)</label>
                        <input value="@preview.ToString("yyyy-MM-dd HH:mm")" disabled />
                        @if (_accessionPreview?.ShortenedForAlloimmunizationRisk == true)
                        {
                            <span class="sub">Shorter window: patient transfused or pregnant recently.</span>
                        }
                    </div>
                }
                <div class="field"><label>Validity hours (optional)</label><input type="number" @bind="Accession.ValidityHours" @bind:after="RefreshAccessionPreviewAsync" /></div>
                <div class="field"><label>Patient ID 1 (MRN) on the tube</label>
                    <input @bind="Accession.Identifier1Value" @bind:event="oninput" placeholder="Scan or type from the tube label" autocomplete="off" />
                    <IdentifierMatchHint Type="IdentityTokenType.MedicalRecordNumber" Value="@Accession.Identifier1Value" Patient="Patient" />
                </div>
                <div class="field"><label>Patient ID 2 (DOB yyyy-MM-dd) on the tube</label>
                    <input @bind="Accession.Identifier2Value" @bind:event="oninput" placeholder="From the tube label" autocomplete="off" />
                    <IdentifierMatchHint Type="IdentityTokenType.DateOfBirth" Value="@Accession.Identifier2Value" Patient="Patient" />
                </div>
                <div class="field"><label>Collected by@(CollectorRequired && Accession.AcceptImmediately ? " (required to accept)" : "")</label><input @bind="Accession.Collector" placeholder="Who drew the specimen" data-collector-required="@(CollectorRequired ? "true" : "false")" /></div>
                <div class="field"><label>Draw location</label><input @bind="Accession.DrawLocation" placeholder="Ward or unit" /></div>
            </div>
                <div class="field">
                    <label>Comment</label>
                    <CodedCommentField Page="CommentPage.Specimen" @bind-Value="Accession.Comment" />
                </div>
                <label class="flex gap" style="align-items:center;">
                    <input type="checkbox" @bind="Accession.AcceptImmediately" />
                    Accept now — specimen is already in the blood bank
                </label>
                <p class="muted" style="margin:.25rem 0 .75rem;">Leave unchecked to record collection only. Receive and accept from the pending-specimens worklist. Result entry still requires Accepted.</p>
                <button class="btn btn-primary" disabled="@Busy" @onclick="OnAccession">Accession</button>
        </div>
    }

    @if (Specimens.Count == 0)
    {
        <div class="empty">No specimens.</div>
    }
    else
    {
        <table class="bb">
            <thead><tr><th>Accession</th><th>Type</th><th>Collected</th><th>Expires</th><th>Status</th><th>Comment</th><th></th></tr></thead>
            <tbody>
                @foreach (var s in Specimens)
                {
                    <tr>
                        <td class="mono">@s.AccessionNumber</td>
                        <td>@(s.SpecimenTypeDescription ?? s.SpecimenType)</td>
                        <td class="nowrap">@s.CollectedUtc.ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="nowrap">@(s.ExpiresUtc?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                        <td><span class="@Ui.Badge(s.Status)">@s.Status</span></td>
                        <td>@(string.IsNullOrWhiteSpace(s.Comment) ? "—" : s.Comment)</td>
                        <td class="right nowrap">
                            <button class="btn btn-ghost btn-sm" @onclick="() => OnSelect.InvokeAsync(s)">@(SelectedId == s.Id ? "Hide" : "Results")</button>
                            <button class="btn btn-ghost btn-sm" @onclick="() => ToggleHistory(s.Id)">@(_historyId == s.Id ? "Hide history" : "History")</button>
                            @if (Session.Has(PermissionCodes.PrintLabel))
                            {
                                <a class="btn btn-ghost btn-sm" href="@($"/printing?specimenId={s.Id}")">Print label</a>
                            }
                            @if (s.Status == SpecimenStatus.Accepted && Session.Has(PermissionCodes.SpecimenEdit))
                            {
                                <button class="btn btn-ghost btn-sm" @onclick="() => OnBeginEdit.InvokeAsync(s)">@(EditId == s.Id ? "Cancel edit" : "Edit")</button>
                            }
                            @if ((s.Status is SpecimenStatus.Collected or SpecimenStatus.Received or SpecimenStatus.Accepted)
                                && Session.Has(PermissionCodes.SpecimenEdit))
                            {
                                <button class="btn btn-ghost btn-sm" @onclick="() => OnBeginRelabel.InvokeAsync(s)">@(RelabelId == s.Id ? "Cancel relabel" : "Relabel")</button>
                            }
                            @if (s.Status == SpecimenStatus.Collected && Session.Has(PermissionCodes.SpecimenAccession))
                            {
                                @if (ReceiveByScanOnly)
                                {
                                    <a class="btn btn-ghost btn-sm" href="/test-worklist?tab=specimens" title="Your facility requires receipt by scan">Scan to receive</a>
                                }
                                else
                                {
                                    <button class="btn btn-primary btn-sm" disabled="@Busy" @onclick="() => OnReceive.InvokeAsync(s.Id)">Receive</button>
                                }
                            }
                            @if (s.Status == SpecimenStatus.Received && Session.Has(PermissionCodes.SpecimenAccession))
                            {
                                <button class="btn btn-primary btn-sm" disabled="@Busy" @onclick="() => OnAccept.InvokeAsync(s.Id)">Accept</button>
                            }
                            @if (s.Status is SpecimenStatus.Collected or SpecimenStatus.Received or SpecimenStatus.Accepted
                                && Session.Has(PermissionCodes.SpecimenReject))
                            {
                                <button class="btn btn-ghost btn-sm" @onclick="() => OnBeginReject.InvokeAsync(s)">Reject</button>
                            }
                        </td>
                    </tr>
                    @if (EditId == s.Id)
                    {
                        <tr><td colspan="7">
                            <div class="alert alert-info" style="margin:0;">
                                <Outcome Value="EditFeedback" />
                                @if (OpenAbidWorkups.Any(w => w.SpecimenId == s.Id))
                                {
                                    <div class="alert alert-warning">
                                        This specimen has an open antibody-identification workup. Changing collection or expiration withdraws interpretation and review. Edit still succeeds.
                                    </div>
                                }
                                <div class="form-row">
                                    <div class="field"><label>Accession #</label><input value="@s.AccessionNumber" disabled /></div>
                                    <div class="field"><label>Specimen type</label><input value="@(s.SpecimenTypeDescription ?? s.SpecimenType)" disabled /></div>
                                    <div class="field"><label>Collected (UTC)</label><input type="datetime-local" @bind="Edit.CollectedLocal" @bind:after="OnCollectedChanged" /></div>
                                    <div class="field"><label>Barcode</label><input value="@(s.Barcode ?? "—")" disabled /><span class="muted">Use Relabel to change.</span></div>
                                    <div class="field"><label>Draw location</label><input @bind="Edit.DrawLocation" /></div>
                                    <div class="field"><label>Collector</label><input @bind="Edit.Collector" /></div>
                                    <div class="field"><label>Expires (UTC)</label><input type="datetime-local" @bind="Edit.ExpiresLocal" @bind:after="OnExpiresChanged" /></div>
                                </div>
                                <div class="field">
                                    <label>Comment</label>
                                    <CodedCommentField Page="CommentPage.Specimen" @bind-Value="Edit.Comment" />
                                </div>
                                @if (NeedsExpirationOverride)
                                {
                                    <div class="bb-card" style="background:#fff8f0;margin-top:.75rem;border:1px solid #e8c48a;">
                                        <strong>Exception: specimen expiration override</strong>
                                        <p class="muted">Changing expiration away from the policy-computed window requires an authorized override. The exception is recorded and cannot be removed.</p>
                                        @if (Session.SecurityLevel < ExceptionMinLevel)
                                        {
                                            <div class="alert alert-warning">Your security level (@Session.SecurityLevel) is below the minimum (@ExceptionMinLevel) required to override.</div>
                                        }
                                        else
                                        {
                                            <div class="form-row">
                                                <AuthorizerField @bind-Value="Edit.AuthorizedBy" />
                                                <div class="field" style="grid-column:1/-1;"><label>Override comment</label><input @bind="Edit.OverrideReason" /></div>
                                            </div>
                                        }
                                    </div>
                                }
                                <div class="flex gap">
                                    <button class="btn btn-primary btn-sm" disabled="@Busy" @onclick="() => OnSaveEdit.InvokeAsync(s.Id)">Save</button>
                                    <button class="btn btn-secondary btn-sm" @onclick="OnCancelEdit">Cancel</button>
                                </div>
                            </div>
                        </td></tr>
                    }
                    @if (RelabelId == s.Id)
                    {
                        <tr><td colspan="7">
                            <div class="alert alert-info" style="margin:0;">
                                <p class="muted" style="margin:0 0 .5rem;">Change the specimen barcode. Accession number stays the same. A reason is required and is audited.</p>
                                <div class="form-row">
                                    <div class="field"><label>Current barcode</label><input value="@(s.Barcode ?? "—")" disabled /></div>
                                    <div class="field"><label>New barcode</label><input @bind="RelabelBarcode" @bind:event="oninput" @bind:after="() => RelabelBarcodeChanged.InvokeAsync(RelabelBarcode)" /></div>
                                    <div class="field" style="grid-column:1/-1;"><label>Reason</label><input @bind="RelabelReason" @bind:event="oninput" @bind:after="() => RelabelReasonChanged.InvokeAsync(RelabelReason)" /></div>
                                </div>
                                <div class="flex gap">
                                    <button class="btn btn-primary btn-sm" disabled="@(Busy || string.IsNullOrWhiteSpace(RelabelBarcode) || string.IsNullOrWhiteSpace(RelabelReason))" @onclick="() => OnRelabel.InvokeAsync(s.Id)">Save relabel</button>
                                    <button class="btn btn-secondary btn-sm" @onclick="OnCancelRelabel">Cancel</button>
                                </div>
                            </div>
                        </td></tr>
                    }
                    @if (RejectId == s.Id)
                    {
                        <tr><td colspan="7">
                            <div class="flex gap" style="flex-wrap:wrap;">
                                @if (OpenAbidWorkups.Any(w => w.SpecimenId == s.Id))
                                {
                                    <div class="alert alert-warning" style="flex:1 1 100%;margin:0;">
                                        This specimen has an open antibody-identification workup. Reject still succeeds. Interpretation is withdrawn; void the workup or link a usable specimen before a new identification can post.
                                    </div>
                                }
                                <SpecimenRejectReasonPicker Code="@RejectReason" CodeChanged="v => RejectReasonChanged.InvokeAsync(v)"
                                                            Comment="@RejectComment" CommentChanged="v => RejectCommentChanged.InvokeAsync(v)" />
                                <button class="btn btn-danger btn-sm" disabled="@(Busy || string.IsNullOrWhiteSpace(RejectReason))" @onclick="() => OnReject.InvokeAsync(s.Id)">Confirm reject</button>
                                <button class="btn btn-secondary btn-sm" @onclick="OnCancelReject">Cancel</button>
                            </div>
                        </td></tr>
                    }
                    @if (_historyId == s.Id)
                    {
                        <tr><td colspan="7">
                            <SpecimenTimelinePanel SpecimenId="s.Id" Accession="@s.AccessionNumber" OnClose="() => _historyId = null" />
                        </td></tr>
                    }
                    @if (SelectedId == s.Id)
                    {
                        <tr><td colspan="7">
                            @if (SpecimenWorklist.Count > 0)
                            {
                                <div style="margin-bottom:.75rem;">
                                    <strong>Tests from linked orders</strong>
                                    <table class="bb" style="margin-top:.35rem;">
                                        <thead><tr><th>Test</th><th>Order #</th><th>Status</th><th>Source</th></tr></thead>
                                        <tbody>
                                            @foreach (var item in SpecimenWorklist)
                                            {
                                                <tr>
                                                    <td>@item.TestName <span class="mono muted">@item.TestCode</span></td>
                                                    <td class="mono">@item.OrderNumber</td>
                                                    <td>@(item.CurrentResultStatus?.ToString() ?? (item.CanEnterResults ? "Pending" : item.BlockReason ?? "Blocked"))</td>
                                                    <td>@(item.CurrentResultSource?.ToString() ?? "—")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                    <p class="muted" style="margin:.35rem 0 0;font-size:.85rem;">Enter results on the <strong>Tests</strong> tab after linking.</p>
                                </div>
                            }
                            else
                            {
                                <p class="muted" style="margin:0 0 .5rem;">No tests from linked orders. Tests appear on this specimen after it is linked to an order.</p>
                                <button type="button" class="btn btn-secondary btn-sm" @onclick="OnOpenOrders">Open Orders to accession or link</button>
                            }
                            @if (ResultDetail is not null)
                            {
                                @ResultDetail(s)
                            }
                        </td></tr>
                    }
                }
            </tbody>
        </table>
    }
</div>

@code {
    // The chart patient, for the live match hint under the tube-label identifiers.
    [Parameter] public PatientDto? Patient { get; set; }

    /// <summary>A specimen whose history opens when the tab opens (a scanned accession in the find box).</summary>
    [Parameter] public long? OpenHistoryId { get; set; }

    private long? _historyId;
    private long? _appliedOpenHistoryId;

    protected override void OnParametersSet()
    {
        if (OpenHistoryId != _appliedOpenHistoryId)
        {
            _appliedOpenHistoryId = OpenHistoryId;
            if (OpenHistoryId is long id)
            {
                _historyId = id;
            }
        }
    }

    private void ToggleHistory(long specimenId) => _historyId = _historyId == specimenId ? null : specimenId;

    [Parameter] public bool ShowAccession { get; set; }
    // Facility policy Specimen.RequireCollector: a tube is accepted only with its collector recorded.
    [Parameter] public bool CollectorRequired { get; set; }
    [Parameter] public Feedback? Feedback { get; set; }
    [Parameter] public Feedback? EditFeedback { get; set; }
    [Parameter] public PatientAccessionForm Accession { get; set; } = new();
    [Parameter] public PatientSpecimenEditForm Edit { get; set; } = new();
    [Parameter] public IReadOnlyList<SpecimenTypeListItemDto> SpecimenTypes { get; set; } = [];
    [Parameter] public IReadOnlyList<SpecimenDto> Specimens { get; set; } = [];
    [Parameter] public long? SelectedId { get; set; }
    [Parameter] public long? EditId { get; set; }
    [Parameter] public long? RelabelId { get; set; }
    [Parameter] public string RelabelBarcode { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> RelabelBarcodeChanged { get; set; }
    [Parameter] public string RelabelReason { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> RelabelReasonChanged { get; set; }
    [Parameter] public long? RejectId { get; set; }
    [Parameter] public string RejectReason { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> RejectReasonChanged { get; set; }
    [Parameter] public string RejectComment { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> RejectCommentChanged { get; set; }
    [Parameter] public IReadOnlyList<TestWorkItemDto> SpecimenWorklist { get; set; } = [];
    [Parameter] public IReadOnlyList<AntibodyIdWorkupListItemDto> OpenAbidWorkups { get; set; } = [];
    [Parameter] public string AbidHref { get; set; } = "/antibody-id";
    [Parameter] public bool Busy { get; set; }
    [Parameter] public RenderFragment<SpecimenDto>? ResultDetail { get; set; }
    [Parameter] public EventCallback OnToggleAccession { get; set; }
    [Parameter] public EventCallback OnAccession { get; set; }
    [Parameter] public EventCallback<SpecimenDto> OnSelect { get; set; }
    [Parameter] public EventCallback<SpecimenDto> OnBeginEdit { get; set; }
    [Parameter] public EventCallback<SpecimenDto> OnBeginRelabel { get; set; }
    [Parameter] public EventCallback<SpecimenDto> OnBeginReject { get; set; }
    [Parameter] public EventCallback<long> OnSaveEdit { get; set; }
    [Parameter] public EventCallback OnCancelEdit { get; set; }
    [Parameter] public EventCallback<long> OnRelabel { get; set; }
    [Parameter] public EventCallback OnCancelRelabel { get; set; }
    [Parameter] public EventCallback<long> OnReject { get; set; }
    [Parameter] public EventCallback OnCancelReject { get; set; }
    [Parameter] public EventCallback<long> OnReceive { get; set; }
    /// <summary>OCD-056: the facility requires receipt by scanning the tube, so the row offers no Receive button.</summary>
    [Parameter] public bool ReceiveByScanOnly { get; set; }
    [Parameter] public EventCallback<long> OnAccept { get; set; }
    [Parameter] public EventCallback OnOpenOrders { get; set; }
    [Parameter] public int ExceptionMinLevel { get; set; } = 2;

    // The server's policy for this patient, as accession will compute it; the catalog value only while it loads or if it fails.
    private SpecimenExpirationPreviewDto? _accessionPreview;
    private (string? Type, DateTime Collected, int? Hours)? _accessionPreviewKey;

    private DateTime? AccessionPreviewExpires =>
        _accessionPreview?.PolicyExpiresUtc
        ?? SpecimenTypeOrderHint.PreviewExpiresUtc(Accession.CollectedLocal, Accession.SpecimenType, SpecimenTypes);

    protected override async Task OnParametersSetAsync()
    {
        if (ShowAccession)
        {
            await RefreshAccessionPreviewAsync();
        }
    }

    private async Task RefreshAccessionPreviewAsync()
    {
        var key = (Accession.SpecimenType, Accession.CollectedLocal, Accession.ValidityHours);
        if (Patient is null || _accessionPreviewKey == key)
        {
            return;
        }

        _accessionPreviewKey = key;
        var r = await Api.PreviewSpecimenExpirationAsync(Patient.Id, Accession.SpecimenType, Accession.CollectedLocal, validityHours: Accession.ValidityHours);
        _accessionPreview = r.Succeeded ? r.Value : null;
    }

    private bool NeedsExpirationOverride =>
        SpecimenExpirationOverrideRule.Evaluate(
            Edit.PolicyExpires,
            Edit.ExpiresLocal,
            overrideAuthorized: false).Severity == RuleSeverity.Warning;

    private async Task OnCollectedChanged()
    {
        // The server's policy for this patient (a recently transfused or pregnant patient gets the shorter window).
        DateTime? server = null;
        if (Patient is not null)
        {
            var r = await Api.PreviewSpecimenExpirationAsync(Patient.Id, Edit.SpecimenType, Edit.CollectedLocal);
            server = r.Succeeded ? r.Value?.PolicyExpiresUtc : null;
        }

        var preview = server
            ?? SpecimenTypeOrderHint.PreviewExpiresUtc(Edit.CollectedLocal, Edit.SpecimenType, SpecimenTypes)
            ?? Edit.CollectedLocal.AddHours(Edit.PolicyHours);
        Edit.PolicyExpires = preview;
        if (!Edit.ExpiryTouched)
        {
            Edit.ExpiresLocal = preview;
        }
    }

    private void OnExpiresChanged() => Edit.ExpiryTouched = true;
}
