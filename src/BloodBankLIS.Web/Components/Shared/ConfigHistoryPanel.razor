@* Configuration change history with old/new JSON comparison. *@
@inject BloodBankApiClient Api

<div class="bb-card" style="margin-top:1rem;">
    <div class="bb-card-title">
        <h3>@Title</h3>
        <button class="btn btn-ghost btn-sm" @onclick="OnClose">Close</button>
    </div>

    <Outcome Value="_feedback" />

    @if (_loading)
    {
        <div class="loading">Loading history...</div>
    }
    else if (DisplayRows.Count == 0)
    {
        <div class="empty">No change history recorded.</div>
    }
    else
    {
        <table class="bb">
            <thead>
                <tr><th>When (UTC)</th><th>Action</th><th>Entity</th><th>Id</th><th>Ver</th><th>By</th><th>Env</th><th>Reason</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var h in DisplayRows)
                {
                    <tr>
                        <td class="nowrap">@h.ChangedUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td>@h.Action</td>
                        <td class="mono">@h.EntityType</td>
                        <td class="mono">@(h.EntityId is null ? "—" : $"#{h.EntityId}")</td>
                        <td>@h.Version</td>
                        <td class="mono">@h.ChangedBy</td>
                        <td>
                            @h.Environment
                            @if (h.IsDevMode) { <span class="badge badge-amber">dev</span> }
                        </td>
                        <td>@h.ChangeReason</td>
                        <td class="right nowrap">
                            @if (AdminHref(h.EntityType) is string href)
                            {
                                <a class="btn btn-ghost btn-sm" href="@href">@AdminHopLabel(h.EntityType)</a>
                            }
                            <button class="btn btn-ghost btn-sm" @onclick="() => Toggle(h.Id)">@(_open == h.Id ? "Hide" : "Compare")</button>
                        </td>
                    </tr>
                    @if (_open == h.Id)
                    {
                        <tr>
                            <td colspan="9">
                                <div class="form-row">
                                    <div>
                                        <div class="muted" style="font-size:.78rem;margin-bottom:.3rem;">Previous</div>
                                        <pre class="pre diff-old">@Pretty(h.OldValueJson)</pre>
                                    </div>
                                    <div>
                                        <div class="muted" style="font-size:.78rem;margin-bottom:.3rem;">New</div>
                                        <pre class="pre diff-new">@Pretty(h.NewValueJson)</pre>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    }
</div>

@code {
    [Parameter] public string Title { get; set; } = "History";
    [Parameter] public IReadOnlyList<ConfigHistoryDto>? Rows { get; set; }
    [Parameter] public string? EntityType { get; set; }
    [Parameter] public long? EntityId { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private List<ConfigHistoryDto> _loaded = new();
    private bool _loading;
    private Feedback? _feedback;
    private long? _open;
    private string? _loadedKey;

    private IReadOnlyList<ConfigHistoryDto> DisplayRows => Rows ?? _loaded;

    protected override Task OnParametersSetAsync()
    {
        if (Rows is not null)
        {
            return Task.CompletedTask;
        }

        if (string.IsNullOrWhiteSpace(EntityType) || EntityId is not long entityId)
        {
            return Task.CompletedTask;
        }

        var key = $"{EntityType}:{entityId}";
        if (_loadedKey == key)
        {
            return Task.CompletedTask;
        }

        _loadedKey = key;
        return LoadAsync(EntityType, entityId);
    }

    private async Task LoadAsync(string entityType, long entityId)
    {
        _loading = true;
        var r = await Api.GetConfigHistoryAsync(entityType, entityId, max: 100);
        _loaded = r.Value ?? new();
        _feedback = r.Succeeded ? null : r.ToFeedback();
        _loading = false;
    }

    private void Toggle(long id) => _open = _open == id ? null : id;

    private static string? AdminHref(string? entityType) => entityType switch
    {
        "TestDefinition" => "/admin/tests",
        "ProductType" => "/admin/products",
        "InterfaceEndpoint" => "/admin/hl7",
        "InterfaceValueTranslation" => "/admin/hl7/translations",
        "User" => "/admin/users",
        "Role" => "/admin/roles",
        "SpecialRequirementDefinition" => "/admin/special-requirements",
        "SpecimenTypeDefinition" => "/admin/specimen-types",
        "BloodAttributeDefinition" => "/admin/blood-attributes",
        "ModificationRule" => "/admin/modification-rules",
        "ExpirationModificationCode" => "/admin/expiration-codes",
        "PhaseDefinition" => "/admin/phases",
        "RuleDefinition" => "/admin/rules",
        "SubtestDefinition" => "/admin/subtests",
        "TestGrouper" => "/admin/test-groupers",
        "ReflexRule" => "/admin/reflex-rules",
        "ChargeRule" => "/admin/charge-rules",
        "ChargeCode" => "/admin/charge-codes",
        "ProductBilling" => "/admin/product-billing",
        "TestServiceBilling" => "/admin/test-service-billing",
        "InventoryLocation" => "/admin/inventory-locations",
        "SystemSetting" => "/admin/facility-policies",
        "CrossmatchSettings" => "/admin/crossmatch-settings",
        "AntibodyPanelLot" => "/admin/antibody-panel-lots",
        "AntibodyPanelManufacturer" => "/admin/antibody-panel-lots",
        "OrderingProvider" => "/admin/providers",
        "OrderingLocation" => "/admin/locations",
        "CompatibilityRule" => "/admin/compatibility-rules",
        "CompatibilityRuleVersion" => "/admin/compatibility-rules",
        "ExceptionDefinition" => "/admin/exceptions",
        "CodedCommentDefinition" => "/admin/coded-comments",
        _ => null
    };

    private static string AdminHopLabel(string entityType) => entityType switch
    {
        "TestDefinition" => "Open Tests",
        "ProductType" => "Open Products",
        "InterfaceEndpoint" => "Open Interface Setup",
        "InterfaceValueTranslation" => "Open Translations",
        "User" => "Open Users",
        "Role" => "Open Roles",
        "SpecialRequirementDefinition" => "Open Special Requirements",
        "SpecimenTypeDefinition" => "Open Specimen Types",
        "BloodAttributeDefinition" => "Open Blood Attributes",
        "ModificationRule" => "Open Modification Rules",
        "ExpirationModificationCode" => "Open Expiration Codes",
        "PhaseDefinition" => "Open Phases",
        "RuleDefinition" => "Open Order & Test Rules",
        "SubtestDefinition" => "Open Subtests",
        "TestGrouper" => "Open Test Groupers",
        "ReflexRule" => "Open Reflex Rules",
        "ChargeRule" => "Open Charge Rules",
        "ChargeCode" => "Open Charge Codes",
        "ProductBilling" => "Open Product Billing",
        "TestServiceBilling" => "Open Test/Service Billing",
        "InventoryLocation" => "Open Inventory Locations",
        "SystemSetting" => "Open Facility Policy",
        "CrossmatchSettings" => "Open Crossmatch Settings",
        "AntibodyPanelLot" => "Open Antibody Panel Lots",
        "AntibodyPanelManufacturer" => "Open Antibody Panel Lots",
        "OrderingProvider" => "Open Ordering Providers",
        "OrderingLocation" => "Open Ordering Locations",
        "CompatibilityRule" => "Open Compatibility Tables",
        "CompatibilityRuleVersion" => "Open Compatibility Tables",
        "ExceptionDefinition" => "Open Exceptions",
        "CodedCommentDefinition" => "Open Coded Comments",
        _ => "Open"
    };

    private static string Pretty(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) return "(none)";
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            return System.Text.Json.JsonSerializer.Serialize(doc.RootElement, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        }
        catch
        {
            return json;
        }
    }
}
