<nav class="workflow-ribbon" aria-label="Patient transfusion workflow">
    <span class="workflow-ribbon-label">Workflow</span>
    @{
        var last = Steps.Count - 1;
    }
    @for (var i = 0; i < Steps.Count; i++)
    {
        var step = Steps[i];
        <button type="button"
                class="workflow-step @(step.Complete ? "done" : null) @(step.Current ? "current" : null)"
                @onclick="() => OnStepSelected.InvokeAsync(step.Key)"
                title="@step.Detail">
            <span class="n">@step.Number</span>@step.Label
        </button>
        @if (i < last)
        {
            <span class="workflow-arrow" aria-hidden="true">→</span>
        }
    }
</nav>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<PatientWorkflowStep> Steps { get; set; } = [];
    [Parameter] public EventCallback<string> OnStepSelected { get; set; }
}
