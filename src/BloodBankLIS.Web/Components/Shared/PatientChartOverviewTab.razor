@inject UserSession Session

<div class="bb-grid cols-2">
    <div class="bb-card">
        <div class="bb-card-title"><h3>Electronic crossmatch eligibility</h3></div>
        <p class="muted">AABB 5.16 computer XM checklist (SafeTrace / SoftBank). Serologic XM is required when any item fails.</p>
        @if (Exm is null)
        {
            <div class="empty">Eligibility could not be loaded.</div>
        }
        else
        {
            <p>
                <span class="badge @(Exm.Eligible ? "badge-green" : "badge-amber")">@(Exm.Eligible ? "Eligible" : "Not eligible")</span>
                @if (ElectronicCrossmatchBanner.Notice(Exm.Eligible, Exm.BlockingReason) is string exmNotice)
                {
                    <span class="muted"> @exmNotice</span>
                }
                @if (OpenAbidWorkups.Count > 0)
                {
                    <div class="alert alert-warning" style="margin-top:.75rem;">
                        Open antibody-identification workup(s) block electronic XM. Serologic crossmatch remains available and warns (`ABID-XM-OPEN`). Use serologic crossmatch, or
                        <a href="@AbidHref">open antibody identification</a>.
                    </div>
                }
            </p>
            <div class="table-scroll">
            <table class="bb">
                <thead><tr><th>Criterion</th><th>Status</th></tr></thead>
                <tbody>
                    @foreach (var c in Exm.Criteria)
                    {
                        <tr>
                            <td>
                                <strong>@c.Label</strong>
                                <div class="muted">@c.Detail</div>
                            </td>
                            <td>
                                <span class="badge @(c.Satisfied ? "badge-green" : "badge-red")">@(c.Satisfied ? "Met" : "Not met")</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
            @if (Session.Has(PermissionCodes.CompatibilityCrossmatch))
            {
                <div class="flex gap" style="margin-top:.85rem;">
                    <a class="btn btn-primary btn-sm" href="@CompatibilityHref">Record crossmatch</a>
                </div>
            }
        }
    </div>

    <div class="bb-card">
        <div class="bb-card-title"><h3>Blood type history</h3></div>
        @if (TypeHistory.Count == 0)
        {
            <div class="empty">No blood type on record.</div>
        }
        else
        {
            <div class="table-scroll">
            <table class="bb">
                <thead><tr><th>Type</th><th>Subgroup</th><th>Source</th><th>Recorded</th></tr></thead>
                <tbody>
                    @foreach (var t in TypeHistory)
                    {
                        <tr class="@(t.Invalidated ? "row-muted" : "")">
                            <td>
                                <strong style="@(t.Invalidated ? "text-decoration:line-through;" : "")">@Ui.BloodType(t.Abo, t.RhD)</strong>
                                @if (t.IsCurrent) { <span class="sub">Current</span> }
                                @if (t.Invalidated) { <span class="badge badge-red">Retired</span> }
                            </td>
                            <td>@t.AboSubgroup</td>
                            <td>
                                @(t.SourceLabel ?? t.Source.ToString())
                                @if (t.Invalidated && !string.IsNullOrWhiteSpace(t.Reason)) { <span class="sub">@t.Reason</span> }
                                @if (!t.CountsAsDetermination && !t.Invalidated) { <span class="sub">Does not count as an ABO/Rh determination</span> }
                            </td>
                            <td>@t.RecordedUtc.ToString("yyyy-MM-dd HH:mm")<span class="sub">@t.RecordedBy</span></td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        }

        @if (Session.Has(PermissionCodes.ImmunoOverride))
        {
            <hr style="margin:1rem 0;border:none;border-top:1px solid var(--bb-border);" />
            <h4>Record manual ABO/Rh <span class="badge badge-red">dangerous</span></h4>
            @if (OpenAbidWorkups.Count > 0)
            {
                <div class="alert alert-warning">
                    Open antibody-identification workup(s). Changing ABO/Rh withdraws interpretation and review so they can be repeated against the current type.
                    This does not identify antibodies.
                    <a href="@AbidHref">Open antibody identification</a>.
                </div>
            }
            else if (HasCompletedUnscopedAbid)
            {
                <div class="alert alert-warning">
                    A completed unscoped antibody-identification workup is the identification of record. Changing ABO/Rh does not reopen it or retract posted history.
                    This does not identify antibodies.
                    <a href="@AbidHref">Open antibody identification</a>.
                </div>
            }
            <Outcome Value="TypeFeedback" />
            <div class="form-row">
                <div class="field"><label>ABO</label>
                    <select @bind="TypeAbo" @bind:after="() => TypeAboChanged.InvokeAsync(TypeAbo)">@foreach (var a in Enum.GetValues<AboGroup>()) { <option value="@a">@a</option> }</select>
                </div>
                <div class="field"><label>Rh(D)</label>
                    <select @bind="TypeRh" @bind:after="() => TypeRhChanged.InvokeAsync(TypeRh)">@foreach (var r in Enum.GetValues<RhType>()) { <option value="@r">@r</option> }</select>
                </div>
                @if (TypeAbo is AboGroup.A or AboGroup.AB)
                {
                    <div class="field"><label>A1/A2 subgroup</label>
                        <select @bind="TypeSubgroup" @bind:after="() => TypeSubgroupChanged.InvokeAsync(TypeSubgroup)">
                            <option value="@AboSubgroup.Unknown">Unknown</option>
                            <option value="@AboSubgroup.A1">A1</option>
                            <option value="@AboSubgroup.A2">A2</option>
                        </select>
                    </div>
                }
            </div>
            <div class="field"><label>Reason (required)</label><input @bind="TypeReason" @bind:after="() => TypeReasonChanged.InvokeAsync(TypeReason)" /></div>
            <div class="form-row">
                <div class="field"><label>Documented source</label>
                    <select @bind="TypeDocumentation" @bind:after="() => TypeDocumentationChanged.InvokeAsync(TypeDocumentation)">
                        <option value="@ManualTypeDocumentation.NotDocumented">Not documented</option>
                        <option value="@ManualTypeDocumentation.PreviousBloodBankSystem">Previous blood bank system</option>
                        <option value="@ManualTypeDocumentation.OutsideSource">Documented outside source</option>
                    </select>
                </div>
                @if (TypeDocumentation != ManualTypeDocumentation.NotDocumented)
                {
                    <div class="field" style="flex:1;"><label>Record or report (required)</label>
                        <input @bind="TypeDocumentationReference" @bind:after="() => TypeDocumentationReferenceChanged.InvokeAsync(TypeDocumentationReference)" placeholder="e.g. legacy LIS record, or outside lab, date, report number" />
                    </div>
                }
            </div>
            <p class="muted">Only a type documented from a previous blood bank system or an outside source counts as one of the two ABO/Rh determinations needed for red-cell issue. An undocumented type is recorded but does not count.</p>
            <button class="btn btn-danger" disabled="@Busy" @onclick="OnRecordType">Record blood type</button>
        }
    </div>

    <div class="bb-card">
        <div class="bb-card-title"><h3>Special transfusion requirements</h3></div>
        <p class="muted">Computer-evaluated at issue. Operators cannot checkbox these away.</p>
        @if (OpenAbidWorkups.Count > 0)
        {
            <div class="alert alert-warning">
                Open antibody-identification workup(s). Antigen-negative needs may change when the workup completes.
                Adding or deactivating a special requirement still records. This does not identify antibodies.
                <a href="@AbidHref">Open antibody identification</a>.
            </div>
        }
        <Outcome Value="SrFeedback" />
        @if (SpecialRequirements.Count == 0)
        {
            <div class="empty">No special requirements on record.</div>
        }
        else
        {
            @* This card is a narrow column on the Overview, so each requirement is a short block rather than a wide table row:
               the name and antigen, then type and dates, then the reason, with End date on its own line underneath. *@
            <div class="sr-list">
                @foreach (var r in SpecialRequirements)
                {
                    <div class="sr-item" data-sr-item>
                        <div class="sr-item-head">
                            <strong>@SpecialRequirementLabel.Display(r.Name ?? r.Code, r.RequirementType, r.AntigenCode)</strong>
                            <span class="badge @(r.IsClinicallyActive ? "badge-green" : "badge-gray")">@(r.IsClinicallyActive ? "Active" : "Not active")</span>
                        </div>
                        <span class="sub">
                            @(r.CategoryLabel is { Length: > 0 } category ? category : r.Level?.ToString())
                            · from @LocalDate(r.EffectiveUtc)@(r.ExpiresUtc is { } endUtc ? $" to {LocalDate(endUtc)}" : "")
                        </span>
                        <span class="sub">@r.Reason</span>
                        @if (r.ReactionInvestigationId is long fromReaction)
                        {
                            <span class="sub"><a href="/reactions">From reaction investigation @fromReaction</a></span>
                        }
                        @if (r.IsClinicallyActive && Session.Has(PermissionCodes.ImmunoOverride))
                        {
                            <button class="btn btn-ghost btn-sm" @onclick="() => OnBeginDeactivateSr.InvokeAsync(r)" data-sr-end-date>End date</button>
                        }
                    </div>
                }
            </div>
        }
        @if (SrDeactivateId is not null)
        {
            <div class="alert alert-warning">
                <div class="field"><label>Reason to deactivate</label><input @bind="SrDeactivateReason" @bind:after="() => SrDeactivateReasonChanged.InvokeAsync(SrDeactivateReason)" /></div>
                <button class="btn btn-danger btn-sm" disabled="@Busy" @onclick="OnConfirmSrDeactivate">Confirm</button>
                <button class="btn btn-secondary btn-sm" @onclick="OnCancelSrDeactivate">Cancel</button>
            </div>
        }
        @if (Session.Has(PermissionCodes.ImmunoRecord))
        {
            <hr style="margin:1rem 0;border:none;border-top:1px solid var(--bb-border);" />
            <h4>Add requirement</h4>
            <div class="form-row">
                <div class="field"><label>Requirement</label>
                    <select @bind="SrDefinitionId" @bind:after="() => SrDefinitionIdChanged.InvokeAsync(SrDefinitionId)">
                        @foreach (var group in SrCatalog.GroupBy(d => d.Category).OrderBy(g => g.Key))
                        {
                            <optgroup label="@SpecialRequirementLabel.Category(group.Key)">
                                @foreach (var d in group)
                                {
                                    <option value="@d.Id">@d.ChoiceLabel</option>
                                }
                            </optgroup>
                        }
                    </select>
                </div>
                @if (SelectedSrDefinition is { EnforcementKind: SpecialRequirementEnforcementKind.RequireAntigenNegative } antigenDef
                     && string.IsNullOrWhiteSpace(antigenDef.AntigenCode))
                {
                    <div class="field"><label>Antigen code</label><input @bind="SrAntigen" @bind:after="() => SrAntigenChanged.InvokeAsync(SrAntigen)" placeholder="Required for antigen-negative" /></div>
                }
                <div class="field"><label>Start date</label><input type="date" @bind="SrStartDate" @bind:after="() => SrStartDateChanged.InvokeAsync(SrStartDate)" /></div>
                <div class="field"><label>End date (optional)</label><input type="date" @bind="SrEndDate" @bind:after="() => SrEndDateChanged.InvokeAsync(SrEndDate)" /></div>
                @if (SelectedSrDefinition?.Category == SpecialRequirementCategory.Informational)
                {
                    <div class="muted" style="grid-column:1/-1;">Shown as a banner on the chart and the issue desk: @SelectedSrDefinition.Instruction. Not enforced.</div>
                }
                else if (SelectedSrDefinition is { } chosen && chosen.Category is SpecialRequirementCategory.UnitTyping or SpecialRequirementCategory.UnitModification)
                {
                    <div class="muted" style="grid-column:1/-1;">Enforced for @(SpecialRequirementLabel.UnitCategory(chosen.Category, chosen.ComponentClass).ToLowerInvariant() is "all categories" ? "every unit" : SpecialRequirementLabel.UnitCategory(chosen.Category, chosen.ComponentClass) + " units") at selection and issue. Applies from the start date; no longer applies on and after the end date.</div>
                }
                <div class="field" style="grid-column:1/-1;"><label>Reason</label><input @bind="SrReason" @bind:after="() => SrReasonChanged.InvokeAsync(SrReason)" /></div>
            </div>
            <button class="btn btn-primary" disabled="@Busy" @onclick="OnAddSr">Add</button>
        }
        @if (Session.Has(PermissionCodes.PatientWrite))
        {
            <hr style="margin:1rem 0;border:none;border-top:1px solid var(--bb-border);" />
            <h4>Recent pregnancy (specimen window)</h4>
            <p class="muted">When documented, accepted specimens use the 3-day alloimmunization-risk window.</p>
            <div class="muted">Current: @(RecentPregnancyUtc?.ToString("yyyy-MM-dd") ?? "not documented")</div>
            <button class="btn btn-secondary btn-sm" disabled="@Busy" @onclick="OnMarkPregnancy">Document pregnancy in last 3 months</button>
        }
    </div>

    <div class="bb-card">
        <div class="bb-card-title">
            <h3>Antibodies</h3>
            @if (Session.Has(PermissionCodes.ImmunoRecord) || Session.Has(PermissionCodes.ImmunoOverride))
            {
                <a class="btn btn-secondary btn-sm" href="@AbidHref">Antibody identification</a>
            }
        </div>
        <Outcome Value="AntibodyFeedback" />
        @if (OpenAbidWorkups.Count > 0)
        {
            <div class="alert alert-warning">
                <p>
                    @OpenAbidWorkups.Count open antibody-identification workup(s).
                    Assistance does not identify antibodies.
                    An unscoped open workup is the identification of record for this patient.
                </p>
                <ul>
                    @foreach (var w in OpenAbidWorkups)
                    {
                        <li>
                            @AbidNextLabel(w)
                            ·
                            @if (string.IsNullOrWhiteSpace(w.SpecimenAccession))
                            {
                                <span>Unscoped</span>
                            }
                            else
                            {
                                <span class="mono">@w.SpecimenAccession</span>
                            }
                            @if (w.HasUnusableSpecimen)
                            {
                                <span class="badge badge-red">Rejected/cancelled</span>
                            }
                            else if (w.HasNotReadySpecimen)
                            {
                                <span class="badge badge-red">Not received</span>
                            }
                            else if (w.HasUnacceptedSpecimen)
                            {
                                <span class="badge badge-blue">Not accepted</span>
                            }
                            else if (w.HasExpiredSpecimen)
                            {
                                <span class="badge badge-amber">Expired specimen</span>
                            }
                            @foreach (var lot in w.InactiveLotNumbers ?? [])
                            {
                                <span class="badge badge-red">Inactive @lot</span>
                            }
                            @foreach (var lot in w.ExpiredLotNumbers ?? [])
                            {
                                <span class="badge badge-amber">Expired @lot</span>
                            }
                            @if (w.HasWithdrawnJudgment)
                            {
                                <span class="badge badge-amber">Judgment withdrawn</span>
                            }
                            @if (w.HasPendingTypeCorrection)
                            {
                                <span class="badge badge-red">Pending type correction</span>
                            }
                            @if (w.HasReservedOrIssuedUnits)
                            {
                                <span class="badge badge-amber">Reserved/issued units</span>
                            }
                            <a class="btn btn-ghost btn-sm" href="@($"/patients/{PatientId}/antibody-id/{w.Id}")">Open</a>
                        </li>
                    }
                </ul>
            </div>
        }
        @if (AntibodyHistory.Count == 0)
        {
            <div class="empty">No antibodies on record.</div>
        }
        else
        {
            <div class="table-scroll">
            <table class="bb">
                <thead><tr><th>Specificity</th><th>Status</th><th>Source</th><th>Active</th><th></th></tr></thead>
                <tbody>
                    @foreach (var a in AntibodyHistory)
                    {
                        <tr>
                            <td><strong>@a.AntibodySpecificity</strong></td>
                            <td>@a.Status</td>
                            <td>
                                @if (a.SourceLabel is { } source)
                                {
                                    <span class="badge badge-blue" data-antibody-outside>Outside report</span> <span class="sub">@source</span>
                                }
                                else
                                {
                                    <span class="sub">@(a.PostedByCompletedWorkup ? "Antibody ID here" : "Recorded here")</span>
                                }
                            </td>
                            <td>@(a.IsActive ? "Yes" : "No")</td>
                            <td class="right">
                                @if (a.IsActive && Session.Has(PermissionCodes.ImmunoOverride) && OpenAbidWorkups.Count == 0)
                                {
                                    <button class="btn btn-ghost btn-sm" @onclick="() => OnBeginDeactivateAb.InvokeAsync(a)">Deactivate</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        }

        @if (DeactivateId is not null && OpenAbidWorkups.Count == 0)
        {
            <div class="alert alert-warning">
                @if (DeactivatePostedByWorkup)
                {
                    <p>This antibody was posted by a completed antibody-identification workup. Deactivating drops antigen-negative selection. Deactivate remains authorized and does not identify antibodies.</p>
                }
                <div class="field"><label>Reason to deactivate</label><input @bind="DeactivateReason" @bind:after="() => DeactivateReasonChanged.InvokeAsync(DeactivateReason)" /></div>
                <button class="btn btn-danger btn-sm" disabled="@Busy" @onclick="OnConfirmDeactivateAb">Confirm</button>
                <button class="btn btn-secondary btn-sm" @onclick="OnCancelDeactivateAb">Cancel</button>
            </div>
        }

        @if (Session.Has(PermissionCodes.ImmunoRecord))
        {
            <hr style="margin:1rem 0;border:none;border-top:1px solid var(--bb-border);" />
            <h4>Add antibody</h4>
            <div class="form-row">
                <div class="field"><label>Catalog antibody</label>
                    <FilterableComboBox TItem="BloodAttributeListItemDto" TValue="long?"
                                        Items="BloodAttributeCatalog"
                                        Value="AbCatalogId"
                                        ValueChanged="OnAbCatalogChanged"
                                        DisplayText="@(a => $"{a.AntibodyName} ({a.Code})")"
                                        ItemValue="@(a => a.Id)"
                                        Placeholder="Select from catalog" />
                </div>
                <div class="field"><label>Status</label>
                    <select @bind="AbStatus" @bind:after="() => AbStatusChanged.InvokeAsync(AbStatus)">@foreach (var s in Enum.GetValues<AntibodyStatus>()) { <option value="@s">@s</option> }</select>
                </div>
            </div>
            <div class="field"><label>Comment</label><input @bind="AbComment" @bind:after="() => AbCommentChanged.InvokeAsync(AbComment)" /></div>
            <div class="form-row">
                <div class="field" style="flex:2;"><label>Reported by another facility (optional)</label>
                    <input @bind="AbFacility" @bind:after="() => AbFacilityChanged.InvokeAsync(AbFacility)" maxlength="@OutsideAntibodyReportRule.MaxFacilityLength"
                           placeholder="e.g. St. Mary's Hospital, from the patient's antibody card" data-antibody-facility />
                </div>
                <div class="field"><label>Identified there on</label>
                    <input type="date" @bind="AbIdentifiedOn" @bind:after="() => AbIdentifiedOnChanged.InvokeAsync(AbIdentifiedOn)" disabled="@string.IsNullOrWhiteSpace(AbFacility)" data-antibody-identified-on />
                </div>
            </div>
            @if (OpenAbidWorkups.Count > 0)
            {
                <p>Complete or void the open workup before adding antibody history from this card.</p>
            }
            <button class="btn btn-primary" disabled="@(Busy || AbCatalogId is null || OpenAbidWorkups.Count > 0)" @onclick="OnAddAntibody">Add antibody</button>
        }
    </div>

    <div class="bb-card">
        <div class="bb-card-title"><h3>Antigen profile</h3></div>
        @if (AntigenProfiles.Count == 0)
        {
            <div class="empty">No antigen typing on record.</div>
        }
        else
        {
            <div class="table-scroll">
            <table class="bb">
                <thead><tr><th>Antigen</th><th>Code</th><th>Result</th><th>Source</th><th>Tested</th></tr></thead>
                <tbody>
                    @foreach (var p in AntigenProfiles)
                    {
                        <tr>
                            <td>@p.AntigenName</td>
                            <td class="mono">@p.AntigenCode</td>
                            <td>@p.Result</td>
                            <td>@(p.SourceResultId is null ? "Chart" : "Verified result")</td>
                            <td class="nowrap">@(p.TestedUtc?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        }
        @if (Session.Has(PermissionCodes.ImmunoRecord))
        {
            <hr style="margin:1rem 0;border:none;border-top:1px solid var(--bb-border);" />
            <h4>Record antigen result</h4>
            @if (OpenAbidWorkups.Count > 0)
            {
                <div class="alert alert-warning">
                    Open antibody-identification workup(s). Changing antigen type withdraws interpretation and review so they can be repeated against the current type.
                    This does not identify antibodies.
                    <a href="@AbidHref">Open antibody identification</a>.
                </div>
            }
            else if (HasCompletedUnscopedAbid || HasCompletedPostedAbid)
            {
                <div class="alert alert-warning">
                    A completed antibody-identification workup is the identification of record. An antigen-positive type that conflicts with posted history warns and does not reopen or retract that history.
                    This does not identify antibodies.
                    <a href="@AbidHref">Open antibody identification</a>.
                </div>
            }
            <Outcome Value="AntigenFeedback" />
            <div class="form-row">
                <div class="field"><label>Antigen</label>
                    <FilterableComboBox TItem="BloodAttributeListItemDto" TValue="long?"
                                        Items="BloodAttributeCatalog"
                                        Value="AgCatalogId"
                                        ValueChanged="OnAgCatalogChanged"
                                        DisplayText="@(a => $"{a.Name} ({a.Code})")"
                                        ItemValue="@(a => a.Id)"
                                        Placeholder="Select antigen" />
                </div>
                <div class="field"><label>Result</label>
                    <select @bind="AgResult" @bind:after="() => AgResultChanged.InvokeAsync(AgResult)">@foreach (var r in Enum.GetValues<AntigenResult>()) { <option value="@r">@r</option> }</select>
                </div>
            </div>
            <p class="muted">Result-sourced phenotypes stay in place. Changing one requires immuno.override.</p>
            <button class="btn btn-primary" disabled="@(Busy || AgCatalogId is null)" @onclick="OnSaveAntigen">Save antigen result</button>
        }
    </div>
</div>

@code {
    [Parameter] public long PatientId { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public ElectronicCrossmatchEligibilityDto? Exm { get; set; }
    [Parameter] public IReadOnlyList<AntibodyIdWorkupListItemDto> OpenAbidWorkups { get; set; } = [];
    [Parameter] public IReadOnlyList<BloodTypeDto> TypeHistory { get; set; } = [];
    [Parameter] public IReadOnlyList<SpecialRequirementDto> SpecialRequirements { get; set; } = [];
    [Parameter] public IReadOnlyList<SpecialRequirementDefinitionDto> SrCatalog { get; set; } = [];
    [Parameter] public IReadOnlyList<AntibodyDto> AntibodyHistory { get; set; } = [];
    [Parameter] public IReadOnlyList<AntigenProfileDto> AntigenProfiles { get; set; } = [];
    [Parameter] public IReadOnlyList<BloodAttributeListItemDto> BloodAttributeCatalog { get; set; } = [];
    [Parameter] public string AbidHref { get; set; } = "/antibody-id";
    [Parameter] public string CompatibilityHref { get; set; } = "/compatibility";
    [Parameter] public bool HasCompletedUnscopedAbid { get; set; }
    [Parameter] public bool HasCompletedPostedAbid { get; set; }
    [Parameter] public Feedback? TypeFeedback { get; set; }
    [Parameter] public Feedback? SrFeedback { get; set; }
    [Parameter] public Feedback? AntibodyFeedback { get; set; }
    [Parameter] public Feedback? AntigenFeedback { get; set; }
    [Parameter] public AboGroup TypeAbo { get; set; } = AboGroup.O;
    [Parameter] public EventCallback<AboGroup> TypeAboChanged { get; set; }
    [Parameter] public RhType TypeRh { get; set; } = RhType.Positive;
    [Parameter] public EventCallback<RhType> TypeRhChanged { get; set; }
    [Parameter] public AboSubgroup TypeSubgroup { get; set; } = AboSubgroup.Unknown;
    [Parameter] public EventCallback<AboSubgroup> TypeSubgroupChanged { get; set; }
    [Parameter] public string TypeReason { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> TypeReasonChanged { get; set; }
    [Parameter] public ManualTypeDocumentation TypeDocumentation { get; set; } = ManualTypeDocumentation.NotDocumented;
    [Parameter] public EventCallback<ManualTypeDocumentation> TypeDocumentationChanged { get; set; }
    [Parameter] public string TypeDocumentationReference { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> TypeDocumentationReferenceChanged { get; set; }
    [Parameter] public long? SrDeactivateId { get; set; }
    [Parameter] public string SrDeactivateReason { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> SrDeactivateReasonChanged { get; set; }
    [Parameter] public long SrDefinitionId { get; set; }
    [Parameter] public EventCallback<long> SrDefinitionIdChanged { get; set; }
    [Parameter] public string? SrAntigen { get; set; }
    [Parameter] public EventCallback<string?> SrAntigenChanged { get; set; }
    // Facility calendar date of a stored instant; an end date shows the first day the requirement no longer applies.
    private static string LocalDate(DateTime utc) =>
        DateTime.SpecifyKind(utc, DateTimeKind.Utc).ToLocalTime().ToString("yyyy-MM-dd");

    [Parameter] public DateTime? SrStartDate { get; set; }
    [Parameter] public EventCallback<DateTime?> SrStartDateChanged { get; set; }
    [Parameter] public DateTime? SrEndDate { get; set; }
    [Parameter] public EventCallback<DateTime?> SrEndDateChanged { get; set; }
