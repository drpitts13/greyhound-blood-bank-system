@inject BloodBankApiClient Api

@* Coded reason (reported by cause) plus a comment, which the code may require. *@
<select @ref="_reasonSelect" @bind="Code" @bind:after="() => CodeChanged.InvokeAsync(Code)" style="min-width:14rem;" aria-label="Rejection reason">
    <option value="">Choose a rejection reason…</option>
    @foreach (var r in _reasons)
    {
        <option value="@r.Code">@r.Text</option>
    }
</select>
<input @bind="Comment" @bind:event="oninput" @bind:after="() => CommentChanged.InvokeAsync(Comment)"
       placeholder="@(RequiresComment ? "Comment (required)" : "Comment (optional)")" style="flex:1;" aria-label="Rejection comment" />

@code {
    [Parameter] public string Code { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> CodeChanged { get; set; }
    [Parameter] public string Comment { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> CommentChanged { get; set; }

    // The picker appears when Reject is chosen, so the reason takes the focus as it appears (Cycle 639).
    [Parameter] public bool Autofocus { get; set; } = true;

    private List<SpecimenRejectionReasonRefDto> _reasons = new();
    private ElementReference _reasonSelect;
    private bool _focused;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!Autofocus || _focused || _reasonSelect.Context is null)
        {
            return;
        }

        _focused = true;
        try
        {
            await _reasonSelect.FocusAsync();
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or TaskCanceledException)
        {
        }
    }

    private bool RequiresComment => _reasons.FirstOrDefault(r => r.Code == Code)?.RequiresComment == true;

    /// <summary>True when a code is chosen and any required comment is present.</summary>
    public static bool IsComplete(IReadOnlyList<SpecimenRejectionReasonRefDto> reasons, string code, string comment) =>
        !string.IsNullOrWhiteSpace(code)
        && (reasons.FirstOrDefault(r => r.Code == code)?.RequiresComment != true || !string.IsNullOrWhiteSpace(comment));

    protected override async Task OnInitializedAsync()
    {
        var r = await Api.GetSpecimenRejectionReasonsAsync();
        if (r.Succeeded) _reasons = r.Value ?? new();
    }
}
