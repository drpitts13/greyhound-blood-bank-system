@inject BloodBankApiClient Api
@inject IJSRuntime Js
@implements IAsyncDisposable

<div class="coded-comment-field">
    <textarea @ref="_textarea"
              value="@Value"
              rows="@Rows"
              placeholder="@Placeholder"
              @oninput="OnInput"></textarea>
    <div class="coded-comment-insert">
        <label>Insert code</label>
        <select value="@_selectedCode" @onchange="OnCodeSelected">
            <option value="">@(_codes.Count == 0 ? "No coded comments" : "Select a code…")</option>
            @foreach (var item in _codes)
            {
                <option value="@item.Code">@item.Code — @item.CommentText</option>
            }
        </select>
    </div>
</div>

@code {
    [Parameter] public CommentPage Page { get; set; }
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public string? Placeholder { get; set; } = "Free text or insert a coded comment";
    [Parameter] public int Rows { get; set; } = 3;

    private ElementReference _textarea;
    private string _selectedCode = string.Empty;
    private List<CodedCommentRefDto> _codes = [];
    private IJSObjectReference? _module;

    protected override async Task OnInitializedAsync()
    {
        var r = await Api.GetReferenceCodedCommentsAsync(Page);
        _codes = r.Value ?? [];
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _module is not null)
        {
            return;
        }

        try
        {
            _module = await Js.InvokeAsync<IJSObjectReference>(
                "import", "./Components/Shared/CodedCommentField.razor.js");
        }
        catch
        {
            _module = null;
        }
    }

    private Task OnInput(ChangeEventArgs e) =>
        ValueChanged.InvokeAsync(e.Value?.ToString());

    private async Task OnCodeSelected(ChangeEventArgs e)
    {
        var code = e.Value?.ToString();
        _selectedCode = string.Empty;
        if (string.IsNullOrWhiteSpace(code))
        {
            return;
        }

        var item = _codes.FirstOrDefault(c => string.Equals(c.Code, code, StringComparison.OrdinalIgnoreCase));
        if (item is null)
        {
            return;
        }

        var current = Value ?? string.Empty;
        var start = current.Length;
        var end = current.Length;
        if (_module is not null)
        {
            try
            {
                var sel = await _module.InvokeAsync<Selection>("getSelection", _textarea);
                start = Math.Clamp(sel.Start, 0, current.Length);
                end = Math.Clamp(sel.End, start, current.Length);
            }
            catch
            {
                start = current.Length;
                end = current.Length;
            }
        }

        var insert = item.CommentText;
        var prefix = start > 0 && !char.IsWhiteSpace(current[start - 1]) ? " " : string.Empty;
        var suffix = end < current.Length && !char.IsWhiteSpace(current[end]) ? " " : string.Empty;
        var next = current[..start] + prefix + insert + suffix + current[end..];
        await ValueChanged.InvokeAsync(next);

        var caret = start + prefix.Length + insert.Length;
        await InvokeAsync(StateHasChanged);
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("setSelection", _textarea, caret);
            }
            catch
            {
                // Caret restore is best-effort.
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            await _module.DisposeAsync();
        }
    }

    private sealed record Selection(int Start, int End);
}
