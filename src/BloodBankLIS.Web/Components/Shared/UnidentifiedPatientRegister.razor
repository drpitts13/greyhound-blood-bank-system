@using BloodBankLIS.Application.Patients
@inject BloodBankApiClient Api

@* Registers an unidentified emergency patient (temporary UNK- MRN, estimated age); the page decides what happens next. *@
<div class="bb-card" data-unidentified-form>
    <div class="bb-card-title"><h3>Register an unidentified patient</h3></div>
    <p class="muted">
        For emergency care before the patient is identified. The system gives a temporary MRN and name
        (for example UNK-20261108-01, UNIDENTIFIED, TRAUMA 20261108-01) for the wristband and the first tube.
        Sex and an estimated age are needed: product selection for patients of childbearing potential uses them.
        When the patient is identified, merge this chart into theirs from the chart.
    </p>
    <Outcome Value="_fb" />
    <div class="form-row">
        <div class="field"><label>Sex</label>
            <select @bind="_sex" data-unidentified-sex>
                <option value="">Choose…</option>
                @foreach (var s in Enum.GetValues<Sex>())
                {
                    <option value="@s">@Ui.EnumText(s)</option>
                }
            </select>
        </div>
        <div class="field"><label>Estimated age (years)</label><input type="number" min="0" max="@UnidentifiedPatientRule.MaxEstimatedAgeYears" @bind="_age" data-unidentified-age /></div>
        <div class="field" style="flex:2;"><label>Note (optional)</label><input @bind="_note" placeholder="For example: trauma bay 2, arrived by EMS 14:05" /></div>
    </div>
    <div class="flex gap">
        <button type="button" class="btn btn-primary" disabled="@_saving" @onclick="RegisterAsync" data-unidentified-submit>Register unidentified patient</button>
        @if (OnCancel.HasDelegate)
        {
            <button type="button" class="btn btn-ghost" @onclick="OnCancel">Cancel</button>
        }
    </div>
</div>

@code {
    [Parameter] public EventCallback<PatientDto> OnRegistered { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private Sex? _sex;
    private int? _age;
    private string? _note;
    private bool _saving;
    private Feedback? _fb;

    private async Task RegisterAsync()
    {
        _saving = true;
        var result = await Api.CreateUnidentifiedPatientAsync(new CreateUnidentifiedPatientRequest(_sex, _age, _note));
        _saving = false;
        if (result.Succeeded && result.Value is { } patient)
        {
            _fb = null;
            await OnRegistered.InvokeAsync(patient);
            return;
        }

        _fb = result.ToFeedback();
    }
}
