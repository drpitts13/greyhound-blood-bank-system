@inject UserSession Session

<Router AppAssembly="typeof(Program).Assembly" NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)" />
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>

@code {
    /// <summary>Browser address captured from the initial HTTP request in App.razor.</summary>
    [Parameter] public string? ClientAddress { get; set; }

    protected override void OnInitialized() => Session.UseClientAddress(ClientAddress);
}
