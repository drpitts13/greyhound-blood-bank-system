<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <!-- The UI consumes the HTTP API but shares the API's contract types (DTOs, enums)
         for compile-time safety, per the architecture's "shares C# models" decision. -->
    <ProjectReference Include="..\BloodBankLIS.Application\BloodBankLIS.Application.csproj" />
    <ProjectReference Include="..\BloodBankLIS.Domain\BloodBankLIS.Domain.csproj" />
    <ProjectReference Include="..\BloodBankLIS.Help\BloodBankLIS.Help.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Same version as BloodBankLIS.Printing; reads an antigram imported from an Excel file. -->
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <!-- Same version as BloodBankLIS.Printing; draws the authenticator setup QR code. -->
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>

</Project>
