<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="0.40.0" />
    <PackageReference Include="QuestPDF" Version="2026.9.0" />
  </ItemGroup>

  <ItemGroup>
    <HelpMarkdown Include="..\..\docs\user-manual\clinical\*.md">
      <Guide>clinical</Guide>
    </HelpMarkdown>
    <HelpMarkdown Include="..\..\docs\user-manual\admin\*.md">
      <Guide>admin</Guide>
    </HelpMarkdown>
    <EmbeddedResource Include="@(HelpMarkdown)">
      <LogicalName>help.%(Guide).%(Filename).md</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\docs\user-manual\figures\*.png">
      <LogicalName>help.figures.%(Filename).png</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
