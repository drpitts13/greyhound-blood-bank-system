<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.AspNetCore.OpenApi.Generated</InterceptorsNamespaces>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.8">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BloodBankLIS.Application\BloodBankLIS.Application.csproj" />
    <ProjectReference Include="..\BloodBankLIS.Infrastructure\BloodBankLIS.Infrastructure.csproj" />
    <ProjectReference Include="..\BloodBankLIS.HL7\BloodBankLIS.HL7.csproj" />
    <ProjectReference Include="..\BloodBankLIS.Printing\BloodBankLIS.Printing.csproj" />
    <ProjectReference Include="..\BloodBankLIS.Security\BloodBankLIS.Security.csproj" />
  </ItemGroup>

</Project>
