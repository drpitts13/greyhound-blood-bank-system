<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.AspNetCore.OpenApi.Generated</InterceptorsNamespaces>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.8">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- QuestPDF's Lato font archive is copied beside this host. The renderer lives in Printing, and QuestPDF only finds that archive next to the entry assembly. -->
    <PackageReference Include="QuestPDF" Version="2026.9.0" />
    <PackageReference Include="PDFtoImage" Version="5.4.0" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BloodBankLIS.Application\BloodBankLIS.Application.csproj" />
    <ProjectReference Include="..\BloodBankLIS.Infrastructure\BloodBankLIS.Infrastructure.csproj" />
    <ProjectReference Include="..\BloodBankLIS.HL7\BloodBankLIS.HL7.csproj" />
    <ProjectReference Include="..\BloodBankLIS.Astm\BloodBankLIS.Astm.csproj" />
    <ProjectReference Include="..\BloodBankLIS.Printing\BloodBankLIS.Printing.csproj" />
    <ProjectReference Include="..\BloodBankLIS.Security\BloodBankLIS.Security.csproj" />
  </ItemGroup>

</Project>
