{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "BloodBankLIS": "Server=localhost\\SQLEXPRESS02;Database=BloodBankLIS;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Database": {
    "AutoMigrate": true
  },
  "Auth": {
    "AllowLegacyIdentityHeader": false,
    "IdleTimeoutMinutes": 30,
    "AbsoluteTimeoutHours": 12
  },
  "Iccbba": {
    "ExtractDirectory": ""
  },
  "Specimens": {
    "ExpirationSweepSeconds": 30
  },
  "Inventory": {
    "ExpirationSweepSeconds": 300
  },
  "Alerts": {
    "ScanSeconds": 300
  },
  "Backup": {
    "Folder": "backups",
    "IntervalHours": 24,
    "KeepCount": 14,
    "OverdueHours": 48
  }
}
